\t}\r\n\t\t}\r\n\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\tcallAlert(\"[Connection Failure]\"+errorThrown);\r\n\t\t\thideLoading();\r\n\t\t}\r\n\t\t, complete:function(jqXHR,status){\r\n\t\t\thideLoading();\r\n\t\t}\r\n\t});\r\n\t\r\n\treturn result;\r\n};\r\n\r\nfunction setMcpViewArea()\r\n{\r\n\t// MCP 사용가맹점이 아닌 경우 미노출\r\n\tif($(\"#useMcp\").val() != \"true\")\r\n\t\treturn;\r\n\t\r\n\tvar inuqeryCardNum = $(\"#jGlobalCardNumber1\").val() + $(\"#jGlobalCardNumber2\").val();\r\n\t\r\n\tif($(\"#jInqueryMCP\").attr(\"jMcpCardVal\") == inuqeryCardNum)\r\n\t\treturn;\r\n\t\r\n\t$(\"#jInqueryMCP\").attr(\"jMcpCardVal\", inuqeryCardNum);\r\n\tif(inuqeryCardNum == \"\" || inuqeryCardNum.length < 8)\r\n\t{\r\n\t\t$payForm.find(\"input[name=mcpData]\").remove();\r\n\t\t$(\".JmcpArea\").hide();\r\n\t\t$(\".JmcpAssentArea\").hide();\r\n\t\t\r\n\t\t$(\"#jSelectMcpTag\").empty();\r\n\t\t$(\"#jSelectMcpTag\").append(\"<option value=''>---------</option>\");\r\n\t\t$(\"#jTermMcp\").prop(\"checked\", false);\r\n\t\t$(\"#jInqueryMCP\").removeAttr(\"jMcpCardCodeVal\");\r\n\t\tsetOriView();\r\n\t\treturn;\r\n\t}\r\n\t$payForm.find(\"input[name=mcpData]\").remove();\r\n\t$(\".JmcpAssentArea\").hide();\r\n\t$(\"#jSelectMcpTag\").empty();\r\n\t$(\"#jSelectMcpTag\").append(\"<option value=''>---------</option>\");\r\n\t$(\"#jTermMcp\").prop(\"checked\", false);\r\n\t$(\"#jInqueryMCP\").removeAttr(\"jMcpCardCodeVal\");\r\n\tsetOriView();\r\n\tshowLoading();\r\n\tjQuery.ajax({\r\n\t\tasync : true\r\n\t\t, url:'/jsApi/normal/checkForCardNum'\r\n\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t, type : \"POST\"\r\n\t\t, dataType:\"json\"\r\n\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t// 정상 통신\r\n\t\t\tif(jsonData['resultCode'] == '0000'){\r\n\t\t\t\tvar cardCode = jsonData['cardCode'];\r\n\t\t\t\t\r\n\t\t\t\tvar mcpCardCodeArr = $(\"#mcpCardCode\").val().split(