            "mimeType": "application/javascript",
            "compression": 0,
            "text": "$(document).ready(function(){\r\n\t$(document).on(\"click\",\".btnAgrmt_detail\", function(e){\t\r\n\t\t// 하단 배너가 없을 때 높이늘 늘려준다.\r\n\t\tif($(\".btmBnr\").length == 0) {\r\n\t\t\t$(\".agrmt_2nd\").css(\"height\", \"462px\");\r\n\t\t}\t\t\r\n\t\t\r\n\t\t$(\".agrmt_2nd\").slideToggle();\r\n\t\t$(\".agrmt_1st\").toggle();\r\n\t\t\r\n\t\t$(this).toggleClass(\"minus\");\r\n\t\t\r\n\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\r\n\t\tif($(this).hasClass(\"minus\") == true){\r\n\t\t\tif(languageView == \"ko\") {\r\n\t\t\t\tjQuery(\".btnAgrmt_detail.minus\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmMinus_ko.png)\"});\r\n\t\t\t\tjQuery(\".btnAgrmt_detail.minus\").attr(\"alt\",\"약관 상세보기 닫기\");\r\n\t\t\t\tjQuery(\".btnAgrmt_detail.minus\").attr(\"title\", \"약관보기 닫기\"); //231113 웹접근성으로 인하여 추가\r\n\t\t\t\t\r\n\t\t\t}else if(languageView == \"en\") {\r\n\t\t\t\tjQuery(\".btnAgrmt_detail.minus\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmMinus_en.png)\"});\r\n\t\t\t\tjQuery(\".btnAgrmt_detail.minus\").attr(\"alt\",\"view terms close\");\r\n\t\t\t\tjQuery(\".btnAgrmt_detail.minus\").attr(\"title\",\"view terms close\"); //231113 웹접근성으로 인하여 추가\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t}else if(languageView == \"cn\") {\r\n\t\t\t\tjQuery(\".btnAgrmt_detail.minus\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmMinus_ch.png)\"});\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tif(languageView == \"ko\") {\r\n\t\t\t\tjQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ko.png)\"});\r\n\t\t\t\tjQuery(\".btnAgrmt_detail\").attr(\"alt\",\"약관 상세보기\");\r\n\t\t\t\tjQuery(\".btnAgrmt_detail\").attr(\"title\", \"약관보기 열기\"); //231113 웹접근성으로 인하여 추가\r\n\t\t\t\t\r\n\t\t\t}else if(languageView == \"en\") {\r\n\t\t\t\tjQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_en.png)\"});\r\n\t\t\t\tjQuery(\".btnAgrmt_detail\").attr(\"alt\",\"view terms more\");\r\n\t\t\t\tjQuery(\".btnAgrmt_detail\").attr(\"title\",\"view terms more\"); //231113 웹접근성으로 인하여 추가\r\n\t\t\t\t \r\n\t\t\t}else if(languageView == \"cn\") {\r\n\t\t\t\tjQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ch.png)\"});\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 상세보기 화면이 오픈된 상태에서 열림/닫힘 버튼 Tab키 클릭시 전제동의 체크박스로 이동\r\n\t$(document).on(\"keydown\", \".btnAgrmt_detail\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode){\r\n\t\t\tif($(this).hasClass(\"minus\")) {\r\n\t\t\t\te.stopPropagation();\r\n\t\t\t\te.preventDefault();\r\n\t\t\t\t\r\n\t\t\t\t$(\"#inputAll\").focus();\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\tvar count = 0;\r\n\t$(document).on(\"click\",\"#btnmq\", function(e){\r\n\t\tcount++;\r\n\t\tvar isEven = function(someNumber) {\r\n\t\t\treturn (someNumber % 2 === 0) ? true : false;\r\n\t\t};\r\n\t\tif (isEven(count) === false) {\r\n\t\t\t$('marquee').trigger('stop');\r\n\t\t\t$(this).child\r\n\t\t} else if (isEven(count) === true) {\r\n\t\t\t$('marquee').trigger('start');\r\n\t\t}\r\n\t\t$(this).toggleClass(\"pause\");\r\n\t});\r\n});"
