            "text": "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div class=\"main_area_top\" id=\"testLoad\">\r\n\t<div id=\"topTitleSection\">\r\n\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- WCCHOI js 추가 -->\r\n<script type=\"text/javascript\" src=\"/js/common.js\"></script>\r\n<!-- 결제 상세 화면 -->\r\n<div class=\"kgPayments\">\t\r\n\t<span style=\"opacity:0;position:absolute;top:-9999px;filter: alpha(opacity=0);-ms-filter:progid:DXImageTransform.Microsoft.Alpha(Opacity=0);-moz-opacity:0;-khtml-opacity:0\">\r\n\t\t<!-- <input type=\"text\" id=\"inputFocus\" maxlength=\"0\" tabindex=\"99\" title=\"결제화면 진입\" /> -->\r\n\t\t<input type=\"text\" id=\"inputFocus\" maxlength=\"0\" title=\"결제화면 진입\" />\r\n\t</span>\r\n\t\r\n\t<!-- 230605 중앙교육 웹접근성으로 인하여 tabindex 주석처리 -->\r\n \r\n \t<!-- 250224 이노디스 웹접근성으로 인하여 tabindex 주석처리 해제 -->\r\n\t\r\n\t\t<div class=\"logo\" id=\"spanLogo\">\r\n\t   \t\t<img src=\"https://stdux.inicis.com/stdpay/img/new_logo04.png\" alt=\"KG Inicis\" /> \r\n\t\t</div>\r\n\t\r\n\t \r\n\t<!-- <dl class=\"hist_new\"> -->\r\n\t\r\n\t\r\n\t<!-- </dl> -->\r\n\t<!-- 상품명 -->\r\n\t<dl class=\"hist\">\r\n\t\t<dt class =\"titl\" ><span langTag=\"common.label1.sub2\">Product Information</span></dt>\r\n\t\t<dd class =\"txtl\" ><span class=\"goods_span\"></span></dd> \r\n\t</dl>\r\n\t\r\n\t \r\n\t\t<!-- 상품가격(상품가격, 상품금액) -->\r\n\t\t<dl class=\"hist\">\r\n\t\t\t\r\n\t\t\t\t<dt><span langTag=\"common.label1.sub3\" >Price </span></dt><!-- 상품가격 -->\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t<dd>\r\n\t\t\t\t<span  class=\"jRightGoodsPrice\">\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t161,000\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t</span>\r\n\t\t\t\t<span langTag=\"common.label1.sub4.WON\" class=\"jRightGoodsCurrency\" bfCurrency=\"Won\">Won</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t<div id=\"lpointDisplay\"></div>\r\n\t<!-- ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ -->\r\n\t<!-- lpoint 적용된 상태 -->\r\n\t\r\n\t\r\n\t\r\n\t\t<dl class=\"hist hide lpoint_exp\" style=\"padding:7px 0 0;\">\r\n\t\t\t<dt>\r\n\t\t\t\t<span langTag=\"payMethodCode.Card\" >신용카드</span>\r\n\t\t\t</dt><!-- 신용카드 -->\r\n\t\t\t<dd>\r\n\t\t\t\t<span  class=\"lpoint_exp_credit\"></span>\r\n\t\t\t\t<span langTag=\"common.label1.sub4.WON\" >Won</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<dl class=\"hist hide lpoint_exp\" style=\"padding:0 0 7px;\">\r\n\t\t\t<dt>\r\n\t\t\t\t<span langtag=\"payMethodCode.Point\" >+ Point</span><!-- + 포인트 -->\r\n\t\t\t</dt>\r\n\t\t\t\r\n\t\t\t<dd>\r\n\t\t\t\t<span  class=\"lpoint_exp_point\"></span>\r\n\t\t\t\t<span>P&nbsp;</span>\r\n\t\t\t</dd>\t\r\n\t\t</dl>\r\n\t\r\n\t<!-- ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ -->\r\n\t\r\n\t\r\n\t<!-- 이니포인트 사용시 -->\r\n\t<dl class=\"hist hide payPoint\">\r\n\t\t<dt>\r\n\t\t\t<span langTag=\"common.label.sub12\" >Point</span>\r\n\t\t</dt>\r\n\t\t\r\n\t\t<dd>\r\n\t\t\t<span class=\"infoPoint\" ></span>\r\n\t\t\t<span langTag=\"common.label1.sub4.WON\" >Won</span>\r\n\t\t</dd>\r\n\t</dl>\r\n\t\r\n\t<!-- 신용카드금액 -->\r\n\t<dl class=\"hist hide payCard\">\r\n\t\t<dt>\r\n\t\t\t<span langTag=\"button.nav2\" >Credit Card</span>\r\n\t\t</dt>\r\n\t\t\r\n\t\t<dd>\r\n\t\t\t<span class=\"infoCard\" ></span>\r\n\t\t\t<span langTag=\"common.label1.sub4.WON\" >Won</span>\r\n\t\t</dd>\r\n\t</dl>\r\n\t\r\n\t<!-- 이니포인트 정보확인 -->\r\n\t\r\n\t\r\n\t<!-- OCB결제시 정보확인 -->\r\n\t\r\n\t\r\n\t<!-- OCB 포인트 사용할경우 -->\r\n\t\r\n\t\r\n\t<!-- GS&Point 정보확인 -->\r\n\t\r\n\t\r\n\t<!-- GS&Point 포인트 사용할경우 -->\r\n\t\r\n\t\r\n\t<!-- UPoint 정보확인때 보여주기 -->\r\n\t\r\n\t\r\n\t<!-- UPoint 포인트 사용할경우 -->\r\n\t\r\n\t\r\n\t<!-- 포인트 카드 선택시 보여주기 -->\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t<!-- 쿠폰 적용된 상태 -->\r\n\t\r\n\t\r\n\t<!-- 쿠폰 미적용 상태-->\r\n\t\r\n\t\t<dl class=\"hist hide coupon\" >\r\n\t\t\t<dt><span langTag=\"common.label.sub11\" tabindex=\"157\">Coupon Amount</span></dt>\r\n\t\t\t<dd>\r\n\t\t\t\t<span class=\"couponPrice\" tabindex=\"158\"> 0 </span>\r\n\t\t\t\t<span langTag=\"common.label1.sub4.WON\" tabindex=\"159\">Won</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\r\n\t\r\n\t<!-- *******************************************************************-->\r\n\t<!-- 이니안심 done -->\r\n\t\r\n\t\r\n\t<!-- 이니안심 card -->\r\n\t\r\n\t\t<dl class=\"hist hide kcare\" >\r\n\t\t\t<dt><span langTag=\"common.label.sub13\" >이니안심금액(+)</span></dt>\r\n\t\t\t<dd>\r\n\t\t\t\t<span class=\"kcarePrice\" tabindex=\"164\"> 0 </span>\r\n\t\t\t\t<span langTag=\"common.label1.sub4.WON\" tabindex=\"165\">Won</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\r\n\t<!-- *******************************************************************-->\r\n\t\r\n\t<!-- YES24 신한 제휴 할인 여부  -->\r\n\t\r\n\t\r\n\t<!-- 제공기간 -->\r\n\t\r\n\t\r\n\t\r\n\t<!-- 쿠폰정보 있을경우 -->\r\n\t\r\n\t\r\n\t\r\n\t\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\t<!-- 쿠폰사용시 -->\r\n\t\t\r\n\t\r\n\t\r\n\t \r\n\t\t<!-- 쿠폰미사용시 -->\r\n\t\t\r\n\t\t\t<dl class=\"total\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\t<dt><span langTag=\"common.label1.sub5\">Payment Amount</span></dt>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<dd>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t<!-- 일반결제일경우 -->\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<span class=\"payPrice jRightPayPrice\" >\r\n\t\t\t\t\t\t\t\t161,000\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t</span>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<!--포인트 결제시 -->\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<!--포인트 단독결제 정보확인창 -->\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t<!--포인트 복합결제 정보확인창 -->\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t<span langTag=\"common.label1.sub4.WON\" class=\"jRightPayCurrency\" >Won</span>\r\n\t\t\t\t</dd>\r\n\t\t\t</dl>\r\n\t\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t<div class=\"smpa_bnr_r\" style=\"display:none;\">\r\n\t\t<img src=\"\" alt=\"\"/>\r\n\t</div>\r\n\t\r\n\t\r\n\t\r\n\t\t<!-- 광고배너 DB화로 인해 기존 iframe 주석 처리 260121-->\r\n\t\t\r\n\t\t\r\n\t\t<div class=\"bnr\" id=\"rightBnr\">\r\n\t\t\t<div class=\"std_ad_right_area\">\r\n\t\t\t\t\r\n\t\t\t\t\t<a href=\"javascript:;\" title=\"새창 열림\" class=\"rightBanner\" style=\"outline-offset:-2px;\" onclick=\"bannerClick('https://inirental.co.kr/');\">\r\n\t\t\t\t\t\t<img src=\"https://ds-cdn.inicis.com/ad/std/2026/0109/ad_bnr_rb.jpg\" alt=\"이니렌탈 다이렉트몰\" name=\"rightAdBanner\" border=\"0\" width=\"128\" height=\"65\" style=\"border: 0;width:128px;height:65px;\">\r\n\t\t\t\t\t</a>\r\n\t\t\t\t\r\n\t\t\t\t\t<a href=\"javascript:;\" title=\"새창 열림\" class=\"rightBanner\" style=\"outline-offset:-2px;\" onclick=\"bannerClick('https://inicis.com/initalkpay');\">\r\n\t\t\t\t\t\t<img src=\"https://ds-cdn.inicis.com/ad/std/2026/0123/ad_bnr_rb_02.png\" alt=\"이니톡결제\" name=\"rightAdBanner\" border=\"0\" width=\"128\" height=\"65\" style=\"border: 0;width:128px;height:65px;\">\r\n\t\t\t\t\t</a>\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t \t\r\n\t\t\t\t\t<!-- 페이지 컨트롤러 영역 -->\r\n\t\t\t\t\t<div class=\"slider_controls\">\r\n\t\t\t\t\t\t<button class=\"playPauseBtn toggle-btn\" id=\"rightPlayPauseBtn\" type=\"button\" aria-pressed=\"false\" onclick=\"autoImg('right')\">\r\n\t\t\t\t\t\t\t<span class=\"icon-play\" aria-hidden=\"true\">▶</span>\r\n\t\t\t\t\t\t\t<span class=\"icon-pause\" aria-hidden=\"true\" style=\"display: none; gap: 1px; font-size: 8px;\"><b>I</b><b>I</b></span>\r\n\t\t\t\t\t\t</button>\r\n\t\t\t\r\n\t\t\t\t\t\t<div class=\"page_controls\">\r\n\t\t\t\t\t\t\t<button class=\"nav_button\" id=\"rightPrevBtn\" type=\"button\" aria-label=\"이전 슬라이드 버튼\" onclick=\"movePrev(true,'right')\">\r\n\t\t\t\t\t\t\t\t<strong>&lt;</strong>\r\n\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<span class=\"page_number\">\r\n\t\t\t\t\t\t\t\t<strong class=\"current\" id=\"rightCurrent\">1</strong>I<span class=\"total\" id=\"rightTotal\">2</span>\r\n\t\t\t\t\t\t\t</span>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t\t<button class=\"nav_button\" id=\"rightNextBtn\" type=\"button\" aria-label=\"다음 슬라이드 버튼\" onclick=\"moveNext(true,'right')\">\r\n\t\t\t\t\t\t\t\t<strong>&gt;</strong>\r\n\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\r\n\t\t\t</div>\t\r\n\t\t</div>\r\n\t\r\n\t\r\n\t\r\n\t<div class=\"btnArea\">\r\n\t\t<!-- 다음버튼 -->\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\t<a href=\"javascript:;\" id=\"CardBtn\" class=\"btnType09 btnDis bottomBtn\" tabindex=\"407\" title=\"\">\r\n\t\t\t\t\t\t<span class=\"blind\">KG Inicis 신용카드 결제 2단계 이동</span>\r\n\t\t\t\t\t\t<span langTag=\"button.next.space\">Next</span>\r\n\t\t\t\t\t</a>\r\n\t\t\t\t\r\n\t\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t\t<!-- 현금영수증 발행버튼 2015-09-11 -->\r\n\t\t\r\n\t\t\r\n\t\t<!-- kpayNext 버튼 201704.28 -->\r\n\t\t\r\n\t</div>\r\n\t\r\n\t<!-- close button-->\r\n\t<button type=\"button\" name=\"button\" class=\"btn_close cancelBtn\" id=\"btnCancel\" tabindex=\"408\" title=\"Close\"></button>\r\n\t<!-- //close button-->\r\n</div>\r\n\r\n<!-- //결제 상세 화면 -->\r\n<div class=\"hide checkCoupon\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div id=\"counponPopup\">\r\n\t<div class=\"popLayer\" style=\"width:440px; height:272px; margin:-163px 0 0 -245px;\"><!-- padding:30px 24px; -->\r\n\t\t<h1 class=\"copy02 bold\"><span langTag=\"common.label1.sub13\">Discount Coupon Event</span></h1>\r\n\t\t\r\n\t\t<div class=\"autoScroll\">\r\n\t\t\t\t\r\n\t\t\t\t<table class=\"tblType03\">\r\n\t\t\t\t\t<caption>할인쿠폰 이벤트</caption>\r\n\t\t\t\t\t<colgroup>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 160px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 170px;\"/>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t</colgroup>\r\n\t\t\t\t\t\r\n\t\t\t\t</table>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t<!-- 정률제 일반카드 쿠폰 추가 250306 -->\r\n\t\t\t\r\n\t\t\t\t<table class=\"tblType03\">\r\n\t\t\t\t\t<caption>할인쿠폰 이벤트</caption>\r\n\t\t\t\t\t<colgroup>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 160px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 170px;\"/>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t</colgroup>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t</table>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t<!-- 정률제 앱카드 쿠폰 추가 250306 -->\r\n\t\t\t\r\n\t\t\t\t<table class=\"tblType03\">\r\n\t\t\t\t\t<caption>할인쿠폰 이벤트</caption>\r\n\t\t\t\t\t<colgroup>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 160px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 170px;\"/>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t</colgroup>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t</table>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t<!-- 일반쿠폰 -->\r\n\t\t\t\r\n\t\t\t\t<table class=\"tblType03\">\r\n\t\t\t\t\t<caption>할인쿠폰 이벤트</caption>\r\n\t\t\t\t\t<colgroup>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 160px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 170px;\"/>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t</colgroup>\r\n\t\t\t\t\t\r\n\t\t\t\t</table>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t<!-- 앱카드 쿠폰 -->\r\n\t\t\t\r\n\t\t\t\t<table class=\"tblType03\">\r\n\t\t\t\t\t<caption>할인쿠폰 이벤트</caption>\r\n\t\t\t\t\t<colgroup>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 160px;\" />\r\n\t\t\t\t\t\t<col style=\"width: 170px;\"/>\r\n\t\t\t\t\t\t<col style=\"width: 40px;\" />\r\n\t\t\t\t\t</colgroup>\r\n\t\t\t\t\t<!-- 우리카드 앱카드 쿠폰 추가로 인하여 분기처리 로직 추가 23.05.04 -->\r\n\t\t\t\t\t\r\n\t\t\t\t</table>\r\n\t\t\t\r\n\t\t\t\r\n\t\t</div>\r\n\t\t\r\n\t\t<div class=\"btnWrapC\" style=\"margin-top:17px\">\r\n\t\t\t<a href=\"javascript:;\" id=\"closeCpnBtn\" class=\"btnType06\"><span class=\"boldNo\" langTag=\"button.close\">Close</span></a>\r\n\t\t</div>\r\n\t </div>\r\n </div></div>\r\n<input type=\"hidden\" name=\"escrowFullData\" id=\"escrowFullData\" value=\"\" />\r\n<input type=\"hidden\" id=\"curPage\" value=\"Card\" />\r\n<script defer type=\"text/javascript\" >\r\n$(document).ready(function(){\r\n\t$(\".kgPayments\").css(\"background-color\",$(\"input[name=colorView]\").val());\r\n\t$(\".btnType09\").css(\"color\",$(\"input[name=colorView]\").val());\r\n\t\r\n\tvar fontColor = $(\"input[name=fontColor]\").val();\r\n\t\r\n\tif(fontColor != \"\" && fontColor != null){\r\n\t\t$(\".kgPayments span\").css(\"color\", fontColor);\r\n\t}\r\n\t\r\n\t\r\n\tvar strCount = 0;\r\n\tvar a =\"QWER 1ST WORLD TOUR 〈ROCKATION : HOM...\"; \r\n\tvar str = a.replace(/¨/gi,\"\\\"\");\r\n\tvar tempStr, tempStr2; \r\n\tfor(i = 0;i < str.length;i++) {\r\n\t tempStr = str.charAt(i);\r\n\t if(escape(tempStr).length > 4) {\r\n\t  strCount += 2;\r\n\t    } else {\r\n\t  strCount += 1 ;\r\n\t }\r\n  } \r\n\tif(strCount == 32){\r\n\t\t}else if(strCount > 28 && strCount != 32) {\r\n\t// alert(\"최대 \" + FieldName + \"byte이므로 초과된 글자수는 자동으로 삭제됩니다.\");\r\n\t\tstrCount = 0; \r\n\t\ttempStr2 =\"\";\r\n\t\tfor(i = 0; i < str.length; i++) {\r\n\t\t\ttempStr = str.charAt(i); \r\n\t\t\tif(escape(tempStr).length > 4) {\r\n\t\t\t\tstrCount += 2;\r\n\t\t\t} else {\r\n\t\t\t\tstrCount += 1 ;\r\n\t\t\t}\r\n\t\t\tif(strCount > 28) {\r\n\t\t\t\tif(escape(tempStr).length > 4) {\r\n\t\t\t\t\tstrCount -= 2;\r\n\t\t\t\t} else {\r\n\t\t\t\t\tstrCount -= 1 ; \r\n\t\t\t  }\r\n\t\t\t\tbreak;     \r\n\t\t\t} else {\r\n\t\t\t\ttempStr2 += tempStr;\r\n\t\t\t}\r\n\t\t}\r\n\t \tstr = tempStr2 + \"...\";\r\n\t}else if(strCount < 17){\r\n\t\t$(\".hist_new td.txtl\").css(\"text-align\",\"right\");\r\n\t}\r\n\t$(\".goods_span\").html(str);\r\n\t// 쿠폰 사용을 보여줄 경우 버튼 클릭과 동일 액션 실행\r\n\tif(\"false\" ==\"true\" && $(\"#autoCouponFlag\").val() !=\"Y\" && \"WON\" !=\"USD\"){\r\n\t\t$(\"#autoCouponFlag\").val(\"Y\");\r\n\t\tjQuery(\"#CouponBtn\").trigger('click');\r\n\t\t\r\n\t\t//wccchoi\r\n\t\t//2016.06.28\r\n\t\t//DESC : 쿠폰 포커스 이동.\r\n\t\tisCuponFocus = true;\r\n\t}\r\n\t\r\n\t//coupon_flg\r\n\t//addCouponStat\t\r\n\t//배너 안보이게\r\n\tvar acceptMethod = $payForm.find(\"[name=acceptmethod]\").val();\r\n\tvar bnrView = $(\"#bnrView\").val();\r\n\tif(acceptMethod.indexOf(\"no_rightbanner\") > -1 || acceptMethod.indexOf(\"no_banner\") > -1 || bnrView === 'false'){\r\n\t//\tjQuery(\"#iframeBanner_Card\").hide();\r\n\t\tjQuery(\"#rightBnr\").hide();\r\n\t}else{\r\n\t\t//다이렉트 결제로 호출되는 경우 결제창 광고 롤링 처리 안되게끔 처리 260123\r\n\t\t//광고배너 핸들링 버튼\r\n\t\tvar getPopWrap = $(\".popWrap\").css(\"display\");\r\n\t\t\r\n\t\tif(getPopWrap == \"block\"){\r\n\t\r\n\t\t\tvar imgs = $(\"#rightBnr a img\");\r\n\t\t\tvar imgsCnt = imgs.length;\r\n\t\t\t\r\n\t\t\timgs.hide().eq(0).show();\r\n\t\t\t\r\n\t\t\tif(imgsCnt > 1){\r\n\t\t\t\tvar banners = document.querySelectorAll(\"#rightBnr\");\r\n\t\t        for (var i = 0; i < banners.length - 1; i++) {\r\n\t\t            banners[i].parentNode.removeChild(banners[i]);\r\n\t\t        }\r\n\r\n\t\t        // 상태 초기화\r\n\t\t        resetBannerState('right');\r\n\t\t\t\tstartBanner('right');\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t}\r\n\t\r\n\t\r\n\t//남대문경찰서 협업 이미지 관련 추가 250819\r\n\tif($(\"#showImgYn\").val() == \"Y\"){\r\n\t\tvar strImgSrc = \"\";\r\n\t\tvar imgPath = 'https:\\/\\/stdux.inicis.com\\/stdpay';\r\n\t\t/* if(strSkinOption.toLowerCase().indexOf(\"skin\") > -1) {\r\n\t\t\t//그레이 배경\r\n\t\t\tstrImgSrc = imgPath+\"/img/right_bnr_smpa.png\";\r\n\t\t}else{\r\n\t\t\t//투명\r\n\t\t\tstrImgSrc = imgPath+\"/img/right_bnr_smpa2.png\";\r\n\t\t}\r\n\t\t */\r\n\t\t \r\n\t\tvar strImgSrc = \"\";\r\n\t\tvar strAltSrc = \"\";\r\n\t\t//251201부터 다른 이미지로 노출\r\n\t\tif($(\"#showChgImg\").val() == \"Y\"){\r\n\t\t\t/* strImgSrc = imgPath+\"/img/right_bnr_smpa2_v2.png\";\r\n\t\t\tstrAltSrc = \"해외 취업 전 꼭 확인하기! 회사정보! 서면 계약서! 정식 취업비자! 서울경찰청\"; */\r\n\t\t\t//260301 이후 신규 문구 및 이미지 노출로 인해 주석처리\r\n\r\n\t\t\tstrImgSrc = imgPath+\"/img/right_bnr_smpa_v3.png\";\r\n\t\t\tstrAltSrc = \"단속내역‘교통민원24’수시 조회! 체납시 가산금, 번호판 영치, 국제운전면허증 발급 제한!\";\r\n\t\t}else{\r\n\t\t/* \tstrImgSrc = imgPath+\"/img/right_bnr_smpa2.png\";\r\n\t\t\tstrAltSrc = \"서울경찰청 의심하고! 전화끊고! 확인하고! 피싱범죄 통합신고 112\"; */\r\n\t\t\t\r\n\t\t\t//260301 이전 노출 문구\r\n\t\t\tstrImgSrc = imgPath+\"/img/right_bnr_smpa2_v2.png\";\r\n\t\t\tstrAltSrc = \"해외 취업 전 꼭 확인하기! 회사정보! 서면 계약서! 정식 취업비자! 서울경찰청\";\r\n\t\t}\r\n\t\t\r\n\t\t$(\".smpa_bnr_r img\").prop(\"src\", strImgSrc);\r\n\t\t$(\".smpa_bnr_r img\").prop(\"alt\", strAltSrc);\r\n\t\t$(\".smpa_bnr_r\").css(\"display\",\"block\");\r\n\t}\r\n\r\n\r\n});\r\nfunction adPopupRight(){\r\n\twindow.open(\"https://card.nonghyup.com/content/html/ip/cn/ipgateway.html?menu_id=IPCC070101&SERVICE_ID=IPCI2002R&NAVIGATE_TYPE=1&event_no=844&prg_yn=\",\"adpopup\",\"width=900,height=610,scrollbars=yes,top=\"+(window.screenTop+10)+\",left=\"+(window.screenLeft+10));\r\n}\r\n\r\n</script>\r\n\t</div>\r\n\t<div class=\"kgContents\">\r\n\t\t<!-- 이용약관 동의 -->\r\n\t\t<div id=\"termsSection\">\r\n\t\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- 이용약관 -->\r\n<div class=\"agr_utilzr_dis\">\r\n\t<div class=\"h3_tit\">\r\n\t\t<h3><span langTag=\"clause.label\">Terms</span></h3>\r\n\t\t<div class=\"agr_all\">\r\n\t\t\t<input type=\"checkbox\" name=\"all\" id=\"inputAll\" tabindex=\"250\"/>\r\n\t\t\t<label for=\"inputAll\"><span langTag=\"clause.label1.sub1\">I agree to all terms and conditions.</span></label>\r\n\t\t</div>\r\n\t</div>\r\n\t<!--  전체동의 간략 -->\r\n\t<div class=\"agrmt_1st\">\r\n\t\t<!-- 전자금융거래 이용약관 -->\r\n\t\t<h4 class=\"label2 hide\" style=\"overflow:hidden;\">\r\n\t\t\t<dl>\r\n\t\t\t<dt><span langTag=\"clause.label2.normal\">Use of Financial Transactions</span></dt>\r\n\t\t\t<dd>\r\n\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk7\" id=\"inputChk7\" checked=\"checked\" disabled=\"disabled\"  tabindex=\"253\">\r\n\t\t\t\t<label for=\"inputChk7\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t</dd>\r\n\t\t\t</dl></h4>\r\n\t\t<!-- 고유식별정보 수입 및 이용안내 -->\r\n\t\t<dl class=\"label4 hide\">\r\n\t\t\t<dt><span langTag=\"clause.label4.normal\">Collection and Use of Unique Personal Information</span></dt>\r\n\t\t\t<dd>\r\n\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk2\" id=\"inputChk2\" checked=\"checked\" disabled=\"disabled\"  tabindex=\"257\">\r\n\t\t\t\t<label for=\"inputChk2\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<!-- 개인정보의 수집 및 이용안내 -->\r\n\t\t<dl class=\"label5 hide\">\r\n\t\t\t<dt><span langTag=\"clause.label5.normal\">Collection and Use of Personal Information</span></dt>\r\n\t\t\t<dd>\r\n\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk3\" id=\"inputChk3\" checked=\"checked\" disabled=\"disabled\" tabindex=\"261\">\r\n\t\t\t\t<label for=\"inputChk3\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<!-- 개인정보 제공 및 위탁안내 -->\r\n\t\t<dl class=\"label6 hide\">\r\n\t\t\t<dt><span langTag=\"clause.label6.normal\">Sharing and Consigning of Personal Information</span></dt>\r\n\t\t\t<dd>\r\n\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk4\" id=\"inputChk4\" checked=\"checked\" disabled=\"disabled\" tabindex=\"265\">\r\n\t\t\t\t<label for=\"inputChk4\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<!-- 통신과금서비스 이용약관 -->\r\n\t\t<dl class=\"label7 hide\">\r\n\t\t\t<dt><span langTag=\"clause.label7.normal\">Terms of Mobile Phone Billing Service</span></dt>\r\n\t\t\t<dd>\r\n\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk5\" id=\"inputChk5\" checked=\"checked\" disabled=\"disabled\" tabindex=\"269\">\r\n\t\t\t\t<label for=\"inputChk5\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t</div>\r\n\t<!--  //전체동의 간략 -->\r\n\t\r\n\t<!--  전체동의 더보기 -->\r\n\t<div class=\"agrmt_2nd\">\r\n\t\t<!-- 전자금융거래 이용약관 -->\r\n\t\t<dl class=\"dl_agrmt label2 hide\">\r\n\t\t\t<dt class=\"dt_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label2.normal\" tabindex=\"251\"> -->\r\n\t\t\t\t<span langTag=\"clause.label2.normal\" >Use of Financial Transactions</span>\r\n\t\t\t\t<a href=\"javascript:;\" class=\"btn_detail goDetailView1\" id=\"aDetailView1\" title=\"새창열림\" tabindex=\"254\">\r\n\t\t\t\t\t<span class=\"hidden\">자세히보기</span>\r\n\t\t\t\t</a>\r\n\t\t\t\t<span class=\"agrWrap\">\r\n\t\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk7\" id=\"inputChkDetail7\" tabindex=\"253\">\r\n\t\t\t\t\t<label for=\"inputChkDetail7\"><span langTag=\"clause.label3\"/>Agree.</span></label>\r\n\t\t\t\t</span>\r\n\t\t\t</dt>\r\n\t\t\t<dd class=\"dd_agrmt\">\r\n\t\t\t\t\r\n\t\t\t\t<span langTag=\"clause.label2.sub1\">Upon the use by the user of electronic payment gateway service and payment escrow service as provided by KG INICIS, the legal relation and basic matters of the electronic financial transaction between the company and user are defined in order to acquire service stability and reliability.</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<!-- 고유식별정보 수입 및 이용안내 -->\r\n\t\t<dl class=\"dl_agrmt label4 hide\">\r\n\t\t\t<dt class=\"dt_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label4.normal\" tabindex=\"255\"> -->\r\n\t\t\t\t<span langTag=\"clause.label4.normal\">Collection and Use of Unique Personal Information</span>\r\n\t\t\t\t<a href=\"javascript:;\" class=\"btn_detail goDetailView2\" id=\"aDetailView2\" title=\"새창열림\" tabindex=\"258\">\r\n\t\t\t\t\t<span class=\"hidden\">자세히보기</span>\r\n\t\t\t\t</a>\r\n\t\t\t\t<span class=\"agrWrap\">\r\n\t\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk2\" id=\"inputChkDetail2\" tabindex=\"257\">\r\n\t\t\t\t\t<label for=\"inputChkDetail2\"><span langTag=\"clause.label3\"/>Agree.</span></label>\r\n\t\t\t\t</span>\r\n\t\t\t</dt>\r\n\t\t\t<dd class=\"dd_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label4.sub1\" tabindex=\"256\"> -->\r\n\t\t\t\t<span langTag=\"clause.label4.sub1\">For user identification and user real name verification during the establishment, maintenance and provision processes of the service agreement, unique identification information is collected for use in electronic transaction related service provision, such as payments, delivery, consent, and withdrawals.</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<!-- 개인정보의 수집 및 이용안내 -->\r\n\t\t<dl class=\"dl_agrmt label5 hide\">\r\n\t\t\t<dt class=\"dt_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label5.normal\" tabindex=\"259\"> -->\r\n\t\t\t\t<span langTag=\"clause.label5.normal\">Collection and Use of Personal Information</span>\r\n\t\t\t\t<a href=\"javascript:;\" class=\"btn_detail goDetailView3\" id=\"aDetailView3\" title=\"새창열림\" tabindex=\"262\">\r\n\t\t\t\t\t<span class=\"hidden\">자세히보기</span>\r\n\t\t\t\t</a>\r\n\t\t\t\t<span class=\"agrWrap\">\r\n\t\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk3\" id=\"inputChkDetail3\" tabindex=\"261\"/>\r\n\t\t\t\t\t<label for=\"inputChkDetail3\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t\t</span>\r\n\t\t\t</dt>\r\n\t\t\t<dd class=\"dd_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label5.sub1\" tabindex=\"260\"> -->\r\n\t\t\t\t<span langTag=\"clause.label5.sub1\">Personal information is collected and used for user identification, authentication and real-name verification during the amount payment and payment process of goods and services purchased by users, respond and check payment detail requests, and prevent illegal use.</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<!-- 개인정보 제공 및 위탁안내 -->\r\n\t\t<dl class=\"dl_agrmt label6 hide\">\r\n\t\t\t<dt class=\"dt_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label6.normal\" tabindex=\"263\"> -->\r\n\t\t\t\t<span langTag=\"clause.label6.normal\">Sharing and Consigning of Personal Information</span>\r\n\t\t\t\t<a href=\"javascript:;\" class=\"btn_detail goDetailView4\" id=\"aDetailView4\" title=\"새창열림\"  tabindex=\"266\">\r\n\t\t\t\t\t<span class=\"hidden\">자세히보기</span>\r\n\t\t\t\t</a>\r\n\t\t\t\t<span class=\"agrWrap\">\r\n\t\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk4\" id=\"inputChkDetail4\" tabindex=\"265\"/>\r\n\t\t\t\t\t<label for=\"inputChkDetail4\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t\t</span>\r\n\t\t\t</dt>\r\n\t\t\t<dd class=\"dd_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label6.sub1\" tabindex=\"264\"> -->\r\n\t\t\t\t<span langTag=\"clause.label6.sub1\">Personal information is provided to financial and electronic transaction related payment institutions, such as credit card companies and banks, in order to execute transactions, such as authentication, settlement, cancellation and refunds upon user orders and respond and verify transaction verification requests.</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t\t\r\n\t\t<!-- 통신과금서비스 이용약관 -->\r\n\t\t<dl class=\"dl_agrmt label7 hide\">\r\n\t\t\t<dt class=\"dt_agrmt\">\r\n\t\t\t\t<!-- <span langTag=\"clause.label7.normal\" tabindex=\"267\"> -->\r\n\t\t\t\t<span langTag=\"clause.label7.normal\">Terms of Mobile Phone Billing Service</span>\r\n\t\t\t\t<a href=\"javascript:;\" class=\"btn_detail goDetailView5\" id=\"aDetailView5\" title=\"새창열림\"  tabindex=\"270\">\r\n\t\t\t\t\t<span class=\"hidden\">자세히보기</span>\r\n\t\t\t\t</a>\r\n\t\t\t\t<span class=\"agrWrap\">\r\n\t\t\t\t\t<input type=\"checkbox\" name=\"check\" class=\"inputChk5\" id=\"inputChkDetail5\" tabindex=\"269\"/>\r\n\t\t\t\t\t<label for=\"inputChkDetail5\"><span langTag=\"clause.label3\">Agree.</span></label>\r\n\t\t\t\t</span>\r\n\t\t\t</dt>\r\n\t\t\t<dd class=\"dd_agrmt\">\r\n\t\t\t\t\r\n\t\t\t\t<span langTag=\"clause.label7.sub1\">When users use the telecommunication payment service provided by KG INICIS, basic matters pertaining to the telecommunication payment service between the company and the user are decided to acquire service stability and reliability.</span>\r\n\t\t\t</dd>\r\n\t\t</dl>\r\n\t</div>\r\n\t<!--  //전체동의 더보기 -->\r\n\t<!-- 웹접근성으로 인하여 button 태그 -> input 태그로 변경 22.09.06\r\n\t<button class=\"btnAgrmt_detail_dis\" type=\"button\" tabindex=\"271\"><span class=\"hidden\">이용약관 상세보기</span></button>  -->\r\n\t<input type=\"button\" class=\"btnAgrmt_detail_dis\" tabindex=\"271\" alt=\"약관 상세보기\" title=\"약관보기 열기\" /><span class=\"hidden\">이용약관 상세보기</span>\r\n</div>\r\n<!-- //이용약관 -->\r\n\r\n<!-- 이니안심 사용여부 체크 -->\r\n\r\n\r\n<!-- 광고서비스  250917 추가 -->\r\n\r\n\r\n<script defer type=\"text/javascript\">\r\n\t$(function(){\r\n\t\t// 웹접근성 관련 추가 2022-12-20\r\n\t\t$(document).on(\"click\", \"input[type=checkbox]\", function(e){\r\n\t\t\t$(\"#\"+e.target.id).focus();\r\n\t\r\n\t\t\t//보안취약점\r\n\t\t\tif($(\"#\"+e.target.id).prop(\"checked\")){\r\n\t\t\t\t$payForm.find(\"input[name=\"+e.target.id+\"Check]\").val(\"T\");\r\n\t\t\t}else{\r\n\t\t\t\t\r\n\t\t\t\tif(e.target.id != \"inputAll\"){\r\n\t\t\t\t\t$payForm.find(\"input[name=inputAllCheck]\").val(\"\");\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t$payForm.find(\"input[name=\"+e.target.id+\"Check]\").val(\"\");\r\n\t\t\t}\r\n\t\t});\r\n\t\t\r\n\t\t\r\n\t\t\r\n\t/* \t$(document).on(\"click\", \"#inputAll\", function(e){\r\n\t\t\t$(\"#inputAll\").focus();\r\n\t\t\tconsole.log(\"전체동의 클릭\");\r\n\r\n\t\t\t$payForm.find(\"input[name=agreeAll]\").val(true);\r\n\t\t});\r\n\t\t\r\n\t \t$(document).on(\"click\", \"#inputChk7\", function(e){\r\n\t\t\t$(\"#inputChk7\").focus();\r\n\t\t\tconsole.log(\"전자금융거래 이용약관 클릭\");\r\n\t\t\t\r\n\t\t\t$payForm.find(\"input[name=agree7]\").val(true);\r\n\t\t});\r\n\t\t\r\n\t\t$(document).on(\"click\", \"#inputChk3\", function(e){\r\n\t\t\t$(\"#inputChk3\").focus();\r\n\t\t\tconsole.log(\"개인정보 수집 이용약관 클릭\");\r\n\t\t\t\r\n\t\t\t$payForm.find(\"input[name=agree3]\").val(true);\r\n\t\t});\r\n\t\t\r\n\t\t$(document).on(\"click\", \"#inputChk4\", function(e){\r\n\t\t\t$(\"#inputChk4\").focus();\r\n\t\t\tconsole.log(\"개인정보 제공 이용약관 클릭\");\r\n\t\t\t\r\n\t\t\t$payForm.find(\"input[name=agree4]\").val(true);\r\n\t\t\t\r\n\t\t}); */\r\n\t\t\r\n\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\t\t\r\n\t\tif($(\"#curPage\").val() == \"Card\" || $(\"#curPage\").val() == \"Gift\") {\r\n\t\t\tif(isFlgUseProvision) {\r\n\t\t\t\t$(\".agr_utilzr_dis\").hide();\r\n\t\t\t} else {\r\n\t\t\t\t$(\".agr_utilzr_dis\").removeClass(\"agr_utilzr_dis\").addClass(\"agr_utilzr\");\r\n\t\t\t\t$(\".btnAgrmt_detail_dis\").removeClass(\"btnAgrmt_detail_dis\").addClass(\"btnAgrmt_detail\");\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tisCompensateChk = false;\r\n\t\t\t$(\".ban_ini\").removeClass(\"dis_ini\");\r\n\t\t\t$(\"input[name=check]\").prop(\"disabled\", false);\r\n\t\t\t$(\"input[name=check]\").prop(\"checked\", false);\r\n\t\t} else {\r\n\t\t\tif(isFlgUseProvision) {\r\n\t\t\t\t$(\".agr_utilzr_dis\").hide();\r\n\t\t\t} else {\r\n\t\t\t\t$(\".agr_all\").css(\"display\", \"none\");\r\n\t\t\t\tif(languageView == \"ko\") {\r\n\t\t\t\t\tjQuery(\".btnAgrmt_detail_dis\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ko.png)\"});\r\n\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\tjQuery(\".btnAgrmt_detail_dis\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_en.png)\"});\r\n\t\t\t\t}else if(languageView == \"cn\"){\r\n\t\t\t\t\tjQuery(\".btnAgrmt_detail_dis\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ch.png)\"});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t$(\".btnAgrmt_detail_dis\").css(\"cursor\", \"default\").prop(\"disabled\", true);\r\n\t\t\t$(\".ico_qes, .mL9\").css(\"cursor\", \"default\").removeClass(\"goOpenWindow\").removeAttr(\"tabIndex\");\r\n\t\t}\r\n\t\t\r\n\t\tif(languageView == \"ko\") {\r\n\t\t\tjQuery(\".ban_ini\").removeClass(\"hide\");\r\n\t\t\tjQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ko.png)\"});\r\n\t\t}else if(languageView == \"en\"){\r\n\t\t\tjQuery(\".ban_ini\").removeClass(\"hide\");\r\n\t\t\tjQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_en.png)\"});\r\n\t\t}else if(languageView == \"cn\"){\r\n\t\t\tjQuery(\".ban_ini\").removeClass(\"hide\");\r\n\t\t\tjQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ch.png)\"});\r\n\t\t}\r\n\t\t\r\n\t\t// 손실보험 체크여부\r\n\t\tif(isCompensateChk) {\r\n\t\t\t$(\"#inputChk6\").prop(\"checked\", true);\r\n\t\t}\r\n\t\t\r\n\t\t// 이용약관 상세보기 버튼, 구분선 기준정보에서 제공한 색상으로 변경\r\n\t\t$(\".agr_utilzr\").css(\"border-bottom-color\", $(\"input[name=colorView]\").val());\r\n\t\t$(\".btnAgrmt_detail\").css(\"background-color\", $(\"input[name=colorView]\").val());\r\n\t});\r\n</script>\t\r\n\t\t</div>\r\n\t\t\r\n\t\t<!-- 페이,카드,할부 -->\r\n\t\t<div class=\"sec_pay\">\r\n\t\t\t<div class=\"curtain\"></div>\r\n\t\t\t\r\n\t\t\t<div class=\"payWrap\">\r\n\t\t\t\t<div>\r\n\t\t\t\t\t<!-- 포커스 -->\r\n\t\t\t\t\t\r\n\t\t\t\t\t<!-- //포커스 -->\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t<!-- 카드-->\r\n\t\t\t<div class=\"crdWrap\">\r\n\t\t\t\t<!-- 포커스 -->\r\n\t\t\t\t<ul>\r\n\t\t\t\t\t\r\n\t\t\t\t</ul>\r\n\t\t\t\t\r\n\t\t\t\t<!-- 일반 카드 -->\r\n\t\t\t\t\r\n\t\t\t\t\t<ul>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<!--\r\n\t\t\t\t\t\t\t2016.05.25 WCCHOI\r\n\t\t\t\t\t\t\tDESC: test 기존에 3번째것만 class 적용 -->\r\n\t\t\t\t\t\t\t \r\n\t\t\t\t\t\t\t \r\n\t\t\t\t\t\t\t  \r\n\t\t\t\t\t\t\t \r\n\t\t\t\t\t\t\t<li class=\"li_pay  \">\r\n\t\t\t\t\t\t\t\t<div class=\"btnPaymntwarp\">\r\n\t\t\t\t\t\t\t\t\t<a class=\"btnPaymnt btn_short\" href=\"javascript:;\" id=\"cardCode20\"  title=\"UnionPay \" aria-label=\"UnionPay\">\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"radio\" id=\"26\" name=\"cardCode\" class=\"hide\" value=\"26\" cardType=\"union\" />\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"card_name\" langTag=\"card.label2.card1.26\">UnionPay</span>\r\n\t\t\t\t\t\t\t\t\t\t<img src=\"https://stdux.inicis.com/stdpay/img/cardIcon/card_26_new.png\" class=\"img_crd\" alt=\"\">\r\n\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t<div class=\"pay_icoWrap\">\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t<!-- 현대카드 1만원 무이자 여부  -->\r\n\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t <input type=\"hidden\" id=\"cardCode2Count\" value=\"0\"/>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t</ul>\r\n\t\t\t\t\r\n\t\t\t\t<div class=\"extraCardTotal\">\r\n\t\t\t\t<!-- 그외카드 -->\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\t<div class=\"extraCardText\"><span class=\"bold\" langTag=\"card.label12\">Interest-free installment plan varies by card issuers<br/>Corporate, Debit, Gift cards and non-BC bank cards are excluded</span></div>\r\n\t\t\t\t\r\n\t\t\t\t\t<!-- 현대카드 1만원 무이자 여부  -->\r\n\t\t\t\t\r\n\t\t\t\t<input type=\"radio\" id=\"cardCodeEct\" name=\"cardCode\" value=\"\" class=\"hide\" isp=false title=\"\" />\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t\r\n\t\t\t<input type=\"radio\" name=\"cardCode\" id=\"oneClick\" class=\"hide\" value=\"easyPay\">\r\n\t\t\t<!-- //페이,카드,할부 -->\r\n\t\t\t\r\n\t\t\t<!-- 할부선택 및 아이콘설명-->\r\n\t\t\t<div class=\"etcWrap\">\r\n\t\t\t\t<!-- 할부선택 -->\r\n\t\t\t\t<div class=\"hide\" id=\"cardQuotaView\">\r\n\t\t\t\t\t<dl class=\"dropdown\" id=\"cardQuota\">\r\n\t\t\t\t\t\t<dt title=\"할부기간선택\"></dt>\r\n\t\t\t\t\t\t<dd>\r\n\t\t\t\t\t\t\t<div class=\"innerBox\">\r\n\t\t\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</dd>\r\n\t\t\t\t\t</dl>\r\n\t\t\t\t\t<input type=\"text\" name=\"cardQuota\" class=\"hide\" value=\"00\"/>\r\n\t\t\t\t</div>\r\n\t\t\t\t<!-- //할부선택 -->\r\n\t\t\t\t\r\n\t\t\t\t<ul class=\"ul_item\">\r\n\t\t\r\n\t\t\t\t<!-- Lpoint 추가 2017-12-07 -->\r\n\t\t\t\t\t\r\n\t\t\t\t<!-- Lpoint 추가 2017-12-07 -->\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t</ul>\r\n\t\t\t\t\t\t\r\n \t\t\t\t<ul class=\"ul_item\">\r\n \t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t<!-- 현대카드 1만원 무이자 여부  -->\r\n\t\t\t\t\t\r\n\t\t\t\t</ul>\r\n\t\t\t</div>\r\n\t\t\t<!--  할부선택 및 아이콘설명 -->\r\n\t\t\t\r\n\t\t\t<!-- 페이-->\r\n\t\t\t<div class=\"payWrap\">\r\n\t\t\t\t<div>\r\n\t\t\t\t\t<div>\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<!-- 일반 페이 -->\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<!-- //일반 페이 -->\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<!-- 기타 페이 -->\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t<!-- //기타 페이 -->\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t\t<input type=\"radio\" id=\"payCodeEct\" name=\"cardCode\"  value=\"\" class=\"hide\" isp=false title=\"\" />\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<!-- //페이-->\r\n\t\t\t\r\n\t\t</div>\r\n\t\t<!-- //페이,카드,할부 -->\r\n\t\t\r\n\t\t<!-- 하단배너-->\r\n\t\t<div id=\"bannerBottomSection\">\r\n\t\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- 배너-->\r\n\r\n\r\n<div class=\"btmBnr\" id=\"centerBnr\" >\r\n\t<div class =\"std_ad_center_area\">\r\n\t\t\r\n\t\t\t<a href=\"javascript:;\" title=\"새창 열림\" style=\"outline-offset:-2px;\" onclick=\"bannerClick('https://inicis-service.inicis.com/?page_id=760/');\">\r\n\t\t\t\t<img src=\"https://ds-cdn.inicis.com/ad/std/2026/0109/ad_bnr_mb_01.png\" alt=\"계좌인증서비스\" name=\"centerAdBanner\" border=\"0\" width=\"490\" height=\"50\" style=\"border: 0; width: 490px; height: 50px;\"/> \r\n\t\t\t</a>\r\n\t\t\r\n\t\t\t<a href=\"javascript:;\" title=\"새창 열림\" style=\"outline-offset:-2px;\" onclick=\"bannerClick('https://inicis-service.inicis.com/');\">\r\n\t\t\t\t<img src=\"https://ds-cdn.inicis.com/ad/std/2026/0109/ad_bnr_mb_02.png\" alt=\"이니백과\" name=\"centerAdBanner\" border=\"0\" width=\"490\" height=\"50\" style=\"border: 0; width: 490px; height: 50px;\"/> \r\n\t\t\t</a>\r\n\t\t\r\n\t\r\n\t\t\r\n\t\t\t<!-- 컨트롤러 영역 -->\r\n\t\t\t<div class=\"slider_controls\">\r\n\t\t\t\t<button class=\"playPauseBtn toggle-btn\" id=\"centerPlayPauseBtn\" type=\"button\" aria-pressed=\"false\" onclick=\"autoImg('center')\">\r\n\t\t\t\t\t<span class=\"icon-play\" aria-hidden=\"true\">▶</span>\r\n\t\t\t\t\t<span class=\"icon-pause\" aria-hidden=\"true\" style=\"display: none; gap: 1px; font-size: 8px;\"><b>I</b><b>I</b></span>\r\n\t\t\t\t</button>\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t<div class=\"page_controls\">\r\n\t\t\t\t\t<button class=\"nav_button\" id=\"centerPrevBtn\" type=\"button\" aria-label=\"이전 슬라이드 버튼\" onclick=\"movePrev(true,'center')\"><strong>&lt;</strong></button>\r\n\t\t\t\t\t\r\n\t\t\t\t\t<span class=\"page_number\">\r\n\t\t\t\t\t\t<strong class=\"current\" id=\"centerCurrent\">1</strong>I<span class=\"total\" id=\"centerTotal\">2</span>\r\n\t\t\t\t\t</span>\r\n\t\t\t\t\t\r\n\t\t\t\t\t<button class=\"nav_button\" id=\"centerNextBtn\" type=\"button\" aria-label=\"다음 슬라이드 버튼\" onclick=\"moveNext(true,'center')\"><strong>&gt;</strong></button>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t\t\t\t\r\n\t</div>\r\n</div> \r\n<script type=\"text/javascript\">\r\n\tvar bnrView = $(\"#bnrView\").val();\r\n\tvar strAcceptMethod = $payForm.find(\"input[name=acceptmethod]\").val();\r\n\tif(bnrView === 'false'|| strAcceptMethod.indexOf(\"no_banner\") > -1){\r\n\t\t$(\".btmBnr\").addClass('hide');\r\n\t}else{\r\n\t\t//다이렉트 결제로 호출되는 경우 결제창 광고 롤링 처리 안되게끔 처리 260123\r\n\t\tvar getPopWrap = $(\".popWrap\").css(\"display\");\r\n\t\t\r\n\t\tif(getPopWrap == 'block'){\r\n\t\t\tvar btmImgs = $('#centerBnr a img');\r\n\t\t\tvar btmImgCt = btmImgs.length;\r\n\t\t\t\r\n\t\t\tbtmImgs.hide().eq(0).show();\r\n\t\t\t\r\n\t\t\tif(btmImgCt > 1){\r\n\t\t\t\tvar banners = document.querySelectorAll(\"#centerBnr\");\r\n\t\t        for (var i = 0; i < banners.length - 1; i++) {\r\n\t\t            banners[i].parentNode.removeChild(banners[i]);\r\n\t\t        }\r\n\r\n\t\t        // 상태 초기화\r\n\t\t        resetBannerState('center');\r\n\t\t\t\tstartBanner('center');\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n</script>\r\n<!-- //배너-->\r\n\t\t</div>\r\n\t\t\r\n\t\t<!-- 공지사항 -->\r\n\t\t<div id=\"noticeSection\">\r\n\t\t\t\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- notice-->\r\n<div class=\"noti_bar\">\r\n\t<marquee id=\"mqButton\" width=\"475\" height=\"30\" behavior=\"scroll\" direction=\"left\" scrollamount=\"3\" style=\"margin-top: 4px;\">\r\n\t\t\r\n\t\t<!-- 신규 가맹점 홍보노출 -->\r\n\t\t\r\n\t\r\n\t\t<!-- notice -->\r\n\t\t\r\n\t</marquee>\r\n</div>\r\n<!-- //notice-->\r\n\r\n<script defer type=\"text/javascript\">\r\n\t$(function(){\t\t\r\n\t\t// 공지사항 속도 설정\r\n\t\t$('marquee').attr(\"scrollamount\", \"6\");\r\n\t\t\r\n\t\t// 신규 가맹점 바로가기 버튼\r\n\t\tjQuery(document).on(\"click\",\"#linkButton\", function(){\r\n\t\t\twindow.open(jQuery(this).attr(\"src\"),\"stdOpen\",\"\");\r\n\t\t});\r\n\t\t\r\n\t\tvar count = 0;\r\n\t\t$(document).on(\"click\",\"#mqButton\", function(e){\r\n\t\t\tcount++;\r\n\t\t\tvar isEven = function(someNumber) {\r\n\t\t\t\treturn (someNumber % 2 === 0) ? true : false;\r\n\t\t\t};\r\n\t\t\tif (isEven(count) === false) {\r\n\t\t\t\t$('marquee').trigger('stop');\r\n\t\t\t\t$(this).child\r\n\t\t\t} else if (isEven(count) === true) {\r\n\t\t\t\t$('marquee').trigger('start');\r\n\t\t\t}\r\n\t\t\t$(this).toggleClass(\"pause\");\r\n\t\t});\r\n\t});\r\n</script>\t\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\t\r\n<div class=\"hide pointOk\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div id=\"point_popup2\">\r\n\t<span style=\"opacity:0;position:absolute;top:-9999px;filter: alpha(opacity=0);-ms-filter:progid:DXImageTransform.Microsoft.Alpha(Opacity=0);-moz-opacity:0;-khtml-opacity:0\">\r\n\t\t<input type=\"text\" id=\"inputFocusPointPopup2\" maxlength=\"0\" tabindex=\"600\"/>\r\n\t</span>\t\r\n \t<div class=\"popLayer\" style=\"width:310px; height:129px; margin:-95px 0 0 -180px;\"><!--padding:30px 24px; -->\r\n\t\t<p class=\"copy02 txtC bold\"><span langTag=\"popup.label3.sub1\" tabindex=\"601\">Do you want to use the card reward points?</span></p>\r\n\t\t<p class=\"copy03 txtC\"><span langTag=\"popup.label1.sub2\" tabindex=\"602\"><font size=\"2px\" color=\"#FF5E00\">When you pay with card points, the redeemable points will be deducted. The insufficient points will covered by card payment.</font></span></p>\r\n\t\t<div class=\"btnWrapC\">\t\t\t\r\n\t\t\t<a href=\"#none\" id=\"useCp\" class=\"btnType07\" tabindex=\"603\"><span class=\"boldNo\" langTag=\"popup.label4.sub1\">Yes</span></a>\r\n\t\t</di