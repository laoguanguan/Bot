ar popUseragent = navigator.userAgent;\r\n//\t\t\t\t\t\tvar winpopup = window.open(url, name, options);\r\n\r\n\t\t\t\t\t\tif( !win ){\r\n\r\n\t\t\t\t\t\t\tvar alertMsg = \"\";\r\n\r\n\t\t\t\t\t\t\tif(popUseragent.indexOf(\"Firefox\")>-1 || popUseragent.indexOf(\"Chrome\")>-1 || popUseragent.indexOf(\"Safari\")>-1 || popUseragent.indexOf(\"Edg\")>-1) {\r\n\t\t\t\t\t\t\t\talertMsg = INImsg.alert_popup_check2;\t\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\talertMsg = INImsg.alert_popup_check1;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tjAlert(alertMsg, \"KG이니시스\", function(r) {\r\n\t\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\r\n\t\t\t\t\t\t\t\tif(typeof(win)!='undefined' || !win.closed) {\r\n\t\t\t\t\t\t\t\t\twin.close();\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t});\r\n\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t} else{\r\n\t\t\t\t\t\t\tvar setInter = setInterval(function(){\r\n//\t\t\t\t\t\t\t\twin.focus();\r\n\t\t\t\t\t\t\t\tif(typeof(win)=='undefined' || win.closed) {\r\n\r\n\t\t\t\t\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\t\thideLoading();\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t},2000);\r\n\r\n\t\t\t\t\t\t\t$payForm.attr(\"target\",\"newFrame\");\r\n\t\t\t\t\t\t}\r\n\r\n\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//CJW 2016.08.10 신한 크롬 이슈로 인하여 생성(프레임생성)\r\n\t\t\t\t\t\tsetIframe();\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t//jQuery(\"#overlay_subWapper .overlayFrame\").attr(\"src\",\"\");\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tjQuery(\"#overlay_subWapper .overlayFrame\").css({\"width\": w + \"px\",\"height\": h + \"px\"});\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tjQuery(\"#overlay_subWapper\").css({\"margin\": m +\"px auto\"});\r\n\r\n\t\t\t\t\t\tjQuery(\"#overlay_subWapper\").css({\"width\":(jQuery(\"#overlay_subWapper .overlayFrame\").width()+2)+\"px\",\"height\":(jQuery(\"#overlay_subWapper .overlayFrame\").height()+37)+\"px\"});\r\n\r\n\t\t\t\t\t\toverlayOnOff(true);\r\n\r\n\t\t\t\t\t\t$payForm.attr(\"target\",\"overlayFrame\");\r\n\t\t\t\t\t\tvar intervalcnt = 0; \r\n\t\t\t\t\t\tvar setInter = setInterval(function(){\r\n\t\t\t\t\t\t\tintervalcnt ++;\r\n\r\n\t\t\t\t\t\t\tif(jQuery('#overlayFrame').length > 0) {\r\n\t\t\t\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\t\t\t\tsetIframeCloseBtn();\r\n\t\t\t\t\t\t\t\tjQuery('#overlayFrame').attr(\"tabindex\", \"399\");\r\n\t\t\t\t\t\t\t}else if(intervalcnt > 5){\r\n\t\t\t\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t},2000);\r\n\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t*/\r\n\t\t\t\t\t\r\n\t\t\t\t\t\t//var win = '';\r\n\t\t\t\t\t\t\r\n//\t\t\t\t\t\t// Fixes dual-screen position                         Most browsers      Firefox\r\n\t\t\t\t\t    var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;\r\n\t\t\t\t\t    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;\r\n\r\n\t\t\t\t\t    width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t\t\t\t\t    height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\r\n\t\t\t\t\t    var left = ((width / 2) - (w / 2)) + dualScreenLeft;\r\n\t\t\t\t\t    var top = ((height / 2) - (h / 2)) ;\r\n\r\n\r\n\t\t\t\t\t    ispWin = window.open(\"../checkWin.jsp\",\"newFrame\",\"width=\" + w + \"px,height=\" + h + \"px,resizable=yes,scrollbars=no,top=\"+top+\",left=\"+left+\",modal=yes\");\r\n\r\n\t\t\t\t\t\t// set user-agent\r\n\t\t\t\t\t\tvar popUseragent = navigator.userAgent;\r\n\r\n\t\t\t\t\t\tif( !ispWin ){\r\n\r\n\t\t\t\t\t\t\tvar alertMsg = \"\";\r\n\r\n\t\t\t\t\t\t\tif(popUseragent.indexOf(\"Firefox\")>-1 || popUseragent.indexOf(\"Chrome\")>-1 || popUseragent.indexOf(\"Safari\")>-1 || popUseragent.indexOf(\"Edg\")>-1) {\r\n\t\t\t\t\t\t\t\talertMsg = INImsg.alert_popup_check2;\t\r\n\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\talertMsg = INImsg.alert_popup_check1;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tjAlert(alertMsg, \"KG이니시스\", function(r) {\r\n\t\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\r\n\t\t\t\t\t\t\t\tif(typeof(ispWin)!='undefined' || !ispWin.closed) {\r\n\t\t\t\t\t\t\t\t\tispWin.close();\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t});\r\n\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t} else{\r\n\t\t\t\t\t\t\tvar setInter = setInterval(function(){\r\n//\t\t\t\t\t\t\t\twin.focus();\r\n\t\t\t\t\t\t\t\tif(typeof(ispWin)=='undefined' || ispWin.closed) {\r\n\t\t\t\t\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\t\thideLoading();\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t},2000);\r\n\r\n\t\t\t\t\t\t\t$payForm.attr(\"target\",\"newFrame\");\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t$payForm.attr(\"action\",\"/payAuthentication/kbapp\");\r\n\t\t\t\t\t$payForm.trigger(\"submit\");\r\n\r\n\t\t\t\t}else if(jsonData['resultCode'] == 'A821'){\r\n\t\t\t\t\tcallReturnSubmit(\"/payMain/fake\");\r\n\t\t\t\t}else{\r\n\t\t\r\n\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\t\t\tjAlert(jsonData['resultMsg'], \"KG이니시스\", function(r) {\r\n\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t\t\t});\t\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tcallAlert(jsonData['resultMsg']);\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\talert(\"[Connection Failure]\"+errorThrown);\r\n\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t, complete:function(jqXHR,status){\r\n\t\t\t\thideLoading()\r\n\t\t\t}\r\n\t});\r\n}\r\nfunction popupOpen(){\r\n\t\tvar w= 350;\r\n\t\tvar h= 160;\r\n\t\tvar url = 'https://stdpay.inicis.com/popup/windowIEinfo.html';\r\n\r\n\t\t// Fixes dual-screen position                         Most browsers      Firefox\r\n\t    var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;\r\n\t    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;\r\n\r\n\t \tvar width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t    var height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\r\n\t    var left = ((width / 2) - (w / 2)) + dualScreenLeft;\r\n\t    var top = ((height / 2) - (h / 2)) ;\r\n\r\n\t\twindow.open(url,\"\",\"width=\"+ w +\"px,height=\"+ h +\"px,resizable=yes,scrollbars=no,top=\"+top+\",left=\"+left+\",modal=yes\");\r\n\r\n}\r\nfunction popupClose(){\r\n\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\tlocation.href = closeUrl;\r\n}\r\n\r\nfunction popupKeepGoing(){\r\n\r\n\tvar cardCode  = $payForm.find(\"[name=ini_cardcode]\").val();\r\n\tvar cardQuota = $payForm.find(\"[name=ansim_quota]\").val();\r\n\tvar gopaymethod = $payForm.find(\"[name=gopaymethod]\").val();\r\n\r\n\tif((gopaymethod ==\"onlyisp\" || gopaymethod ==\"onlyvcard\") && $payForm.find(\"[name=payPopup]\").val()==\"2\" ){\r\n\t\t$(\"#cardCodeEct\").val(cardCode);\r\n\t\t$(\"#cardCodeEct\").attr('cardType',\"isp\");\r\n\t\t$(\"#cardCodeEct\").attr('checked',true);\r\n\t\t//포인트 사용 가능할때만\r\n\t\tif( $payForm.find(\"input[name=cardPointList]\").val() !=null && $payForm.find(\"input[name=cardPointList]\").val().indexOf(cardCode) >= 0){\r\n\t\t\tif($payForm.find(\"[name=acceptmethod]\").val().indexOf(\"usespcp\") >= 0){\r\n\r\n\t\t\t\tmakePointPopup(\"ISP\",cardCode);\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n// \t\t\t포인트 팝업 보여줄까?말까?\r\n\t\t\tif($payForm.find(\"[name=acceptmethod]\").val().indexOf(\"usenospcp\") < 0){\r\n\t\t\t\t$(\"[name=CARD_Point]\").val(\"1\");\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif($payForm.find(\"input[name=KBAPP]\") != null && $payForm.find(\"input[name=KBAPP]\").val() =='KBAPP'\r\n\t\t\t&& cardCode == '06'){\r\n\r\n\t\t\t\tcallkbAppPopup();\r\n\r\n\r\n\t\t}else{\r\n\t\t\tcallISP();\r\n\t\t}\r\n\r\n\t}else if(gopaymethod == \"onlyacard\" && $payForm.find(\"[name=payPopup]\").val()==\"2\"){\r\n\r\n\t\t$(\"#cardCodeEct\").val(cardCode);\r\n\t\t$(\"#cardCodeEct\").attr('cardType',\"visa3d\");\r\n\t\t$(\"#cardCodeEct\").attr('checked',true);\r\n\t\t$(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li a.\" + cardCode + \"\").parent(\"li\").html());\r\n\t\tif($(\"#spanSelectCardCode .dropdown dt\").find(\"img\").length == 0) {\r\n\t\t\t$(\"#spanSelectCardCode .dropdown dt\").find(\"span:eq(1)\").removeClass(\"ellipsis\");\r\n\t\t}\r\n\t\t$(\"#spanSelectCardCode .dropdown dt a\").addClass(\"selected\");\r\n\t\t$(\"#spanSelectCardCode .dropdown dt a.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\r\n\t\t//포인트 사용 가능할때만\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(cardQuota);\r\n\t\tif( $payForm.find(\"input[name=cardPointList]\").val() !=null && $payForm.find(\"input[name=cardPointList]\").val().indexOf(cardCode) >= 0){\r\n\t\t\tif($payForm.find(\"[name=acceptmethod]\").val().indexOf(\"usespcp\") >= 0){\r\n\t\t\t\tmakePointPopup(\"VISA3D\",cardCode);\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tif($payForm.find(\"[name=acceptmethod]\").val().indexOf(\"usenospcp\") < 0){\r\n\t\t\t\t$(\"[name=CARD_Point]\").val(\"1\");\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\t\t\tcallVisa3d(cardCode);\r\n\r\n\t}\r\n}\r\n////////////////////////////////////////////////////\r\n//할부 개월에 선택 결제 수단에 따른 무이자 표시\r\n///////////////////////////////////////////////////\r\nfunction setCardNoInterestText(obj){\r\n\tvar cardCode = jQuery(obj).val();\r\n\t\r\n\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\tif(jQuery(\"#ispPluginAlert\").size() > 0){\r\n\t\tif(boolMobile && $payForm.find(\"input[name=cardSelectIsp]\").val().indexOf(cardCode) >= 0){\r\n\t\t\tjQuery(\"#ispPluginAlert\").show();\r\n\t\t}else{\r\n\t\t\tjQuery(\"#ispPluginAlert\").hide();\r\n\t\t}\r\n\t}\r\n\t\r\n\t//해외카드면 숨김...\r\n\tif($payForm.find(\"input[name=cardCodesNormal]\").val() != null){\r\n\t\tif($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf(cardCode) >= 0){\r\n\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\treturn;\r\n\t\t}\r\n\t}\r\n\t\r\n\t//OS를 체크해서 만약 OS MAC일경우 ...VCard(ISP)도 할부선택 가능하도록...\r\n//\tvar request_os = window.navigator.appVersion.toLocaleUpperCase();\r\n//\tvar boolMac = false;\r\n//\tif(request_os.indexOf('MAC OS') > -1 || request_os.indexOf('MACINTOSH') > -1){\r\n//\t\tboolMac = true;\r\n//\t}\r\n\t\r\n\tif(\"\"==cardCode || \"iniPoint\"==cardCode){\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n//\tindexOf 함수 호출이 불가능하여 수정 간편결제일 경우 결제타입이 easyPay만 체크하면 됨\r\n//\t}else if($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf(jQuery(obj).val()) >= 0\r\n//\t\t|| jQuery(obj).val() == \"easyPay\" // 간편결제\r\n//\t){\r\n\t} else if(jQuery(obj).val() == \"easyPay\") {// 간편결제\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if(jQuery(obj).val() == \"Swallet\"){// 에스월렛\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if(jQuery(obj).val() ==\"Paypin\"){//페이핀\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if(jQuery(obj).val()==\"Kpay\"){//케이페이\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if(jQuery(obj).val()==\"Ssp\"){//삼성페이\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} /*else if($payForm.find(\"[name=cardCode]:checked\").attr(\"cardType\") == \"isp\"){\r\n\t\t//isp 카드 화면에서 할부개월 선택 로직 변경으로 기존 로직 주석처리 240821\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t}*/ else if($payForm.find(\"[name=cardCode]:checked\").attr(\"cardType\") ==\"union\"){//은련카드\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if($payForm.find(\"[name=cardCode]:checked\").attr(\"cardType\") ==\"oneClick\"){//은련카드\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t}else if($payForm.find(\"[name=cardCode]:checked\").val() ==\"payco\"){//payco\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t}else if($payForm.find(\"[name=cardCode]:checked\").attr(\"cardType\") ==\"kakaopay\"){//lpay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t}else if($payForm.find(\"[name=cardCode]:checked\").attr(\"cardType\") ==\"lpay\"){//lpay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if($payForm.find(\"[name=cardCode]:checked\").attr(\"cardType\") ==\"ssgpay\"){//ssgpay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if($payForm.find(\"[name=cardCode]:checked\").val() ==\"tosspay\"){//tosspay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if($payForm.find(\"[name=cardCode]:checked\").val() ==\"naverpay\"){//naverpay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if($payForm.find(\"[name=currency]\").val() == 'WON' && Number($payForm.find(\"input[name=price]\").val()) < 50000 && cardCode != \"04\"){//현재카드 1만원 할부관련\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if($payForm.find(\"[name=cardCode]:checked\").val() ==\"chaipay\"){//chaipay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if($payForm.find(\"[name=cardCode]:checked\").val() ==\"tmoneypay\"){//tmoneypay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if(jQuery(obj).val()==\"ssgpay\"){//ssgpay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t} else if(jQuery(obj).val() == \"pinpay\"){ //pinpay\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t}else{\r\n\t\t/* 현대카드 18개월 노출 주석처리\r\n\t\tvar quotaBaseArray = null;\r\n\t\r\n\t\tvar hdCardCode = \"04\";\r\n\t\tif(cardCode == hdCardCode){\r\n\t\t\t/*1. quotabase에 2:3:4:5:6:11:12까지 올라왔을 때 \r\n\t\t\t\t 해당 가맹점 maxQuota보고 현대카드 18개월 까지 존재해있으면 13~18개월수 까지 추가\r\n\t\t\t\r\n\t\t\t  $payForm.find(\"name=[cardMaxQuotaList]\") ->  가맹점 기준정보 카드별사 최소 최대 할부 개월 셋팅 값\r\n\t\t\t  $payForm.find(\"name=[quotabase]\") -> 가맹점에서 올려준 카드할부 개월 수\r\n\t\t\t  \r\n\t\t\t*/\r\n\t\t\t\r\n\t\t/*\r\n\t\t\tvar getMaxQuotaArray = $payForm.find(\"[name=cardMaxQuotaList]\").val().split('&');\r\n\t\t\tvar getMaxQuotaList = null;\r\n\t\t\tvar getMaxQuota = null;\r\n\t\t\t\r\n\t\t\t//가맹점 기준정보에 셋팅된 maxQuota \r\n\t\t\tif(getMaxQuotaArray.length > 0){\r\n\t\t\t\tfor(var i = 0; i < getMaxQuotaArray.length; i++){\r\n\t\t\t\t\t\r\n\t\t\t\t\t//04=18:12\r\n\t\t\t\t\tvar getCardArr = getMaxQuotaArray[i];\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(jQuery.trim(getCardArr).length > 0){\r\n\t\t\t\t\t\tvar getCard = getCardArr.split(\"=\");\r\n\t\t\t\t\t\t//가져온 카드 코드가 현대카드와 동일하면\r\n\t\t\t\t\t\tif(getCard[0] == hdCardCode){\r\n\t\t\t\t\t\t\tgetMaxQuotaList = getCard[1].split(\":\");\r\n\t\t\t\t\t\t\t//현대카드 최대할부개월 수 \r\n\t\t\t\t\t\t\tgetMaxQuota = getMaxQuotaList[0];\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//가맹점 인입된 할부개월\r\n\t\t\tvar getStoreQuotaArray = $payForm.find(\"[name=quotabase]\").val().split(\":\");\r\n\t\t\tconsole.info(\"getStoreQuotaArray :: \" + getStoreQuotaArray);\r\n\t\t\tvar getStoreMaxQuota = null;\r\n\t\t\tvar setStoreMaxQuota = null;\r\n\t\t\t\r\n\t\t\tif(getStoreQuotaArray.length > 0){\r\n\t\t\t\t\r\n\t\t\t\tvar sortArr = getStoreQuotaArray;\r\n\t\t\t\t\r\n\t\t\t\t//가맹점에서 인입된 할부개월 수 중 12개월 포함, 가맹점 기준정보 현대카드 할부개월 멕시멈 18이면\r\n\t\t\t\tif(sortArr.indexOf('12') > -1 && getMaxQuota == '18'){\r\n\t\t\t\t\tvar setArr = new Array('13','14','15','16','17','18');\r\n\t\t\t\t\t\r\n\t\t\t\t\tfor(var j = 0; j < setArr.length; j++){\r\n\t\t\t\t\t\tif(sortArr.indexOf(setArr[j]) > -1){\r\n\t\t\t\t\t\t\tsetArr.splice(j,0);\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tsortArr.push(setArr[j]);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\t//정렬\r\n\t\t\t\t\tsetStoreMaxQuota = sortArr.sort(function(f,s) {return f-s});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tquotaBaseArray = setStoreMaxQuota;\r\n\t\t}\r\n*/\r\n\t\t\r\n\t\t//카드코드 별 quotabase 가져오기\r\n\t\t//우리비씨  경우 BC와 동일한 무이사 사용을 위해 변경\r\n\t\tif(cardCode == \"38\"){\r\n\t\t\tcardCode = \"11\";\r\n\t\t}\r\n\t\t\r\n\t\tjQuery(\"#cardQuotaView\").show();\r\n\t\t\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\r\n\t\tvar cardNoInterestText =\"\";\r\n\t\t\r\n\t\t//모든 금액 정리된 값\r\n\t\tvar allPrice= Number($payForm.find(\"input[name=price]\").val());\r\n\t\tvar lpointPrice = 0;\r\n\t\tvar couponPrice = 0;\r\n\t\tif(Number($('[name=lpoint]').val()) > 0 ){\r\n\t\t\tlpointPrice = Number($('[name=lpoint]').val());\r\n\t\t\tallPrice = allPrice - lpointPrice;\r\n\t\t}\r\n\t\t \r\n\t\t//쿠폰 사용여부 체크\r\n\t\tif($(document).find(\"input[name=couponInfo]\").val() != '' && $(\"#overlay_popup2\").find(\"input:radio[name=selCoupon]:checked\").val() != null){\r\n\t\t\t//현재 사용중인 쿠폰 시퀀스\r\n\t\t\tvar type = $(\"#overlay_popup2\").find(\"input:radio[name=selCoupon]:checked\").val();\r\n\t\t\t//현재 사용중인 쿠폰 금액\r\n\t\t\t couponPrice = Number($(document).find(\"#\"+type+\"\").val());\t\r\n\t\t\t allPrice = allPrice - couponPrice;\r\n\t\t}\r\n\t\t \r\n\r\n//\t\t var data1 = \"\";\r\n//\t\t $.each( $('#payForm').serializeArray(), function(key,val){\r\n//\t\t\t data1 += \",\" +val['name']+ \":\"+val['value'];\r\n//\t\t });\r\n//\t\t console.log(\"payform= \" + data1.substr(1));\t\t \r\n\t\t \r\n//\t\tif( cardCode == \"04\"){\r\n//\t\t\t allPrice= Number(String($(\".payPrice\").html()).replace(',', '')) - lpointPrice ;\r\n//\t\t}\r\n\t\t\r\n\t\t//복합결제시 적용 PointCard 가져옴\r\n\t\tif('PointCard'==$payForm.find(\"input[name=selectPayMethod]\").val()){\r\n\t\t\t allPrice = Number($payForm.find(\"input[name=CardPrice]\").val());\r\n\t\t\t\r\n\t\t }\r\n//\t\t//기준정보에 있는 nointcard 가져옴\r\n//\t\tvar oriArray= ($payForm.find(\"[name=cardNoInterestEventNew]\").val()).split(\"^\");\r\n//\t\tvar oriArray1 = \"\";\r\n//\t\tfor(var i=0;i<oriArray.length;i++){\r\n//\t\t\tvar z1 = oriArray[i];\r\n//\t\t\tif(jQuery.trim(z1).length > 0){\r\n//\t\t\tvar noIntPrice =  (z1.split(\"-\")[1])*10000;\r\n//\t\t\tif( allPrice >= noIntPrice){\r\n//\t\t\t\toriArray1 += z1.split(\"-\")[0]+\"-\"+z1.split(\"-\")[2]+\",\";\r\n//\t\t\t\t\r\n//\t\t\t\t}\r\n//\t\t\t}\r\n//\t\t}\r\n\t\t\r\n\t\t//기준정보에 있는 nointcard 가져옴\r\n\t\tvar oriArray= ($payForm.find(\"[name=nointwithprice]\").val()).split(\"^\");\r\n\t\tvar oriArrayNew = \"\";\r\n\t\tfor(var i=0;i<oriArray.length;i++){\r\n\t\t\tvar z1 = oriArray[i];\r\n\t\t\tif(jQuery.trim(z1).length > 0){\r\n\t\t\tvar noIntMinPrice =  (z1.split(\"-\")[1]);\r\n\t\t\tvar noIntMaxPrice = (z1.split(\"-\")[2]);\r\n\t\t\tif( allPrice >= noIntMinPrice && (noIntMaxPrice == 0 || allPrice <= noIntMaxPrice)){\r\n\t\t\t\toriArrayNew += z1.split(\"-\")[0]+\"-\"+z1.split(\"-\")[3]+\",\";\r\n\t\t\t\t\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n//\t\tconsole.log(\"oriArrayNew= \"+ oriArrayNew);\r\n//\t\tconsole.log(\"payprice= \"+Number(String($(\".payPrice\").html()).replace(',', '')));\r\n//\t\tconsole.log(\"price= \"+ Number($payForm.find(\"input[name=price]\").val()));\r\n//\t\tconsole.log(\"lpoint= \"+ Number($('[name=lpoint]').val()));\r\n//\t\tconsole.log(\"allPrice= \"+ allPrice);\r\n//\t\tconsole.log(\"lpointPrice= \"+ lpointPrice);\r\n\t\t// 상점 무이자 + 일반 이벤트 무이자 \r\n//\t\tvar array = ($payForm.find(\"[name=nointerest]\").val()+\",\"+$payForm.find(\"[name=cardNoInterestEvent]\").val()).split(\",\");\r\n\t\r\n\t\tvar array = ($payForm.find(\"[name=nointerest]\").val()+\",\"+oriArrayNew).split(\",\");\r\n\t\r\n\t\t// 50000원 미만  상점 무이자 표시 안함\r\n\t\tif($payForm.find(\"[name=currency]\").val() == 'WON' && allPrice < 50000){\r\n\t\t\tarray = (oriArrayNew).split(\",\");//($payForm.find(\"[name=cardNoInterestEvent]\").val()).split(\",\");\r\n\t\t}\r\n\t\t\r\n\t\t$payForm.find(\"#cardQuotaView li img.cardNoInterestText\").remove();\r\n\t\t$payForm.find(\"#cardQuotaView li img.cardSlimInterestText\").remove();\r\n\t\t\r\n\t\tif(languageView == \"ko\"){\r\n\t\t\tcardNoInterestText = \"<img class='cardNoInterestText flag' src='\" + imgPath + \"/img/icoF_new.gif' alt='무이자'/>\";\r\n\t\t}else if(languageView == \"en\"){\r\n\t\t\tcardNoInterestText = \"<img class='cardNoInterestText flag' src='\" + imgPath + \"/img/icoF_new.gif' alt='무이자'/>\";\r\n\t\t}else if(languageView == \"cn\"){\r\n\t\t\tcardNoInterestText = \"<img class='cardNoInterestText flag' src='\" + imgPath + \"/img/icoF_new.gif' alt='무이자'/>\";\r\n\t\t}\r\n\t\t\r\n\t\t$payForm.find(\"#cardQuotaView li img.cardNoInterestText\").remove();\r\n\t\t$payForm.find(\"#cardQuotaView li img.cardSlimInterestText\").remove();\r\n\t\t\r\n\t/*\tif(quotaBaseArray == null){\r\n\t\t\tquotaBaseArray = $payForm.find(\"[name=quotabase]\").val().split(\":\");\r\n\t\t}\r\n\t*/\r\n\t\t\r\n\t\t//var quotaBaseArray = $payForm.find(\"[name=quotabase]\").val().split(\":\");\r\n\t\t\r\n\t\tvar getQuota = $payForm.find(\"[name=quotabase]\").val();\r\n\t\t\r\n\t\tvar chkFlg = getQuota.indexOf(\"99\") > -1 ? \"Y\" : \"N\";\r\n\t\t\r\n\t\tvar quotabase2 = \"\";\r\n\t\tvar quotaBaseArray = \"\";\r\n\t\t\r\n\t\t//0 일시불처리\r\n\t\tif(getQuota  == \"0\"){\r\n\t\t\tquotabase2 = $payForm.find(\"[name=quotabase]\").val();\r\n\t\t\tquotaBaseArray = $payForm.find(\"[name=quotabase]\").val().split(\":\");\t\t\r\n\t\t}else if (getQuota == \"0:99\"){\r\n\t\t\t$(\"#cardQuota\").hide();\r\n\t\t\t\r\n\t\t\tvar lang = $payForm.find(\"[name=languageView]\").val();\r\n\t\t\tvar resultMsg = \"\";\r\n\t\t\t\r\n\t\t\tif(lang == \"ko\"){\r\n\t\t\t\tresultMsg = \"선택 가능한 할부개월수가 없습니다. <br> 상점으로 문의해주시기 바랍니다.\";\r\n\t\t\t}else{\r\n\t\t\t\tresultMsg = \"Installment options are not available.<br> Please contact the store for assistance.\";\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tcallAlert(resultMsg);\r\n\t\t}else{\r\n\t\t\t//일시불 제거 옵션 체크\r\n\t\t\tvar getQuotaBase = getCardCodeQuotaBase();\r\n\r\n\t\t\tif(getQuotaBase != null){\r\n\t\t\t\t quotabase2 = getQuotaBase;\r\n\t\t\t\t quotaBaseArray = quotabase2.split(\":\");\r\n\t\t\t\t \r\n\t\t\t\t $(\"#cardQuota\").show();\r\n\t\t\t}else{\r\n\t\t\t\t//할부개월 최대할부개월 초과로 인해서 hide\r\n\t\t\t\t$(\"#cardQuota\").hide();\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\t\t$(\"#cardQuotaView .dropdown dt\").empty();\r\n\t\t$(\"#cardQuotaView .dropdown ul\").empty();\r\n\t\t//할부개월수 1개 선택 시 해당 개월수만 세팅\r\n\t\t//var quotabase2 = $payForm.find(\"[name=quotabase]\").val();\r\n\r\n\t\t\r\n\t\t\r\n\t\t/* 할부개월 로직 변경으로 인하여 주석 처리 240827\r\n\t\tif(\"GODOBALAN4\" == $payForm.find(\"[name=mid]\").val()\r\n\t\t\t\t&& $payForm.find(\"[name=useragent]\").val().indexOf(\"IE8\") < 0\r\n\t\t\t\t&& $payForm.find(\"[name=useragent]\").val().indexOf(\"IE7\") < 0)\r\n\t\t{\r\n\t\t\tvar tmpCardCode = \"\";\r\n\t\t\t//씨티카드 최대 할부 개월 노출 부분 BC와 동일한 최대 할부개월 사용을 위해 변경\r\n\t\t\tif( cardCode == '43')\r\n\t\t\t{\r\n\t\t\t\ttmpCardCode =  cardCode;\r\n\t\t\t\tcardCode = \"11\";\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar maxQuotaInfo = '';\r\n\t\t\tvar maxNointInfo = '';\r\n\t\t\tvar excessNointArray = '';\r\n\t\t\tvar excessNoint = '';\r\n\t\t\tvar maxQuotaArray= '';\r\n\t\t\tif($payForm.find(\"[name=cardMaxQuotaList]\").val() !=null)\r\n\t\t\tvar maxQuotaArray = $payForm.find(\"[name=cardMaxQuotaList]\").val().split('&');\r\n\t\t\t\r\n\t\t\tif(maxQuotaArray.length > 0)\r\n\t\t\t{\r\n\t\t\t\tfor(var i=0;i<maxQuotaArray.length;i++)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar q1 = maxQuotaArray[i];\r\n\t\t\t\t\tif(jQuery.trim(q1).length > 0)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar q2 = q1.split(\"=\");\r\n\t\t\t\t\t\tif(cardCode == q2[0])\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tvar max = q2[1].split(\":\");\r\n\t\t\t\t\t\t\tmaxQuotaInfo = Number(max[0]);\r\n\t\t\t\t\t\t\tmaxNointInfo = Number(max[1]);\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t//cardMaxQuotaList 에 해당하는 카드가 없을경우 default Max Quota 12개월.\r\n\t\t\tif(maxQuotaInfo == \"\")maxQuotaInfo = 12;\t\r\n\t\t\tif(maxNointInfo == \"\")maxNointInfo = 12;\r\n\t\t\t\r\n\t\t\tif(maxQuotaInfo != \"\")\r\n\t\t\t{\r\n\t\t\t\t\r\n\t\t\t\tquotaBaseArray = quotaBaseArray.filter(function(data){\r\n\t\t\t\t\treturn data <= maxQuotaInfo;\r\n\t\t\t\t});\r\n\t\t\t}\t\t\r\n\t\r\n\t\t\tfor(var i=0;i<array.length;i++)\r\n\t\t\t{\r\n\t\t\t\tvar q1 = array[i];\r\n\t\t\t\t\r\n\t\t\t\tif(jQuery.trim(q1).length > 0)\r\n\t\t\t\t{\r\n\t\t\t\t\t// 선택 카드에 따른 무이자 표시\r\n\t\t\t\t\tif(cardCode == q1.split(\"-\")[0] || (tmpCardCode ==\"43\" && q1.split(\"-\")[0]==\"43\"))\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar array2 = q1.split(\"-\")[1].split(\":\");\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tfor(var j=0; j < array2.length;j++)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tvar q2 = array2[j];\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tif(q2 > maxNointInfo)\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\texcessNoint += q2+\":\";\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif(excessNoint.length > 0)\r\n\t\t\t{\r\n\t\t\t excessNointArray = excessNoint.split(\":\"); \r\n\t\t\t quotaBaseArray = quotaBaseArray.filter(function(data)\r\n\t\t\t\t\t {\r\n\t\t\t\treturn excessNointArray.indexOf(data) < 0 ;\r\n\t\t\t });\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif(tmpCardCode ==\"43\")\r\n\t\t\t{\r\n\t\t\t\tcardCode = tmpCardCode;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t\r\n\t\t}\r\n*/\r\n\t\t\r\n\t\t\r\n\t\tvar filter = /[:]/gi;\r\n\t\tvar filter2 = \"\";\r\n\r\n\t\tif(filter.test(quotabase2)){\r\n\t\t  filter2 = \"true\";\r\n\t\t}else{\r\n\t\t  filter2 = \"false\";\r\n\t\t}\r\n\t\t\r\n\t\tvar temp = quotabase2; \r\n\t\r\n\t\tif(filter2 == \"false\" && quotabase2 != \"\"){ \r\n\t\t\tif(quotabase2.length == 1){ \r\n\t\t\t\ttemp = \"0\" +quotabase2; \r\n\t\t\t} \r\n\t\t\t$(\"input[name=cardQuota]\").val(temp); \r\n\t\t} \r\n\t\t\r\n\t\tvar tabIndex = $(\"#cardQuota\").attr(\"tabIndex\");\r\n\t\tvar tabIndexNext = parseInt(tabIndex);\r\n\t\tvar count = quotaBaseArray.length;\r\n\t\t\r\n\t\tfor(var i=0; i <= count ; i++){\r\n\t\t\tif(i==0){\r\n\t\t\t\tif(chkFlg == \"N\"){\r\n\t\t\t\t\t//일시불 제거 옵션 미인입\r\n\t\t\t\t\tif(filter2 == \"true\" || (quotabase2 == null||quotabase2 == \"\") || (quotabase2 ==\"0\"||quotabase2 ==\"00\")){\r\n\t\t\t\t\t\tif(languageView == \"ko\"){\r\n\t\t\t\t\t\t\tvar str ='<a href=\"#\"><span class=\"value\">00</span><span> 일시불 </span></a>';\r\n\t\t\t\t\t\t\tvar strLi = '<li><a href=\"#\" class=\"00\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">00</span><span> 일시불 </span></a></li>';\r\n\t\t\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\t\t\tvar str ='<a href=\"#\"><span class=\"value\">00</span><span> Lump sum </span></a>';\r\n\t\t\t\t\t\t\tvar strLi = '<li><a href=\"#\" class=\"00\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">00</span><span> Lump sum </span></a></li>';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\telse if(languageView == \"cn\"){\r\n\t\t\t\t\t\t\tvar str ='<a href=\"#\"><span class=\"value\">00</span><span> 一次性  </span></a>';\r\n\t\t\t\t\t\t\tvar strLi = '<li><a href=\"#\" class=\"00\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">00</span><span> 一次性 </span></a></li>';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t$(\"#cardQuotaView .dropdown dt\").append(str);\r\n\t\t\t\t\t\t$(\"#cardQuotaView .dropdown ul\").append(strLi);\r\n\t\t\t\t\t}\r\n\t\t\t\t}else {\r\n\t\t\t\t\tif(count > 1){\r\n\t\t\t\t\t\t//일시불 제거 옵션\r\n\t\t\t\t\t\tif(languageView == \"ko\"){\r\n\t\t\t\t\t\t\tstrDt = '<a href=\"#\" class=\"0' + quotaBaseArray[i] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">0' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i]) + '개월</span></a>';\r\n\t\t\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\t\t\tstrDt = '<a href=\"#\" class=\"0' + quotaBaseArray[i] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">0' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i]) + 'Month</span></a>';\r\n\t\t\t\t\t\t}else if(languageView == \"cn\"){\r\n\t\t\t\t\t\t\tstrDt = '<a href=\"#\" class=\"0' + quotaBaseArray[i] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">0' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i]) + '个月</span></a>';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t$(\"#cardQuotaView .dropdown dt\").append(strDt);\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t\telse if(i > 0){\r\n\t\t\t\tvar str = '';\r\n\t\t\t\tvar strDt = '';\r\n\t\t\t\tvar quota = Number(quotaBaseArray[i-1]);\r\n\t\t\t\tif(quotaBaseA