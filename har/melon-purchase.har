          "content": {
            "size": 99964,
            "mimeType": "text/css",
            "compression": 0,
            "text": "\r\n/*********************************************************/\r\n/*********************************************************/\r\n/* plugin ************************************************/\r\n/*********************************************************/\r\n/*********************************************************/\r\n\r\n@charset \"utf-8\";\r\n\r\n.tooltip {display:none;background:transparent url(http://open.inicis.com/img/black_arrow.png);font-size:11px;height:70px;width:160px;padding:25px;color:#fff;}\r\n\r\n.loading-indicator {height: 200px;width: 200px;background: url( 'https://stdux.inicis.com/stdpay/img/loading/ajax-loader_SC.gif' );background-repeat: no-repeat;background-position: center center;}\r\n.loading-indicator-overlay {background-color: transparent;opacity: 0.6;filter: alpha(opacity = 50);}\r\n\r\n.hasPlaceholder {color: #777;}\r\n\r\n#popup_container {font-size: 12px;min-width: 300px; max-width: 600px; background: #FFF;border: solid 3px #bbb;color: #000;-moz-border-radius: 16px;-webkit-border-radius: 16px;border-radius: 16px;margin-top: 40px;border: 1px solid #ccc;box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);z-index: 9999;\r\n}\r\n#popup_title {height:50px;border-bottom: 1px solid #eee;font-size: 14px;font-weight: bold;background: url(https://stdux.inicis.com/stdpay/img/logo/kg36.jpg) no-repeat;background-position: 50% center;}\r\n#popup_content {padding: 1em 1.75em;margin: 0em;text-align: center;}\r\n#popup_message{padding:10px 0;}\r\n#popup_content.alert {}\r\n#popup_panel {text-align: center;margin: 1em 0em 0em 1em;}\r\n#popup_prompt {margin: .5em 0em;}\r\n\r\n\r\n\r\n/*********************************************************/\r\n/*********************************************************/\r\n/* buttons ***********************************************/\r\n/*********************************************************/\r\n/*********************************************************/\r\n\r\n/* button */\r\n.button { display: inline-block; zoom: 1; *display: inline; vertical-align: baseline; margin: 0 3px; outline: none; cursor: pointer; text-align: center; text-decoration: none; padding: .5em 2em .55em;border-radius: 8px;  }\r\n.button:hover {text-decoration: none !important;}\r\n.button:active {position: relative;top: 1px;}\r\n.button:focus {outline:1px dashed #999;} /* 20160620 �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃占� */\r\n\r\n.button.bigrounded {-webkit-border-radius: 2em;-moz-border-radius: 2em;border-radius: 2em;}\r\n.button.small {font-weight: normal;font-size: 12px;padding: .35em 1.25em .275em;}\r\n.button.small2 {font-weight: normal;font-size: 12px;padding: .21em .6em .155em;}\r\n.button.small3 {font-weight: normal;font-size: 12px;padding: .15em .3em .100em;}\r\n.button.button.medium {font-weight: bold;font-size: 12px;padding: .6em 1.7em .42em;}\r\n.button.big {font-weight: bold;font-size: 15px;padding: .6em 2.5em .42em;}\r\n.button.big2 {font-weight: bold;font-size: 11px;padding-left:5px;padding-right:5px;width: 75px;height: 15px;}\r\n\r\n/* for inicis */\r\n/* gray */\r\n.button.gray2 {color: #ffffff !important;background: #afb0b2;}\r\n.button.gray2:hover {/* color: #ffffff; background: #afb0b2; */}\r\n.button.gray2:active {/* color: #afb0b2 !important; */}\r\n.button.gray3 {color: #ffffff !important;border: solid 1px #555;background: #afb0b2;}\r\n.button.gray3:hover {/* color: #ffffff; background: #afb0b2; */}\r\n.button.gray3:active {/* color: #afb0b2 !important; */}\r\n.button.blue2 {color: #ffffff !important;background: #2a5d9f;}\r\n.button.blue2:hover {/* color: #ffffff !important; background: #2a5d9f; */}\r\n.button.blue2:active {/* color: #2a5d9f !important; */}\r\n.button.blue3 {color: #ffffff !important;background: #677ab1;}\r\n.button.blue3:hover {/* color: #ffffff !important; background: #4b5e92; */}\r\n.button.blue3:active {/* color: #de898c !important; */}\r\n\r\n/* blue */\r\n.button.blue4 {color: #ffffff !important;border: solid 1px #0076a3;background: #4f9be8;}\r\n.button.blue4:hover {/* color: #ffffff !important; background: #2d88e3; */}\r\n.button.blue4:active {/* color: #80bed6 !important; */}\r\n.button.black2 {color: #ffffff !important;background: #333;}\r\n.button.black2:hover {color: #ffffff !important;background: #000;}\r\n.button.black2:active {color: #666 !important;}\r\n\r\n/* red */\r\n.button.red2 {color: #ffffff !important;background: #f36b79;}\r\n.button.red2:hover {background: #f15060;}\r\n.button.red2:active {color: #de898c !important;}\r\n\r\n/* purple */\r\n.button.purple2 {color: #ffffff !important;background: #664499;}\r\n.button.purple2:hover {background: #664499;}\r\n.button.purple2:active {color: #fff !important;}\r\n\r\n/* white */\r\n.button.white2 {color: #606060 !important;background: #fff;}\r\n.button.white2:hover {background: #ededed;}\r\n.button.white2:active {color: #999 !important;}\r\n\r\n/* white */\r\n.button.white3 {color: #3779b2!important;background: #fff;}\r\n.button.white3:hover {/* background: #ededed; */}\r\n.button.white3:active {/* color: #999 !important; */}\r\n\r\n/* color styles */\r\n/* black */\r\n.button.black {\r\ncolor: #d7d7d7 !important;\r\nborder: solid 1px #333;\r\nbackground: #333;\r\n}\r\n.button.black:hover {\r\nbackground: #000;\r\n}\r\n.button.black:active {\r\ncolor: #666 !important;\r\n}\r\n\r\n/* gray */\r\n.button.gray {\r\ncolor: #e9e9e9 !important;\r\nborder: solid 1px #555;\r\nbackground: #6e6e6e;\r\n}\r\n.button.gray:hover {\r\nbackground: #616161;\r\n}\r\n.button.gray:active {\r\ncolor: #afafaf !important;\r\n}\r\n\r\n/* white */\r\n.button.white {\r\ncolor: #606060 !important;\r\nborder: solid 1px #b7b7b7;\r\nbackground: #fff;\r\n}\r\n\r\n.button.white:hover {\r\nbackground: #ededed;\r\n}\r\n.button.white:active {\r\ncolor: #999 !important;\r\n}\r\n\r\n/* orange */\r\n.button.orange {\r\ncolor: #fef4e9 !important;\r\nborder: solid 1px #da7c0c;\r\nbackground: #f78d1d;\r\n}\r\n.button.orange:hover {\r\nbackground: #f47c20;\r\n}\r\n.button.orange:active {\r\ncolor: #fcd3a5 !important;\r\n}\r\n\r\n/* red */\r\n.button.red {\r\ncolor: #faddde !important;\r\nborder: solid 1px #980c10;\r\nbackground: #d81b21;\r\n}\r\n.button.red:hover {\r\nbackground: #b61318;\r\n}\r\n.button.red:active {\r\ncolor: #de898c !important;\r\n}\r\n\r\n/* blue */\r\n.button.blue {\r\ncolor: #d9eef7 !important;\r\nborder: solid 1px #0076a3;\r\nbackground: #0095cd;\r\n}\r\n.button.blue:hover {\r\nbackground: #007ead;\r\n}\r\n.button.blue:active {\r\ncolor: #80bed6 !important;\r\n}\r\n\r\n/* rosy */\r\n.button.rosy {\r\ncolor: #fae7e9 !important;\r\nborder: solid 1px #b73948;\r\nbackground: #da5867;\r\n}\r\n.button.rosy:hover {\r\nbackground: #ba4b58;\r\n}\r\n.button.rosy:active {\r\ncolor: #dca4ab !important;\r\n}\r\n\r\n/* green */\r\n.button.green {\r\ncolor: #e8f0de !important;\r\nborder: solid 1px #538312;\r\nbackground: #64991e;\r\n}\r\n.button.green:hover {\r\nbackground: #538018;\r\n}\r\n.button.green:active {\r\ncolor: #a9c08c !important;\r\n}\r\n\r\n/* pink */\r\n.button.pink {\r\ncolor: #feeef5 !important;\r\nborder: solid 1px #d2729e;\r\nbackground: #f895c2;\r\n}\r\n.button.pink:hover {\r\nbackground: #d57ea5;\r\n}\r\n.button.pink:active {\r\ncolor: #f3c3d9 !important;\r\n}\r\n.button.disable {cursor: normal;color: gray !important;}\r\n\r\n/* rosy */\r\n.button.rosydisable {\r\ncursor: default;\r\nfont-weight: bold;\r\ncolor: #fae7e9 !important;\r\nborder: solid 1px #b73948;\r\nbackground: #da5867;\r\n}\r\n\r\n\r\n\r\n/*********************************************************/\r\n/*********************************************************/\r\n/* INIStdPay *********************************************/\r\n/*********************************************************/\r\n/*********************************************************/\r\n\r\n\r\n/*!\r\n * Bootstrap v2.2.1\r\n *\r\n * Copyright 2012 Twitter, Inc\r\n * Licensed under the Apache License v2.0\r\n * http://www.apache.org/licenses/LICENSE-2.0\r\n *\r\n * Designed and built with all the love in the world @twitter by @mdo and @fat.\r\n */\r\n .clearfix {\r\n\t*zoom: 1;\r\n}\r\n.clearfix:before, .clearfix:after { display: table; content: \"\"; line-height: 0; }\r\n.clearfix:after { clear: both; }\r\n.hide-text { font: 0/0 a; color: transparent; text-shadow: none; background-color: transparent; border: 0; }\r\n\r\n.input-block-level { display: block; width: 100%; min-height: 30px; -webkit-box-sizing: border-box; -moz-box-sizing: border-box; box-sizing: border-box; }\r\n\r\n/* 占쎌녇占쎄틓占쎈뮛�뜝�럥占쎈뛽�궔�뜝�뜴�쐻占쎈쑕占쎌맶�뜝�럥�쑅�뜝�럥議� */\r\n.inipay_modal-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 10400; background-color: #000000; }\r\n.inipay_modal-backdrop.fade { opacity: 0; }\r\n.inipay_modal-backdrop,\r\n.inipay_modal-backdrop.fade.in {\r\n\topacity: 0.3;\r\n\tfilter: alpha(opacity=30);\r\n}\r\n.inipay_modal {\r\n\tposition: fixed;\r\n\tz-index: 10500;\r\n\twidth: 100%;\r\n\theight : 100%;\r\n\tmargin: 0px auto;\r\n\tbackground-color: transparent;\r\n\r\n\t/* IE6-7 */\r\n/*\r\n\t-webkit-border-radius: 10px;\r\n\t-moz-border-radius: 10px;\r\n\tborder-radius: 10px;\r\n*/\r\n\t/* -webkit-border-radius: 5px;\r\n\t-moz-border-radius: 5px;\r\n\tborder-radius: 5px;\r\n\r\n\t-webkit-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-moz-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\tbox-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-webkit-background-clip: padding-box;\r\n\t-moz-background-clip: padding-box;\r\n\tbackground-clip: padding-box;*/\r\n\toutline: none; \r\n}\r\n.inipay_modal.fade {\r\n\t-webkit-transition: opacity .3s linear, top .3s ease-out;\r\n\t-moz-transition: opacity .3s linear, top .3s ease-out;\r\n\t-o-transition: opacity .3s linear, top .3s ease-out;\r\n\ttransition: opacity .3s linear, top .3s ease-out;\r\n\ttop: -1200px;\r\n}\r\n.inipay_modal.fade.in { top: 0%; }\r\n\r\n/*占쎌녇占쎄틓占쎈뮛�뜝�럥占쎈뛽�궔�뜝�뜴�쐻占쎈쑕占쎌맶�뜝�럥�쑅�뜝�럥議� 占쎌녇占쎄틓占쎈뮛�뜝�럥�뼌占쎈쐻占쎈윥占쎈탵占쎈쐻占쎈윥�뜮�빢�삕占쎌맶�뜝�럥�몷占쎈퉲�뜝�뜴�쐻占쎈윪占쎈쨮占쎈쐻占쎈윪�뤃占�*/\r\n\r\n.inipay_modal_msg-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 10400; background-color: #000000; }\r\n.inipay_modal_msg-backdrop.fade { opacity: 0; }\r\n.inipay_modal_msg-backdrop,\r\n.inipay_modal_msg-backdrop.fade.in { opacity: 0.0; filter: alpha(opacity=0); }\r\n.inipay_modal_msg {\r\n\t/*display:none;*/\r\n\tposition: fixed;\r\n\t/*top: 40%;*/\r\n\tleft: 50%;\r\n\tz-index: 10500;\r\n\twidth: 666px;\r\n\tmargin: -250px 0 0 -335px;\r\n\tbackground-color: #ffffff;\r\n\tborder: 2px solid #999;\r\n\tborder: 2px solid rgba(0, 0, 0, 0.3);\r\n\t*border: 2px solid #999;\r\n\t/* IE6-7 */\r\n\r\n\tpadding:15px;\r\n\ttext-align:center;\r\n\tfont-size : 13px;\r\n\tcolor: #2a5d9f;\r\n\r\n\r\n/*\r\n\t-webkit-border-radius: 10px;\r\n\t-moz-border-radius: 10px;\r\n\tborder-radius: 10px;\r\n*/\r\n\t-webkit-border-radius: 5px;\r\n\t-moz-border-radius: 5px;\r\n\tborder-radius: 5px;\r\n\r\n\t-webkit-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-moz-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\tbox-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-webkit-background-clip: padding-box;\r\n\t-moz-background-clip: padding-box;\r\n\tbackground-clip: padding-box;\r\n\toutline: none;\r\n}\r\n.inipay_modal_msg.fade {\r\n\t-webkit-transition: opacity .3s linear, top .3s ease-out;\r\n\t-moz-transition: opacity .3s linear, top .3s ease-out;\r\n\t-o-transition: opacity .3s linear, top .3s ease-out;\r\n\ttransition: opacity .3s linear, top .3s ease-out;\r\n\ttop: -600px;\r\n}\r\n.inipay_modal_msg.fade.in {\r\n\ttop: 40%;\r\n}\r\n/****************************/\r\n/** header\r\n/****************************/\r\n.inipay_modal-header {\r\n\t/*padding: 5px 15px;*/\r\n\tpadding: 5px 5px 0 10px;\r\n\t/*border-bottom: 1px solid #eee;*/\r\n}\r\n.inipay_modal-header .close { margin-top: 5px; }\r\n.inipay_modal-header h3 { margin: 0; line-height: 20px; clear: none; font-size: 18px; font-weight: bold; color: inherit; text-rendering: optimizelegibility; }\r\n\r\n\r\n.inipay_close { position: absolute; top: -14px; right: -14px; width: 32px; height: 32px; cursor: pointer; opacity: 0.3; }\r\n\r\n.inipay_close:hover { opacity: 0.8; }\r\n\r\n/**** body ******************/\r\n.inipay_modal-body { width: 100%; height: 100%; }\r\n.inipay_iframe { border: none #FFFF00 0px; display: block; left: 0; top: 0px; overflow: hidden; width: 100%; height: 100%; margin: 0px auto; }\r\n\r\n.inipay_modal-form { margin-bottom: 0; }\r\n\r\n/**** footer ************************/\r\n.inipay_modal-footer { padding: 2px; margin-bottom: 0; text-align: right; background-color: #f5f5f5; -webkit-border-radius: 0 0 6px 6px; -moz-border-radius: 0 0 6px 6px; border-radius: 0 0 6px 6px; -webkit-box-shadow: inset 0 1px 0 #ffffff; -moz-box-shadow: inset 0 1px 0 #ffffff; box-shadow: inset 0 1px 0 #ffffff; *zoom: 1; }\r\n.inipay_modal-footer:before, .inipay_modal-footer:after { display: table; content: \"\"; line-height: 0; }\r\n.inipay_modal-footer:after { clear: both; }\r\n.inipay_modal-footer .btn + .btn { margin-left: 5px; margin-bottom: 0; }\r\n.inipay_modal-footer .btn-group .btn + .btn { margin-left: -1px; }\r\n.inipay_modal-footer .btn-block + .btn-block { margin-left: 0; }\r\n\r\n\r\n\r\n\r\n/*********************************************************/\r\n/*********************************************************/\r\n/* Loading ***********************************************/\r\n/*********************************************************/\r\n/*********************************************************/\r\n\r\nbody{overflow:hidden;}\r\n\r\n.loading-indicator {height: 200px;width: 200px;margin-top: -30px;background: url( 'https://stdux.inicis.com/stdpay/img/loading/ajax-loader_Pk.gif') no-repeat 50% 50%;}\r\n\r\n.loading-indicator-overlay {background-color: transparent;opacity: 0.6;filter: alpha(opacity = 50);border-radius: 20px;}\r\n\r\n\r\n\r\n/*********************************************************/\r\n/*********************************************************/\r\n/* COMMON ************************************************/\r\n/*********************************************************/\r\n/*********************************************************/\r\n\r\n\r\n@import url(\"//fonts.googleapis.com/earlyaccess/nanumgothic.css\");\r\n@font-face {\r\n    font-family: 'NanumGothic';\r\n    src: url('https://stdux.inicis.com/stdpay/font/NanumGothic.eot');\r\n    src: url('https://stdux.inicis.com/stdpay/font/NanumGothic.eot?#iefix') format('embedded-opentype'),\r\n         url('https://stdux.inicis.com/stdpay/font/NanumGothic.woff') format('woff'),\r\n         url('https://stdux.inicis.com/stdpay/font/NanumGothic.ttf') format('truetype');\r\n    font-weight: normal;\r\n    font-style: normal;\r\n}\r\n\r\n*{padding:0; margin:0;}\r\nbody {padding:0; margin:0; line-height:16px;  color:#666; font-size:12px;}\r\nbody,input,h1,h2,h3,h4,h5,h6,div,span,td,th,table,tr,dl,dt,dd,li,a,select,option{font-family:'pretendard','pretendard-subset','noto sans cjk kr', 'Noto Sans Korean', 'NanumGothic',\"Malgun Gothic\",\"占쎌녇占쎄틓占쎈뮛�뜝�럥�럯癲ル슔�걞而ㅵ뜝�럩留뜹뜝�럥�맶占쎈쐻�뜝占� �뜝�럥�맶�뜝�럥�몘力놂옙�⑨옙占쎈젺�솻洹⑦맔占쎌굲�뜝�럥�꽔�뜝�럩援�\",-apple-system,BlinkMacSystemFont,helvetica,\"Apple SD Gothic Neo\",sans-serif;}\r\n/* caption {visibility:hidden; overflow:hidden; width:0; height:0; font-size:0; line-height:0}  *//* 201605 �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃占� */\r\ncaption {overflow:hidden; width:0; height:0; font-size:0; line-height:0}\r\nimg {border:0; vertical-align:middle;}\r\na {text-decoration:none;}\r\n/*a:focus {outline:1px dashed #999;}*/\r\na, a:hover, a:focus, a:active {color: inherit;}\r\nli{list-style: none;padding:0;margin:0}\r\n/* form */\r\ninput { color:#666;}\r\n.check,\r\n.radio {display:inline-block; padding:0; margin:0 5px 0 0; height:16px; line-height:16px; vertical-align:middle; border: 0; vertical-align:middle;}\r\n.select {display:inline-block; line-height:14px; padding:1px; border:1px solid #b7b7b7; *margin-right: 5px;}\r\n.select select {width:100%;line-height:14px;padding:0 20px 0 10px; border:0; font-size:12px; color:#666; vertical-align:middle;height: 22px;-webkit-appearance:none;-moz-appearance:none;appearance:none;background: url('https://stdux.inicis.com/stdpay/img/ico_select_arrow.png') no-repeat center right 0;}\r\n\r\n.inputText {display:inline-block; height:20px; line-height:20px; padding:0 5px; margin:0; color:#555; border:1px solid #b7b7b7;vertical-align:middle;}\r\n.inputText2 {display:inline-block; height:20px; line-height:20px; padding:0 5px; margin:0; color:#555; font-weight:bold; border:1px solid #b7b7b7;vertical-align:middle; background:#efefef;}\r\n.inputText3 {display:inline-block; height:20px; line-height:20px; padding:0 5px; margin:0; color:#555; border:1px solid #b7b7b7;vertical-align:middle;}\r\n.inputText4 {display:inline-block; height:20px; line-height:20px; padding:0 5px; margin:0; color:#555; font-weight:bold; border:1px solid #b7b7b7;vertical-align:middle; background:#efefef;}\r\n\r\n/* .inputPw {display:inline-block; height:22px; line-height:22px; padding: 0 5px; margin:0; border:1px solid #b7b7b7;vertical-align:middle; background:url(\"https://stdux.inicis.com/stdpay/img/icoLock_new.gif\") no-repeat right center;} */\r\n.inputPw {display:inline-block; height:22px; line-height:22px; padding: 0 8px 0 0 !important; margin:0; border:1px solid #b7b7b7;vertical-align:middle; background:url(\"https://stdux.inicis.com/stdpay/img/icoLock_new.gif\") no-repeat right center;}\r\n.inputPw_noBg {display:inline-block; height:22px; line-height:22px; padding: 0 10px; margin:0; border:1px solid #b7b7b7;vertical-align:middle; background: none;} /* 20160615 �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃占� */\r\n.inputPw_disabled {display:inline-block; height:22px; line-height:22px; padding: 0 5px; margin:0; border:1px solid #b7b7b7;vertical-align:middle; background: #eee url(\"https://stdux.inicis.com/stdpay/img/icoLock.gif\") no-repeat right center;} /* 20160620 �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃占� */\r\n\r\n.mL5 {margin-left:5px !important;}\r\n.mL9 {margin-left:9px !important;}\r\n.mL11 {margin-left:11px !important;}\r\n.mL15 {margin-left:15px !important;}\r\n\r\n.mT0 {margin-top:0 !important;}\r\n.mT5 {margin-top:5px !important;}\r\n.mT10 {margin-top:10px !important;}\r\n.mT15 {margin-top:15px !important;}\r\n.mT20 {margin-top:20px !important;}\r\n.mB5 {margin-bottom: 5px !important;}\r\n.m20 {margin:20px !important;}\r\n\r\n.pT0 {padding-top:0 !important;}\r\n.p10 {padding:10px !important;}\r\n.pT10 {padding-top:10px !important;}\r\n.pB10 {padding-bottom:10px !important;}\r\n.pR0 {padding-right:0 !important;}\r\n\r\n.fL {float:left !important;}\r\n.blind {overflow:hidden; position:absolute; top:0; left:0; width:1px; height:1px; font-size:1px; line-height:100px; white-space:nowrap} /* 20160520 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윪占쎌젲占쎈쐻占쎈윪占쎈㎡占쎈쎗�뜝�뜴�쐻占쎈짗占쎌굲�뜝�럥鍮�占쎈쐻占쎈윥�뜮�빢�삕占쎌맶�뜝�럥�몧�뜝�럩留띰옙�쐻占쎈윥占쎌몝占쎈쎗�뜝�뜴�쐻�뜝占� 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝癲ル슢�뵩占쎈㎉�뜝�럩留띰옙�쐻占쎈윥占쎌몗�뜝�럥�렓占쎈쐻�뜝占� 占쎌녇占쎄틓占쎈뮛�뜝�럥�럯占쎈쐻占쎈윪筌띾돍�삕占쎈늾占쎈쇊占쎈늅�댆�뇯�쐻占쎈윪�뤃轅곗녇占쎈룂占쎄덱占쎈쇀占쎌돸占쎌굲�뜝�럡�렊占쎈쐻占쎈윞占쎈쑆�뜝�럥�맶占쎈쐻�뜝占� 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽占쎈쐻占쎈윥壤쎻벂�쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗占쎈쐪筌먦룂�굲 css */\r\n.hidden{font-size: 0;line-height: 0;position: absolute;text-indent: 10000px;top:-10000px}\r\n.cBoth {clear:both;}\r\n.hand{cursor: pointer;}\r\n.hide{display:none;}\r\n\r\n.bdLine {border:1px solid #ddd;}\r\n.bdTop {border-top:1px solid #ddd;}\r\n.bdBtm {border-bottom:1px solid #ddd;}\r\n\r\n.copy {margin-left:5px;}\r\n.autoScroll{overflow-y:auto; height:210px;}\r\n\r\n.txtC {text-align:center !important;}\r\n/*.txtC a {display:inline-block; margin:0 3px;}*/\r\n\r\n/* color */\r\n.color01 {color:#664499 !important;}\r\n.color02 {color:#555 !important;}\r\n.color03 {color:#f2310b;}\r\na.color01 {text-decoration:underline;}\r\na.color03 {text-decoration:underline;}\r\n\r\n.bold {font-weight:bold !important;}\r\n.boldNo {font-weight:normal !important;}\r\n\r\n.allAgree {text-align:right; padding:0 5px; border:0; margin:0; color:#666;}\r\n\r\n*:first-child + html .check {vertical-align:2px;} /* IE7 */\r\n*:first-child + html .radio {vertical-align:2px;} /* IE7 */\r\n\r\n/* form */\r\n/* �뜝�럥�맶�뜝�럥�쑅�뜝�럥堉볟뜝�럥�맶�뜝�럥�쑅�뜝�럡�뒅�뜝�럥�맶�뜝�럥�쐾�뜝�럥琉됵옙�쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윞占쎈�섓옙�쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝�뜝�럡�뜦占쎈쐻占쎈짗占쎌굲占쎌젂占쎈쳟占쎌굲占쎌넂�뜝�룞�삕�뤃占� 占쎈쐻占쎈윪占쎌맚占쎈쐻占쎈윪占쎈츧占쎈쐻占쎈윥占쎈튉占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윥占쎈튉占쎈쐻占쎈윥�젆占쏙옙�쐻占쎈윥�씙�뜝�럡�렊�뜝�럥�맶�뜝�럥�쐾�뜝�럥猷�/占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽占쎈쐻占쎈윥�뜝�떬�씮�굲�뜝�럩留띰옙�쐻占쎈윥占쎌몗占쎈쐻占쎈윥占쏙옙占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윞�뙼臾덈쐻占쎈윥占쎄틦�뜝�뜦維�甕곗쥜�삕筌띾돍�삕占쎌맶�뜝�럥�쐾�뜝�럥猷� 占쎌녇占쎄틓占쎈뮦�뜝�럥彛믭옙�쐻占쎈윪繹먯닂�삕占쎈늾占쎈쇊占쎈탛占쎈샴�뜝�럥�솗嶺뚮ㅏ�뒩�빊�뼃�쐻占쎈윥椰꾩쉫�쐪筌먦룂�굲 占쎈쐻占쎈윥占쎌넁�뜝�뜦維�占쎈뮡占쎈쐻占쎈짗占쎈쭟�뜝�럩援뀐옙�쐻占쎈윪占쎌죧 */\r\n.checkFildBusiness {position: relative; left: 0.5px; top: 2px;}\r\n#checkFildBusiness {position: relative; left: 0.5px; top: 2px;}\r\n.checkFildJumin {position: relative; left: 0.5px; top: 2px;}\r\n#checkFildJumin {position: relative; left: 0.5px; top: 2px;}\r\n\r\n.kgLayer {position:fixed; top:50%; left:50%; width:820px;height:600px;margin:-300px 0 0 -410px; font-size:12px; line-height:140%;}\r\n\r\n.popWrap {position:relative;width:490px; height:600px;background:#fff;padding:0 210px 0 120px;/*border:1px solid #eee*/ display: none;}\r\n/*占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗占쎈쐻占쎈윥�뤃寃쇰쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽�뜝�럥堉��뜝�럩�뭶�뜝�럩留띰옙�쐻占쎈윥占쎌몗占쎈쐪筌먦끉�룯�뜝�럥裕뗰옙�쐻占쎈윥�뙴湲븍쐪筌먲퐢占쎌슖�쑏占쎈�섓옙�맶占쎈쐻�뜝占� 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝�뜝�럩釉わ옙踰됵옙留띰옙�쐻占쎈윥占쎌몗�뜝�럥�렓占쎈쐻占쎈짗占쎌굲�뜝�럩留띰옙�쐻占쎈윥占쎌몗占쎈쐻占쎈윥占쎈옘 �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃占�  */\r\n.kgLayer02 {position:fixed; top:50%; left:50%; width:467px;height:496px; margin:-248px 0 0 -234px; font-size:12px; line-height:140%; }\r\n\r\n\r\n/* header */\r\n.kgHeader {position:relative; overflow:hidden; height:35px;padding:15px 0 0; margin:0 20px ; border-bottom:2px solid #c9c9c9;}\r\n.kgHeader h1 {float:left; padding:7px 0 0 10px; margin:0; font-size:0; line-height:0;}\r\n.kgHeader .fR {overflow:hidden; float:right; padding:10px 0 0; margin:0;}\r\n.kgHeader .fR .copy {float:left; padding:0; margin:-2px 1px 0; font-size:11px; color:#666; vertical-align:top;}\r\n.kgHeader .fR .step {overflow:hidden; float:left; padding:0; margin:0; list-style:none;}\r\n.kgHeader .fR .step li {float:left; overflow:hidden; width:10px; height:10px; margin-left:6px;text-indent:-9999px; background:#c3c3c3;}\r\n.kgHeader .fR .step li span {visibility:hidden;}\r\n.kgHeader .fR .step li.on {background:#cc1915;}\r\n\r\n/* �뜝�럥�맶�뜝�럥�쑅占쎈빝占쎌돥占쎌맶�뜝�럥�쑋�뜝�럥痢㏆옙�쐻占쎈윥占쎄괴�뜝�럥�맶占쎈쐻�뜝占� 占쎌녇占쎄틓占쎈뮛�뜝�럥�뼌占쎈쐻占쎈짗占쎌굲�뜝�럥�맶�뜝�럥�쑅占쎈쐻�뜝占� */\r\n.kgMenuList {position:absolute; top:0; left:0; width:112px; height:525px;padding:55px 4px 20px 4px; background:#F8F8F8;border-right: 1px solid #ddd;}\r\n.kgMenuList ul.menu {padding:0; margin:0; list-style:none;}\r\n.kgMenuList ul.menu li { padding:0; margin:0; text-align:center;display:block}\r\n.kgMenuList ul.menu li a {display:block;line-height:1.1;padding:11px 0; text-decoration:none; color:#777;font-size:15px;font-weight: normal;}\r\n.kgMenuList ul.menu li a:hover{color:#333}\r\n.kgMenuList ul.menu li.on a,.kgMenuList ul.menu li.on a span {font-weight:bold; color:#333;}\r\n\r\n.langList {overflow:hidden; position:absolute; bottom:0; left:0; padding:10px 13px; list-style:none}\r\n.langList li {float:left; margin:2px;}\r\n\r\n/* �뜝�럥�맶�뜝�럥�쑅占쎈빝占쎌돥占쎌맶�뜝�럥�쑋�뜝�럥痢㏆옙�쐻占쎈윥占쎄괴�뜝�럥�맶占쎈쐻�뜝占� iframeBanner */\r\n.kgMenuList .bnr {text-align: center;position: absolute;bottom:100px;right:10px;width:100px;height:65px}\r\n\r\n/* �뜝�럥�맶�뜝�럥�쑅占쎈빝占쎌돥占쎌맶�뜝�럥�쑋�뜝�럥痢㏆옙�쐻占쎈윥占쎄괴�뜝�럥�맶占쎈쐻�뜝占� 占쎈쐻占쎈윥占쎈읁占쎈쐻占쎈윥筌앷엥�쐻占쎈쑆占쏙옙嶺뚮쪋�삕�뜝�럥�맶占쎈쐻�뜝占�(占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝�뜝�럩釉わ옙踰됵옙留띰옙�쐻占쎈윥占쎌맽占쎈쐻占쎈윥占쎌끍占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗占쎈쐻占쎈윥�댆�벩�쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽�뜝�럥堉�占쎈쐻�뜝占�) */\r\n.kgBanner {position:absolute; top:29px; left:-192px; width:100px; height:432px; border-right:0; vertical-align:middle; overflow: hidden;}\r\n.kgBanner .logo {display:block; width:138px;height:50px;}\r\n.kgBanner .bnr {display:block; width:100px;height:432px;}\r\n\r\n/* �뜝�럥�맶�뜝�럥�쑅占쎈빝占쎌돥占쎌맶�뜝�럥�쑋�뜝�럥痢㏆옙�쐻占쎈윥占쎄괴�뜝�럥�맶占쎈쐻�뜝占� �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃轅⑤쐻占쎈윥占쎈읁占쎈쐻占쎈윥筌앷엥�쐻占쎈쑆占쏙옙嶺뚮쪋�삕�뜝�럥�맶占쎈쐻�뜝占�(占쎈쐻占쎈윥占쎄틦�뜝�뜦維�甕곗×罹놅옙�눓占쎌맶�뜝�럥�쑅�뜏類ｍ넪占쎈돗�뜝�럩�뮇�뜝�럥�넅占쎈쐻占쎈윪�뤃占�) */\r\n.kgBanner_left {position:absolute; top:0px; left:-120px; width:110px; height:600px; border-right:0; vertical-align:middle; overflow: hidden;}\r\n.kgBanner_left .bnr {display:block; width:110px;height:600px;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윥�뜝�뜦�뙔占쎈돗�뜝�럩�뤁�뜝�럩�뮡�뜝�럡�렊 �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃轅⑤쐻占쎈윥占쎈읁占쎈쐻占쎈윥筌앷엥�쐻占쎈쑆占쏙옙嶺뚮쪋�삕�뜝�럥�맶占쎈쐻�뜝占�(占쎈쐻占쎈윥占쎄틦�뜝�뜦維�甕곗×罹놅옙�눓占쎌맶�뜝�럥�쑅�뜏類ｍ넪占쎈돗�뜝�럩�뮇�뜝�럥�넅占쎈쐻占쎈윪�뤃占�) */\r\n.kgBanner_right {position:absolute; top:0px; left:830px; width:110px; height:600px; border-right:0; vertical-align:middle; overflow: hidden;}\r\n.kgBanner_right .bnr {display:block; width:110px;height:600px;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윥�뜝�뜦�뙔占쎈돗�뜝�럩�뤁�뜝�럩�뮡�뜝�럡�렊 占쎈쐻占쎈윥占쎈듋�뜝�럥�뇢�뜝�럥�렑占쎈쐻占쎈짗占쎈쭟�뜝�럩援뀐옙�쐻占쎈윪鈺곕끀�쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈눇�뙼怨대춱�뜝�럩留띰옙�쐻占쎈윥占쎌몗占쎈쐻占쎈윥占쏙옙 */\r\n.kgPayments {position:absolute; top:0; right:0; width:170px; height:600px; padding:0 20px;background:#F8F8F8; border-left:1px solid #ddd}\r\n.kgPayments .logo {display:block;padding:30px 3px 15px 0;border-bottom: 1px solid #ccc;margin-bottom:3px}\r\n/* *:first-child+html .kgPayments .logo {filter: alpha(opacity=50);} IE7 */\r\n/* .kgPayments .logo {-ms-filter:\"progid:DXImageTransform.Microsoft.Alpha(Opacity=50)\";} IE8 */\r\n\r\n.kgPayments .bottomline {height:1px; margin-top:12px; background-color: #ccc; opacity:0.4; filter:alpha(opacity:\"40\"); -ms-filter: \"progid:DXImageTransform.Microsoft.Alpha(Opacity=40)\"; filter: alpha(opacity=40);}\t/*filter - ie7 ie8*/\r\n.kgPayments .topline \t{height:1px; margin-bottom:11px; background-color: #ccc; opacity:0.4; filter:alpha(opacity:\"40\"); -ms-filter: \"progid:DXImageTransform.Microsoft.Alpha(Opacity=40)\"; filter: alpha(opacity=40);}/*filter - ie7 ie8*/\r\n\r\n.kgPayments dl.hist {overflow:hidden; min-height:16px; padding:7px 0; margin:0;}\r\n.kgPayments dl.hist dt {float:left; padding:0; margin:0; color:#333;font-size:11px;}\r\n.kgPayments dl.hist dd {float:right;padding:0; margin:0; color:#333; width:auto; text-align:right; text-overflow:ellipsis;overflow: hidden;font-weight:bold}\r\n.kgPayments dl.hist dd span{font-weight:bold;font-size:12px;font-weight:bold}\r\n.kgPayments dl.hist dd .btnType03 span{font-size:11px;color: #fff!important;}\r\n.kgPayments dl.hist_new {overflow:hidden; height:34px; padding:7px 0; margin:0;}\r\n.kgPayments dl.hist_new dt {float:left; width:40px;height:30px; padding:0; margin:0; color:#333; opacity:0.7; -ms-filter: \"progid:DXImageTransform.Microsoft.Alpha(Opacity=70)\"; filter: alpha(opacity=70);}\r\n.kgPayments dl.hist_new dd {float:right; width:100px;height:30px; padding:0; margin :0; color:#333; text-align:right; overflow: hidden;}\r\n\r\n.hist_new {width:100%;}\r\n.hist_new td.titl {width:50px;height:18px;margin:0; vertical-align:top; color:#fff; opacity:0.7; -ms-filter: \"progid:DXImageTransform.Microsoft.Alpha(Opacity=70)\"; filter: alpha(opacity=70);}\r\n.hist_new td.txtl {height:18px; padding:0; margin :0; color:#fff; text-align:left;}\r\n\r\n.hist_new2 {width:100%;}\r\n.hist_new2 td.titl {width:50px;height:18px;margin:0; vertical-align:top; color:#fff; }\r\n.hist_new2 td.txtl {height:18px; padding:0; margin :0; color:#fff; text-align:right;}\r\n\r\n.kgPayments dl.hist_ex {overflow:hidden; height:25px; padding:7px 0; margin:0;}\r\n.kgPayments dl.hist_ex dt {float:left; padding:0; margin:0; color:#fff; }\r\n.kgPayments dl.hist_ex dd {float:center;padding:0; margin:0; color:#fff; width:155px; text-align:center; text-overflow:ellipsis; white-space: nowrap; overflow: hidden;}\r\n\r\n.kgPayments dl.total {overflow:hidden; padding:15px 0;border-top:1px solid #ccc;margin-top:7px}\r\n.kgPayments dl.total dt {float:left; padding:0; margin:0; color:#333;font-size: 11px}\r\n.kgPayments dl.total dd {float:right;padding:0; margin:0; color:#333;font-size: 15px}\r\n.kgPayments dl.total dd strong {font-size:16px; line-height:16px;}\r\n\r\n.btnArea {position:absolute; width:210px; bottom:20px; right:0; text-align:center;}\r\n.btnArea a {display:inline-block; margin:0 4px;}\r\n.btnArea a:focus {outline: 2px solid #000;color:#c1272c}\r\n.kgPayments .bnr {text-align: center;position: absolute;bottom:81px;right:22px;width:165px;height:65px}\r\n.kgPayments .bnr a{display: block}\r\n\r\n/*占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗占쎈쐻占쎈윥�뤃寃쇰쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽�뜝�럥堉��뜝�럩�뭶�뜝�럩留띰옙�쐻占쎈윥占쎌몗占쎈쐪筌먦끉�룯�뜝�럥裕뗰옙�쐻占쎈윥占쎌넅占쎈쐻占쎈윪�뤃占� 占쎈쐻占쎈윥占쎄틦�뜝�뜦維�占쎈뮝力놂옙癰귥옓�맶�뜝�럥�쑅占쎄슈�뜝占�  */\r\n.kgContents .btnArea {position:absolute; width:100%; bottom:19px; left:0; text-align:center;}\r\n.kgContents .btnArea a {display:inline-block; margin:0 4px;}\r\n.kgContents .btnArea a:focus {outline: 1px dashed #999;}\r\n.kgContents .bnr {text-align: center;width:165px;height:80px} /* 201605 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗占쎈쐻占쎈윥�눧袁��쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윪占쎌죧 */\r\n.kgContents .bnr img{width:165px;height:80px;margin:0 auto}\r\n\r\n/* contents */\r\n.kgContents {width:450px; padding:15px 20px 0 20px;height:533px;position: relative;overflow: hidden}\r\n*:first-child+html .kgContents {position:relative; width:429px; padding:14px 19px; border:0;} /* IE7 */\r\n\r\n/* text */\r\n.copy01 {padding:0 4px; margin:0 0 5px; font-size:12px; color:#222;}\r\n.copy02 {padding:0; margin:0 0 10px; font-size:16px; color:#555;}\r\n.copy03 {padding:0; margin:15px 0; font-size:13px; color:#777; letter-spacing:-0.1px;}\r\n.sTxt {padding:0; margin-top:2px; font-size:11px; color:#555;}\r\n\r\n h1.copy02 {margin-bottom:5px;}\r\n h2.copy01 {margin-top:3px;}\r\n\r\n/* dlType */\r\n.dlType01 {position:relative; padding:7px 0 0; margin:0;}\r\n.dlType01 dt {height:18px; padding:0 6px; margin:0 0 3px; color:#555; font-weight:bold;}\r\n*:first-child + html .dlType01 dt {height:20px;} /* IE7 */\r\n.dlType01 dd {padding:0; margin:0 0 10px; color:#666;}\r\n.dlType01 dd .scrollBox {overflow-y:scroll;height:37px; padding:6px 10px; line-height:15px; color:#555;border:1px solid #dddddd; background:none; text-align:justify}\r\n.dlType01 dd.detail {position:absolute; top:6px; right:0; height:15px; padding:2px 0 0; margin:0; line-height:17px;}\r\n.dlType01 dd.detail .check input {vertical-align:top;}\r\n.dlType01 dd.detail a {margin-top:-2px;font-size:11px;padding-bottom:2px}\r\n.dlType01 dd.detail a:focus {outline: 1px dashed #999;}\r\n.dlType01.pT0 dd.detail {top:0;}\r\n.dlType01 dd.detail a.btnType05{padding:2px 6px;border-radius: 4px;}\r\n.dlType01 dd.detail a.btnType05 span{font-size:11px}\r\n\r\n.dlType02 {border:1px solid #dbdbdb; padding:8px 15px 4px; margin:0;}\r\n.dlType02 dt {font-weight:bold; margin-bottom:5px;}\r\n.dlType02 dt img {display:inline-block; margin-top:-2px; vertical-align:middle;}\r\n.dlType02 dd {padding:0; margin:0; line-height:17px;}\r\n\r\n.dlType03 {border:1px solid #dbdbdb; border-width:1px 0; padding:8px 15px 4px; margin:10px 0 15px; color:#555;}\r\n.dlType03 dt {font-weight:bold; margin-bottom:5px;}\r\n.dlType03 dd {padding:0 0 0 8px; text-indent:-8px; margin:0; line-height:17px;}\r\n.dlType03 dd img {vertical-align:middle;}\r\n\r\n.dlType04 {padding:0; margin:20px 0; color:#555;}\r\n.dlType04 dt {font-weight:bold; margin-bottom:5px; letter-spacing:1px;}\r\n.dlType04 dd {padding:0; margin:0 0 10px; line-height:17px; color:#777; letter-spacing:0px;}\r\n.dlType04 dd img {vertical-align:middle;}\r\n\r\n/* list */\r\n.radioList {overflow:hidden; padding:2px 0 0 0; margin:0; list-style:none;}\r\n*:first-child + html .radioList {border: 0;}\r\n.radioList li{float:left; padding:0; margin-right:15px; height:24px; line-height:24px;}\r\n.radioList li{border: 0;}\r\n\r\n.radioList.type02 {padding-top:5px;}\r\n.radioList.type02 li {margin-right:10px;}\r\n\r\n.radioList01 {overflow:hidden; height:34px; padding:0; margin:0; list-style:none;}\r\n.radioList01 li {position:relative; float:left; padding:7px 0 9px 8px; margin:0 8px 0 0; width:127px; height:16px; font-weight:bold; background:#fff; color:#666; border:none}\r\n.radioList01 li img {display:inline-block; margin-right:2px;}\r\n.radioList01 li.last {margin-right:0; width:128px;}\r\n.radioList01 li .btnQ {position:absolute; top:9px; right:7px; font-size:0; line-height:0;}\r\n.radioList01 li .btnQ img {margin-right:0;}\r\n.radioList01 li .icoList {display:inline-block; font-size: 0; margin-left: -3px;}\r\n.radioList01 li .icoList img {margin-right:1px;margin-bottom: 9px}\r\n\r\n.radioList01 li label {height:14px; line-height:14px;margin-top:-1px}\r\n.radioList01 li label img {display:none; width:40px; height:16px; margin-top:-2px;}\r\n.radioList01 li label span {display:inline-block;}\r\n.radioList01 li label.a:hover span{display:none;}\r\n.radioList01 li label.a:hover img {display:inline-block;}\r\n\r\n.radioList01.no02 li{width:200px;}\r\n.radioList01.no01 li{width:418px; margin-right:0;}\r\n\r\n.radioList02 {overflow:hidden; padding:8px 0 10px; margin:0; list-style:none;}\r\n.radioList02 li {float:left; padding:0 0 0 8px; margin:0 8px 0 0; width:129px; height:27px; line-height:27px;}\r\n.radioList02 li.nth3 {margin-right:0;}\r\n.radioList02 li .icoList {display:inline-block; font-size: 0; margin-left: -3px;}\r\n.radioList02 li .icoList img {margin-right:1px; margin-bottom: 9px}\r\n\r\n.radioList02 li label {height:16px; line-height:16px;}\r\n.radioList02 li label img {display:none; width:40px; height:16px; margin-top:-2px;}\r\n.radioList02 li label span {display:inline-block;}\r\n.radioList02 li label.a:hover span{display:none;}\r\n.radioList02 li label.a:hover img {display:inline-block;}\r\n\r\n.radioList03 {overflow:hidden; padding:10px 0; margin:0; list-style:none;}\r\n.radioList03 li {float:left; padding:0 0 0 8px; height:27px; line-height:27px; vertical-align: baseline;}\r\n\r\n.radioList04 {overflow:hidden; padding:10px 0; margin:0 0 10px; list-style:none; border-top:1px solid #ddd; border-bottom:1px solid #ddd;}\r\n.radioList04 li {padding:2px 0 0 8px; height:27px; line-height:27px; line-height:27px; vertical-align: baseline;}\r\n\r\n.radioList05 {overflow:hidden; padding:8px 0 10px; margin:0; list-style:none;}\r\n.radioList05 li {float:left; padding:0 0 0 8px; margin:0 8px 0 0; width:129px; height:27px; line-height:27px;}\r\n.radioList05 li.nth3 {margin-right:0;}\r\n.radioList05 li .icoList {display:inline-block; font-size: 0; margin-left: -3px;}\r\n.radioList05 li .icoList img {margin-right:1px; margin-bottom: 9px}\r\n\r\n.radioList05 li label {height:16px; line-height:16px;}\r\n.radioList05 li label img {display:none; width:40px; height:16px; margin-top:-2px;}\r\n.radioList05 li label span {display:inline-block;}\r\n.radioList05 li label.a:hover span{display:none;}\r\n.radioList05 li label.a:hover img {display:inline-block;}\r\n\r\n.checkList01 {overflow:hidden; padding:6px 8px; width:348px; margin:0; list-style:none;}\r\n.checkList01 li {float:left; padding:2px 0; width:165px; white-space:nowrap;}\r\n\r\n.checkList02 {overflow:hidden; padding:6px 5px; width:450px; margin:0; list-style:none;}\r\n.checkList02 li {float:left; padding:2px 0; width:214px; white-space:nowrap;}\r\n\r\n.checkList03 {position: relative; overflow:hidden; list-style:none; margin: 15px 0 10px 0;}\r\n.checkList03 li {position: relative; float:left; width: 214px; height: 22px; line-height: 22px; letter-spacing: -1px;}\r\n*:first-child+html .checkList03 li {letter-spacing: -1.5px;}\r\n.checkList03 li .allAgreement {font-weight: bold;}\r\n.checkList03 li .btnAgree {position: absolute; top: -1.5px; right: 5px;}\r\n\r\n/* �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃占� */\r\n.checkList04 {position: relative; overflow:hidden; list-style:none; margin: 15px 0 10px 0;}\r\n.checkList04 li {position: relative; float:left; width:50%;letter-spacing: -1px;overflow:hidden;padding:2px 0;line-height:22px; vertical-align:middle}\r\n*:first-child+html .checkList04 li {letter-spacing: -1.5px;}\r\n.checkList04 li .agreeTxt{line-height:1.2;display:inline-block;padding:0 40px 0 15px;width:165px}\r\n.checkList04 li .allAgreement {font-weight: bold;}\r\n.checkList04 li .btnAgree {position: absolute; top: 2px; right: 5px;}\r\n.checkList04 li .check{position: absolute; top:8px; left: 0;}\r\n.checkList04 .allAgreement{width:100%};\r\n\r\n.icoList {margin-bottom:10px; text-align:right; font-size: 0px;}\r\n.icoList img {margin-left:1px;}\r\n\r\n.btnList {text-align:right; padding-right:5px; margin-bottom:8px; font-size:0; line-height:0;}\r\n.btnList a {margin-left:2px;}\r\n\r\n/* table */\r\n.tblType01 {width:100%; margin:0 0 10px; border-collapse:collapse; border-top:1px solid #dbdbdb;}\r\n.tblType01 td {padding:5px 15px 3px 15px; height:24px; line-height:24px; vertical-align:middle; background:#f9f9f9; border-bottom:1px solid #dbdbdb;}\r\n.tblType01 td.tit {padding:5px 10px 3px 19px; background:#efefef;}\r\n.tblType01 th.tit {padding: 5px 10px 3px 19px; background: #efefef; border-bottom: 1px solid #dbdbdb; font-weight: 300; text-align: left;}\r\n\r\n.tblType02 {width:100%; border-collapse:collapse;}\r\n.tblType02 td {padding:4px 15px; height:24px; line-height:24px; vertical-align:middle; border:1px solid #dadada;}\r\n.tblType02 td.tit {text-align:center;}\r\n.tblType02 .odd td {background:#f3f3f3;}\r\n\r\n.tblType03 {width:100%; margin:0 0 10px; border-collapse:collapse; border-top:1px solid #dbdbdb; table-layout: fixed;}\r\n*:first-child + html .tblType03 {border-right: 0;border-bottom: 0;border-left: 0;}\r\n.tblType03 td, .tblType03 th {padding:2px 10px;height:22px;background:#fff; color:#555; font-weight:400; border-bottom:1px solid #dbdbdb;}\r\n.tblType03 td.tit {padding:5px 0 5px 0; text-align:center; color:#666; vertical-align: middle;}\r\n\r\n.tblType03 td.titL, .tblType03 th.titL {padding:5px 5px 3px 10px; text-align:left; color:#666;background:#fff; vertical-align: middle; width: 100px;border-right: 1px solid #DBDBDB;}\r\n.tblType03 td.txtL {/*line-height: 30px;*/}\r\n.tblType03 td.btn {padding:5px 0px; text-align:center;}\r\n.tblType03 td.txtR {text-align:right; padding-right:10px;}\r\n.tblType03 td.txtC {padding:5px 0;}\r\n.tblType03 td a img {vertical-align:middle;}\r\n\r\n.tblType04 {width:100%; *width: 405px; border-collapse:collapse; margin:20px 0 0; border:1px solid #dadada; font-size: 12px;}\r\n.tblType04 td {padding: 6px 10px 1px; border-bottom: 1px solid #dadada;}\r\n.tblType04 td.tit {text-align: center;  border-right: 1px solid #dadada; font-weight: bold; background:#f3f3f3;}\r\n.tblType04 td.txtL {line-height: 12px;}/* 20160525 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗�뜝�럥���뜝�떥�궡留띰옙�쐻占쎈윥占쎌맽占쎈쐻占쎈윥占쎌졑占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽占쎈쐻占쎈윥�뜝�룞�삕占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윪鈺곤옙 */\r\n.tblType04 td .icon {display: block; padding: 0 0 4px 10px; background: url(https://stdux.inicis.com/stdpay/img2/icon02.gif) no-repeat 0 2px;}\r\n.tblType04 .odd td {}\r\n\r\n.tblType05 {width:100%; margin:0 0 10px; border-collapse:collapse; border-top:1px solid #dbdbdb;}\r\n*:first-child + html .tblType03 {border-right: 0;border-bottom: 0;border-left: 0;}\r\n.tblType05 td {padding:4px 10px; height:24px; line-height:24px; vertical-align:top; background:#fff; color:#555; border-bottom:1px solid #dbdbdb;}\r\n.tblType05 td.tit {padding: 5px 0 5px 0; text-align:center; color:#666; background:#f5f5f5; vertical-align: middle;}\r\n.tblType05 td.titL {padding: 5px 0 3px 10px; text-align: left; color:#666; vertical-align: middle; width: 94px;border-right:1px solid #dbdbdb ;}\r\n.tblType05 td.btn {padding:5px 10px;}\r\n.tblType05 td.txtR {text-align:right; padding-right:10px;}\r\n.tblType05 td.txtC {padding:5px 0;}\r\n.tblType05 td a img {vertical-align:middle;}\r\n\r\n.btmBnr {position:absolute; bottom:30px; left:0; width:490px; height:50px; background:#eee;z-index:5}\r\n*:first-child + html .btmBnr{top:380px;}/* IE7 */\r\n\r\n.listType01 {padding:0; margin:10px 0 5px; list-style:none;}\r\n.listType01 li {padding:0 0 0 15px; margin:3px 0; background:url(\"https://stdux.inicis.com/stdpay/img/icoSq.gif\") no-repeat 5px 5px;}\r\n.listType01 li span.textStrong {color: #000;}\r\n\r\n.deem {position:absolute; top:0; left:0; width:100%; height:100%; background:#000; z-index:999; opacity:0.15; -ms-filter: \"progid:DXImageTransform.Microsoft.Alpha(Opacity=15)\"; filter: alpha(opacity=15);}\r\n\r\n.btnType01 {overflow:hidden; display:inline-block; height:13px; line-height:12px; font-size:11px; padding:3px 8px; color:#fff; background:#acacac; vertical-align:middle; text-indent:0;border-radius: 4px;}\r\n*:first-child+html .btnType01 {border: 0;}\r\n.btnType01 span {display:inline-block;}\r\n*:first-child+html .btnType01 span{border: 0;}\r\n.btnType01:hover {background:#919191; color:#dfdfdf;}\r\n\r\n.btnType02 {overflow:hidden; display:inline-block; height:16px; line-height:16px; font-size:12px; padding:3px 6px; color:#fff; background:#555; vertical-align:middle; text-indent:0;border-radius: 4px;}\r\n.btnType02 span {display:inline-block;}\r\n.btnType02:hover {background:#555; color:#dfdfdf;}\r\n.btnType02:focus {color:#fff;}\r\n\r\n.btnType03 {overflow:hidden; display:inline-block;font-size:11px; padding:2px 4px ;line-height:15px;color: #fff!important; background:#f9870d; vertical-align:middle; text-indent:0;border-radius: 4px;}\r\n.btnType03 span {display:inline-block;}\r\n\r\n.btnType04 {overflow:hidden; display:inline-block; line-height:15px; font-size:11px; padding:3px 6px;color:#fff!important; background:#f9870d; vertical-align:middle;text-indent:0;border-radius: 4px;}\r\n.btnType04 span {display:inline-block;}\r\n\r\n.btnType05 {overflow:hidden; display:inline-block;font-size:11px;height:14px;line-height:14px; padding:2px 6px 2px 6px; color:#fff!important; background:#555; vertical-align:middle;text-indent:0;border-radius: 4px;}\r\n.btnType05 span {display:inline-block;}\r\n.btnType05:hover {background:#919191; color:#dfdfdf;}\r\n\r\n.btnType06 {overflow:hidden; display:inline-block; text-align:center; width:72px; height:34px; line-height:34px; font-weight:bold; color:#fff; background:#a1a1a1; vertical-align:middle;border-radius: 8px;border-radius: 4px;}\r\n.btnType06:hover {color:#d4d4d4; background:#888;}\r\n\r\n.btnType07 {overflow:hidden; display:inline-block; text-align:center; width:72px; height:34px; line-height:34px; font-weight:bold; color:#fff; background:#f2310b; vertical-align:middle;border-radius: 4px;}\r\n\r\n\r\n.btnType08 {overflow:hidden; display:inline-block; text-align:center; width:72px; height:34px; line-height:34px; font-weight:bold; color:#cc1915; background:#fff; vertical-align:middle;border-radius: 4px;}\r\n.btnType08:hover {color:#a1120f; background:#e5e5e5;}\r\n.btnType08:active {color:#cc1915; background:#fff;} /* 20160517 �뜝�럥�맶�뜝�럥�쑅�뜝�럥猷억옙�쐻占쎈윞�뙼占쏙옙�쐻占쎈윥筌욎�λ쐻占쎈윪�뤃占� */\r\n\r\n.btnWrapC {padding:0; margin:30px 0; text-align:center;}\r\n.btnWrapC a {display:inline-block; margin:0 5px;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윞�뙼臾덈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽占쎈쐻占쎈윥�뙴�뱶�쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝�뜝�럡�뜦�뜝�럥占쎌쉻�삕占쎈�뉛옙�쐺獄�袁る쭒占쎌젂占쎈씮�굲占쎌뼔�섓옙�맶占쎈쐻�뜝占� 占쎈쐻占쎈윥占쎄틦�뜝�뜦維�占쎈뮝力놂옙癰귥옓�맶�뜝�럥�쑅占쎄슈�뜝占� */\r\n.btn01 {overflow:hidden; position:absolute; top:10px; right:0; padding-left:5px; padding-right:5px;}\r\n.btn01:hover {background:#919191; color:#dfdfdf;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윞�뙼臾덈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽占쎈쐻占쎈윥�뙴�뱶�쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝�뜝�럡�뜦�뜝�럥占쎌쉻�삕占쎈�뉛옙�쐺獄�袁る쭒占쎌젂占쎈씮�굲占쎌뼔�섓옙�맶占쎈쐻�뜝占� 占쎈쐻占쎈윥占쎄틦�뜝�뜦維�占쎈뮝力놂옙癰귥옓�맶�뜝�럥�쑅占쎄슈�뜝占� */\r\n.btn02 {overflow:hidden; display:inline-block; width:69px; height:17px; margin-left:3px; background:url(\"https://stdux.inicis.com/stdpay/img/btnDetail.gif\") no-repeat 0 0; text-indent:-999px; vertical-align:middle;}\r\n.btn02:hover {background:url(\"https://stdux.inicis.com/stdpay/img/btnDetailOn.gif\") no-repeat 0 0;}\r\n\r\n/* �뜝�럥�맶�뜝�럥�쑅�뜝�럥援섇뜝�럥�맶�뜝�럥�쑅占쎈뙕占쎈젿占쎌맶�뜝�럥�쐾�뜝�럥堉� 占쎈쐻占쎈윥占쎄틦�뜝�뜦維�占쎈뮝力놂옙癰귥옓�맶�뜝�럥�쑅占쎄슈�뜝占� */\r\n.btn03 {overflow:hidden; display:inline-block; width:72px; height:34px; background:url(\"https://stdux.inicis.com/stdpay/img/btnCancel.gif\") no-repeat 0 0; text-indent:-999px; vertical-align:middle;}\r\n.btn03:hover {background: url(\"https://stdux.inicis.com/stdpay/img/btnCancelOn.gif\")\r\n\t\tno-repeat 0 0;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗�뜝�럩�쟼�넭怨살삕�뜝�럩留띰옙�쐻占쎈윥占쎌몝占쎈탶�ⓦ끉�굲 占쎈쐻占쎈윥占쎄틦�뜝�뜦維�占쎈뮝力놂옙癰귥옓�맶�뜝�럥�쑅占쎄슈�뜝占� */\r\n.btn04 {overflow:hidden; display:inline-block; width:72px; height:34px; background:url(\"https://stdux.inicis.com/stdpay/img/btnNext.gif\") no-repeat 0 0; text-indent:-999px; vertical-align:middle;}\r\n.btn04:hover {background:url(\"https://stdux.inicis.com/stdpay/img/btnNextOn.gif\") no-repeat 0 0;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈듋�뜝�럥�뇢�뜝�럥�렑占쎈쐻占쎈짗占쎈쭟�뜝�럩援뀐옙�쐻占쎈윪鈺곤옙 占쎈쐻占쎈윥占쎄틦�뜝�뜦維�占쎈뮝力놂옙癰귥옓�맶�뜝�럥�쑅占쎄슈�뜝占� */\r\n.btn05 {overflow:hidden; display:inline-block; width:72px; height:34px; background:url(\"https://stdux.inicis.com/stdpay/img/btnPay.gif\") no-repeat 0 0; text-indent:-999px; vertical-align:middle;}\r\n.btn05:hover {background:url(\"https://stdux.inicis.com/stdpay/img/btnPayOn.gif\") no-repeat 0 0;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윞占쎄섐占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝�뜝�럩堉뀐옙�굲 占쎈쐻占쎈윥占쎄틦�뜝�뜦維�占쎈뮝力놂옙癰귥옓�맶�뜝�럥�쑅占쎄슈�뜝占� */\r\n.btn06 {overflow:hidden; display:inline-block; width:72px; height:34px; background:url(\"https://stdux.inicis.com/stdpay/img/btnConfirm02.gif\") no-repeat 0 0; text-indent:-999px; vertical-align:middle;}\r\n.btn06:hover {background:url(\"https://stdux.inicis.com/stdpay/img/btnConfirm02On.gif\") no-repeat 0 0;}\r\n\r\n.btnQ {display:inline-block; line-height:15px;}\r\n.btnQ img {vertical-align:top; margin-top:-1px;}\r\n\r\n.popLayer {position:fixed; top:50%; left:50%; padding:30px 24px; background:#fff; border:1px solid #ccc;border-radius: 16px; z-index:9999;box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);}\r\n.popLayer_scul {/* position:absolute; top:50%; left:50%; */ margin: 30px 20px; background:#fff; z-index:9999;} /* 20160519 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗占쎈쐻占쎈윥�눧袁��쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈쐻占쎈윪占쎌죧 */\r\n.popLayer .btnAbsolC {position:absolute; bottom:30px; left:0; width:100%; text-align:center; padding:0; margin:0;}\r\n.popLayer .tblType03 td {padding-top:3px; padding-bottom:3px;}\r\n.popLayer .btnType06:hover {overflow:hidden; display:inline-block; text-align:center; width:72px; height:34px; line-height:34px; font-weight:bold; color:#fff; background:#a1a1a1; vertical-align:middle;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占쎈눇�뙼�맧彛묈뜝�럩留띰옙�쐻占쎈윥