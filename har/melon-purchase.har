").find(\"input:radio[name=selCoupon]:checked\").val() != null){\r\n\t\t\t//현재 사용중인 쿠폰 시퀀스\r\n\t\t\tvar type = $(\"#overlay_popup2\").find(\"input:radio[name=selCoupon]:checked\").val();\r\n\r\n\t\t\t//현재 사용중인 쿠폰 금액\r\n\t\t\tvar couponPrice = Number($(document).find(\"#\"+type+\"\").val());\r\n\t\t\t\r\n\t\t\t//쿠폰 사용일 경우(결제요청금액 - 쿠폰적용금액 + 이니안심금액)\r\n\t\t\ttotalPrice = oriPrice - couponPrice + kcarePrice;\r\n\t\t}else{\r\n\t\t\t//쿠폰 미사용일 경우(결제요청금액 + 이니안심금액)\r\n\t\t\ttotalPrice = oriPrice + kcarePrice;\r\n\t\t}\r\n\r\n\t\t//적용할 금액 #,### 형식으로 변경\r\n\t\tvar currency = String(totalPrice).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\r\n\t\t//우측 금액표기란에 이니안심 포함 된 금액으로 변경\r\n\t\t$(\".payPrice\").html(currency);\r\n\t\t$(\".kcarePrice\").html(String(kcarePrice).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,'));\r\n\t\t$(\".kcare\").show();\r\n\t\t\r\n\t\tvar cardCode = '';\r\n\t\t\r\n\t\tif(boolMobile){\r\n\t\t\tcardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t}else{\r\n\t\t\tcardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t}\r\n\t\t\r\n       // alert(\"카드코드 : \" + cardCode.val() + \", 카드타입 : \" + cardCode.attr(\"cardType\"));\r\n        \r\n        if(cardCode.val() != null){\r\n        \t\r\n\t\t\tif(cardCode.attr(\"cardType\") == \"isp\" || cardCode.attr(\"cardType\") == \"visa3d\"){\r\n\t\t\t/*\tif($payForm.find(\"input[name=cardQuota]\").val() != '00'){\r\n\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\tresetKcare();\r\n\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}else if($('[name=lpUse]').val() == 'true'){\r\n\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\tresetKcare();\r\n\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg3);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}else if($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf(cardCode.val()) >= 0){ //해외카드 일 경우 사용불가\r\n\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\tresetKcare();\r\n\t\t\t\t\tcal