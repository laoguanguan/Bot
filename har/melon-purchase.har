          "content": {
            "size": 21917,
            "mimeType": "text/css",
            "compression": 0,
            "text": "\n@charset \"utf-8\";\n\n\n/* reset */\nbody,div,dl,dt,dd,ul,ol,li,h1,h2,h3,h4,h5,h6,pre,code,form,fieldset,legend,textarea,p,blockquote,th,td,input,select,textarea,button{margin:0;padding:0}\nfieldset,img{border:0 none}\ndl,ul,ol,menu,li {list-style:none}\nblockquote, q {quotes: none}\nblockquote:before, blockquote:after,q:before, q:after {content:'';content:none}\ninput,select,textarea,button {vertical-align:middle}\ninput::-ms-clear {display:none}\nbutton {border:0 none;background-color:transparent;cursor:pointer}\ninput, label {cursor:pointer;}\nbody {background-color:#f0f0f0}\nbody,th,td,input,select,textarea,button {font-size:14px;line-height:1.5;font-family:'돋움',dotum,sans-serif;color:#333} /* color값은 디자인가이드에 맞게사용 */\na {color:#333;text-decoration:none}\na:active, a:hover {text-decoration:underline}\na:active {background-color:transparent}\naddress,caption,cite,code,dfn,em,var {font-style:normal;font-weight:normal}\n\n/* global */\n#daumIndex {overflow:hidden;position:absolute;left:-9999px;width:0;height:1px;margin:0;padding:0} /* 스킵네비게이션 */\n.ir_pm {display:block;overflow:hidden;font-size:0px;line-height:0;text-indent:-9999px} /* 사용된 이미지내 의미있는 텍스트의 대체텍스트를 제공할때 */\n.ir_wa {display:block;overflow:hidden;position:relative;width:100%;height:100%;z-index:-1} /* 중요한 이미지 대체텍스트로 이미지off시에도 대체 텍스트를 보여주고자 할때 */\n.screen_out {overflow:hidden;position:absolute;width:0;height:0;line-height:0;text-indent:-9999px} /* 대체텍스트가 아닌 접근성을 위한 숨김텍스트를 제공할때 */\n.view_hide {height:0;font-size:0;line-height:0;visibility:hidden}\n\n.f_l {float:left}\n.f_r {float:right}\n.cl_b {clear:both;width:0;height:0;font-size:0;line-height:0}\n.show {display:block}\n.hide {display:none}\n.tbl {border-collapse:collapse;border-spacing: 0} /* 테이블 초기화 */\n.clear_g {display:block;overflow:visible;width:auto;clear:both;*zoom:1}\n.clear_g:after {display:block;visibility:hidden;height:0;font-size:0;clear:both;content:''}\n\n/* 공통 */\n.img_pay{display:block;background:url(../images/img_pay.gif) no-repeat 0 0}\n.ico_form{display:block;background:url(../images/ico_form.png) no-repeat 0 0}/* 2018-11-09 추가 */\n.popup_body{overflow:hidden;width:100%}\n.tit_pay{display:block;padding:28px 0 0 31px;font-size:20px;line-height:24px}\n.tit_detail{float:left;padding:8px 9px 0 0;line-height:16px;color:#666}\n.list_infomation{padding:20px 26px 0 32px}\n.box_pay .list_infomation{padding:0}\n.list_fst{padding-top:4px}\n.list_infomation li{margin-top:11px;padding-left:12px;font-size:13px;line-height:15px;color:#666;background:url(../images/bul_pay.gif) no-repeat 0 5px;letter-spacing:0}\n.list_infomation .txt_moreinfo{font-weight:bold;text-decoration:underline}\n.list_infomation .link_detail{display:inline-block;padding:0 8px 5px;color:#666}\n.list_infomation .link_page{color:#666;text-decoration:underline}\n.box_pay{margin:17px 16px 0;padding:27px 30px 31px;border:1px solid #e9e9e9;background-color:#fff}\n.tit_info{display:block;font-size:18px}\n.tbl_pay{width:100%;margin-top:10px;border-top:2px solid #808080;border-collapse:collapse;border-spacing:0}\n.tbl_fst{margin-bottom:37px}\n.tbl_lst{margin-top:30px}\n.tbl_pay th{width:144px;border-bottom:1px solid #dbdbdb;font-weight:normal;background-color:#f7f7f7;text-align:left}\n.tbl_pay td{border-bottom:1px solid #e0e0e0;font-weight:bold;text-align:right}\n.tbl_pay .inner_cell{padding:17px 21px 16px}\n.emph_pay{font-weight:bold;color:#ee252c}\n.emph_info{color:#333}\n.emph_g{font-weight:bold}\n\n/* header */\n.popup_pay_type{position:relative;width:520px}\n.popup_pay_tax{position:relative;width:695px}\n.popup_head{height:48px;padding-top:31px;border-bottom:1px solid #3d3d3d;background-color:#474747}\n.tit_daumkakaopay{position:relative;z-index:1;padding-left:32px;font-weight:normal;font-size:26px;line-height:28px;color:#e0e0e0;letter-spacing:-1px;vertical-align:top}\n.popup_head .img_pay{display:inline-block;width:219px;height:24px;margin-top:6px}\n\n/* 버튼 */\n.bundle_pay{margin-top:20px;white-space:nowrap}\n.btn_pay{display:inline-block;height:26px;margin-right:7px;padding:0 8px 0 9px;border:1px solid #d6d6d6;color:#666;background-color:#fefefe;background-image:-webkit-gradient(linear, left top, left bottom, from(#fff), to(#f7f7f7));background-image:-moz-linear-gradient(top, #fff, #f7f7f7);background-image:-o-linear-gradient(top, #fff, #f7f7f7);background-image:linear-gradient(to bottom, #fff, #f7f7f7)}\n.btn_pay2{display:inline-block;height:26px;margin-right:7px;padding:0 8px 0 9px;border:1px solid #d6d6d6;color:#666;background-color:#fefefe;background-image:-webkit-gradient(linear, left top, left bottom, from(#fff), to(#f7f7f7));background-image:-moz-linear-gradient(top, #fff, #f7f7f7);background-image:-o-linear-gradient(top, #fff, #f7f7f7);background-image:linear-gradient(to bottom, #fff, #f7f7f7)}\nbutton.btn_pay{height:28px}\nbutton.btn_pay2{height:28px}\n.btn_pay .ico_shortcut{display:inline-block;width:6px;height:10px;margin:0 0 0 6px;background-position:-80px -50px}\n.btn_pay2 .ico_shortcut{display:inline-block;width:6px;height:10px;margin:0 0 0 6px;background-position:-80px -50px}\n\n/* 셀렉트 박스 */\n.select_pay{display:inline-block;position:relative;width:92px;height:23px;padding:3px 39px 0 7px;border:1px solid #d6d6d6;line-height:21px;background-color:#fff;text-align:right}/* 2015-08-20 수정 */\n.select_off{color:#919191}\n.select_pay .opt_pay{overflow:hidden;position:absolute;top:0;left:0;width:100%;height:26px;border:0 none;background:none;vertical-align:top;letter-spacing:0;opacity:0.01;filter:alpha(opacity=0)}\n.select_pay .btn_select{position:absolute;right:0;top:0;width:26px;height:26px;margin:0;padding:0;border-top:0 none;border-right:0 none;border-bottom:0 none}\n.btn_select .img_pay{width:8px;height:5px;margin:11px auto 0;background-position:-60px -50px}\n\n/* 폼요소 */\n.tf_direct{width:138px;height:26px;border:1px solid #aeaeae;border-right-color:#ccc;border-bottom-color:#ccc;vertical-align:top}\n.inp_pay{float:left;width:13px;height:13px;margin-top:1px}\n.lab_pay{display:inline-block;overflow:hidden;padding-left:7px;line-height:16px}\n.pay_input{position:relative;z-index:1;border:1px solid #d7d7d7;background-color:#fff}\n.pay_input .lab_input{position:absolute;left:10px;top:0;z-index:-1;line-height:30px;color:#919191;cursor:text}\n.pay_input .tf_pay{width:100%;height:26px;padding-top:2px;border:0 none;line-height:20px;background-color:transparent;text-align:left;text-indent:10px}\n.pay_check{overflow:hidden;padding:0 1px}\n.bundle_check{float:left;width:50%;line-height:17px}\n.pay_check .inp_check{width:14px;height:14px;margin-top:1px;vertical-align:top}\n.pay_check .lab_check{font-weight:bold;padding-left:5px}\n.pay_check .off .lab_check{font-weight:normal;color:#666}\n\n/* 잔액 정보 */\n.info_pay{padding:35px 0 32px 32px;border-bottom:1px solid #dfdfdf;background-color:#fff}\n.info_pay .pay_item{font-weight:normal;font-size:18px}\n.info_pay .txt_user{display:block;font-size:14px;color:#666}\n.info_pay .txt_user2{font-weight:bold}\n.info_pay .pay_price{display:block;padding:11px 31px 0 0;text-align:right}\n.pay_price .tit_price{display:inline-block;padding:9px 5px 0 0;color:#919191;vertical-align:top}\n.pay_price .emph_pay{display:inline-block;font-size:24px;vertical-align:top}\n.pay_price .txt_price{display:inline-block;margin-top:6px;font-weight:bold;font-size:18px;vertical-align:top}/* 2015-08-20 추가 */\n\n/* 하단버튼 */\n/*.bundle_btn{overflow:hidden;position:absolute;left:0;bottom:16px;width:100%;text-align:center}*/\n.bundle_btn{overflow:hidden;left:0;bottom:16px;width:100%;text-align:center;margin-top:20px; margin-bottom:20px;}\n.inner_btn{display:inline-block;overflow:hidden;vertical-align:top}\n.inner_btn .btn_popup{display:inline;float:left;width:238px;height:48px;margin:0 4px;border:1px solid #666;font-size:18px;line-height:51px;color:#fff;background-color:#707070;text-align:center;text-decoration:none;cursor:pointer;}\n.inner_btn .link_cancel{border-color:#dbdbdb;color:#333;background-color:#e0e0e0}\n\n/* 레이어 공통 */\n.dimmed_layer{position:fixed;z-index:9998;top:0;left:0;width:100%;height:100%;background-color:#000;opacity:0.2;filter:alpha(opacity=20)}\n.pay_layer{position:absolute;left:16px;z-index:9999;border-bottom:2px solid #a9a9a9}\n.pay_layer .inner_pay_layer{padding:33px 31px 29px;border:1px solid #666;background-color:#fff}\n.pay_layer .inner_pay_layer1{width:424px}\n.pay_layer .layer_body{overflow:hidden;line-height:17px}\n.pay_layer .tit_pay{padding:0 0 16px;border-bottom:1px solid #e1e1e1}\n.pay_layer .desc_notice{padding:27px 11px;color:#666}\n.pay_layer .list_infomation{padding:8px 0 0 0}\n.layer_foot{overflow:hidden;width:100%;padding-top:30px;text-align:center}\n.layer_foot .btn_popup{width:206px;margin:0}\n.layer_foot .link_cancel{margin:0 0 0 8px}\n.layer_foot .link_close{position:absolute;right:31px;top:32px;width:22px;height:22px;font-size:0;line-height:0;background-position:-30px -30px;text-indent:-9999px}\n\n/* 이용약관동의 */\n.box_agree{overflow-y:scroll;height:574px;font-size:13px}\n.pay_policy{width:487px;padding:19px 0 0 32px}\n\n/* 맞춤충전 */\n.bundle_option{position:relative;padding-bottom:12px;border-bottom:2px solid #808080}\n.bundle_option .emph_info{color:#919191}\n.pay_setting{overflow:hidden;width:100%;padding-top:24px}\n.pay_setting .txt_setting{float:left;line-height:30px;white-space:nowrap}\n.pay_custom .fst{width:46px}\n.bundle_setting{float:left;width:100%;padding-top:14px}\n.pay_setting .select_pay{float:left;margin:0 9px 0 4px}\n.pay_custom .bundle_setting .select_pay{margin-left:50px}\n.pay_setting .tf_direct{float:left;margin-right:7px}\n.box_pay .pay_setnotice{overflow:hidden;width:100%;margin-top:38px;padding-top:12px;border-top:1px solid #e0e0e0;line-height:28px}\n.pay_setnotice .desc_notice{float:left;margin:1px 0 0 2px}\n.pay_setnotice .btn_pay{float:right;margin-right:8px}\n.pay_edit{padding-top:8px;text-align:right}\n.pay_edit .btn_pay{margin:0}\n\n/* 맞춤충전 레이어 */\n.pay_layer .desc_detail{display:block;height:17px;padding:20px 0px 15px 0px;margin-top:36px;font-weight:bold;line-height:17px;text-align:center;background-color:#f7f7f7}\n.pay_layer .pay_limit{margin:49px 0 14px}\n\n/* 수기충전 */\n.pay_write .bundle_check{padding:23px 0 4px}\n.pay_write .bundle_inp{padding-top:17px}\n.bundle_inp .inp_check{margin-top:8px}\n.pay_write .tf_direct{height:28px;margin-left:6px}\n\n/* 일반충전 레이어 */\n.pay_layer .notice_detail{overflow-y:scroll;height:288px;padding:27px 11px 0}\n\n/* 정기충전 */\n.pay_regular .fst{width:34px}\n.pay_regular .bundle_setting .select_pay{margin-left:38px}\n\n/* 고정가상계좌 */\n.choice_pay{margin-top:10px;border-top:2px solid #808080;border-bottom: 1px solid #e0e0e0}/* 2015-08-20 수정 */\n.choice_pay .pay_method{padding:17px 2px 13px;border-top:1px solid #e0e0e0}/* 2015-08-20 수정 */\n.choice_pay .pay_method:first-child{border-top:0 none}/* 2015-08-20 추가 */\n.pay_method .inp_pay{margin-top:4px}\n.pay_method .lab_method{padding-left:11px;font-weight:bold;line-height:24px;vertical-align:top}\n.box_account .tit_info{padding-bottom:7px}\n.box_account .desc_notice{line-height:18px}\n.box_account .btn_pay{margin-top:15px}\n.detail_infomation{margin-top:32px;padding:18px 20px 30px;background-color:#f7f7f7}\n.detail_infomation .select_pay{margin-top:11px;padding-right:9px;text-align:center}\n.detail_infomation .btn_select{margin:0}\n.detail_infomation .list_infomation{padding:5px 0 0 0}\n.detail_infomation .info_account{line-height:18px}\n.info_account dt{display:inline}\n.info_account dd{display:inline;font-weight:bold}\n.detail_infomation .fst{margin-top:15px}\n/* .choice_pay .list_infomation{margin-top:-1px;padding:7px 24px 18px;border-top:1px solid #f5f5f5;border-bottom:1px solid #e0e0e0} 2015-08-20 삭제 */\n\n/* 고정가상계좌 발급완료 레이어팝업 */\n.inner_pay_layer3{width:336px;padding:85px 31px 31px 31px}\n.pay_layer .desc_confirm{padding:53px 0 54px;font-weight:bold;text-align:center}\n.pay_layer .desc_guide{padding:5px 0 17px;font-weight:bold;text-align:center}\n.pay_layer .desc_caution{padding:19px 0 6px;font-size:13px;color:#919191;text-align:center}\n.num_input .lab_input{left:0;width:100%;text-align:center}\n.num_input .tf_pay{text-align:center}\n.inner_pay_layer3 .btn_popup{width:162px}\n.layer_foot .link_confirm{width:238px}\n\n/* 일회성 가상계좌 발급 : 2015-08-20 추가 시작 */\n.choice_pay .pay_detail{display:none;overflow:hidden;padding:21px 0 28px 24px;border-top:1px solid #f5f5f5;color:#666}\n.choice_pay .on{display:block}\n.pay_detail .define_pay{padding-bottom:8px;color:#333}\n.pay_detail .define_pay dd{line-height:20px}\n.pay_detail .tit_define{overflow:hidden;width:92px;height:17px;margin:2px 0 10px;font-size:0;line-height:0;background-position:-110px -30px;text-indent:-9999px}\n.pay_bank .select_pay{float:left;width:80px;text-align:left}\n.pay_bank .btn_sms{float:left;width:140px;margin-left:6px}\n.pay_bank .detail_infomation{float:left;width:344px;margin:10px 0 8px;padding:15px 17px 15px 17px;clear:both}\n.bundle_phone{overflow:hidden;float:left;width:100%;margin-bottom:20px}\n.pay_bank .pay_agree{float:left;width:100%}\n.pay_bank .pay_input{float:right;width:250px}\n.pay_bank .list_infomation{float:left}\n.pay_bank .inp_pay{margin-top:3px}\n.pay_bank .pay_agree .lab_pay{float:left;width:317px;line-height:20px}\n.pay_bank .bundle_cash{float:left;width:100%;padding:27px 0 14px}\n.bundle_cash .tit_detail{padding:0 12px 0 0}\n.bundle_cash .inp_pay{margin:0}\n.bundle_cash .lab_pay{float:left;width:64px;padding-left:11px}\n\n/* 현금영수증 발급 등록 정보 팝업 */\n.tab_pay{overflow:hidden;width:100%;height:58px;margin-top:30px}\n.tab_pay li{float:left;width:50%;margin-left:-1px;border-bottom:2px solid #666;text-align:center}\n.tab_pay .on{position:relative;border-bottom:0 none}\n.tab_pay li:first-child{margin-left:0}\n.tab_pay .link_tab{display:block;height:46px;padding-top:1px;border:1px solid #d9d9d9;border-bottom:0 none;line-height:50px;color:#666;background-color:#fafafa;text-decoration:none}\n.tab_pay .on .link_tab{height:48px;padding:0;border:2px solid #666;border-bottom:0 none;font-weight:bold;color:#333;background-color:#fff}\n.info_business{overflow:hidden;width:100%;padding-top:22px}\n.info_business .tit_detail{padding-right:0}\n.info_tab .bundle_phone{margin:22px 0 19px}\n.info_tab .select_pay{float:left;width:118px;margin-right:5px;text-align:left}\n.info_tab .pay_input{float:left;width:248px;height:26px}\n.info_business .pay_input{float:right;width:305px}\n.info_tab .pay_input .tf_pay{height:24px}\n.info_tab .pay_input .lab_input{line-height:28px}\n.info_tab .emph_pay{display:block;padding-top:30px;font-weight:normal;color:#ee252c;text-align:center}\n.info_business .emph_pay{float:left;width:100%;padding-top:178px}\n/* 2015-08-20 추가 끝 */\n\n/* 자동결제 결제 세부내역 */\n.pay_details{overflow:hidden;width:100%;margin-top:32px}\n.pay_details .select_pay{float:left;width:310px;text-align:center}\n.pay_details .btn_pay{float:right;margin-right:0}\n.pay_details .btn_select{float:none}\n\n/* 자동결제 */\n.tbl_card .inner_cell{padding:17px 15px 15px;font-size:16px;line-height:32px}\n.tbl_card{margin-bottom:31px}\n.tbl_card th{width:114px;text-align:center}\n.tbl_card td{text-align:center}\n.tbl_card td .inner_cell{overflow:hidden;position:relative;padding:10px 90px 10px 15px;word-break:break-all}\n.tbl_card .btn_pay{position:absolute;right:50px;top:50%;margin-top:-14px}\n.tbl_card .btn_pay2{position:absolute;right:5px;top:50%;margin-top:-14px}\n.tbl_card .btn_card{width:100%;padding:19px 0 18px;font-size:18px;background-color:#fff;text-align:center}\n.tbl_card .btn_card .img_pay{display:inline-block;width:20px;height:20px;margin:3px 10px 0 0;background-position:0 -30px;vertical-align:top}\n.box_pay .detail_auto{padding:16px 24px 15px}\n.detail_auto .tit_guide{display:block;margin-bottom:10px;font-weight:normal;color:#666}\n.detail_auto .desc_guide{margin-bottom:5px;font-size:13px;line-height:16px}\n.detail_auto .info_guide{font-size:13px;line-height:16px}\n.detail_auto .info_guide dt{display:inline}\n.detail_auto .info_guide dd{display:inline}\n.detail_auto .guide_notice{margin-top:10px;font-size:13px;color:#919191}\n\n/* 결제진행중 */\n.pay_roading{text-align:center}\n.pay_roading .img_pay{width:46px;height:11px;margin:298px auto 35px;background-position:-60px -30px}\n.pay_roading .tit_info{font-size:20px;margin-bottom:3px}\n.pay_roading .desc_info{font-size:13px;line-height:15px;color:#666}\n\n/* 세금계산서 조회 */\n.desc_corporate{margin:7px 0 26px 0;line-height:18px}\n.detail_corporate{overflow:hidden;padding:16px 20px;background:#f7f7f7}\n.detail_corporate .tit_corporate{float:left;width:105px;height:28px;line-height:29px}\n.detail_corporate .pay_input{float:right;width:270px}\n\n/* 전자세금계산서인쇄 */\n.tbl .view_hide{overflow:hidden;width:1px;height:0.1px;font-size:0;line-height:0;text-indent:-9999px}\n.popup_pay_tax th, \n.popup_pay_tax td{font-size:12px}\n.popup_pay_tax .td_left{text-align:left}\n.popup_pay_tax .td_right{text-align:right}\n.popup_pay_tax .td_center{text-align:center}\n.popup_pay_tax .head_invoice{overflow:hidden;margin:15px 18px 0;border:2px solid #40454f;border-bottom:0;background-color:#f7faf9}\n.popup_pay_tax .head_invoice .tit_invoice{float:left;width:327px;height:48px;font-size:18px;line-height:48px;text-align:center}\n.popup_pay_tax .head_invoice .txt_assi{font-size:12px;letter-spacing:-1px;vertical-align:middle}\n.popup_pay_tax .head_invoice .info_serial{text-align:center}\n.popup_pay_tax .head_invoice .tit_serial{float:left;width:84px;border-top:1px solid #e4e8ec;line-height:23px;color:#6e7478;border-left:1px solid #e4e8ec;border-right:1px solid #e4e8ec}\n.popup_pay_tax .head_invoice .desc_serial{overflow:hidden;line-height:23px;border-top:1px solid #e4e8ec}\n\n.info_invoice{overflow:hidden;margin:0 18px;background-color:#f7faf9}\n.info_invoice .invoice_name{float:left}\n.info_invoice .txt_assi{float:right;margin-right:3px;font-size:11px;line-height:22px;color:#6e7478}\n.area_supply{overflow:hidden}\n.area_supply th{font-weight:bold;border-bottom:1px solid #e4e8ec;text-align:center}\n.area_supply td{overflow:hidden;height:34px;padding:0 5px;border-left:1px solid #ea5555;border-bottom:1px solid #e4e8ec}\n.invoice_supplier{float:left;width:327px;border:2px solid #ea5555;border-right:0}\n.invoice_supplier .tit_object{border-left:0}\n.invoice_supplier th{border-left:1px solid #ea5555;color:#ea5555;background-color:#fff3f3}\n.invoice_supplier tr:last-child td,\n.invoice_demander tr:last-child td{border-bottom:0}\n.invoice_demander{float:left;width:328px;border:2px solid #5396da;border-left:0}\n.invoice_demander th{border-left:1px solid #5396da;color:#3c88d5;background-color:#eff9fd}\n.invoice_demander td{border-left:1px solid #5396da}\n\n.info_sheet{margin:0 18px 15px;border:2px solid #40454f;border-top:0}\n.info_sheet .cover_sheet{border-top:2px solid #40454f}\n.tbl_sheet{width:100%;background-color:#fff;table-layout:fixed}\n.tbl_sheet thead th{font-weight:bold;border-bottom:1px solid #8e9296;color:#6e7478;background-color:#fbfbfb}\n.tbl_sheet tbody th{color:#6e7478;background-color:#fbfbfb}\n.tbl_sheet tbody tr:last-child th,\n.tbl_sheet tr:last-child td{border-bottom:0}\n.tbl_sheet th{line-height:23px;word-break:break-all}\n.tbl_sheet td{padding:2px 3px 1px;word-break:break-all}\n.tbl_sheet th,\n.tbl_sheet td{border-right:1px solid #e4e8ec;border-bottom:1px solid #e4e8ec;text-align:center}\n.info_sheet thead th:last-child,\n.info_sheet tbody th:last-child,\n.info_sheet tbody td:last-child{border-right:0}\n.person_sheet{margin:0 18px;border:2px solid #40454f}\n.person_sheet tbody th{font-weight:normal;color:#333}\n.person_sheet th:last-child,\n.person_sheet td:last-child{border-right:0}\n.tbl_money tbody th{border-left:1px solid #e4e8ec;border-right:0}\n.tbl_money tbody th:last-child{border-right:0}\n.tbl_money tbody td{border-left:1px solid #e4e8ec;border-right:0;text-align:right}\n.tbl_money tbody th:first-child,\n.tbl_money tbody td:first-child{border-left:0}\n\n\n/* 2017-03-27 추가 시작 */\n/* 환불신청 */\n.popup_pay_refund .tit_daumkakaopay .img_pay{background-position:0 -68px}\n.refund_pay{padding-top:22px;border-bottom:0 none}\n.info_inp{width:100%;margin-bottom:12px}\n.info_inp:after{display:block;clear:both;content:''}\n.info_inp dt{float:left;width:75px;height:28px;padding-left:6px;font-weight:bold;line-height:28px;color:#333}\n.info_inp dd{overflow:hidden}\n.info_inp .tf_pay{padding-top:0}\n.bank_inp .select_pay{float:left;width:96px;margin-right:6px;text-align:left}\n.bank_inp .pay_input{float:left;width:193px}\n.refund_pay .list_infomation{padding:0 0 0 7px}\n.refund_pay .detail_infomation{margin-top:46px}\n.detail_infomation .txt_agree{color:#666}\n.detail_infomation .list_agree{padding:6px 0 0 4px}\n.detail_infomation .list_agree li{font-size:13px;line-height:18px}\n.refund_agree{padding-top:30px;text-align:center}\n.refund_agree .inner_agree{display:inline-block;vertical-align:top}\n.refund_agree .lab_pay{font-weight:bold;vertical-align:top}\n.list_noti{padding-top:7px}\n/* 2017-03-27 추가 끝 */\n\n/* 2018-11-09 추가 */\n/* 결제 필수 동의 */\n.box_payagree{overflow:hidden;position:relative;padding:21px 30px 17px}\n.box_payagree .inp_payagree{position:absolute;top:50%;left:30px;width:24px;height:24px;margin-top:-12px;-webkit-appearance:none;opacity:0}\n.box_payagree .lab_payagree{float:left;padding-left:32px;font-size:14px;line-height:24px;color:#808080}\n.box_payagree .lab_payagree .ico_form{position:absolute;top:50%;left:30px;width:24px;height:24px;margin-top:-12px;background-position:0 0}\n.box_payagree .lab_payagree.on .ico_form{background-position:0 -40px}\n.box_payagree .link_payagree{position:absolute;top:0;right:0;padding:0 31px}\n.box_payagree .link_payagree .txt_payagree{font-size:14px;line-height:62px;color:#808080;text-decoration:underline}\n/* //2018-11-09 추가 */\n"
