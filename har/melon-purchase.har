          "content": {
            "size": 135413,
            "mimeType": "text/javascript",
            "text": "var cdnDomain = \"https://stdux.inicis.com/stdpay\";\r\n//document.write(\"\");\r\n/////////////////////////////////////\r\n// 변수 선언\r\n/////////////////////////////////////\r\nvar $payForm = null;\r\nvar visa3dWin = null;\r\nvar loadScript = {\r\n\t\t\"Card\":false\r\n\t\t,\"EasyPay\":false\r\n\t\t,\"HPP\":false\r\n\t\t,\"Swallet\":false\r\n\t\t,\"Paypin\":false\r\n\t\t,\"Kpay\":false\r\n\t\t,\"IniPoint\":false\r\n\t\t,\"PhoneBill\":false \r\n\t\t,\"Bill\":false\r\n\t};\r\n\r\n//WCCHOI\r\nvar isLogoFocus \t= false;\r\nvar isCuponFocus \t= false;\r\nvar isDirectCall \t= false;\r\n//UI없이처리 일경우\r\nvar isNonUI\t\t\t= false;\r\n// 메뉴 이동에 따른 기준정보에서 보내준 결제서비스 약관동의의 유지 여부\r\nvar isFlgUseProvision = false; \r\n// 결제서비스 약관동의 여부\r\nvar isAssentChk = false;\r\n// 에스크로 약관동의 여부\r\nvar isEscrowChk = false;\r\n// 손실 보상동의 여부\r\nvar isCompensateChk = false;\r\n// 선택메뉴\r\nvar selectMenuId = \"\";\r\n\r\n/////////////////////////////////////\r\n//메세지 처리\r\n/////////////////////////////////////\r\nvar INImsg = null;\r\nvar INImsg_ko = {\r\n\t\ttitle \t\t  \t: \"KG 이니시스\"\r\n\t\t,title_mobil \t: \"KG 모빌리언스\"\r\n\t\t,title2 \t\t \t: \"법인카드 결제확인\"\r\n\t\t,title3 \t\t \t: \"할인카드 조회오류\"\r\n\r\n\t\t,alert_confirm1 : \"결제를 취소하시겠습니까?\"\r\n\t\t,alert_msg3 : '<b>결제 가능시간(#1분)이 초과 되었습니다.<br/><br/>결제가 자동 종료됩니다.</b>'\r\n\t\t,alert_msg4 : '<b>결제 가능시간이 <span style=\"color:red;font-weight:bold;\">#1분</span> 남았습니다.</b><br/><br/>※ #1분내 결제를 완료하지 않는 경우 결제가 종료됩니다.(최대결제가능시간:#2분)'\r\n\t\t,alert_msg5 : '해당 카드는 현재 브라우져에서 결제가 불가능합니다.<br/>(해당브라우져 카드사에서 미지원, \\'Internet Explorer\\' 브라우져에서만 가능)'\r\n\t\t,alert_msg9 : '이메일을 정확히 입력해주세요'\r\n\t\t,alert_msg10 : 'iframe을 통한 처리시 화면 권장 사이즈가 아닙니다.[320x520 이상]'\r\n\t\t,alert_msg11 : '모바일은 지원하지 않습니다.'\r\n\t\t,alert_msg12 : '언어 변환에 실패였습니다.'\r\n\t\t,alert_msg13 : '쿠폰을 선택해주세요.'\r\n\t\t,alert_msg14 : '인증번호가 입력 되지 않았습니다.'\r\n\t\t,alert_msg15 : '인증번호가 일치 하지 않습니다.'\r\n\t\t,alert_card_msg1 : '카드유형을 선택해주세요.'\r\n\t\t,alert_card_msg2 : '할부유형을 선택해주세요.'\r\n\t\t,alert_card_msg3 : '카드번호를 입력하세요'\r\n\t\t,alert_card_msg4 : '카드 유효기간을 선택해주세요'\r\n\t\t,alert_card_msg5 : '비인증 결제를 진행합니다.'\r\n\t\t,alert_card_msg6 : 'ISP 호출에 오류가 발생하였습니다.'\r\n\t\t,alert_card_msg7 : 'ISP 모바일 앱 인증이 이루어지 않았습니다.<br/>(다시 시도해주시기 바랍니다.)'\r\n\t\t\t\r\n\t\t,alert_card_msg8 : '잠시후 ISP 모바일 앱이 실행됩니다.'\r\n\r\n\t\t,alert_card_msg9 : '기타 정보를 입력하세요'\r\n\t\t,alert_card_msg10: '삼성월렛은 30만원 이상 결제가 불가능합니다.'\r\n\t\t,alert_card_msg11: 'KPAY는 30만원 이상 결제가 불가능합니다.'\r\n\t\t// 네이버 체크아웃 1000원 미만 옵션 없이 사용 시 문구 출력 BY KSM 2016.03.18 6699ff\r\n\t\t,alert_card_msg12: '<b> <span style=\"color:#6699ff;font-weight:bold;\"> 1,000원 미만의 금액은 신용카드로 결제하실 수 없습니다. </span></b><br/><br/>신용카드를 제외한 다른 방법으로 결제하시기 바랍니다.'\r\n\t\t,alert_card_msg13: '선택하신 카드는 해당 개월로 할부 결제가 불가합니다.'\r\n     \t\r\n\t\t//평창 Fail 메시지\r\n\t\t,alert_card_msg14 : '결제요청하신 카드는 평창동계올림픽에서 결제할 수 없는 카드입니다.'\r\n\t\t,alert_card_msg15 : '생년월일을 정확하게 입력해주세요.'\r\n\t\t,alert_card_msg16 : '결제를 위한 통화코드가 원화가 아닙니다. 상점에 문의해주시기 바랍니다.'\r\n\t\t\t\r\n\t\t,alert_card_msg17 : function(str) {\r\n\t\t\treturn '카드포인트 사용이 불가능합니다. 카드포인트는 결제금액이  <b> '+ str +'</b> 원 이상인 경우에 사용 가능합니다.'\r\n     \t}\r\n\r\n\t\t//애플페이 다이렉트 옵션 호출 시 미지원 브라우저 문구 출력\r\n\t\t,alert_card_msg18 : '입력한 지불수단은 해당 브라우저에서 이용하실 수 없습니다.<br/> 다른 지불수단 입력해주세요.'\t\r\n\r\n\t\t//해외카드 메시지\r\n\t\t,alert_card_msg19 : '카드 소유주 이름을 입력하세요.'\r\n\t\t,alert_card_msg20 : '카드 소유주 E-MAIL을 입력하세요.'\r\n\t\t//해외카드 화면 빈체크 메시지 추가 250709\r\n\t\t,alert_card_msg21 : '선택한 카드사와 입력된 카드번호가 일치하지 않습니다.'\r\n\t\t//해외카드 가상키패드 메시지 추가 250715\r\n\t\t,alert_card_msg22 : '입력한 카드번호 다시 확인해주세요.'\r\n\t\t\t\r\n\t\t//이니안심 메시지\r\n\t\t,alert_kcare_msg1 : '선택 되어진 지불수단으로 이니안심서비스를 이용하실 수 없습니다.<br/>이니안심서비스 사용을 원하시면 다른 카드를 선택해주세요.'\r\n\t\t,alert_kcare_msg2 : '이니안심서비스 이용 시 할부결제를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg3 : 'Lpoint 사용 시 이니안심서비스를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg4 : '카드 포인트 사용 시 이니안심서비스를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg5 : '이니안심서비스 이용 시 할부결제를 이용할 수 없습니다.<br/>이니안심서비스를 사용하시겠습니까?'\r\n\t\t,alert_kcare_msg6 : '이니안심서비스 사용 안내'\r\n\t\t,alert_kcare_msg7 : '이니포인트 이용 시 이니안심서비스를 사용하실 수 없습니다.'\r\n\t\t,alert_kcare_msg8 : '이니안심서비스 사용 시 Lpoint를 이용할 수 없습니다.'\r\n\t\t//이니안심 할부개월 추가로 인한 메시지 추가 250506\r\n\t\t,alert_kcare_msg9 : '선택하신 할부개월은 이니안심 서비스 이용이 불가합니다.'\r\n\t\t\t\r\n\t\t,alert_easyPay_msg1 : '간편결제 아이디가 정확하지 않습니다.'\r\n\t\t,alert_easyPay_msg2 : '간편결제 패스워드를 입력해주세요.'\r\n\r\n\t\t,alert_easyPay_msg3 : '할부유형을 선택해주세요.'\r\n\t\t,alert_easyPay_msg4 : '문자 메세지로 전송된 인증번호를 입력해주세요'\r\n\r\n\t\t,alert_easyPay_msg5 : '간편결제 처리중 통신 오류가 발생하였습니다.<br/>뒤로 돌아가 로그인부터 시도해주세요'\r\n\r\n\t\t,alert_easyPay_msg6 : '\\'인증번호 발송\\' 버튼을 클릭후, <br/>문자 메세지로 전송된 인증번호를 입력해주세요'\r\n\r\n\t\t,alert_easyPay_msg7 : '인증번호가 등록된 휴대폰으로 발송되었습니다. <br/>휴대폰에 수신된 인증번호를 입력해주세요'\r\n\t\t,alert_easyPay_msg8 : '고객님이 선택하신 할인쿠폰을 사용할 수 없습니다. <br/>고객님이 선택하신 하나카드로 결제를 하실 경우에만 사용이 가능합니다. <br/>고객님의 간편결제용 카드 정보에는 하나카드가 없으므로 <br/>선택하신 카드 쿠폰할인이 불가능 합니다.'\r\n\t\t,alert_easyPay_msg9 : '고객님이 선택하신 할인쿠폰을 사용할 수 없습니다. <br/>고객님이 선택하신 신한카드로 결제를 하실 경우에만 사용이 가능합니다. <br/>고객님의 간편결제용 카드 정보에는 신한카드가 없으므로 <br/>선택하신 카드 쿠폰할인이 불가능 합니다.'\r\n\t\t,alert_easyPay_msg10 : '<font color=\"#6799FF\" style=\"\"><b>간편결제 인증 요청 오류</b></font> <br/><br/> 다음 이유로 인해 간편결제 인증 요청이 실패하였습니다. <br/><br/>'\r\n\r\n\t\t,alert_point_msg1 : '아이디를 입력하세요.'\r\n\t\t,alert_point_msg2 : '비밀번호를 입력하세요.'\r\n\t\t,alert_point_msg3 : '이니포인트는 결제 금액의 최대 50%까지 사용 가능합니다.'\r\n\t\t,alert_point_msg4 : '결제하시고자 하는 포인트를 선택해여 주십시오.'\r\n\t\t,alert_point_msg5 : '포인트는 1포인트 이상 사용 가능합니다.'\t\r\n\t\t,alert_point_msg6 : '사용할 포인트를 확인 하십시오.'\r\n\t\t,alert_point_msg7 : '포인트를 조회하십시오.'\r\n\t\t,alert_point_msg8 : 'LPOINT와 쿠폰은 함께 사용할 수 없습니다.'\t\r\n\t\t\t\r\n\t\t,alert_hpp_msg1 : '결제 휴대폰 통신사를 선택해주세요'\r\n\t\t,alert_hpp_msg2 : '휴대폰번호를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_hpp_msg3 : '주민등록번호를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_hpp_msg4 : '이용약관에 동의하여 주시기 바랍니다. <br/>동의를 해야만 결제 진행이 가능합니다.'\r\n\r\n\t\t,alert_hpp_msg5 : '문자 메세지로 전송된 인증번호를 입력해주세요'\r\n\t\t,alert_hpp_msg6 : '주민등록번호를 확인 후 다시한번 입력하여 주시기 바랍니다.'\r\n\r\n\t\t,alert_bank_msg1 : '계좌이체할 은행을 선택해주세요'\r\n\t\t,alert_bank_msg2 : '계좌이체할 증권사를 선택해주세요'\r\n\t\t,alert_bank_msg3 : '현금영수증 발행용도를 선택하세요'\r\n\t\t,alert_bank_msg4 : '현금영수증 확인수단을 선택하세요'\r\n\t\t,alert_bank_msg5 : '현금영수증 발행번호를 입력하세요'\r\n\t\t,alert_bank_msg6 : '현금영수증 발행번호의 길이가 맞지 않습니다.'\r\n\t\t,alert_bank_msg7 : '계좌이체 호출에 오류가 발생하였습니다.'\r\n\t\t,alert_bank_msg8 : '계좌이체 모바일 앱 인증이 이루어지 않았습니다.'\r\n\t\t,alert_bank_msg9 : '잠시후 계좌이체 모바일 앱이 실행됩니다.'\r\n\t\t,alert_bank_msg10 : '예금주명을 입력해 주세요'\r\n\t\t,alert_bank_msg11 : '문자(한글 및 영문)만 입력해 주세요.'\r\n\t\t,alert_bank_msg12 : '주민(외국인)번호 앞자리를 입력해 주세요.'\r\n\t\t,alert_bank_msg13 : '주민(외국인)번호 뒷자리를 입력해 주세요.'\r\n\t\t,alert_bank_msg14 : '숫자만 입력해 주세요.'\r\n\t\t,alert_bank_msg15 : '주민등록번호를 확인 후 다시한번 입력하여 주시기 바랍니다.'\r\n\t\t,alert_bank_msg16 : '사업자등록번호 첫번째 자리를 입력해 주세요.'\r\n\t\t,alert_bank_msg17 : '사업자등록번호 두번째 자리를 입력해 주세요.'\r\n\t\t,alert_bank_msg18 : '사업자등록번호 세번째 자리를 입력해 주세요.'\r\n\t\t,alert_bank_msg19 : '사업자등록번호를 확인 후 다시한번 입력하여 주시기 바랍니다.'\r\n\t\t,alert_bank_msg20 : '숫자를 입력 하세요.'\r\n\t\t,alert_bank_msg21 : '입금계좌번호를 입력해 주세요.'\r\n\t\t,alert_bank_msg22 : '계좌 비밀번호를 입력해 주세요.'\r\n\t\t,alert_bank_msg23 : '현금 영수증 발행을 위한 주민(외국인)번호 앞자리를 입력해 주세요.'\r\n\t\t,alert_bank_msg24 : '현금 영수증 발행을 위한 주민(외국인)번호 뒷자리를 입력해 주세요.'\r\n\t\t,alert_bank_msg25 : '현금 영수증 발행을 위한 휴대폰번호를 입력해 주세요.'\r\n\t\t,alert_bank_msg26 : '현금 영수증 발행을 위한 사업자등록번호를 입력해 주세요.'\r\n\t\t,alert_bank_msg27 : '현금 영수증 발행을 위한 주민등록번호를 확인 후 다시한번 입력하여 주시기 바랍니다.'\r\n\t\t,alert_bank_msg28 : '현금 영수증 발행을 위한 사업자등록번호를 확인 후 다시한번 입력하여 주시기 바랍니다.'\r\n\t\t,alert_bank_msg29 : '송금자명은 한글 및 영문만 입력해 주시기 바랍니다.<br>(특수문자는 &을 제외하고 입력 가능합니다.)'\r\n\t\t,alert_bank_msg30 : '한글10자(영문20자)까지 가능합니다.'\r\n\t\t,alert_bank_msg31 : '현금 영수증 발행을 위한 카드번호를 입력해 주세요.'\r\n\t\t\t\r\n\t\t,alert_easybank_KBANK : '케이뱅크 페이란, 고객님의 케이뱅크 계좌에서 간편한 인증으로 결제되는 서비스입니다.'\r\n\t\t\t\r\n\t\t,alert_vbank_msg1 : '입금은행을 선택해주세요'\r\n\t\t,alert_vbank_msg2 : '송금자 명을 입력하세요'\r\n\r\n\t\t,alert_vbank_msg3 : '현금영수증 발행용도를 선택하세요'\r\n\t\t,alert_vbank_msg4 : '현금영수증 발행을 위한 정보를 정확히 입력하세요'\r\n\t\t,alert_vbank_msg5 : '현금영수증 발행번호를 입력하세요'\r\n\t\t,alert_vbank_msg6 : '현금영수증 발급을 위해 주민등록번호를 입력해주세요.'\r\n\r\n\t\t,alert_vbank_msg7 : '주민등록번호를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_vbank_msg8 : '28일까지만 선택 가능합니다.'\r\n\t\t,alert_vbank_msg9 : '30일까지만 선택 가능합니다.'\r\n\t\t,alert_vbank_msg10: '입금기한이 오늘보다 전날 일 수 없습니다.'\r\n\t\t,alert_vbank_msg11: '입금기한이 오늘부터 최대 30일을 넘을수 없습니다.'\r\n\t\t,alert_vbank_msg12: '법인계좌에 대한 출금의 경우는 사업자 지출증빙용 현금영수증만 발행할 수 있습니다.'\r\n\t\t,alert_vbank_msg13: '현금영수증 발급을 위해 현금영수증 카드번호를 입력해주세요.'\r\n\t\t,alert_vbank_msg14: '현금영수증 발급을 위해 휴대폰번호를 입력해주세요.'\r\n\t\t,alert_vbank_msg15: '결제정보 토스 안내를 위해 휴대폰번호를 입력해주세요.'\r\n\t\t,alert_vbank_msg16: '결제정보 토스 안내를 위해 내용에 동의해주세요.'\r\n\t\t,alert_vbank_msg17 : '현금영수증 카드번호를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_vbank_msg18 : '현금영수증 휴대폰번호를 정확히 입력하시기 바랍니다.'\r\n\r\n\t\t,alert_okCash_msg1 : 'Ok Cashbag 카드번호를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_okCash_msg2 : '<font color=\"#6799FF\" ><b>회원인증오류</b></font></br>※ 다음 에러로 포인트 조회를 실패 하였습니다.</br>'\r\n\t\t,alert_okCash_msg4 : '신용카드 복합결제를 위한 결제 금액이 없습니다.'\r\n\t\t,alert_okCash_msg5 : '신용카드 복합결제를 하실 경우 신용카드 결제 금액은 1000원 이상이어야 합니다.'\r\n\t\t,alert_okCash_msg6 : 'OK캐쉬백 포인트를 0원으로 결제할 수 없습니다. 다시 입력하여 주십시오'\r\n\t\t,alert_okCash_msg7 : '입력하신 [사용하실 액수]가 전체 결제금액보다 모자랍니다.'\r\n\t\t,alert_okCash_msg8 : 'OK캐쉬백 포인트를 1000원 단위로 입력해 주십시오'\r\n\r\n\t\t,alert_upt_msg1 : 'U-point 최소 사용 금액은 1000원 이상이어야 합니다.'\r\n\r\n\t\t,alert_gspt_msg1\t  : '입력하신 [사용하실 액수]가 전체 결제금액보다 모자랍니다.'\r\n\t\t,alert_gspt_msg2\t  : 'GS&POINT를 0원으로 결제할 수 없습니다. 다시 입력하여 주십시오'\r\n\t\t,alert_gspt_msg3\t  : '신용카드 복합결제를 하실 경우 신용카드 결제 금액은 1000원 이상이어야 합니다.'\r\n\t\t,alert_gspt_msg4\t  : 'GS&POINT를 1000원 단위로 입력해 주십시오'\r\n\t\t,alert_gspt_msg5\t  : '반드시 GS포인트 + 신용카드 복합결제로 결제가 되어야 합니다.<br/>신용카드 복합결제 체크박스를 클릭해 주십시오.'\r\n\t\t,alert_gspt_msg6\t  : 'GS&POINT 아이디를 입력해주세요.'\r\n\t\t,alert_gspt_msg7\t  : 'GS&POINT 패스워드를 입력해주세요.'\r\n\t\t,alert_gspt_msg8\t  : '제휴가맹점 코드 값이 설정되지 않았습니다.<br/>쇼핑몰 관리자에게 문의 바랍니다.'\r\n\r\n\t\t,alert_upnt_msg1 \t  : 'U-point 카드번호를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_upnt_msg2\t  : 'U-point 를 0원으로 결제할 수 없습니다. 다시 입력하여 주십시오'\r\n\r\n\t\t,alert_mypt_msg1\t\t:\"적립된 포인트가 5000포인트 이하이면 결제를 진행 할 수 없습니다.\"\r\n\t\t,alert_mypt_msg2\t\t:\"결제 금액보다 적립된 포인트가 부족합니다.\"\r\n\r\n\t\t,alert_gift_msg1 : '결제하실 상품권을 선택해주세요'\r\n\r\n\t\t,alert_culture_msg1 : '컬쳐랜드 아이디를 입력해주세요.'\r\n\t\t,alert_culture_msg2 : '컬쳐랜드 패스워드를 입력해주세요.'\r\n\t\t,alert_culture_msg3 : '문화상품권 PIN번호를 입력하세요'\r\n\t\t,alert_culture_msg4 : '#1원 상품권 PIN번호가 확인되었습니다.<br/>최종 결제시에 충전과 동시에 사용됩니다.'\r\n\t\t,alert_culture_msg5 : '충전금액이 부족합니다.<br/>컬쳐캐쉬 잔액과 충전 상품권금액의 합이 결제금액보다 커야만 합니다.'\r\n\t\t,alert_culture_msg6 : '컬쳐랜드 로그인이 필요합니다.'\r\n\r\n\t\t,alert_hpmn_msg1 : '해피머니 아이디를 입력해주세요'\r\n\t\t,alert_hpmn_msg2 : '해피머니 패스워드를 입력해주세요.'\r\n\t\t,alert_hpmn_msg3 : '해피머니 상품권번호 입력하세요'\r\n\t\t,alert_hpmn_msg4 : '해피머니 상품권 발행일을 입력하세요'\r\n\t\t,alert_hpmn_msg5 : '해피머니가 충전되었습니다.'\r\n\r\n\t    ,alert_sculture_msg1:'상품권번호를 정확히 입력해주세요.'\r\n\t    ,alert_sculture_msg2:'잔액보다 큰 금액을 입력하셨습니다.'\r\n\t    ,alert_sculture_msg3:'잔액이 부족합니다.'\r\n\t    ,alert_sculture_msg4:'잔액이 상품금액을 초과하여 자동조정되었습니다.<br/>잔액은 뒤에서 확인 가능합니다.'\r\n\r\n\t\t,alert_cancel1 : '인증을 취소하셨습니다.'\r\n\r\n\t\t,alert_isp_fail1 : 'ISP 인증에 실패하였습니다.'\r\n\t\t,alert_isp_fail2 : 'ISP 모듈처리에 실패하였습니다.'\r\n\r\n\t    ,alert_ini_test1  : '이니포인트 로그인 화면으로 넘어 가유!'\r\n\r\n\r\n\t    ,alert_swallet_msg1 : \"결제요청 알림 재발송 전, 고객님의 스마트기기의 인터넷 연결 상태를 다시 확인해주세요. '확인'버튼을 누르시면 결제 요청을 다시 진행합니다.\"\r\n\t    ,alert_swallet_msg2 : \"휴대폰번호를 정확히 입력하시기 바랍니다.\"\r\n    \t,alert_swallet_msg3 : '결제 단말기를 선택해주세요.'\r\n    \t,alert_swallet_msg4 : '뱅크월렛 가입여부를 확인하여 주시기 바랍니다.'\r\n\r\n\t    ,alert_paypin_msg1 : \"결제요청 알림 재발송 전, 고객님의 스마트기기의 인터넷 연결 상태를 다시 확인해주세요. '확인'버튼을 누르시면 결제 요청을 다시 진행합니다.\"\r\n\t    ,alert_paypin_msg2 : \"휴대폰번호를 정확히 입력하시기 바랍니다.\"\r\n    \t,alert_paypin_msg3 : \"PayPin 결제에 사용가능한 결제수단이 없습니다.<br/>상점에 문의하여 주시기바랍니다.\"\r\n\t    ,alert_kpay_msg1 : \"결제요청 알림 재발송 전, 고객님의 스마트기기의 인터넷 연결 상태를 다시 확인해주세요. '확인'버튼을 누르시면 결제 요청을 다시 진행합니다.\"\r\n\t    ,alert_kpay_msg2 : \"휴대폰번호를 정확히 입력하시기 바랍니다.\"\r\n        ,alert_swallet_msg : \"휴대폰 번호를 정확히 입력하시기 바랍니다.\"\r\n\r\n        ,alert_bankWallet_msg1 : '인증번호발급완료 <br/><br/> 인증번호가 발급되었습니다.<br/>뱅크월렛 앱을 실행하여 인증번호 입력 후 결제를 진행하여 주십시오.'\r\n        ,alert_bankWallet_msg2 : '재한 시간 초과 <br/> 재전송 버튼을 누르신 후 새로 받은 인증번호로 뱅크월렛 앱에서 인증을 받으시기 바랍니다.'\r\n        ,alert_bankWallet_msg3 : '뱅크월렛 인증이 완료되지 않았습니다. <br/> 뱅크웰렛 앱에서 결제 인증을 받으신 후 다음 버튼을 클릭하시기 바랍니다.'\r\n        ,alert_bankWallet_msg4 : '인증번호요청 후 다음을 눌러주세요.'\r\n        ,alert_bankWallet_msg5 : '인증번호요청을 다시 하십시오.'\r\n\t\t,alert_bankWallet_msg6 : '전자지갑을 선택해주세요'\r\n\r\n        ,alert_phoneBill_msg1 : '통신과금 이용약관 동의 <br/><br/>통신과금 이용약관에 동의하여 주십시오. 동의 후 결제가 진행됩니다.'\r\n        //,alert_phoneBill_msg2 : '입력 에러 <br/><br/>전화번호를 정확히 입력하시기 바랍니다.'\r\n        //,alert_phoneBill_msg3 : '입력 에러 <br/><br/>주민등록번호를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_phoneBill_msg2 : '<b><span style=\"color:#5592C1\">입력 오류</span></b> <br/><br/>전화번호를 정확히 입력하시기 바랍니다.'\r\n\t    ,alert_phoneBill_msg3 : '<b><span style=\"color:#5592C1\">입력 오류</span></b> <br/><br/>주민등록번호를 정확히 입력하시기 바랍니다.'\r\n        ,alert_bcsh_msg1 : '충전요청한 도서상품권을 충전하셔도 잔액이 부족합니다.'\r\n        ,alert_bcsh_msg2 : '도서문화상품권 잔액이 부족합니다.</br>충전 후 다시 시도하여 주시기 바랍니다.'\r\n\r\n        ,alert_teen_msg1 : '잔액이 부족합니다. 틴캐시를 별도 구매하여 이용하시기 바랍니다.'\r\n        ,alert_teen_msg2 : '가지고 계신 틴캐시 카드번호를 정확히 입력하시오.'\r\n        ,alert_teen_msg3 : '아이디를 입력하십시오.'\r\n        ,alert_teen_msg4 : '비밀번호를 입력하십시오.'\r\n\r\n        ,alert_bill_msg1 : '비밀번호를 입력하시기 바랍니다.'\r\n        ,alert_bill_msg2 : '성명을 입력하시기 바랍니다.'\r\n        ,alert_bill_msg3 : '취소하셨습니다.'\r\n        ,alert_bill_agree_msg0 : '정기과금 이용약관에 동의하여 주십시오.'\r\n    \t,alert_bill_agree_msg1 : '전자금융 이용약관에 동의하여 주십시오.'\r\n\t\t,alert_bill_agree_msg2 : '고유식별정보수집 및 이용약관에 동의하여 주십시오.'\r\n\t\t,alert_bill_agree_msg3 : '개인정보수집 및 이용안내에 동의하여 주십시오.'\r\n\t\t,alert_bill_agree_msg4 : '개인정보이용 및 위탁안내에 동의하여 주십시오.'\r\n\t\t,alert_bill_fullRegNum_msg \t: '주민등록번호 13자리를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_bill_frontRegNum_msg : '주민등록번호 앞 6자리를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_bill_backRegNum_msg \t: '주민등록번호 뒤 7자리를 정확히 입력하시기 바랍니다.'\r\n\t\t,alert_done_msg1 : '결제내용에 동의하여 주십시오.<br/> 동의 후 결제가 진행됩니다.'\r\n    \t,alert_directbank_msg1 : '계좌번호를 입력하십시오.'\r\n        ,alert_directbank_msg2 : '계좌 비밀번호를 입력하십시오.'\r\n    \t,alert_directbank_msg3 : '보안수단 일련번호를 입력하십시오.'\r\n    \t,alert_directbank_msg4 : '보안카드 번호를 입력하십시오.'\r\n    \t,alert_directbank_msg5 : 'OTP 번호를 입력하십시오.'\r\n\t\t,alert_directbank_msg6 : '구매안전서비스 이용약관에 동의하여 주시기 바랍니다. 동의를 해야만 결제 진행이 가능합니다.'\r\n\t\t,alert_directbank_msg7 : '휴대폰 인증 시간이 초과되었습니다.'\r\n\t    ,alert_directbank_msg8 : '서비스 이용약관에 동의하여 주시기 바랍니다. 동의를 해야만 결제 진행이 가능합니다.'\r\n\t    ,alert_directbank_msg9 : '통신이용약관에 동의하여 주시기 바랍니다. 동의를 해야만 결제 진행이 가능합니다.'\r\n\t    ,alert_directbank_msg10 : '고유식별정보처리동의 이용약관에 동의하여 주시기 바랍니다. 동의를 해야만 결제 진행이 가능합니다.'\r\n\t    ,alert_directbank_msg11 : '개인정보이용 및 제공동의 이용약관에 동의하여 주시기 바랍니다. 동의를 해야만 결제 진행이 가능합니다.'\r\n\t    ,alert_directbank_msg12 : '죄송합니다. 해당 은행은 법인계좌로 계좌이체를 하실 수 없습니다.'\t\r\n\t    ,alert_directbank_useCert1 : '공인인증서'\t\r\n\t    ,alert_directbank_useCert2 : '휴대폰 인증'\r\n\t    ,alert_directbank_certType2 : 'OTP'\r\n\t    ,alert_directbank_certType3 : '보안카드'\r\n\t    ,alert_directbank_noneCert : '비인증'\r\n    \t,alert_directbank_param_msg1 : function(str) {\r\n \t    \treturn \"<b>최소 이체금액보다 결제금액이 적습니다.</b>  <br/> 최소 이체금액은 \" + str + \"입니다.\";\r\n     \t}\r\n \t\t,alert_directbank_param_msg2 : function(str) {\r\n \t\t\treturn \"<b>최대 이체금액보다 결제금액이 많습니다.</b>  <br/> 최대 이체금액은 \" + str + \"입니다.\";\r\n \t\t}\r\n \t\t,alert_directbank_param_msg3 : function(str1,str2) {\r\n \t    \treturn \"<b>선택하신 은행의 서비스 시간이 아닙니다.</b> <br/> 서비스 가능 시간은 \" + str1 + \"부터 \" + str2 + \"입니다.\";\r\n     \t}\r\n \t\t,alert_basicfault_msg : '기준정보 설정 오류 : 이니시스 고객센터(1588-4954)로 문의하여 주시기 바랍니다.'\r\n\r\n        ,alert_cashReceipt_msg1 : '사업자번호를 정확히 입력해 주세요.'\t/*현금영수증 20150908*/\r\n        \r\n        \t\r\n\t\t/**네이버 - NIK START - 2015-09-18 */\r\n\t\t,alert_nik_agree_tit0 : '전자금융거래 이용약관 동의'\r\n\t    ,alert_nik_agree_msg0 : '전자금융거래 이용 약관에 동의하여 주십시오.<br/> 동의 후 결제가 진행됩니다.'\r\n\t\t,alert_nik_agree_tit1 : '고유식별정보 수집 및 이용 동의'\r\n\t    ,alert_nik_agree_msg1 : '고유식별정보 수집 및 이용에 동의하여 주십시오.<br/> 동의 후 결제가 진행됩니다.'\r\n\t\t,alert_nik_agree_tit2 : '개인정보수집 및 이용 동의'\r\n\t    ,alert_nik_agree_msg2 : '개인정보수집 및 이용에 동의하여 주십시오.<br/> 동의 후 결제가 진행됩니다.'\r\n\t\t,alert_nik_agree_tit3 : '개인정보 제공 및 위탁 동의'\r\n\t    ,alert_nik_agree_msg3 : '개인정보 제공 및 위탁에 동의하여 주십시오.<br/> 동의 후 결제가 진행됩니다.'\r\n\t\t,alert_nik_agree_tit4 : '결제정보 제공 동의'\r\n\t\t,alert_nik_agree_msg4 : '결제정보 제공에 동의를 하셔야 <br/>결제가 진행됩니다.'\r\n\t\t,alert_nik_card_title : '신용카드 결제'\r\n\t\t,alert_nik_dbank_title : '계좌 이체'\r\n\t\t,alert_nik_vbank_title : '무통장 입금'\r\n\t\t/**네이버 - NIK END*/\r\n\r\n\t\t,alert_nik_vbank_msg1: '<b><font color=\"dark blue\">이니페이 에스크로 이용 약관</font></b> <br/><br/>이니매매보호서비스를 이용하시려면 반드시 약관에 동의해야 합니다. <br/> 에스크로 이용약관 동의를 반드시 체크하시고 다음버튼을 누르세요. '\r\n\t\t,alert_nik_vbank_msg2: '<b><font color=\"dark blue\">결제정보 제공 동의</font></b><br/><br/>결제정보 제공에 동의를 하셔야 결제가 진행됩니다.'\r\n\r\n\r\n\t\t,IDS_BTBANK_188     :     \"선택하신 은행은 이체 서비스 장애가 발생 중입니다. \\n\\n 다른 은행을 선택하여 주십시오.\"\r\n\t    ,IDS_BTBANK_230     :      \"인증서의 주민등록번호(또는 사업자등록번호)와계좌 소유주의 주민등록번호(또는 사업자등록번호)와 일치하지 않으니 확인 후 다시 이용하시기 바랍니다.\"\r\n\t    ,IDS_BTBANK_243     :      \"지급가능잔액 부족\"\r\n\t    ,IDS_BTBANK_255     :      \"계좌 비밀번호(숫자4자리)가 일치하지 않습니다. 확인후 다시 이용하시기 바랍니다.\"\r\n\t    ,IDS_BTBANK_261     :      \"이용하신 계좌의 잔액부족으로 출금할 수 없습니다. \"\r\n\t    ,IDS_BTBANK_272     :      \"입력하신 계좌번호가 올바르지 않습니다. \"\r\n\t    ,IDS_BTBANK_278     :      \"이용하신 은행에서 서비스를 일시 중단하였거나 기타 사유로 인하여 정상적으로 출금할 수 없습니다. 해당은행으로 문의하여 확인해주시기 바랍니다. \"\r\n\t    ,IDS_BTBANK_282     :      \"OTP 또는 보안카드를 사용하지 않는 계좌입니다.\"\r\n\t    ,IDS_BTBANK_333     :      \"OTP 또는 보안카드 입력값이 틀렸습니다.\"\r\n\t    ,IDS_BTBANK_379     :      \"보안수단 일련번호 검증 오류\"\r\n\t    ,IDS_BTBANK_385     :      \"입력횟수 초과했습니다.\"\r\n\t    ,IDS_BTBANK_367     :      \"보안강화를 위해 서비스 이용을 제한하오니 가까운 영업점을 방문하여 교체발급 받으시기 바랍니다.\"\r\n\t    ,IDS_BTBANK_def     :      \"보안수단 인증에 실패했습니다. 잠시 후 다시 이용하시기 바랍니다. \"\r\n\r\n\t    ,alert_escrow_msg00 : \"장애로 인해 결제를 진행할수 없습니다.\"\r\n\t    ,alert_escrow_msg01 : '환불 받은 은행을 선택해주시기 바랍니다.'\r\n\t    ,alert_escrow_msg02 : '환불 받을 계좌번호를 입력하시기 바랍니다.'\r\n\t    \t\r\n\t    ,alert_yes24_corp\t: //'<b>법인카드 결제 확인</b></br>'+\r\n\t    \t\t\t\t\t   '<font color=\"#6799FF\"><b>할인여부 : </b></font> 할인 미적용 대상</br>'+\r\n\t    \t\t\t\t\t   '</br><font color=\"#6799FF\"><b>상세내용 : </b></font>법인카드는 할인 대상에서 제외 됩니다.</br>'+\r\n\t    \t\t\t\t\t   '</br><font color=\"#0095CD\"><b>※ 법인카드로 결제 진행 하시겠습니까?</b></font>'\r\n\t    \t\t\t\t\t   \r\n\t    ,alert_yes24_fail\t: function(code,msg) {\r\n \t    \t //<b>법인카드 결제 확인</b></br>'+\r\n\t    \treturn \t'<font color=\"#6799FF\"><b>오류코드 : </b></font>' + code + '</br>'+\r\n \t    \t\t\t'</br><font color=\"#6799FF\"><b>오류내역 : </b></font>' + msg + '</br>'+\r\n \t    \t\t\t'</br><font color=\"#0095CD\"><b>※ 일반결제로 결제 진행 하시겠습니까?</b></font>';\r\n     \t}\r\n \t\t\r\n \t\t,alert_mcp_msg1\t\t:\t\t\"MCP서비스 이용 동의 후 결제 가능합니다.\"\r\n \t\t\r\n \t\t//팝업창 노출 여부 체크 메시지\r\n \t\t,alert_popup_check1 : '결제창 정상 호출을 위한 설정 방법 \\n\\n1.신뢰할 수 있는 사이트 변경\\n인터넷 익스플로러 내 도구>인터넷 옵션>보안(탭)>신뢰할 수 있는 \\n사이트>사이트(버튼)에서 상점 도메인과 https://stdpay.inicis.com를\\n모두 추가 혹은 제거 합니다.\\n\\n2.팝업차단 확인\\n도구>인터넷옵션>개인 정보(탭)> 팝업 차단 사용 해지 합니다.\\n\\n설정 이후 페이지를 새로고침 해주세요.' \r\n \t\t,alert_popup_check2 : '팝업이 차단되었습니다.\\n팝업차단 해제 후 다시 시도해 주시기 바랍니다.'\r\n \t\r\n}\r\nvar INImsg_en = {\r\n\t\ttitle\t\t\t:'KG INICIS'\r\n\t\t,title_mobil \t: 'KG Mobilians'\r\n\t\t\t\r\n\t\t,alert_confirm1:'Would you like to cancel the payment?'\r\n\t\t// ,alert_msg3:'The site you are trying to pay restricts the payment time to (%d) minutes. The payment time has been exceeded. Please cancel the payment and try again.'\r\n\t\t,alert_msg3 : '<b>The payment time (#%dmin) has been exceeded.<br/><br/>The payment will terminate automatically.</b>'\r\n\t\t,alert_msg4:'<b> The remaining payment time <span style=\"\"color:red;font-weight:bold;\"\"> is #1 minute </span>. </b><br/><br/>※ If the payment is not completed in #1 minute, the payment will be terminated. (Maximum payment time: #2 minutes)\"'\r\n\t\t,alert_msg5:'This card cannot be used for payments in the current browser. <br/> (card company does not support current browser, Supported in only \\'Internet Explorer\\' browser)\"'\r\n\t\t,alert_msg9:'Please enter the exact email address'\r\n\t\t,alert_msg10:'This is not the recommended screen size upon processing through iframe. [over 320x520]'\r\n\t\t,alert_msg11:'Not available in mobile device.'\r\n\t\t,alert_msg12:'Language conversion has failed.'\r\n\t\t,alert_msg13:'Select the coupon.'\r\n\t\t//,alert_msg14:'Authentication number has not been entered.'\r\n\t\t,alert_msg14:'Authentication number is not entered.'\r\n\t\t,alert_msg15:'Authentication number is incorrect.'\r\n\t\t,alert_card_msg1:'Please choose the card type.'\r\n\t\t,alert_card_msg2:'Please choose the installment type.'\r\n\t\t,alert_card_msg3:'Please enter the card number'\r\n\t\t,alert_card_msg4:'Please enter the card expiration date'\r\n\t\t,alert_card_msg5:'Proceeding with non-authenticated payment.'\r\n\t\t,alert_card_msg6:'ISP processing error has occurred'\r\n\t\t,alert_card_msg7:'ISP mobile app authentication has not been completed.<br/> (Please try again.)'\r\n\t\t,alert_card_msg8:'ISP mobile app will start shortly.'\r\n\t\t,alert_card_msg9:'Enter the miscellaneous information.'\r\n\t\t,alert_card_msg10:'Samsung Wallet does not support payments over 300,000 Won.\"'\r\n\t\t,alert_card_msg11:'Kpay does not support payments over 300,000 Won.\"'\r\n\t\t,alert_card_msg12: '<b> <span style=\"color:#6699ff;font-weight:bold;\"> Credit cards cannot be used for payments under 1,000 Won.   </span></b><br/><br/>Please pay by a method other than credit card.'\r\n\t\t,alert_card_msg13 : 'The selected month is not eligible for installment plan.'\r\n\t\r\n\r\n\t\t//평창 Fail 메시지\r\n\t\t,alert_card_msg14 : 'This credit card is not valied for Pyeongchang Winter Olympic.'\r\n\t\t,alert_card_msg16 : 'Currency code for payment is not Korean Won. Please inquire with the merchant.'\r\n\t\t\r\n\t\t,alert_card_msg17 : function(str) {\r\n\t\t\treturn 'Card points can not be used. You can use your card points if your payment is more than <b> '+ str +'</b> won.'\r\n     \t}\r\n\r\n\r\n\t\t//애플페이 다이렉트 옵션 호출 시 미지원 브라우저 문구 출력\r\n\t\t,alert_card_msg18 : 'The payment method you entered is not available in your browser.<br/>Please enter another payment method'\t\r\n\t\t\r\n\t\t//해외카드 메시지\r\n\t\t,alert_card_msg19 : 'Please enter the cardholder name.'\r\n\t\t,alert_card_msg20 : 'Please enter the cardholer E-mail.'\r\n\t\t//해외카드 화면 빈체크 메시지 추가 250709\r\n\t\t,alert_card_msg21 : 'The selected card company and the entered card number do not match.'\r\n\t\t//해외카드 가상키패드 메시지 추가 250715\r\n\t\t,alert_card_msg22 : 'Please check the card number you entered again.'\r\n\t\t\t\r\n\t\t//이니안심 메시지\r\n\t\t,alert_kcare_msg1 : '선택 되어진 지불수단으로 이니안심서비스를 이용하실 수 없습니다.<br/>이니안심서비스 사용을 원하시면 다른 카드를 선택해주세요.'\r\n\t\t,alert_kcare_msg2 : '이니안심서비스 이용 시 할부결제를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg3 : 'Lpoint 사용 시 이니안심서비스를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg4 : '카드 포인트 사용 시 이니안심서비스를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg5 : '이니안심서비스 이용 시 할부결제를 이용할 수 없습니다.<br/>이니안심서비스를 사용하시겠습니까?'\r\n\t\t,alert_kcare_msg6 : '이니안심서비스 사용 안내'\r\n\t\t,alert_kcare_msg7 : '이니포인트 이용 시 이니안심서비스를 사용하실 수 없습니다.'\r\n\t\t,alert_kcare_msg8 : '이니안심서비스 사용 시 Lpoint를 이용할 수 없습니다.'\r\n\t\t//이니안심 할부개월 추가로 인한 메시지 추가 250506\r\n\t\t,alert_kcare_msg9 : '선택하신 할부개월은 이니안심 서비스 이용이 불가합니다.'\r\n\t\t\r\n\t\t,alert_easyPay_msg1:'EasyPay ID is incorrect.'\r\n\t\t,alert_easyPay_msg2:'Please enter your EasyPay password.'\r\n\t\t,alert_easyPay_msg3:'Please choose the installment type.'\r\n\t\t,alert_easyPay_msg4:'Please enter the authentication number sent to you via SMS text.'\r\n\t\t,alert_easyPay_msg5:'EasyPay connection error has occurred. <br/> Please go back to login page and try again'\r\n\t\t,alert_easyPay_msg6:'After pressing the \\'Send Authentication Number\\' button, <br/> enter the authentication number sent to you via SMS text\"'\r\n\t\t,alert_easyPay_msg7:'The authentication number has been sent to your mobile phone. <br/> Enter the authentication number you received on your mobile phone.'\r\n\t\t//,alert_easyPay_msg8:'The selected discount coupon cannot be used. <br/> It is available only when paying with the selected Hana Card. <br/> As Hana Card does not exist within your EasyPay card information, <br/> the selected card coupon discount is unavailable. \"'\r\n\t\t,alert_easyPay_msg8: 'The discount coupon you selected cannot be used. <br/>It is available only when paying with the selected Hana Card. <br/> As Hana Card does not exist within your EasyPay card information, <br/> the selected card coupon discount is unavailable.' \r\n\t\t//,alert_easyPay_msg9:'The selected discount coupon cannot be used. <br/> It is available only when paying with the selected Shinhan Card. <br/> As Shinhan Card does not exist within your EasyPay card information, <br/> the selected card coupon discount is unavailable. \"'\r\n\t\t,alert_easyPay_msg9:'The discount coupon you selected cannot be used. <br/>It is available only when paying with the selected Shinhan Card. <br/> As Shinhan Card does not exist within your EasyPay card information, <br/> the selected card coupon discount is unavailable.'\t\t\t\r\n\t\t,alert_easyPay_msg10:'<font color=\"\"#6799FF\"\" style=\"\"\"\"><b>EasyPay Authentication Request Error</b></font> <br/><br/> EasyPay Authentication Request has failed for the following reason.<br/><br/>\"'\r\n\t\t\t\r\n\t\t,alert_point_msg1:'Enter your ID.'\r\n\t\t,alert_point_msg2:'Enter your Password.'\r\n\t\t,alert_point_msg3:'IniPoint can be used to up to 50% of your payment amount.'\r\n\t\t,alert_point_msg4:'Select the points you wish to use for payment.'\r\n\t\t,alert_point_msg5 : '포인트는 1포인트 이상 사용 가능합니다.'\r\n\t\t,alert_point_msg6 : '사용할 포인트를 확인 하십시오.'\t\r\n\t\t,alert_point_msg7 : '포인트를 조회하십시오.'\r\n\t\t,alert_point_msg8 : 'LPOINT와 쿠폰은 함께 사용할 수 없습니다.'\t\r\n\t\t,alert_hpp_msg1:'Select the telecom carrier for payment.'\r\n\t\t,alert_hpp_msg2:'Enter your exact mobile phone number.'\r\n\t\t,alert_hpp_msg3:'Enter your exact resident registration number.'\r\n\t\t,alert_hpp_msg4:'Please agree to the service use terms and conditions. <br/> Payment will proceed only after agreement.'\r\n\t\t,alert_hpp_msg5:'Enter the authentication number sent to you via SMS text'\r\n\t\t,alert_hpp_msg6:'Check the RRN and try again.'\r\n\t\t\t\r\n\t\t,alert_bank_msg1:'Select the bank for account transfer.'\r\n\t\t,alert_bank_msg2:'Select the securities company for account transfer.'\r\n\t\t,alert_bank_msg3:'Select the cash receipt purpose.'\r\n\t\t,alert_bank_msg4:'Select the cash receipt verification method.'\r\n\t\t,alert_bank_msg5:'Enter the cash receipt issuance number.'\r\n\t\t,alert_bank_msg6:'The length of the cash receipt issuance number is incorrect.'\r\n\t\t,alert_bank_msg7:'An account transfer calling error has occurred.'\r\n\t\t,alert_bank_msg8:'The account transfer mobile app has not been authenticated.'\r\n\t\t,alert_bank_msg9:'The account transfer mobile app will start shortly.'\r\n\t\t,alert_bank_msg10:'Enter the account holder name.'\r\n\t\t,alert_bank_msg11:'Enter only characters (English and Korean).'\r\n\t\t,alert_bank_msg12:'Enter the front digits of your resident (foreigner) registration number.'\r\n\t\t,alert_bank_msg13:'Enter the back digits of your resident (foreigner) registration number.'\r\n\t\t,alert_bank_msg14:'Please enter only numbers.'\r\n\t\t,alert_bank_msg15:'Check the RRN and try again.'\r\n\t\t,alert_bank_msg16:'Enter the first digit of your business registration number.'\r\n\t\t,alert_bank_msg17:'Enter the second digit of your business registration number.'\r\n\t\t,alert_bank_msg18:'Enter the third digit of your business registration number.'\r\n\t\t,alert_bank_msg19:'Check your business registration number and try again.'\r\n\t\t,alert_bank_msg20:'Please enter numbers.'\r\n\t\t,alert_bank_msg21:'Enter your bank account number.'\r\n\t\t,alert_bank_msg22:' Enter your bank account password.'\r\n\t\t,alert_bank_msg23:'Please enter the front digits of your resident (foreign) registration number for cash receipt issuance.'\r\n\t\t,alert_bank_msg24:'Enter the back digits of your resident (foreigner) registration number for cash receipt issuance.'         \r\n\t\t,alert_bank_msg25:'Please enter mobile phone number for cash receipt issuance.'   \r\n\t\t,alert_bank_msg26:'Enter the business registration number for cash receipt issuance.'\r\n\t\t,alert_bank_msg27:'Check the resident registration number and proceed with cash receipt issuance again.'\r\n\t\t,alert_bank_msg28:'Check your business registration number and proceed with cash receipt issuance again.'\r\n\t\t,alert_bank_msg29:'Enter only Korean or English for the Remitter Name.<br>(special characters can also be entered excluding &.)'\r\n\t\t,alert_bank_msg30:'Up to 10 Korean characters (20 English characters) are supported.' \r\n\t\t,alert_bank_msg31:'Please enter card number for cash receipt issuance.'     \r\n\t\t\t\r\n\t\t,alert_easybank_KBANK : '케이뱅크 페이란, 고객님의 케이뱅크 계좌에서 간편한 인증으로 결제되는 서비스입니다.'\r\n\t\t\t\t\t\r\n\t\t,alert_vbank_msg1:'Select the deposit bank.'\r\n\t\t,alert_vbank_msg2:'Enter the remitter name.'\r\n\t\t//,alert_vbank_msg3:'Select the purpose of cash receipt issuance.'\r\n\t\t,alert_vbank_msg3:'Select the cash receipt purpose.'\r\n\t\t,alert_vbank_msg4:'Select the cash receipt verification method.'\r\n\t\t,alert_vbank_msg5:'Enter the cash receipt issuance number.'\r\n\t\t,alert_vbank_msg6:'The length of cash receipt issuance number is incorrect.'\r\n\t\t,alert_vbank_msg7:'Please enter the resident registration number correctly.'\r\n\t\t,alert_vbank_msg8:'Can only select up to 28 days.'\r\n\t\t,alert_vbank_msg9:'Can only select up to 30 days.'\r\n\t\t,alert_vbank_msg10:'The deposit deadline cannot be before today.'\r\n\t\t,alert_vbank_msg11:'The deposit deadline cannot exceed 9 days from today.'\r\n\t\t,alert_vbank_msg12:'In the case of withdrawals from corporate accounts, only business expense purpose cash receipts can be issued.\"'\r\n\t\t,alert_vbank_msg13:'Please enter your cash receipt card number for cash receipts issuance.' \r\n\t\t,alert_vbank_msg14:'Please enter your phone number for cash receipt issuance.'\r\n\t\t,alert_vbank_msg15: '결제정보 토스 안내를 위해 휴대폰번호를 입력해주세요.'\r\n\t\t,alert_vbank_msg16: '결제정보 토스 안내를 위해 내용에 동의해주세요.'\r\n\t\t,alert_vbank_msg17 : 'Please enter your cash receipt card number correctly.'\r\n\t\t,alert_vbank_msg18 : 'Please enter your cash receipt phone number correctly.'\r\n\t\t\r\n\t\t,alert_okCash_msg1:'Please enter the OK Cashbag card number correctly.'\r\n\t\t,alert_okCash_msg2:'<font color=\"\"#6799FF\"\" ><b>Member authentication error</b></font></br>※ Point search failed due to the following error.</br>\"'\r\n\t\t,alert_okCash_msg4:'There is no payment amount for credit card complex payment.'\r\n\t\t,alert_okCash_msg5:'When using credit card complex payment, the payment amount must exceed 1000 Won.\"'\r\n\t\t,alert_okCash_msg6:'OK Cashbag points cannot be used for payments of 0 Won. Please try again.'\r\n\t\t,alert_okCash_msg7:'The entered [amount to use] is insufficient compared to total payment amount.'\r\n\t\t,alert_okCash_msg8 : 'Enter OK Cashbag points in 1,000 Won units.'\r\n\t\t\t\r\n\t\t,alert_upt_msg1 : 'U-points can be used starting from 1,000 Won.'\r\n\t\t\t\t\r\n\t\t,alert_gspt_msg1:'The entered [amount to use] is insufficient compared to total payment amount.'\r\n\t\t//,alert_gspt_msg2:'GS&POINT cannot be used for payments of 0 Won. The payment amount must exceed 1000 Won.'\r\n\t\t,alert_gspt_msg2:'Payment unavailable as GS&POINT balance is 0 Won. Please try again'\t\t\t\r\n\t\t,alert_gspt_msg3:'When using credit card complex payment, the payment amount must exceed 1000 Won.\"'\r\n\t\t//,alert_gspt_msg4:'For GS&POINT, please enter in 1000 Won units.\"'\r\n\t\t,alert_gspt_msg4:'Enter GS&POINT in 1,000 Won units.'\r\n\t\t//,alert_gspt_msg5:'Payment must be conducted as GS Point + Credit Card Complex Payment.<br/> Please check the credit card complex payment box.'\r\n\t\t,alert_gspt_msg5:'Payment must be made as GS Point + Credit Card Complex Payment.<br/> Please check the credit card complex payment checkbox.'\t\t\t\r\n\t\t,alert_gspt_msg6:'Enter the GS&POINT ID.'\r\n\t\t,alert_gspt_msg7:'Enter the GS&POINT Password.'\r\n\t\t//,alert_gspt_msg8:'The affiliate merchant code value has not been set.<br/> Please inquire with the shopping mall administrator.'\r\n\t\t,alert_gspt_msg8:'Partner merchant code value is not set.<br/>Please inquire with the shopping mall administrator.'\t\t\t\r\n\r\n\t\t//,alert_upnt_msg1:'Correctly enter the U-point card number.'\r\n\t\t,alert_upnt_msg1:'Please enter a valid U-point card number.'\r\n\t\t,alert_upnt_msg2:'U-point cannot be used for payments of 0 Won. Please try again.'\r\n\t\t\t\r\n\t\t//,alert_mypt_msg1:'Points cannot be used for payment when the total points is less than 5000 points.'\r\n\t\t,alert_mypt_msg1:'Payment cannot be made when the points balance is less than 5000 points.'\t\t        \r\n\t\t//,alert_mypt_msg2:'The total points is less than the payment amount.'\r\n\t\t,alert_mypt_msg2:'Insufficient points compared to actual payment amount.'\t\t\t  \r\n\t\t\t\r\n\t\t,alert_gift_msg1:'Select the gift certificate to use for payment.'\r\n\t\t,alert_culture_msg1:'Enter the Cultureland ID.'\r\n\t\t,alert_culture_msg2:'Enter the Cultureland Password.'\r\n\t\t,alert_culture_msg3:'Enter the Culture gift certificate PIN number.'\r\n\t\t,alert_culture_msg4:'#1 Won gift certificate PIN number has been verified. <br/>It is used simultaneously with charging upon final payment.'\r\n\t\t,alert_culture_msg5:'The charging amount is insufficient.<br/> The sum of the Cultureland balance and charging gift certificate must exceed the payment amount.'\r\n\t\t//,alert_culture_msg6 : '컬쳐랜드 로그인이 필요합니다(번역필요).'\r\n\t\t,alert_culture_msg6 :  'You must log into Cultureland.'\r\n\t\t\t\r\n\t\t\t\r\n\t\t,alert_hpmn_msg1:'Enter the Happy Money ID.'\r\n\t\t,alert_hpmn_msg2:'Enter the Happy Money Password.'\r\n\t\t,alert_hpmn_msg3:'Enter the Happy Money gift certificate number.'\r\n\t\t,alert_hpmn_msg4:'Enter the Happy Money gift certificate issuance date.'\r\n\t\t,alert_hpmn_msg5:'Happy Money has been charged.'\r\n\t\t\t\r\n\t\t,alert_sculture_msg1:'Please enter the gift certificate number correctly.'\r\n\t\t,alert_sculture_msg2:'You have entered an amount larger than the balance.'\r\n\t\t,alert_sculture_msg3:'Balance is insufficient.'\r\n\t\t,alert_sculture_msg4:'Balance is automatically adjusted as it exceeds the product amount.<br/>The balance can be verified later.'\r\n\t\t,alert_cancel1:'The payment has been cancelled. '\r\n\t\t,alert_isp_fail1:'ISP authentication has failed.'\r\n\t\t,alert_isp_fail2:'ISP module processing failed.'\r\n\t\t,alert_ini_test1:'Converting to IniPoint login screen.'\r\n\t\t\r\n\t\t,alert_swallet_msg1:'Before re-sending the payment request alert, please check to see that your smart device is properly connected to the internet. Press the \"OK\" button to request payment again.'\t\t\t                              \r\n\t\t,alert_swallet_msg2:'Please enter the mobile phone number correctly.'\r\n\t\t,alert_swallet_msg3:'Select the payment device.'\r\n\t\t//,alert_swallet_msg4 : '뱅크월렛 가입여부를 확인하여 주시기 바랍니다(번역필요).'\r\n\t\t,alert_swallet_msg4 : 'Check to see that you have registered with Bank Wallet.'\r\n\t\t,alert_paypin_msg1:'Before re-sending the payment request alert, please check to see that your smart device is properly connected to the internet. Press the \"OK\" button to request payment again.'\r\n\t\t,alert_paypin_msg2:'Please enter the mobile phone number correctly.'\r\n\t\t,alert_paypin_msg3:'Payment method that supports PayPin payment is not available.<br/> Please inquire with the merchant.'\r\n\t\t,alert_kpay_msg1:'Before re-sending the payment request alert, please check to see that your smart device is properly connected to the internet. Press the \"OK\" button to request payment again.'\r\n\t\t,alert_kpay_msg2:'Please enter the mobile phone number correctly.'\r\n\t\t,alert_swallet_msg :'Please enter the correct mobile phone number'\r\n\t\t\t\r\n\t\t,alert_bankWallet_msg1:'Authentication number issuance complete <br/><br/> The authentication number has bee issued.<br/>Start the Bank Wallet app, enter the authentication number and proceed with payment.\"'\r\n\t\t,alert_bankWallet_msg2:'Time limit exceeded <br/> Press the resend button and use the new authentication number to authenticate in the Bank Wallet app.'\r\n\t\t,alert_bankWallet_msg3:'Bank Wallet authentication is incomplete. <br/> Within the Bank Wallet app, authenticate payment and press the Next button.\"'\r\n\t\t,alert_bankWallet_msg4:'After authentication number request, press Next.\"'\r\n\t\t,alert_bankWallet_msg5:'Try authentication number request again.'\r\n\t\t,alert_bankWallet_msg6 :'Select the E-wallet'\r\n\t\t,alert_phoneBill_msg1:'Telecom billing service use agreement <br/><br/>Please agree with the telecom billing service use agreement. Payment will proceed upon agreement.'\r\n\t\t,alert_phoneBill_msg2:'Input error <br/><br/>Please enter the correct telephone number.'\r\n\t\t,alert_phoneBill_msg3:'Input error <br/><br/>Please enter the correct RRN.'\r\n\t\t\t\r\n\t\t,alert_bcsh_msg1:'Balance is insufficient even if you charge the requested book gift certificate.'\r\n        //,alert_bcsh_msg2 : '도서문화상품권 잔액이 부족합니다.</br>충전 후 다시 시도하여 주시기 바랍니다.'\r\n\t\t,alert_bcsh_msg2 : 'Book Culture Gift Certificate balance is insufficient.</br>Charge your  balance and try again.'\r\n\t\t\t\r\n\t\t,alert_teen_msg1:'Balance is insufficient. Please purchase additional TeenCash and try again.'\r\n\t\t,alert_teen_msg2:'Correctly enter your Teen Cash card number.'\r\n\t\t,alert_teen_msg3:'Enter your ID.'\r\n\t\t,alert_teen_msg4:'Enter your Password.'\r\n\r\n\t\t,alert_bill_msg1 : 'Enter your Password.'\r\n\t\t,alert_bill_msg2 : 'Enter your name.'\r\n\t\t,alert_bill_msg3 : 'Cancelled.'\r\n\t\t\r\n\t\t,alert_done_msg1 : '결제내용에 동의하여 주십시오.<br/> 동의 후 결제가 진행됩니다.'\r\n\t\t,alert_bill_agree_msg0 : ''\r\n\t\t,alert_bill_agree_msg1 : 'Please agree to the Financial Transaction Terms and Conditions.'\r\n\t\t,alert_bill_agree_msg2 : 'Please agree to the Collection and Use of Unique Identification Information.'\r\n\t\t,alert_bill_agree_msg3 : 'Please consent to the Collection and Use of Unique Identification Information.'\r\n\t\t,alert_bill_agree_msg4 : 'Please consent to the Provision and Consignment of Personal Information.'\r\n\t\t,alert_bill_agree_msg5 : 'Please agree with the telecom billing service use agreement.'\r\n\t\t,alert_directbank_msg1 : 'Enter your bank account number.'\r\n        ,alert_directbank_msg2 : 'Enter you bank account password.'\r\n    \t,alert_directbank_msg3 : 'Enter your security card serial number.'\r\n    \t,alert_directbank_msg4 : 'Enter your security card number.'\r\n    \t,alert_directbank_msg5 : 'Enter the OTP number.'\r\n\t\t,alert_directbank_msg6 : 'Please agree to the purchasing safety service terms and conditions. Payment will proceed only after agreement.'\r\n\t\t,alert_directbank_msg7 : 'Mobile phone authentication time limit has expired.'\r\n\t    ,alert_directbank_msg8 : 'Please agree to the service terms and conditions. Payment will proceed only after agreement.'\r\n\t    ,alert_directbank_msg9 : 'Please agree to the telecommunication use terms and conditions. Payment will proceed only after agreement.'\r\n\t    ,alert_directbank_msg10 : 'Please agree to the identification information processing agreement terms and conditions. Payment will proceed only after agreement.'\r\n\t    ,alert_directbank_msg11 : 'Please agree to the Personal information use and provision terms and conditions. Payment will proceed only after agreement.'\r\n\t    ,alert_directbank_msg12 : 'Sorry, coporate bank account transfer is not available for this bank.'\r\n\t\t,alert_directbank_useCert1 : 'Bank Certificate'\t\r\n\t\t,alert_directbank_useCert2 : 'Mobile Authentication'\r\n\t\t,alert_directbank_certType2 : 'OTP'\r\n\t\t,alert_directbank_certType3 : 'safety card'\r\n\t\t,alert_directbank_noneCert : 'unauthenticated'\r\n\t    ,alert_directbank_param_msg1 : function(str) {\r\n \t    \treturn \"<b>Payment amount is less than minimum transfer amount.</b>  <br/> Minimum transfer amount is \" + str + \".\";\r\n     \t}\r\n \t\t,alert_directbank_param_msg2 : function(str) {\r\n \t\t\treturn \"<b>Payment amount is more than maximum transfer amount.</b>  <br/> Maximum transfer amount is \" + str + \".\";\r\n \t\t}\r\n \t\t,alert_directbank_param_msg3 : function(str1,str2) {\r\n \t    \treturn \"<b>Service is not available at this time.</b> <br/> business hours are from \" + str1 + \"to \" + str2 + \".\";\r\n     \t}\r\n \t\t,alert_basicfault_msg : 'Standard information error: Please inquire with INICIS customer service center(+82-1588-4954).'\r\n\r\n        ,alert_cashReceipt_msg1 : 'Please enter a valid business registration number.'\t/*현금영수증 20150908*/\r\n        \t\r\n        \t\r\n\t\t/**네이버 - NIK START - 2015-09-18 */\r\n\t\t,alert_nik_agree_tit0 : 'Financial Transaction Terms and Conditions'\r\n\t    ,alert_nik_agree_msg0 : 'Please agree to the Financial Transaction Terms and Conditions.<br/> The payment will proceed only after agreement.'\r\n\t\t,alert_nik_agree_tit1 : 'Consent to Collection and Use of Unique Identification information'\r\n\t    ,alert_nik_agree_msg1 : 'Please agree to the Collection and Use of Unique Identification Information.<br/> The payment will proceed only after agreement.'\r\n\t\t,alert_nik_agree_tit2 : 'Collection and Use of Personal Information'\r\n\t    ,alert_nik_agree_msg2 : 'Please consent to the Collection and Use of Unique Identification Information.<br/> The payment will proceed only after agreement.'\r\n\t\t,alert_nik_agree_tit3 : 'Consent to Provision and Consignment of Personal Information'\r\n\t    ,alert_nik_agree_msg3 : 'Please consent to the Provision and Consignment of Personal Information.<br/> The payment will proceed only after agreement.'\r\n\t\t,alert_nik_agree_tit4 : 'Consent to Provision of Transaction Information'\r\n\t\t,alert_nik_agree_msg4 : 'You must consent to Provision of Transaction Information <br/>to proceed with payment.'\r\n\t\t,alert_nik_card_title : 'Credit Card Payment'\r\n\t\t,alert_nik_dbank_title : 'Account Transfer'\r\n\t\t,alert_nik_vbank_title : 'Virtual Account Transfer'\r\n\t\t/**네이버 - NIK END*/\r\n\r\n\t\t,alert_nik_vbank_msg1: '<b><font color=\"dark blue\">INIPAY Escrow Terms and Conditions</font></b> <br/><br/>You must agree to the terms and conditions to use INIEscrow Service. <br/> Agree to the Escrow Terms and Conditions and press the Next button. '\r\n\t\t,alert_nik_vbank_msg2: '<b><font color=\"dark blue\">Consent to Provision of Transaction Information</font></b><br/><br/>You must consent to Provision of Transaction information to proceed with payment.'\r\n\r\n\r\n\t\t,IDS_BTBANK_188     :     \"Bank you chose is currently experiencing account transfer errors. \\n\\n Please choose another bank.\"\r\n\t    ,IDS_BTBANK_230     :      \"Unable to match the Social Security number of the certificate (or business registration number) and the account holder's social security number (or business registration number). Please check the information you entered and try again.\"\r\n\t    ,IDS_BTBANK_243     :      \"Insufficient account balance\"\r\n\t    ,IDS_BTBANK_255     :      \"Account password (4 digit number) is incorrect. Please check your password again and use.\"\r\n\t    ,IDS_BTBANK_261     :      \"Unable to withdraw due to lack of balance of the account you used. \"\r\n\t    ,IDS_BTBANK_272     :      \"The account number you entered is incorrect. \"\r\n\t    ,IDS_BTBANK_278     :      \"Can't withdraw because you bank suspend services, or due to any other reason. Please inquire with the corresponding bank. \"\r\n\t    ,IDS_BTBANK_282     :      \"Account you entered is not available for OTP or a safety card.\"\r\n\t    ,IDS_BTBANK_333     :      \"Entered OTP or safety card value is incorrect.\"\r\n\t    ,IDS_BTBANK_379     :      \"Security measures, serial number Validation error\"\r\n\t    ,IDS_BTBANK_385     :      \"Input limit has been exceeded.\"\r\n\t    ,IDS_BTBANK_367     :      \"Service use is currently restricted for security measures. Please visit a nearby sales branch if necessary.\"\r\n\t    ,IDS_BTBANK_def     :       \"Security method authentication has failed. Please try again later. \"\r\n\r\n\t    ,alert_escrow_msg00 :\t\t\"Payment cannot be conducted due to system failure.\"\r\n\t\t,alert_mcp_msg1\t\t: \"Please check the checkbox if wish MCP service.\"\r\n \t\t\r\n\t\t//팝업창 노출 여부 체크 메시지\r\n \t\t,alert_popup_check1 : 'How to set up to call the payment window normally \\n\\n1.Change Trusted Sites \\nAdd or remove both the store domain and https://stdpay.inicis.com  \\n Internet Explorer Tools>Internet Options>Security (tab)>Trusted Sites>Sites (button). \\n\\n2.Check Pop-up Blocker \\nTools>Internet Options>Privacy (tab)> Disable Pop-up Blocker.\\n\\nPlease refresh the page after setting.' \r\n \t\t,alert_popup_check2 : 'Pop-up blocked. Please try again after disabling the pop-up blocker.'\r\n};\r\nvar INImsg_cn = {\r\n\t\ttitle\t\t\t:'KG INICIS'\r\n\t\t,title_mobil \t: 'KG Mobilians'\r\n\t\t\r\n\t\t,alert_confirm1:'是否取消支付？'\r\n\t\t,alert_msg3:'<b>交易(%d)超时。<br/><br/>交易将自动取消。</b>.'\r\n\t\t,alert_msg4:'<b>离交易结束还剩<span style=\"color:red;font-weight:bold;\">#1分钟</span>。</b><br/><br/>※如不在 #1分钟内完成交易，交易将被取消（交易时限：#2分钟以内）'\r\n\t\t,alert_msg5:'您当前使用的浏览器不支持本信用卡交易。<br/>（该卡无法在目前浏览器下使用，请使用 \\'Internet Explorer\\'浏览器）'\r\n\t\t,alert_msg9:'请正确输入邮箱地址。'\r\n\t\t,alert_msg10:'文件大小不符合iframe指定规格。[超过320x520]'\r\n\t\t,alert_msg11:'不支持手机支付。'\r\n\t\t,alert_msg12:'语言转换失败。'\r\n\t\t,alert_msg13:'请选择优惠券。'\r\n\t\t,alert_msg14:'未输入验证码。'\r\n\t\t,alert_msg15:'验证码错误。'\r\n\t\t,alert_card_msg1:'请选择卡类型。'\r\n\t\t,alert_card_msg2:'请选择分期付款类型。'\r\n\t\t,alert_card_msg3:'请输入卡号。'\r\n\t\t,alert_card_msg4:'请输入卡有效期。'\r\n\t\t,alert_card_msg5:'进行非认证交易。'\r\n\t\t,alert_card_msg6:'ISP呼叫发生错误。'\r\n\t\t,alert_card_msg7:'ISP Mobile APP验证失败。<br/>（请重试）。'\r\n\t\t,alert_card_msg8:'稍后即将运行ISP Mobile APP。'\r\n\t\t,alert_card_msg9:'请输入其他信息。'\r\n\t\t,alert_card_msg10:'30万韩元以上不可使用三星钱包。'\r\n\t\t,alert_card_msg11:'30万韩元以上不可使用Kpay。'\r\n\t\t,alert_card_msg12:'未满1,000韩元的金额不支持信用卡支付。请用其他方式支付。'\r\n\t\t,alert_card_msg13:'您所选的信用卡不支持分期付款。'\t\t\t\r\n\t\t  \r\n\t\t,alert_card_msg14:'您支付请求的卡无法使用在平昌奥运会。'\r\n\t\t,alert_card_msg16 : '货币代码错误，请咨询商户。'\r\n\t\t\r\n\t\t,alert_card_msg17 : function(str) {\r\n\t\t\treturn '不可使用积分，积分需在结算金额超过<b> '+ str +'</b>韩币(含<b> '+ str +'</b>韩币)时才可使用。';\r\n     \t}\r\n\t\t\r\n\t\t//애플페이 다이렉트 옵션 호출 시 미지원 브라우저 문구 출력\r\n\t\t,alert_card_msg18 : '您输入的付款方式无法在该浏览器中使用。<br/> 请输入其他付款方式'\r\n\t\t\r\n\t\t//해외카드 메시지\r\n\t\t,alert_card_msg19 : 'Please enter the cardholder name.'\r\n\t\t,alert_card_msg20 : 'Please enter the cardholer E-mail.'\r\n\t\t\r\n\t\t//해외카드 화면 빈체크 메시지 추가 250709\r\n\t\t,alert_card_msg21 : 'The selected card company and the entered card number do not match.'\r\n\t\t//해외카드 가상키패드 메시지 추가 250715\r\n\t\t,alert_card_msg22 : 'Please check the card number you entered again.'\r\n\t\t\t\r\n\t\t//이니안심 메시지\r\n\t\t,alert_kcare_msg1 : '선택 되어진 지불수단으로 이니안심서비스를 이용하실 수 없습니다.<br/>이니안심서비스 사용을 원하시면 다른 카드를 선택해주세요.'\r\n\t\t,alert_kcare_msg2 : '이니안심서비스 이용 시 할부결제를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg3 : 'Lpoint 사용 시 이니안심서비스를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg4 : '카드 포인트 사용 시 이니안심서비스를 이용할 수 없습니다.'\r\n\t\t,alert_kcare_msg5 : '이니안심서비스 이용 시 할부결제를 이용할 수 없습니다.<br/>이니안심서비스를 사용하시겠습니까?'\r\n\t\t,alert_kcare_msg6 : '이니안심서비스 사용 안내'\r\n\t\t,alert_kcare_msg7 : '이니포인트 이용 시 이니안심서비스를 사용하실 수 없습니다.'\r\n\t\t,alert_kcare_msg8 : '이니안심서비스 사용 시 Lpoint를 이용할 수 없습니다.'\r\n\t\t//이니안심 할부개월 추가로 인한 메시지 추가 250506\r\n\t\t,alert_kcare_msg9 : '선택하신 할부개월은 이니안심 서비스 이용이 불가합니다.'\r\n\t\t\t\r\n\t\t,alert_easyPay_msg1:'快捷支付ID不正确。'\r\n\t\t,alert_easyPay_msg2:'请输入快捷支付密码。'\r\n\t\t,alert_easyPay_msg3:'请选择分期付款类型。'\r\n\t\t,alert_easyPay_msg4:'请输入您用手机短信收到的验证码。'\r\n\t\t,alert_easyPay_msg5:'在处理快捷支付的过程中发生错误。<br/>请返回至登录页面重新登录。'\r\n\t\t,alert_easyPay_msg6:'请点击\\“发送验证码\\”，<br/>输入用手机短信收到的验证码。'\r\n\t\t,alert_easyPay_msg7:'验证码已发送至您的手机。<br/>请输入您收到的验证码。'\r\n\t\t,alert_easyPay_msg8:'无法使用您选择的优惠券。<br/>该优惠券仅适用于韩亚卡。<br/>由于您的快捷支付信息中没有韩亚卡，<br/>无法使用该优惠券。'\r\n\t\t,alert_easyPay_msg9:'无法使用您选择的优惠券。<br/>该优惠券仅适用于新韩卡。<br/>由于您的快捷支付信息中没有新韩卡，<br/>无法使用该优惠券。'\r\n\t\t,alert_easyPay_msg10:'<font color=\"#6799FF\" style=\"\"><b>快捷支付验证请求错误</b></font> <br/><br/> 由于以下原因快捷支付验证请求失败。<br/><br/>'\r\n\t\t,alert_point_msg1:'请输入ID。'\r\n\t\t,alert_point_msg2:'请输入密码。'\r\n\t\t,alert_point_msg3:'INIPOINT最多可使用交易金额的50%。'\r\n\t\t,alert_point_msg4:'请选择您要使用的积分。'\r\n\t\t,alert_point_msg5 : '포인트는 1포인트 이상 사용 가능합니다.'\r\n\t\t,alert_point_msg6 : '사용할 포인트를 확인 하십시오.'\r\n\t\t,alert_point_msg7 : '포인트를 조회하십시오.'\r\n\t\t,alert_point_msg8 : 'LPOINT와 쿠폰은 함께 사용할 수 없습니다.'\t\r\n\t\t,alert_hpp_msg1:'请选择通信运营商。'\r\n\t\t,alert_hpp_msg2:'请正确输入手机号。'\r\n\t\t,alert_hpp_msg3:'请正确输入身份证号。'\r\n\t\t,alert_hpp_msg4:'请同意通信收费服务条款，<br/>同意后才可进行交易。'\r\n\t\t,alert_hpp_msg5:'请输入您用手机短信收到的验证码。'\r\n\t\t,alert_hpp_msg6:'请确认身份证号后重新输入。'\r\n\t\t,alert_bank_msg1:'请选择转账银行。'\r\n\t\t,alert_bank_msg2:'请选择转账证券公司。'\r\n\t\t,alert_bank_msg3:'请选择现金收据用途。'\r\n\t\t,alert_bank_msg4:'请选择现金收据确认手段。'\r\n\t\t,alert_bank_msg5:'请输入现金发票发行号。'\r\n\t\t,alert_bank_msg6:'现金发票发行号位数不正确。'\r\n\t\t,alert_bank_msg7:'转账呼叫失败。'\r\n\t\t,alert_bank_msg8:'转账Mobile APP验证失败。'\r\n\t\t,alert_bank_msg9:'稍后即将运行转账Mobile APP'\r\n\t\t,alert_bank_msg10:'请选择户名。'\r\n\t\t,alert_bank_msg11:'只可输入韩文和英文。'\r\n\t\t,alert_bank_msg12:'请输入身份证号前位数。'\r\n\t\t,alert_bank_msg13:'请输入身份证号后位数。'\r\n\t\t,alert_bank_msg14:'只可输入数字。'\r\n\t\t,alert_bank_msg15:'请检查身份证号后重新输入。'\r\n\t\t,alert_bank_msg16:'请输入营业执照号第一位数。'\r\n\t\t,alert_bank_msg17:'请输入营业执照号第二位数。'\r\n\t\t,alert_bank_msg18:'请输入营业执照号第三位数。'\r\n\t\t,alert_bank_msg19:'请检查营业执照号后重新输入。'\r\n\t\t,alert_bank_msg20:'请输入数字。'\r\n\t\t,alert_bank_msg21 : '请输入汇款账号。'\r\n\t\t,alert_bank_msg22 : '请输入账号密码'\r\n\t\t,alert_bank_msg23 : '请输入身份证号前6位数，以便开具发票。'\r\n\t\t,alert_bank_msg24 : '请输入身份证号后7位位数，以便开具发票。'\r\n\t\t,alert_bank_msg25 : '请输入手机号，以便开具发票。'\r\n\t\t,alert_bank_msg26 : '请输入营业执照号，以便开具发票。'\r\n\t\t,alert_bank_msg27 : '输入有误，请重新输入身份证号，以便开具发票。'\r\n\t\t,alert_bank_msg28 : '输入有误，请重新输入营业执照号，以便开具发票。'\r\n\t\t,alert_bank_msg29 : '汇款人姓名只允许输入韩文和英文。<br>除“&”外可输入特殊字母。'\r\n\t\t,alert_bank_msg30 : '可输入10个韩文字符和20个英文字符。'\r\n\t\t,alert_bank_msg31 : '请输入卡号以便开具发票。'\r\n\t\t\t\r\n\t\t,alert_easybank_KBANK : '케이뱅크 페이란, 고객님의 케이뱅크 계좌에서 간편한 인증으로 결제되는 서비스입니다.'\r\n\t\t\t\r\n\t\t,alert_vbank_msg1:'请选择转账银行。'\r\n\t\t,alert_vbank_msg2:'请输入汇款人姓名。'\r\n\t\t,alert_vbank_msg3:'请选择现金收据用途。'\r\n\t\t,alert_vbank_msg4:'请选择现金收据确认手段。'\r\n\t\t,alert_vbank_msg5:'请输入现金发票发行号。'\r\n\t\t,alert_vbank_msg6:'现金发票发行号位数不正确。'\r\n\t\t,alert_vbank_msg7:'请正确输入身份证号。'\r\n\t\t,alert_vbank_msg8:'只可选择至28日。'\r\n\t\t,alert_vbank_msg9:'只可选择至30日。'\r\n\t\t,alert_vbank_msg10:'汇款时间不得早于今天。'\r\n\t\t,alert_vbank_msg11:'汇款时间自今日起最多不能超过9天。'\r\n\t\t,alert_vbank_msg12:'如从法人账户转账，只可开具支出凭证现金收据。'\r\n\t\t,alert_vbank_msg13:'请输入现金发票卡号以便开具发票。'\r\n\t\t,alert_vbank_msg14:'请输入手机号以便开具现金发票。'\t\r\n\t\t,alert_vbank_msg15: '결제정보 토스 안내를 위해 휴대폰번호를 입력해주세요.'\r\n\t\t,alert_vbank_msg16: '결제정보 토스 안내를 위해 내용에 동의해주세요.'\r\n\t\t,alert_vbank_msg17 : '请准确输入现金收据卡号。'\r\n\t\t,alert_vbank_msg18 : '请准确输入现金收据手机号。'\r\n\t\t\r\n\t\t,alert_okCash_msg1:'请正确输入Ok Cashbag卡号。'\r\n\t\t,alert_okCash_msg2:'<font color=\"#6799FF\" ><b>会员验证错误</b></font></br>※ 由于以下错误积分查询失败。</br>'\r\n\t\t,alert_okCash_msg4:'未找到可进行信用卡复合支付的款项。'\r\n\t\t,alert_okCash_msg5:'如欲进行信用卡复合支付，信用卡支付金额需超过1,000韩元。'\r\n\t\t,alert_okCash_msg6:'Ok Cashbag积分支付金额不可以为\"0\"，请重新输入。'\r\n\t\t,alert_okCash_msg7:'您输入的[欲使用金额]少于总交易金额。'\r\n\t\t,alert_okCash_msg8:'请以1000单位输入Ok Cashbag积分。'\r\n\t\t\t\r\n\t\t,alert_upt_msg1 : ' U-point最低使用金额为1000元。'\r\n\t\t\t\t\r\n\t\t,alert_gspt_msg1:' 您输入的[欲使用金额]少于总交易金额。'\r\n\t\t,alert_gspt_msg2:' GS&POINT不可以是“0”，请重新输入。'\r\n\t\t,alert_gspt_msg3:'如欲进行信用卡复合支付，信用卡支付金额需超过1,000韩元。'\r\n\t\t,alert_gspt_msg4:' 请以1000单位输入GS&POINT积分。'\r\n\t\t,alert_gspt_msg5:'须选择GS&POINT + 信用卡符合支付。<br/>请勾选信用卡符合支付。'\r\n\t\t,alert_gspt_msg6:'请输入GS&POINT ID。'\r\n\t\t,alert_gspt_msg7:'请输入GS&POINT密码。 '\r\n\t\t,alert_gspt_msg8:'未设置加盟店代码，<br/>请咨询加盟店管理员。'\r\n\t\t\r\n\t\t,alert_upnt_msg1:'请正确输入U-point卡号。'\r\n\t\t,alert_upnt_msg2: 'U-point 积分支付金额不可以为\"0\"，请重新输入。'\r\n\t\t\t\r\n\t\t,alert_mypt_msg1:'若积分不足5,000分，将无法使用积分。'\r\n\t\t,alert_mypt_msg2:'积分少于您要支付的金额。'\r\n\t\t\t\r\n\t\t,alert_gift_msg1:'请选择您要支付的商品券'\r\n\t\t\t\r\n\t\t,alert_culture_msg1:'请输入CULTURE LAND ID。'\r\n\t\t,alert_culture_msg2:'请输入CULTURE LAND 密码。'\r\n\t\t,alert_culture_msg3:'请输入文化商品券PIN码。'\r\n\t\t,alert_culture_msg4:'#1韩元商品券PIN号验证成功。<br/>在最后付款时可在充值的同时使用。'\r\n\t\t,alert_culture_msg5:'充值金额少于交易金额，<br/>CULTURE CASH余额和已充值的商品券金额的总和需大于交易金额。'\r\n\t\t,alert_culture_msg6 : '请登录CULTURE LAND.'\r\n\t\t,alert_hpmn_msg1:'请输入Happymoney ID。'\r\n\t\t,alert_hpmn_msg2:'请输入Happymoney密码。'\r\n\t\t,alert_hpmn_msg3:'请输入Happymoney商品券号。'\r\n\t\t,alert_hpmn_msg4:'请输入Happymoney商品券发行日期。'\r\n\t\t,alert_hpmn_msg5:'Happymoney充值成功。'\r\n\t\t,alert_sculture_msg1:'请正确输入商品券号。'\r\n\t\t,alert_sculture_msg2:'您输入的金额大于余额。'\r\n\t\t,alert_sculture_msg3:'余额不足。'\r\n\t\t,alert_sculture_msg4:'余额超出商品价格，系统已进行调整。<br/>余额可在下一环节确认。'\r\n\t\t,alert_cancel1:'您已取消本次交易。'\r\n\t\t,alert_isp_fail1:'ISP验证失败。'\r\n\t\t,alert_isp_fail2:'ISP模块处理失败。'\r\n\t\t,alert_ini_test1:'将切换至INIPOINT登录页面。'\r\n\t\t,alert_swallet_msg1:'在重新发送支付请求提醒前，请检查您的智能手机是否连接到网络。点击“确认”键，将重新发送支付请求。'\r\n\t\t,alert_swallet_msg2:'请正确输入手机号。'\r\n\t\t,alert_swallet_msg3:'请选择用于支付的设备。'\r\n\t\t,alert_swallet_msg4 : '请确认是否已注册BankWallet.'\r\n\t\t,alert_paypin_msg1:'在重新发送支付请求提醒前，请检查您的智能手机是否连接到网络。点击“确认”键，将重新发送支付请求。'\r\n\t\t,alert_paypin_msg2:'请正确输入手机号。'\r\n\t\t,alert_paypin_msg3:'未找到可在PayPin使用的支付方式。<br/>请咨询加盟店。'\r\n\t\t,alert_kpay_msg1:'在重新发送支付请求提醒前，请检查您的智能手机是否连接到网络。点击“确认”键，将重新发送支付请求。'\r\n\t\t,alert_kpay_msg2:'请正确输入手机号。'\r\n\t\t,alert_swallet_msg:'请正确输入手机号。'\r\n\t\t\t\r\n\t\t,alert_bankWallet_msg1:'验证码获取成功<br/><br/>成功获取验证码，<br/>请运行BankWallet APP输入验证码后进行交易。'\r\n\t\t,ale