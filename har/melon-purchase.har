#fff;width:400px;height:400px;margin:40px auto;padding:3px;border: 1px #D9DADB solid;background-color: white;-webkit-border-radius: 3px;-moz-border-radius: 3px;border-radius: 3px;}\r\n#overlay_subWapper .overlayFrame {background-color:#fff;border: none #ffff00 0px;display:block; left:0; top:0px;border: 1px #d9dadb solid;width:200px;height:150px;}\r\n.overlay_close:hover {color: black;text-decoration: none;cursor: pointer;opacity: 0.4;filter: alpha(opacity=40);}\r\n/* .overlay_close {float: right;font-size: 18px;font-weight: bold;line-height: 20px;color: black;text-shadow: 0 1px 0 white;opacity: 0.2;filter: alpha(opacity=20);padding: 0;cursor: pointer;background: transparent;border: 0;-webkit-appearance: none;} */\r\n.overlay_close {float: right;font-size: 18px;font-weight: bold;line-height: 14px;color: black;text-shadow: 0 1px 0 white;opacity: 0.2;filter: alpha(opacity=20);padding: 0;cursor: pointer;background: transparent;border: 0;-webkit-appearance: none;}\r\n \r\n.popup_close:hover {color: black;text-decoration: none;cursor: pointer;opacity: 0.4;filter: alpha(opacity=40);}\r\n.popup_close {float: right;font-size: 20px;font-weight: bold;line-height: 20px;color: black;text-shadow: 0 1px 0 white;opacity: 0.2;filter: alpha(opacity=20);padding: 8px 8px 0 0;cursor: pointer;background: transparent;border: 0;-webkit-appearance: none;}\r\n\r\n.overlay-header .close {margin-top: 5px;}\r\n.overlay-header h4 {margin: 0;line-height: 20px;clear:none;font-size: 13px;font-weight: bold;color: inherit;text-rendering: optimizelegibility;}\r\n.overlay-footer {margin: 0;line-height: 15px;clear:none;font-size: 13px;color: inherit;text-rendering: optimizelegibility;}\r\n\r\n#overlay_popup_bg {position: absolute;display:none;width:100%;height: 100%;background-color: #fff;opacity: 0;filter: alpha(opacity=1);z-index: 100;left: 0px;}\r\n#overlay_popup {position: absolute;display:none;z-index: 101;}\r\n\r\n#overlay_subPopup {margin:40px auto;-webkit-border-radius: 3px;-moz-border-radius: 3px;border-radius: 3px;}\r\n#overlay_subPopup .overlayFrame2 {background-color:#fff; left:0; top:0px; border: 1px #5592C4 solid;}/* border color 占쎈쐻占쎈윪占쎈�뉛옙�쐺獄쏆옓爾쎾뜝�럡�렊占쎈쐻占쎈윥占쎈듋�뜝�럥�뇢�솻洹⑥삕�뜝�럡�렊 */\r\n\r\n#overlay_popup_bg2{position: absolute;display:none;width:100%;height: 100%;background-color: #fff;opacity: 0;filter: alpha(opacity=1);z-index: 100;left: 0px;}\r\n#overlay_popup2{position: absolute;display:none;z-index: 101;width: 100%;left : 0px;}\r\n\r\n#overlay_subPopup2 {vertical-align: middle;background-color: #fff;width:400px;height:400px;margin:40px auto;border: 1px #D9DADB solid;background-color: white;-webkit-border-radius: 3px;-moz-border-radius: 3px;border-radius: 3px;}\r\n#overlay_subPopup2 .overlayFrame3 {background-color:#fff;border: none #ffff00 0px;display:block; left:0; top:0px;border: 1px #d9dadb solid;width:430px;height:440px;}\r\n\r\n#overlay_popup_bg3{position: absolute;display:none;width:100%;height: 100%;background-color: #fff;opacity: 0;filter: alpha(opacity=1);z-index: 100;left: 0px;}\r\n#overlay_popup3{position: absolute;display:none;z-index: 101;width: 100%; height:100%; left : 0px;}\r\n\r\n#overlay_subPopup3 {vertical-align: middle;background-color: transparent; width:100%; height:100%; }\r\n#overlay_subPopup3 .overlayFrame4 {background-color:#fff; border: 1px #d9dadb solid; display:block; width:400px; height:200px; border-radius : 5px; margin : 88px auto;}\r\n/*#overlay_subPopup3 .overlayFrame4 {background-color:#fff; border: 1px #d9dadb solid; display:block; width:480px; height:420px; border-radius : 5px; margin : 88px auto;}*/\r\n\r\n/*input text 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗�뜝�럥�맶�뜝�럥�쑅占쎈쐻占쎈짗占쎌굲占쎈쐻占쎈윪�뤃�먥뵾占쎌뒧鸚룸ŀ�쐻占쎈쓡�뜝�럩堉뷂옙�꼻�삕占쎈㎍�뜝�럥�맶占쎈쐻�뜝占� 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗占쎈쐻占쎈윥占쎈윛占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몗癲ル슢�뵯筌띿엺�젂占쎈쳟占쎌굲占쎌넂�뜝�룞�삕�뤃占�*/\r\n.giftTextBox {width: 135px; border:none;border-right:0px; border-top:0px; boder-left:0px; boder-bottom:0px;}\r\n\r\n/* 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌맽癲ル슢�뵯�뜝�룞�맊占쎈㎍占쎈쐻占쎈윥占쎌몗�뜝�럥�맶�뜝�럥�쑅�뤆�룆理됵옙堉�占쎈쐻占쎈짗占쎌굲�뜝�럩留뜹뜝�럥�맶占쎈쐻�뜝占� 占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝占