            "text": "var ispWin = '';\r\n///////////////////////////\r\n//결제수단 선택 이벤트\r\n///////////////////////////\r\nfunction setPayMethodBtnEvent(){\r\n\t//wcchoi\t\r\n\t//DESC: 포커스세팅, 왼쪽메뉴 탭인덱스 설정.\r\n\tvar settingLogoFocus = function(){\r\n\t\tisLogoFocus = true;\r\n\t};\r\n\t\r\n\r\n\t// 렌탈 서비스\r\n\tjQuery(document).on(\"click\",\".goRtPayBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"RTPAY\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//빌링\r\n\tjQuery(document).on(\"click\",\".goBillBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\tsetPaymethodView(\"Bill\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\r\n\t//에스크로 거래확인\r\n\tjQuery(document).on(\"click\",\".goEscrowConfBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\tsetEscrowView(\"escrowConf\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//에스크로 약관동의\r\n\tjQuery(document).on(\"click\",\".goEscrowBtn\", function(e){\r\n\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\tsetPaymethodView(\"escrow\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\r\n\t// 약관동의\r\n\tjQuery(document).on(\"click\",\".goAssentChkBtn\", function(e){\r\n\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\tsetPaymethodView(\"AssentChk\",\"payStart\", null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\r\n\t// 신용카드 \r\n\tjQuery(document).on(\"click\",\".goCardBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)){\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"Card\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\r\n\t// 실시간계좌이체\r\n\tjQuery(document).on(\"click\",\".goDirectBankBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tvar dboption = $payForm.find(\"input[name=dboption]\").val();\r\n\t\t\tif(dboption == \"1\"){\r\n\t//\t\t\tcallAlert(\"죄송합니다. i계좌이체는 현재 준비중에 있습니다. 빠른 시일내에 완료하도록 하겠습니다.\");\r\n\t//\t\t\treturn false;\r\n\t\t\t\tsetPaymethodView(\"iDirectBank\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}else{\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"DirectBank\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 실시간계좌이체 - 뱅크페이\r\n\tjQuery(document).on(\"click\",\".goBPDirectBankBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"BPDirectBank\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 휴대폰\r\n\tjQuery(document).on(\"click\",\".goHppBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tsettingLogoFocus();\r\n\t\tsetPaymethodView(\"HPP\",\"payStart\",null);\r\n\t\tselectPaymethodtBtn(this);\r\n\t});\r\n\t\r\n\t// 무통장입금\r\n\tjQuery(document).on(\"click\",\".goVbankBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"VBank\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\r\n\t// 간편결제\r\n\tjQuery(document).on(\"click\",\".goEasyPayBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"EasyPay\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\r\n\t// 전화결제\r\n\tjQuery(document).on(\"click\",\".goPhoneBillBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"PhoneBill\",\"payStart\", null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\r\n\t// 포인트결제\r\n\tjQuery(document).on(\"click\",\".goPOINTBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tvar payMethod =  jQuery(\"#POINT\").val();\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tif(payMethod == '1'){\r\n\t\t\t\tsetPaymethodView(\"Point\",\"payStart\",null);\r\n\t\t\t}\r\n\t\t\tif(payMethod == '2'){\r\n\t\t\t\tsetPaymethodView(\"OCBPoint\",\"payStart\",null);\r\n\t\t\t}\r\n\t\t\tif(payMethod == '3'){\r\n\t\t\t\tsetPaymethodView(\"GSPT\",\"payStart\",null);\r\n\t\t\t}\r\n\t\t\tif(payMethod == '4'){\r\n\t\t\t\tsetPaymethodView(\"UPNT\",\"payStart\",null);\r\n\t\t\t}\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 상품권\r\n\tjQuery(document).on(\"click\",\".goGiftCardBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"Gift\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 전자지갑\r\n\tjQuery(document).on(\"click\",\".goEWalletBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"Ewallet\",\"payStart\", null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 문화상품권\r\n\tjQuery(document).on(\"click\",\".goCultureBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"Culture\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\tjQuery(document).on(\"click\",\".goHpmnBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"HPMN\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//스마트 상품권\r\n\tjQuery(document).on(\"click\",\".goSCultureBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"SCulture\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t// Kpay\r\n\tjQuery(document).on(\"click\",\".goKpayBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"Kpay\",\"payStart\", null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 포인트\r\n\tjQuery(document).on(\"click\",\".goMypointBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"Mypoint\",\"payStart\", null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//SSGPay 계좌이체 20161213\r\n\tjQuery(document).on(\"click\",\".goSSGDirectBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"SSGDirectbank\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//SSGPay 카드 20170411\r\n\tjQuery(document).on(\"click\",\".goSSGCardBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"SSGCard\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//SSGPay 머니 20180315\r\n\tjQuery(document).on(\"click\",\".goSSGMoneyBtn\", function(e){\r\n\t\tselectMenuId = this.id;\r\n\t\t\r\n\t\tif(assentValidation(this)) {\r\n\t\t\tsettingLogoFocus();\r\n\t\t\tsetPaymethodView(\"SSGMoney\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t//엔터키입력했을때 \r\n\t//2016.05.19  WCCHOI\r\n\t//DESC :엔터키입력했을때 - 빌링 \r\n\t$(document).on(\"keydown\",'.goBillBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Bill\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 에스크로 거래확인 \r\n\t$(document).on(\"keydown\",'.goEscrowConfBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"escrowConf\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 에스크로 약관동의 \r\n\t$(document).on(\"keydown\",'.goEscrowBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\t\tsetPaymethodView(\"escrow\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 -  약관동의 \r\n\t$(document).on(\"keydown\",'.goAssentChkBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\tif(!jQuery(this).hasClass(\"on\")){\r\n\t\t\t\tsetPaymethodView(\"AssentChk\",\"payStart\", null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 신용카드 \r\n\t$(document).on(\"keydown\",'.goCardBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)){\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Card\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 실시간계좌이체 \r\n\t$(document).on(\"keydown\",'.goDirectBankBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tvar dboption = $payForm.find(\"input[name=dboption]\").val();\r\n\t\t\t\tif(dboption == \"1\"){\r\n\t//\t\t\t\tcallAlert(\"죄송합니다. i계좌이체는 현재 준비중에 있습니다. 빠른 시일내에 완료하도록 하겠습니다.\");\r\n\t//\t\t\t\treturn false;\r\n\t\t\t\t\tsetPaymethodView(\"iDirectBank\",\"payStart\",null);\r\n\t\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tsettingLogoFocus();\r\n\t\t\t\t\tsetPaymethodView(\"DirectBank\",\"payStart\",null);\r\n\t\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 실시간계좌이체 - 뱅크페이\r\n\tjQuery(document).on(\"keydown\",\".goBPDirectBankBtn\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\tselectMenuId = this.id;\r\n\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"BPDirectBank\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\t\r\n\t//DESC :엔터키입력했을때 - 휴대폰 \r\n\t$(document).on(\"keydown\",'.goHppBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tsettingLogoFocus();\t\t\t\r\n\t\t\tsetPaymethodView(\"HPP\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(this);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 무통장입금 \r\n\t$(document).on(\"keydown\",'.goVbankBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tsetPaymethodView(\"VBank\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 간편결제 \r\n\t$(document).on(\"keydown\",'.goEasyPayBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"EasyPay\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 전화결제 \r\n\t$(document).on(\"keydown\",'.goPhoneBillBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"PhoneBill\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 포인트결제 \r\n\t$(document).on(\"keydown\",'.goPOINTBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tvar payMethod =  $(\"#POINT\").val();\r\n\t\tvar pointValue = \"Point\";\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tswitch (payMethod){\r\n\t\t\t\t\tcase '1':\r\n\t\t\t\t\t\tpointValue = \"Point\";\r\n\t\t\t\t\t    break;\r\n\t\t\t\t\tcase '2':\r\n\t\t\t\t\t\tpointValue = \"OCBPoint\";\r\n\t\t\t\t\t    break;\r\n\t\t\t\t\tcase '3':\r\n\t\t\t\t\t\tpointValue = \"GSPT\";\r\n\t\t\t\t\t    break;\r\n\t\t\t\t\tcase '4':\r\n\t\t\t\t\t\tpointValue = \"UPNT\";\r\n\t\t\t\t\t    break;\r\n\t\t\t\t\tdefault:\r\n\t\t\t\t\t\tpointValue = \"Point\";\r\n\t\t\t\t}\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(pointValue,\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 상품권 \r\n\t$(document).on(\"keydown\",'.goGiftCardBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Gift\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 전자지갑 \r\n\t$(document).on(\"keydown\",'.goEWalletBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Ewallet\",\"payStart\", null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 문화상품권 \r\n\t$(document).on(\"keydown\",'.goCultureBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Culture\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때  \r\n\t$(document).on(\"keydown\",'.goHpmnBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"HPMN\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - 스마트 상품권 \r\n\t$(document).on(\"keydown\",'.goSCultureBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"SCulture\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - Kpay \r\n\t$(document).on(\"keydown\",'.goKpayBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Kpay\",\"payStart\", null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - Swallet \r\n\t$(document).on(\"keydown\",'.goSwalletBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Swallet\",\"payStart\", null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - Paypin \r\n\t$(document).on(\"keydown\",'.goPaypinBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Paypin\",\"payStart\", null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - Paypin \r\n\t$(document).on(\"keydown\",'.goMypointBtn', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"Mypoint\",\"payStart\", null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :엔터키입력했을때 - SSGPay \r\n\t$(document).on(\"keydown\",'.SSGDirectbank', function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tselectMenuId = this.id;\r\n\t\t\t\r\n\t\t\tif(!jQuery(this).hasClass(\"on\") && assentValidation(this)) {\r\n\t\t\t\tsettingLogoFocus();\r\n\t\t\t\tsetPaymethodView(\"SSGDirectbank\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(this);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t//wccchoi\r\n\t//2016.06.23  \r\n\t//DESC :맨처음화면에서 엔터를 쳤을떄 이벤트 막기\r\n\t$('#inputFocus').on(\"keypress keydown keyup\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t}\r\n\t});\r\n\t//wcchoi\r\n\t//2016.06.23 \r\n\t//DESC :맨처음화면에서 엔터를 쳤을떄 이벤트 막기\r\n\t$('#inputLogo').on(\"keypress keydown keyup\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t}\r\n\t});\r\n} //if\r\nfunction selectPaymethodtBtn(obj){\r\n\t//이노시스 웹접근성 개선으로 인하여 선택된 결제수단 title 선택됨 추가 250224\r\n\tjQuery(\".payMethodSelecBtn\").each(function(){\r\n\t\tjQuery(this).attr(\"title\", \"\");\r\n\t});\r\n\r\n\tjQuery(\".payMethodSelecBtn\").removeClass(\"on\");\r\n\tjQuery(obj).addClass(\"on\");\r\n\tjQuery(\"#autoCouponFlag\").val(\"N\"); //자동으로 쿠폰사용 팝업 FLAG 초기화\r\n\t\r\n\tvar selectId = jQuery(obj).attr(\"id\");\r\n\tjQuery(\"#\"+selectId).attr(\"title\", jQuery(\"#\" + selectMenuId).find(\"a span\").text().replace(/[\\n\\t]+/g, \"\") + \" 선택됨\");\r\n}\r\n\r\n// 에스크로/결제서비스 이용약관 동의 여부 검증_2017.03.02_kyb\r\nfunction assentValidation(obj) {\r\n\tvar currency = $(\"input:hidden[name=currency]\").val();\r\n\t/*\r\n\t * 리뉴얼 화면과 나머지 결제의 이용약관 동의 방식이 달라서 구분 처리\r\n\t * 기존 : 에스크로 동의 -> 이용약관 동의 -> 결제화면\r\n\t * 리뉴얼 : 에스크로 동의 -> 이용약관 동의 + 결제화면\r\n\t * 리뉴얼 완료 후 else 부분 삭제\r\n\t */\r\n\tif(selectMenuId == \"Card\" || selectMenuId == \"GiftCard\") {\r\n\t\tif(!isEscrowChk) { // 에스크로 동의\r\n\t\t\tsetPaymethodView(\"escrow\",\"payStart\",null);\r\n\t\t\tselectPaymethodtBtn(obj);\r\n\t\t\treturn false;\r\n\t\t} else if(isFlgUseProvision) { // 기준정보에서 제공해 준 약관 동의 사용안함 상태일 때\r\n\t\t\tisAssentChk = true;\r\n\t\t} else if(!jQuery(obj).hasClass(\"on\")) { // 다른메뉴에서 진입 할 때\r\n\t\t\tisAssentChk = false;\r\n\t\t} else if(!isFlgUseProvision) { // 기준정보에서 제공해 준 약관 동의 사용 상태일 때\r\n\t\t\tisAssentChk = false;\r\n\t\t}\r\n\t} else {\r\n\t\tif(currency != \"USD\") {\r\n\t\t\tif(!isEscrowChk) {\r\n\t\t\t\tsetPaymethodView(\"escrow\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(obj);\r\n\t\t\t\treturn false;\r\n\t\t\t} else if(isFlgUseProvision) { // 기준정보에서 제공해 준 약관 동의 사용안함 상태일 때\r\n\t\t\t\tisAssentChk = true;\r\n\t\t\t} else if(!isAssentChk) {\r\n\t\t\t\tsetPaymethodView(\"AssentChk\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(obj);\r\n\t\t\t\treturn false;\r\n\t\t\t} else if(!jQuery(obj).hasClass(\"on\")) {\r\n\t\t\t\tisAssentChk = false;\r\n\t\t\t\tsetPaymethodView(\"AssentChk\",\"payStart\",null);\r\n\t\t\t\tselectPaymethodtBtn(obj);\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\r\n\treturn true;\r\n}\r\n\r\n////////////////////////////////////////////////////////////////////////////////////////////////\r\n//공통 이벤트\r\n////////////////////////////////////////////////////////////////////////////////////////////////\r\nfunction setCommonBtnEvent(){\r\n\t// 뒤로 버튼\r\n\tjQuery(document).on(\"click\",\".prevBtn\", function(){\r\n\t\tif('PointCard'==$payForm.find(\"input[name=selectPayMethod]\").val()){\r\n\t\t\t\t$payForm.find(\"input[name=selectPayMethod]\").val()\r\n\t\t\tsetPaymethodView($payForm.find(\"input[name=selectPayMethod]\").val(),\"payStart\", null);\r\n\t\t}else{\r\n\t\t\tsetPaymethodView($payForm.find(\"input[name=selectPayMethod]\").val(),\"payStart\", null);\r\n\t\t}\r\n\t});\r\n\t// 취소 버튼\r\n\tjQuery(document).on(\"click\",\".cancelBtn\", function(){\r\n\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\tshowLoading();\r\n\t\tvar mobilians = $(\"#mobilians\").val();\r\n\t\tvar title = INImsg.title;\r\n\t\t\r\n\t\tif(mobilians === 'true'){\r\n\t\t\ttitle = INImsg.title_mobil\r\n\t\t}\r\n\t\t\t\r\n\t\tjConfirm(INImsg.alert_confirm1, title, function(r) {\r\n\t\t\tif(r){\r\n\t\t\t\t\tif(closeUrl.length > 0 && (\"overlay\" == $payForm.find(\"[name=payViewType]\").val())){\r\n\t\t\t\t\t\t//$payForm.find(\"[name=payViewType]\").val(\"iframe\");\t\t// 취소 스크립트 페이지가 새창으로 뜨는것 방지\r\n\t\t\t\t\t\thistoryUpdateClose(closeUrl,\"overlay\");\r\n\t\t\t\t\t\t//location.href = closeUrl;\r\n\t\t\t\t\t}else if(\"popup\" == $payForm.find(\"[name=payViewType]\").val()){\r\n\t\t\t\t\t\thistoryUpdateClose(closeUrl,\"popup\");\r\n\t\t\t\t\t\t//self.close();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tcallReturnSubmit(\"/payMain/cancel\");\r\n\t\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\t\thideLoading();\r\n\t\t\t}\r\n\t\t});\r\n\t});\r\n\t//wcchoi\r\n\t//2016.06.22\r\n\t//취소버튼 엔터키 눌렀을때 \r\n\t//DESC : 셀렉트 버튼에서 엔터를 눌렀을떄 이벤트, 탭키를 눌렀을때 이벤트.\r\n\t$(document).on(\"keydown\",\".cancelBtn\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){ //enter key.\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\tshowLoading();\r\n\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\tjConfirm(INImsg.alert_confirm1, INImsg.title, function(r) {\r\n\t\t\t\tif(r){\r\n\t\t\t\t\t\tif(closeUrl.length > 0 && (\"overlay\" == $payForm.find(\"[name=payViewType]\").val())){\r\n\t\t\t\t\t\t\t//$payForm.find(\"[name=payViewType]\").val(\"iframe\");\t\t// 취소 스크립트 페이지가 새창으로 뜨는것 방지\r\n\t\t\t\t\t\t\thistoryUpdateClose(closeUrl,\"overlay\");\r\n\t\t\t\t\t\t\t//location.href = closeUrl;\r\n\t\t\t\t\t\t}else if(\"popup\" == $payForm.find(\"[name=payViewType]\").val()){\r\n\t\t\t\t\t\t\thistoryUpdateClose(closeUrl,\"popup\");\r\n\t\t\t\t\t\t\t//self.close();\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tcallReturnSubmit(\"/payMain/cancel\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\t\thideLoading();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}else if (9 == keycode && true == e.shiftKey) { //tab + shift key.\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tvar inputFocus = $(this).parent().parent().find('.bottomBtn');\r\n\t\t\tvar length = inputFocus.length;\r\n\t\t\tif (length > 0) {\r\n\t\t\t\tsetTimeout(function(){\r\n\t\t\t\t\tinputFocus.focus();\r\n\t\t\t\t}, 100);\r\n\t\t\t}\r\n        }else if(9 == keycode){   //tab Key.\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\r\n\t\t\t//가맹점 웹접근성 개선으로 인하여 기존 spanLogo focus 주석처리\r\n\t\t\t//250224 로고 포커싱 주석처리 해제\r\n\t\t\t/*\r\n\t\t\tvar inputFocus = $(this).parent().parent().find('#spanLogo');\r\n\t\t\tvar length = inputFocus.length;\r\n\t\t\tif (length > 0) {\r\n\t\t\t\tsetTimeout(function(){\r\n\t\t\t\t\tinputFocus.focus();\r\n\t\t\t\t}, 100);\r\n\t\t\t}\r\n\t\t\t*/\r\n\t\t\t\r\n\t\t\r\n\t\t\t/* 250224 이노디스 웹접근성 개선으로 결제창 메인 포커싱 주석처리\r\n\t\t\tvar mainFocus = $(document.getElementById(\"popWrapLogo\"));\r\n\t\t\tvar mainLength = mainFocus.length;\r\n\t\t\tif(mainLength > 0){\r\n\t\t\t\tsetTimeout(function(){\r\n\t\t\t\t\tmainFocus.focus();\r\n\t\t\t\t}, 100);\r\n\t\t\t}\r\n\t\t\t*/\r\n\t\t\t\r\n\t\t\t//251119 가맹점 웹접근성으로 추가\r\n\t        var selectMenuId = jQuery(\"#payMethodViewDiv\").find(\".payMethodSelecBtn:not(.hide)\").eq(0).attr(\"id\");    \r\n\t        var inputFocus = $(\"#payMethodViewDiv\").find('#'+selectMenuId); //가맹점 웹접근성 수정요청으로 결제창 호출 후 왼쪽 상단 결제수단 탭으로 포커싱 되게끔 수정 251119 \r\n\t\t\tvar btnLength = inputFocus.length;\r\n\t\t\tif(btnLength > 0){\r\n\t\t\t\tsetTimeout(function(){\r\n\t\t\t\t\tinputFocus.focus();\r\n\t\t\t\t}, 100);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\r\n\t//결제창 테두리 div\r\n\t$(document).on(\"keydown\", \"#popWrapLogo\", function(e){\r\n\r\n\t\t//결제창 테두리 focus 되어 있을 때 \r\n\t\tif(document.activeElement.id == \"popWrapLogo\"){\r\n\t\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\t\tif(9 == keycode && true == e.shiftKey){\r\n\t\t\t\te.stopPropagation();\r\n\t\t\t\te.preventDefault();\r\n\t\t\t\t\r\n\t\t\t\tvar mainFocus = $(this).parent().parent().find(\"#btnCancel\");\r\n\t\t\t\tvar length = mainFocus.length;\r\n\t\t\t\tif(length > 0){\r\n\t\t\t\t\tsetTimeout(function(){\r\n\t\t\t\t\t\tmainFocus.focus();\r\n\t\t\t\t\t}, 100);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t$(document).on(\"keydown\",\"#spanLogo\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode && true == e.shiftKey) { //tab + shift key.\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tvar inputFocus = $(this).parent().parent().find('#btnCancel');\r\n\t\t\tvar length = inputFocus.length;\r\n\t\t\tif (length > 0) {\r\n\t\t\t\tsetTimeout(function(){\r\n\t\t\t\t\tinputFocus.focus();\r\n\t\t\t\t}, 100);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t$(document).on(\"keydown\", $(\"#payMethodViewDiv\").find('#'+jQuery(\"#payMethodViewDiv\").find(\".payMethodSelecBtn:not(.hide)\").eq(0).attr(\"id\")), function(e){\r\n\t\t//251119 가맹점 웹접근성으로 추가\r\n\t\tvar selectMenuId = jQuery(\"#payMethodViewDiv\").find(\".payMethodSelecBtn:not(.hide)\").eq(0).attr(\"id\");    \r\n\t\t\r\n\t\tif(document.activeElement.id == selectMenuId){\r\n\t\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\t\tif(9 == keycode && true == e.shiftKey){\r\n\t\t\t\te.stopPropagation();\r\n\t\t\t\te.preventDefault();\r\n\t\t\t\t\r\n\t\t\t\tvar mainFocus = $(this).find(\"#btnCancel\");\r\n\t\t\t\tvar length = mainFocus.length;\r\n\t\t\t\tif(length > 0){\r\n\t\t\t\t\tsetTimeout(function(){\r\n\t\t\t\t\t\tmainFocus.focus();\r\n\t\t\t\t\t}, 100);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t\r\n\t// 결제 확정\r\n\tjQuery(document).on(\"click\",\"#payDoneBtn\", function(){\r\n\t\tshowLoading();\r\n\t\t//계좌이체, 문화상품권 결제동의(donechk)\r\n\t\tvar selectPayMethod = $payForm.find(\"[name=selectPayMethod]\").val();\r\n\t\t\r\n\t\tif(selectPayMethod == 'DirectBank' || selectPayMethod == 'iDirectBank' || selectPayMethod == 'Culture'){\r\n\t\t\r\n\t\t\tvar donechk = false;\r\n\t\t\tvar acceptMethod = ($payForm.find(\"[name=acceptmethod]\").val());\r\n\t\t\r\n\t\t\tif(acceptMethod.indexOf(\"donechk\") > -1){\r\n\t\t\t\tdonechk = true;\r\n\t\t\t}\r\n\r\n\t\t\tif(donechk){\r\n\t\t\t\tif(!($(\"#donechk\").prop(\"checked\"))) {// 개인정보의 수집 및 이용안내\r\n\t\t\t\t\tcallAlert(INImsg.alert_done_msg1);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t//===\r\n\t\tvar check = $payForm.find(\"[name=checkEmail]\").val();\t\t\r\n\t\tif(check == 'false'){\r\n\t\t\tvar custEmail = jQuery.trim($payForm.find(\"input[name=custEmail]\").val());\r\n\t\t\t//이메일 값이 있을경우에만 체크\r\n\t\t\tif(custEmail != \"\"){\r\n\t\t\t\tvar emailReg = new RegExp(/^((([a-z]|\\d|[!#\\$%&'\\*\\+\\-\