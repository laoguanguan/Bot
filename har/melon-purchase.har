"ko\"){\r\n\t\t\t\t\t\t\tstrDt = '<a href=\"#\" class=\"' + quotaBaseArray[i-1] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">0' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i-1]) + '개월</span></a>';\r\n\t\t\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\t\t\tstrDt = '<a href=\"#\" class=\"' + quotaBaseArray[i-1] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">0' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i-1]) + 'Month</span></a>';\r\n\t\t\t\t\t\t}else if(languageView == \"cn\"){\r\n\t\t\t\t\t\t\tstrDt = '<a href=\"#\" class=\"' + quotaBaseArray[i-1] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">0' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i-1]) + '个月</span></a>';\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t$(\"#cardQuotaView .dropdown dt\").append(strDt);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(languageView == \"ko\"){\r\n\t\t\t\t\t\tstr = '<li><a href=\"#\" class=\"' + quotaBaseArray[i-1] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i-1]) + '개월</span></a></li>';\r\n\t\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\t\tstr = '<li><a href=\"#\" class=\"' + quotaBaseArray[i-1] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i-1]) + 'Month</span></a></li>';\r\n\t\t\t\t\t}else if(languageView == \"cn\"){\r\n\t\t\t\t\t\tstr = '<li><a href=\"#\" class=\"' + quotaBaseArray[i-1] + '\" tabIndex=\"' + tabIndexNext + '\"><span class=\"value\">' + quotaBaseArray[i-1] + '</span><span>' + Number(quotaBaseArray[i-1]) + '个月 </span></a></li>';\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t}\r\n\t\t\t\t$(\"#cardQuotaView .dropdown ul\").append(str);\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\tfor(var i=0;i<array.length;i++){\r\n\t\t\tvar q1 = array[i];\r\n\t\t\t\r\n\t\t\tif(jQuery.trim(q1).length > 0){\r\n\t\t\t\t// 선택 카드에 따른 무이자 표시\r\n\t\t\t\tif(cardCode == q1.split(\"-\")[0]){\r\n\t\t\t\t\tvar array2 = q1.split(\"-\")[1].split(\":\");\r\n\t\t\t\t\t\r\n\t\t\t\t\tfor(var j=0; j < array2.length;j++){\r\n\t\t\t\t\t\tvar q2 = array2[j];\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tif(jQuery.trim(q2).length > 0){\r\n\t\t\t\t\t\t\tvar optionDt ='';\r\n\t\t\t\t\t\t\tvar optionLi ='';\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tif(q2.length ==1){\r\n\t\t\t\t\t\t\t\toptionDt = $payForm.find(\"#cardQuotaView dt > a.0\" + q2 + \" span:eq(1)\");\r\n\t\t\t\t\t\t\t\toptionLi = $payForm.find(\"#cardQuotaView li > a.0\" + q2 + \" span:eq(1)\");\r\n\t\t\t\t\t\t\t}else if(q2.length >1){\r\n\t\t\t\t\t\t\t\toptionDt = $payForm.find(\"#cardQuotaView dt > a.\" + q2 + \" span:eq(1)\");\r\n\t\t\t\t\t\t\t\toptionLi = $payForm.find(\"#cardQuotaView li > a.\" + q2 + \" span:eq(1)\");\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t// 중복 체크\r\n\t\t\t\t\t\t\tif(optionLi.find(\"img.cardNoInterestText\").size() <=0 ){\r\n\t\t\t\t\t\t\t\toptionDt.append(cardNoInterestText);\r\n\t\t\t\t\t\t\t\toptionLi.append(cardNoInterestText);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t//슬림무이자 설정\r\n\t\tvar cardSlimInterestText =\"\";\r\n\t\tif(languageView == \"ko\"){\r\n\t\t\tcardSlimInterestText = \"<img class='cardSlimInterestText flag' src='\" + imgPath + \"/img/slim.jpg' alt='슬림'/>\";\r\n\t\t}else if(languageView == \"en\"){\r\n\t\t\tcardSlimInterestText = \"<img class='cardSlimInterestText flag' src='\" + imgPath + \"/img/slim.jpg' alt='슬림'/>\";\r\n\t\t}else if(languageView == \"cn\"){\r\n\t\t\tcardSlimInterestText = \"<img class='cardSlimInterestText flag' src='\" + imgPath + \"/img/slim.jpg' alt='슬림'/>\";\r\n\t\t}\r\n\t\t\r\n\t\tvar list= $payForm.find(\"[name=slimNoInterestList]\").val();\r\n\t\tif(list!=null){\r\n\t\t\tvar slimArray = list.split(\",\");\r\n\t\t\tfor(var i=0;i<slimArray.length;i++){\r\n\t\t\t\tvar q1 = slimArray[i];\r\n\t\t\t\tif(jQuery.trim(q1).length > 0){\r\n\t\t\t\t\t// 선택 카