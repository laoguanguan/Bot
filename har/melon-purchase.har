            "text": "@charset \"utf-8\";\r\n\r\n/* 범용창 팝업 css */\r\n @supports(-webkit-appearance: none) or (-moz-appearance: none) {\r\n   .lpointPopLayer .radio {\r\n\t\t-webkit-appearance: none;\r\n\t\t-moz-appearance: none;\r\n\t\tbackground: #fff;\r\n\t\tborder: 1px solid #909090;\r\n\t\tborder-radius: 50%;\r\n\t\tcursor: pointer;\r\n\t\twidth: 18px;\r\n\t\theight: 18px;\r\n   }\r\n\r\n   .lpointPopLayer label .radio:checked::after {\r\n\t\tposition: absolute;\r\n\t\tborder: 0;\r\n\t\tcontent: '';\r\n\t\tdisplay: block;\r\n\t\ttop: 50%;\r\n\t\tleft: 50%;\r\n\t\tmargin: -6px 0 0 -6px;\r\n\t\twidth: 12px;\r\n\t\theight: 12px;\r\n\t\tborder-radius: 50%;\r\n\t\tbackground: rgb(0 155 250);\r\n\t\tborder-color: rgb(0 155 250);\r\n   }\r\n}\r\n\r\n.lpointPopLayer .radio_wrap {\r\n\tcursor: pointer;\r\n}\r\n\r\n.lpointPopLayer .radio_txt {\r\n\tdisplay: inline-block;\r\n\tfont-size: 12px;\r\n\tcolor: #111;\r\n\tfont-weight: 400;\r\n\tpadding: 4px;\r\n}\r\n\r\n.lpointPopLayer .radio:focus~.radio_wrap {\r\n\t/* box-shadow: 0 0 0 2px #909090; */\r\n\toutline: 2px;\r\n}\r\n\r\n\r\n.lpointPopLayer .radio:checked~.radio_wrap .radio_txt {\r\n\tfont-weight: 600;\r\n}\r\n\r\n.lpointPopLayer .radio:disabled~.radio_wrap {\r\n\tcolor: #111;\r\n\tcursor: default;\r\n}\r\n\r\n.lpointPopLayer .radio:disabled~.radio_wrap .radio_txt {\r\n\tcolor: #111;\r\n\tfont-weight: 400;\r\n}\r\n\r\n\r\n.lpoint_con {\r\n\tpadding: 0 0 5px 0;\r\n}\r\n\r\n.lpoint_con h2 {\r\n\tfont-size: 13px;\r\n\tpadding: 5px 10px;\r\n\tdisplay: inline-block;\r\n}\r\n\r\n.lpoint_con .lpoint_type {\r\n\tdisplay: flex;\r\n\tjustify-content: space-between;\r\n}\r\n\r\n.lpoint_con .lpoint_type li {\r\n\tpadding: 5px 2px;\r\n\twidth: 100%;\r\n\tposition: relative;\r\n}\r\n\r\n\r\n.lpoint_type label .radio {\r\n\tposition: absolute;\r\n\tmargin: 0;\r\n\tright: 20px;\r\n\ttop: 22px;\r\n}\r\n\r\n.lpoint_type .radio_wrap {\r\n\tborder: 1px solid #909090;\r\n\tborder-radius: 10px;\r\n\tpadding: 4px 0 4px 20px;\r\n\tdisplay: flex;\r\n\tflex-direction: row;\r\n\talign-items: center;\r\n\tbox-sizing: border-box;\r\n}\r\n\r\n.lpoint_con .radio_txt {\r\n\ttext-align: center;\r\n}\r\n\r\n.lpoint_type .radio:checked~.radio_wrap {\r\n\tborder-color: rgb(0 155 250);\r\n}\r\n\r\n.lpointPopLayer {\r\n\tdisplay: inline-table;\r\n\twidth: 300px;\r\n\tmargin: -135px 0 0 -220px;\r\n\tpadding: 20px;\r\n\tfont-family: 'NanumGothic','sans-serif';\r\n\tfont-size: 12px;\r\n\tborder: 1px solid #CCC;\r\n}\r\n\r\n.topLayer {\r\n\tdisplay:inline-block;\r\n\tmargin:0;\t\r\n}\r\n\r\n#tableLayer {\r\n\twidth: 100%;\r\n\tmargin: 0;\r\n\tborder-collapse: collapse;\r\n\tborder-top: 1px solid #dbdbdb;\r\n\tbackground-color: white;\r\n\tdisplay: table;\r\n\tborder-spacing: 2px;\r\n}\r\n\r\n#tableLayer tbody, #directTableLayer tbody, #lpPointLayer tbody, #lpPlPointSect tbody {\r\n\tdisplay: table-row-group;\r\n\tvertical-align: middle;\r\n\tborder-color: inherit;\r\n}\r\n\r\n.lPtxtL {\r\n\tpadding: 5px 5px 3px 10px;\r\n\ttext-align:left;\r\n\tcolor: #666;\r\n\tbackground: #f5f5f5;\r\n\tvertical-align: middle;\r\n\twidth:60px;\r\n\tborder-bottom: 1px solid #dbdbdb;\r\n}\r\n\r\n.lPtxtB {\r\n    padding: 3px 0 3px 10px;\r\n    height: 22px;\r\n    background: #fff;\r\n    color: #555;\r\n    border-bottom: 1px solid #dbdbdb;\r\n}\r\n\r\n.hyphen {\r\n\tpadding:0 2px;\r\n}\r\n\r\n\r\n.lPtxtB input[type=text], .lPtxtB input[type=password] {\r\n\twidth:30px;\r\n\tpadding:1px 5px;\r\n}\r\n\r\n\r\n#lCardPw, #lDCardPw {\r\n\tpadding:1px 5px;\r\n\twidth:120px;\r\n\tmargin-top:1px;\r\n}\r\n\r\n.lCardPwSpan {\r\n\tmargin:1px 0 0 4px;\r\n\toverflow: hidden;\r\n\tdisplay:inline-block;\r\n\tfont-size:11px;\r\n\tline-height:17px;\r\n\tpadding: 2px 14px;\r\n\tcolor: #fff;\r\n\tbackground: #acacac;\r\n\tvertical-align: top;\r\n\ttext-align:center;\t\r\n}\r\n\r\n#lpPlLinkSect {\r\n\tdisplay: inline-block;\r\n\tmargin: 3px 0;\r\n}\r\n\r\n#lpPlLinkSect a {\r\n\tmargin: 8px 0px;\r\n\tcolor: #f2310b;\r\n\tfont: text-decoration: underline italic bold 14px/30px Georgia, serif;\r\n}\r\n\r\n#lpPlPointSect {\r\n\tdisplay:none;\r\n\tmargin:0px 0 3px 0;\t\r\n}\r\n\r\n#lpPlPointSect table {\r\n\twidth:300px;\r\n\tmargin:0;\r\n\tborder-collapse: collapse;\r\n\tborder-top: 1px solid #dbdbdb;\r\n\tbackground-color: white;\r\n\tdisplay: table;\r\n\tborder-spacing: 2px;\r\n\tborder-top:0px;\r\n}\r\n\r\n#usePoint {\r\n\tpadding:1px 5px;\r\n\twidth:120px;\r\n\tmargin-top:1px;\r\n\tvertical-align:middle;\r\n}\r\n\r\n#chkLPointAll {\r\n\tpadding:0;\r\n\tmargin:0px 0 0 3px;\r\n\tvertical-align:middle;\r\n}\r\n\r\n.btnWrapC {\r\n\ttext-align: center;\r\n\tmargin:10px 0 0;\r\n}\r\n\r\n/* .btnType06 span {\r\n\tmargin:2px;\r\n\tpadding: 8px 20px;\r\n\tcolor: #fff;\r\n\tvertical-align: top;\r\n\ttext-align:center;\r\n}\r\n\r\n.btnType07 span {\r\n\tmargin:2px;\r\n\tpadding: 8px 20px;\r\n\tcolor: #fff;\r\n\tvertical-align: top;\r\n\ttext-align:center;\r\n}\r\n */\r\n\r\n/* 다이렉트 팝업 css */\r\n\r\n\r\n.lpointDirectPopLayer {\r\n\tdisplay:inline-table;\r\n\twidth:270px;\r\n\theight:200px;\r\n\tmargin:-135px 0 0 -220px;\r\n\tpadding:20px;\r\n\tfont-family:'NanumGothic','sans-serif';\r\n\tfont-size:12px;\r\n\tborder:1px solid #CCC;\r\n}\r\n\r\n#directTableLayer {\r\n\twidth:300px;\r\n\tmargin:0;\r\n\tborder-collapse: collapse;\r\n\tborder-top: 1px solid #dbdbdb;\r\n\tbackground-color: white;\r\n\tdisplay: table;\r\n\tborder-spacing: 2px;\r\n}\r\n\r\n\r\n#lpPlInfomation {\r\n\tcolor:#ff0000;\r\n\tfont:text-decoration: underline italic bold 14px/30px Georgia, serif;\r\n}\r\n\r\n#lpPlPointSect {\r\n\tdisplay:none;\r\n\tmargin:0px 0 3px 0;\r\n}\r\n\r\n#lpPointLayer {\r\n\twidth:300px;\r\n\tmargin:0;\r\n\tborder-collapse: collapse;\r\n\tborder-top: 1px solid #dbdbdb;\r\n\tbackground-color: white;\r\n\tdisplay: table;\r\n\tborder-spacing: 2px;\r\n\tborder-top:0px;\r\n}\r\n\r\n.m20 {\r\n\tdisplay:table-footer-group;\r\n\ttext-align: center;\r\n}\r\n"
          },
