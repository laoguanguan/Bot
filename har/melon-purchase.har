            "text": "/*!\r\n * Bootstrap v2.2.1\r\n *\r\n * Copyright 2012 Twitter, Inc\r\n * Licensed under the Apache License v2.0\r\n * http://www.apache.org/licenses/LICENSE-2.0\r\n *\r\n * Designed and built with all the love in the world @twitter by @mdo and @fat.\r\n */\r\n.clearfix {\r\n\t*zoom: 1;\r\n}\r\n.clearfix:before,\r\n.clearfix:after {\r\n\tdisplay: table;\r\n\tcontent: \"\";\r\n\tline-height: 0;\r\n}\r\n.clearfix:after {\r\n\tclear: both;\r\n}\r\n.hide-text {\r\n\tfont: 0/0 a;\r\n\tcolor: transparent;\r\n\ttext-shadow: none;\r\n\tbackground-color: transparent;\r\n\tborder: 0;\r\n}\r\n\r\n.input-block-level {\r\n\tdisplay: block;\r\n\twidth: 100%;\r\n\tmin-height: 30px;\r\n\t-webkit-box-sizing: border-box;\r\n\t-moz-box-sizing: border-box;\r\n\tbox-sizing: border-box;\r\n}\r\n\r\n/*���*/\r\n.inipay_modal-backdrop {\r\n\tposition: fixed;\r\n\ttop: 0;\r\n\tright: 0;\r\n\tbottom: 0;\r\n\tleft: 0;\r\n\tz-index: 10400;\r\n\tbackground-color: #000000;\r\n}\r\n.inipay_modal-backdrop.fade {\r\n\topacity: 0;\r\n}\r\n.inipay_modal-backdrop,\r\n.inipay_modal-backdrop.fade.in {\r\n\topacity: 0.3;\r\n\tfilter: alpha(opacity=30);\r\n}\r\n.inipay_modal {\r\n\t/*display:none;*/\r\n\tposition: fixed;\r\n/* \tleft: 50%; */\r\n\tz-index: 10500;\r\n\twidth: 100%;\r\n\theight : 100%;\r\n\tmargin: 0px auto;\r\n\tbackground-color: transparent;\r\n\t/* border: 1px solid #999;\r\n\tborder: 1px solid rgba(0, 0, 0, 0.3);\r\n\t*border: 1px solid #999; */\r\n\t/* IE6-7 */\r\n\r\n/*\r\n\t-webkit-border-radius: 10px;\r\n\t-moz-border-radius: 10px;\r\n\tborder-radius: 10px;\r\n*/\r\n\t/* -webkit-border-radius: 5px;\r\n\t-moz-border-radius: 5px;\r\n\tborder-radius: 5px;\r\n\r\n\t-webkit-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-moz-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\tbox-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-webkit-background-clip: padding-box;\r\n\t-moz-background-clip: padding-box;\r\n\tbackground-clip: padding-box;*/\r\n\toutline: none; \r\n}\r\n.inipay_modal.fade {\r\n\t-webkit-transition: opacity .3s linear, top .3s ease-out;\r\n\t-moz-transition: opacity .3s linear, top .3s ease-out;\r\n\t-o-transition: opacity .3s linear, top .3s ease-out;\r\n\ttransition: opacity .3s linear, top .3s ease-out;\r\n\ttop: -1200px;\r\n}\r\n.inipay_modal.fade.in {\r\n\ttop: 0%;\r\n}\r\n\r\n/*��� �޼���*/\r\n\r\n.inipay_modal_msg-backdrop {\r\n\tposition: fixed;\r\n\ttop: 0;\r\n\tright: 0;\r\n\tbottom: 0;\r\n\tleft: 0;\r\n\tz-index: 10400;\r\n\tbackground-color: #000000;\r\n}\r\n.inipay_modal_msg-backdrop.fade {\r\n\topacity: 0;\r\n}\r\n.inipay_modal_msg-backdrop,\r\n.inipay_modal_msg-backdrop.fade.in {\r\n\topacity: 0.0;\r\n\tfilter: alpha(opacity=0);\r\n}\r\n.inipay_modal_msg {\r\n\t/*display:none;*/\r\n\tposition: fixed;\r\n\t/*top: 40%;*/\r\n\tleft: 50%;\r\n\tz-index: 10500;\r\n\twidth: 666px;\r\n\tmargin: -250px 0 0 -335px;\r\n\tbackground-color: #ffffff;\r\n\tborder: 2px solid #999;\r\n\tborder: 2px solid rgba(0, 0, 0, 0.3);\r\n\t*border: 2px solid #999;\r\n\t/* IE6-7 */\r\n\r\n\tpadding:15px;\r\n\ttext-align:center;\r\n\tfont-size : 13px;\r\n\tcolor: #2a5d9f;\r\n\r\n\r\n/*\r\n\t-webkit-border-radius: 10px;\r\n\t-moz-border-radius: 10px;\r\n\tborder-radius: 10px;\r\n*/\r\n\t-webkit-border-radius: 5px;\r\n\t-moz-border-radius: 5px;\r\n\tborder-radius: 5px;\r\n\r\n\t-webkit-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-moz-box-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\tbox-shadow: 0 3px 7px rgba(0, 0, 0, 0.3);\r\n\t-webkit-background-clip: padding-box;\r\n\t-moz-background-clip: padding-box;\r\n\tbackground-clip: padding-box;\r\n\toutline: none;\r\n}\r\n.inipay_modal_msg.fade {\r\n\t-webkit-transition: opacity .3s linear, top .3s ease-out;\r\n\t-moz-transition: opacity .3s linear, top .3s ease-out;\r\n\t-o-transition: opacity .3s linear, top .3s ease-out;\r\n\ttransition: opacity .3s linear, top .3s ease-out;\r\n\ttop: -600px;\r\n}\r\n.inipay_modal_msg.fade.in {\r\n\ttop: 40%;\r\n}\r\n/****************************/\r\n/** header\r\n/****************************/\r\n.inipay_modal-header {\r\n\t/*padding: 5px 15px;*/\r\n\tpadding: 5px 5px 0 10px;\r\n\t/*border-bottom: 1px solid #eee;*/\r\n}\r\n.inipay_modal-header .close {\r\n\tmargin-top: 5px;\r\n}\r\n.inipay_modal-header h3 {\r\n\tmargin: 0;\r\n\tline-height: 20px;\r\n\tclear:none;\r\n\tfont-size: 18px;\r\n\r\n\tfont-family: inherit;\r\n\tfont-weight: bold;\r\n\tcolor: inherit;\r\n\ttext-rendering: optimizelegibility;\r\n}\r\n\r\n\r\n.inipay_close {\r\n\r\n\tposition: absolute;\r\n\ttop: -14px;\r\n\tright: -14px;\r\n\r\n\twidth: 32px;\r\n\theight: 32px;\r\n\r\n\tcursor: pointer;\r\n\r\n\topacity: 0.3;\r\n}\r\n\r\n.inipay_close:hover {\r\n\topacity: 0.8;\r\n\r\n}\r\n/****************************/\r\n/** body\r\n/****************************/\r\n.inipay_modal-body {\r\n\t/*overflow:auto;*/\r\n\t/*height: 590px;*/\r\n\t/*padding: 5px;*/\r\n\twidth:100%;\r\n\theight:100%;\r\n/* \ttext-align: center; */\r\n}\r\n.inipay_iframe {\r\n\tborder: none #FFFF00 0px;\r\n\tdisplay:block; left:0; top:0px;\r\n\toverflow:hidden;\r\n\twidth:100%;\r\n\theight:100%;\r\n\tmargin:0px auto;\r\n\t/*\r\n\twidth:570px;\r\n\theight:465px;\r\n\t*/\r\n}\r\n\r\n.inipay_modal-form {\r\n\tmargin-bottom: 0;\r\n}\r\n\r\n/****************************/\r\n/** footer\r\n/****************************/\r\n.inipay_modal-footer {\r\n\t/*padding: 10px 15px 10px;*/\r\n\tpadding: 2px;\r\n\tmargin-bottom: 0;\r\n\ttext-align: right;\r\n\tbackground-color: #f5f5f5;\r\n\t/*border-top: 1px solid #ddd;*/\r\n\t-webkit-border-radius: 0 0 6px 6px;\r\n\t-moz-border-radius: 0 0 6px 6px;\r\n\tborder-radius: 0 0 6px 6px;\r\n\t-webkit-box-shadow: inset 0 1px 0 #ffffff;\r\n\t-moz-box-shadow: inset 0 1px 0 #ffffff;\r\n\tbox-shadow: inset 0 1px 0 #ffffff;\r\n\t*zoom: 1;\r\n}\r\n.inipay_modal-footer:before,\r\n.inipay_modal-footer:after {\r\n\tdisplay: table;\r\n\tcontent: \"\";\r\n\tline-height: 0;\r\n}\r\n.inipay_modal-footer:after {\r\n\tclear: both;\r\n}\r\n.inipay_modal-footer .btn + .btn {\r\n\tmargin-left: 5px;\r\n\tmargin-bottom: 0;\r\n}\r\n.inipay_modal-footer .btn-group .btn + .btn {\r\n\tmargin-left: -1px;\r\n}\r\n.inipay_modal-footer .btn-block + .btn-block {\r\n\tmargin-left: 0;\r\n}\r\n\r\n\r\n\r\n\r\n"
          },
