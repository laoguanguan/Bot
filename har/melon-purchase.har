            "size": 98593,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\"/>\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\" />\n\t<title>Melon Ticket - Global</title>\n    <link rel=\"shortcut icon\" type=\"image/x-icon\" href=\"https://cdnticket.melon.co.kr/resource/image/web/common/pc_32.ico\" /><!-- 파비콘 추가 -->\n     <!-- IOS용 -->\n    <link rel=\"apple-touch-icon-precomposed\" href=\"https://cdnticket.melon.co.kr/resource/image/web/common/ios_120.png\" />\n\t<link rel=\"apple-touch-icon-precomposed\" sizes=\"180x180\" href=\"https://cdnticket.melon.co.kr/resource/image/web/common/ios_180.png\" />\n\t<meta name=\"keywords\" content=\"K-pop, Kpop, Concert, Musical, Melon, Melon Ticket\" />\n\t<meta name=\"description\" content=\"Offers tickets for K-pop Concerts, Musicals and Theatre in Korea.\" />\n    <meta property=\"og:title\" content=\"\"/>\n    <meta property=\"og:image\" content=\"\"/>\n    <meta property=\"og:description\" content=\"듣다·보다·만나다, 멜론티켓\"/>\n    <meta name=\"viewport\" content=\"width=1126\"/>\n    <script src=\"/resource/script/phase/deployPhaseUtils.js\"></script>\n<!-- 네이버 광고 로그분석 -->\n<!-- 공통 적용 스크립트 , 모든 페이지에 노출되도록 설치. 단 전환페이지 설정값보다 항상 하단에 위치해야함 -->\n<script type=\"text/javascript\" src=\"//wcs.naver.net/wcslog.js\"> </script>\n<script type=\"text/javascript\">\n    // console.log(\"##########################################\");\n    // console.log(\"##########################################\");\n    // console.log(\"네이버 광고 로그 분석 공통 스크립트 실행\");\n    // console.log(\"script_common.jsp\");\n    // console.log(\"##########################################\");\n    // console.log(\"##########################################\");\n    if (!wcs_add) var wcs_add={};\n    wcs_add[\"wa\"] = \"s_322bdbd6fd48\";\n    if (!_nasa) var _nasa={};\n    if(window.wcs){\n        wcs.inflow(\"melon.com\");\n        wcs_do(_nasa);\n    }\n</script>\n<!-- END 네이버 광고 로그분석 -->\n<script>\n</script>\n<script type=\"text/javascript\" src=\"/resource/script/web/common/jquery-3.6.0.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/jquery-migrate-3.3.2.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/jquery.inputmask.bundle.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/ui_script.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/melonweb_openlib.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/melonweb_comm.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/melonweb_member_external.js?ts=221005\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/webUtils.js?date=1608221544\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/CaptchaUtils.js?v=20240116\"></script>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"//cdnticket.melon.co.kr/resource/style/web/common/common_eng-26bfdde865.css\" id=\"linkCommonOnestopCss\"/>\n\n    <script>var APIURL = '/tktapi', POCURL = '/tktapi_poc', CTX = '';</script>\n\n<script type=\"text/javascript\" src=\"/resource/script/web/common/dictionaryForMultiNationLanguage.js?modifyDate=2025091115\" id=\"dictionaryForMultiNationLanguage\" data-modifyDate=\"2025091115\"></script>\n<script>\n\n\t/**\n\t * 날짜문자열을 넘기면 YYYY.mm.dd 형태로 포맷팅됨.\n\t * Deprecated Sun, 31 Jul 2016 17:00\n\t */\n\tfunction convertDateFormat(date, time){\n\t\tif(date == null || date == undefined || date.length != 8){\n\t\t\tdate = \"20000101\";\n\t\t}\n\t\tif(time == null || time == undefined || (time.length != 4 && time.length != 6)){\n\t\t\ttime = \"0000\";\n\t\t}\n\t\t\n\t\t// 기존 로직\n\t\t//var d = new Date(Date.parse(date.substr(0,4)+\"-\"+date.substr(4,2)+\"-\"+date.substr(6,2)+\"T\"+time.substr(0,2)+\":\"+time.substr(2,2)));\n\t\t//return d.toUTCString().substr(0, 22); // Sat, 30 Jul 2016 18:00\n\t\t\n\t\t// 변환 로직\n\t\t//var d = new Date(date+((time).length == 4 ? (time+'00') : (time)).replace(/^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})$/,'$1/$2/$3 $4:$5:$6'));\n\t\t\n\t\t//영문 변환 - UTCString 쓰지 않고 메뉴얼 변환\n\t\t//return date.length >= 8 ? getMonthName((parseInt(date.substr(4,2), 10) - 1)) + \" \" + parseInt(date.substr(6,2), 10) + date.substr(0,4) + \" \" + time.substr(0,2) + \":\" + time.substr(2,2) : \"\"\n\t\t//return date.length >= 8 ? getMonthName((parseInt(date.substr(4,2), 10) - 1)) + \" \" + parseInt(date.substr(6,2), 10) + date.substr(0,4) + \" \" + date.substr(8,2) + \":\" + date.substr(10,2) : \"\"\n\t\treturn convertDateFormatOnlyDate(date) + \" \" + convertDateFormatOnlyTime(time);\n\t};\n\t\n\tfunction convertDateFormat2(date){\n\t\tif(date == null || date == undefined || date.length < 12){\n\t\t\tif(date.length < 8){\n\t\t\t\tdate = \"200001010000\";  \n\t\t\t}else{\n\t\t\t\tdate = date.substr(0, 8) + \"0000\";\n\t\t\t}\n\t\t}\n\t\treturn convertDateFormat(date.substr(0, 8), date.substr(8, 4));\n\t};\n\t\n\tfunction convertDateFormatOnlyDate(dateStr, DATE_DELIM){\n\t\tDATE_DELIM = (DATE_DELIM == undefined ? \".\" : DATE_DELIM);\n\t\treturn (dateStr.substr(0,4)+DATE_DELIM+dateStr.substr(4,2)+DATE_DELIM+dateStr.substr(6,2));\n\t};\n\tfunction convertDateFormatOnlyTime(timeStr, TIME_DELIM){\n\t\tTIME_DELIM = (TIME_DELIM == undefined ? \":\" : TIME_DELIM);\n\t\tif(timeStr.length == 6){\n\t\t\treturn (timeStr.substr(0,2)+TIME_DELIM+timeStr.substr(2,2)+TIME_DELIM+timeStr.substr(4,2));\n\t\t} else {\n\t\t\treturn (timeStr.substr(0,2)+TIME_DELIM+timeStr.substr(2,2));\n\t\t}\n\t};\n\t\n\t/**\n\t * getMonthName Function - via http://www.jquery2dotnet.com/2013/11/javascript-get-month-name-from-number.html\n\t */\n\tvar getMonthName = function (v) {\n\t\t//var n = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\n\t\tvar n = [];\n\t\tn = monthNameArr[LANG_CD.EN]; //16-08-25 한글 표기로 통일하기로 함.\n\t\t/*if(langCd != undefined && langCd != '' && monthNameArr[langCd] != undefined){\n\t\t\tn = monthNameArr[langCd];\n\t\t} else {\n\t\t\tn = monthNameArr['default']; \n\t\t}*/\n\t\treturn n[Number(v)];\n\t};\n\n\tfunction getWeekDay(dt, seperator, option) {\n\t\tif(seperator == undefined || option == undefined){\n\t\t\tvar week = [];\n\t\t\tweek = weekNameArr[LANG_CD.EN]; //16-08-25 한글 표기로 통일하기로 함.\n\t\t\t/*if(langCd != undefined && langCd != '' && monthNameArr[langCd] != undefined){\n\t\t\t\tweek = weekNameArr[langCd];\n\t\t\t} else {\n\t\t\t\tweek = weekNameArr['default']; \n\t\t\t}*/\n\t\t\tvar day = new Date(dt.split(\".\").join(\"/\")).getDay();\n\t\t\treturn week[day];\n\t\t} else {\n\t\t\tvar datestr = dt;\n\t\t\ttry {\n\t\t\t\tvar date_arr = getYmdArr(datestr, seperator);\n\t\t\t\tvar obj_date = new Date(date_arr[0],date_arr[1]-1,date_arr[2]);\n\t\t\t\tif(option == '0') {\n\t\t\t\t\treturn obj_date.getDay();\n\t\t\t\t}\n\t\t\t\telse if(option == '1') {\n\t\t\t\t\tvar week_str = new Array(\"일\",\"월\",\"화\",\"수\",\"목\",\"금\",\"토\");\n\t\t\t\t\treturn week_str[obj_date.getDay()];\n\t\t\t\t}\n\t\t\t}\n\t\t\tcatch(e) {\n\t\t\t\t//alert('udfMainFrm.js : '+e);\n\t\t\t}\n\t\t}\n\t};\n\tfunction getYmdArr(dateStr, seperator) {\n\t\ttry {\n\t\t\tif(seperator == '') {\n\t\t\t\tvar rtnArr = new Array();\n\t\t\t\trtnArr[0] = dateStr.substr(0,4);\n\t\t\t\trtnArr[1] = dateStr.substr(4,2);\n\t\t\t\trtnArr[2] = dateStr.substr(6,2);\n\t\t\t\treturn rtnArr;\n\t\t\t}\n\t\t\telse {\n\t\t\t\treturn dateStr.split(seperator);\n\t\t\t}\n\t\t}\n\t\tcatch(e) {\n\t\t\t//alert('udfMainFrm.js : '+e);\n\t\t}\n\t};\n\n\tvar LANG_CD = {\n\t\tEN: 'EN',\n\t\tCN: 'CN',\n\t\tJP: 'JP',\n\t\tKR: 'KR'\n\t};\n\tvar langCd = LANG_CD.EN;\n\tvar COMMON_PROP = 'common';\n\tvar MSG_PROP = 'message';\n\n\t/**\n\t * 글로벌용 임시 함수. 한글 상태명을 영문 상태명으로 변환\n\t */\n\tvar replaceKrToEn = function(targetProp, statusName) {\n\t\treturn replaceKrTo(LANG_CD.EN, targetProp, statusName);\n\t};\n\t/**\n\t * 글로벌용 임시 함수. 한글 상태명을 영문 상태명으로 변환\n\t */\n\tvar replaceKrToLangCd = function(targetProp, statusName) {\n\t\treturn replaceKrTo(langCd, targetProp, statusName);\n\t};\n\n\t/**\n\t * 글로벌용 임시 함수. 한글 상태명을 타국 상태명으로 변환\n\t */\n\tvar replaceKrTo = function(lang, targetProp, statusName) {\n\t\treturn replaceLangToLang(dictionaryKrTo, lang, targetProp, statusName);\n\t};\n\n\tvar replaceEnToLangCd = function(targetProp, statusName) {\n\t\treturn replaceEnTo(langCd, targetProp, statusName);\n\t};\n\t/**\n\t * 글로벌용 임시 함수. 영문을 타국어로 변환\n\t */\n\tvar replaceEnTo = function(lang, targetProp, statusName) {\n\t\treturn replaceLangToLang(dictionaryEnTo, lang, targetProp, statusName);\n\t};\n\n\t/**\n\t * 글로벌용 임시 함수. 영문을 타국어로 변환\n\t */\n\tvar hasWordEnTo = function(lang, targetProp, statusName) {\n\t\tif (statusName.indexOf(replaceEnTo(lang, targetProp, statusName)) > -1) {\n\t\t\treturn false;\n\t\t} else {\n\t\t\treturn true;\n\t\t}\n\t};\n\t/**\n\t * 글로벌용 임시 함수. 국어을 타국어로 변환\n\t */\n\tvar hasWordKrTo = function(lang, targetProp, statusName) {\n\t\tif (statusName.indexOf(replaceKrTo(lang, targetProp, statusName)) > -1) {\n\t\t\treturn false;\n\t\t} else {\n\t\t\treturn true;\n\t\t}\n\t};\n\n\tvar replaceLangToLang = function(dictionaryFromLang, toLang, targetProp, statusName) {\n\t\tvar langIndex = 0;\n\t\tswitch (toLang) {\n\t\t\tcase LANG_CD.EN:\n\t\t\t\tlangIndex = 0;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.CN:\n\t\t\t\tlangIndex = 1;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.JP:\n\t\t\t\tlangIndex = 2;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.KR:\n\t\t\t\tlangIndex = 3;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\tlangIndex = 0;\n\t\t\t\tbreak;\n\t\t};\n\n\t\t//사전에 카테고리나 단어가 정의되지 않은 경우는 statusName을 반환.\n\t\tif (dictionaryFromLang[targetProp] == undefined\n\t\t\t|| dictionaryFromLang[targetProp][statusName] == undefined\n\t\t\t|| dictionaryFromLang[targetProp][statusName][langIndex] == undefined\n\t\t\t/*|| dictionaryFromLang[targetProp][statusName][langIndex] == ''*//*의도적 빈 값 처리를 위해 넣음*/\n\t\t) {\n\t\t\treturn statusName;\n\t\t} else {\n\t\t\treturn dictionaryFromLang[targetProp][statusName][langIndex];\n\t\t}\n\t};\n\n\t/**\n\t * target elements를 순회하면서 action에 설정된 작업을 처리한다.\n\t * @param complete - function 투어 완료했을 때 처리할 작업\n\t * @param target - HTML Element 투어할 DOM Element\n\t * @param action - function 처리할 작업\n\t * @param isSeries - boolean 내부 재귀 호출용 파라미터.\n\t * 출처: http://www.bsidesoft.com/?p=1431\n\t */\n\tfunction tour(complete, target, action, isSeries) {\n\t\tvar stack, curr, i, start, timeCounter;\n\n\t\t//최초 호출된 경우\n\t\tif (!isSeries) {\n\t\t\t//최초 스택을 생성-이전동일\n\t\t\tstack = [target.length ? target : [target]];\n\t\t} else {\n\t\t\t// 이어받는 경우는 target이 stack임\n\t\t\tstack = target;\n\t\t}\n\n\t\t//시작시간을 확인한다.\n\t\tstart = Date.now();\n\n\t\t//시간확인용 카운터 초기화\n\t\ttimeCounter = 0;\n\n\t\twhile (curr = stack.pop()) {\n\t\t\ti = curr.length;\n\t\t\twhile (i--) {\n\t\t\t\taction(curr[i]);\n\t\t\t\tif (curr[i].childNodes && curr[i].childNodes.length) {\n\t\t\t\t\tstack.push(curr[i].childNodes);\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t\t//카운터가 100이 될때마다 시간을 측정한다.\n\t\t\tif (timeCounter++ == 100) {\n\t\t\t\t//3초가 경과되었다면\n\t\t\t\tif (Date.now() - start > 3000) {\n\t\t\t\t\t//다음 프레임으로 넘긴다.\n\t\t\t\t\treturn setTimeout(function() {\n\t\t\t\t\t\t//현재 스택을 target으로, isSeries를 true로\n\t\t\t\t\t\ttour(complete, stack, action, true);\n\t\t\t\t\t}, 1);\n\t\t\t\t}\n\t\t\t\t//카운터를 초기화\n\t\t\t\ttimeCounter = 0;\n\t\t\t}\n\t\t}\n\n\t\t//만약 무사히 나왔다면 완료된것!\n\t\tcomplete();\n\t}\n\n\tvar replaceAllBodyEnToLangCd = function(callback) {\n\t\treplaceAllEnToLangCd(document.body,callback);\n\t}\n\tvar getCssPathToLangCd = function(currPage) {\n\t\tvar langCodeOfCss = '';\n\t\tvar engCssPath = \"//cdnticket.melon.co.kr/resource/style/web/common/common_eng-26bfdde865.css\";\n\t\tvar chnCssPath = \"//cdnticket.melon.co.kr/resource/style/web/common/common_chn-f64aaea19b.css\";\n\t\tvar jpnCssPath = \"//cdnticket.melon.co.kr/resource/style/web/common/common_jpn-40426d3dfc.css\";\n\t\tvar cssPath;\n\t\tswitch (langCd) {\n\t\t\tcase LANG_CD.EN:\n\t\t\t\t// langCodeOfCss = 'eng';\n                cssPath = engCssPath;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.CN:\n\t\t\t\t// langCodeOfCss = 'chn';\n                cssPath = chnCssPath;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.JP:\n\t\t\t\t// langCodeOfCss = 'jpn';\n                cssPath = jpnCssPath;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.KR:\n\t\t\t\t// langCodeOfCss = '';\n                cssPath = engCssPath;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\t// langCodeOfCss = 'eng';\n                cssPath = engCssPath;\n\t\t\t\tbreak;\n\t\t};\n\t\t// var tempLangCodeOfCss = (langCodeOfCss == '' ? '' : '_' + langCodeOfCss);\n\t\t// tempLangCodeOfCss += (currPage.indexOf('onestop') > -1 ? '_onestop' : '');\n\t\t// var cssPath = '../../../resource/style/web/common/common'+tempLangCodeOfCss+'.css';\n\t\treturn cssPath;\n\t}\n\n\tvar setCssToLangCd = function() {\n\t\tvar targetCssLink = '';\n\t\tif(document.getElementById('linkCommonOnestopCss')){\n\t\t\ttargetCssLink = document.getElementById('linkCommonOnestopCss');\n\t\t} else if(document.getElementById('linkCommonCss')){\n\t\t\ttargetCssLink = document.getElementById('linkCommonCss');\n\t\t}\n\t\tif(typeof targetCssLink != \"object\"){\n\t\t\t//if( window.console ){ console.log(\"css 변환 실패\"); }\n\t\t\treturn;\n\t\t}\n\t\tvar currCssHref = targetCssLink.getAttribute('href');\n\t\tvar nextCssHref = getCssPathToLangCd('onestop');\n\t\tif(currCssHref != nextCssHref){\n\t\t\ttargetCssLink.setAttribute('href',nextCssHref);\n\t\t}\n\t};\n\tvar replaceAllEnToLangCd = function(target,callback) {\n\t\tvar baseLang = LANG_CD.EN;\n\t\treplaceAllLangToLangCd(baseLang,target,callback);\n\t};\n\tvar replaceAllKrToLangCd = function(target,callback) {\n\t\tvar baseLang = LANG_CD.KR;\n\t\treplaceAllLangToLangCd(baseLang,target,callback);\n\t};\n\tvar replaceAllLangToLangCd = function(baseLang,target,callback) {\n\t\tif (target == undefined) {\n\t\t\ttarget = document.body;\n\t\t}\n\t\t//target.style.display = \"none\";\n\t\t//사용하기\n\t\ttour(\n\t\t\tfunction complte() {\n\t\t\t\tsetCssToLangCd();\n\t\t\t\t//target.style.display = \"\"; //block을 주면 css 잡힌 것을 해치게 됨.\n\t\t\t\t//if( window.console ) console.log('tour completed!');\n\t\t\t\t//if( window.console ) console.log('callback resolve start');\n\t\t\t\tcallback != undefined && typeof callback == 'function' ? callback() : '';\n\t\t\t},\n\t\t\ttarget,\n\t\t\tfunction action(el) {\n\t\t\t\t//if( window.console ) console.log(\"el.nodeType  = \" + el.nodeType);\n\t\t\t\tif (el.nodeType == 1) {\n\t\t\t\t\tvar targetEleType = '';\n\t\t\t\t\tvar targetEleAttr = '';\n\t\t\t\t\tif (el.innerHTML) {\n\t\t\t\t\t\ttargetEleType = \"innerHTML\";\n\t\t\t\t\t\ttargetEleAttr = el.innerHTML;\n\t\t\t\t\t} else if (el.text) {\n\t\t\t\t\t\ttargetEleType = \"text\";\n\t\t\t\t\t\ttargetEleAttr = el.text;\n\t\t\t\t\t} else if (el.value) {\n\t\t\t\t\t\ttargetEleType = \"value\";\n\t\t\t\t\t\ttargetEleAttr = el.value;\n\t\t\t\t\t} else {\n\t\t\t\t\t\t//if( window.console ) console.log(\"skip\");\n\t\t\t\t\t};\n\n\t\t\t\t\tif(targetEleAttr != ''){\n\t\t\t\t\t\t//if( window.console ) console.log(targetEleType + \"\\t\\t\\t\" + targetEleAttr);\n\t\t\t\t\t\tif (baseLang == LANG_CD.EN && hasWordEnTo(langCd, COMMON_PROP, targetEleAttr)) {\n\t\t\t\t\t\t\tel[targetEleType] = replaceEnTo(langCd, COMMON_PROP, targetEleAttr);\n\t\t\t\t\t\t} else\n\t\t\t\t\t\tif (baseLang == LANG_CD.KR && hasWordKrTo(langCd, COMMON_PROP, targetEleAttr)) {\n\t\t\t\t\t\t\tel[targetEleType] = replaceKrTo(langCd, COMMON_PROP, targetEleAttr);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t);\n\t};\n\n</script>\n</head>\n<body>\n\n    <div class=\"section_onestop\" style=\"display: none;width: 970px\">\n    <!-- 배송/결제 영역-->\n    <div class=\"wrap_select\">\n        <div class=\"location_step\">\n            <ul class=\"list_step\">\n            </ul>\n        </div>\n        <div class=\"box_r\">\n            <!-- 하이패스 임시 이미지 -->\n            <div class=\"mb20\" id=\"paySepImage\" style=\"display: none;\"><img src=\"https://cdnticket.melon.co.kr/resource/image/web/onestop/img_highpass_info.png\" alt=\"\" /></div>\n            <form id=\"dForm\" method=\"post\" name=\"dForm\">\n            <input type=\"hidden\" id=\"jType\" name=\"jType\" value=\"I\">\n            <!-- 수령방법 선택 -->\n            <div class=\"box_how\">\n                <h3 class=\"select_tit\">Delivery Method</h3>\n                <ul class=\"list_receipt_how type03\" id=\"partDeliveryType\">\n                </ul>\n                <div class=\"txt\" id=\"txtDeliveryInfo\"></div>\n                <div class=\"box_info_use box_gray\"><!-- 현장수령 선택시-->\n                    <h4 class=\"tit_receipt\"><span>Member Information </span><span class=\"tit_info date\">(Please use English and numbers only)</span></h4>\n                    <div class=\"box_inp_opt\">\n                        <table class=\"tbl\">\n                            <caption class=\"hide\"></caption>\n                            <colgroup>\n                                <col style=\"width:43px;\"/>\n                                <col style=\"width:150px;\"/>\n                                <col style=\"width:43px;\"/>\n                                <col style=\"width:150px;\"/>\n                                <col style=\"width:43px;\"/>\n                                <col style=\"width:150px;\"/>\n                            </colgroup>\n                            <tbody>\n                                <tr>\n                                    <th class=\"txt_gray\" id=\"labUserName\">Name</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\" id=\"userName\"></div>\n                                    </td>\n                                    <th class=\"txt_gray\">Mobile</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"tel\" id=\"tel\" class=\"inputType inp_txt inp_w130\" maxlength=\"20\"/> <!-- 161114 선주매니저 요청 maxlength 20  -->\n                                            <label for=\"tel\" class=\"place_holder\"></label>\n                                        </div>\n                                    </td>\n                                    <th class=\"txt_gray\">E-mail</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"email\" id=\"email\" class=\"inputType inp_txt inp_w130\" value=\"\"  />\n                                            <label for=\"email\" class=\"place_holder\"></label>\n                                        </div>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                        <p class=\"txt_more txt_gray\">A confirmation mail will be sent via e-mail.<br>Member`s name must exactly match the name on a passport to confirm your tickets.</p>\n                    </div>\n                </div><!--// 현장수령 선택시-->\n                <!-- TICKET-3561 -->\n                <!-- 해외배송 선택시-->\n                <div class=\"box_location box_gray\" id=\"addrInfo\" style=\"display: none;\">\n                    <h4 class=\"tit_receipt\">Shipping Address</h4>\n                    <div class=\"box_inp_opt\">\n                        <div class=\"box_inp_opt\">\n                            <table class=\"tbl \">\n                                <caption class=\"hide\"></caption>\n                                <colgroup>\n                                    <col style=\"width:130px;\" />\n                                    <col />\n                                </colgroup>\n                                <tbody>\n                                <tr>\n                                    <th class=\"txt_gray\">Country</th>\n                                    <td>\n                                        <span class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"recv_country_disp\" id=\"recv_country_disp\" class=\"inputType inp_txt\" value=\"\" disabled=\"disabled\" maxlength=\"100\"/>\n                                            <input type=\"hidden\" id=\"recv_country\" name=\"recv_country\" value=\"\"/>\n                                            <label for=\"recv_country\" class=\"place_holder\"></label>\n                                        </span>\n                                        <button class=\"box_inp_btn\" onclick=\"$('#selectCountry').show(); return false;\">Search</button>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th class=\"txt_gray\">Name (First and Last)</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"recv_name\" id=\"recv_name\" class=\"inputType inp_txt\" value=\"\" style=\"width: 446px;\" maxlength=\"35\"/>\n                                            <label for=\"recv_name\" class=\"place_holder\" style=\"top: 4px;\">Enter in English only</label>\n                                        </div>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th class=\"txt_gray\">Street Address</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"recv_address\" id=\"recv_address\" class=\"inputType inp_txt\" value=\"\" style=\"width: 446px;\" maxlength=\"200\"/>\n                                            <label for=\"recv_address\" class=\"place_holder\" style=\"top: 4px;\">Enter in English only</label>\n                                        </div>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th class=\"txt_gray\">City</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"recv_city\" id=\"recv_city\" class=\"inputType inp_txt\" value=\"\" style=\"width: 446px;\" maxlength=\"50\"/>\n                                            <label for=\"recv_city\" class=\"place_holder\" style=\"top: 4px;\">Enter in English only</label>\n                                        </div>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th class=\"txt_gray\">State/Province</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"recv_state\" id=\"recv_state\" class=\"inputType inp_txt\" value=\"\" style=\"width: 446px;\" maxlength=\"50\"/>\n                                            <label for=\"recv_state\" class=\"place_holder\" style=\"top: 4px;\">Enter in English only</label>\n                                        </div>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th class=\"txt_gray\">Zip/Postal Code</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            <input type=\"text\" name=\"recv_zipno\" id=\"recv_zipno\" class=\"inputType inp_txt\" value=\"\" style=\"width: 446px;\" maxlength=\"20\"/>\n                                            <label for=\"recv_zipno\" class=\"place_holder\" style=\"top: 4px;\"></label>\n                                        </div>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th class=\"txt_gray\">Phone Number</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\"><!-- form wrapper -->\n                                            + <input type=\"text\" name=\"recv_tel1_disp\" id=\"recv_tel1_disp\" class=\"inputType inp_txt inp_w77\" value=\"\" disabled=\"disabled\"  maxlength=\"10\"/>\n                                            <input type=\"hidden\" id=\"recv_tel1\" name=\"recv_tel1\" value=\"\"/>\n                                            <input type=\"text\" name=\"recv_tel2\" id=\"recv_tel2\" class=\"inputType inp_txt\" value=\"\" style=\"width: 355px;\" maxlength=\"12\"/>\n                                            <label for=\"recv_tel2\" class=\"place_holder\" style=\"top: 4px;\"></label>\n                                            <input type=\"hidden\" id=\"recv_country_code\" name=\"recv_country_code\" value=\"\"/>\n                                            <input type=\"hidden\" id=\"recv_delvy_price\" name=\"recv_delvy_price\" value=\"0\"/>\n                                        </div>\n                                    </td>\n                                </tr>\n                                </tbody>\n                            </table>\n                            <p class=\"txt_more txt_gray\">* International Shipping Fee is estimated by pre-inputted weight of item and based on your selected country.</p>\n                            <p class=\"txt_more txt_gray\">* Shipments outside the Korea may be subject to tariffs, duties, Value Added Tax [VAT], etc. These costs are your responsibility and are not included in the Shipping charges.</p>\n                            <!-- FTTICKET-316 -->\n                            <table class=\"tbl \">\n                                <caption class=\"hide\"></caption>\n                                <colgroup>\n                                    <col style=\"width:130px;\" />\n                                    <col />\n                                </colgroup>\n                                <tbody>\n                                <tr>\n                                    <th class=\"txt_gray\">Additional Address</th>\n                                    <td>\n                                        <div class=\"wrap_form_input\">\n                                            <!-- form wrapper -->\n                                            <input type=\"text\" name=\"addAddress\" id=\"addAddress\" class=\"inputType inp_txt\" value=\"\" style=\"width: 446px;\" />\n                                            <label for=\"addAddress\" class=\"place_holder\" style=\"top: 4px;\">Enter in your native language only.</label>\n                                        </div>\n                                    </td>\n                                </tr>\n                                </tbody>\n                            </table>\n                            <p class=\"txt_more txt_og\">* The additional address should be written in your native language.</p>\n                            <p class=\"txt_more txt_og\">* Please check the event notice for countries requiring an additional address.</p>\n                            <p class=\"txt_more txt_og\">* Shipping may not be available if you don`t fill out the additional address in your native language for a country requiring it.</p>\n                            <!-- // FTTICKET-316 -->\n                        </div>\n                    </div>\n                </div>\n                <!--// 일반배송 선택시-->\n                <!-- //TICKET-3561 -->\n            </div>\n            <!--// 수령방법 선택 -->\n\n\t\t\t<!-- 예매자 부가정보 --><!-- FTTICKET-278 : 팬클럽 부가정보 입력 개선 - 220111 -->\n\t\t\t<div class=\"box_payment\" id=\"addInfo\" style=\"display: none;\">\n\t\t\t<h3 class=\"select_tit\">Please, Enter your customer's additional information.</h3>\n\t\t\t\t<div class=\"box_gray2\">\n\t\t\t\t\t<h4 id=\"addInfoTitle\"></h4>\n                    <ul id=\"addInfoG7\" style=\"display: none;\">\n                        <li>\n                            <label>Request for agreement on personal information usage on third-party marketing (Optional)<br/>Your cell phone number and e-mail address will be used for advertisement, marketing, and customer service improvement purpose.<br/>This agreement request is optional, independent of your service quality or coverage of Melon Ticket.\n                            </label>\n                        </li>\n                    </ul>\n\t\t\t\t\t<ul id=\"addInfoInputFieldList\">\n\t\t\t\t\t</ul>\n\t\t\t\t\t<ul id=\"addInfoInputFieldListTemplate\" style=\"display: none;\">\n                        <li class=\"TA_temp\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <input type=\"text\" maxLength=\"50\" class=\"inp_txt\" />\n                        </li>\n                        <!-- 생년월일 TA0001 1-->\n                        <li class=\"list-birth TA0001\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <div class=\"wrap_sel\">\n                                <!-- selected된 값이 DP되는 영역 -->\n                                <div class=\"btn_sel\">\n                                    <select class=\"sel_cate birth-yy\"></select>\n                                    <select class=\"sel_cate birth-mm\"></select>\n                                    <select class=\"sel_cate birth-dd\"></select>\n                                </div>\n                            </div>\n                        </li>\n                        <!-- 아이디 TA0002 2-->\n                        <li class=\"list-id TA0002\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <input type=\"text\" hangeulNotOnly spaceNotOnly maxLength=\"30\" class=\"inp_txt\" value=\"\" />\n                        </li>\n                        <!-- 성별 TA0003 3 -->\n                        <li class=\"list-gender TA0003\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <span class=\"box-radio\">\n\t\t\t\t\t\t\t  \t\t<input type='radio' id=\"female\" value=\"F\">\n\t\t\t\t\t\t\t  \t\t<label class=\"label-radio\" for=\"female\">여성 Female</label>\n\t\t\t\t\t\t\t\t</span>\n                            <span class=\"box-radio\">\n\t\t\t\t\t\t\t  \t\t<input type='radio' id=\"male\" value=\"M\">\n\t\t\t\t\t\t\t  \t\t<label class=\"label-radio\" for=\"male\">남성 Male</label><br>\n\t\t\t\t\t\t\t\t</span>\n                        </li>\n                        <!-- 국가 TA0004 4 -->\n                        <li class=\"list-nation TA0004\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <div class=\"wrap_sel\">\n                                <!-- selected된 값이 DP되는 영역 -->\n                                <div class=\"btn_sel\">\n                                    <select class=\"sel_cate\"></select>\n                                </div>\n                            </div>\n                        </li>\n                        <!-- 이름 TA0007 5 -->\n                        <li class=\"list-name TA0007\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <input type=\"text\" maxLength=\"50\" class=\"inp_txt\" value=\"\" />\n                        </li>\n                        <!-- 우편번호 TA0008 6-->\n                        <li class=\"list-postalcode TA0008\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <input type=\"text\" numberOnly maxLength=\"30\" class=\"inp_txt\" value=\"\" />\n                        </li>\n                        <!-- 주소 TA0009 7 -->\n                        <li class=\"list-address TA0009\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <input type=\"text\" class=\"inp_txt\" maxlength=\"50\" value=\"\" />\n                        </li>\n                        <!-- 전화번호 TA0010 8 -->\n                        <li class=\"list-number TA0010\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <div class=\"box-input\">\n                                <div class=\"wrap_sel\">\n                                    <!-- selected된 값이 DP되는 영역 -->\n                                    <div class=\"btn_sel\">\n                                        <select name=\"\" class=\"sel_cate\"></select>\n                                    </div>\n                                </div>\n                                <input type=\"text\" numberOnly maxlength=\"30\" class=\"inp_txt\" value=\"\" />\n                            </div>\n                        </li>\n                        <!-- 이메일 TA0011 9-->\n                        <li class=\"list-email TA0011\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <input type=\"text\" maxlength=\"30\" hangeulNotOnly spaceNotOnly class=\"inp_txt\" value=\"\" />\n                            <span class=\"atsign\" style=\"margin: 0 5px;\">@</span>\n                            <input type=\"text\" maxlength=\"30\" hangeulNotOnly spaceNotOnly class=\"inp_txt\" value=\"\" />\n                        </li>\n                        <!-- 팬ID TA0013 10 -->\n                        <li class=\"list-daumfanid TA0013\">\n                            <span class=\"list-title\"><span class=\"inputFieldName\"></span><span class=\"require\">*</span></span>\n                            <input type=\"text\" class=\"inp_txt\" maxlength=\"50\" value=\"\" />\n                        </li>\n\t\t\t\t\t</ul>\n                    <div id=\"addInfoNotice\" class=\"box-notice\" style=\"display: none;\">\n                        <p class=\"box-notice-title\"></p>\n                        <ul class=\"box-notice-list\">\n                        </ul>\n                        <div class=\"tit_check\">\n                            <input type=\"checkbox\" id=\"notice-check\" class=\"styled\" title=\"\">\n                            <label for=\"notice-check\"><span class=\"txt_lab\"></span></label>\n                        </div>\n                    </div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<!-- //예매자 부가정보 --><!-- //FTTICKET-278 : 팬클럽 부가정보 입력 개선 - 220111 -->\n\n            <!-- 결제수단 선택-->\n            <div id=\"partPaymentInfo\" class=\"box_payment\" style=\"display: none;\">\n            <h3 class=\"select_tit\">Please Select Payment Method</h3>\n                <ul class=\"list_receipt_how type02\">\n                    <li id=\"payMethod001\">\n                        <div class=\"item_inp\">\n                            <input type=\"radio\" id=\"payMethodCode001\" name=\"payMethodCode\" value=\"AP0012\" title=\"International Credit Card\" class=\"inp_g\">\n                            <span class=\"ico_radio\"></span>\n                            <label for=\"payMethodCode001\" class=\"lab_g\">\n                                <span class=\"txt_lab\">International Credit Card</span>\n                            </label>\n                        </div>\n                        <div class=\"box_card box_gray\" id=\"partPaymentCard\" style=\"display: none;\"><!-- 신용 카드 시 노출 -->\n                            <div class=\"wrap_sel\">\n                                <!-- selected된 값이 DP되는 영역 -->\n                                <div class=\"btn_sel\">\n                                    <!-- 셀렉트박스 -->\n                                    <select id=\"cardCode\" name=\"cardCode\" onChange=\"setCardContent(this.value);\" class=\"sel_cate\">\n                                    </select>\n                                    <input type=\"hidden\" id=\"cardCodeName\" name=\"cardCodeName\" />\n                                    <input type=\"hidden\" id=\"autheTypeCode\" name=\"autheTypeCode\" />\n                                    <input type=\"hidden\" id=\"cardQuota\" name=\"cardQuota\" value=\"12\"/>\n                                    <!-- 셀렉트박스 -->\n                                    <input type=\"hidden\" id=\"quota\" name=\"quota\" value=\"00\"/>\n                                    <!--\n                                    <select id=\"quota\" name=\"quota\" class=\"sel_cate\">\n                                        <option value=\"\" selected=\"selected\">할부개월을 선택하세요.</option>\n                                    </select>\n                                    -->\n                                </div>\n                            </div>\n                            <p id=\"txtCardDcContext\" class=\"txt_more_card\" style=\"display: none;\"></p>\n                        </div><!--// 신용 카드 시 노출 -->\n                        <p id=\"cardNote\" style=\"margin-top: 5px;display: none;\"> - Please note that your card statement and sales history will reflect \"KGINICIS\" \"BC Card,\" or similar, and not \"Melon Ticket\" service.</p>\n                    </li>\n                    <li id=\"payMethod002\" style=\"display:none\">\n                        <div class=\"item_inp\">\n                            <input type=\"radio\" id=\"payMethodCode002\" name=\"payMethodCode\" value=\"AP0010\" title=\"Alipay Plus\" class=\"inp_g\">\n                            <span class=\"ico_radio\"></span>\n                            <label for=\"payMethodCode002\" class=\"lab_g\">\n                                <span class=\"txt_lab\">Alipay Plus</span>\n                            </label>\n                        </div>\n                    </li>\n                    <li id=\"payMethod003\" style=\"display:none\">\n                        <div class=\"item_inp\">\n                            <input type=\"radio\" id=\"payMethodCode003\" name=\"payMethodCode\" value=\"AP0011\" title=\"Paypal\" class=\"inp_g\">\n                            <span class=\"ico_radio\"></span>\n                            <label for=\"payMethodCode003\" class=\"lab_g\">\n                                <span class=\"txt_lab\">Paypal</span>\n                            </label>\n                        </div>\n                    </li>\n                </ul>\n            </div>\n            <!--// 결제수단 선택-->\n            <!-- 예매자 전체동의 -->\n            <div id=\"partCheckAgree\" class=\"box_cont box_receipt\">\n                <ul class=\"box_agree\">\n                    <li class=\"list_agree frt\">\n                        <div class=\"select_tit\"><span>Terms And Conditions</span>\n                            <div class=\"tit_check_r\">\n                                <input type=\"checkbox\" id=\"chkAgreeAll\" name=\"chkAgreeAll\" title=\"Agreed to all terms\">\n                                <label><span class=\"txt_lab\">Agreed to all terms</span></label>\n                            </div>\n                        </div>\n                    </li>\n                    <li class=\"list_agree\">\n                        <div class=\"tit_check\">\n                            <input type=\"checkbox\" id=\"chkAgree01\" name=\"chkAgree\" title=\"예매 및 취소 수수료/ 취소기한을 확인하였으며 동의합니다.\">\n                            <label><span class=\"txt_lab\">Agree with a Cancellation Policy</span></label>\n                        </div>\n                        <div class=\"box_ar_info\">\n                            <div class=\"tb_date\">\n                                <table class=\"tbl \">\n                                    <caption class=\"hide\"></caption>\n                                    <colgroup>\n                                        <col style=\"width:226px;\"/>\n                                        <col style=\"width:326px;\"/>\n                                    </colgroup>\n                                    <thead class=\"tb_date_th\">\n                                        <tr>\n                                            <th class=\"txt_gray\">Cancellation Date</th>\n                                            <th class=\"txt_gray\">Cancellation Fee</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody id=\"partCancelFeeList2\">\n                                    </tbody>\n                                </table>\n                            </div>\n                            <ul class=\"list_ds\">\n                                <li><span>- </span><span class=\"txt_og\">Service fees will not be refundable after the day of the purchase.</span></li>\n                                <li><span>- </span><span>There is no cancellation fee when you cancel your order by 11:59 pm of the day that you booked. (GMT +0900 (KST))</span></li>\n                            </ul>\n                        </div>\n                    </li>\n                    <li class=\"list_agree\">\n                        <ul>\n                            <li class=\"float_r\">\n                                <div class=\"tit_check\">\n                                    <input type=\"checkbox\" id=\"chkAgree_kakao\" name=\"chkAgree\" title=\"Consent to Kakao Terms of Use for Electronic Financial Transaction\">\n                                    <label><span class=\"txt_lab\">Consent to Kakao Terms of Use for Electronic Financial Transaction</span></label>\n                                    <a href=\"javascript: openKakaoAgree();\" class=\"btn_flexible btn_flexible_ico2 btn_detail\"><span>Detail</span></a>\n                                </div>\n                            </li>\n                            <li class=\"float_r\">\n                                <div class=\"tit_check\">\n                                    <input type=\"checkbox\" id=\"chkAgree02\" name=\"chkAgree\" title=\"Consent to the Collection and Use of the Personal Information\">\n                                    <label><span class=\"txt_lab\">Consent to the Collection and Use of the Personal Information</span></label>\n                                    <a href=\"javascript: popupAgreement('02');\" class=\"btn_flexible btn_flexible_ico2 btn_detail\"><span>Detail</span></a>\n                                </div>\n                            </li>\n                            <li class=\"float_r\">\n                                <div class=\"tit_check\">\n                                    <input type=\"checkbox\" id=\"chkAgree03\" name=\"chkAgree\" title=\"Consent to Provide of Personal Information to a Third Party\">\n                                    <label><span class=\"txt_lab\">Consent to Provide of Personal Information to a Third Party</span></label>\n                                    <a href=\"javascript: popupAgreement('03');\" class=\"btn_flexible btn_flexible_ico2 btn_detail\"><span>Detail</span></a>\n                                </div>\n                            </li>\n                            <li class=\"float_r\" id=\"simplePayAgree01\">\n                                <div class=\"tit_check\">\n                                    <input type=\"checkbox\" id=\"chkAgree04-1\" name=\"chkAgree\" title=\"Consent to Cross-border Transfer of Personal Information\">\n                                    <label><span class=\"txt_lab\">Consent to Cross-border Transfer of Personal Information</span></label>\n                                    <a href=\"javascript: popupAgreement(checkedVal(document.dForm.payMethodCode) === 'AP0010' ? '04-1' : '06');\" class=\"btn_flexible btn_flexible_ico2 btn_detail\"><span>Detail</span></a>\n                                </div>\n                            </li>\n                            <li class=\"float_r\" id=\"simplePayAgree02\">\n                                <div class=\"tit_check\">\n                                    <input type=\"checkbox\" id=\"chkAgree05\" name=\"chkAgree\" title=\"Consent to Provide of Personal Information to a Third-Party\">\n                                    <label><span class=\"txt_lab\">Consent to Provide of Personal Information to a Third-Party</span></label>\n                                    <a href=\"javascript: popupAgreement(checkedVal(document.dForm.payMethodCode) === 'AP0010' ? '05' : '07');\" class=\"btn_flexible btn_flexible_ico2 btn_detail\"><span>Detail</span></a>\n                                </div>\n                            </li>\n                        </ul>\n                    </li>\n                </ul>\n            </div>\n        <!--// 예매자 전체동의 -->\n        <!-- 우편번호 레이어팝업 -->\n        <!--// 우편번호 레이어팝업 -->\n        <!-- TICKET-3561 -->\n        <!-- 국가 선택 레이어 -->\n        <div class=\"layerPop layer_personal_info\" style=\"width:590px;top:70px;left:23px;\" id=\"selectCountry\">\n            <div class=\"la_header\">\n                <div class=\"la_header1\">\n                    <h3>Select Your Country</h3>\n                    <div class=\"popClose\">\n                        <a href=\"#\" class=\"btn_layerpopup_close\" onclick=\"$(this).closest('.layerPop').hide(); return false;\">레이어팝업닫기</a><!-- 레이어 닫기 임시 onclick 이벤트 개발시 삭제 -->\n                    </div>\n                </div>\n            </div>\n            <div class=\"la_middle\">\n                <div class=\"la_middle1\">\n                    <div class=\"box_personal\">\n                        <div class=\"inner_default\">\n                            <ul id=\"countryList\">\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"la_footer\">\n                <div class=\"la_footer1\"></div>\n            </div>\n        </div>\n        <!-- //국가 선택 레이어 -->\n        <!-- //TICKET-3561 -->\n            </form>\n        </div>\n    </div>\n    <!--// 배송/결제 영역-->\n    <!--티켓 정보 영역-->\n    <div class=\"wrap_ticket_info\">\n        <h2 class=\"logo_onestop\"><a href=\"#none\"><img src=\"https://cdnticket.melon.co.kr/resource/image/web/common/logo_onestop_en.png\" alt=\"Melon 티켓\"></a></h2>\n        <div class=\"box_info\">\n            <h3 class=\"select_tit select_t txt_prod_name\"></h3>\n              <div class=\"box_ticket\">\n                  <ul class=\"box_ticket_list\">\n                      <li class=\"nth nth1 txt_prod_schedule\"></li>\n                      <li class=\"nth nth2 txt_ticket_info\"></li>\n                  </ul>\n                  <!--좌석정보 레이어팝업-->\n                  <div class=\"layer_ticket\" id=\"layer_ticket\">\n                      <div class=\"layer_arr\"></div>\n                      <div class=\"tk_header\">\n                          <div class=\"tk_header1\">\n                              <span class=\"tk_tit\"></span>\n                          </div>\n                      </div>\n                      <div class=\"tk_middle\">\n                          <div class=\"tk_middle1\">\n                              <div class=\"tk_con\">\n                                  <ul class=\"list_ticket_info\">\n                                  </ul>\n                              </div>\n                          </div>\n                      </div>\n                      <div class=\"tk_footer\"><div class=\"tk_footer1\"></div></div>\n                  </div>\n                  <!--// 좌석정보 레이어팝업-->\n              </div>\n        </div>\n        <div class=\"box_info\">\n            <h3 class=\"select_tit\">Payment</h3>\n            <div class=\"box_ticket\">\n                <div class=\"box_total_inner\">\n                    <p class=\"tk_b\"><span class=\"tk_tit\">Ticket Price</span><span class=\"pay pay_comp\">￦<span id=\"ticketPriceTotal\">0</span></span></p>\n                    <ul class=\"list_tkpay\">\n                        <li><span class=\"tk_tit\">Fixed price</span><span class=\"pay\">￦<span id=\"basePriceTotal\">0</span></span></li>\n                        <li><span class=\"tk_tit\">Discount</span><span class=\"pay\">￦<span id=\"dcPriceTotal\">0</span></span></li>\n                    </ul>\n                </div>\n                <div class=\"box_total_inner\"><p class=\"tk_b\"><span class=\"tk_tit tk_tit_b\" >Service Fee</span><span class=\"pay pay_comp\">￦<span id=\"reservationFee\">0</span></span></p></div>\n                <div class=\"box_total_inner lst\"><p class=\"tk_b\"><span class=\"tk_tit tk_tit_b\">Shipping Fee</span><span class=\"pay pay_comp\">￦<span id=\"deliveryCost\">0</span></span></p></div>\n                <div class=\"box_total_inner box_result\"><span class=\"tk_tit tot_tit\">Total Amount</span><strong class=\"pay tot_pay\">￦<span id=\"paymentAmount\">0</span></strong></div>\n            </div>\n        </div>\n        <div class=\"box_info_bm\">\n            <div class=\"box_info_list\">\n                <ul class=\"dotlist1x1 one_list\">\n                    <li><span>Cancellation Deadline</span> : <span class=\"txt_og txt_cancel_close_dt\"></span></li>\n                    <li><span>Cancellation Fee</span> : <span class=\"txt_og txt_cancel_fee_info\"></span>\n                        <a href=\"#none\" class=\"btn_flexible btn_flexible_ico2 btn_detail specCancel\"><span>Detail</span></a>\n                        <div class=\"floating_hover_box\"><!-- 2016-01-15 신규 추가 취소수수료 -->\n                        \t<span class=\"bg_top\"></span><!-- UX-466 / 2017-07-11 -->\n                            <strong>Cancellation Fee Info</strong><!-- row가 얼마나 늘어날 수 있을까 최대5개까지는 괜찮은데요..-->\n                            <div class=\"tabling\">\n                                <table summary=\"\">\n                                    <caption></caption>\n                                    <colgroup>\n                                        <col width=\"50%\" />\n                                        <col width=\"50%\" />\n                                    </colgroup>\n                                    <thead>\n                                        <tr>\n                                            <th scope=\"col\">Cancellation Date</th>\n                                            <th scope=\"col\">Cancellation Fee</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody id=\"partCancelFeeList\">\n                                    </tbody>\n                                </table>\n                            </div>\n                            <span class=\"bg_bottom\"></span><!-- UX-466 / 2017-07-11 -->\n                        </div><!-- //2016-01-15 신규 추가 취소수수료 -->\n                    </li>\n                </ul>\n            </div>\n            <div class=\"btn_onestop\">\n                <span class=\"button btWhite frt\"><a href=\"javascript: history.back();\" class=\"btnOne\"><span>Previous</span><em class=\"one_arr prav_ar\">Previous</em></a></span>\n                <span class=\"button btNext\"><a href=\"#\" class=\"btnOne\" id=\"btnFinalPayment\">Checkout</a></span>\n            </div>\n        </div>\n    </div>\n    <!--// 티켓 정보 영역 -->\n</div>\n<div id=\"part_billing_process\" style=\"display: none;\" ></div>\n\n<div id=\"newDiv\" style=\"display: none;\">\n    <div class=\"popWrapper\" style=\"position:fixed;top:0;left:0;width:100%;height:100%;z-index:10000000000000000000000000;\">\n        <div class=\"bg\" style=\"position:absolute; top:0; left:0; width:100%; height:100%; background:#FFF;filter: alpha(opacity=60);\"></div>\n        <div id=\"divpop\" style=\"width:400px;height:200px;border-radius:5px;text-align:center;position:absolute;top:50%;left:50%;margin-left:-200px;margin-top:-100px;z-index:10000000000000000000000;\"></div>\n    </div>\n</div>\n\n<!-- ZAM-netfunnel -->\n<script type=\"text/javascript\" src=\"/resource/script/web/common/netfunnel.js\"></script>\n<script type=\"text/javascript\">\n\nvar cardData                = {};\nvar selectedTicket          = [];\nvar paysync                 = false;\nvar isNext                  = false;\nvar isKcpIsp                = false;\nvar isKcpV3d                = false;\nvar totTicketPrice = 0;\nvar willCallFlg             = false;        // '특별할인(현장수령용)' 권종그룹 추가[TICKETDEV-511] => 해당 권종은 현장수령용으로 처리\nvar seatInfoListWithPriceType = [];\nvar interlockTypeCode = parent.document.sFormSub.interlockTypeCode.value == undefined ? \"\" : parent.document.sFormSub.interlockTypeCode.value;\nvar seatingKeys = {};\n\nvar isAddressChar = function(el,msg){if(/^[a-zA-Z0-9.,\\-,\\/~ ]+$/.test(el.value)){return true;}else{if(msg){alertGlb(msg);el.focus();}return false;}}\nvar isValidChar = function(el,msg){if(/^[a-zA-Z0-9 ]+$/.test(el.value)){return true;}else{if(msg){alertGlb(msg);el.focus();}return false;}}\n\n$(function(){\n    if(parent.prodData.globalSimplePayUseYn == 'Y'){\n        $(\"#payMethod002\").show()\n        $(\"#payMethod003\").show()\n    }\n\n    $(\".item_inp\").click(function(){\n        const inputRadio = $(this).find('input[type=\"radio\"]');\n        if(inputRadio.attr(\"disabled\")){\n            return false;\n        }\n        inputRadio.prop('checked', true);\n        setPayMethod(inputRadio.attr('title'), inputRadio.val());\n        doChecking();\n    })\n\n\n});\n\nfunction doValidation() {\n    var frm                     = document.dForm;\n    var delvyTypeCode           = checkedVal(frm.delvyTypeCode);\n    var payMethodCode           = checkedVal(frm.payMethodCode);\n    var delvyTypeCnt            = $(\".radio_delvy_type\").filter(function() {return !$(this).prop(\"disabled\");}).length;\n\n    // 예매자 부가정보를 입력하세요 값 검증\n    if( !parent.addInfo.form.isValidAddInfo($(\"#addInfoInputFieldList\"), $(\"#addInfoNotice\")) ){return;}\n\n    if(delvyTypeCnt > 0) {\n        if(!isChecked(frm.delvyTypeCode, \"수령방법을 선택해주세요.\")) {\n            $(\"#partDelvyInfo\").addClass(\"open\");\n            return ;\n        }\n    }\n    // 해외 배송인 경우 배송정보 입력 validation\n    if('Y' == parent.prodData.globalDelvyYn && !willCallFlg) {\n        if (isBlank(frm.recv_country_disp, \"Select Your Country.\")) { return; }\n        if (isBlank(frm.recv_name, \"Please enter all required information.\")) { return; }\n        if (!isValidChar(frm.recv_name, \"Please enter in English or Numbers only.\")) { return; }\n        if (isBlank(frm.recv_address, \"Please enter all required information.\")) { return; }\n        if (!isAddressChar(frm.recv_address, \"Please enter in English or Numbers only.\")) { return; }\n        if (isBlank(frm.recv_city, \"Please enter all required information.\")) { return; }\n        if (!isAddressChar(frm.recv_city, \"Please enter in English or Numbers only.\")) { return; }\n        if (isBlank(frm.recv_state, \"Please enter all required information.\")) { return; }\n        if (!isAddressChar(frm.recv_state, \"Please enter in English or Numbers only.\")) { return; }\n        if (isBlank(frm.recv_zipno, \"Please enter all required information.\")) { return; }\n        if (!isAlphabetOrNumber(frm.recv_zipno, \"Please enter in English or Numbers only.\")) { return; }\n        //if (!isNumber(frm.recv_zipno, \"Please enter all required information.\")) { return; }\n        if (isBlank(frm.recv_tel1_disp, \"Select Your Country.\")) { return; }\n        if (isBlank(frm.recv_tel2, \"Please enter all required information.\")) { return; }\n        if (!isNumber(frm.recv_tel2, \"Please enter your phone number numbers only.\")) { return; }\n    }\n\n\tif(isBlank(frm.tel          , \"Please enter your mobile number numbers only.\")) {return;}\n\n\t//if(!parent.addInfo.form.isValidAddInfo(document.getElementsByName(parent._els.name.userInputField))){return;}\n\n    //if(frm.tel.value.length > 11 || frm.tel.value.length < 10 || !isNumber(frm.tel)) {alert(\"Please enter your mobile number numbers only.\"); return;}\n    //if(frm.tel.value.length > 20 || frm.tel.value.length < 10 || !isNumber(frm.tel)) {alertGlb(\"Please enter your mobile number numbers only.\"); return;}\n    if(frm.tel.value.length > 20 || frm.tel.value.length < 5 || !isNumber(frm.tel)) {alertGlb(\"Please enter your mobile number numbers only.\"); return;} // 5~10자 이내 숫자만 입력..\n    if(isBlank(frm.email        , \"Please, Enter your E-mail address.\")) {return;}\n    if(!isEmail(frm.email        , frm.email.value          , \"Please, Enter your E-mail address.\")) {return;}\n\n     if (parent.data.payAmt > 0) {\n         if(!isChecked(frm.payMethodCode , \"결제수단을 선택해주세요.\")) {return ;}\n         if (payMethodCode == \"AP0001\" || payMethodCode == \"AP0012\") {\n             if(isBlank(frm.cardCode     , replaceEnToLangCd(MSG_PROP,\"Select a card\"))) {return ;}\n             if(isBlank(frm.quota    , replaceEnToLangCd(MSG_PROP,\"Please, Select monthly plan for payment.\"))) {return ;}\n         }\n         else if (payMethodCode == \"AP0002\") {\n         }\n         else if (payMethodCode == \"AP0003\") {\n         }\n     }\n\n     if ($(\"input:checkbox[name='chkAgree']\").length != $(\"input:checkbox[name='chkAgree']:checked\").length) {\n         alertGlb(\"Please, Agree to all terms.\");\n         return;\n     }\n\n    return true;\n}\n/**\n *  checkout button fn\n *\n */\nfunction goPayment() {\n\tvar prodId = \"\";\n\tvar scheduleNo = \"\";\n\tvar seatId = \"\";\n    if (paysync) {\n        var payMethodCode = checkedVal(document.dForm.payMethodCode);\n        if (payMethodCode == \"AP0001\" || payMethodCode == \"AP0012\") {\n\n        }\n        else if (payMethodCode == \"AP0002\") {\n            try {\n                if (PAY_WIN.closed) {\n                    setLoading(false);\n                }\n                else {\n                    //alert(\"결제 진행중입니다. 잠시만 기다려 주세요.\");\n                    return;\n                }\n            }\n            catch (e) {\n                setLoading(false);\n            }\n        }\n        else {\n            //alert(\"결제 진행중입니다. 잠시만 기다려 주세요.\");\n            return;\n        }\n    }\n\n    setLoading(true);\n    if (!doValidation()) {\n        setLoading(false);\n        return;\n    }\n\n\n    $(\"#delvyZipno\").attr(\"disabled\", false);\n    $(\"#delvyAddr\").attr(\"disabled\", false);\n    parent.payParams = $(\"#dForm\").serializeArray();\n    $(\"#delvyZipno\").attr(\"disabled\", true);\n    $(\"#delvyAddr\").attr(\"disabled\", true);\n\n    // 할인권종 매수제한 체크 [DcPrice]\n    if (!parent.chkDcPrice(parent.payParams)) {\n        setLoading(false);\n        return;\n    }\n\n    parent.payParams.push({name:\"prodId\"              , value: parent.prodData.prodId});\n    parent.payParams.push({name:\"pocCode\"             , value: parent.prodData.pocCode});\n    parent.payParams.push({name:\"scheduleNo\"          , value: parent.prodData.scheduleNo});\n\n    parent.payParams.push({name:\"rsrvVolume\"          , value: parent.data.rsrvVolume});\n    parent.payParams.push({name:\"payAmt\"              , value: parent.data.payAmt});\n\n    parent.payParams.push({ name : \"cardBpId\", value : parent.$(\"#cardBpId\").val()});\n\tparent.payParams.push({ name : \"cardMid\", value : parent.$(\"#cardMid\").val()});\n\n\tprodId = parent.prodData.prodId;\n\tscheduleNo = parent.prodData.scheduleNo;\n\n    seatInfoListWithPriceType = [];//좌석정보 초기화\n\tvar addInfo = {};\n    if (parent.$(\"#flplanTypeCode\").val() == \"DR0003\") {\n        $.each(selectedTicket, function(key, val) {\n            // 일반상품 (좌석을 먼저 선택하는 경우)\n            var saveAdvtkData\t= [];\n            var seatInfo\t\t= {};\n            $.each(parent.data.seatdata, function(key1, val1) {\n                if (val.seatGradeNo == val1.grade)\n                \tseatInfo = val1;\n            });\n\n            for (var i=0 ; i < parseInt(val.selectedVolume) ; i++) {\n                parent.payParams.push({name:\"priceNo\"\t, value: val.priceNo});\n                parent.payParams.push({name:\"seatId\"\t, value: seatInfo.sid});\n                parent.payParams.push({name:\"advtkNo\"\t, value: saveAdvtkData.length > i ? saveAdvtkData[i] : \"\"});\n\n                seatInfoListWithPriceType.push({priceNo: val.priceNo,seatId: seatInfo.sid, clipSeatId : '0', gradeNm : val.seatGradeName, seatNm : '비지정', basePrice : val.basePrice, priceName : val.krPriceName , sejongPriceCode: val.sejongPriceCode });\n                addInfo.priceNo = val.priceNo;\n                seatId = seatInfo.sid;\n            }\n        });\n    }\n    else {\n        if(parent.$(\"#seatTypeCode\").val() == \"SE0003\"){\n            if (parent.$(\"#sellCondNo\").val() != null && parent.$(\"#sellCondNo\").val() != \"\") {\n                parent.payParams.push({name:\"drawOrderNo\" , value: parent.$(\"#sellCondNo\").val()});\n            }\n            $.each(selectedTicket, function(key, val) {\n                // 일반상품 (좌석을 먼저 선택하는 경우)\n                var saveAdvtkData       = [];\n                var seatInfo            = {};\n                $.each(parent.data.seatdata, function(key1, val1) {\n                    if (val.seatGradeNo == val1.grade)\n                    \tseatInfo = val1;\n                });\n\n                for (var i=0 ; i < parseInt(val.selectedVolume) ; i++) {\n                    parent.payParams.push({name:\"priceNo\"             , value: val.priceNo});\n                    parent.payParams.push({name:\"seatId\"              , value: seatInfo.sid});\n                    parent.payParams.push({name:\"advtkNo\"             , value: saveAdvtkData.length > i ? saveAdvtkData[i] : \"\"});\n\n                    seatInfoListWithPriceType.push({ priceNo : val.priceNo, seatId : seatInfo.sid, clipSeatId : '0', gradeNm : val.seatGradeName, seatNm : '비지정', basePrice : val.basePrice, priceName : val.krPriceName , sejongPriceCode: val.sejongPriceCode });\n                    addInfo.priceNo = val.priceNo;\n                }\n            });\n        }\n        else\n        {\n            var saveTicketData = {};\n            $.each(selectedTicket, function(key, val) {\n                if (saveTicketData[val.seatGradeNo] == null)\n                \tsaveTicketData[val.seatGradeNo] = [];\n                for (var i=0 ; i < parseInt(val.selectedVolume) ; i++) {\n                    saveTicketData[val.seatGradeNo].push({\n                    \tpriceNo: val.priceNo,\n                    \tseatGradeNo: val.seatGradeNo,\n                    \tbasePrice: val.basePrice,\n                    \tdcTypeCode: val.dcTypeCode,\n                    \tdcPriceTypeCode: val.dcPriceTypeCode,\n                    \tticketTypePrice: val.ticketTypePrice,\n                    \tpriceName : val.priceName,\n                    \tkrPriceName : val.krPriceName,\n                        sejongPriceCode: val.sejongPriceCode\n                   \t});\n                    addInfo.priceNo = val.priceNo;\n                }\n            });\n\n            $.each(saveTicketData, function(key, val) {\n                var saveSeatData       = [];\n                var saveAdvtkData      = [];\n                $.each(parent.data.seatdata, function(key1, val1) {\n                    if (key == val1.grade)\n                    \tsaveSeatData.push(val1);\n                });\n\n                $.each(val, function(key1, val1) {\n                    parent.payParams.push({name:\"priceNo\"\t, value: val1.priceNo});\n                    parent.payParams.push({name:\"seatId\"\t, value: saveSeatData[key1].sid});\n                    parent.payParams.push({name:\"advtkNo\"\t, value: saveAdvtkData.length > key1 ? saveAdvtkData[key1] : \"\"});\n\n                    seatInfoListWithPriceType.push({priceNo: val1.priceNo,seatId: saveSeatData[key1].sid, clipSeatId : saveSeatData[key1].csid, gradeNm : saveSeatData[key1].gn,seatNm : saveSeatData[key1].krTitle, basePrice : val1.basePrice, priceName:val1.krPriceName , sejongPriceCode: val1.sejongPriceCode });\n                    addInfo.priceNo = val1.priceNo;\n                });\n            });\n        }\n    }\n    parent.payParams.push({\n    \tname:\"seatInfoListWithPriceType\",\n    \tvalue: JSON.stringify(seatInfoListWithPriceType)\n   \t});\n\n    // 예매자 부가정보 json 데이터 만들기\n    var jaddList = $(\"#addInfoInputFieldList\").find(\"input, select\");\n    var jdataFieldNameList = []\n    jaddList.each(function (index, el) {\n        var _name = el.name;\n        if ( jdataFieldNameList.indexOf(_name) === -1 ) {\n            jdataFieldNameList.push(_name);\n        }\n    });\n\n    var inputs = [];\n    jdataFieldNameList.forEach(function(name, index){\n        inputs.push(parent.addInfo.form.inputSumValues($(\"[name='\" + name + \"']\")));\n    });\n\n\tif(inputs.length > 0){\n\t\taddInfo.inputs = inputs;\n\t\taddInfo.prodId = parent.prodData.prodId;\n\t\taddInfo.scheduleNo = parent.prodData.scheduleNo;\n\t\taddInfo.userTermsYn = $('#'+parent._els.chkAgree04).is(':checked') ? 'Y' : 'N'\n\t\tparent.payParams.push({\n\t\t\tname : \"addInfo\",\n\t\t\tvalue : parent.addInfo.form.parseAddInfo('delvy',addInfo,parent.addInfo.form.getterAddInfo())\n\t\t});\n\t}\n\n    $.each(parent.data.seatdata, function(key1, val1) {\n        delete val1.priceNo;\n    });\n\n    if (NetFunnel.gControl !== null) {\n        parent.payParams.push({name: \"netfunnel_key\", value: parent.$(\"#netfunnel_key\").val()});\n    }\n\n\t//비지정석 , 지정석 로직 분리\n\tvar flplanTypeCode \t= parent.$(\"#flplanTypeCode\").val();\n\tvar seatTypeCode\t= parent.$(\"#seatTypeCode\").val();\n\tif(flplanTypeCode == \"DR0003\"){\n\t\t//비지정형\n\t\tgoUnspecified();\n\t}else{\n\t\tif(seatTypeCode == \"SE0003\"){\n\t\t\t//비지정석\n\t\t\tgoUnspecified();\n\t\t}else{\n\t\t\t//지정석\n\t\t\tgoNoUnspecified(0);\n\t\t}\n\t}\n}\n\n\nfunction goUnspecified(){\n\t$.ajax({\n\t\ttype : \"POST\",\n\t\tdataType : \"jsonp\",\n\t\turl : APIURL + \"/glb/reservation/getNoRsrvSeq.json?v=1\",\n\t\tasync : true,\n\t\tjsonpCallback: \"getNoRsrvSeqHandler\",\n\t\tdata : parent.payParams,\n\t\tsuccess : function(result) {\n\t\t\tvar resultCode = result.code;\n\t\t\tif (resultCode == \"0000\") {\n                //LG아트센터용 비지정석 좌석 연동값세팅 START\n                if(interlockTypeCode == \"IL0003\"){\n                    parent.document.sFormSub.interlockTid.value = result.interlockTid;\n                    seatingKeys = result.seatingKeys;\n                }\n                //LG아트센터용 비지정석 좌석 연동값세팅 END\n\n\t\t\t\tgoNoUnspecified(result.noRsrvSeatSeqs);\n\t\t\t}\n            else if(resultCode == \"3100\") {\n                alert(\"Sorry. Already sold out.\");\n                setLoading(false);\n            }\n            else if(resultCode == \"3101\") {\n                alert(\"Payment procces was not done successfully. Please Try again.\");\n                setLoading(false);\n            }\n            else if (resultCode == \"T9110\") {\n                alert(replaceEnToLangCd(MSG_PROP,result.message));\n                parent.rsrvPopupClose();\n            }\n            else {\n\t\t\t\talertGlb(\"System Error. Please try again in a few minutes.\");\n\t\t\t\tsetLoading(false);\n\t\t\t}\n\t\t},\n\t\terror : function(xhr, status, error) {\n\t\t\talertGlb(\"System Error. Please try again in a few minutes.\");\n\t\t\tsetLoading(false);\n\t\t}\n\t});\n\n}\n\nfunction goNoUnspecified(noRsrvSeatSeqs){\n\tvar flplanTypeCode \t= parent.$(\"#flplanTypeCode\").val();\n\tif(noRsrvSeatSeqs != \"0\" || noRsrvSeatSeqs != 0){\n\t\t$.each( noRsrvSeatSeqs, function(key, val) {\n\t\t\tparent.payParams.push({ name : \"noRsrvSeatSeq\", value : val });\n\t\t});\n\t}\n\n    var firstSeatId = 0; //default 0\n    var firstTicket = [];\n    $.each(parent.typeData, function(key, val) {\n        if (parseInt(val.selectedVolume) > 0) {\n            firstTicket = val;\n            return false; //break\n        }\n    });\n\n    var seatInfo = {};\n    $.each(parent.data.seatdata, function(key1, val1) {\n               if (firstTicket.seatGradeNo == val1.grade){\n            firstSeatId = val1.sid;\n            return false; //break\n        }\n    });\n    parent.payParams.push({ name : \"firstSeatId\", value : firstSeatId });\n    parent.payParams.push({ name : \"sellTypeCode\", value : parent.$(\"#sellTypeCode\").val() });\n    parent.payParams.push({ name : \"chkcapt\"     , value : Captcha.getData()});\n\n    //LG아트센터용 연동값세팅\n    var frm = document.dForm;\n    if(interlockTypeCode == \"IL0003\"){\n        parent.payParams.push({ name : \"interlockTid\", value : parent.document.sFormSub.interlockTid.value});\n\n        $.each(seatInfoListWithPriceType, function(key, val) {\n            $.each(seatingKeys, function(key2, val2) {\n                if(val2.gradeName == val.gradeNm){\n                    if(val2.setFlag != \"Y\"){\n                        val.seatingId = val2.seatingId;\n                        val2.setFlag = \"Y\";\n                        return false;\n                    }\n                }\n            });\n        });\n        $.each(parent.payParams, function(key3, val3) {\n            if(val3.name == \"seatInfoListWithPriceType\"){\n                val3.value = JSON.stringify(seatInfoListWithPriceType);\n            }\n        });\n    }\n\n\t $.ajax({\n\t type           : \"POST\"\n\t , dataType     : \"jsonp\"\n\t , url          : APIURL + \"/glb/reservation/save.json?v=1\"\n\t , async        : true\n\t , jsonpCallback: \"saveHandler\"\n\t , data         : parent.payParams\n\t , success      : function(result) {\n\t     if(result.code == \"0000\") {\n\t         parent.payParams.push({name: \"rsrvSeq\"              , value: result.rsrvSeq});\n\t         parent.payParams.push({name: \"payNo\"                , value: result.payNo});\n             goCheckPayment(result);\n         } else if(result.code == \"T8900\" || result.code == \"T9110\") {\n             setLoading(false);\n             alert(replaceEnTo(langCd, MSG_PROP, result.message));\n             parent.rsrvPopupClose();\n         } else if(result.code == 'T0002') {\t\t\t // T0002 : 인증 미완료시\n\t         setLoading(false);\n\t\t     Captcha.setData('');\n\t\t     parent.captchaObj.show();\n         } else if (result.code == \"T5100\") {\n             setLoading(false);\n             alert(result.message);\n             window.parent.close();\n         } else if(result.code == 'T8887'){ //영어 이름 체크\n             setLoading(false);\n             alertGlb(\"Enter your full name. (English only, must match your passport)\");\n         } else if(result.code == 'T8889'){  //저장된 회원 이름이 없을 경우 메시지 없이 그냥 예매종료처리\n             setLoading(false);\n             parent.rsrvPopupClose();\n         } else if (result.code.startsWith(\"T950\")) {        // eKYC 실패 코드 (T950x 모두 차단)\n             setLoading(false);\n             parent.rsrvPopupClose();\n         }\n         else {\n\t         //alert(replaceEnToLangCd(MSG_PROP,result.message) + \" [\" + result.code + \"]\");\n\t         //alert(result.message + \" [\" + result.code + \"]\");\n\t         alertGlb(result.message);\n\t        \tsetLoading(false);\n\t    \t\tvar flplanTypeCode = parent.$(\"#flplanTypeCode\").val();\n\t         if (flplanTypeCode == \"DR0001\") {\t//전체형\n\t             location.href          = CTX + \"/reservation/popup/stepSeat.htm\";\n\t         }\n\t         else if (flplanTypeCode == \"DR0002\") {\t//블록형\n\t             location.href          = CTX + \"/reservation/popup/stepBlock.htm\";\n\t         }else{ // 그 외 비지정형\n\t        \t history.back();\n\t         }\n\t     }\n\t }\n\t , error        : function(xhr, status, error) {\n         if(xhr.status == 504) {\n   \t         alertGlb(\"Payment process was not done successfully. Please Try again.\");\n   \t         setLoading(false);\n         }\n         else {\n   \t         alertGlb(\"Payment process was not done successfully. Please Try again.\");\n   \t         setLoading(false);\n         }\n\t }\n\t});\n}\n\nfunction goCheckPayment(pdata) {\n    var payMethodCode           = pdata.payMethodCode;\n    $.each(parent.payParams, function(key, val){\n        if (val.name == \"payMethodCode\") val.value = payMethodCode;\n    });\n\n    // HOEON\n    pdata.card_pay_method = \"GLB\";\n\n\n    if ([\"AP0001\", \"AP0012\", \"AP0010\", \"AP0011\"].includes(payMethodCode)) {\n\n        $(\"#part_billing_process\").empty();\n        $(\"#divpop\").empty();\n        if(pdata.card_pay_method == \"GLB\") {\n\n            $.ajax({\n                type : \"POST\",\n                url : CTX + \"/reservation/ajax/payInitForm.htm?procMode=R\",\n                async : false,\n                data : pdata,\n                success : function(result) {\n                    sessionStorageControl(true);\n                    $(\"#newDiv\").show();\n                    $(\"#divpop\").html(result);\n                },\n                error : function(e) {\n                    sessionStorageControl(false);\n                    setLoading(false);\n                    alertGlb(\"Failed to load the page.\");\n                }\n            });\n        }\n    }\n    else if (payMethodCode == \"AP0007\" || payMethodCode == \"AP0006\"   || payMethodCode == \"AP0005\" ) {\n    \tdoFinish(pdata.rsrvSeq);\n    }\n}\n\nfunction doFinish(rsrvSeq) {\n    sessionStorageControl(true);\n\n    var params = $.param({\n        rsrvSeq:rsrvSeq,\n        langCd:langCd\n    });\n\n    parent.location.href      = \"/reservation/popup/stepFinish.htm\"+\"?\"+params;\n}\n\nfunction setDeliveryType(delvyTypeCode) {\n    var delvyInfo                       = $(\"<span/>\");\n    var txtDelvyMethod                  = \"\";\n    var txtDelvyFee                     = parent.prodData.delvyFee == null ? \"0\" : parent.prodData.delvyFee;\n    $(\"#part_delivery_info\").css({display:(delvyTypeCode == \"DV0003\" ? \"\" : \"none\")});\n    $(\"#txtDeliveryInfo\").empty();\n\n    parent.data.deliveryTypeCode        = delvyTypeCode;\n    parent.data.deliveryCost            = delvyTypeCode == \"DV0003\" ? txtDelvyFee : 0;\n\n    if (delvyTypeCode == \"DV0002\") {\n        //delvyInfo.append(\"공연 당일 현장 교부처에서 예매번호 및 본인 확인 후 티켓을 수령하여 입장이 가능합니다.\");\n    }\n    else if (delvyTypeCode == \"DV0003\") {\n\n\t\tvar batchDelvyDt = parent.prodData.batchDelvyDt;\n\n\t\tif (batchDelvyDt != null && batchDelvyDt != \"\" ) {\n\t\t\tvar now = new Date();\n\t\t\tvar batchDt = new Date(Number(batchDelvyDt.substring(0,4)),Number(batchDelvyDt.substring(4,6)) - 1,Number(batchDelvyDt.substring(6,8)));\n\n\t\t\tif(now.getTime() < batchDt.getTime()){ // 현재시각과 일괄배송날짜 시각 비교\n\n\t\t\t\tvar batchDelvyDtStr = parseInt(batchDelvyDt.substr(4, 2), 10) + \"월 \" + parseInt(batchDelvyDt.substr(6, 2), 10) + \"일\";\n\t\t\t\tdelvyInfo.text(batchDelvyDtStr + \" 일괄발송(발송일기준 최대 4~5일 이내 배송)\");\n\t\t\t} else {\n\n\t\t\t\tdelvyInfo.append(\"예매완료(결제익일) 기준으로 4~5일 이내 배송됩니다.(주말/공휴일을 제외한 영업일 기준)\");\n\t\t\t}\n\t\t} else {\n\n\t\t\tdelvyInfo.append(\"예매완료(결제익일) 기준으로 4~5일 이내 배송됩니다.(주말/공휴일을 제외한 영업일 기준)\");\n\t\t}\n    }\n    else if (delvyTypeCode == \"DV0004\") {\n        delvyInfo.append(\"종이티켓 없이 현장에서 모바일티켓을 제시하면 입장이 가능합니다.\");\n    }\n\n    $(\"#txtDeliveryInfo\").append(delvyInfo);\n\n    setFinalCalc();\n}\n\n// function setPayMethodCode(obj) {\n//     setPayMethod(obj.title, obj.value);\n// }\n\nfunction setPayMethod(tlt, val) {\n    var payMethodCode              = val == undefined ? \"\" : val;\n    var payMethodTitle             = tlt == undefined ? \"\" : tlt;\n\n    $dom.partPaymentCard.hide();\n    $dom.partPaymentMobl.hide();\n    $dom.partPaymentVbank.hide();\n    $dom.cardNote.hide();\n    $dom.simplePayAgree01.hide();\n    $dom.simplePayAgree02.hide();\n    if (payMethodCode == \"AP0001\" || payMethodCode == \"AP0012\") {\n        $dom.partPaymentCard.show();\n        $dom.cardNote.show();\n    }else if(payMethodCode == \"AP0010\" || payMethodCode == \"AP0011\"){\n        $dom.simplePayAgree01.show();\n        $dom.simplePayAgree02.show();\n    }\n}\n\nfunction setCardContent(cardCode) {\n    $(\"#txtCardPointName\").text(\"\");\n    $(\"#txtCardDcContext\").text(\"\").hide();\n    $(\"#partCardPointInfo\").hide();\n\n    $.each(cardData, function(key, val) {\n        if (cardCode == val.cardBpId) {\n            $(\"#cardCodeName\").val(val.cardBpName);\n            $(\"#autheTypeCode\").val(val.autheTypeCode);\n            if (val.cardDcList != null && val.cardDcList != undefined) {\n                $.each(val.cardDcList, function(key1, val1) {\n                    $(\"#txtCardDcContext\").append(val1.dcContent != null && val1.dcContent != \"\" ? ($(\"#txtCardDcContext\").text() == \"\" ? \"\" : \"<br/>\") + val1.dcContent : \"\");\n                });\n                if ($(\"#txtCardDcContext\").text() != \"\") $(\"#txtCardDcContext\").show();\n            }\n\n            if (val.pointUseYn == \"Y\") {\n                $(\"#partCardPointInfo\").show();\n                $(\"#txtCardPointName\").text(val.pointName);\n            }\n            else {\n                $(\"#partCardPointInfo\").hide();\n                $(\"#txtCardPointName\").text(\"\");\n            }\n        }\n    });\n\n    doChecking();\n}\n\nfunction setFinalCalc() {\n    var basePrice                   = 0;\n    var ticketCount                 = 0;\n    var selectedBaseTotal           = 0;\n    var selectedPriceTotal          = 0;\n    var paymentAmount               = 0;\n    var dcPriceTotal                = 0;\n    var reservationFee              = 0;\n    var deliveryCost                = 0;\n    var chargeTotal                 = 0;\n    var discountTotal               = 0;\n    var seatGradeData               = {};\n\n    $.each(selectedTicket, function(key, val) {\n        selectedBaseTotal       += (parseInt(val.basePrice, 10) * parseInt(val.selectedVolume, 10));\n        selectedPriceTotal      += (parseInt(val.ticketTypePrice, 10) * parseInt(val.selectedVolume, 10));\n        ticketCount             += parseInt(val.selectedVolume, 10);\n        basePrice               = parseInt(val.basePrice, 10);\n\n        if (seatGradeData[val.seatGradeNo] == null || seatGradeData[val.seatGradeNo] == undefined) {\n            seatGradeData[val.seatGradeNo] = {\"seatGradeName\" : val.seatGradeName, \"selectedVolume\" : val.selectedVolume};\n        }\n        else {\n            seatGradeData[val.seatGradeNo].selectedVolume = parseInt(seatGradeData[val.seatGradeNo].selectedVolume, 0) +  parseInt(val.selectedVolume, 0);\n        }\n    });\n\n    reservationFee              = parseInt(parent.prodData.rsrvFee, 10) * ticketCount;\n    deliveryCost                = parseInt($(\"#recv_delvy_price\").val(), 10);\n    dcPriceTotal                = selectedBaseTotal - selectedPriceTotal;\n    chargeTotal                 = selectedBaseTotal + reservationFee + deliveryCost;\n    discountTotal               = dcPriceTotal;\n    paymentAmount               = chargeTotal - discountTotal;\n\n    $(\"#ticketPriceTotal\").text(addComma(selectedBaseTotal - discountTotal));\n    $(\"#basePriceTotal\").text(addComma(selectedBaseTotal));\n    $(\"#reservationFee\").text(addComma(reservationFee));\n    $(\"#deliveryCost\").text(addComma(deliveryCost));\n    $(\"#dcPriceTotal\").text(addComma(-dcPriceTotal));\n    $(\"#paymentAmount\").text(addComma(paymentAmount));\n\n    parent.data.rsrvVolume             = ticketCount;\n    parent.data.payAmt                 = paymentAmount;\n\n    if (paymentAmount <= 0) {\n        $('ul.list_receipt_how.type02 input[type=\"radio\"]').prop({disabled: true});\n        $('ul.list_receipt_how.type02 span.txt_lab').css(\"color\", \"#ccc\");\n        setPayMethod(\"\", \"\");\n    }\n    else {\n        setPayMethodInit();\n        if ($('ul.list_receipt_how.type02 input[type=\"radio\"]:checked').length > 0) {\n            setPayMethod($('ul.list_receipt_how.type02 input[type=\"radio\"]:checked').text(), $('ul.list_receipt_how.type02 input[type=\"radio\"]:checked').val());\n        }\n        else {\n            setPayMethod(\"\", \"\");\n        }\n    }\n\n}\n\nfunction bindDelvyMethList(delvy) {\n    $.each(selectedTicket, function(key, val) {\n        willCallFlg = (val.dcTypeCode == 'DP0016')?true:willCallFlg;\n    });\n\n    $(\"#partDeliveryType\").empty();\n    var nonPostDelvyCount               = 0;\n    // for Global\n\n    // 배송, 현장수령, 모바일 티켓\n    if (willCallFlg) {\n        // 무조건 현장 수령\n        var glbDelCd = 'DV0002';\n        var delvyobj = $(\"<li id=\\\"delvyType\" + glbDelCd + \"\\\" >\");\n        delvyobj.append(\"<input type=\\\"radio\\\" id=\\\"delvyTypeCode\" + glbDelCd + \"\\\" name=\\\"delvyTypeCode\\\" value=\\\"\" + glbDelCd + \"\\\" class=\\\"radio_delvy_type\\\" title=\\\"Will Call\\\">\");\n        delvyobj.append(\"<label class=\\\"label-radio\\\" for=\\\"delvyTypeCode\" + glbDelCd + \"\\\" ><span class=\\\"txt_lab\\\" id=\\\"delvyTypeName\" + glbDelCd + \"\\\" style=\\\"color:#ccc\\\">Will Call</span></label>\");\n        delvyobj.append(\"<p class=\\\"txt_more txt_gray\\\">You have to bring your passport to the ticket office to check your tickets.</p>\");\n        $(\"#partDeliveryType\").append(delvyobj);\n        $(\"#delvyTypeCodeDV0002\").attr(\"checked\", true);\n        $(\"#delvyTypeNameDV0002\").css(\"color\", \"\");\n        $(\"#addrInfo\").hide();\n    } else if('Y' == parent.prodData.globalDelvyYn) {\n        var glbDelCd = 'DV0006';\n        var delvyobj = $(\"<li id=\\\"delvyType\" + glbDelCd + \"\\\" >\");\n        delvyobj.append(\"<input type=\\\"radio\\\" id=\\\"delvyTypeCode\" + glbDelCd + \"\\\" name=\\\"delvyTypeCode\\\" value=\\\"\" + glbDelCd + \"\\\" class=\\\"radio_delvy_type\\\" title=\\\"shipping\\\">\");\n        delvyobj.append(\"<span class=\\\"txt_lab\\\" id=\\\"delvyTypeName\" + glbDelCd + \"\\\" style=\\\"color:#ccc\\\">International Shipping</span> (EMS)\");\n        delvyobj.append(\"<p class=\\\"txt_more txt_gray\\\">Shipping Schedule : To be announced</p>\");\n        $(\"#partDeliveryType\").append(delvyobj);\n        $(\"#delvyTypeCodeDV0006\").attr(\"checked\", true);\n        $(\"#delvyTypeNameDV0006\").css(\"color\", \"\");\n        $(\"#addrInfo\").show();\n    } else {\n        var glbDelCd = 'DV0002';\n        var delvyobj = $(\"<li id=\\\"delvyType\" + glbDelCd + \"\\\" >\");\n        delvyobj.append(\"<input type=\\\"radio\\\" id=\\\"delvyTypeCode\" + glbDelCd + \"\\\" name=\\\"delvyTypeCode\\\" value=\\\"\" + glbDelCd + \"\\\" class=\\\"radio_delvy_type\\\" title=\\\"Will Call\\\">\");\n        delvyobj.append(\"<label class=\\\"label-radio\\\" for=\\\"delvyTypeCode\" + glbDelCd + \"\\\" ><span class=\\\"txt_lab\\\" id=\\\"delvyTypeName\" + glbDelCd + \"\\\" style=\\\"color:#ccc\\\">Will Call</span></label>\");\n        delvyobj.append(\"<p class=\\\"txt_more txt_gray\\\">You have to bring your passport to the ticket office to check your tickets.</p>\");\n        $(\"#partDeliveryType\").append(delvyobj);\n\n        var glbDelCd = 'DV0004';\n        var delvyobj = $(\"<li id=\\\"delvyType\" + glbDelCd + \"\\\" >\");\n        delvyobj.append(\"<input type=\\\"radio\\\" id=\\\"delvyTypeCode\" + glbDelCd + \"\\\" name=\\\"delvyTypeCode\\\" value=\\\"\" + glbDelCd + \"\\\" class=\\\"radio_delvy_type\\\" title=\\\"Mobile Ticket\\\">\");\n        delvyobj.append(\"<label class=\\\"label-radio\\\" for=\\\"delvyTypeCode\" + glbDelCd + \"\\\" ><span class=\\\"txt_lab\\\" id=\\\"delvyTypeName\" + glbDelCd + \"\\\" style=\\\"color:#ccc\\\">Mobile Ticket</span></label>\");\n        delvyobj.append(\"<p class=\\\"txt_more txt_gray\\\">You will be allowed to enter the event with a Mobile Ticket. (A paper ticket is not necessary)</p>\");\n        $(\"#partDeliveryType\").append(delvyobj);\n\n        if (parent.prodData.spotRecvYn == 'Y') {\n            $(\"#delvyTypeCodeDV0002\").attr(\"checked\", true);\n            $(\"#delvyTypeCodeDV0002\").attr(\"disabled\", false);\n            $(\"#delvyTypeNameDV0002\").css(\"color\", \"\");\n\n            if (parent.prodData.globalMobileRecvYn == 'Y') {\n                $(\"#delvyTypeCodeDV0004\").attr(\"checked\", false);\n                $(\"#delvyTypeCodeDV0004\").attr(\"disabled\", false);\n                $(\"#delvyTypeNameDV0004\").css(\"color\", \"\");\n            } else {\n                $(\"#delvyTypeCodeDV0004\").attr(\"checked\", false);\n                $(\"#delvyTypeCodeDV0004\").attr(\"disabled\", true);\n\n            }\n        } else if (parent.prodData.globalMobileRecvYn == 'Y') {\n            $(\"#delvyTypeCodeDV0002\").attr(\"checked\", false);\n            $(\"#delvyTypeCodeDV0002\").attr(\"disabled\", true);\n\n            $(\"#delvyTypeCodeDV0004\").attr(\"checked\", true);\n            $(\"#delvyTypeCodeDV0004\").attr(\"disabled\", false);\n            $(\"#delvyTypeNameDV0004\").css(\"color\", \"\");\n        } else {\n            $(\"#delvyTypeCodeDV0002\").attr(\"checked\", true);\n            $(\"#delvyTypeCodeDV0002\").attr(\"disabled\", false);\n            $(\"#delvyTypeNameDV0002\").css(\"color\", \"\");\n\n            $(\"#delvyTypeCodeDV0004\").attr(\"checked\", false);\n            $(\"#delvyTypeCodeDV0004\").attr(\"disabled\", true);\n        }\n\n        $(\"#addrInfo\").hide();\n\n    }\n\n    // if ($(\"input:radio[name='delvyTypeCode']:enabled\").length == 1) {\n    // \tvar chkDelvyType = $(\"input:radio[name='delvyTypeCode']:enabled\");\n    // \tchkDelvyType\n    // \t//setDeliveryType(chkDelvyType.val());\n    // }\n}\n\nfunction bindCardBpList(bpdata) {\n    var cardCode        = $(\"#cardCode\");\n    var cardGroupId     = parent.$(\"#cardGroupId\").val() == undefined || parent.$(\"#cardGroupId\").val() == null ? \"\" : parent.$(\"#cardGroupId\").val();\n    var cardBpId        = parent.$(\"#cardBpId\").val() == undefined || parent.$(\"#cardBpId\").val() == null ? \"\" : parent.$(\"#cardBpId\").val();\n    var selectBpId      = \"\";\n    cardData            = bpdata;\n\n    cardCode.empty();\n    cardCode.append($(\"<option/>\").val(\"\").text(replaceEnToLangCd(MSG_PROP,\"Select a card\")).attr({selected:\"selected\"}));\n    if (cardGroupId == \"\" && cardBpId == \"\") {\n        $.each(bpdata, function(key, val) {\n            cardCode.append($(\"<option/>\").val(val.cardBpId).text(val.cardBpName));\n        });\n    }\n    else {\n        $.each(bpdata, function(key, val) {\n            cardCode.append($(\"<option/>\").val(val.cardBpId).attr({selected: (key == 0 ? \"selected\" : \"\")}).text(val.cardBpName));\n            if (key == 0) selectBpId = val.cardBpId\n        });\n\n        setCardContent(selectBpId);\n    }\n}\n\nfunction bindAgreement(agreeInfo) {\n    if (agreeInfo == null || agreeInfo == undefined) {\n        $(\".agree_terms_approval\").show();\n    }\n    else {\n        if (agreeInfo.useYn == \"Y\") {\n            $(\".agree_terms_approval\").remove();\n        }\n        else {\n            $(\".agree_terms_approval\").show();\n        }\n    }\n}\n\nfunction setDelvySameasInfo(obj) {\n    if (obj.checked) {\n        $(\"#delvyName\").val($(\"#userName\").html());\n        $(\"#delvyTel\").val($(\"#tel\").val());\n    }\n}\n\nfunction setPayMethodInit() {\n    $('ul.list_receipt_how.type02 input[type=\"radio\"]').prop({disabled: false});\n    $('ul.list_receipt_how.type02 span.txt_lab').css(\"color\", \"\");\n}\n\nfunction deliveryInit() {\n\n\tvar params = parent.$(\"#sForm\").serialize();\n    $.ajax({\n        type           : \"POST\"\n        , dataType     : \"jsonp\"\n        , url          : APIURL + \"/glb/product/delivery.json?v=1\"\n        , async        : false\n        , data         : params\n        , success      : function(result) {\n            if(result.result == -1) {\n                alertGlb(\"Service is delayed.\");\n                history.back();\n            }\n            else {\n                bindDelvyMethList(result.dvCodeList);\n                bindCardBpList(result.cardBpList);\n                bindAgreement(result.termsInfo);\n                if(result.countryList != null && result.countryList.length > 0) {\n                    bindCountryList(result.countryList);\n                }\n\n                $(\"#userName\").html(\"xin chen\");\n                $(\"#tel\").val(\"\");\n                $(\"#email\").val(\"yanyumochenai@gmail.com\");\n                doChecking();\n            }\n\n            if (result.trafficCtrlYn == \"Y\") {\n                //Netfunnel 명시적 완료처리\n                NetFunnel_aliveNotice(\n                    {\n                        ipblock: function(ev, ret) {\n                            return false;\n                        },\n                        block: function(ev,ret) {\n                            alert(ret.data.msg);\n                            return false;\n                        }\n                    }\n                );\n            }\n\n            // 예매자 부가정보 입력\n            parent.addInfo.form.defaultSetInputData(result);\n\n        }\n        , error        : function(e) {\n            alertGlb(\"Service is delayed.\");\n        }\n    });\n\n    setPayMethodInit();\n\n    setFinalCalc();\n}\n\nfunction setLoading (isloading) {\n    paysync         = isloading;\n    if (isloading) {\n        loadingOpen(replaceEnToLangCd(MSG_PROP,\"The payment is in progress. Please, Wait.\"));\n        $(\"#loadingLayer\").click(function() {\n            var payMethodCode           = checkedVal(document.dForm.payMethodCode);\n            if (payMethodCode == \"AP0001\" || payMethodCode == \"AP0012\") {\n\n            }\n            else if (payMethodCode == \"AP0002\") {\n                try {\n                    if (PAY_WIN.closed) {\n                        setLoading(false);\n                    }\n                    else {\n                        //alert(\"결제 진행중입니다. 잠시만 기다려 주세요.\");\n                        return;\n                    }\n                }\n                catch (e) {\n                    setLoading(false);\n                }\n            }\n            else {\n                //alert(\"결제 진행중입니다. 잠시만 기다려 주세요.\");\n                return;\n            }\n        });\n    }\n    else {\n        loadingClose();\n    }\n}\n\n$dom = {};\n$(document).ready(function() {\n    $dom.delvyCategory = $(\"#delvyCategory\");\n    $dom.btnFinalPayment = $(\"#btnFinalPayment\");\n    $dom.partDelvyCategory = $(\"#partDelvyCategory\");\n    $dom.partPaymentCard = $(\"#partPaymentCard\");\n    $dom.cardNote = $(\"#cardNote\");\n    $dom.simplePayAgree01 = $(\"#simplePayAgree01\");\n    $dom.simplePayAgree02 = $(\"#simplePayAgree02\");\n    $dom.cardNote = $(\"#cardNote\");\n    $dom.partPaymentMobl = $(\"#partPaymentMobl\");\n    $dom.partPaymentVbank = $(\"#partPaymentVbank\");\n    parent.$dom.addInfo.addInfo = $(\"#\" + parent._els.addInfo);\n\tparent.$dom.addInfo.addInfoTitle = $(\"#\" + parent._els.addInfoTitle);\n\tparent.$dom.addInfo.addInfoInputFieldList = $(\"#\" + parent._els.addInfoInputFieldList);\n\tparent.$dom.addInfo.addInfoInputFieldListTemplate = $(\"#\" + parent._els.addInfoInputFieldListTemplate);\n    parent.$dom.addInfo.addInfoNotice = $(\"#\" + parent._els.addInfoNotice);\n\n\tif(\n            parent.prodData.prodId == 100169\n         || parent.prodData.prodId == 200013\n         || parent.prodData.prodId == 200659\n         || parent.prodData.prodId == 100146\n    ){\n        $(\"#addInfoG7\").show();\n    }\n\n\tlangCd = parent.langCd; //MNL 전역 변수의 값을 변경\n\n    $(\"div.section_onestop\")[0].style.display = \"none\"; /*MNL*/\n    initload(function(){\n        replaceAllEnToLangCd($(\"div.section_onestop\")[0],function(){\n            $(\"div.section_onestop\")[0].style.display = \"\";\n        });\n    });\n\n    if('' == null || '' == '' || '' == '0000'){\n\n    }else{\n\n    \tvar kcpRes = parent.findKcpResObj('', '');\n\n\t\talert(\"[\" + kcpRes.res_cd + \"] \" + replaceEnToLangCd(MSG_PROP,kcpRes.res_msg_glb));\n\n    \t//alert('['+''+']'+'');\n    }\n\n});\n\nfunction initload(callback) {\n\n    parent.data.rsrvVolume          = 0;\n    parent.data.payAmt              = 0;\n    parent.data.deliveryTypeCode    = \"\";\n    parent.data.deliveryCost        = 0;\n\n    $.each(parent.typeData, function(key, val) {\n        if (parseInt(val.selectedVolume) > 0) {\n            selectedTicket.push(val);\n            totTicketPrice += (\n                parseInt(val.ticketTypePrice, 10) * parseInt(val.selectedVolume, 10)\n            );\n        }\n    });\n    parent.addInfo.form.setAddInfo('delvy',parent.prodData);\n\n   \t$(\"#partPaymentInfo\").show();\n\t$(\"#partCheckAgree\").show();\n\t$dom.btnFinalPayment.text(replaceEnToLangCd(MSG_PROP,\"Checkout\"));\n\n\n    parent.setProdSchedule();\n\n    parent.setProdSeat();\n\n    parent.setCancelInfo($(\"#partCancelFeeList\"));\n    setCancelFeeInfo($(\"#partCancelFeeList2\"));\n\n    parent.setRsrvNavi(\"3\");\n\n    deliveryInit();\n\n    $(\"#chkAgreeAll\").click(function() {\n        $(\"input:checkbox[name='chkAgree']\").prop(\"checked\", this.checked);\n        doChecking();\n    });\n\n    $(\"input:checkbox[name='chkAgree']\").click(function() {\n        if (this.checked) {\n            if ($(\"input:checkbox[name='chkAgree']\").length == $(\"input:checkbox[name='chkAgree']:checked\").length) {\n                $(\"#chkAgreeAll\").prop(\"checked\", this.checked);\n            }\n        }\n        else {\n            $(\"#chkAgreeAll\").prop(\"checked\", this.checked);\n        }\n        doChecking();\n    });\n\n    $(\"input[name='payMethodCode']\").change(function(){\n        doChecking();\n    });\n\n    $dom.btnFinalPayment.click(function(event) {\n        event.preventDefault();\n        if ($(this).parent().filter(\".on\").length > 0) {\n            goPayment();\n        }\n    });\n\n  \t//2017-03-08 jhshin 프로그레스바 이동시 문구에 따라 이동하는 이벤트\n    $(document).on('click', '.btn_o_menu01', function ($event) {\n        $event.stopPropagation();\n\n        if (!confirm(replaceEnToLangCd(MSG_PROP, \"Are you sure you want to leave? You’ll lose your selected seats.\"))) {\n            $event.preventDefault();\n        } else {\n            parent.cancelLock();\n        }\n    });\n\n    callback != undefined && typeof callback == 'function' ? callback() : '';\n}\n\nfunction setCancelFeeInfo (cancelFeeObj) { //cancelfee.json\n\t$.each(parent.feeData, function(key, val) {\n\t\tif(val.TODAY == val.FROMDT && val.CANCELFEETXT != 'None'){ //무부과 기간은 지났지만 예매당일 일시\n       \t\tvar trobjDummy           = $(\"<tr/>\");\n        \tvar toDay = convertDateFormatOnlyDate(val.TODAY);\n            trobjDummy.append(\"<td>\"+toDay+\"</td>\");\n            trobjDummy.append(\"<td>\"+replaceEnToLangCd(COMMON_PROP, \"None\")+\"</td>\");\n            trobjDummy.appendTo(cancelFeeObj);\n\n            var todayDate = new Date();\n        \ttodayDate.setDate( todayDate.getDate() + 1);\n        \tvar yy = todayDate.getFullYear();\n        \tvar mm = todayDate.getMonth()+1; mm = (mm < 10) ? '0' + mm : mm;\n        \tvar dd = todayDate.getDate(); dd = (dd < 10) ? '0' + dd : dd;\n\n            var cancelStartDt       = convertDateFormatOnlyDate(yy + \"\" + mm + \"\" + dd);\n            var cancelEndDt         = convertDateFormatOnlyDate(val.TODT);\n            if (val.TODT < val.FROMDT) cancelEndDt = convertDateFormatOnlyDate(val.FROMDT);\n        }\n        else {\n            var cancelStartDt       = convertDateFormatOnlyDate(val.FROMDT);\n            var cancelEndDt         = convertDateFormatOnlyDate(val.TODT);\n            if (val.TODT < val.FROMDT) cancelEndDt = convertDateFormatOnlyDate(val.FROMDT);\n        }\n\n       \tvar trobj           = $(\"<tr/>\");\n        if(cancelStartDt <= cancelEndDt){\n        \tif (cancelStartDt == cancelEndDt) {\n                trobj.append(\"<td>\" + cancelStartDt + \"</td>\");\n            }\n            else {\n                trobj.append(\"<td>\" + cancelStartDt + \" ~ \" + cancelEndDt + \"</td>\");\n            }\n        \ttrobj.append(\"<td>\" + val.CANCELFEETXT + \"</td>\");\n\n            trobj.appendTo(cancelFeeObj);\n        }\n    });\n}\n\nfunction doChecking() {\n    isNext                      = true;\n    if (parent.data.payAmt > 0) {\n        if (checkedVal(document.dForm.payMethodCode) == \"\"){\n       \t\tisNext = false;\n        }else{\n\t        \tif(document.dForm.payMethodCode.value == 'AP0001' || document.dForm.payMethodCode.value == 'AP0012') {\n                    if (document.dForm.cardCode.value == '') {\n                        isNext = false;\n                    }\n                }\n        }\n    }\n    if ($(\"input:checkbox[name='chkAgree']\").length != $(\"input:checkbox[name='chkAgree']:checked\").length) {\n        isNext = false;\n    }\n\n    if (isNext) {\n        $dom.btnFinalPayment.parent().addClass(\"on\");\n    }\n    else {\n        $dom.btnFinalPayment.parent().removeClass(\"on\");\n    }\n}\n\nfunction updateNationalCode(cntryCode, name, cntryNoCode, price, _this) {\n    $(\"#recv_country_disp\").val(name);\n    $(\"#recv_country\").val(name);\n    $(\"#recv_tel1_disp\").val(cntryNoCode);\n    $(\"#recv_tel1\").val(cntryNoCode);\n    $(\"#recv_country_code\").val(cntryCode);\n    $(\"#recv_delvy_price\").val(price);\n    updateShippingFee(price);\n    $(_this).closest('.layerPop').hide();\n    return false;\n}\n\nfunction updateShippingFee(price) {\n    setFinalCalc();\n}\n\nfunction bindCountryList(list) {\n    if(list != null && list.length > 0) {\n        $.each(list, function (key, item) {\n            var objHtm = '<li><button onclick=\"updateNationalCode('+ item.cntryCode +', \\''+ item.cntryEnName.replace(\"\\n\", \" \").replace(\"'\",\"\\\\'\") +'\\',\\''+ item.cntryNoCode +'\\','+ item.weightPrice +', this);return false;\">'+item.cntryEnName.replace(\"\\n\", \" \")+'</button></li>';\n            $(\"#countryList\").append(objHtm);\n        });\n    }\n\n}\n\n/*\n * 배송지 상세주소 200byte 초과 제한\n */\n$(\"#recv_address\").on('keydown keyup', function () {\n\n    var addrDtlValue = $(\"#recv_address\").val();\n    if (changeByte(addrDtlValue) > 199) {\n        $(\"#recv_address\").val(subStringByte(addrDtlValue));\n        alert('Please enter the address within 200 bytes.');\n    }\n\n});\n\nfunction changeByte(addrDtlValue) {\n    var codeByte = 0;\n    for (var idx = 0; idx < addrDtlValue.length; idx++) {\n        var oneChar = escape(addrDtlValue.charAt(idx));\n        if (oneChar.length == 1) {\n            codeByte++;\n        } else if (oneChar.indexOf(\"%u\") != -1) {\n            codeByte += 2;\n        } else if (oneChar.indexOf(\"%\") != -1) {\n            codeByte++;\n        }\n    }\n    return codeByte;\n}\n\nfunction subStringByte(str) {\n\n    if (str == null || str.length < 1) {\n        return 0;\n    }\n    var stringByteSize = 0;\n    var rIndex = 0;\n\n    for (var i = 0; i < str.length; i++) {\n        stringByteSize += this.changeByte(str.charAt(i));\n        if (199 < stringByteSize) {\n            rIndex = i;\n            break;\n        } else if (199 === stringByteSize) {\n            rIndex = i + 1;\n            break;\n        }\n    }\n\n    return str.substring(0, rIndex);\n}\n\nfunction sessionStorageControl(isCont){\n    if(isCont){\n        sessionStorage.setItem('prodData', JSON.stringify(parent.prodData));\n        sessionStorage.setItem('typeData', JSON.stringify(parent.typeData));\n        sessionStorage.setItem('seatData', JSON.stringify(parent.seatData));\n        sessionStorage.setItem('gradeData', JSON.stringify(parent.gradeData));\n    }else{\n        sessionStorage.removeItem(\"prodData\");\n        sessionStorage.removeItem(\"typeData\");\n        sessionStorage.removeItem(\"seatData\");\n        sessionStorage.removeItem(\"gradeData\");\n    }\n}\n\ndocument.querySelector('#recv_address').addEventListener('paste', function(event){\n    var pasteData = (event.clipboardData || window.clipboardData).getData('text');\n    if (changeByte(pasteData) > 199) {\n        var selection = window.getSelection();\n        if(!selection.rangeCount) return false;\n\n        $(\"#recv_address\").val(subStringByte(pasteData));\n        event.preventDefault();\n        setTimeout(function(){\n            alert('상세 주소는 200바이트 이내로 입력해 주세요');\n        });\n    }\n});\n/*\n * 배송지 상세주소 200byte 초과 제한 끝\n */\n\nfunction openKakaoAgree(){\n    window.open(\"https://billing-web.kakao.com/kbill/terms/finance_eng?style=pc\", \"kakaoAgree\", \"width=1200px,height=700px,scrollbars=yes\");\n}\n\n</script>\n</body>\n</html>\n"
          },
