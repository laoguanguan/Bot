            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=7\" />\r\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\r\n<!-- FDS 적용 -->\r\n<script src=\"https://stdux.inicis.com/stdpay/js/libs/jquery-1.9.1.min.js\"></script>\r\n<script src=\"/af/jquery.xdomainrequest.min.js\"></script>\r\n<script src=\"/af/json2.js\"></script>\r\n<script src=\"/af/swfobject-min.js\"></script>\r\n<script src=\"/af/itraceraf.cfg.js\"></script>\r\n<script src=\"/af/weed.min.js\"></script>\r\n<script src=\"/af/itraceraf.min.js\"></script>\r\n<!-- FDS 적용 여기까지  -->\r\n</head>\r\n<body bgcolor=\"#FFFFFF\" text=\"#242424\" leftmargin=0 topmargin=15 marginwidth=0 marginheight=0 bottommargin=0 rightmargin=0>\r\n\r\n<!-- FDS 적용 -->\r\n<script>\r\nvar isSubmit = false;\r\n\t$(document).ready(function(){\r\n// iTracer AF 수집\r\n\t\tiTracerAF.init(function(data){\r\n// data parameter 구조\r\n// data.ukey : 단말 코드\r\n// data.wdata : 암호화된 단말 정보\r\n\r\n// \t\talert(data.ukey);\r\n\t\t\r\n\t\t$('input[name=fds_ukey]', parent.document.body).val(data.ukey);\r\n\t\t$('input[name=fds_wdata]', parent.document.body).val(data.wdata);\r\n\t\t$('input[name=fds_sno] ', parent.document.body).val(\"031611\");\r\n \r\n\t\t\r\n// \t\talert($('input[name=fds_ukey]', parent.document.body).val());\r\n\t\t\r\n\t\t});\r\n\t});\r\n</script>\r\n</body>\r\n</html>\r\n\r\n"
