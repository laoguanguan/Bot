ize: 12px;height:30px;position:relative}\r\n.li_itm{display: inline-block;margin-left:6px;line-height: 26px}\r\n.li_itm input{vertical-align: middle;}\r\n.li_itm a{text-decoration: underline;}\r\n.ul_item{display: inline-block;font-size:11.4px}\r\n.etcWrap .nmlSlet{float:left}\r\n.lanWrap{position: absolute;bottom:20px;left:4px}\r\n.lanWrap button{width:37px;height:21px;border:0;float:left;margin-right:1px}\r\n.lang_kor{background: url(https://stdux.inicis.com/stdpay/img/newly/btn_kor.png) no-repeat}\r\n.lang_eng{background: url(https://stdux.inicis.com/stdpay/img/newly/btn_eng.png) no-repeat}\r\n.lang_cha{background: url(https://stdux.inicis.com/stdpay/img/newly/btn_cha.png) no-repeat}\r\n/* .btn_close{width:32px;height:32px;background: url(https://stdux.inicis.com/stdpay/img/newly/btn_close.png) no-repeat;border:0;position: absolute;top:5px;right:5px} */\r\n.btn_close{width:32px;height:32px;background: url(https://stdux.inicis.com/stdpay/img/new_btn_close.png) no-repeat;border:0;position: absolute;top:5px;right:5px}\r\n.btnType09 {font-size:15px;overflow:hidden; display:inline-block; text-align:center; width:165px; height:40px; line-height:40px; font-weight:bold; color:#fff!important; background:#664499; vertical-align:middle;border-radius: 8px;}\r\n.btnType09:hover {color:#fff; background:#664499;}\r\n.btnType09:active {color:#fff; background:#664499;}\r\n.btnDis,.btnDis:hover,.btnDis:active,.btnDis:visited{color:#999;background:#ddd !important;}\r\n.sec_pay{background: #fff; position:relative;height:355px}\r\n.img_border{border:1px solid #666}\r\n.payPrice{font-weight:bold}\r\n\r\n/* ie7占쎈쐻占쎈윥占쎈㎍占쎈쐻占쎈윥占쎌몝�뜝�럩堉싳㏏�뜝�럩留띰옙�쐻占쎈윥占쎌몗�뜝�럥�렓占쎈쐻�뜝占�*/\r\nbody.oldie .kgLayer *{font-family:'pretendard','pretendard-subset','noto sans cjk kr', 'Noto Sans Korean', 'NanumGothic',\"Malgun Gothic\",\"占쎌녇占쎄틓占쎈뮛�뜝�럥�럯癲ル슔�걞而ㅵ뜝�럩留뜹뜝�럥�맶占쎈쐻�뜝占� �뜝�럥�맶�뜝�럥�몘力놂옙�⑨옙占쎈젺�솻洹⑦맔占쎌굲�뜝�럥�꽔�뜝�럩援�\",-apple-system,BlinkMacSystemFont,helvetica,\"Apple SD Gothic Neo\",dotum,sans-serif !important; letter-spacing:-1px}\r\nbody.oldie .ban_slg{letter-spacing:-2px}\r\nbody.oldie .kgLayer .pay_ico{font-size:10px}\r\nbody.oldie .kgLayer .payPrice{font-weight:bold}\r\nbody.oldie .kgLayer .ban_ini{margin-bottom:5px}\r\n.msie7 body.oldie .kgLayer .etcWrap{margin-top:-20px}\r\nbody.oldie .kgLayer .dd_agrmt,body.oldie .kgLayer .dt_agrmt{font-size:12px}\r\n.scrollView{overflow-y:auto;height:144px}\r\n.uni_txt{font-size:11px; color:#c1272c; padding-left:5px;margin-top:-5px}\r\n.opt_mu{background:url(https://stdux.inicis.com/stdpay/img/icoF.gif) right center no-repeat}\r\n\r\n.extraCardTotal{height:40px;position:relative}\r\n.extraCardText {float:right;margin-top:4px;font-size:10.4px;text-align:right}\r\n.mgt0 {margin-top:0px}\r\n\r\n.dropdown{position:absolute;text-align:left;top:0;left:0;z-index:4}\r\n.dropdown dd, .dropdown dt, .dropdown ul { margin:0px; padding:0px; }\r\n.dropdown dd { position:relative;display:block; }\r\n.dropdown a, .dropdown a:visited { color:#666; text-decoration:none; display: block}\r\n.dropdown a:hover { color:#5d4617;}\r\n.dropdown dt{width:110px;position:absolute;top:0;left:0;height:28px}\r\n.dropdown dt a:hover { color:#5d4617; border: 1px solid #ddd;}\r\n.dropdown dt a {background:#fff url(https://stdux.inicis.com/stdpay/img/arrow.png) no-repeat;background-position: right 5px center; display:block; padding-right:8px;border:1px solid #ddd;border-radius: 8px;text-align: center;}\r\n.dropdown dt a span {cursor:pointer; display:block; padding:5px;width:110px}\r\n.dropdown dd{position:relative;width:127px;margin-top:28px}\r\n.dropdown dd .innerBox{display:none;border:1px solid #ddd;}\r\n.dropdown dd ul { background:#fff none repeat scroll 0 0;  color:#C5C0B0; \r\n                  padding:5px 0px;width:inherit;list-style:none;overflow-y:auto;height:75px;}\r\n.dropdown span.value { display:none;}\r\n.dropdown dd ul li{display:block;}\r\n.dropdown dd ul li a { padding:5px; display:block;overflow:hidden; outline-offset: -2px;}\r\n\r\n.dropdown dd ul li a:hover { background-color:#f1f1f1;}\r\n.dropdown img.flag { border:none; vertical-align:middle;margin-top:-1px }\r\n\r\n\r\n#cardQuotaView .dropdown img.flag{margin-left:3px}\r\n.flagvisibility { display:inline-block;}\r\n.extraCard{height:40px;position:relative;float:left}\r\n.extraPay{height:40px;position:relative}\r\n/* .extraCard dl{float:left;} */\r\n.extraCard .dropdown dt a {height: 35px;}\r\n.extraCard .dropdown dt a img{margin-top:10px}\r\n.extraCard > .dropdown dt{height:37px}\r\n.extraCard > .dropdown dt a.selected{border:2px solid #C12731;}\r\n/* .extraCard > .dropdown dt a{padding-left:5px} */\r\n.extraCard > .dropdown dt a{padding-left:0px}\r\n.extraCard > .dropdown dt a span{padding:9px 0;}\r\n.extraCard > .dropdown dd{margin-top:35px}\r\n.extraCard > .dropdown .ellipsis{width:65px;float:left}\r\n.extraCard > .dropdown dt a .ellipsis{width:65px;}\r\n\r\n\r\n.extraCardTotal2{height:28px;position:absolute;right:150px;}\r\n.dropdown_1 dt{width:150px}\r\n.dropdown_1 dt a span {width:142px}\r\n.dropdown_1 dd ul { width:147px}                  \r\n.dropdown_1 dd{width:149px}\r\n.extraCard .dropdown_1 dt a {height:28px;margin-left:2px}\r\n.extraCard > .dropdown_1 dd{margin-top:28px}\r\n.extraCard > .dropdown_1 dt a span{padding:9.5px 0;}\r\n\r\n\r\n.ellipsis{text-overflow:ellipsis; white-space: nowrap;overflow:hidden;display:block}\r\n.zindexUp{z-index:10 !important}\r\nh4.label2 span{font-weight:normal;}\r\n.agrmt_1st span{color:#4b4b4b}\r\n.dis_inline{display:inline-block}\r\n\r\n.radiusBorder{border:1px solid #ccc;border-radius: 20px;width:17px;height: 17px;box-sizing: border-box;display: inline-block;text-align: center;font-size: 14px;line-height: 14px;position:absolute;font-weight:bold;}\r\n\r\n.naver_popLayer {border:1px solid #acacac; background:#fff;}\r\n.naverType2Wrap ul{margin:10px 0; display: table; width: 100%; overflow: hidden;}\r\n.naverType2Wrap .li_02{width:50%; box-sizing: border-box; display: table-cell; float: none;}\r\n\r\n.naverType