ection Failure]\"+errorThrown);\r\n\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t}\r\n\t\t\t, complete:function(jqXHR,status){\r\n\t\t\t\t\thideLoading();\r\n\t\t\t\t}\r\n\t\t});\r\n}\r\n\r\n/*네이버페이 포인트,카드 레이어창 생성*/\r\nfunction makeNaverPointLayer(){\r\n\r\n\tif($payForm.find(\"[name=currency]\").val() == 'USD'){\r\n\t\tjAlert(\"결제를 위한 통화코드가 원화가 아닙니다.\\n신용카드 결제를 이용해주세요.\", \"KG 이니시스\", function() {\r\n\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2') {\r\n\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t}\r\n\t\t});\r\n\t\treturn;\r\n\t}\r\n\t\r\n\tjQuery.ajax({\r\n\t\tasyn : true\r\n\t\t, url:'/jsApi/naver/PointCall'\r\n\t\t, data : $payForm.serialize()\t\t\r\n\t\t, type : \"POST\"\r\n\t\t, dataType:\"html\"\t\r\n\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\t\r\n\t\t, success:function(html, staus, jqXHR){\r\n\t\t\t//레이어창 생성\r\n\t\t\tjQuery(\"#overlay_popup\").html(html);\r\n\t\t\t//jQuery(\"#overlay_popup\").css({\"width\":\"700px\",\"height\":\"250px\"});\r\n\t\t\t\r\n\t\t\tvar naverpay_payPaymethod = $payForm.find(\"[name=naverpayPaymethod]\").val();\r\n\t\t\t\r\n\t\t\t//포커스 설정\r\n\t\t\tvar inputFocusNaverPopup = $('#overlay_popup').find(\"#inputFocusNaverCard\");\r\n\t\t\tif(naverpay_payPaymethod == 2 ){\r\n\t\t\t\tinputFocusNaverPopup = $('#overlay_popup').find(\"#inputFocusNaverPoint\");\t\t\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar length = inputFocusNaverPopup.length;\r\n\t\t\tif(length > 0){\r\n\t\t\t\tsetTimeout(function() {\r\n\t\t\t\t\tinputFocusNaverPopup.focus(); \r\n\t\t\t    }, 100);\r\n\t\t\t}\r\n\t\t\t\t\t\t\t\r\n\t\t\toverlayPopupOnOff(true);\r\n\t\t}\r\n\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\talert(\"[Connection Failure]\"+errorThrown);\r\n\t\t}\r\n\t\t\r\n\t});\r\n\r\n}\r\n\r\nfunction callLpoint(){\r\n\t\r\n\tif($payForm.find(\"[name=currency]\").val() == 'USD'){\r\n\t\tjAlert(\"결제를 위한 통화코드가 원화가 아닙니다.\\n신용카드 결제를 이용해주세요.\", \"KG 이니시스\", function() {\r\n\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2') {\r\n\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t}\r\n\t\t});\r\n\t\treturn;\r\n\t}\r\n\t\r\n\t//1000원미만 결제여부 확인\r\n\tif(below1000Check() != \"Y\"){\r\n\t\t return;\r\n\t }\r\n\t\r\n\tjQuery.ajax({\r\n\t\tasyn : true\r\n\t\t, url:'/jsApi/lpoint/callLpoint'\r\n\t\t, data : $payForm.serialize()\t\t\r\n\t\t, type : \"POST\"\r\n\t\t, dataType:\"html\"\t\r\n\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\t\r\n\t\t, success:function(html, staus, jqXHR){\r\n\t\t\t//레이어창 생성\r\n\t\t\tjQuery(\"#overlay_popup\").html(html);\r\n\t\t\t//jQuery(\"#overlay_popup\").css({\"width\":\"700px\",\"height\":\"250px\"});\r\n\t\t\t\r\n\t\t\t//포커스 설정\r\n\t\t\tvar inputFocusLpointPopup = $('#overlay_popup').find(\"#lpointLayer1\");\r\n\t\t\t\r\n\t\t\tvar length = inputFocusLpointPopup.length;\r\n\t\t\tif(length > 0){\r\n\t\t\t\tsetTimeout(function() {\r\n\t\t\t\t\tinputFocusLpointPopup.focus(); \r\n\t\t\t    }, 100);\r\n\t\t\t}\r\n\t\t\t\t\t\t\t\r\n\t\t\toverlayPopupOnOff(true);\r\n\t\t}\r\n\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\talert(\"[Connection Failure]\"+errorThrown);\r\n\t\t}\r\n\t\t\r\n\t});\r\n\t\r\n}\r\n//naverpay 호출 함수\r\nfunction callNaverPay(){\r\n\t\r\n\tif($payForm.find(\"[name=currency]\").val() == 'USD'){\r\n\t\tjAlert(\"결제를 위한 통화코드가 원화가 아닙니다.\\n신용카드 결제를 이용해주세요.\", \"KG 이니시스\", function() {\r\n\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2') {\r\n\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t}\r\n\t\t});\r\n\t\treturn;\r\n\t}\r\n\r\n\t//1000원미만 결제여부 확인\r\n\tif(below1000Check() != \"Y\"){\r\n\t\t return;\r\n\t }\r\n\t\r\n\tvar acceptmethod = $payForm.find(\":input[name=acceptmethod]\").val();\r\n\tvar gopaymethod = $payForm.find(\"input[name=gopa