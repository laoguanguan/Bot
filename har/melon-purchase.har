r\n\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t, type : \"POST\"\r\n\t\t, dataType:\"json\"\r\n\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\tif(jsonData[\"resultCode\"] == '0000'){\r\n\t\t\t\t//캡차 검증 성공\r\n\t\t\t\tcallGlobalVisa3d($payForm.find(\"input[name=globalCardCode]\").val());\r\n\r\n\t\t\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\t\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\t\t\tjQuery(\"#overlay_popup\").html('');\r\n\t\t\t\t\r\n\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\t\tclosePopupUrl();\r\n\t\t\t\t}\r\n\t\t\t}else if(jsonData[\"resultCode\"] == 'R504') {\r\n\t\t\t\tcallAlert(\"check the characters again\");\r\n\t\t\t\t\r\n\t\t\t\tvar flg = $payForm.find(\"input[name=captchaFlag]\").val();\r\n\t\t\t\t\r\n\t\t\t\t//새로고침 영역으로\r\n\t\t\t\tsetTimeout(function() {\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(flg == \"img\"){\r\n\t\t\t\t\t\tcallCaptcha(flg,\"ri\");\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tcallCaptcha(flg,\"rv\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t    }, 200);\r\n\t\t\t\t\r\n\t\t\t}\r\n\t\t\t\r\n\t\t}\r\n\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\talert(\"[Connection Failure]\"+errorThrown);\r\n\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t}\r\n\t\t\r\n\t\t}\r\n\t\t, complete:function(jqXHR,status){\r\n\t\t\r\n\t\t}\r\n\t});\r\n}\r\n*/\r\nfunction callGlobalVisa3d($selectCardCode){\r\n\tshowLoading();\r\n\r\n\tvar browserJavaEnabled = navigator.javaEnabled(); //브라우저 자바사용 \r\n\tvar browserLanguage = \"ko\";\r\n\tvar browserColorDepth = screen.colorDepth;\r\n\tvar browserScreenHeight = window.innerHeight;\r\n\tvar browserScreenWidth = window.innerWidth;\r\n\tvar browserTZ = new Date().getTimezoneOffset();\r\n\tvar browserUserAgent = navigator.userAgent;\r\n\tif(navigator.language != null){browserLanguage=navigator.language;} \r\n\tbrowserLanguage = browserLanguage.toLowerCase().substring(0.5);\r\n\t\r\n\tif($payForm.find(\"input[name=globalCardCode]\").val() != \"\"){\r\n\t\t$payForm.find(\"input[name=globalCardCode]\").val(\"\"); \r\n\t}\r\n\r\n\t\r\n\t$(\"[globalParams]\").remove();\r\n\r\n\t$payForm.append(\"<input type='hidden' name='browserJavaEnabled' globalParams value='\" + browserJavaEnabled + \"' />\");\r\n\t$payForm.append(\"<input type='hidden' name='browserLanguage' globalParams value='\" + browserLanguage + \"' />\");\r\n\t$payForm.append(\"<input type='hidden' name='browserColorDepth' globalParams value='\" + browserColorDepth + \"' />\");\r\n\t$payForm.append(\"<input type='hidden' name='browserScreenHeight' globalParams value='\" + browserScreenHeight + \"' />\");\r\n\t$payForm.append(\"<input type='hidden' name='browserScreenWidth' globalParams value='\" + browserScreenWidth + \"' />\");\r\n\t$payForm.append(\"<input type='hidden' name='browserTZ' globalParams value='\" + browserTZ + \"' />\");\r\n\t$payForm.append(\"<input type='hidden' name='browserUserAgent' globalParams value='\" + browserUserAgent + \"' />\");\r\n\t$payForm.append(\"<input type='hidden' name='threeDSMethodData' globalParams value='' />\");\r\n\t\r\n\t$payForm.append(\"<input type='hidden' name='acsMethodURL' globalParams value='' />\");\r\n\t$payForm.append(\"<input type='hidden' name='threeDSMethodReqData' globalParams value='' />\");\r\n\t$payForm.append(\"<input type='hidden' name='messageVersion' globalParams value='' />\");\r\n\t\t\r\n\tjQuery.ajax({\r\n\t\tasyn : true\r\n\t\t, url:'/jsApi/globalPayAuthentication/before'\r\n\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t, type : \"POST\"\r\n\t\t, dataType:\"json\"\r\n\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t\t// 정상 통신\r\n\t\t\t\tif(jsonData['resultCode'] == '0000')\r\n\t\t\t\t{\r\n\r\n\t\t\t\t\t$payForm.find(\"input[name=visa3dRequest]\").val(jsonData['visa3dRequest']);\r\n\t\t\t\t\t$payForm.find(\"input[name=visa3dResponse]\").val(jsonData['visa3dResponse']);\r\n\t\t\t\t\t$payForm.find(\"input[name=checkNoInt]\").val(jsonData['checkNoInt']);\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(jsonData['acsMethodURL'] != null && jsonData['threeDSMethodReqData'] != null && jsonData['messageVersion'] != null)\r\n\t\t\t\t\t{\t\t\t\r\n\t\t\t\t\t\t$payForm.find(\"input[name=acsMethodURL]\").val(jsonData['acsMethodURL']);\r\n\t\t\t\t\t\t$payForm.find(\"input[name=threeDSMethodReqData]\").val(jsonData['threeDSMethodReqData']);\r\n\t\t\t\t\t\t$payForm.find(\"input[name=messageVersion]\").val(jsonData['messageVersion']);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\t\r\n\t\t\t\t\tif(jsonData['resultStatus'] == 'F')\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$payForm.find(\"input[name=encrypted]\").val(jsonData['encrypted']);\r\n\t\t\t\t\t\t$payForm.find(\"input[name=type]\").remove();\r\n\t\t\t\t\t\t$payForm.append(\"<input type='hidden' name='type' />\");\r\n\t\t\t\t\t\t$payForm.find(\"input[name=type]\").val(\"VISA3D\");\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tcallPayDoneView();\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '1' || ($payForm.find(\"input[name=payPopup]\").val() == '2'  && $payForm.find(\"input[name=payViewType ]\").val() == 'popup' ) \r\n\t\t\t\t\t\t\t\t|| \"21,22,23,24\".indexOf($selectCardCode)> -1)\r\n\t\t\t\t\t\t{\r\n//\t\t\t\t\t\t\tvar win = '';\r\n\t\t\t\t\t\t\tvar w = 395;\r\n\t\t\t\t\t\t\tvar h = 408;\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tif(\"21\" == ($selectCardCode))\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tw = 400;\r\n\t\t\t\t\t\t\t\th = 432;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse if(jsonData['visa3dVer'] == '2')\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tw = 500;\r\n\t\t\t\t\t\t\t\th = 600;\r\n\t\t\t\t\t\t\t}\r\n\t\r\n//\t\t\t\t\t\t\t\t// Fixes dual-screen position                         Most browsers      Firefox\r\n\t\t\t\t\t\t\t    var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;\r\n\t\t\t\t\t\t\t    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;\r\n\r\n\t\t\t\t\t\t\t    width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t\t\t\t\t\t\t    height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\r\n\t\t\t\t\t\t\t    var left = ((width / 2) - (w / 2)) + dualScreenLeft;\r\n\t\t\t\t\t\t\t    var top = ((height / 2) - (h / 2)) ;\r\n\r\n\r\n\t\t\t\t\t\t\t\twin = window.open(\"../checkWin.jsp\",\"newFrame\",\"width=\"+w+\"px,height=\"+h+\"px,resizable=no,scrollbars=no,top=\"+top+\",left=\"+left+\",modal=yes\",true);\r\n\r\n\r\n\t\t\t\t\t\t\t// set user-agent\r\n\t\t\t\t\t\t\tvar popUseragent = navigator.userAgent;\r\n//\t\t\t\t\t\t\tvar winpopup = window.open(url, name, options);\r\n\r\n\t\t\t\t\t\t\tif( !win )\r\n\t\t\t\t\t\t\t{\r\n\r\n\t\t\t\t\t\t\t\tvar alertMsg = \"\";\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\tif(popUseragent.indexOf(\"Firefox\")>-1 || popUseragent.indexOf(\"Chrome\")>-1 || popUseragent.indexOf(\"Safari\")>-1 || popUseragent.indexOf(\"Edg\")>-1) {\r\n\t\t\t\t\t\t\t\t\talertMsg = INImsg.alert_popup_check2;\t\r\n\t\t\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\t\t\talertMsg = INImsg.alert_popup_check1;\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\tjAlert(alertMsg, \"KG이니시스\", function(r) \r\n\t\t\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\r\n\t\t\t\t\t\t\t\t\tif(typeof(win)!='undefined' || !win.closed) \r\n\t\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\t\twin.close();\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t\t} \r\n\t\t\t\t\t\t\tel