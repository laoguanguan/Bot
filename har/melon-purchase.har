ngth != 4\r\n\t\t\t|| $payForm.find(\"[name=cardNumber3]\").val().length != 4\r\n\t\t\t|| $payForm.find(\"[name=cardNumber4]\").val().length < 2\r\n\t\t){\r\n\t\t\tcallAlert(INImsg.alert_card_msg3);\r\n\t\t\treturn;\r\n\t\t}else if(\r\n\t\t\t$payForm.find(\"[name=cardYear]\").val().length <= 0\r\n\t\t\t|| $payForm.find(\"[name=cardMonth]\").val().length <= 0\r\n\t\t){\r\n\t\t\tcallAlert(INImsg.alert_card_msg4);\r\n\t\t\treturn;\r\n\t\t}\r\n\t\t// 추가 정보 있는지 확인\r\n\t\tif(jQuery(\"input[name=cardHasType]\").length > 0 ){\r\n\t\t\tvar target = null;\r\n\t\t\tif(jQuery(\"input[name=cardHasType]:checked\").val() == \"id\"){\r\n\t\t\t\ttarget = jQuery(\".cardNextIdViewTr\").find(\"input\");\r\n\t\t\t}else if(jQuery(\"input[name=cardHasType]:checked\").val() == \"co\"){\r\n\t\t\t\ttarget = jQuery(\".cardNextCoViewTr\").find(\"input\");\r\n\t\t\t}\r\n\t\t\tif(target != null){\r\n\t\t\t\tvar boolCheckInput = false;\r\n\t\t\t\ttarget.each(function(){\r\n\t\t\t\t\tif(jQuery.trim(jQuery(this).val()).length !=jQuery(this).attr(\"maxlength\")){\r\n\t\t\t\t\t\tboolCheckInput = true;\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\tif(boolCheckInput){\r\n\t\t\t\t\tcallAlert(INImsg.alert_card_msg9);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\tif($(\"#jSelectMcpTag option:selected\").text() != 'KRW' && $(\"#jSelectMcpTag\").val() != '' && $(\"#jTermMcp\").prop(\"checked\") == false)\r\n\t\t{\r\n\t\t\tcallAlert(INImsg.alert_mcp_msg1);\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\tif($(\"input[id=cardGlobalFlg]\").val() == \"Y\"){\r\n\t\t\t//카드소유주 이름\r\n\t\t\tif($payForm.find(\"input[id=cardHolderName1]\").val().length <= 0 || $payForm.find(\"input[id=cardHolderName2]\").val().length <= 0){\r\n\t\t\t\tcallAlert(INImsg.alert_card_msg19);\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//카드 소유주 이메일\r\n\t\t\tif($payForm.find(\"input[id=cardHolderEmail]\").val().length <= 0){\r\n\t\t\t\tcallAlert(INImsg.alert_card_msg20);\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//이메일