          "content": {
            "size": 83503,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\"/>\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\" />\n\t<title>Melon Ticket - Global</title>\n    <link rel=\"shortcut icon\" type=\"image/x-icon\" href=\"https://cdnticket.melon.co.kr/resource/image/web/common/pc_32.ico\" /><!-- 파비콘 추가 -->\n     <!-- IOS용 -->\n    <link rel=\"apple-touch-icon-precomposed\" href=\"https://cdnticket.melon.co.kr/resource/image/web/common/ios_120.png\" />\n\t<link rel=\"apple-touch-icon-precomposed\" sizes=\"180x180\" href=\"https://cdnticket.melon.co.kr/resource/image/web/common/ios_180.png\" />\n\t<meta name=\"keywords\" content=\"K-pop, Kpop, Concert, Musical, Melon, Melon Ticket\" />\n\t<meta name=\"description\" content=\"Offers tickets for K-pop Concerts, Musicals and Theatre in Korea.\" />\n    <meta property=\"og:title\" content=\"\"/>\n    <meta property=\"og:image\" content=\"\"/>\n    <meta property=\"og:description\" content=\"듣다·보다·만나다, 멜론티켓\"/>\n    <meta name=\"viewport\" content=\"width=1126\"/>\n    <script src=\"/resource/script/phase/deployPhaseUtils.js\"></script>\n<!-- 네이버 광고 로그분석 -->\n<!-- 공통 적용 스크립트 , 모든 페이지에 노출되도록 설치. 단 전환페이지 설정값보다 항상 하단에 위치해야함 -->\n<script type=\"text/javascript\" src=\"//wcs.naver.net/wcslog.js\"> </script>\n<script type=\"text/javascript\">\n    // console.log(\"##########################################\");\n    // console.log(\"##########################################\");\n    // console.log(\"네이버 광고 로그 분석 공통 스크립트 실행\");\n    // console.log(\"script_common.jsp\");\n    // console.log(\"##########################################\");\n    // console.log(\"##########################################\");\n    if (!wcs_add) var wcs_add={};\n    wcs_add[\"wa\"] = \"s_322bdbd6fd48\";\n    if (!_nasa) var _nasa={};\n    if(window.wcs){\n        wcs.inflow(\"melon.com\");\n        wcs_do(_nasa);\n    }\n</script>\n<!-- END 네이버 광고 로그분석 -->\n<script>\n</script>\n<script type=\"text/javascript\" src=\"/resource/script/web/common/jquery-3.6.0.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/jquery-migrate-3.3.2.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/jquery.inputmask.bundle.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/ui_script.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/melonweb_openlib.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/melonweb_comm.js\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/melonweb_member_external.js?ts=221005\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/webUtils.js?date=1608221544\"></script>\n    <script type=\"text/javascript\" src=\"/resource/script/web/common/CaptchaUtils.js?v=20240116\"></script>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"//cdnticket.melon.co.kr/resource/style/web/common/common_eng-26bfdde865.css\" id=\"linkCommonOnestopCss\"/>\n\n    <script>var APIURL = '/tktapi', POCURL = '/tktapi_poc', CTX = '';</script>\n\n<script type=\"text/javascript\" src=\"/resource/script/web/common/dictionaryForMultiNationLanguage.js?modifyDate=2025091115\" id=\"dictionaryForMultiNationLanguage\" data-modifyDate=\"2025091115\"></script>\n<script>\n\n\t/**\n\t * 날짜문자열을 넘기면 YYYY.mm.dd 형태로 포맷팅됨.\n\t * Deprecated Sun, 31 Jul 2016 17:00\n\t */\n\tfunction convertDateFormat(date, time){\n\t\tif(date == null || date == undefined || date.length != 8){\n\t\t\tdate = \"20000101\";\n\t\t}\n\t\tif(time == null || time == undefined || (time.length != 4 && time.length != 6)){\n\t\t\ttime = \"0000\";\n\t\t}\n\t\t\n\t\t// 기존 로직\n\t\t//var d = new Date(Date.parse(date.substr(0,4)+\"-\"+date.substr(4,2)+\"-\"+date.substr(6,2)+\"T\"+time.substr(0,2)+\":\"+time.substr(2,2)));\n\t\t//return d.toUTCString().substr(0, 22); // Sat, 30 Jul 2016 18:00\n\t\t\n\t\t// 변환 로직\n\t\t//var d = new Date(date+((time).length == 4 ? (time+'00') : (time)).replace(/^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})$/,'$1/$2/$3 $4:$5:$6'));\n\t\t\n\t\t//영문 변환 - UTCString 쓰지 않고 메뉴얼 변환\n\t\t//return date.length >= 8 ? getMonthName((parseInt(date.substr(4,2), 10) - 1)) + \" \" + parseInt(date.substr(6,2), 10) + date.substr(0,4) + \" \" + time.substr(0,2) + \":\" + time.substr(2,2) : \"\"\n\t\t//return date.length >= 8 ? getMonthName((parseInt(date.substr(4,2), 10) - 1)) + \" \" + parseInt(date.substr(6,2), 10) + date.substr(0,4) + \" \" + date.substr(8,2) + \":\" + date.substr(10,2) : \"\"\n\t\treturn convertDateFormatOnlyDate(date) + \" \" + convertDateFormatOnlyTime(time);\n\t};\n\t\n\tfunction convertDateFormat2(date){\n\t\tif(date == null || date == undefined || date.length < 12){\n\t\t\tif(date.length < 8){\n\t\t\t\tdate = \"200001010000\";  \n\t\t\t}else{\n\t\t\t\tdate = date.substr(0, 8) + \"0000\";\n\t\t\t}\n\t\t}\n\t\treturn convertDateFormat(date.substr(0, 8), date.substr(8, 4));\n\t};\n\t\n\tfunction convertDateFormatOnlyDate(dateStr, DATE_DELIM){\n\t\tDATE_DELIM = (DATE_DELIM == undefined ? \".\" : DATE_DELIM);\n\t\treturn (dateStr.substr(0,4)+DATE_DELIM+dateStr.substr(4,2)+DATE_DELIM+dateStr.substr(6,2));\n\t};\n\tfunction convertDateFormatOnlyTime(timeStr, TIME_DELIM){\n\t\tTIME_DELIM = (TIME_DELIM == undefined ? \":\" : TIME_DELIM);\n\t\tif(timeStr.length == 6){\n\t\t\treturn (timeStr.substr(0,2)+TIME_DELIM+timeStr.substr(2,2)+TIME_DELIM+timeStr.substr(4,2));\n\t\t} else {\n\t\t\treturn (timeStr.substr(0,2)+TIME_DELIM+timeStr.substr(2,2));\n\t\t}\n\t};\n\t\n\t/**\n\t * getMonthName Function - via http://www.jquery2dotnet.com/2013/11/javascript-get-month-name-from-number.html\n\t */\n\tvar getMonthName = function (v) {\n\t\t//var n = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];\n\t\tvar n = [];\n\t\tn = monthNameArr[LANG_CD.EN]; //16-08-25 한글 표기로 통일하기로 함.\n\t\t/*if(langCd != undefined && langCd != '' && monthNameArr[langCd] != undefined){\n\t\t\tn = monthNameArr[langCd];\n\t\t} else {\n\t\t\tn = monthNameArr['default']; \n\t\t}*/\n\t\treturn n[Number(v)];\n\t};\n\n\tfunction getWeekDay(dt, seperator, option) {\n\t\tif(seperator == undefined || option == undefined){\n\t\t\tvar week = [];\n\t\t\tweek = weekNameArr[LANG_CD.EN]; //16-08-25 한글 표기로 통일하기로 함.\n\t\t\t/*if(langCd != undefined && langCd != '' && monthNameArr[langCd] != undefined){\n\t\t\t\tweek = weekNameArr[langCd];\n\t\t\t} else {\n\t\t\t\tweek = weekNameArr['default']; \n\t\t\t}*/\n\t\t\tvar day = new Date(dt.split(\".\").join(\"/\")).getDay();\n\t\t\treturn week[day];\n\t\t} else {\n\t\t\tvar datestr = dt;\n\t\t\ttry {\n\t\t\t\tvar date_arr = getYmdArr(datestr, seperator);\n\t\t\t\tvar obj_date = new Date(date_arr[0],date_arr[1]-1,date_arr[2]);\n\t\t\t\tif(option == '0') {\n\t\t\t\t\treturn obj_date.getDay();\n\t\t\t\t}\n\t\t\t\telse if(option == '1') {\n\t\t\t\t\tvar week_str = new Array(\"일\",\"월\",\"화\",\"수\",\"목\",\"금\",\"토\");\n\t\t\t\t\treturn week_str[obj_date.getDay()];\n\t\t\t\t}\n\t\t\t}\n\t\t\tcatch(e) {\n\t\t\t\t//alert('udfMainFrm.js : '+e);\n\t\t\t}\n\t\t}\n\t};\n\tfunction getYmdArr(dateStr, seperator) {\n\t\ttry {\n\t\t\tif(seperator == '') {\n\t\t\t\tvar rtnArr = new Array();\n\t\t\t\trtnArr[0] = dateStr.substr(0,4);\n\t\t\t\trtnArr[1] = dateStr.substr(4,2);\n\t\t\t\trtnArr[2] = dateStr.substr(6,2);\n\t\t\t\treturn rtnArr;\n\t\t\t}\n\t\t\telse {\n\t\t\t\treturn dateStr.split(seperator);\n\t\t\t}\n\t\t}\n\t\tcatch(e) {\n\t\t\t//alert('udfMainFrm.js : '+e);\n\t\t}\n\t};\n\n\tvar LANG_CD = {\n\t\tEN: 'EN',\n\t\tCN: 'CN',\n\t\tJP: 'JP',\n\t\tKR: 'KR'\n\t};\n\tvar langCd = LANG_CD.EN;\n\tvar COMMON_PROP = 'common';\n\tvar MSG_PROP = 'message';\n\n\t/**\n\t * 글로벌용 임시 함수. 한글 상태명을 영문 상태명으로 변환\n\t */\n\tvar replaceKrToEn = function(targetProp, statusName) {\n\t\treturn replaceKrTo(LANG_CD.EN, targetProp, statusName);\n\t};\n\t/**\n\t * 글로벌용 임시 함수. 한글 상태명을 영문 상태명으로 변환\n\t */\n\tvar replaceKrToLangCd = function(targetProp, statusName) {\n\t\treturn replaceKrTo(langCd, targetProp, statusName);\n\t};\n\n\t/**\n\t * 글로벌용 임시 함수. 한글 상태명을 타국 상태명으로 변환\n\t */\n\tvar replaceKrTo = function(lang, targetProp, statusName) {\n\t\treturn replaceLangToLang(dictionaryKrTo, lang, targetProp, statusName);\n\t};\n\n\tvar replaceEnToLangCd = function(targetProp, statusName) {\n\t\treturn replaceEnTo(langCd, targetProp, statusName);\n\t};\n\t/**\n\t * 글로벌용 임시 함수. 영문을 타국어로 변환\n\t */\n\tvar replaceEnTo = function(lang, targetProp, statusName) {\n\t\treturn replaceLangToLang(dictionaryEnTo, lang, targetProp, statusName);\n\t};\n\n\t/**\n\t * 글로벌용 임시 함수. 영문을 타국어로 변환\n\t */\n\tvar hasWordEnTo = function(lang, targetProp, statusName) {\n\t\tif (statusName.indexOf(replaceEnTo(lang, targetProp, statusName)) > -1) {\n\t\t\treturn false;\n\t\t} else {\n\t\t\treturn true;\n\t\t}\n\t};\n\t/**\n\t * 글로벌용 임시 함수. 국어을 타국어로 변환\n\t */\n\tvar hasWordKrTo = function(lang, targetProp, statusName) {\n\t\tif (statusName.indexOf(replaceKrTo(lang, targetProp, statusName)) > -1) {\n\t\t\treturn false;\n\t\t} else {\n\t\t\treturn true;\n\t\t}\n\t};\n\n\tvar replaceLangToLang = function(dictionaryFromLang, toLang, targetProp, statusName) {\n\t\tvar langIndex = 0;\n\t\tswitch (toLang) {\n\t\t\tcase LANG_CD.EN:\n\t\t\t\tlangIndex = 0;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.CN:\n\t\t\t\tlangIndex = 1;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.JP:\n\t\t\t\tlangIndex = 2;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.KR:\n\t\t\t\tlangIndex = 3;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\tlangIndex = 0;\n\t\t\t\tbreak;\n\t\t};\n\n\t\t//사전에 카테고리나 단어가 정의되지 않은 경우는 statusName을 반환.\n\t\tif (dictionaryFromLang[targetProp] == undefined\n\t\t\t|| dictionaryFromLang[targetProp][statusName] == undefined\n\t\t\t|| dictionaryFromLang[targetProp][statusName][langIndex] == undefined\n\t\t\t/*|| dictionaryFromLang[targetProp][statusName][langIndex] == ''*//*의도적 빈 값 처리를 위해 넣음*/\n\t\t) {\n\t\t\treturn statusName;\n\t\t} else {\n\t\t\treturn dictionaryFromLang[targetProp][statusName][langIndex];\n\t\t}\n\t};\n\n\t/**\n\t * target elements를 순회하면서 action에 설정된 작업을 처리한다.\n\t * @param complete - function 투어 완료했을 때 처리할 작업\n\t * @param target - HTML Element 투어할 DOM Element\n\t * @param action - function 처리할 작업\n\t * @param isSeries - boolean 내부 재귀 호출용 파라미터.\n\t * 출처: http://www.bsidesoft.com/?p=1431\n\t */\n\tfunction tour(complete, target, action, isSeries) {\n\t\tvar stack, curr, i, start, timeCounter;\n\n\t\t//최초 호출된 경우\n\t\tif (!isSeries) {\n\t\t\t//최초 스택을 생성-이전동일\n\t\t\tstack = [target.length ? target : [target]];\n\t\t} else {\n\t\t\t// 이어받는 경우는 target이 stack임\n\t\t\tstack = target;\n\t\t}\n\n\t\t//시작시간을 확인한다.\n\t\tstart = Date.now();\n\n\t\t//시간확인용 카운터 초기화\n\t\ttimeCounter = 0;\n\n\t\twhile (curr = stack.pop()) {\n\t\t\ti = curr.length;\n\t\t\twhile (i--) {\n\t\t\t\taction(curr[i]);\n\t\t\t\tif (curr[i].childNodes && curr[i].childNodes.length) {\n\t\t\t\t\tstack.push(curr[i].childNodes);\n\t\t\t\t}\n\t\t\t}\n\t\t\t\n\t\t\t//카운터가 100이 될때마다 시간을 측정한다.\n\t\t\tif (timeCounter++ == 100) {\n\t\t\t\t//3초가 경과되었다면\n\t\t\t\tif (Date.now() - start > 3000) {\n\t\t\t\t\t//다음 프레임으로 넘긴다.\n\t\t\t\t\treturn setTimeout(function() {\n\t\t\t\t\t\t//현재 스택을 target으로, isSeries를 true로\n\t\t\t\t\t\ttour(complete, stack, action, true);\n\t\t\t\t\t}, 1);\n\t\t\t\t}\n\t\t\t\t//카운터를 초기화\n\t\t\t\ttimeCounter = 0;\n\t\t\t}\n\t\t}\n\n\t\t//만약 무사히 나왔다면 완료된것!\n\t\tcomplete();\n\t}\n\n\tvar replaceAllBodyEnToLangCd = function(callback) {\n\t\treplaceAllEnToLangCd(document.body,callback);\n\t}\n\tvar getCssPathToLangCd = function(currPage) {\n\t\tvar langCodeOfCss = '';\n\t\tvar engCssPath = \"//cdnticket.melon.co.kr/resource/style/web/common/common_eng-26bfdde865.css\";\n\t\tvar chnCssPath = \"//cdnticket.melon.co.kr/resource/style/web/common/common_chn-f64aaea19b.css\";\n\t\tvar jpnCssPath = \"//cdnticket.melon.co.kr/resource/style/web/common/common_jpn-40426d3dfc.css\";\n\t\tvar cssPath;\n\t\tswitch (langCd) {\n\t\t\tcase LANG_CD.EN:\n\t\t\t\t// langCodeOfCss = 'eng';\n                cssPath = engCssPath;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.CN:\n\t\t\t\t// langCodeOfCss = 'chn';\n                cssPath = chnCssPath;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.JP:\n\t\t\t\t// langCodeOfCss = 'jpn';\n                cssPath = jpnCssPath;\n\t\t\t\tbreak;\n\t\t\tcase LANG_CD.KR:\n\t\t\t\t// langCodeOfCss = '';\n                cssPath = engCssPath;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\t// langCodeOfCss = 'eng';\n                cssPath = engCssPath;\n\t\t\t\tbreak;\n\t\t};\n\t\t// var tempLangCodeOfCss = (langCodeOfCss == '' ? '' : '_' + langCodeOfCss);\n\t\t// tempLangCodeOfCss += (currPage.indexOf('onestop') > -1 ? '_onestop' : '');\n\t\t// var cssPath = '../../../resource/style/web/common/common'+tempLangCodeOfCss+'.css';\n\t\treturn cssPath;\n\t}\n\n\tvar setCssToLangCd = function() {\n\t\tvar targetCssLink = '';\n\t\tif(document.getElementById('linkCommonOnestopCss')){\n\t\t\ttargetCssLink = document.getElementById('linkCommonOnestopCss');\n\t\t} else if(document.getElementById('linkCommonCss')){\n\t\t\ttargetCssLink = document.getElementById('linkCommonCss');\n\t\t}\n\t\tif(typeof targetCssLink != \"object\"){\n\t\t\t//if( window.console ){ console.log(\"css 변환 실패\"); }\n\t\t\treturn;\n\t\t}\n\t\tvar currCssHref = targetCssLink.getAttribute('href');\n\t\tvar nextCssHref = getCssPathToLangCd('onestop');\n\t\tif(currCssHref != nextCssHref){\n\t\t\ttargetCssLink.setAttribute('href',nextCssHref);\n\t\t}\n\t};\n\tvar replaceAllEnToLangCd = function(target,callback) {\n\t\tvar baseLang = LANG_CD.EN;\n\t\treplaceAllLangToLangCd(baseLang,target,callback);\n\t};\n\tvar replaceAllKrToLangCd = function(target,callback) {\n\t\tvar baseLang = LANG_CD.KR;\n\t\treplaceAllLangToLangCd(baseLang,target,callback);\n\t};\n\tvar replaceAllLangToLangCd = function(baseLang,target,callback) {\n\t\tif (target == undefined) {\n\t\t\ttarget = document.body;\n\t\t}\n\t\t//target.style.display = \"none\";\n\t\t//사용하기\n\t\ttour(\n\t\t\tfunction complte() {\n\t\t\t\tsetCssToLangCd();\n\t\t\t\t//target.style.display = \"\"; //block을 주면 css 잡힌 것을 해치게 됨.\n\t\t\t\t//if( window.console ) console.log('tour completed!');\n\t\t\t\t//if( window.console ) console.log('callback resolve start');\n\t\t\t\tcallback != undefined && typeof callback == 'function' ? callback() : '';\n\t\t\t},\n\t\t\ttarget,\n\t\t\tfunction action(el) {\n\t\t\t\t//if( window.console ) console.log(\"el.nodeType  = \" + el.nodeType);\n\t\t\t\tif (el.nodeType == 1) {\n\t\t\t\t\tvar targetEleType = '';\n\t\t\t\t\tvar targetEleAttr = '';\n\t\t\t\t\tif (el.innerHTML) {\n\t\t\t\t\t\ttargetEleType = \"innerHTML\";\n\t\t\t\t\t\ttargetEleAttr = el.innerHTML;\n\t\t\t\t\t} else if (el.text) {\n\t\t\t\t\t\ttargetEleType = \"text\";\n\t\t\t\t\t\ttargetEleAttr = el.text;\n\t\t\t\t\t} else if (el.value) {\n\t\t\t\t\t\ttargetEleType = \"value\";\n\t\t\t\t\t\ttargetEleAttr = el.value;\n\t\t\t\t\t} else {\n\t\t\t\t\t\t//if( window.console ) console.log(\"skip\");\n\t\t\t\t\t};\n\n\t\t\t\t\tif(targetEleAttr != ''){\n\t\t\t\t\t\t//if( window.console ) console.log(targetEleType + \"\\t\\t\\t\" + targetEleAttr);\n\t\t\t\t\t\tif (baseLang == LANG_CD.EN && hasWordEnTo(langCd, COMMON_PROP, targetEleAttr)) {\n\t\t\t\t\t\t\tel[targetEleType] = replaceEnTo(langCd, COMMON_PROP, targetEleAttr);\n\t\t\t\t\t\t} else\n\t\t\t\t\t\tif (baseLang == LANG_CD.KR && hasWordKrTo(langCd, COMMON_PROP, targetEleAttr)) {\n\t\t\t\t\t\t\tel[targetEleType] = replaceKrTo(langCd, COMMON_PROP, targetEleAttr);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t);\n\t};\n\n</script>\n</head>\n<body>\n\n    <script>\nif(\"0000\"!=\"0000\"){\n\talert(replaceEnToLangCd(MSG_PROP,\"\"));\n    history.back();\n}\n</script>\n<div class=\"section_onestop\" style=\"display: none;width: 970px\">\n    <!--가격선택  영역-->\n    <div class=\"wrap_select\">\n        <div class=\"location_step\">\n            <ul class=\"list_step\">\n            </ul>\n        </div>\n        <div class=\"box_select box_r\">\n            <!--티켓가격 선택-->\n            <div class=\"box_select_t\">\n                <h3 class=\"select_tit\">Please select ticket price.</h3>\n                <!---->\n                <div id=\"partTicketType\" class=\"box_cont box_ticket\">\n                </div>\n            </div>\n            <!--// 티켓가격 선택-->\n            <!--할인수단 선택 -->\n            <!-- \n            <div class=\"box_select_t box_top\">\n                <h3 class=\"select_tit\">할인수단을 선택하세요</h3>\n                <div class=\"box_cont box_coupon\">\n                    <div class=\"list_coupon\">\n                        <div class=\"list_coupon_t frt\">\n                            <div class=\"ticket_btn_cp\" onclick=\"$(this).parent().toggleClass('open');return false;\">\n                                <div class=\"box_coupon_t\">\n                                    <span class=\"tit_cp\">쿠폰 <span class=\"txt_gr\"><span id=\"txtCouponCnt\">0</span>개</span></span>\n                                </div>\n                            </div>\n                            <div class=\"box_coupon_more\">\n                                <div class=\"box_coupon\">\n                                    <table summary=\"쿠폰\" class=\"tbl \">\n                                        <caption class=\"hide\"></caption>\n                                        <colgroup>\n                                            <col width=\"397\" />\n                                            <col width=\"226\" />                             \n                                        </colgroup>\n                                        <tbody id=\"partCouponData\">\n                                        </tbody>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>  \n                    </div>\n                    <div class=\"list_coupon\">\n                        <div class=\"list_coupon_t\">\n                            <div class=\"ticket_btn_cp\" onclick=\"$(this).parent().toggleClass('open');return false;\">\n                                <div class=\"box_coupon_t\">\n                                    <span class=\"tit_cp\">공연예매권 <span class=\"txt_gr\"><span id=\"txtAdvtkCnt\">0</span>개</span></span>\n                                </div>\n                            </div>\n                            <div class=\"box_coupon_more box_gray\">\n                                <div class=\"coupon_register\">\n                                    <p class=\"coupon_use\"><span id=\"loginUserName\"></span>님이 가지고 계신 공연예매권 등록 후에는 등록을 취소할 수 없습니다.</p>\n                                    <div class=\"wrap_form_input coupon_sch\">\n                                        <input type=\"text\" name=\"regAdvtkNo\" id=\"regAdvtkNo\" class=\"inputType top_search\" value=\"\" style=\"text-transform:uppercase;\" title=\"\" value=\"\" maxlength=\"16\"/>\n                                        <label for=\"top_search\" class=\"place_holder\">예매권번호 16자리를 입력하세요.</label>             \n                                    </div>\n                                    <div class=\"btn_coupon\"><span class=\"button btColorGreen\"><a id=\"btnAdvtkReg\" href=\"#\" class=\"btSizeM \">등록</a></span></div>\n                                </div>                          \n                            </div>\n                            <div class=\"box_coupon_more\">\n                                <div class=\"box_coupon\">\n                                    <table summary=\"쿠폰\" class=\"tbl \">\n                                        <caption class=\"hide\"></caption>\n                                        <colgroup>\n                                            <col style=\"width:397px\" />\n                                            <col style=\"width:226px\" />\n                                        </colgroup>\n                                        <tbody id=\"partAdvtkData\">\n                                        </tbody>\n                                    </table>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            -->\n            <!--// 할인수단 선택 -->\n        </div>\n    </div>\n    <!--// 가격선택  영역-->\n    <!--티켓 정보 영역-->\n    <div class=\"wrap_ticket_info\">\n        <h2 class=\"logo_onestop\"><a href=\"#none\"><img src=\"https://cdnticket.melon.co.kr/resource/image/web/common/logo_onestop_en.png\" alt=\"Melon 티켓\"></a></h2>\n        <div class=\"box_info\">\n            <h3 class=\"select_tit select_t txt_prod_name\"></h3>\n            <div class=\"box_ticket\">\n                <ul class=\"box_ticket_list\">\n                    <li class=\"nth nth1 txt_prod_schedule\"></li>\n                    <li class=\"nth nth2 txt_ticket_info\"></li>\n                </ul>\n                <!--좌석정보 레이어팝업-->\n                <div class=\"layer_ticket\" id=\"layer_ticket\">\n                    <div class=\"layer_arr\"></div>\n                    <div class=\"tk_header\">\n                        <div class=\"tk_header1\">\n                            <span class=\"tk_tit\"></span>\n                        </div>                      \n                    </div>\n                    <div class=\"tk_middle\">\n                        <div class=\"tk_middle1\">\n                            <div class=\"tk_con\">\n                                <ul class=\"list_ticket_info\">\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"tk_footer\"><div class=\"tk_footer1\"></div></div>\n                </div>\n                <!--// 좌석정보 레이어팝업-->\n            </div>\n        </div>\n        <div class=\"box_info\">\n            <h3 class=\"select_tit\">Payment</h3>\n            <div class=\"box_ticket\">\n                <div class=\"box_total_inner\">\n                    <p class=\"tk_b\"><span class=\"tk_tit\">Ticket Price</span><span class=\"pay pay_comp\">￦<span id=\"ticketPriceTotal\">0</span></span></p>\n                    <ul class=\"list_tkpay\">\n                        <li><span class=\"tk_tit\">Fixed price</span><span class=\"pay\">￦<span id=\"basePriceTotal\">0</span></span></li>\n                        <li><span class=\"tk_tit\">Discount</span><span class=\"pay\">￦<span id=\"dcPriceTotal\">0</span></span></li>\n                        <!-- \n                        <li><span class=\"tk_tit\">쿠폰할인</span><span class=\"pay\">￦<span id=\"couponAmount\">0</span></span></li>\n                        <li><span class=\"tk_tit\">공연예매권</span><span class=\"pay\">￦<span id=\"advtkAmount\">0</span></span></li>\n                        -->\n                    </ul>\n                </div>\n                <div class=\"box_total_inner\"><p class=\"tk_b\"><span class=\"tk_tit tk_tit_b\" >Service Fee</span><span class=\"pay pay_comp\">￦<span id=\"reservationFee\">0</span></span></p></div>\n                <!-- \n                <div class=\"box_total_inner lst\"><p class=\"tk_b\"><span class=\"tk_tit tk_tit_b\">배송료</span><span class=\"pay pay_comp\">￦<span id=\"delivyFee\">0</span></span></p></div>\n                -->\n                <div class=\"box_total_inner box_result\"><span class=\"tk_tit tot_tit\">Total Amount</span><strong class=\"pay tot_pay\">￦<span id=\"paymentAmount\">0</span></strong></div>\n            </div>\n        </div>\n        <div class=\"box_info_bm\">\n            <div class=\"box_info_list\">\n                <ul class=\"dotlist1x1 one_list\">\n                    <li><span>Cancellation Deadline</span> : <span class=\"txt_og txt_cancel_close_dt\"></span></li>\n                    <li><span>Cancellation Fee</span> : <span class=\"txt_og txt_cancel_fee_info\"></span>\n                        <a href=\"#none\" class=\"btn_flexible btn_flexible_ico2 btn_detail specCancel\"><span>Detail</span></a>\n                        <div class=\"floating_hover_box\"><!-- 2016-01-15 신규 추가 취소수수료 -->\n                        \t<span class=\"bg_top\"></span><!-- UX-466 / 2017-07-11 -->\n                            <strong>Cancellation Fee Info</strong><!-- row가 얼마나 늘어날 수 있을까 최대5개까지는 괜찮은데요..-->\n                            <div class=\"tabling\">\n                                <table summary=\"\">\n                                    <caption></caption>\n                                    <colgroup>\n                                        <col width=\"50%\" />\n                                        <col width=\"50%\" />\n                                    </colgroup>\n                                    <thead>\n                                        <tr>\n                                            <th scope=\"col\">Cancellation Date</th>\n                                            <th scope=\"col\">Cancellation Fee</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody id=\"partCancelFeeList\">\n                                    </tbody>\n                                </table>\n                            </div>\n                            <span class=\"bg_bottom\"></span><!-- UX-466 / 2017-07-11 -->\n                        </div><!-- //2016-01-15 신규 추가 취소수수료 -->\n                    </li>\n                </ul>\n            </div>\n            <div class=\"btn_onestop\">\n                <span class=\"button btWhite frt\"><a href=\"javascript: goBack();\" class=\"btnOne\"><span>Previous</span><em class=\"one_arr prav_ar\">Previous</em></a></span>\n                <span class=\"button btNext\"><a href=\"#\" id=\"nextPayment\" class=\"btnOne\"><span>Next</span><em class=\"one_arr next_ar\">Next</em></a></span>\n            </div>\n        </div>\n    </div>\n    <!--// 티켓 정보 영역 -->\n    <!-- 몇 석 선택했는지 표시하는 영역 생성용 탬플릿 -->\n    <div id=\"txt_seat_grade_tot_template\" style=\"display:'none';\">\n\t    <div id=\"txt_seat_grade_tot_EN\">\n\t        <span class=\"txt\">\n\t            <em class=\"seatGradeSel\">0</em>\n\t            <span class=\"txt_seat_grade_tot\" style=\"display:'none';\">\n\t                &nbsp;of <span class=\"seatGradeTot\">0</span>\n\t            </span> selected\n\t        </span>\n\t    </div>\n\t    <div id=\"txt_seat_grade_tot_CN\">\n\t        <span class=\"txt\">\n\t            <span class=\"txt_seat_grade_tot\" style=\"display:'none';\">\n\t                <span class=\"seatGradeTot\">0</span>张中选择\n\t            </span>\n\t            <em class=\"seatGradeSel\">0</em>张\n\t        </span>\n\t    </div>\n\t    <div id=\"txt_seat_grade_tot_JP\">\n\t        <span class=\"txt\">\n\t            <span class=\"txt_seat_grade_tot\" style=\"display:'none';\">\n\t                <span class=\"seatGradeTot\">0</span>枚から\n\t            </span>\n\t            <em class=\"seatGradeSel\">0</em>枚選択\n\t        </span>\n\t    </div>\n\t    <div id=\"txt_seat_grade_tot_KR\">\n\t        <span class=\"txt\">\n\t            <span class=\"txt_seat_grade_tot\" style=\"display:'none';\">\n\t                <span id=\"seatGrade_tot\">0</span>매중 \n\t            </span>\n\t            <em id=\"seatGrade_sel\">0</em>매 선택\n\t        </span>\n\t    </div>\n    </div>\n    <!-- //몇 석 선택했는지 표시하는 영역 생성용 탬플릿 -->\n</div>\n\n<!-- ZAM-netfunnel -->\n<script type=\"text/javascript\" src=\"/resource/script/web/common/netfunnel.js\"></script>\n\n<script type=\"text/javascript\">\n\nvar chkDcCard           = false;\nvar maxCount            = parent.prodData.limitVolume;\nvar seatCount           = parent.data.selectedSeatCount == 0 ? 10 : parent.data.selectedSeatCount;\nvar flplanTypeCode      = parent.$(\"#flplanTypeCode\").val();\nvar seatTypeCode        = parent.$(\"#seatTypeCode\").val();\nvar limitVolume         = {};\nvar prevPriceCnt        = 0;\n\nfunction goDelivery() {\n\t\n\t// 캠핑권 매수 체크 S\n    if(campingTicketCheck() == false) return false;\n    // 캠핑권 매수 체크 E\n\t\n    if (flplanTypeCode != \"DR0003\" && \"SE0003\" !== seatTypeCode) {\n        if (seatCount != parent.selectedTicketCount) {\n            alertGlb(\"Select the price first.\");\n            return false;\n        }\n    }\n    else {\n        if (parent.selectedTicketCount <= 0) {\n            alertGlb(\"Select the price first.\");\n            return false;\n        }\n    }\n          \n    var advtkCount              = $(\"input[name='advtkNo']:checked\").length;\n\n    if (advtkCount > 0) {\n        var basicTypeCnt      = 0;\n        $.each(parent.typeData, function (key, val) {\n            if (val.dcYn == \"N\") basicTypeCnt   += parseInt(val.selectedVolume, 10);\n        });\n        if (advtkCount > basicTypeCnt) {\n            alert(\"공연예매권은 일반권종에만 사용이 가능합니다.\");\n            return false;\n        }\n    }\n    \n    if (setCalc()) {\n        chkPriceLimit();\n    }\n}\n\nfunction chkPriceLimit() {\n    // 할인권종 매수제한 체크 [DcPrice]\n    if (!parent.chkDcPrice()) return false;\n\n    var params = parent.$(\"#sForm\").serializeArray();\n    \n    $.each(parent.typeData, function(key, val) {\n        if (parseInt(val.selectedVolume) > 0) {\n            params.push({name:\"priceNo\"             , value: val.priceNo});\n            params.push({name:\"rsrvVolume\"          , value: val.selectedVolume});\n        }\n    });\n\n    var firstSeatId = 0; //default 0\n    var firstTicket = [];\n    $.each(parent.typeData, function(key, val) {\n        if (parseInt(val.selectedVolume) > 0) {\n            firstTicket = val;\n            return false; //break\n        }\n    });\n\n    var seatInfo = {};\n    $.each(parent.data.seatdata, function(key1, val1) {\n               if (firstTicket.seatGradeNo == val1.grade){\n            firstSeatId = val1.sid;\n            return false; //break\n        }\n    });\n    params.push({ name : \"chkcapt\"    , value : Captcha.getData()});\n\n    $.ajax({\n        type            : \"POST\"\n        , dataType      : \"jsonp\"\n        , url           : APIURL + \"/glb/reservation/pricelimit.json?v=1\"\n        , async         : false\n        , data          : params\n        , success       : function(result) {\n            var v_prodId\t\t= parent.prodData.prodId ;\n            var v_scheduleNo\t= parent.prodData.scheduleNo;\n            var v_firstSeatId\t= firstSeatId;\n            if(result.result == \"0000\") {\n                var params = $.param({\n                     prodId : v_prodId\n                    ,scheduleNo : v_scheduleNo\n                    ,firstSeatId : v_firstSeatId\n                });\n                location.href           = CTX + \"/reservation/popup/stepDelvy.htm?\" + params;\n            } else if (result.code == 'T0002') {                // T0002 : 인증 미완료시\n                parent.captchaObj.show();\n                Captcha.setData('');\n            } else {\n                alert(replaceEnToLangCd(MSG_PROP,result.message));\n            }\n        }\n        , error         : function(e) {\n        \t\talert(\"다시 시도부탁드립니다.\");\n            history.back();\n        }\n    });\n}\n\nfunction sltTicket(volume, seatgrade, priceno) {\n\t\n\t//지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh S\n\t//텐트상품을 위한 함수\n\ttentTicketList(volume, seatgrade);\n\t//지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh E\n\t\n    if (flplanTypeCode != \"DR0003\" && seatTypeCode !== \"SE0003\") {\n        vldTicket(volume, seatgrade, priceno);\n    }\n    else {\n        var seatId                  = \"\";\n        var selectedGradeVolume     = 0;\n\n        $.each(parent.seatData, function(key, val) {\n            if (seatgrade == val.grade) seatId = val.sid;\n        });\n\n        $(\".selectSeatGrade_\" + seatgrade).each(function() {\n            if(!isNaN(this.value) && this.value.length != 0) {\n                selectedGradeVolume += parseFloat(this.value);\n            }\n        });\n\n        $.ajax({\n            type           : \"POST\"\n            , dataType     : \"jsonp\"\n            , url          : APIURL + \"/product/seatStateInfo.json?v=1\"\n            , async        : false\n            , data         : {\"prodId\" : parent.prodData.prodId, \"scheduleNo\" : parent.prodData.scheduleNo, \"seatId\" : seatId, \"volume\" : parseInt(volume.value, 10), \"selectedGradeVolume\" : selectedGradeVolume}\n            , success      : function(result) {\n                var rmdSeatCnt   = parseInt(result.rmdSeatCnt, 10);\n                var chkResult    = parseInt(result.chkResult, 10);\n                \n                if (chkResult < 1) {\n                    if(rmdSeatCnt == 0) {\n                        alert(\"Already Sold out.\");\n                        volume.value                = parent.typeData[seatgrade + \"_\" + priceno].selectedVolume;\n                    }\n                    else {\n                        alert(\"The remaining quantity : \" + rmdSeatCnt + \", Please select the number again.\");\n                        volume.value                = parent.typeData[seatgrade + \"_\" + priceno].selectedVolume;\n                    }\n                }\n                else {\n                    vldTicket(volume, seatgrade, priceno);\n                }\n            }\n            , error        : function(e) {\n                alert(replaceEnToLangCd(MSG_PROP,\"System Error. Please ask melonticket.\"));\n                volume.value                = parent.typeData[seatgrade + \"_\" + priceno].selectedVolume;\n            }\n        });\n    }\n}\n\nfunction vldTicket(volume, seatgrade, priceno) {\n    var selectedGradeCount      = 0;\n    var totalGradeCount         = 0;\n    var couponCount             = $(\"input[name='couponNo']:checked\").length;\n    var advtkCount              = $(\"input[name='advtkNo']:checked\").length;\n    var tdata                   = parent.typeData[seatgrade + \"_\" + priceno];\n\n    $(\".selectSeatGrade_\" + seatgrade).each(function() {\n        if(!isNaN(this.value) && this.value.length != 0) {\n            selectedGradeCount += parseFloat(this.value);\n        }\n    });\n\n    $(\".selectSeatGrade\").each(function() {\n        if(!isNaN(this.value) && this.value.length != 0) {\n            totalGradeCount += parseFloat(this.value);\n        }\n    });\n\n    if ((flplanTypeCode != \"DR0003\" && seatTypeCode != \"SE0003\") && $(\"#seatGrade\" + seatgrade + \"_tot\").text() < selectedGradeCount) {\n    \t$(volume).val(parent.typeData[seatgrade + \"_\" + priceno].selectedVolume);\n        alert(replaceEnToLangCd(MSG_PROP,\"The quantity you can choose is exceeded.\"));\n        return false;\n    }\n    else {\n        // 비지정석 매수체크\n        if(maxCount < totalGradeCount) {\n            $(volume).val(parent.typeData[seatgrade + \"_\" + priceno].selectedVolume);\n            var volumeTypeAndLimit = '';\n            volumeTypeAndLimit += maxCount + \" \" +replaceKrToLangCd(COMMON_PROP,\"매\") + \" \";\n\n            if(limitVolume.VOLUMETYPECODE == 'CL0001'){\n                volumeTypeAndLimit += '';\n            }else if(limitVolume.VOLUMETYPECODE == 'CL0002'){\n                volumeTypeAndLimit += replaceKrToLangCd(COMMON_PROP,\"회원별\");\n            }else if(limitVolume.VOLUMETYPECODE == 'CL0003'){\n                volumeTypeAndLimit += replaceKrToLangCd(COMMON_PROP,\"주문별\");\n            }else if(limitVolume.VOLUMETYPECODE == 'CL0004'){\n                volumeTypeAndLimit += replaceKrToLangCd(COMMON_PROP,\"회차별\");\n            }\n\n            alert(replaceKrToLangCd(COMMON_PROP,\"예매 가능 매수를 초과하였습니다.\") + \" (\"+volumeTypeAndLimit+\")\");\n            return false;\n        }\n\n        var dcTypeCode              = tdata.dcTypeCode;\n        var prevCondPriceNo         = tdata.prevCondPriceNo;\n\n        if (prevPriceCnt > 0) {\n            if (prevCondPriceNo != 0) {\n            \tif (volume.value > 0) {\n                    var prevdata               = parent.typeData[seatgrade + \"_\" + prevCondPriceNo];\n                    if (prevdata.selectedVolume <= 0) {\n                    \t$(volume).val(parent.typeData[seatgrade + \"_\" + priceno].selectedVolume);\n                        alert(\"<\" + prevdata.priceName + \">을 함께 선택해주셔야 예매가 가능합니다.\");\n                        return false;\n                    }\n            \t}\n            }\n            else {\n            \tif (volume.value <= 0) {\n            \t\tvar nextCnt           = 0;\n                    var prevdata               = parent.typeData[seatgrade + \"_\" + priceno];\n                    $.each(parent.typeData, function(key, val) {\n                        if (seatgrade == val.seatGradeNo && priceno == val.prevCondPriceNo) {\n                            nextCnt                 += parseInt($(\"#volume_\" + val.seatGradeNo + \"_\" + val.priceNo).val(), 10);\n                        }\n                    });\n                    if (nextCnt > 0) {\n                        alert(\"<\" + prevdata.priceName + \">을 함께 선택해주셔야 예매가 가능합니다.\");\n                        $(volume).val(parent.typeData[seatgrade + \"_\" + priceno].selectedVolume);\n                        return false;\n                    }\n                    /*\n                    $.each(parent.typeData, function(key, val) {\n                        if (seatgrade == val.seatGradeNo && priceno == val.prevCondPriceNo) {\n                            var nextvolume          = $(\"#volume_\" + val.seatGradeNo + \"_\" + val.priceNo);\n                        \tparent.typeData[val.seatGradeNo + \"_\" + val.priceNo].selectedVolume = 0;\n\n                            nextvolume.val(0);\n                            nextvolume.parent().parent().parent().parent().parent().removeClass(\"on\");\n                            nextvolume.parent().parent().parent().next().removeClass(\"open\");\n                        }\n                    });\n                    */\n            \t}\n            }\n        }\n        \n        if (dcTypeCode == \"DP0002\") {\n            \n            if (volume.value > 0) {\n                parent.$(\"#cardGroupId\").val(tdata.cardGroupId == null ? \"\" : tdata.cardGroupId);\n                parent.$(\"#cardBpId\").val(tdata.cardBpId == null ? \"\" : tdata.cardBpId);\n                parent.$(\"#cardMid\").val(tdata.mid == null ? \"\" : tdata.mid);\n            }\n            else {\n                parent.$(\"#cardGroupId\").val(\"\");\n                parent.$(\"#cardBpId\").val(\"\");\n                parent.$(\"#cardMid\").val(\"\");\n            }\n        } \n        else if (dcTypeCode == \"DP0003\") {\n            var selectedCount           = 0;\n            var dcClass                 = \".selectDcType_\" + tdata.dcTypeCode + \"_\" + tdata.cardGroupId + \"_\" + tdata.cardBpId;\n//          var nonCardList             = $(\".selectSeatGrade\").not(dcClass).filter(\"[value != 0]\");\n//          var dcCardList              = $(\".selectSeatGrade\").filter(dcClass).filter(\"[value != 0]\");\n            var nonCardList             = $(\".selectSeatGrade\").not(dcClass).filter(function(){return this.value > 0});\n            var dcCardList              = $(\".selectSeatGrade\").filter(dcClass).filter(function(){return this.value > 0});\n\n            \n            if (dcCardList.length <= 0) {\n                if (chkDcCard) {\n                    $(\".selectSeatGrade\").not(dcClass).show().attr(\"disabled\", false);\n                    chkDcCard = !chkDcCard;\n\n                    parent.$(\"#cardGroupId\").val(\"\");\n                    parent.$(\"#cardBpId\").val(\"\");\n                    parent.$(\"#cardMid\").val(\"\");\n                }\n            }\n            else {\n                \n                if (!chkDcCard) {\n                    \n                    if (nonCardList.length > 0) {\n                        if (confirm(\"카드 할인 가격은 다른 가격과 같이 사용하실 수 없습니다. 다른 가격을 초기화 하시겠습니까?\")) {\n                            $(\".selectSeatGrade\").not(dcClass).val(0).attr(\"disabled\", true);\n                            //\".selectSeatGrade\").parent().parent().parent().removeClass(\"box_ticket_t_select\");\n                            //$(\".selectSeatGrade\").parent().children(\".sel_out\").html(\"0매\");\n                            nonCardList.each(function(){\n                                parent.typeData[this.id.replace(\"volume_\",\"\")].selectedVolume = 0;\n                            });\n                        }\n                        else {\n                            volume.value = parent.typeData[seatgrade + \"_\" + priceno].selectedVolume;\n                            return;\n                        }\n                    }\n                    else {\n                        $(\".selectSeatGrade\").not(dcClass).val(0).attr(\"disabled\", true);\n                    }\n                    chkDcCard           = true;\n                    parent.$(\"#cardGroupId\").val(tdata.cardGroupId == null ? \"\" : tdata.cardGroupId);\n                    parent.$(\"#cardBpId\").val(tdata.cardBpId == null ? \"\" : tdata.cardBpId);\n                    parent.$(\"#cardMid\").val(tdata.mid == null ? \"\" : tdata.mid);\n                }\n            }\n        }\n\n        if (volume.value > 0) {\n\t        $(volume).parent().parent().parent().parent().parent().addClass(\"on\");\n\t        $(volume).parent().parent().parent().next().addClass(\"open\");\n        } else {\n            $(volume).parent().parent().parent().parent().parent().removeClass(\"on\");\n            $(volume).parent().parent().parent().next().removeClass(\"open\");\n        }\n\n        $(\"#seatGrade\" + seatgrade + \"_sel\").text(selectedGradeCount);\n        parent.typeData[seatgrade + \"_\" + priceno].selectedVolume = volume.value;\n        \n        // 티켓가격 매수 선택시 쿠폰선택정보 초기화\n        $(\"input[name='couponNo']\").each(function(){\n            this.checked = false;\n            parent.couponData[this.value].selectedYn = \"N\";\n            parent.couponData[this.value].couponDcPrice = 0;\n        });\n        \n        setCalc();\n        \n        if ($(\".selectSeatGrade option:selected\").filter(function(){return this.value > 0}).length > 0) {\n            $(\"#nextPayment\").parent().addClass(\"on\"); \n        }\n        else {\n            $(\"#nextPayment\").parent().removeClass(\"on\"); \n        }\n    }\n}\n\nfunction setCalc() {\n    var basePrice               = 0;\n    var ticketCount             = 0;\n    var selectedBaseTotal       = 0;\n    var selectedPriceTotal      = 0;\n    var paymentAmount           = 0;\n    var dcPriceTotal            = 0;\n    var reservationFee          = 0;\n    var deliveryCost            = 0;\n    var couponAmount            = 0;\n    var advtkAmount             = 0;\n    var advtkCount              = 0;\n    var chargeTotal             = 0;\n    var discountTotal           = 0;\n\n    $.each(parent.typeData, function(key, val){\n        selectedBaseTotal       += (parseInt(val.basePrice, 10) * parseInt(val.selectedVolume, 10));\n        selectedPriceTotal      += (parseInt(val.ticketTypePrice, 10) * parseInt(val.selectedVolume, 10));\n        ticketCount             += parseInt(val.selectedVolume, 10);\n        basePrice               = parseInt(val.basePrice, 10);\n    });\n\n    $.each(parent.couponData, function(key, val){\n        if(val.selectedYn == \"Y\") couponAmount += val.couponDcPrice;\n    });\n\n    $.each(parent.advtkData, function(key, val){\n        if(val.selectedYn == \"Y\") {\n            advtkAmount += parseInt(val.basePrice, 10);\n            advtkCount++;\n        }\n    });\n\n    $.each(parent.data.seatdata, function(key, val) {\n        //if (val.advtkNo != null && val.advtkNo != \"\" && val.advtkNo != undefined) {\n        //    advtkAmount     += parseInt(val.basePrice, 10);\n        //    advtkCount++;\n        //}\n    });\n\n    reservationFee              = parseInt(parent.prodData.rsrvFee, 10) * (ticketCount - advtkCount);\n    deliveryCost                = 0;\n    dcPriceTotal                = selectedBaseTotal - selectedPriceTotal;\n    chargeTotal                 = selectedBaseTotal + reservationFee + deliveryCost;\n    discountTotal               = dcPriceTotal + couponAmount + advtkAmount;\n    paymentAmount               = chargeTotal - discountTotal;\n    parent.selectedTicketCount  = ticketCount;\n    $(\"#txtNoneSeatCount\").text(ticketCount);\n\n    $(\"#ticketPriceTotal\").text(addComma(selectedBaseTotal - discountTotal));\n    $(\"#basePriceTotal\").text(addComma(selectedBaseTotal));\n    $(\"#reservationFee\").text(addComma(reservationFee));\n    $(\"#dcPriceTotal\").text(addComma(-dcPriceTotal));\n    $(\"#couponAmount\").text(addComma(-couponAmount));\n    $(\"#advtkAmount\").text(addComma(-advtkAmount));\n    $(\"#paymentAmount\").text(addComma(paymentAmount));\n    \n    if (advtkCount == 0 && paymentAmount < 0) {\n        alert(\"결제 대상금액 오류 입니다. 쿠폰 및 예매권 사용을 취소해 주시기 바랍니다.\");\n        \n        if ($(\"input[name='couponNo']:checked\").length > 0) {\n            resetCoupon();\n            setCalc();\n        }\n        return false;\n    }\n    else {\n        return true;\n    }\n}\n\nfunction setAdvtk() {\n    var ticketCount = 0;\n    var advtkCheckCount = 0;\n    $.each(parent.typeData, function(key, val) {\n        ticketCount += parseFloat(val.selectedVolume);\n    });\n    \n    $.each(parent.advtkData, function(key, val){\n        if(val.selectedYn == \"Y\") advtkCount++;\n    });\n    \n    if (advtkCheckCount > 0) {\n        if (advtkCheckCount > ticketCount) {\n            alert(\"선택하신 예매권이 선택하신 좌석 수를 초과할 수 없습니다. 예매권 선택을 초기화 합니다.\");\n            \n            $(\"input[name='advtkNo']\").prop( \"checked\", false );                \n            $.each(parent.advtkData, function(key, val){\n                val.selectedYn == \"N\";\n                val.advtkPrice == \"0\";\n            });\n        }\n        else {\n            var advtkseq = 0;\n            $.each(parent.typeData, function(key, val) {\n                for (var i=0 ; i > parseFloat(val.selectedVolume) ; i++) {\n                    //val.basePrice\n                }\n            });\n        }\n    }\n}\n\nfunction checkTicketCount() {\n    if (flplanTypeCode != \"DR0003\" && seatTypeCode != \"SE0003\") {\n        if (seatCount != parent.selectedTicketCount) {\n            alert(replaceEnToLangCd(MSG_PROP,\"Select the price first.\"));\n            return false;\n        }\n    }\n    else {\n        if (parent.selectedTicketCount <= 0) {\n            alert(replaceEnToLangCd(MSG_PROP,\"Select the price first.\"));\n            return false;\n        }\n    }\n    return true;\n}\n\nfunction selectedCoupon(coupon) {\n    if(!coupon.checked) {\n        parent.couponData[coupon.value].selectedYn = \"N\";\n        parent.couponData[coupon.value].couponDcPrice = 0;\n        setCalc();\n        return;\n    }\n\n    resetCoupon();\n \n    if(!checkTicketCount()) return;\n\n    if($(\"input[name='advtkNo']:checked\").length > 0) {\n        alert(\"쿠폰은 예매권과 같이 사용 할 수 없습니다.\");\n        return;\n    }\n    \n    coupon.checked = true;\n    \n    var couponDcPrice       = 0;\n    var dcVolume            = 0; // 할인받을 매수\n    var ticketAmount        = 0; // 티켓금액\n    var couponNo            = $(\"input[name='couponNo']:checked\").val();\n    var selCouponData       = parent.couponData[couponNo];\n           \n    $.each(parent.typeData, function(key, val){\n        ticketAmount += parseInt(val.ticketTypePrice, 10) * parseInt(val.selectedVolume, 10);\n    });\n        \n    if(selCouponData.discInfo.minOrderPrice && selCouponData.discInfo.minOrderPrice > ticketAmount) { // 최소 구매금액\n        alert(\"최소 티켓금액이 \" + addComma(selCouponData.discInfo.minOrderPrice) + \"원 이상인 경우에 사용 할 수 있는 쿠폰입니다.\");\n        coupon.checked = false;\n        \n        resetCoupon();\n        setCalc();\n        return;\n    }\n    \n    var discProdTypeFlg = selCouponData.desc.discProdTypeFlg;       /* AL:전체상품, GR:특정장르, PR:특정상품, SC:특정상품의좌석등급 */\n    var discTypeFlg     = selCouponData.discInfo.discTypeFlg;       /* FIXED_PRICE:정액제, FIXED_RATIO:정률제 */ \n    var discScope       = selCouponData.discCoverrage.discScope;     /* TICKET_COUNT:구매매수당, PER_TRAN:구매 건당, FEE:예매수수료 면제 */\n    var maxDiscPrice    = selCouponData.discInfo.maxDiscPrice;      /* 최대할인금액 */\n    var maxDiscTicket   = selCouponData.discCoverrage.maxDiscTicket; /* 최대할인매수 */\n    var discAmount      = selCouponData.discInfo.discAmount;        /* 할인금액(원,%) */            \n    var seatGradeNo     = selCouponData.desc.seatGradeNo;           /* 좌석등급번호 */\n    \n    maxDiscTicket = maxDiscTicket ? maxDiscTicket : 999999;\n    \n    // 티켓가격 매수가 선택된 항목들만 금액 높은순으로 정렬\n    var typeDataArr = [];\n    $.each(parent.typeData, function(key, val){\n        if(parseInt(val.selectedVolume, 10) > 0) {\n            typeDataArr.push(val);\n        }\n    });\n    for(var i = 0; i < typeDataArr.length; i++) {\n        for(var j = i; j < typeDataArr.length; j++) {\n            if(typeDataArr[i].ticketTypePrice < typeDataArr[j].ticketTypePrice) {\n                var tmp = typeDataArr[i];\n                typeDataArr[i] = typeDataArr[j];\n                typeDataArr[j] = tmp;\n            }\n        }\n    }\n    \n    $.each(typeDataArr, function(key, val){\n        var selectedVolume = parseInt(val.selectedVolume, 10);\n        // 권종의 중복할인가능여부 및 선택매수 체크\n        if(val.dupDcYn == \"N\" || selectedVolume <= 0) {\n            return;\n        }\n        // 특정좌석등급만 쿠폰적용 가능한 경우 체크\n        if(discProdTypeFlg == \"SC\" && seatGradeNo.indexOf(val.seatGradeNo) == -1) {\n            return;\n        }\n        \n        if(discScope == \"TICKET_COUNT\") { // 구매매수당\n            if(maxDiscTicket == dcVolume) {\n                return;\n            }\n            \n            if((dcVolume + selectedVolume) > maxDiscTicket) {\n                selectedVolume = maxDiscTicket - dcVolume;\n            }\n            dcVolume      += selectedVolume;\n            if(discTypeFlg == \"FIXED_PRICE\") { // 정액제\n                couponDcPrice += discAmount * selectedVolume;   \n            } else if(discTypeFlg == \"FIXED_RATIO\") { // 정률제\n                couponDcPrice += Math.floor(parseInt(val.ticketTypePrice, 10) * discAmount / 100) * selectedVolume;\n            }\n            \n\n        } else if(discScope == \"PER_TRAN\") { // 구매건당\n            if(discTypeFlg == \"FIXED_PRICE\") { // 정액제\n                couponDcPrice = discAmount;\n            } else if(discTypeFlg == \"FIXED_RATIO\") { // 정률제\n                couponDcPrice += Math.floor(parseInt(val.ticketTypePrice, 10) * discAmount / 100) * selectedVolume;\n            }\n        \n        } else if(discScope == \"FEE\") { // 예매수수료 면제\n            if(maxDiscTicket == dcVolume) {\n                return;\n            }\n            if((dcVolume + selectedVolume) > maxDiscTicket) {\n                selectedVolume = maxDiscTicket - dcVolume;\n            }\n            dcVolume      += selectedVolume;\n            couponDcPrice += parseInt(parent.prodData.rsrvFee, 10) * selectedVolume;\n                            \n        }\n        \n    });\n    \n    if(couponDcPrice == 0) {\n        coupon.checked = false;\n        alert(\"할인쿠폰을 사용할 수 없는 가격을 선택하였습니다. 선택한 가격을 확인해주세요.\");\n\n        resetCoupon();\n        setCalc();\n        return;\n    }\n    \n    if(maxDiscPrice && maxDiscPrice < couponDcPrice) {\n        couponDcPrice = maxDiscPrice;\n    }\n    \n    parent.couponData[couponNo].selectedYn = \"Y\";\n    parent.couponData[couponNo].couponDcPrice = couponDcPrice;\n        \n    setCalc();\n              \n    return;\n}\n\nfunction resetCoupon() {\n    // 쿠폰선택초기화\n    $(\"input[name='couponNo']\").each(function(){\n        this.checked = false;\n        parent.couponData[this.value].selectedYn = \"N\";\n        parent.couponData[this.value].couponDcPrice = 0;\n    });\n}\n\nfunction selectedAdvtk(advtk) {\n    var ttCount             = 0;\n    var tgCount             = 0;\n    var dcCount             = 0;\n    var noBasicTypeCount    = 0;\n    var advtkInfo           = parent.advtkData[advtk.value];\n\n    if (advtk.checked) {\n        if($(\"input[name='couponNo']:checked\").length > 0) {\n            advtk.checked = false;\n            alert(\"예매권은 쿠폰과 같이 사용 할 수 없습니다.\");\n            return false;\n        }\n        \n        $.each(parent.typeData, function(key, val) {\n            ttCount += parseFloat(val.selectedVolume);\n            if (advtkInfo.seatGradeNo != null && advtkInfo.seatGradeNo != \"\") {\n                if (advtkInfo.seatGradeNo == val.seatGradeNo && val.dcYn == \"N\") {\n                    tgCount        += parseFloat(val.selectedVolume);\n                } else if (val.dcYn != \"N\"){\n                    noBasicTypeCount += parseFloat(val.selectedVolume);\n                }\n            }\n            else {\n                tgCount        += parseFloat(val.selectedVolume);\n            }\n        });\n        \n        if (ttCount <= 0) {\n            advtk.checked       = false;\n            alert(\"가격을 먼저 선택해 주세요.\");\n            return false;\n        }\n        else {\n            // 등급제한이 있을 경우\n            if (advtkInfo.seatGradeNo != null && advtkInfo.seatGradeNo != \"\") {\n                var eqGradeCnt        = 0;\n                var adGradeCnt        = 0;\n                \n                if (flplanTypeCode != \"DR0003\" && seatTypeCode != \"SE0003\") {\n                    $.each(parent.data.seatdata, function(key, val) {\n                        if (advtkInfo.seatGradeNo == val.grade) eqGradeCnt++;\n                    });\n                }\n                else {\n                    $(\".selectSeatGrade_\" + advtkInfo.seatGradeNo).each(function() {\n                        if(!isNaN(this.value) && this.value.length != 0) {\n                            eqGradeCnt += parseFloat(this.value);\n                        }\n                    });\n                }\n\n                if (eqGradeCnt <= 0) {\n                    advtk.checked       = false;\n                    alert(\"선택하신 예매권은 \" + advtkInfo.seatGradeName + \"등급에서만 사용 가능합니다.\");\n                    return false;\n                }\n                \n                $.each(parent.advtkData, function(key, val) {   \n                    if (advtkInfo.seatGradeNo == val.seatGradeNo && val.selectedYn == \"Y\") {\n                        adGradeCnt++;\n                    }\n                });\n\n                if (tgCount <= adGradeCnt) {\n                    advtk.checked       = false;\n                    //alert(\"선택하신 예매권(\" + advtkInfo.seatGradeName + \"등급) 수량(\" + adGradeCnt + \")이 선택하신 동일 등급 좌석수(\" + tgCount + \")를 초과합니다.\");\n                    var msg = '';\n                    if(noBasicTypeCount > 0){\n                        msg = \"공연예매권은 기본가를 선택 시에만 이용하실 수 있습니다.\";\n                    } else {\n                        msg = \"선택 매수를 초과하였습니다.\";\n                    }\n                    alert(msg);\n                    return false;\n                }\n                \n            }\n            // 등급제한이 없을 경우\n            else {\n                var seatCnt             = 0;\n                var advtkCnt            = 0;\n\n                if (flplanTypeCode != \"DR0003\" && seatTypeCode != \"SE0003\") {\n                    $.each(parent.data.seatdata, function(key, val) {\n                        seatCnt++;\n                    });\n                }\n                else {\n                    $(\".selectSeatGrade\").each(function() {\n                        if(!isNaN(this.value) && this.value.length != 0) {\n                            seatCnt += parseFloat(this.value);\n                        }\n                    });\n                }\n                \n                $.each(parent.advtkData, function(key, val) {\n                    if (val.selectedYn == \"Y\") advtkCnt++;\n                });\n                \n                if (tgCount < advtkCnt) {\n                    advtk.checked       = false;\n                    alert(\"선택하신 예매권 수량(\" + (advtkCnt + 1) + \")이 선택하신 동일 좌석수(\" + seatCnt + \")를 초과합니다.\");\n                    return false;\n                }\n            }\n        }\n        \n        parent.advtkData[advtk.value].selectedYn = \"Y\";\n\n        $.each(parent.data.seatdata, function(key, val) {\n            if (advtkInfo.seatGradeNo == val.grade && (val.advtkNo == \"\" || val.advtkNo == undefined)) {\n                val.advtkNo                 = advtkInfo.advtkNo;\n                val.basePrice               = advtkInfo.basePrice;\n                return false;\n            }\n        });\n    }\n    else {\n        parent.advtkData[advtk.value].selectedYn = \"N\";\n\n        $.each(parent.data.seatdata, function(key, val) {\n            if (val.advtkNo == advtkInfo.advtkNo) {\n                val.advtkNo                 = \"\";\n                val.basePrice               = \"\";\n            }\n        });\n    }\n    \n    // 결제 정보 재계산\n    setCalc();\n}\n\nfunction bindTicketList(tdata) {\n    var thtml                   = \"\";\n    var ticketObj               = $(\"#partTicketType\");\n    prevPriceCnt                = 0;\n    ticketObj.empty();\n    var _$dom = {};\n    $.each(tdata, function(key, val) {\n        var gradetitle              = $(\"<h4/>\");\n        \n      \t//지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh S\n    \tvar cSGN = \"\";\n    \tif(parent.campingTentFlag == \"T\"){\t//텐트권 일때만\n\t    \tif(parent.campingSGN.split(',').length > 0){\n\t\t    \tfor(var i = 0; i < parent.campingSGN.split(',').length ; i++){\n\t\t        \tif(val.seatGradeNo == parent.campingSGN.split(',')[i]){\n\t\t        \t\tcSGN = val.seatGradeNo;\n\t\t        \t}\n\t\t        }\n\t    \t}else{\n\t    \t\tcSGN = \"00000\";\n\t    \t}\n\t     \t\n\t\t\tif(cSGN != \"00000\" && cSGN==\"\"){\n\t\t\t\tgradetitle          = $(\"<h4 class='h4TitleDisplay' style='display:none' />\");\n\t\t\t}\n    \t}\n    \t//지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh E\n        \n        gradetitle.append(\"<strong class=\\\"tit_ticket\\\">\" + val.seatGradeName + \"</strong>\");\n\n        //몇 석 선택하는지 표시하는 영역 생성하여 삽입\n        _$dom.tempSeatGradeTot = $('#txt_seat_grade_tot_template').find('#txt_seat_grade_tot_'+langCd).clone();\n        _$dom.tempSeatGradeTot.find('em.seatGradeSel')[0].id = \"seatGrade\" + val.seatGradeNo + \"_sel\";\n        _$dom.tempSeatGradeTot.find('em.seatGradeSel')[0].innerText = '0';\n        _$dom.tempSeatGradeTot.find('span.seatGradeTot')[0].id = \"seatGrade\" + val.seatGradeNo + \"_tot\";\n        _$dom.tempSeatGradeTot.find('span.seatGradeTot')[0].innerText = val.seatCount;\n        var viewTotSelected = \"none\";\n        if(flplanTypeCode == \"DR0003\" || seatTypeCode == \"SE0003\"){\n            viewTotSelected = \"none\";\n        } else {\n            viewTotSelected = \"\"; //inline, inline-block\n        }\n        _$dom.tempSeatGradeTot.find('span.txt_seat_grade_tot')[0].style.display = viewTotSelected;\n        gradetitle.append(_$dom.tempSeatGradeTot.html());\n        $('#txt_seat_grade_tot_template')[0].style.display = 'none';\n        //기존 로직\n        //gradetitle.append\n        //(\n        //    \"<span class=\\\"txt\\\">\"\n        //    +\"<span class=\\\"txt_seat_grade_tot\\\" style=\\\"display: \"\n        //    +((flplanTypeCode == \"DR0003\" || seatTypeCode == \"SE0003\") ? \"none\" : \"\") + \";\\\">\"\n        //    +\"<em id=\\\"seatGrade\" + val.seatGradeNo + \"_sel\\\">0</em> of \"\n        //    + \"<span id=\\\"seatGrade\" + val.seatGradeNo + \"_tot\\\">\" + val.seatCount + \"</span> selected</span>\"\n        //);\n\n        ticketObj.append(gradetitle);\n        \n        $.each(val.prodTicketTypeList, function(key1, val1) {\n        \t\n        \t// 2016.07.19, 안지원M 요청\n        \t// 카드할인권종은 노출 시키지 않음\n        \tif(val1.cardBpId == null || val1.cardBpId == ''){\n        \t\t\n        \t}else{\n        \t\t\n        \t\treturn true;\n        \t}\n        \t\n            var ttypeobj                = $(\"<div />\").addClass(\"list_ticket\");\n            \n         \t //지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh S\n        \tif(cSGN != \"00000\" && cSGN==\"\" && parent.campingTentFlag == \"T\"){\n   \t\t\t\tttypeobj            = $(\"<div style='display:none' />\").addClass(\"list_ticket listTicketDisplay\");\n    \t\t}\n        \t//지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh E\n\n            //TICKETDEV-315 [공통] 권종 매진 시 표기 수정\n            if( val1.dcPriceSoldOutYn == \"Y\" && val1.dcPriceSellYCnt == 0 ){\n                ttypeobj                = $(\"<div />\").addClass(\"list_ticket soldout\")\n            }\n\n            var ttypebok                = $(\"<div />\").addClass(\"box_ticket_t\");\n            var ttypewrap               = $(\"<div />\");\n            var ttypebtn                = $(\"<div />\");\n            var ttypedl                 = $(\"<dl />\");\n            var ttypetkdt               = $(\"<dt />\").addClass(\"tit_tk\");\n            var ttypeprcdd              = $(\"<dd />\").addClass(\"price price_sale\");\n            var ttypeprcrdd             = $(\"<dd />\").addClass(\"price price_sale_r\");\n            var ttypeseldd              = $(\"<dd />\").addClass(\"price wrap_sel\");\n            var ttypemore               = $(\"<div class=\\\"box_ticket_more\\\"/>\").html(val1.dcContent);\n            var ttypemore               = $(\"<div />\").addClass(\"box_ticket_more\").html($(\"<p />\").addClass(\"tit_more_info\").text(val1.dcContent));\n            var ttypesel                = $(\"<select id=\\\"volume_\" + val1.seatGradeNo + \"_\" + val1.priceNo + \"\\\" name=\\\"volume_\" + val1.seatGradeNo + \"_\" + val1.priceNo + \"\\\"/>\");\n            var maxSellVolume           = (val1.maxSellVolume == null || val1.maxSellVolume == 0) ? val.seatCount : (val.seatCount > val1.maxSellVolume ? val1.maxSellVolume : val.seatCount);\n            var minSellVolume           = (val1.minSellVolume == null) ? 0 : val1.minSellVolume;\n            var buyUnitVolume           = (val1.buyUnitVolume == null || val1.buyUnitVolume == 0) ? 1 : val1.buyUnitVolume;\n            \n            ttypesel.addClass(\"sel_cate\");\n            ttypesel.addClass(\"selectSeatGrade\");\n            ttypesel.addClass(\"selectSeatGrade_\" + val1.seatGradeNo);\n            ttypesel.addClass(\"selectDcType_\" + val1.dcTypeCode + \"_\" + val1.cardGroupId + \"_\" + val1.cardBpId);\n            ttypesel.attr(\"onChange\", \"sltTicket(this, '\" + val1.seatGradeNo + \"', '\" + val1.priceNo + \"');\");\n            \n            var useDefaultVol = true;\n          \t//지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh S\n          \tif(parent.campingTentFlag == \"C\" || parent.campingTentFlag == \"K\"){\n          \t\tmaxSellVolume = parent.festivalCnt - parent.campingCnt;\n          \t}else if(cSGN != \"00000\" && cSGN != \"\" && parent.campingCnt > 0 && parent.campingTentFlag == \"T\"){\n           \t\tmaxSellVolume = parent.campingCnt - parent.tentCnt;\n            }\n          \t//지산 밸리 록 페스티벌 하드코딩 2017.05.12 joyh E\n            for (var i=0 ; i <= parseInt(maxSellVolume, 10) ; i += parseInt(buyUnitVolume, 10)) {\n                if (i == 0 || i >= minSellVolume) {\n                    useDefaultVol = false;\n                    ttypesel.append(\"<option value=\\\"\" + i + \"\\\">\" + i + \"</option>\"); \n                }\n            }\n\n            if(useDefaultVol) {\n                // 매수제한 초과시 디폴트로 0매 노출\n                ttypesel.append(\"<option value=\\\"\" + 0 + \"\\\">\" + 0 + \"</option>\"); \n            }\n\n            //TICKETDEV-315 [공통] 권종 매진 시 표기 수정\n            if( val1.dcPriceSoldOutYn == \"Y\" && val1.dcPriceSellYCnt == 0 ){\n                ttypesel = replaceKrToLangCd(COMMON_PROP,\"매진\");\n            }\n\n            ttypetkdt.append(val1.priceName);\n            if (ttypemore.text() != \"\" && !(val1.dcPriceSoldOutYn == \"Y\" && val1.dcPriceSellYCnt == 0)) {\n            \tttypetkdt.append(\"<span class=\\\"arr\\\">보기</span>\");\n            }\n                  \n            if (val1.dcYn == \"Y\") {\n                ttypebtn.addClass(\"ticket_btn\");\n                if (val1.basePrice - val1.ticketTypePrice  > 0) {\n                    var dcStr = '';\n//                     if(langCd == 'CN') {\n//                         dcStr = \"折扣\";\n//                     }\n//                     else if(langCd == 'JP') {\n//                         dcStr = \"割引\";\n//                     }\n//                     else {\n//                         dcStr = \"Discount\";\n//                     }\n                    ttypeprcdd.text(\"- ￦\" + addComma(val1.basePrice - val1.ticketTypePrice) + \" \" + dcStr);\n                }\n                ttypeprcrdd.text(\"￦ \" + addComma(val1.ticketTypePrice));\n\n                ttypedl.append(ttypetkdt);\n                ttypedl.append(ttypeprcdd);\n                ttypedl.append(ttypeprcrdd);\n                ttypedl.append(ttypeseldd.append(ttypesel));\n            }\n            else {\n                ttypetkdt.addClass(\"base_pr\");\n                ttypeprcrdd.text(\"￦ \" + addComma(val1.ticketTypePrice)).addClass(\"txt_bd\");\n                \n                ttypedl.append(ttypetkdt);\n                ttypedl.append(ttypeprcrdd);\n                ttypedl.append(ttypeseldd.append(ttypesel));\n            }\n            \n            ttypebtn.append(ttypedl);\n            ttypewrap.append(ttypebtn);\n\n            if (ttypemore.text() != \"\" && !(val1.dcPriceSoldOutYn == \"Y\" && val1.dcPriceSellYCnt == 0) ) ttypewrap.append(ttypemore);\n            \n            ttypeobj.append(ttypebok.append(ttypewrap));\n\n            ticketObj.append(ttypeobj);\n\n            val1.selectedVolume = 0;\n            parent.typeData[val1.seatGradeNo + \"_\" + val1.priceNo] = val1;\n            // 선행권종 포함 여부 확인\n            if (val1.prevCondPriceNo != 0) prevPriceCnt++;\n        });\n    });\n\n    // 티켓 가격설정의 버튼의 옵션을 노출하기 위한 스크립트\n    $(\".tit_tk\").not(\".base_pr\").click(function(){\n        $(this).parent().parent().next().toggleClass(\"open\");\n        $(this).children().toggleClass('more');\n        return false;\n    });\n}\n\nfunction bindCouponList(cdata) {\n    $(\"#partCouponData\").html(\"\");\n    // 사용가능 쿠폰\n    $.each(cdata.listUseSaleCupn, function(key, val) {\n        val.selectedYn              = \"N\";\n        parent.couponData[val.cupnNo]    = val;\n        \n        var couponobj = $(\"<tr/>\");\n        var couponlab = $(\"<td/>\").addClass(\"coupon\");\n        var couponpid = $(\"<td/>\");\n        \n        var discAmountStr     = addComma(val.discInfo.discAmount) + (val.discInfo.discTypeFlg == \"FIXED_PRICE\" ? \"원\" : \"%\");\n        var cupnUseStartDtStr = val.cupnUseStartDt.substr(0,4) + \".\" + val.cupnUseStartDt.substr(4,2) + \".\" + val.cupnUseStartDt.substr(6,2);\n        var cupnUseEndDtStr   = val.cupnUseEndDt.substr(0,4)   + \".\" + val.cupnUseEndDt.substr(4,2)   + \".\" + val.cupnUseEndDt.substr(6,2);\n        \n        couponlab.append(\"<input type=\\\"checkbox\\\" id=\\\"couponNo\\\" name=\\\"couponNo\\\" value=\\\"\" + val.cupnNo + \"\\\" />\");\n        couponlab.append(\"<span class=\\\"txt_coup\\\">\" + val.cupnName + \"</span> <span class=\\\"txt_gr\\\">(\" + discAmountStr + \")</span>\");\n        couponpid.html(cupnUseStartDtStr + \" ~ \" + cupnUseEndDtStr + \" 까지 사용가능\");\n        \n        couponobj.append(couponlab);\n        couponobj.append(couponpid);\n        \n        $(\"#partCouponData\").append(couponobj);\n    });\n    if(cdata.listUseSaleCupn.length == 0) {\n        $(\"#partCouponData\").parent().parent().append(\"<p class=\\\"no_result\\\">사용 가능한 쿠폰이 없습니다.</p>\");\n        $(\"#partCouponData\").parent().hide();\n    }\n    \n    $(\"#txtCouponCnt\").text(cdata.listUseSaleCupn.length);\n    \n    $(\"input[name='couponNo']\").click(function() {\n        selectedCoupon(this);\n    });\n}\n\nfunction bindAdvtkList(adata) {\n    var advtkCnt = 0;\n    $(\"#partAdvtkData\").html(\"\");\n\n    $.each(adata, function(key, val) {\n        val.selectedYn                      = \"N\";\n        parent.advtkData[val.advtkNo]       = val;\n        \n        var advtkobj                = $(\"<tr/>\");\n        var advtklab                = $(\"<td/>\").addClass(\"coupon\");\n        var advtkpid                = $(\"<td/>\");\n\n        var advtkUseStartDt         = val.advtkUseStartDt;\n        var advtkUseEndDt           = val.advtkUseEndDt;\n        var advtkUseStartDtStr      = advtkUseStartDt.substr(0,4) + \".\" + advtkUseStartDt.substr(4,2) + \".\" + advtkUseStartDt.substr(6,2);\n        var advtkUseEndDtStr        = advtkUseEndDt.substr(0,4) + \".\" + advtkUseEndDt.substr(4,2) + \".\" + advtkUseEndDt.substr(6,2);\n        \n\n        advtklab.append(\"<input type=\\\"checkbox\\\" id=\\\"advtkNo\\\" name=\\\"advtkNo\\\" value=\\\"\" + val.advtkNo + \"\\\" />\");\n        advtklab.append(\"<span class=\\\"txt_coup\\\">\" + val.advtkName + \"</span> <span class=\\\"txt_gr\\\">(\" + val.seatGradeName + \")</span>\");\n        advtkpid.html(advtkUseStartDtStr + \" ~ \" + advtkUseEndDtStr + \" 까지 사용가능\");\n        \n        advtkobj.append(advtklab);\n        advtkobj.append(advtkpid);\n        \n        $(\"#partAdvtkData\").append(advtkobj);\n        \n        advtkCnt++;\n    });\n    \n    if(advtkCnt == 0) {\n        $(\"#partAdvtkData\").parent().parent().append(\"<p class=\\\"no_result\\\">사용 가능한 예매권이 없습니다.</p>\");\n        $(\"#partAdvtkData\").parent().hide();\n    }\n    \n    $(\"#txtAdvtkCnt\").text(advtkCnt);\n    \n    $(\"input[name='advtkNo']\").click(function() {\n        selectedAdvtk(this);\n    });\n}\n\nfunction bindAdvtk(adata) {\n    var advtkCnt                = parseInt($(\"#txtAdvtkCnt\").text(), 10);\n    var advtkobj                = $(\"<tr/>\");\n    var advtklab                = $(\"<td/>\").addClass(\"coupon\");\n    var advtkpid                = $(\"<td/>\");\n    \n    var advtkUseStartDt         = adata.advtkUseStartDt;\n    var advtkUseEndDt           = adata.advtkUseEndDt;\n    var advtkUseStartDtStr      = advtkUseStartDt.substr(0,4) + \".\" + advtkUseStartDt.substr(4,2) + \".\" + advtkUseStartDt.substr(6,2);\n    var advtkUseEndDtStr        = advtkUseEndDt.substr(0,4) + \".\" + advtkUseEndDt.substr(4,2) + \".\" + advtkUseEndDt.substr(6,2);\n\n    adata.selectedYn             = \"N\";\n    parent.advtkData[adata.advtkNo]     = adata;\n\n    advtklab.append(\"<input type=\\\"checkbox\\\" id=\\\"advtkNo\\\" name=\\\"advtkNo\\\" value=\\\"\" + adata.advtkNo + \"\\\" />\");\n    advtklab.append(\"<span class=\\\"txt_coup\\\">\" + adata.advtkName + \"</span> <span class=\\\"txt_gr\\\">(\" + adata.seatGradeName + \")</span>\");\n    advtkpid.html(advtkUseStartDtStr + \" ~ \" + advtkUseEndDtStr + \" 까지 사용가능\");\n    \n    advtkobj.append(advtklab);\n    advtkobj.append(advtkpid);\n    \n    $(\"#partAdvtkData\").append(advtkobj);\n    $(\"#txtAdvtkCnt\").text(advtkCnt + 1);\n    \n    $(\"input[name='advtkNo']\").click(function() {\n        selectedAdvtk(this);\n    });\n}\n\nfunction couponInit() {\n    var prodId      = parent.prodData.prodId;\n    var scheduleNo  = parent.prodData.scheduleNo;\n    var seatGradeNo = \"\";\n    \n    $.each(parent.seatData, function(key, val){\n        if(seatGradeNo) {\n            seatGradeNo += \"@\";\n        }\n        seatGradeNo += val.grade;\n    });\n    \n    var params = {\"v\":\"1\", \"channel\":\"M\", \"prodId\":prodId, \"scheduleNo\":scheduleNo, \"seatGradeNo\":seatGradeNo};\n    \n    $.ajax({\n        type           : \"POST\"\n        , dataType     : \"jsonp\"\n        , url          : POCURL + \"/glb/saleCupn/listSaleCupnByPay.json\"\n        , async        : true\n        , data         : params\n        , success      : function(result) {\n            if(result.result == 0) {\n                bindCouponList(result.data);\n            }\n        }\n        , error        : function(e) {\n            // ignore\n        }\n    });         \n}\n\nfunction setAutoSelect(tdata) {\n    if (flplanTypeCode != \"DR0003\" && \"SE0003\" !== seatTypeCode) {\n\t    $.each(tdata, function(key, val) {\n\t        var typeCount               = val.prodTicketTypeList.length;\n\t        \n\t        $.each(val.prodTicketTypeList, function(key1, val1) {\n\t            if (val.seatCount > 0 && typeCount == 1 && val1.dcPriceSoldOutYn != 'Y') {\n\t                $(\"#volume_\" + val1.seatGradeNo + \"_\" + val1.priceNo).val(val.seatCount);\n\t                sltTicket(document.getElementById(\"volume_\" + val1.seatGradeNo + \"_\" + val1.priceNo), val1.seatGradeNo, val1.priceNo);\n\t            }\n\t        });\n\t    });\n    }\n}\n\nfunction ticketInit() {\n    \n    parent.typeData     = {};\n    chkDcCard           = false;\n    parent.$(\"#cardGroupId\").val(\"\");\n    parent.$(\"#cardBpId\").val(\"\");\n    parent.$(\"#cardMid\").val(\"\");\n    var params          = parent.$(\"#sForm\").serializeArray();\n    var seatCount       = 0;\n    var parentGradeNo = parent.$(\"#seatGradeNo\").val();\n    var parentMapClickYn = parent.$(\"#mapClickYn\").val();\n    \n    $.each(parent.seatData, function(key, val){\n        params.push({name: \"seatId\"              , value: val.sid});\n        seatCount++;\n    });\n    \n    // 권종선택 초기 정보 전 seatId 최종 체크\n    /*\n    if (seatCount == 0) {\n    \talert(\"Seat information is not correct. Please select again.\");\n        if (parent.$(\"#rsrvStep\").val() == \"TKT\") {\n            parent.rsrvPopupClose();\n        } else {\n            history.back();\n        }\n    }*/\n\n    $.ajax({\n        type           : \"POST\"\n        , dataType     : \"jsonp\"\n        , url          : APIURL + \"/glb/product/tickettype.json?v=1\"\n        , async        : false\n        , data         : params\n        , success      : function(result) {\n            if(result.code == \"0000\") {\n                parent.dcPriceCheckYn = (result.dcPriceCheckYn != 'Y' && result.dcPriceCheckYn != 'N')?'N':result.dcPriceCheckYn;\n                bindTicketList(result.seatGradeList);\n                if (flplanTypeCode == \"DR0002\") {\n                \tif(parentMapClickYn == \"N\"){\n\t                \tif (result.seatGrades.length > 1) {\n\t                        if (parentGradeNo == undefined || parentGradeNo == null || parentGradeNo == \"\") {\n\t                            alert(replaceEnToLangCd(MSG_PROP,\"Please, Confirm the seat grade and price you chosen.\"));\n\t                        }\n\t                        else {\n\t                            $.each(result.seatGradeList, function (key, val) {\n\t                                if (val.seatGradeNo != parentGradeNo ) {\n\t                                    alert(replaceEnToLangCd(MSG_PROP,\"Please, Confirm the seat grade and price you chosen.\"));\n\t                                }\n\t                            });\n\t                        }\n\t                \t}\n                \t}\n                }\n                bindAdvtkList(result.advtkList);\n                if (result.seatList != null && result.seatList != undefined) {\n                    parent.seatData             = {};\n                    parent.data.seatdata        = [];\n                    $.each(result.seatList, function(key, val) {\n                        parent.seatData[val.seatId]    = {\"sid\":val.seatId, \"grade\": val.seatGradeNo, \"title\": val.seatNo};\n                        parent.data.seatdata.push({\"sid\":val.seatId, \"grade\": val.seatGradeNo, \"title\": val.seatNo});\n                        parent.$(\"#seatTypeCode\").val(val.seatTypeCode);\n                    });\n                    limitVolume                 = result.limitVolume;\n                    maxCount                    = limitVolume.VOLUMETYPECODE == \"CL0001\" ? 10 : limitVolume.LIMITVOLUME;\n                }\n                else {\n                    parent.data.seatdata        = [];\n                    $.each(parent.seatData, function(key, val) {\n                        parent.data.seatdata.push({\"sid\": val.sid, \"grade\": val.grade, \"title\": val.title, \"csid\" : val.csid, \"gn\" : val.gn, \"krTitle\": val.krTitle});\n                    });\n                    maxCount                    = seatCount;\n                }\n                // 좌석정보 - 일반상품일 경우\n                parent.setProdSeat();\n                // 쿠폰정보 초기 세팅\n                // 2016.06.27, 하종수PL의 요청으로 disable 시킴\n                // couponInit();\n\n                setAutoSelect(result.seatGradeList);\n            }\n            else {\n                alert(replaceEnToLangCd(MSG_PROP,result.message));\n                if (parent.$(\"#rsrvStep\").val() == \"TKT\") {\n                \tparent.rsrvPopupClose();\n                }\n                else {\n                    history.back();\n                }\n            }\n        }\n        , error        : function(e) {\n            alertGlb(\"System Error. Please ask melonticket.\");\n        }\n    });\n}\n\n$(\"div.section_onestop\").ready(function() {\n\tlangCd = parent.langCd; //MNL 전역 변수의 값을 변경\n\tinitload(function(){\n        /*MNL*/\n        replaceAllEnToLangCd($(\"div.section_onestop\")[0],function(){\n            $(\"div.section_onestop\")[0].style.display = \"\";\n        });\n\t});\n\n    if (parent.$(\"#trafficCtrlYn\").val() == \"Y\") {\n        //Netfunnel 명시적 완료처리\n        NetFunnel_aliveNotice(\n            {\n                ipblock: function(ev, ret) {\n                    return false;\n                },\n                block: function(ev,ret) {\n                    alert(ret.data.msg);\n                    return false;\n                }\n            }\n        );\n    }\n});\n\nfunction initload(callback) {\n    \n    $(\"#loginUserName\").text(getMemberNickName());\n\n    parent.selectedTicketCount = 0;\n    $(\"#txtNoneSeatCount\").text(\"0\");\n    \n    // 권종 선택 초기 세팅\n    ticketInit();\n\n    parent.setRsrvNavi(\"2\");\n    // 예매정보\n    parent.setProdSchedule();\n    // 취소 기한\n    parent.setCancelInfo($(\"#partCancelFeeList\"));\n    // 티켓 가격설정의 버튼의 옵션을 노출하기 위한 스크립트\n    $(\"#btnAdvtkReg\").click(function(event){\n        event.preventDefault();\n        var params       = parent.$(\"#sForm\").serializeArray();\n       \n        if ($(\"#regAdvtkNo\").val() == \"\") {\n            alert(\"예매권번호를 입력해 주세요.\");\n            return;\n        }\n       \n        params.push({name:\"advtkNo\"    , value: $(\"#regAdvtkNo\").val()});\n        $.ajax({\n            type           : \"POST\"\n            , dataType     : \"jsonp\"\n            , url          : APIURL + \"/glb/product/saveAdvtk.json?v=1\"\n            , async        : false\n            , data         : params\n            , success      : function(result) {\n                if(result.code == \"0000\") {\n                    alert(\"예매번호가 등록되었습니다.\");\n                    bindAdvtk(result.advtkData);\n                }\n                else {\n                    alert(replaceEnToLangCd(MSG_PROP,result.message));\n                }\n                $(\"#regAdvtkNo\").val(\"\");\n            }\n            , error        : function(e) {\n                alert(\"예매번호 등록중 오류가 발생하였습니다. 관리자에게 문의해 주십시오.\");\n            }\n        });\n    });\n   \n    $(\"#nextPayment\").click(function(event) {\n        event.preventDefault();\n        if ($(this).parent().filter(\".on\").length > 0) {\n            if (!goDelivery()) return false;\n        }\n    });\n\t\t    \n    $(document).keydown(function(e){\n\n        if (e.keyCode == $.ui.keyCode.BACKSPACE) {\n\n            var rx = /INPUT|SELECT|TEXTAREA/i;\n            if(!rx.test(e.target.tagName) || e.target.disabled || e.target.readOnly ){\n                e.preventDefault();\n            }\n\n            if (confirm(replaceEnToLangCd(MSG_PROP,\"Are you sure you want to leave? You’ll lose your selected seats.\"))) {\n                history.back();\n            }\n        }\n    });\n    \n    //2017-03-08 jhshin 프로그레스바 이동시 문구에 따라 이동하는 이벤트\n    $(document).on('click', '.btn_o_menu01', function($event){\n    \t$event.stopPropagation();\n    \t\n    \tif(!confirm(replaceEnToLangCd(MSG_PROP,\"Are you sure you want to leave? You’ll lose your selected seats.\"))){\n    \t\t$event.preventDefault();\n    \t}else{\n            parent.cancelLock();\n        }\n    });\n\n    callback != undefined && typeof callback == 'function' ? callback() : '';\n}\n\nfunction goBack() {\n\tif (parent.$(\"#rsrvStep\").val() != \"TKT\") {\n        if (confirm(replaceEnToLangCd(MSG_PROP,\"Are you sure you want to leave? You’ll lose your selected seats.\"))) {\n            parent.cancelLock();\n            history.back();\n        }\n    }\n}\n\nfunction tentTicketList(volume , seatgrade){\n\tif(parent.campingCnt > 0 && parent.campingTentFlag == \"T\"){\n\t\tvar cSGN = \"\";\n\t\tif(parent.campingSGN.split(',').length > 0){\n\t    \tfor(var i = 0; i < parent.campingSGN.split(',').length ; i++){\n\t        \tif(seatgrade == parent.campingSGN.split(',')[i]){\n\t        \t\tcSGN = seatgrade;\n\t        \t}\n\t        }\n    \t}else{\n    \t\tcSGN = \"00000\";\n    \t}\n\t\t\n\t\tif(cSGN == seatgrade){\n\t\t\tif(volume.value == \"0\"){\n\t\t\t\t$(\".h4TitleDisplay\").attr(\"style\",\"display:none\");\n\t\t\t\t$(\".listTicketDisplay\").attr(\"style\",\"display:none\");\n\t\t\t\t\n\t\t\t}else{\n\t\t\t\t$(\".h4TitleDisplay\").attr(\"style\",\"display\");\n\t\t\t\t$(\".listTicketDisplay\").attr(\"style\",\"display\");\n\t\t\t}\n\t\t\t\n\t\t\tfor(var i = 0 ; i < $(\".listTicketDisplay\").length ; i++){\n\t\t\t\t\twhile ($(\".listTicketDisplay select\")[i].options.length) {\n\t\t\t\t\t\t$(\".listTicketDisplay select\")[i].options.remove(0);\n\t\t\t\t    }\n\t\t\t\t\t\n\t\t\t\t\tfor(var h=0 ;h <= (volume.value*2) ;h++){\n\t\t\t\t\t\tvar option = document.createElement('option');\n\t\t\t\t        \toption.text  = h;\n\t\t\t\t        \toption.value = h;\n\t\t\t\t\t\t$(\".listTicketDisplay select\")[i].options.add(option,h);\t\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\tvar listTicketDisplayId = $(\".listTicketDisplay select\")[i].id;\n\t\t\t\t\t$(\"#\"+listTicketDisplayId).val(\"0\");\n\t\t\t\t\t$(\"#\"+listTicketDisplayId).change();\n\t\t\t}\n\t\t}\n\t}\t\n}\n\nvar util = {};\nutil.getIntWithDefaultOf0 = function(intStr){\n\tvar res = parseInt(intStr, 10) || 0;\n\treturn res;\n};\n\nfunction campingTicketCheck() {\n    var ret = true;\n    if(parent.festivalCnt > 0 && parent.campingTentFlag != \"T\") {\n        var ticketCount             = 0;\n        $.each(parent.typeData, function(key, val){\n            var selectedVolume       = util.getIntWithDefaultOf0(val.selectedVolume);\n            ticketCount             += selectedVolume;\n        });\n        if(ticketCount + parseInt(parent.campingCnt) > parseInt(parent.festivalCnt)) {\n        \tif(parent.campingTentFlag == \"C\"){\n        \t\t//alert(\"캠핑권은 구매하신 3일권 매수만큼만 예매 가능합니다. 매수를 다시 선택해주세요.(구매가능매수: \" + (parseInt(parent.festivalCnt) - parseInt(parent.campingCnt)) + \"매)\");\n        \t\talert(\"Tickets for camping tickets can only be booked for the number of 3-Days tickets purchased. Please Try again. (Available quantity: \" + (parseInt(parent.festivalCnt) - parseInt(parent.campingCnt)) + \")\");\n        \t}else if(parent.campingTentFlag == \"K\"){\n        \t\t//alert(\"해당상품은 구매하신 Compton to Seoul Festival 2017 의 매수만큼  예매 가능합니다. 매수를 다시 선택해주세요.(구매가능매수: \" + (parseInt(parent.festivalCnt) - parseInt(parent.campingCnt)) + \"매)\");\n        \t\talert(\"You can buy ticket of after party as many as you bought ticket of Compton to Seoul Festival 2017.(Available quantity: \" + (parseInt(parent.festivalCnt) - parseInt(parent.campingCnt)) + \")\");\n        \t}else{\n        \t\t//alert(\"캠핑권은 구매하신 3일권 매수만큼만 예매 가능합니다. 매수를 다시 선택해주세요.(구매가능매수: \" + (parseInt(parent.festivalCnt) - parseInt(parent.campingCnt)) + \"매)\");\n        \t\talert(\"Tickets for camping tickets can only be booked for the number of 3-Days tickets purchased. Please Try again. (Available quantity: \" + (parseInt(parent.festivalCnt) - parseInt(parent.campingCnt)) + \")\");\n        \t}\n            ret = false;\n        }\n        else {\n            ret = true;\n        }\n        \n    }\n    return ret;\n}\n</script>\n</body>\n</html>\n"
          },
