nd(\"dt a span.value\").html()).focus();\r\n\t\t\t}\r\n\t\t});\r\n\t});\r\n\t\r\n\t$(document).off(\"keydown\", \"#cardQuotaView .dropdown\").on(\"keydown\", \"#cardQuotaView .dropdown\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n//\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\t$(\".dropdown dd .innerBox\").not(\"#cardQuotaView .dropdown dd .innerBox\").hide();\r\n\t\t\t$(this).addClass(\"zindexUp\");\r\n\t\t\t\r\n\t\t\t$(\"#cardQuotaView .dropdown dd .innerBox\").slideToggle(10, function() {\r\n\t\t\t\tif($(this).css(\"display\") == \"none\") {\r\n\t\t\t\t\t$(\"#cardQuotaView .dropdown\").focus();\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$(\"#cardQuotaView .dropdown dd ul li .\" + $(\"#cardQuotaView .dropdown\").find(\"dt a span.value\").html()).focus();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\t});\r\n\t\r\n\t$(document).off(\"click\", \"#cardQuotaView .dropdown dd ul li a\").on(\"click\", \"#cardQuotaView .dropdown dd ul li a\", function() {\r\n\t\tvar text = $(this).html();\r\n\t\t//이니안심 선택하고 할부개월 수 선택 시 \r\n\t\tif($(\"#inputChk6\").prop(\"checked\")) {\r\n\t\t\t/*\r\n\t\t\t \t이니안심 할부개월 개선 250429\r\n\t\t\t\t현대카드 10000 ~ 199699\r\n\t\t\t\t그외카드 50000 ~ 199699 \r\n\t\t\t\r\n\t\t\t*/\r\n\t\t\t\r\n\t\t\t//var getCardCode = $(\"input[name=cardCode]\").val();\r\n\t\t\tvar getCardCode = $payForm.find(\".btnPaymnt.selected\").find(\"input[name=cardCode]\").val();\r\n\t\t\tvar getPrice = $payForm.find(\"input[name=price]\").val();\r\n\t\t\t\r\n\t\t\tif(getCardCode == '04'){\r\n\t\t\t\tif(Number(getPrice) >= 10000 && Number(getPrice) <= 199699){\r\n\t\t\t\t\tif($(text).html() != '00' && $(text).html() != '02' && $(text).html() != '03'){\r\n\t\t\t\t\t\t//할부개월 3개월 이상 초과 시 선택하신 할부개월은 이니안심 서비스 이용이 불가합니다. aler\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg9);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif($(text).html() != '00'){\r\n\t\t\t\t\t\t//할부 관련 적용 가능 금액 초과 시 할부개월 일시불 이상이면 이니안심서비스 이용 시 할부결제를 이용할 수 없습니다. alert\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tif(Number(getPrice) >= 50000 && Number(getPrice) <= 199699){\r\n\t\t\t\t\t//할부개월 3개월 이상 초과 시 선택하신 할부개월은 이니안심 서비스 이용이 불가합니다. alert\r\n\t\t\t\t\tif($(text).html() != '00' && $(text).html() != '02' && $(text).html() != '03'){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg9);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif($(text).html() != '00'){\r\n\t\t\t\t\t\t//이니안심서비스 이용 시 할부결제를 이용할 수 없습니다. alert\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t/*\tif($(text).html() != '00'){\r\n\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\treturn;\r\n\t\t\t}*/\r\n\t\t}\r\n\t\t\r\n\t\t$(\"#cardQuotaView .dropdown dt a\").html(text);\r\n\t\t$(\"#cardQuotaView .dropdown dd .innerBox\").hide();\r\n\t\t$(this).parent().parent().parent().parent(\".dropdown\").removeClass(\"zindexUp\");\r\n\t\t$(\"#cardQuotaView .dropdown dt\").focus();\r\n\t\t$(\"input[name=cardQuota]\").val($(\"#cardQuotaView .dropdown\").find(\"dt a span.value\").html());\r\n\t\t\r\n\t});\r\n\t\r\n\t$(document).off(\"keydown\", \"#cardQuotaView .dropdown dd ul li a\").on(\"keydown\", \"#cardQuotaView .dropdown dd ul li a\", function(e) {\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode && true == e.shiftKey) { //tab + shift key.\r\n\t\t\tif($(this).parent(\"li\").index() == 0) {\r\n\t\t\t\t$(\"#cardQuotaView .dropdown dd ul li a:eq(1)\").focus();\r\n\t\t\t} else if(($(this).parent(\"li\").index() + 1) == $(\"#cardQuotaView .dropdown dd ul li\").length) {\r\n\t\t\t\t$(\"#cardQuotaView .dropdown dd ul li a:eq(\" + ($(\"#cardQuotaView .dropdown dd ul li\").length - 1) + \")\").focus();\r\n\t\t\t}\r\n\t\t} else if(9 == keycode) {\r\n\t\t\tif(($(this).parent(\"li\").index() + 1) == $(\"#cardQuotaView .dropdown dd ul li\").length) {\r\n\t\t\t\t$(\"#cardQuotaView .dropdown dd ul li a:eq(\" + ($(\"#cardQuotaView .dropdown dd ul li\").length - 2) + \")\").focus();\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t// 할부기간선택 셀렉트박스 설정_end\r\n}\r\n//선택된 카드코드에 할부개월 수 가져오기\r\nfunction getCardCodeQuotaBase(){\r\n\tvar rtnValue = null;\r\n\t\t\r\n\tjQuery.ajax({\r\n\t\tasync : false\r\n\t\t, url:'/payMain/getCardCodeQuota'\r\n\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t, type : \"POST\"\r\n\t\t, dataType:\"json\"\r\n\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t// 정상 통신\r\n\t\t\tvar resultCode = jsonData['resultCode'];\r\n\t\t\t\r\n\t\t\tif(resultCode == \"01\"){\r\n\t\t\t\t//단일 할부개월 최대할부개월 수 초과 하였을 때\r\n\t\t\t\t//callAlert(\"카드 할부개월 정보 이상\");\r\n\t\t\t\tcallAlert(jsonData['resultMsg']);\r\n\t\t\t}else{\r\n\t\t\t\tvar resultValue = jsonData[\"resultValue\"];\r\n\t\t\t\trtnValue = resultValue;\r\n\t\t\t}\r\n\r\n\t\t}\r\n\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\tcallAlert(\"[Connection Failure]\"+errorThrown);\r\n\t\t\thideLoading();\r\n\t\t}\r\n\t\t, complete:function(jqXHR,status){\r\n\t\t\thideLoading();\r\n\t\t}\r\n\t});\r\n\r\n\treturn rtnValue;\r\n}\r\nfunction callPinpay(){\t\r\n\tif($payForm.find(\"[name=currency]\").val() == 'USD'){\r\n\t\tjAlert(\"결제를 위한 통화코드가 원화가 아닙니다.\\n신용카드 결제를 이용해주세요.\", \"KG 이니시스\", function() {\r\n\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2') {\r\n\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t}\r\n\t\t});\r\n\t\treturn;\r\n\t}\r\n\t\r\n\t//1000원미만 결제여부 확인\r\n\tif(below1000Check() != \"Y\"){\r\n\t\t return;\r\n\t}\r\n\t\r\n\tshowLoading();\r\n\t\r\n\t//결제창 띄우기 전 검증\r\n\tjQuery.ajax({\r\n\t\tasyn : true\r\n\t\t, url: '/jsApi/pinpay/before'\r\n\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t, type : \"POST\"\r\n\t\t, dataType : \"json\"\r\n\t\t, contentType : \"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t, success : function(jsonData, staus, jqXHR){\r\n\t\t\t// 정상 통신\r\n\t\t\tif(jsonData['resultCode'] == '0000'){\t\r\n\t\t\t\t\r\n\t\t\t\t$payForm.find(\"input[name=pinpayResponse]\").remove();\r\n\t\t\t\t$payForm.append(\"<input type='hidden' name='pinpayResponse' />\");\r\n\t\t\t\t$payForm.find(\"input[name=pinpayResponse]\").val(jsonData['pinpayResponse']);\t\r\n\t\t\t\r\n\t\t\t\t$payForm.find(\"input[name=sid]\").remove();\r\n\t\t\t\t$payForm.append(\"<input type='hidden' name='sid' />\");\r\n\t\t\t\t$payForm.find(\"input[name=sid]\").val(jsonData['sid']);\t\r\n\t\t\t\r\n\t\t\t\t$payForm.find(\"input[name=memberUniqueId]\").remove();\r\n\t\t\t\t$payForm.append(\"<input type='hidden' name='memberUniqueId' />\");\r\n\t\t\t\t$payForm.find(\"input[name=memberUniqueId]\").val(jsonData['pinpayMid']);\t\r\n\r\n\t\t\t\tvar win = '';\r\n\t\t\t\t\r\n\t\t\t\tvar w = 540;\r\n\t\t\t\tvar h = 700;\r\n\t\t\t\t\r\n\t\t\t    var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;\r\n\t\t\t    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;\r\n\r\n\t\t\t    width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t\t\t    height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\r\n\t\t\t    var left = ((width / 2) - (w / 2)) + dualScreenLeft;\r\n\t\t\t    var top = ((height / 2) - (h / 2)) ;\r\n\t\t\t\t    \r\n\t\t\t\twin = window.open(\"../checkWin.jsp\",\"newFrame\",\"width=540,height=700,resizable=no,scroll=auto,top=\"+top+\",left=\"+left+\",modal=yes\");\r\n\t\t\t\t\r\n\t\t\t\t// set user-agent\r\n\t\t\t\tvar popUseragent = navigator.userAgent;\r\n\t\t\t\t\r\n\t\t\t\tif( !win ){\r\n\t\t\t\t\t\r\n\t\t\t\t\tvar alertMsg = \"\";\r\n\t\r\n\t\t\t\t\t/*if(popUseragent.indexOf(\"Edge\")>-1) {\r\n\t\t\t\t\t\talertMsg = \"결제창 정상 호출을 위한 설정 방법 \\n\\n1.신뢰할 수 있는 사이트 변경\\n인터넷 익스플로러 내 도구>인터넷 옵션>보안(탭)>신뢰할 수 있는 \\n사이트>사이트(버튼)에서 상점 도메인과 https://stdpay.inicis.com를\\n모두 추가 혹은 제거 합니다.\\n\\n2.팝업차단 확인\\n도구>인터넷옵션>개인 정보(탭)> 팝업 차단 사용 해지 합니다.\\n\\n설정 이후 페이지를 새로고침 해주세요.\";\r\n\t\t\t\t\t} else if(popUseragent.indexOf(\"Firefox\")>-1 || popUseragent.indexOf(\"Chrome\")>-1 || popUseragent.indexOf(\"Safari\")>-1) {\r\n\t\t\t\t\t\talertMsg = \"팝업이 차단되었습니다.\\n팝업차단 해제 후 다시 시도해 주시기 바랍니다.\";\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\talertMsg = \"결제창 정상 호출을 위한 설정 방법 \\n\\n1.신뢰할 수 있는 사이트 변경\\n인터넷 익스플로러 내 도구>인터넷 옵션>보안(탭)>신뢰할 수 있는 \\n사이트>사이트(버튼)에서 상점 도메인과 https://stdpay.inicis.com를\\n모두 추가 혹은 제거 합니다.\\n\\n2.팝업차단 확인\\n도구>인터넷옵션>개인 정보(탭)> 팝업 차단 사용 해지 합니다.\\n\\n설정 이후 페이지를 새로고침 해주세요.\";\r\n\t\t\t\t\t}*/\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(popUseragent.indexOf(\"Firefox\")>-1 || popUseragent.indexOf(\"Chrome\")>-1 || popUseragent.indexOf(\"Safari\")>-1 || popUseragent.indexOf(\"Edg\")>-1) {\r\n\t\t\t\t\t\talertMsg = INImsg.alert_popup_check2;\t\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\talertMsg = INImsg.alert_popup_check1;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\tjAlert(alertMsg, \"KG이니시스\", function(r) {\r\n\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\tlocation.href = closeUrl;\t\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tif(typeof(win)!='undefined' || !win.closed) {\r\n\t\t\t\t\t\t\twin.close();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\t\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} else{\r\n\t\t\t\t\tvar setInter = setInterval(function(){\r\n\t\t\t\t\t\tif(typeof(win)=='undefined' || win.closed) {\r\n\t\t\t\t\t\t\t// 정상처리 되면 0\r\n\t\t\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\tlocation.href = closeUrl;\t\r\n\t\t\t\t\t\t\t}else{\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\thideLoading();\r\n\t\t\t\t\t\