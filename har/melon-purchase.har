\t\tgoURL=\"https://plugin.inicis.com/html60/main/04_Information_en.html\";\r\n\t\t\tif(mobilians === 'true'){\r\n\t\t\t\tgoURL=\"https://mup.mobilians.co.kr/terms/cnInfoUseEn.html\";\r\n\t\t\t}\r\n\t\t}else if(languageView == \"cn\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/04_Information_cn.html\";\r\n\t\t\tif(mobilians === 'true'){\r\n\t\t\t\tgoURL=\"https://mup.mobilians.co.kr/terms/cnInfoUseCn.html\";\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t//window.open(goURL,\"stdOpen\",\"scrollbars = yes\");\r\n\t\twindow.open(goURL, \"stdOpen\", \"scrollbars = yes, width=1000, height=580\");\r\n\t});\r\n\t\r\n\tjQuery(document).on(\"click\",\".goDetailView5\", function(){\r\n\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\t\tvar goURL = \"\"\r\n\t\tif(languageView == \"ko\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/06_Information.html\";\r\n\t\t}else if(languageView == \"en\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/06_Information_en.html\";\r\n\t\t}else if(languageView == \"cn\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/06_Information_cn.html\";\r\n\t\t}\r\n\t\t\r\n\t\t//window.open(goURL,\"stdOpen\",\"scrollbars = yes\");\r\n\t\twindow.open(goURL, \"stdOpen\", \"scrollbars = yes, width=1000, height=580\");\r\n\t});\r\n\r\n\t//쿠폰버튼 팝업\r\n\tjQuery(document).on(\"click\",\"#CouponBtn\",function(){\r\n\t\t\r\n\t\tif(Number($('[name=lpoint]').val()) > 0){\r\n\t\t\t\r\n\t\t\tcallAlert(INImsg.alert_point_msg8);//LPOINT와 쿠폰은 함께 사용할 수 없습니다.\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\t\tvar getTag = jQuery(\"#counponPopup\").html();\r\n\t\tjQuery(\"#overlay_popup2\").html(getTag);\r\n\t\t//jQuery(\"#overlay_popup .overlayFrame\").attr(\"src\",\"payMain/CouponPopup\");\r\n\r\n\t\tif(languageView == \"ko\"){\r\n\t\t\t//쿠폰팝업 일시불 쿠폰 추가로 인하여 기존 사이즈 수정 240925\r\n\t\t\t//jQuery(\"#overlay_popup2\").css({\"width\":\"330px\",\"height\":\"272px\"});\r\n\t\t\tjQuery(\"#overlay_popup2\").css({\"width\":\"395px\",\"height\":\"272px\"});\r\n\t\t}else if(languageView == \"en\"){\r\n\t\t\t//쿠폰팝업 일시불 쿠폰 추가로 인하여 기존 사이즈 수정 240925\r\n\t\t\t//jQuery(\"#overlay_popup2\").css({\"width\":\"330px\",\"height\":\"272px\"});\r\n\t\t\tjQuery(\"#overlay_popup2\").css({\"width\":\"395px\",\"height\":\"272px\"});\r\n\t\t}\r\n//\t\tjQuery(\"#overlay_popup\").css({\"width\":(jQuery(\"#overlay_popup .overlayFrame\").width())+\"px\",\"height\":(jQuery(\"#overlay_popup .overlayFrame\").height())+\"px\"});\r\n\r\n\t\toverlayPopupOnOff2(true);\r\n\t\t\r\n\t\t//wcchoi\r\n\t\t//2016.06.28\r\n\t\t//DESC : 포커스이동\r\n\t\tvar inputCouponPopupFocus = $(\"#inputCouponPopupFocus\");\r\n\t\tvar length = inputCouponPopupFocus.length;\r\n\t\tif (length > 0) {\r\n\t\t\tsetTimeout(function(){\r\n\t\t\t\tinputCouponPopupFocus.focus();\r\n\t\t\t}, 100);\r\n\t\t}\r\n\t});\r\n\r\n\t\r\n\t//유니마일 안내 문구 확인버튼\r\n\tjQuery(document).on(\"click\",\"#uniMileOk\", function(){\r\n\t\t$('#UniMilePointPopup').addClass(\"hide\");\r\n\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\t$(\"#uniMilePoint\").focus(); \r\n\t});\r\n\t\r\n\t//유니마일 안내 문구 확인 엔터시\r\n\tjQuery(document).on(\"keydown\",\"#uniMileOk\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\t$('#UniMilePointPopup').addClass(\"hide\");\r\n\t\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\t\t$(\"#uniMilePoint\").focus(); \r\n\t\t}\r\n\t\t\r\n\t});\r\n\t\r\n\r\n\t//현대 아멕스 팝업 사용안함 버튼 클릭 시\r\n\tjQuery(document).on(\"click\", \"#notAmexCp\", function(){\r\n\t\t//기존 팝업 닫기\r\n\t\tjQuery(\"#overlay_popup\").html('');\r\n\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\t\r\n\t\t//가맹점 포인트 설정 유무에 따른 포인트 팝업 레이어 노출\r\n\r\n\t\t//현대카드 포인트 처리\r\n\t\t//cardpointlist 랑 q5cardPointlist에 04 포함되어있는지 확인하기\r\n\t\tvar cardPointYn = null;\r\n\t\tvar q5CardPointYn = null;\r\n\t\t\r\n\t\tcardPointYn = $payForm.find(\"input[name=cardPointList]\").val().indexOf(\"04\") >= 0 ? \"Y\" : \"N\";\r\n\t\tq5CardPointYn = $payForm.find(\"input[name=q5CardPointList]\").val().indexOf(\"04\") >= 0 ? \"Y\" : \"N\";\r\n\t\t\r\n\t\t//일반결제에서 선택한 카드코드\r\n\t\tvar $selectCardCode = null;\r\n\t\t\r\n\t\tif(boolMobile){\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t}else{\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t}\r\n\t\t\r\n\t\t//다이렉트 결제 인지 일반결제인지 판단하는 플래그 값\r\n\t\tvar directYn = $payForm.find(\"input[name=gopaymethod]\").val().length > 0 ? \"Y\" : \"N\";\r\n\t\t\r\n\t\tvar strAcceptMethod = $payForm.find(\"input[name=acceptmethod]\").val();\r\n\t\t\r\n\t\t//다이렉트 일 때는 ini_cardcode 카드코드\r\n\t\tvar cardCode  = $payForm.find(\"[name=ini_cardcode]\").val();\r\n\t\t\r\n\t\t//3가지 케이스 체크 1) cardPointYn=Y, q5CardPointYn=Y 카드포인트, q5포인트 둘 다 포함 / 2) q5CardPointYn=Y 1번이랑 동일함 / 3)cardPointYn=Y q5 아닌 포인트\r\n\t\tif(cardPointYn == \"Y\" && q5CardPointYn == \"N\"){\r\n\t\t\t//Q5 아닌 포인트 인 경우\r\n\t\t\t\r\n\t\t\tif(directYn == \"Y\"){\r\n\t\t\t\t//다이렉트 결제\r\n\t\t\t \r\n\t\t\t\t/*\r\n\t\t\t\t    다이렉트 acceptmethod 옵션필드 \r\n\t\t\t\t\t\r\n\t\t\t\t\t1)usespcp 포인트 사용여부 레이어 노출 \r\n\t\t\t\t\t2)usenospcp 포인트 미사용 간주 \r\n\t\t\t\t\t3)빈 값 포인트 사용으로 간주하여 레이어 미노출 포인트 사용 플래그 셋팅함\r\n\t\t\t\t*/\r\n\t\t\t\t\r\n\t\t\t\tif(strAcceptMethod.indexOf(\"usespcp\") >= 0){\r\n\t\t\t\t\t//다이렉트 결제 포인트 사용여부 레이어 노출\r\n\t\t\t\t\tif($payForm.find(\"input[name=selectPopup]\").val() != null){\r\n\t\t\t\t\t\t$payForm.find(\"input[name=selectPopup]\").val(\"\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t$payForm.find(\"input[name=selectPopup]\").val(\"1\");\r\n\t\t\t\t\t\r\n\t\t\t\t\tmakePointPopup(\"VISA3D\", cardCode);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(strAcceptMethod.indexOf(\"usenospcp\") < 0){\r\n\t\t\t\t\t\t//usenosp 옵션 없을 때\r\n\t\t\t\t\t\t//최솟값 체크하고 포인트 사용으로 넘어감\r\n\t\t\t\t\t\tif(!checkPointMinPrice()){\r\n\t\t\t\t\t\t\tjAlert(INImsg.alert_card_msg17($(\"#pntMinPrice\").text()), \"KG이니시스\", function(r) {\r\n\t\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t$(\"[name=CARD_Point]\").val(\"1\");\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\tcallVisa3d(cardCode);\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\t//일반결제 \r\n\t\t\t\t//q5가 아닌 포인트는 acceptmethod 옵션 필드 인입 여부에 따라 레이어 호출 다르게 해야함\r\n\t\t\t\t//일반 결제 인 경우에는 서버단 로직에서 옵션 필드 확인 하여 팝업 플래그 셋팅, view 단으로 넘어오기 때문에 별도 처리 X\r\n\t\t\t\tmakePointLayer();\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t}else if(q5CardPointYn == \"Y\" && cardPointYn == \"N\" || q5CardPointYn == \"Y\" && cardPointYn == \"Y\"){\r\n\t\t\t//Q5 포인트 사용\r\n\t\t\t\r\n\t\t\tif(directYn == \"Y\"){\r\n\t\t\t\t//다이렉트 결제\r\n\t\t\t\tif($payForm.find(\"input[name=selectPopup]\").val() != null){\r\n\t\t\t\t\t$payForm.find(\"input[name=selectPopup]\").val(\"\");\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t$payForm.find(\"input[name=selectPopup]\").val(\"1\");\r\n\t\t\t\t\r\n\t\t\t\tmakePointPopup(\"VISA3D\", cardCode);\r\n\t\t\t\treturn;\r\n\t\t\t}else{\r\n\t\t\t\t//일반결제\r\n\t\t\t\tif($payForm.find(\"input[name=selectPopup]\").val() != null) {\r\n\t\t\t\t\t$payForm.find(\"input[name=selectPopup]\").val(\"\");\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t$payForm.find(\"input[name=selectPopup]\").val(\"1\");\r\n\r\n\t\t\t\tmakePointLayer();\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\t//둘다 미포함 인 경우 포인트 팝업 미노출 및 현대카드 acsUrl 호출\t\r\n\t\t\tif(directYn == \"Y\"){\r\n\t\t\t\tcallVisa3d(cardCode);\r\n\t\t\t}else{\r\n\t\t\t\tcallVisa3d($selectCardCode.val());\r\n\t\t\t}\r\n\t\t\r\n\t\t}\r\n\t\t\r\n\t});\r\n\t\r\n\t//현대 아멕스 팝업 사용함 버튼 클릭 시\r\n\tjQuery(document).on(\"click\", \"#useAmexCp\", function(){\r\n\t\t//포인트 사용으로 했을 땐 승인요청 플래그 데이터 셋팅 및 현대카드 acsUrl 호출\r\n\t\t\r\n\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\tjQuery(\"#overlay_popup\").html();\r\n\t\t\r\n\t\tvar $selectCardCode = \"\";\r\n\t\t\r\n\t\tif(boolMobile){\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t}else{\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t}\r\n\r\n\t\t//다이렉트 인 경우에는 ini_cardcode로 인입되는 카드코드 사용\r\n\t\tvar cardCode = $payForm.find(\"input[name=ini_cardcode]\").val();\r\n\t\t\r\n\t\t$selectCardCode = $selectCardCode == null ? cardCode : $selectCardCode;\r\n\t\t\r\n\t\tif($payForm.find(\"input[name=CARD_VoucherCode]\").val() != null){\r\n\t\t\t$payForm.find(\"input[name=CARD_VoucherCode]\").val(\"\");\r\n\t\t}\r\n\t\t\r\n\t\t$payForm.find(\"input[name=CARD_VoucherCode]\").val(\"01\");\r\n\t\t\r\n\t\t//이니안심 사용체크 포인트 사용 X\r\n\t\tif($payForm.find(\"input[name=CNF_KCARE]\").val() == '1'){\r\n\t\t\t$payForm.find(\"input[name=CNF_KCARE]\").val('0');\r\n\t\t\tcallAlert(INImsg.alert_kcare_msg4);\r\n\t\t\treturn;\r\n\t\t}\r\n\t\t\r\n\t\tcallVisa3d($selectCardCode.val());\r\n\t});\r\n\t\r\n\t//포인트 사용 여부!\r\n\tjQuery(document).on(\"click\",\"#useCp\", function(){\r\n\r\n\t\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\t\tjQuery(\"#overlay_popup\").html('');\r\n\t\t\tvar $selectCardCode;\r\n\t\t\tif(boolMobile){\r\n\t\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t\t}else{\r\n\t\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t\t}\r\n\t\t\t$payForm.find(\"input[name=CARD_Point]\").val('1');\r\n\t\t\t\r\n\t\t\t//이니안심 사용체크 후 포인트 사용 시 진행안됨\r\n\t\t\tif($payForm.find(\"input[name=CNF_KCARE]\").val() == '1'){\r\n\t\t\t\t$payForm.find(\"input[name=CNF_KCARE]\").val('0');\r\n\t\t\t\tcallAlert(INImsg.alert_kcare_msg4);\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif($selectCardCode.attr(\"cardType\") == \"visa3d\"){\r\n\r\n\t\t\t\t\tcallVisa3d($selectCardCode.val());\r\n\r\n\t\t\t}else if($selectCardCode.attr(\"cardType\") == \"isp\"){\r\n\t\t\t\tshowLoading();\r\n\t\t\t\tif($payForm.find(\"input[name=KBAPP]\") != null && $payForm.find(\"input[name=KBAPP]\").val() =='KBAPP'\r\n\t\t\t\t\t&& $selectCardCode.val() == '06'){\r\n\r\n\t\t\t\t\tcallkbAppPopup();\r\n\r\n\t\t\t\t}else{\r\n\r\n\t\t\t\t\thideLoading();\r\n\t\t\t\t\tcallISP();\r\n\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tcallPayDoneView();\t\t\t\t\r\n\t\t\t}\r\n\t});\r\n\r\n\tjQuery(document).on(\"click\",\"#notCp\", function(){\r\n\t\tjQuery(\"#overlay_popup\").html('');\r\n\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\tvar $selectCardCode;\r\n\t\tif(boolMobile){\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t}else{\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t}\r\n\t\t$payForm.find(\"input[name=CARD_Point]\").val('0');\r\n\t\tif($selectCardCode.attr(\"cardType\") == \"visa3d\"){\r\n\r\n\t\t\t\tcallVisa3d($selectCardCode.val());\r\n\r\n\t\t}else if($selectCardCode.attr(\"cardType\") == \"isp\"){\r\n\t\t\tshowLoading();\r\n\t\t\t\r\n\t\t\t//이니안심 할부관련체크(ISP 계열은 이니안심 사용 체크하고 금액이 5만원이 넘을경우에는 Confirm 창에서 이니안심 사용여부를 확인한다. 사용 시 일시불로 셋팅하며, 미사용시에는 기존방식대로 진행된다.) \r\n\t\t\t//if($payForm.find(\"input[name=CNF_KCARE]\").val() == '1' && Number(String($(\".payPrice\").html()).replace(',', '')) >= 50000 && Number($payForm.find(\"input[name=price]\").val()) >= 50000){\r\n\t\t\t\r\n\t\t\t//이니안심 할부개월 허용 로직 개선으로 인하여 isp 계열 할부관련 체크 199699만원이 넘는경우로 로직 수정 250506\r\n\t\t\tif($payForm.find(\"input[name=CNF_KCARE]\").val() == '1' && Number(String($(\".payPrice\").html()).replace(',', '')) > 199699 && Number($payForm.find(\"input[name=price]\").val()) > 199699){\r\n\t\t\t\tjConfirm(INImsg.alert_kcare_msg5, INImsg.alert_kcare_msg6, function(r) {\r\n\t\t\t\t\tif(r){\r\n\t\t\t\t\t\t//이니안심 사용\r\n\t\t\t\t\t\t$payForm.find(\"input[name=CNF_KCARE]\").val('1');\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//이니안심 사용안함\r\n\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\t$payForm.find(\"input[name=CNF_KCARE]\").val('0');\t\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\tif($payForm.find(\"input[name=KBAPP]\") != null && $payForm.find(\"input[name=KBAPP]\").val() =='KBAPP'\r\n\t\t\t\t\t\t&& $selectCardCode.val() == '06'){\r\n\r\n\t\t\t\t\t\tcallkbAppPopup();\r\n\r\n\t\t\t\t\t}else{\r\n\r\n\t\t\t\t\t\thideLoading();\r\n\t\t\t\t\t\tcallISP();\r\n\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t});\t\r\n\t\t\t}else{\r\n\t\t\t\tif($payForm.find(\"input[name=KBAPP]\") != null && $payForm.find(\"input[name=KBAPP]\").val() =='KBAPP'\r\n\t\t\t\t\t&& $selectCardCode.val() == '06'){\r\n\r\n\t\t\t\t\tcallkbAppPopup();\r\n\r\n\t\t\t\t}else{\r\n\r\n\t\t\t\t\thideLoading();\r\n\t\t\t\t\tcallISP();\r\n\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tcallPayDoneView();\r\n\t\t\t\r\n\t\t}\r\n\t});\r\n\t\r\n\t//현대카드 유이자혜택 사용버튼\r\n\tjQuery(document).on(\"click\",\"#useInterestEventBtn\", function(){\r\n\r\n\t\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\t\tjQuery(\"#overlay_popup\").html('');\r\n\t\t\tvar $selectCardCode;\r\n\t\t\tif(boolMobile){\r\n\t\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t\t}else{\r\n\t\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\t\t\t\r\n\t\t\tvar interestEventQuota = $payForm.find(\"input[name=interest_min_quota]\").val();\r\n\t\t\t$payForm.find(\"input[name=cardQuota]\").val(interestEventQuota);\r\n\t\t\t\r\n\t\t\t$(\"#cardQuotaView .dropdown dt\").empty();\r\n\t\t\t\r\n\t\t\t//혹시라도 유이자 할부 개월수가 없을경우\r\n\t\t\tif(interestEventQuota == ''){\r\n\t\t\t\tvar str = '';\r\n\t\t\t\tif(languageView == \"ko\"){\r\n\t\t\t\t\tstr ='<a href=\"#\"><span class=\"value\">00</span><span> 일시불 </span></a>';\r\n\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\tstr ='<a href=\"#\"><span class=\"value\">00</span><span> Lump sum </span></a>';\r\n\t\t\t\t}\r\n\t\t\t\telse if(languageView == \"cn\"){\r\n\t\t\t\t\tstr ='<a href=\"#\"><span class=\"value\">00</span><span> 一次性  </span></a>';\r\n\t\t\t\t}\r\n\t\t\t\t$(\"#cardQuotaView .dropdown dt\").append(str);\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val('00');\r\n\t\t\t}else{\r\n\t\t\t\tvar str = '';\r\n\t\t\t\tif(interestEventQuota.length == 1){\r\n\t\t\t\t\t//할부개월 수가 1자리 수일 경우 (ex : 1,2,3,4 ...)\r\n\t\t\t\t\tif(languageView == \"ko\"){\r\n\t\t\t\t\t\tstr = '<a href=\"#\"><span class=\"value\">0' + interestEventQuota + '</span><span>' + Number(interestEventQuota) + '개월</span></a>';\r\n\t\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\t\tstr = '<a href=\"#\"><span class=\"value\">0' + interestEventQuota + '</span><span>' + Number(interestEventQuota) + 'Month</span></a>';\r\n\t\t\t\t\t}else if(languageView == \"cn\"){\r\n\t\t\t\t\t\tstr = '<a href=\"#\"><span class=\"value\">0' + interestEventQuota + '</span><span>' + Number(interestEventQuota) + '个月</span></a>';\r\n\t\t\t\t\t}\r\n\t\t\t\t}else if(interestEventQuota.length > 1){\r\n\t\t\t\t\t//할부개월 수가 2자리 일 경우 (ex : 01,02,03,04 ...)\r\n\t\t\t\t\tif(languageView == \"ko\"){\r\n\t\t\t\t\t\tstr = '<a href=\"#\"><span class=\"value\">' + interestEventQuota + '</span><span>' + Number(interestEventQuota) + '개월</span></a>';\r\n\t\t\t\t\t}else if(languageView == \"en\"){\r\n\t\t\t\t\t\tstr = '<a href=\"#\"><span class=\"value\">' + interestEventQuota + '</span><span>' + Number(interestEventQuota) + 'Month</span></a>';\r\n\t\t\t\t\t}else if(languageView == \"cn\"){\r\n\t\t\t\t\t\tstr = '<a href=\"#\"><span class=\"value\">' + interestEventQuota + '</span><span>' + Number(interestEventQuota) + '个月</span></a>';\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t$(\"#cardQuotaView .dropdown dt\").append(str);\r\n\t\t\t}\r\n\t\t\t//간편결제, 카드 영역 비활성화\r\n\t\t\t$(\".crdWrap\").find(\"a\").prop(\"disabled\",true);\r\n\t\t\t$(\".payWrap\").find(\"a\").prop(\"disabled\",true);\r\n\t\t\t//쿠폰 및 Lpoint 비활성화\r\n\t\t\t$(\"#CouponBtn\").prop(\"disabled\",true);\r\n\t\t\t$(\"#chkLpoint\").parent(\"li\").hide();\r\n\t\t\t\r\n\t});\r\n\t\r\n\t//현대카드 유이자혜택 사용안함버튼\r\n\tjQuery(document).on(\"click\",\"#notInterestEventBtn\", function(){\r\n\t\tjQuery(\"#overlay_popup\").html('');\r\n\t\tjQuery(\"#overlay_popup\").hide();\r\n\t\tjQuery(\"#overlay_popup_bg\").hide();\r\n\t\tvar $selectCardCode;\r\n\t\tif(boolMobile){\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t}else{\r\n\t\t\t$selectCardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t}\r\n\t\t\r\n\t\tif($payForm.find(\"input[name=cardPointList]\").val() != null  && $payForm.find(\"input[name=cardPointList]\").val().indexOf($selectCardCode.val()) >= 0 ){\r\n\t\t\t\r\n\t\t\tmakePointLayer();\r\n\t\t\treturn;\t\t\t\t\t\t\r\n\t\t}else if($payForm.find(\"input[name=mallPointList]\").val() != null && $payForm.find(\"input[name=mallPointList]\").val().indexOf($selectCardCode.val()) >= 0 ){\r\n\t\t\t\r\n\t\t\tmakePointLayer();\r\n\t\t\treturn;\r\n\t\t}\r\n\t\t\r\n\t\tcallVisa3d($selectCardCode.val());\r\n\t});\r\n\t\r\n\t//wccchoi\r\n\t//2016.06.28\r\n\t//DESC: 쿠폰사용의 id를 변경해서, 수정.\r\n\t//쿠폰사용\r\n\t$(document).on(\"click\",\"a[id^='useCpnBtn']\", function(){\r\n\t\tvar type= $(this).attr(\"type\");\r\n\t\t$(\"#overlay_popup2\").find(\"input:radio[name=selCoupon]\").val(type).attr(\"checked\", true);\r\n\r\n\t\tvar checkRadio = $(\"#overlay_popup2\").find(\"input:radio[name=selCoupon]:checked\").val();\r\n\t\t//쿠폰 선택 시 일시불 여부 추가 240925\r\n\t\tvar chkLumpFlg = this.closest(\"td\").querySelector(\"[name=couponLumpFlg]\").value;\r\n\r\n\t\t//쿠폰 선택 시 할부개월 선택 selectbox 활성화 체크 후 활성화 -> 비활성화 240925\r\n\t\tif($(\"#cardQuotaView\").is(\":visible\")){\r\n\t\t\t$(\"#cardQuotaView\").hide();\r\n\t\t}\r\n\t\t\r\n\t\tif(checkRadio != null){\r\n\t\t\tvar disc = $(document).find(\"#\"+type+\"\").val();\r\n\r\n\t\t\tvar code = checkRadio.substr(checkRadio.length-2,2);\r\n\r\n\t\t\tvar seq = checkRadio.substring(0,10);\r\n\t\t\tvar couponGroup = $(document).find(\"#\"+type+\"\").attr(\"couponGroup\");\r\n\t\t\tvar price = '';\r\n\t\t\tvar flag = '';\r\n\t\t\t\r\n\t\t\t//우리카드 앱카드 쿠폰 추가로 인해 로직 추가 23.05.04\r\n\t\t\tif(code == 'WB' || code == 'WC' || code == 'PP') {\r\n\t\t\t\tflag = code;\r\n\t\t\t\t//code = '38';\r\n\t\t\t\tcode = '02';\r\n\t\t\t}\r\n\r\n\t\t\t//이니안심 사용여부 체크\r\n\t\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t\t\t\t//이니안심사용(결제요청금액 - 쿠폰사용금액 + 이니안심금액\r\n\t\t\t\tprice = Number($payForm.find(\"input[name=price]\").val())-Number(disc)+Number($('[name=PR_KCARE]').val());\r\n\t\t\t}else{\r\n\t\t\t\tprice = Number($payForm.find(\"input[name=price]\").val())-Number(disc);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar couponInfo = '';\r\n\t\t\t\r\n\t\t\tif(flag != \"\") {\r\n\t\t\t\tcouponInfo = flag+'-'+code+'-'+disc+'-'+seq;\r\n\t\t\t}else{\r\n\t\t\t\tcouponInfo = code+'-'+disc+'-'+seq;\t\t\t\r\n\t\t\t}\r\n\t\r\n\t\t\tvar currency = String(price).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\tvar coupon = String(disc).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\t$(\".payPrice\").html(currency);\r\n\t\t\t$(\".couponPrice\").html(coupon);\r\n\t\t\t$(\".coupon\").show();\r\n\r\n\t\t\tif($(\"#easyPayCardCode option:selected\").size() > 0){\r\n\t\t\t\tvar selectCode = $payForm.find(\"[name=cardCode] option:selected\").val();\r\n\t\t\t\tif(code != selectCode || $payForm.find(\"input[name=couponInfo]\").val().length <= 0){\r\n\t\t\t\t\tvar check = false;\r\n\t\t\t\t\t$(\"#easyPayCardCode\").val(code).attr(\"selected\", true);\r\n\t\t\t\t\tif($(\"#easyPayCardCode option:selected\").val() == code){\r\n\t\t\t\t\t\t$(document).find(\"input[name=couponInfo]\").val(couponInfo);\r\n\t\t\t\t\t\t$(document).find(\"input[name=couponGroup]\").val(couponGroup);\r\n\t\t\t\t\t\tif(Number($payForm.find(\"input[name=price]\").val())-Number(disc) >= jQuery(\"input[name=installmentPrice]\").val()){\r\n\t\t\t\t\t\t\tjQuery(\"#cardQuota\").show();\r\n\t\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t\t\tvar obj =$(document).find(\"#easyPayCardCode\");\r\n\t\t\t\t\t\t\tsetCardNoInterestText(obj);\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tjQuery(\"#cardQuota\").hide();\r\n\t\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcheck=true;\r\n\t\t\t\t\t\toverlayPopupOnOff(false);\r\n\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(!check){\r\n\t\t\t\t\t\tif(code=='14'){\r\n\t\t\t\t\t\t\tcallAlert(INImsg.alert_easyPay_msg9);\r\n\t\t\t\t\t\t}else if(code == '34'){\r\n\t\t\t\t\t\t\tcallAlert(INImsg.alert_easyPay_msg8);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tjQuery(\"#closeCpnBtn\").trigger('click');\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(Number($payForm.find(\"input[name=price]\").val())-Number(disc) >= jQuery(\"input[name=installmentPrice]\").val()){\r\n\t\t\t\t\t\tjQuery(\"#cardQuota\").show();\r\n\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t\tvar obj =$(document).find(\"#easyPayCardCode\");\r\n\t\t\t\t\t\tsetCardNoInterestText(obj);\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tjQuery(\"#cardQuota\").hide();\r\n\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\t$(document).find(\"input[name=couponInfo]\").val(couponInfo);\r\n\t\t\t$(document).find(\"input[name=couponGroup]\").val(couponGroup);\r\n\r\n\t\t\tvar installmentPrice =$(\"input[name=installmentPrice]\").val();\r\n\r\n\t\t\tif(seq.indexOf(\"E\",0)== 0){\r\n\t\t\t\tjQuery(\"#oneClick\").prop(\"checked\", true);\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\t\r\n\t\t\t\tif(!($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChkDetail3\").prop(\"checked\")) && !isAssentChk) {// 개인정보의 수집 및 이용안내\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg3);\r\n\t\t\t\t\tjQuery(\"#closeCpnBtn\").trigger('click');\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} else if(!($(\"#inputChk4\").prop(\"checked\") && $(\"#inputChkDetail4\").prop(\"checked\")) && !isAssentChk) { // 개인정보 제공 및 위탁안내\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg4);\r\n\t\t\t\t\tjQuery(\"#closeCpnBtn\").trigger('click');\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t$('#CardBtn').trigger('click');\r\n\t\t\t}else if(seq.indexOf(\"K\",0)== 0){\r\n\t\t\t\tprice = Number($(document).find(\"input[name=afPrice]\").val());\r\n\t\t\t\tif(price >= 300000){\r\n\t\t\t\t\tcallAlert(INImsg.alert_card_msg11);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\t$(document).find(\"input:radio[value=Kpay]\").prop(\"checked\",true);\r\n\t\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\t$('#CardBtn').trigger('click');\r\n\r\n\t\t\t}else if(seq.indexOf(\"P\",0)== 0){\r\n\r\n\t\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t\t$(document).find(\"#oneClickSelect\").val(\"Paypin\");\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\tjQuery(\"#oneClick\").val(jQuery(\"#oneClickSelect\").val());\r\n\t\t\t\tjQuery(\"#oneClick\").prop(\"checked\", true);\r\n\t\t\t\t$('#CardBtn').trigger('click');\r\n\r\n\t\t\t}else if(seq.indexOf(\"S\",0)== 0){\r\n\t\t\t\tprice = Number($(document).find(\"input[name=afPrice]\").val());\r\n\t\t\t\tif(price >= 300000){\r\n\t\t\t\t\tcallAlert(INImsg.alert_card_msg11);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t\t$(document).find(\"#oneClickSelect\").val(\"Swallet\");\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\tjQuery(\"#oneClick\").val(jQuery(\"#oneClickSelect\").val());\r\n\t\t\t\tjQuery(\"#oneClick\").prop(\"checked\", true);\r\n\r\n\t\t\t\t$('#CardBtn').trigger('click');\r\n\t\t\t}else{\r\n\t\t\t\tjQuery(\"#cardCodeEct\").val('');\r\n\t\t\t\t\r\n\t\t\t\t// 적용된 결제카드가 선택 표시가 되도록\r\n\t\t\t\t$(\".btnPaymnt\").removeClass(\"selected\").css(\"border-color\", \"\");\r\n\t\t\t\t$(\"#spanSelectPayCode .dropdown dt\").html($(\"#spanSelectPayCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\t\t$(\"#payCodeEct\").val(\"\");\r\n\t\t\t\t\r\n\t\t\t\t$(document).find(\"input[value=\"+code+\"]\").parent(\".btnPaymnt\").addClass(\"selected\");\r\n\t\t\t\t$(document).find(\"input[value=\"+code+\"]\").prop(\"checked\", true);\r\n\t\t\t\t$(\".btnPaymnt.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tif('14' == code){\r\n\t\t\t\t\t$(\"#shinhanApp\").parent(\"li\").show();\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\"#shinhanApp\").parent(\"li\").hide();\r\n\t\t\t\t\t$(\"#shinhanApp\").prop(\"checked\", false);\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t//유니마일 포인트 우리카드 타입이 isp여부 확인하여 포인트 사용체크박스 활성화\r\n\t\t\t\tvar cardCode = '';\r\n\t\t\t\tcardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t\t\t\r\n\t\t\t\tif(cardCode.val() != null){\r\n\t\t\t\t\tif(cardCode.attr(\"cardType\") == \"isp\" && ('11' == code || '71' == code || '46' == code || '47' == code || '38' == code)){\r\n\t\t\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").show();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").hide();\r\n\t\t\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").hide();\r\n\t\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\tvar obj = $(document).find(\"input:radio[value=\"+code+\"]\");\r\n\t\t\t\tvar temp = obj.val();\r\n\t\t\t\tvar chkQuota = $payForm.find(\"[name=quotabase]\").val();\r\n\t\t\t\r\n\t\t\t\tif(typeof(temp) == 'undefined' ){\r\n\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li a.\" + code + \"\").parent(\"li\").html());\r\n\t\t\t\t\tif(jQuery(\"#spanSelectCardCode .dropdown dt\").find(\"img\").length == 0) {\r\n\t\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").find(\"span:eq(1)\").removeClass(\"ellipsis\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt a\").addClass(\"selected\");\r\n\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt a.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t\tjQuery(\"#cardCodeEct\").val($(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html());\r\n\t\t\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\",\t$(\"#spanSelectCardCode .dropdown\").find(\"dt a\").attr(\"cardType\"));\r\n\t\t\t\t\tjQuery(\"#cardCodeEct\").prop(\"checked\", true);\r\n\t\t\t\t\t\r\n\t\t\t\t\t//선택한 쿠폰이 일시불이 아닌 경우에만 할부개월 노출 240925\r\n\t\t\t\t\tif(chkLumpFlg == \"N\"){\r\n\t\t\t\t\t\tsetCardNoInterestText(jQuery(\"#cardCodeEct\"));\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\t\r\n\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\t\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\t\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\t\t\t\t\r\n\t\t\t\t\t//선택한 쿠폰이 일시불이 아닌 경우에만 할부개월 노출 240925\r\n\t\t\t\t\tif(chkLumpFlg == \"N\"){\r\n\t\t\t\t\t\tsetCardNoInterestText(obj);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//간편결제화면에서 쿠폰 사용!\r\n\t\t\tif($(document).find(\"#easyPayCardCode\").size() > 0){\r\n\t\t\t\tjQuery(\"#cdPriceText\").remove();\r\n\t\t\t\tjQuery(\"#payPriceText\").remove();\r\n\t\t\t\tjQuery(\"#dcPrice\").prepend(\"<span id='cdPriceText'>\"+String(disc).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,')+\"</span>\");\r\n\t\t\t\tjQuery(\"#payPrice2\").prepend(\"<span id='payPriceText'>\"+String(price).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,')+\"</span>\");\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif(Number($payForm.find(\"input[name=price]\").val())-Number(disc) >= installmentPrice){\r\n\t\t\t\r\n\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t}else if(Number($payForm.find(\"input[name=price]\").val())-Number(disc) >= 10000 && code== '04' ){\r\n\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t}else{\r\n\t\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\toverlayPopupOnOff2(false);\r\n\t\t}\r\n\t\telse{\r\n\t\t\tcallAlert(INImsg.alert_msg13);\r\n\t\t}\r\n\t});\r\n\t\r\n\t//wccchoi\r\n\t//2016.06.28\r\n\t//DESC: 쿠폰사용에서 키를 눌렀을때 이벤트.\r\n\t$(document).on(\"keydown\",\"a[id^='useCpnBtn']\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\r\n\t\t\tvar type= $(this).attr(\"type\");\r\n\t\t\t\r\n\t\t\t$(\"#overlay_popup2\").find(\"input:radio[name=selCoupon]\").val(type).attr(\"checked\", true);\r\n\t\t\t\r\n\t\t\tvar checkRadio = $(\"#overlay_popup2\").find(\"input:radio[name=selCoupon]:checked\").val();\r\n\t\t\r\n\t\t\tif(checkRadio != null){\r\n\t\t\t\tvar disc = $(document).find(\"#\"+type+\"\").val();\r\n\t\t\t\tvar code = checkRadio.substr(checkRadio.length-2,2);\r\n\t\t\t\tvar seq = checkRadio.substring(0,10);\r\n\t\t\t\tvar price = '';\r\n\t\t\t\tvar couponGroup = $(document).find(\"#\"+type+\"\").attr(\"couponGroup\");\r\n\t\t\t\t\r\n\t\t\t\t//우리카드 앱카드 쿠폰 추가로 인해 로직 추가 23.05.04\r\n\t\t\t\tif(code == 'WB' || code == 'WC' || code == 'PP') {\r\n\t\t\t\t\tflag = code;\r\n\t\t\t\t\t//code = '38';\r\n\t\t\t\t\tcode = '02';\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t//이니안심 사용여부 체크\r\n\t\t\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t\t\t\t\t//이니안심사용(결제요청금액 - 쿠폰사용금액 + 이니안심금액\r\n\t\t\t\t\tprice = Number($payForm.find(\"input[name=price]\").val())-Number(disc)+Number($('[name=PR_KCARE]').val());\r\n\t\t\t\t}else{\r\n\t\t\t\t\tprice = Number($payForm.find(\"input[name=price]\").val())-Number(disc);\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tvar couponInfo = '';\r\n\t\t\t\t\r\n\t\t\t\tif(flag != \"\") {\r\n\t\t\t\t\tcouponInfo = flag+'-'+code+'-'+disc+'-'+seq;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tcouponInfo = code+'-'+disc+'-'+seq;\t\t\t\r\n\t\t\t\t}\r\n\r\n\t\t\t\tvar currency = String(price).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\t\tvar coupon = String(disc).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\t\t\r\n\t\t\t\t$(\".payPrice\").html(currency);\r\n\t\t\t\t$(\".couponPrice\").html(coupon);\r\n\t\t\t\t$(\".coupon\").show();\r\n\t\t\t\tif($(\"#easyPayCardCode option:selected\").size() > 0){\r\n\t\t\t\t\tvar selectCode = $payForm.find(\"[name=cardCode] option:selected\").val();\r\n\t\t\t\t\tif(code != selectCode || $payForm.find(\"input[name=couponInfo]\").val().length <= 0){\r\n\t\t\t\t\t\tvar check = false;\r\n\t\t\t\t\t\t$(\"#easyPayCardCode\").val(code).attr(\"selected\", true);\r\n\t\t\t\t\t\tif($(\"#easyPayCardCode option:selected\").val() == code){\r\n\t\t\t\t\t\t\t$(document).find(\"input[name=couponInfo]\").val(couponInfo);\r\n\t\t\t\t\t\t\t$(document).find(\"input[name=couponGroup]\").val(couponGroup);\r\n\t\t\t\t\t\t\tif(Number($payForm.find(\"input[name=price]\").val())-Number(disc) >= jQuery(\"input[name=installmentPrice]\").val()){\r\n\t\t\t\t\t\t\t\t$(\"#cardQuota\").show();\r\n\t\t\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t\t\t\tvar obj =$(document).find(\"#easyPayCardCode\");\r\n\t\t\t\t\t\t\t\tsetCardNoInterestText(obj);\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t$(\"#cardQuota\").hide();\r\n\t\t\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tcheck=true;\r\n\t\t\t\t\t\t\toverlayPopupOnOff(false);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(!check){\r\n\t\t\t\t\t\t\tif(code=='14'){\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_easyPay_msg9);\r\n\t\t\t\t\t\t\t}else if(code == '34'){\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_easyPay_msg8);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t$(\"#closeCpnBtn\").trigger('click');\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tif(Number($payForm.find(\"input[name=price]\").val())-Number(disc) >= jQuery(\"input[name=installmentPrice]\").val()){\r\n\t\t\t\t\t\t\t$(\"#cardQuota\").show();\r\n\t\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t\t\tvar obj =$(document).find(\"#easyPayCardCode\");\r\n\t\t\t\t\t\t\tsetCardNoInterestText(obj);\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t$(\"#cardQuota\").hide();\r\n\t\t\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t$(document).find(\"input[name=couponInfo]\").val(couponInfo);\r\n\t\t\t\t$(document).find(\"input[name=couponGroup]\").val(couponGroup);\r\n\t\t\t\tvar installmentPrice =$(\"input[name=installmentPrice]\").val();\r\n\t\t\t\tif(seq.indexOf(\"E\",0)== 0){\r\n\t\t\t\t\tjQuery(\"#oneClick\").prop(\"checked\", true);\r\n\t\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(!($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChkDetail3\").prop(\"checked\")) && !isAssentChk) {// 개인정보의 수집 및 이용안내\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg3);\r\n\t\t\t\t\t\tjQuery(\"#closeCpnBtn\").trigger('click');\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t} else if(!($(\"#inputChk4\").prop(\"checked\") && $(\"#inputChkDetail4\").prop(\"checked\")) && !isAssentChk) { // 개인정보 제공 및 위탁안내\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg4);\r\n\t\t\t\t\t\tjQuery(\"#closeCpnBtn\").trigger('click');\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t\t$('#CardBtn').trigger('click');\r\n\t\t\t\t}else if(seq.indexOf(\"K\",0)== 0){\r\n\t\t\t\t\tprice = Number($(document).find(\"input[name=afPrice]\").val());\r\n\t\t\t\t\tif(price >= 300000){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_card_msg11);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$(document).find(\"input:radio[value=Kpay]\").prop(\"checked\",true);\r\n\t\t\t\t\t$(\"#cardQuotaView\").hide();\r\n\t\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\t\t$('#CardBtn').trigger('click');\r\n\t\t\t\t}else if(seq.indexOf(\"P\",0)== 0){\r\n\t\t\t\t\t$(\"#cardQuotaView\").hide();\r\n\t\t\t\t\t$(document).find(\"#oneClickSelect\").val(\"Paypin\");\r\n\t\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\t\t$(\"#oneClick\").val(jQuery(\"#oneClickSelect\").val());\r\n\t\t\t\t\t$(\"#oneClick\").prop(\"checked\", true);\r\n\t\t\t\t\t$('#CardBtn').trigger('click');\r\n\t\t\t\t\t\r\n\t\t\t\t}else if(seq.indexOf(\"S\",0)== 0){\r\n\t\t\t\t\tprice = Number($(document).find(\"input[name=afPrice]\").val());\r\n\t\t\t\t\tif(price >= 300000){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_card_msg11);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$(\"#cardQuotaView\").hide();\r\n\t\t\t\t\t$(document).find(\"#oneClickSelect\").val(\"Swallet\");\r\n\t\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t\t\t$(\"#oneClick\").val(jQuery(\"#oneClickSelect\").val());\r\n\t\t\t\t\t$(\"#oneClick\").prop(\"checked\", true);\r\n\t\t\t\t\t\r\n\t\t\t\t\t$('#CardBtn').trigger('click');\r\n\t\t\t\t}else{\r\n\t\t\t\t\tjQuery(\"#cardCodeEct\").val('');\r\n\t\t\t\t\t\r\n\t\t\t\t\t// 적용된 결제카드가 선택 표시가 되도록\r\n\t\t\t\t\t$(\".btnPaymnt\").removeClass(\"selected\").css(\"border-color\", \"\");\r\n\t\t\t\t\t$(\"#spanSelectPayCode .dropdown dt\").html($(\"#spanSelectPayCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\t\t\t$(\"#payCodeEct\").val(\"\");\r\n\t\t\t\t\t\r\n\t\t\t\t\t$(document).find(\"input[value=\"+code+\"]\").parent(\".btnPaymnt\").addClass(\"selected\");\r\n\t\t\t\t\t$(document).find(\"input[value=\"+code+\"]\").prop(\"checked\", true);\r\n\t\t\t\t\t$(\".btnPaymnt.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t$(document).find(\"input[value=\"+code+\"]\").prop(\"checked\",true);\r\n\t\t\t\t\tif('14' == code){\r\n\t\t\t\t\t\t$(\"#shinhanApp\").parent(\"li\").show();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$(\"#shinhanApp\").parent(\"li\").hide();\r\n\t\t\t\t\t\t$(\"#shinhanApp\").prop(\"checked\", false);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t//유니마일 포인트 우리카드 타입이 isp여부 확인하여 포인트 사용체크박스 활성화\r\n\t\t\t\t\tvar cardCode = '';\r\n\t\t\t\t\tcardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(cardCode.val() != null){\r\n\t\t\t\t\t\tif(cardCode.attr(\"cardType\") == \"isp\" && ('11' == code || '71' == code || '46' == code || '47' == code || '38' == code)){\r\n\t\t\t\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").show();\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").hide();\r\n\t\t\t\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").hide();\r\n\t\t\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\tvar obj = $(document).find(\"input:radio[value=\"+code+\"]\");\r\n\t\t\t\t\tvar temp = obj.val();\r\n\t\t\t\t\tif(typeof(temp) == 'undefined' ){\r\n\t\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li a.\" + code + \"\").parent(\"li\").html());\r\n\t\t\t\t\t\tif(jQuery(\"#spanSelectCardCode .dropdown dt\").find(\"img\").length == 0) {\r\n\t\t\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").find(\"span:eq(1)\").removeClass(\"ellipsis\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt a\").addClass(\"selected\");\r\n\t\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt a.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t\t\tjQuery(\"#cardCodeEct\").val($(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html());\r\n\t\t\t\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\",\t$(\"#spanSelectCardCode .dropdown\").find(\"dt a\").attr(\"cardType\"));\r\n\t\t\t\t\t\tjQuery(\"#cardCodeEct\").prop(\"checked\", true);\r\n\t\t\t\t\t\tsetCardNoInterestText(jQuery(\"#cardCodeEct\"));\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\t\t\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\t\t\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\t\t\t\t\tsetCardNoInterestText(obj);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t//간편결제화면에서 쿠폰 사용!\r\n\t\t\t\tif($(document).find(\"#easyPayCardCode\").size() > 0){\r\n\t\t\t\t\t$(\"#cdPriceText\").remove();\r\n\t\t\t\t\t$(\"#payPriceText\").remove();\r\n\t\t\t\t\t$(\"#dcPrice\").prepend(\"<span id='cdPriceText'>\"+String(disc).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,')+\"</span>\");\r\n\t\t\t\t\t$(\"#payPrice2\").prepend(\"<span id='payPriceText'>\"+String(price).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,')+\"</span>\");\r\n\t\t\t\t}\r\n\t\t\t\tif(Number($payForm.find(\"input[name=price]\").val())-Number(disc) >= installmentPrice){\r\n\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\"#cardQuotaView\").hide();\r\n\t\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\t}\r\n\t\t\t\toverlayPopupOnOff2(false);\r\n\t\t\t}\r\n\t\t\telse{\r\n\t\t\t\tcallAlert(INImsg.alert_msg13);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 적용안함\r\n\t$(document).on(\"click\",\"#closeCpnBtn\", function(){\r\n\t\tif($(document).find(\"input[name=couponInfo]\").val().trim() != \"\") {\r\n\t\t\t$(\".btnPaymnt\").removeClass(\"selected\").css(\"border-color\", \"\");\r\n\t\t\t$(\".bottomBtn\").addClass(\"btnDis\");\r\n\t\t\t$(\".btnType09\").css(\"color\", \"\");\r\n\t\t\t\r\n\t\t\t$('input[name=cardCode]').prop(\"checked\", false);\r\n\t\t\t\r\n\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\t\tjQuery(\"#spanSelectPayCode .dropdown dt\").html($(\"#spanSelectPayCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\tjQuery(\"#payCodeEct\").val(\"\");\r\n\t\t\t\r\n\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t}\r\n\t\t\r\n\t\t///////체크값 초기화 하고 나가기!\r\n\t\tvar currency = '';\r\n\t\t\r\n\t\t//이니안심 사용여부 체크\r\n\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t\t\t//결제요청금액 + 이니안심금액\r\n\t\t\tvar totalPrice = Number($payForm.find(\"input[name=price]\").val()) + Number($('[name=PR_KCARE]').val());\r\n\t\t\tcurrency = String(totalPrice).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t}else{\r\n\t\t\tcurrency = String($payForm.find(\"input[name=price]\").val()).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t}\r\n\r\n\t\t$(document).find(\"input[name=couponInfo]\").val('');\r\n\t\t$(document).find(\"input[name=couponGroup]\").val('');\r\n\t\t$(\".payPrice\").html(currency);\r\n\t\t$(\".couponPrice\").html('0');\r\n\t\t$(\".coupon\").hide();\r\n\t\t///////////////////////\r\n\t\t\r\n\t\t$payForm.find(\"#oneClickSelect option[value=0]\").attr(\"selected\",true);\r\n\t\t\r\n\t\t//간편결제화면에서 쿠폰 사용 안할경우!\r\n\t\tif($(document).find(\"#easyPayCardCode\").size() > 0){\r\n\t\t\tjQuery(\"#notCoupon_title\").show();\r\n\r\n\t\t\tvar price = $(document).find(\"input[name=price]\").val().replace(',','');\r\n\t\t\tif(Number(price) >= Number(jQuery(\"input[name=installmentPrice]\").val())){\r\n\t\t\t\tjQuery(\"#cardQuota\").show();\r\n\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t\tvar obj =$(document).find(\"#easyPayCardCode\");\r\n\t\t\t\tsetCardNoInterestText(obj);\r\n\t\t\t}else{\r\n\t\t\t\tjQuery(\"#cardQuota\").hide();\r\n\t\t\t\tjQuery(\"#cardQuotaView .dropdown dd ul li:eq(0) a\").trigger(\"click\");\r\n\t\t\t}\r\n\t\t}else{\r\n\r\n\t\t}\r\n\t\toverlayPopupOnOff2(false);\r\n\t\t\t\r\n\t\t//wcchoi\r\n\t\t//2016.06.27\r\n\t\t//DESC : 신용카드 탭인덱스 설정,라디오버튼 탭이동할수있게 세팅, 포커스 이동.\r\n\t\tinicis.common.setTabIndexCard();\r\n  \t\t//inputFocus focus.\r\n\t\tvar inputFocus = $('#inputFocus');\r\n\t\tsetTimeout(function(){\r\n\t\t\tinputFocus.focus();\r\n\t\t}, 100);\r\n\t});\r\n\t//wcchoi\r\n\t//2016.06.27\r\n\t//DESC : 닫기버튼에서 탭키를 클릭하면, 포커스 이동.\r\n\t$(document).on(\"keydown\", \"#closeCpnBtn\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\tinicis.common.setInputFocus('inputCouponPopupFocus');\r\n\t\t}\r\n\t});\t\r\n\t\r\n\t//결제창에서 뒤로가기 방지 하기!\r\n\t$(document).keydown(function(e){\r\n\t\tif(e.target.nodeName !=\"INPUT\" && \"overlay\" == $payForm.find(\"[name=payViewType]\").val()){\r\n\t\t\tif(e.keyCode==8){\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t//숫자만 입력받기 이벤트\r\n\t$(document).on(\"keydown\",\".onlynum\",function(e){\r\n\t\tif(!(e.keyCode==8||e.keyCode==9||e.keyCode==13||e.keyCode==46||e.keyCode==144||(e.keyCode>=48&&e.keyCode<=57)||(e.keyCode>=96&&e.keyCode<=105)\r\n\t\t\t\t          ||(e.keyCode>=37&&e.keyCode<=40)||e.keyCode==110||e.keyCode==190)){\r\n\t        return false;\r\n\t   }\r\n\t});\r\n\t//숫자만 입력받기 이벤트\r\n\t$(document).on(\"keydown\",\".onlydigit\",function(e){\r\n\t\tvar keyCode = e.keyCode ? e.keyCode : e.which ? e.which : e.charCode; \r\n\t\tvar shiftPressed=0;\r\n\t\tshiftPressed=e.shiftKey;\r\n\t\tif(!(keyCode==8||keyCode==9||keyCode==13||keyCode==46||keyCode==144\r\n\t\t\t\t         ||(keyCode>=48&&keyCode<=57)||(keyCode>=96&&keyCode<=105)\r\n\t\t\t\t         ||(keyCode>=37&&keyCode<=40))){ \r\n\t\t\treturn false;\r\n\t   }else{\r\n\t\t   if(shiftPressed){\r\n\t\t\t   return false;\r\n\t\t   }\r\n\t   }\r\n\t});\r\n\t\r\n\t// 클릭시 셀렉트박스 값 부분이 숨겨지는 이벤트\r\n\t$(document).bind('click', function(e) {\r\n\t\tvar $clicked = $(e.target);\r\n\t\tif (! $clicked.parents().hasClass(\"dropdown\")) {\r\n\t\t\t$(\".dropdown dd .innerBox\").hide();\r\n\t\t\t$(\".dropdown dd .innerBox ul\").scrollTop(0);\r\n\t\t\t\r\n\t\t\tif($(\".dropdown\").hasClass(\"zindexUp\")){\r\n\t\t\t\t$(\".dropdown\").removeClass(\"zindexUp\");\r\n\t\t\t}\r\n\t\t};\r\n\t\t\r\n\t});\r\n\t\r\n\t//iframe창 overlay_CloseBtn 키보드 닫기 이벤트\r\n\t$(document).on(\"keydown\",\"#overlay_CloseBtn\",function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\toverlayOnOff(false);\r\n\r\n\t\t\tjQuery(\"#overlay_subWapper .overlayFrame\").attr(\"src\",\"\");\r\n\r\n\t\t\tjQuery(window).trigger(\"resize\");\r\n\t\t\t$('#CardBtn').focus();\r\n\t\t}\r\n\t});\r\n\t\r\n}\r\n\r\n//css 변경\r\nfunction fn_changeCSS(arg) //LJH 20160630\r\n{\r\n\tif(arg== \"ko\"){\r\n\t\tvar tg = document.getElementById('langcss');\r\n\t    if(tg) tg.href=\"../css/newcommon2017_ko.css\";\r\n\t    \r\n\t    jQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ko.png)\"});\r\n\t    jQuery(\".btnAgrmt_detail.minus\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmMinus_ko.png)\"});\r\n\t}else if(arg== \"en\"){\r\n\t\tvar tg = document.getElementById('langcss');\r\n\t    if(tg) tg.href=\"../css/newcommon2017_en.css\";\r\n\t    \r\n\t    jQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_en.png)\"});\r\n\t    jQuery(\".btnAgrmt_detail.minus\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmMinus_en.png)\"});\r\n\t}else if(arg== \"cn\"){\r\n\t\tvar tg = document.getElementById('langcss');\r\n\t    if(tg) tg.href=\"../css/newcommon2017_cn.css\";\r\n\t    \r\n\t    jQuery(\".btnAgrmt_detail\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmtMore_ch.png)\"});\r\n\t    jQuery(\".btnAgrmt_detail.minus\").css({\"background-image\":\"url(https://stdux.inicis.com/stdpay/img/newly/btn_agrmMinus_ch.png)\"});\r\n\t}\r\n\tfn_changeHtml(arg); \r\n\t\r\n}\r\n//언어변경에 따른 공통 HTML 변경\r\nfunction fn_changeHtml(arg) //LJH 20160630\r\n{\r\n\tif(arg== \"ko\"){\r\n\t    $(\"#CommonBrSapn\").addClass(\"hide\");\r\n\t    //무통장\r\n\t    $(\"#enSapn\").addClass(\"hide\");\r\n\t    $(\"#etcSpan\").removeClass(\"hide\");\r\n\t    $(\"#extSpan\").removeClass(\"hide\"); //나중에 삭제\r\n\t}else if(arg== \"en\"){\r\n\t    $(\"#CommonBrSapn\").removeClass(\"hide\");\r\n\t    //무통장\r\n\t    $(\"#etcSpan\").addClass(\"hide\");\r\n\t    $(\"#extSpan\").addClass(\"hide\"); //나중에 삭제\r\n\t    $(\"#enSapn\").removeClass(\"hide\");\r\n\t}else if(arg== \"cn\"){\r\n\t    $(\"#CommonBrSapn\").addClass(\"hide\");\r\n\t    //무통장\r\n\t    $(\"#enSapn\").addClass(\"hide\");\r\n\t    $(\"#etcSpan\").removeClass(\"hide\");\r\n\t    $(\"#extSpan\").removeClass(\"hide\"); //나중에 삭제\r\n\t}\r\n}\r\n\r\n\r\n/////////////////////////////////////////\r\n//Child 프레임에서 호출\r\n/////////////////////////////////////////\r\nvar callRecive = {\r\n\t\tpayMethod : \"\"\r\n\t\t,next : function(obj){\r\n\t\t\t//overlayPopupOnOff3(false);\r\n\t\t\tshowLoading();\r\n\t\t\t\r\n/*\t\t\tvar $childForm;\r\n            $childForm = jQuery(\"#overlayFrame4\").contents().find(\"#returnForm\");*/\r\n\r\n\t\t\t$payForm.find(\"input[name=encrypted]\").remove();\r\n\t\t\t$payForm.append(\"<input type='hidden' name='encrypted' />\");\r\n\t\t\t$payForm.find(\"input[name=encrypted]\").val(obj);\r\n\t\t\t\r\n\r\n\t\t\t// 폼값 입력\r\n\t\t\t//$payForm.find(\"input[name=encrypted]\").val($childForm.find(\"input[name=encrypted]\").val());\r\n\t\t\t//이니데이터 안씀 251124\r\n\t\t\t//$payForm.find(\"input[name=iniData]\").val($childForm.find(\"input[name=iniData]\").val());\r\n\t\t\t$payForm.append(\"<input type='hidden' name='type' />\");\r\n\t\t\t$payForm.find(\"input[name=type]\").val(\"ISP\");\r\n\t\t\t\r\n\t\t\t//이니포인트 체크\r\n\t\t\tif($payForm.find(\"input[name=selectPayMethod]\").val() == \"IniPoint\"){\r\n\t\t\t\t//제휴코드가 37이면 정상\r\n\t\t\t\tif(Number($payForm.find(\"input[name=issuerCode]\").val()) != 37){\r\n\t\t\t\t\t\r\n\t\t\t\t\tcallRecive.msg(\"결제창에서 [다음] 버튼을 누르시고 하나비씨 VISA 하나 이니포인트카드\\n인증서를 선택해 주시길 바랍니다.\");\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t//pyeongchang2018olympic\r\n\t\t\tif ((-1 != $payForm.find(\"input[name=acceptmethod]\").val().indexOf(\"pyeongchang\")) && ('04' != $payForm.find(\"input[name=ISP_CDNO_PREFIX]\").val())){\r\n\r\n\t\t\t\tcallAlert(INImsg.alert_card_msg14 , function(){\r\n\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\tif(closeUrl.length > 0 && (\"overlay\" == $payForm.find(\"[name=payViewType]\").val())){\r\n\t\t\t\t\t\t//$payForm.find(\"[name=payViewType]\").val(\"iframe\");\t\t// 취소 스크립트 페이지가 새창으로 뜨는것 방지\r\n\t\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2' || $payForm.find(\"input[name=payPopup]\").val() == '3'){\r\n\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else if(\"popup\" == $payForm.find(\"[name=payViewType]\").val()){\r\n\t\t\t\t\t\tself.close();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2' || $payForm.find(\"input[name=payPopup]\").val() == '3'){\r\n\t\t\t\t\t\t\tcallReturnSubmit(\"/payMain/cancel\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\treturn;\r\n\t\t\t\r\n\t\t\t}\r\n\r\n\r\n\t\t\t// BC카드 쿠폰이벤트 적용시 발행사 체크 로직 추가 BY KSM EX)우리 BC OK 새마을금고 NOT OK\r\n\t\t\tif( $payForm.find(\"input[name=couponInfo]\").val() !=null && $payForm.find(\"input[name=couponInfo]\").val().length > 0 && $payForm.find(\"[name=cardCode]:checked\").val() == \"11\"){\r\n\t\t\t\tjQuery.ajax({\r\n\t\t\t\t\tasyn : true\r\n\t\t\t\t\t, url:'/jsApi/coupon/CouponBCBankChk'\r\n\t\t\t\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t\t\t\t, type : \"POST\"\r\n\t\t\t\t\t, dataType:\"json\"\r\n\t\t\t\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t\t\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t\t\t\t // BC 카드 발급사가 아닐 경우\r\n\t\t\t\t\t\tif(jsonData['resultCode']==\"V832\" || jsonData['resultCode']==\"V833\")\r\n\t\t\t\t\t    {\r\n\t\t\t\t\t\t\t if($payForm.find(\"input[name=payPopup]\").val() == '2' || $payForm.find(\"input[name=payPopup]\").val() == '3'){\r\n\t\t\t\t\t\t\t\t \tjAlert(jsonData['resultMsg'], \"KG이니시스\", function(r) {\r\n\t\t\t\t\t\t\t\t \t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t\t\t\t\t\t});\t\r\n\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\tcallAlert(jsonData['resultMsg']);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t    }else{\r\n\t\t\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2' || $payForm.find(\"input[name=payPopup]\").val() == '3'){\r\n\t\t\t\t\t\t\t\tcallReturnSubmit(\"/payMain/done\");\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tcallPayDoneView();\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t     }\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t, error:function(jqXHR,status,errorThrown ){\r\n\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t, complete:function(jqXHR,status){\r\n\r\n\t\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\t\r\n\t\t\t}else{\r\n\t\t\t\t\r\n\t\t\t\t// 결제완료 페이지 표시\r\n\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2' || $payForm.find(\"input[name=payPopup]\").val() == '3'){\r\n\t\t\t\t\tcallReturnSubmit(\"/payMain/done\");\r\n\t\t\t\t}else{\r\n\t\t\t\t\tcallPayDoneView();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t}\r\n\t\t,cancel : function(){\r\n\t\t\tcallRecive.msg(INImsg.alert_cancel1);\r\n\t\t\toverlayOnOff(false);\r\n\t\t}\r\n\t\t,winCancel : function(){\r\n\t\t\tcallRecive.winMsg(INImsg.alert_cancel1);\r\n\t\t}\r\n\t\t,fake : function(){\r\n\t\t\tcallReturnSubmit(\"/payMain/fake\");\r\n\t\t}\r\n\t\t,msg : function(msg){\r\n\t\t\tif(msg.length > 0 && $payForm.find(\"input[name=payPopup]\").val() != '2'){\r\n\t\t\t\tcallAlert(msg);\r\n\t\t\t}\r\n\t\t\toverlayOnOff(false);\r\n\t\t\thideLoading();\r\n\t\t}\t\t\r\n\t\t,winMsg : function(msg){\r\n\t\t\tif(msg.length > 0 && $payForm.find(\"input[name=payPopup]\").val() != '2'){\r\n\t\t\t\tcallAlert(msg);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\thideLoading();\r\n\t\t}\r\n\t\t,hppMsg : function(msg){\r\n\t\t\tif(msg.length > 0 && $payForm.find(\"input[name=gopaymethod]\").val() != 'onlyhpp' ){\r\n\t\t\t\tcallAlert(msg);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif($payForm.find(\"input[name=acceptmethod]\").val().indexOf('useoverlay') > -1){\r\n\t\t\t\toverlayPopupOnOff3(false);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\thideLoading();\r\n\t\t}\r\n\t\r\n\t\t,cardNextBankpay : function(obj){\r\n\r\n\t\t\t$childForm = jQuery(\"#overlayFrame\").contents().find(\"#returnForm\");\r\n\t\t\tvar bankpayreturn = obj;\r\n\t\t\t//alert($childForm.serialize());\r\n\t\t\tshowLoading();\r\n\t\t\t// 폼값 입력\r\n\t\t\t$payForm.find(\"input[name=bankpayReturn]\").val(bankpayreturn);\r\n\r\n\t\t\tvar acceptmethod = $payForm.find(\":input[name=acceptmethod]\").val();\r\n\t\t\tvar beginIndex  = acceptmethod.indexOf(\"site_id(\");\r\n\t\t\tvar temp = acceptmethod.substring(beginIndex + 8,acceptmethod.length);\r\n\t\t\tvar endIndex = temp.indexOf(\")\");\r\n\t\t\tvar site_id = temp.substring(0, endIndex);\r\n\r\n\t\t\tif(site_id.length > 0 ){\r\n\t\t\t\tif(site_id == \"wmk\" || site_id == \"nikom\" || site_id == \"tmon\"|| site_id == \"nik\"){\r\n\t\t\t\t\tcallReturnSubmit(\"/payMain/done\");\r\n\t\t\t\t}else{\r\n\t\t\t\t\tcallPayDoneView();\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tcallPayDoneView();\r\n\t\t\t}\r\n\r\n\t\t},cardNextiDbank : function(obj){\r\n\r\n\t\t\t$childForm = jQuery(\"#overlayFrame\").contents().find(\"#returnForm\");\r\n\t\t\tvar bankpayreturn = obj;\r\n//\t\t\talert(\"cardNextiDbank === \\n\" + bankpayreturn);\r\n\t\t\tshowLoading();\r\n\t\t\t// 폼값 입력\r\n\t\t\t$payForm.find(\"input[name=bankpayReturn]\").val(bankpayreturn);\r\n\r\n\t\t\tvar acceptmethod = $payForm.find(\":input[name=acceptmethod]\").val();\r\n\t\t\tvar beginIndex  = acceptmethod.indexOf(\"site_id(\");\r\n\t\t\tvar temp = acceptmethod.substring(beginIndex + 8,acceptmethod.length);\r\n\t\t\tvar endIndex = temp.indexOf(\")\");\r\n\t\t\tvar site_id = temp.substring(0, endIndex);\r\n\r\n\t\t\tif(site_id.length > 0 ){\r\n\t\t\t\tif(site_id == \"wmk\" || site_id == \"nikom\" || site_id == \"tmon\"|| site_id == \"nik\"){\r\n\t\t\t\t\tcallReturnSubmit(\"/payMain/done\");\r\n\t\t\t\t}else{\r\n\t\t\t\t\tcallPayDoneView();\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tcallPayDoneView();\r\n\t\t\t}\r\n\t\t}\r\n\t\t,kbNextiDirectBank : function(obj, cfiTid, mTid){\r\n//\t\t\t$returnForm.find(\"input[name=ACCT_CfiTid_FNBC]\").val(),$returnForm.find(\"input[name=ACCT_MTid_FNBC]\").val()\r\n\t\t\t$childForm = jQuery(\"#overlayFrame\").contents().find(\"#returnForm\");\r\n\t\t\tvar kbreturn = obj;\r\n\t\t\t//alert($childForm.serialize());\r\n\t\t\tshowLoading();\r\n\t\t\t// 폼값 입력\r\n\t\t//\t$payForm.find(\"input[name=iDirectBankReturn]\").val(kbreturn);\r\n\t\t\t$payForm.find(\"input[name=ACCT_FlgFNBC]\").val(\"1\");\r\n\t\t\t$payForm.find(\"input[name=ACCT_CfiTid_FNBC]\").val(cfiTid);\r\n\t\t\t$payForm.find(\"input[name=ACCT_MTid_FNBC]\").val(mTid);\r\n\t\t\t$payForm.find(\"input[name=bankpayReturn]\").val(kbreturn);\r\n\r\n\t\t\tcallPayDoneView();\r\n\r\n\t\t}\r\n\t\t,cardNextVisa3d : function(obj, obj2){\r\n\r\n\t\t\tshowLoading();\r\n\t\t\tvar $childForm;\r\n\t\t\t\r\n\t\t\tif($