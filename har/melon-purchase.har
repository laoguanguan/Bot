one) {\r\n\t\t.lpointPopLayer .radio { -webkit-appearance: none; -moz-appearance: none; background: #fff; border: 1px solid #909090; border-radius: 50%; cursor: pointer; width: 18px; height: 18px; }\r\n\r\n\t\t.lpointPopLayer label .radio:checked::after { position: absolute; border: 0; content: ''; display: block; top: 50%; left: 50%; margin: -6px 0 0 -6px; width: 12px; height: 12px; border-radius: 50%; background: rgb(0 155 250); border-color: rgb(0 155 250); }\r\n}\r\n\r\n.lpointPopLayer .radio_wrap { cursor: pointer; }\r\n.lpointPopLayer .radio_txt { display: inline-block; font-size: 12px; color: #111; font-weight: 400; padding: 4px; }\r\n.lpointPopLayer .radio:focus~.radio_wrap {outline: 2px; }\r\n\r\n.lpointPopLayer .radio:checked~.radio_wrap .radio_txt { font-weight: 600; }\r\n.lpointPopLayer .radio:disabled~.radio_wrap { color: #111; cursor: default; }\r\n.lpointPopLayer .radio:disabled~.radio_wrap .radio_txt { color: #111; font-weight: 400; }\r\n\r\n.lpoint_con { padding: 0 0 5px 0; }\r\n.lpoint_con h2 { font-size: 13px; padding: 5px 10px; display: inline-block; }\r\n\r\n.lpoint_con .lpoint_type { display: flex; justify-content: space-between; }\r\n.lpoint_con .lpoint_type li { padding: 5px 2px; width: 100%; position: relative; }\r\n\r\n.lpoint_type label .radio { position: absolute; margin: 0; right: 20px; top: 22px; }\r\n\r\n.lpoint_type .radio_wrap { border: 1px solid #909090; border-radius: 10px; padding: 4px 0 4px 20px; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; }\r\n.lpoint_con .radio_txt { text-align: center; }\r\n\r\n.lpoint_type .radio:checked~.radio_wrap { border-color: rgb(0 155 250); }\r\n\r\n.lpointPopLayer { display: inline-table; width: 300px; margin: -135px 0 0 -220px; padding: 20px;  font-size: 12px; border: 1px solid #CCC; }\r\n.topLayer { display: inline-block; margin: 0; }\r\n#tableLayer { width: 100%; margin: 0; border-collapse: collapse; border-top: 1px solid #dbdbdb; background-color: white; displa