            "compression": 0,
            "text": "/*\r\n * 결제창 광고 롤링 배너 이벤트 처리\r\n */\r\nvar bannerStatus = {\r\n\tleft : { current:0, imgs:null, total:0, timer:null, playing:false, tabIndex:{ container:221, playPause:222, prev:223, next:224 }},\r\n\tcenter : { current:0, imgs:null, total:0, timer:null, playing:false, tabIndex:{ container:397, playPause:398, prev:399, next:400 }},\r\n\tright : { current:0, imgs:null, total:0, timer:null, playing:false, tabIndex:{ container:402, playPause:403, prev:404, next:405 }}\r\n};\r\n\r\nvar intervalSec = 3000;\r\n\r\nvar isKeyboard = false;\r\n\r\ndocument.addEventListener(\"keydown\", function(){\r\n\tisKeyboard = true;\r\n});\r\n\r\ndocument.addEventListener(\"mousedown\", function(){\r\n\tisKeyboard = false;\r\n});\r\n\r\n\r\nfunction startBanner(bannerFlg){\t\r\n\t\r\n\tvar bannerYn = document.getElementById(bannerFlg+\"Bnr\");\r\n\t\r\n\tif(bannerYn != null){\r\n\t\tresetBannerState(bannerFlg);\r\n\t\t\r\n\t\t//div 포커스 이벤트 부여\r\n\t\tbnrFocusControl(bannerFlg);\r\n\t\t//배너 갯수 체크\r\n\t\tupdateBanner(bannerFlg);\r\n\t\t//이미지 tabindex 부여\r\n\t\tshowImgBanner(bannerStatus[bannerFlg]);\r\n\t\t//이미지 롤링 처리\r\n\t\tautoImg(bannerFlg);\r\n\t}\r\n}\r\n\r\nfunction updateBanner(bnrs){\r\n\tvar banners = null;\r\n\t\r\n\tvar bannerYn = document.getElementById(bnrs+\"Bnr\");\r\n\tif(bannerYn != null){\r\n\t\tif(bnrs == 'left'){\r\n\t\t\tbanners = $(\"#leftBnr a img\");\r\n\t\t}else if(bnrs == 'center'){\r\n\t\t\tbanners =  $(\"#centerBnr a img\");\r\n\t\t}else{\r\n\t\t\tbanners = $(\"#rightBnr a img\");\r\n\t\t}\r\n\r\n\t\tif(banners.length > 0){\r\n\t\t\tbannerStatus[bnrs].imgs = banners;\r\n\t\t\tbannerStatus[bnrs].total = banners.length;\r\n\t\t\t\r\n\t\t}\r\n\t\t\r\n\t\tdocument.querySelector(\"#\"+bnrs+\"Current\").textContent = bannerStatus[bnrs].current + 1;\r\n\t\tdocument.querySelector(\"#\"+bnrs+\"Total\").textContent = bannerStatus[bnrs].total;\r\n\t}\r\n}\r\n\r\nfunction startAuto(bnrs){\r\n\tstopAuto(bnrs);\r\n\tbannerStatus[bnrs].playing = true;\r\n\r\n\tbannerStatus[bnrs].timer = setInterval(function(){\r\n\t\tmoveNext(false, bnrs);\r\n\t}, intervalSec);\r\n}\r\n\r\nfunction stopAuto(bnrs){\r\n\tvar state = bannerStatus[bnrs];\r\n\t\r\n\tif(state && state.timer){\r\n\t\tclearInterval(state.timer);\r\n\t\tstate.timer = null;\r\n\t}\r\n\t\r\n\tstate.playing = false;\r\n}\r\n\r\nfunction movePrev(fromUser, bnrs) {\t\r\n\tvar bannerYn = document.getElementById(bnrs+\"Bnr\");\r\n\tif(bannerYn != null){\r\n\t\tvar state = bannerStatus[bnrs];\r\n\t\tupdateBanner(bnrs);\r\n\r\n\t\tstate.current = (state.current - 1 + state.total) % state.total;\r\n\t\tshowImgBanner(state);\r\n\t\t\r\n\t\tdocument.querySelector(\"#\"+bnrs+\"Current\").textContent = state.current + 1;\r\n\t\t\r\n\t    if (fromUser && state.playing && !isKeyboard){\r\n\t    \tstartAuto(bnrs);\r\n\t    } \r\n\t}\r\n}\r\n\r\nfunction moveNext(fromUser, bnrs) {\r\n\tvar bannerYn = document.getElementById(bnrs+\"Bnr\");\r\n\tif(bannerYn != null){\r\n\t\tvar state = bannerStatus[bnrs];\r\n\t\tupdateBanner(bnrs);\r\n\t\t\r\n\t\tstate.current = (state.current + 1) % state.total;\r\n\t\tshowImgBanner(state);\r\n\t\t\r\n\t\tdocument.querySelector(\"#\"+bnrs+\"Current\").textContent = state.current + 1;\r\n\r\n\t    if (fromUser && state.playing && !isKeyboard){\r\n\t    \tstartAuto(bnrs);\r\n\t    }\r\n\t}\r\n}\r\n\r\nfunction bannerClick(url){\r\n\twindow.open(url,'INICIS','');\r\n}\r\n\r\nfunction setTabIndex(bnrs){\r\n\t//left -> common.js\r\n\tif(bnrs == 'center' || bnrs == 'right'){\r\n\t\tvar bnrTabIndex = bannerStatus[bnrs].tabIndex;\r\n\t\t\r\n\t\t//재생 & 중지 버튼\r\n\t\tdocument.getElementById(bnrs+\"PlayPauseBtn\").setAttribute(\"tabindex\", bnrTabIndex.playPause);\r\n\t\t//이전 버튼\r\n\t\tdocument.getElementById(bnrs+\"PrevBtn\").setAttribute(\"tabindex\", bnrTabIndex.prev);\r\n\t\t//이후 버튼\r\n\t\tdocument.getElementById(bnrs+\"NextBtn\").setAttribute(\"tabindex\", bnrTabIndex.next);\r\n\t}\r\n\r\n}\r\n\r\nfunction resetTabIndex(bnrs){\r\n\t//재생 & 중지 버튼\r\n\tdocument.getElementById(bnrs+\"PlayPauseBtn\").tabindex = -1;\r\n\t//이전 버튼\r\n\tdocument.getElementById(bnrs+\"PrevBtn\").tabindex = -1;\r\n\t//이후 버튼\r\n\tdocument.getElementById(bnrs+\"NextBtn\").tabindex = -1;\r\n}\r\n\r\nfunction bnrFocusControl(bnrs){\r\n\tvar bnrContainer = document.getElementById(bnrs+\"Bnr\");\r\n\t\r\n\tbnrContainer.addEventListener(\"focusin\", function(e){\r\n\t\tif(isKeyboard){\r\n\t\t\t//배너 요소 tabindex 부여\r\n\t\t\tsetTabIndex(bnrs);\r\n\t\t\tstopAuto(bnrs, false);\r\n\t\t}\r\n\t});\r\n\t\r\n\tbnrContainer.addEventListener(\"focusout\", function(e){\r\n\t\tif(!bnrContainer.contains(e.relatedTarget) && isKeyboard){\r\n\t\t\t//배너 요소 tabindex 제거\r\n\t\t\tresetTabIndex(bnrs);\r\n\t\t\tstartAuto(bnrs, false);\r\n\t\t}\r\n\t});\r\n\t\r\n}\r\n\r\nfunction showImgBanner(state){\r\n\t//a 태그에만\r\n\tvar activeTabIndex = state.tabIndex.container;\r\n\t\r\n\tstate.imgs.each(function(idx){\r\n\t\tif(idx == state.current){\r\n\t\t\t$(this).show();\r\n\t\t\t$(this).parent().attr(\"tabindex\", activeTabIndex);\r\n\t\t}else{\r\n\t\t\t$(this).hide();\r\n\t\t\t$(this).parent().attr(\"tabindex\", \"-1\");\r\n\t\t}\r\n\t});\r\n}\r\n\r\n\r\nfunction autoImg(bnrs){\r\n\tvar state = bannerStatus[bnrs];\r\n\tvar btn = document.getElementById(bnrs+\"PlayPauseBtn\");\r\n\tvar playIcon = btn.querySelector(\".icon-play\");\r\n\tvar pauseIcon = btn.querySelector(\".icon-pause\");\r\n\t\r\n\tstate.playing = !state.playing;\r\n\t\r\n\tif(state.playing){\r\n\t\tstartAuto(bnrs);\r\n\t\tplayIcon.style.display = \"none\";\r\n\t\tpauseIcon.style.display = \"flex\";\r\n\t\tbtn.setAttribute(\"aria-pressed\", \"true\");\r\n\t\tbtn.setAttribute(\"aria-label\", \"슬라이드 정지\");\r\n\t\t//updatePlayPauseText(bnrs, true);\r\n\t}else{\r\n\t\tstopAuto(bnrs);\r\n\t\tplayIcon.style.display = \"flex\";\r\n\t\tpauseIcon.style.display = \"none\";\r\n\t\tbtn.setAttribute(\"aria-pressed\", \"false\");\r\n\t\tbtn.setAttribute(\"aria-label\", \"슬라이드 재생\");\r\n\t\t//updatePlayPauseText(bnrs, false);\r\n\t}\r\n}\r\n\r\nfunction updatePlayPauseText(bnrs, isPlaying){\r\n\tvar text = document.getElementById(bnrs+\"PlayPauseText\");\r\n\ttext.textContent = isPlaying ? \"슬라이드 정지 버튼\" : \"슬라이드 재생 버튼\";\r\n}\r\n\r\nfunction resetBannerState(bnrs){\r\n\tvar state = bannerStatus[bnrs];\r\n\tif(!state){\r\n\t\treturn;\r\n\t}\r\n\t\r\n\tif(state.timer){\r\n\t\tclearInterval(state.timer);\r\n\t}\r\n\t\r\n\tstate.current = 0;\r\n\tstate.imgs = null;\r\n\tstate.total = 0;\r\n\tstate.timer = null;\r\n\tstate.playing = false;\r\n}\r\n\r\n\r\n"
          },
