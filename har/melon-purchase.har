lic bold 14px/30px Georgia, serif; }\r\n#lpPlPointSect { display: none; margin: 0px 0 3px 0; }\r\n#lpPointLayer { width: 300px; margin: 0; border-collapse: collapse; border-top: 1px solid #dbdbdb; background-color: white; display: table; border-spacing: 2px; border-top: 0px; }\r\n.m20 { display: table-footer-group; text-align: center; }\r\n\r\n\r\n\r\n/*********************************************************/\r\n/*********************************************************/\r\n/* new_naverpay.css **************************************/\r\n/*********************************************************/\r\n/*********************************************************/\r\n\r\n/*    naverpay renewal popup css */\r\n\r\n/* reset */\r\nbody,a,li,h2,h1{color:#111;font-size: 12px;}\r\n@supports(-webkit-appearance: none) or (-moz-appearance: none) { \r\n    .naverPay_wrap .radio {\r\n\t    \t-webkit-appearance: none;\r\n\t    \t-moz-appearance: none;\r\n\t    \tbackground: #fff;\r\n\t    \tborder: 1px solid #909090;\r\n\t    \tborder-radius: 50%;\r\n\t    \tcursor: pointer;\r\n\t    \twidth: 18px;\r\n\t    \theight: 18px;\r\n    \t}\r\n    \t\r\n\t.naverPay_wrap label .radio:checked::after {\r\n\t    position: absolute;\r\n\t    border: 0;\r\n\t    content: '';\r\n\t    display: block;\r\n\t    top: 50%;\r\n\t    left: 50%;\r\n\t    margin: -6px 0 0 -6px;\r\n\t    width: 12px;\r\n\t    height: 12px;\r\n\t    border-radius: 50%;\r\n\t    background: #09AA5C;\r\n\t    border-color:#09AA5C;\r\n    }\r\n}\r\n.radio_wrap { cursor: pointer; }\r\n.radio_txt { display: inline-block; font-size: 12px; color: #111; font-weight: 400; padding: 4px; }\r\n.radio:focus ~ .radio_wrap { outline: 2px; }\r\n.radio:checked ~ .radio_wrap .radio_txt { font-weight: 600; }\r\n.radio:disabled ~ .radio_wrap { color: #111; cursor: default; }\r\n.radio:disabled ~ .radio_wrap .radio_txt { color: #111; font-weight: 400; }\r\n\r\n.select {\r\n\t/* width:100%; */\r\n\tpadding:0;\r\n\theight: auto;\r\n\tborder-radius:4px;\r\n\tfont-size:12px;\r\n\tborder:1px solid #909090 ;\r\n}\r\n\t\r\ninput[type=\"text\"],input[type=\"password\"] {\r\n\twidth:auto;\r\n\tpadding:8px 0;\r\n\tborder-radius:4px;\r\n\tborder:1px solid #909090;\r\n\tfont-size:12px;\r\n\tbox-sizing: border-box;\r\n\theight: 24px;\r\n\tline-height:1em;\r\n\ttext-align: center;\r\n}\r\n\t\r\ninput::placeholder, input::-webkit-input-placeholder, input:-ms-input-placeholder { color: #909090; }\r\ninput::placeholder { color: #909090; }\r\ninput:-ms-input-placeholder { color: #909090; }\r\ninput::-webkit-input-placeholder { color: #909090; }\r\n.naverPay_popLayer { position: fixed; top: 50%; left: 50%; width: 500px; height: 420px; margin: -200px 0 0 -250px; padding: 0; border: 1px solid #acacac; box-sizing: border-box; background: #fff; z-index: 9999; }\r\n.naverPay_popLayer h1,h2,h3 { padding: 0; margin: 0; }\r\n.naverPay_popLayer ul { list-style: none; margin: 0; padding: 0; }\r\n.naverPay_wrap li { box-sizing: border-box; }\r\n.naverPay_header { border-bottom: 8px solid #F0F2F4; padding: 15px 10px 10px; }\r\n.naverPay_header ul { width: 100%; }\r\n.naverPay_header li { display: flex; justify-content: space-between; align-items: center; font-size: 12px; padding: 5px 10px; }\r\n.naverPay_header .naver_price { font-size: 15px; font-weight: bold; }\r\n.naverPay_con { padding: 15px 10px; }\r\n.naverPay_con h2 { font-size: 13px; padding: 5px 10px; display: inline-block; }\r\n.naverPay_con .naverPay_type { display: flex; justify-content: space-between; }\r\n.naverPay_con .naverPay_type li { padding: 5px 10px; width: 100%; position: relative; }\r\n.naverPay_type label .radio { position: absolute; margin: 0; right: 20px; top: 22px; }\r\n.naverPay_type .naver_radio_point_txt { position: absolute; margin: 0; right: 40px; top: 24px; font-size: 11px; color: #09AA5C; font-weight: bold; }\r\n.naverPay_type .radio_wrap { border: 1px solid #909090; border-radius: 10px; padding: 10px 20px; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; }\r\n.naverPay_type .radio:checked ~ .radio_wrap { border-color: #09AA5C; }\r\n.naverPay_popLayer .cashRecript { margin: 10px 0 0; }\r\n.naverPay_popLayer .cashRecript_type { display: flex; }\r\n.naverPay_popLayer .cashRecript_type li { padding: 4px 10px; }\r\n.naverPay_popLayer .cashRecript_type label { display: flex; align-items: center; position: relative; }\r\n.naverPay_popLayer .cashRecript_type .radio { position: relative; margin: 0; width: 18px; height: 18px; }\r\n.naverPay_popLayer .cashReceiptInfo { padding: 2px 5px; }\r\n.naverPay_popLayer .cashReceiptInfo ul { display: grid; grid-template-columns: 120px auto; align-items: center; box-sizing: border-box; }\r\n.naverPay_popLayer .cashReceiptInfo li { padding: 0 5px; width: 100%; box-sizing: border-box; font-size: 12px}\r\n\r\n.naverPay_popLayer .cashReceiptInfo li .inputInline { display: flex; align-items: center; }\r\n.naverPay_popLayer .cashReceiptInfo li .inputInline span { padding: 0 4px; }\r\n.naverPay_popLayer .cashReceiptInfo.businessDeduct ul { grid-template-columns: 100px auto; }\r\n.naverPay_popLayer .cashReceiptInfo.businessDeduct span { padding: 0 0 0 4px; }\r\n.naverPay_Btn { position: absolute; bottom: 0; width: 100%; padding: 0 10px 20px; box-sizing: border-box; }\r\n.naverPay_Btn ul { display: flex; flex-direction: row; }\r\n.naverPay_Btn ul li { padding: 0 10px; width: 100%; }\r\n.naverPay_Btn ul li button { width: 100%; border: 0; padding: 12px 0; font-weight: bold; font-size: 15px; text-align: center; border-radius: 5px; cursor: pointer; }\r\n.naverPay_btn.cancel { background-color: #E4F1EA; color: #666; }\r\n.naverPay_btn.submit { background-color: #08C15A; color: #111; }\r\n.hide { display: none; }\r\n.naverPay_type_tit { display: flex; align-items: center; justify-content: space-between; }\r\n.naverPay_type_tit span { padding: 0 10px 0 0; color: #666; font-size: 12px; }\r\n\r\n\r\n/*   naver captcha popup css */\r\n#captchaPopup { top: 50%; left: 50%; width: 450px; margin: -202px 0 0 -295px; }\r\n#contentDiv { margin-top: 21px}\r\n#imgDiv { display: flex; flex-direction: row; justify-content: space-between; }\r\n#imgDiv li:nth-child(2), #voiceDiv li:nth-child(2) { text-align: right; }\r\n#refreshImgBtn, #refreshVoiceBtn { width: 220px; height: 40px; background: #fff; border: 1px solid #bbb; text-align: left; padding: 0 0 0 20px; font-weight: bold; box-sizing: border-box; color: #555; margin: 0 0 10px 0; }\r\n#changeVoiceBtn, #changeImgBtn { width: 220px; height: 40px; background: #fff; border: 1px solid #bbb; text-align: left; padding: 0 0 0 20px; font-weight: bold; color: #555; box-sizing: border-box; }\r\n#imgDiv li input[type=button] img { width: 16px; margin-right: 10px; }\r\n#voiceDiv { display: flex; flex-direction: row; justify-content: space-between; }\r\n#voiceImg { width: 200px; height: 90px; display: flex; background: #eee; border: 1px solid #bbb; text-align: center; flex-direction: column; justify-content: center; align-items: center; box-sizing: border-box; }\r\n#voiceDiv li input[type=button] img { width: 16px; margin-right: 10px; }\r\n#textDiv li { border: 1px solid #bbb; }\r\n#captchaText { border: none; width: 100%; padding: 10px; box-sizing: border-box; height: 40px; }\r\n#btnDiv { margin-bottom: 20px}\r\n\r\n/* amex voucher popup 250609 */\r\n#voucherLayer { width: 400px; margin: -120px 0 0 -180px; word-break: keep-all; }\r\n#voucherLayer h4 { font-size: 18px; color: #707070; line-height: 1.2em; font-weight: 500; }\r\n#voucherLayer h4 strong { color: #000; font-size: 19px; font-weight: 700; }\r\n#voucherLayer .voucherCon { margin: 15px 0; }\r\n#voucherLayer .voucherCon p { text-align: left;font-size:13px;line-height: 1.4em;padding: 4px 10px 4px 0;color: #666;font-weight: 300; }\r\n#voucherLayer .voucherCon p strong { color: #111;font-weight: 600; }\r\n#voucherLayer .voucherCon p strong.important {color:#f2310b }\r\n\r\n/* �궓��臾� 寃쎌같�꽌 �삊�뾽 �씠誘몄� 愿��젴 異붽� 250819 */\r\n.smpa_bnr_r { position: absolute; left:0; bottom:180px; }\r\n\r\n/* 愿묎퀬 �꽌鍮꾩뒪 �쁺�뿭 CSS 異붽� 250917 */\r\n.bnr_new {display: flex; flex-direction: row; padding-right: 5px; justify-content: space-between; margin-bottom: 5px;}\r\n.bnr_new .bnr_img {width: 100%; max-height: 28px; max-width: 284px; border-radius: 8px;}\r\n.bnr_new .btn_sec {display: flex; flex-direction: row; font-size: 11px; align-items: center; gap: 8px;}\r\n.bnr_new .btn_sec .detail {display: flex; flex-direction: row; gap: 4px; align-items: center;}\r\n.bnr_new .btn_sec .detail  a {font-size: 11px; cursor: pointer; color: #707070;}\r\n.bnr_new .btn_sec .chk_box {display: flex; align-items: center; gap: 3px;}\r\n.bnr_new .sub {font-size:9px; line-height:1px; font-weight:bold; margin-top:3px; color:#4F4F4F;}\r\n\r\n/* 광고배너 영역 추가 260119 */\r\n/* 공통 */\r\n.std_ad_area, .std_ad_center_area, .std_ad_right_area {\r\n  position: relative;\r\n  display: inline-block;\r\n}\r\n\r\n/* 롤링 */\r\n.slider_controls {\r\n  position: absolute;\r\n  right: 4px;\r\n  bottom: 4px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n  font-family: sans-serif;\r\n}\r\n\r\n.toggle-btn {\r\n  width: 13px;\r\n  height: 13px;\r\n  border: none;\r\n  border-radius: 50%;\r\n  background-color: rgba(255, 255, 255, 0.7);\r\n  font-size: 7px;\r\n  font-weight: bold;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n/* 넘버링 + 화살표 컨테이너 */\r\n.page_controls {\r\n  display: flex;\r\n  align-items: center;\r\n  background-color: rgba(255, 255, 255, 0.7);\r\n  border-radius: 9999px;\r\n  padding: 0 3px;\r\n}\r\n\r\n/* 화살표 버튼 */\r\n.nav_button {\r\n  background: none;\r\n  border: none;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  color: #4b4b4b;\r\n  padding: 0;\r\n  margin: 0;\r\n  padding-bottom: 3px;\r\n}\r\n\r\n/* 페이지 번호 */\r\n.page_number {\r\n  margin: 0px 5px;\r\n  font-size: 10px;\r\n  color: #333;\r\n  display: flex;\r\n  gap: 3px;\r\n  font-weight: 700;\r\n}\