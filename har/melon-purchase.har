            "text": "/*\r\n *  Author : ehbang\r\n */\r\n\r\nfunction callFirstPaymethod(){\r\n\t// 결제 화면 초기 진입 시 화면 및 동의 설정_2017.02.22_kyb\r\n\tvar flgUseProvisionLength = jQuery(\"#payMethodViewDiv\").find(\"#flgUseProvision\").length;\r\n\tvar escrowLength = jQuery(\"#payMethodViewDiv\").find(\"#escrow\").length;\r\n\tvar firstMenuId = jQuery(\"#payMethodViewDiv\").find(\".payMethodSelecBtn\").eq(0).attr(\"id\");\r\n\tvar currency = jQuery(\"input:hidden[name=currency]\").val();\r\n\t\r\n\t// 보이는 메뉴 중에서 첫번째 메뉴를 선택메뉴로 전역변수에 저장한다.\r\n\tselectMenuId = jQuery(\"#payMethodViewDiv\").find(\".payMethodSelecBtn:not(.hide)\").eq(0).attr(\"id\");\t\r\n\t// 보이는 메뉴 중에서 첫번째 메뉴에 선택 이미지 설정\r\n\tjQuery(\"#\" + selectMenuId).addClass(\"on\");\r\n\t\r\n\t//250224 이노시스 웹접근성으로 인하여 결제창 호출 후 상단 on 처리 시 title 선택됨 추가\r\n\tjQuery(\"#\" + selectMenuId).attr(\"title\", jQuery(\"#\" + selectMenuId).find(\"a span\").text().replace(/[\\n\\t]+/g, \"\") + \" 선택됨\");\r\n\r\n\t// 가맹점에서 이용약관 등록이 되어있으면 이용약관 동의 : true\r\n\tif(flgUseProvisionLength == 0) {\r\n\t\tisAssentChk = true;\r\n\t\tisFlgUseProvision = true;\r\n\t}\r\n\t\r\n\tif(escrowLength > 0) { // 에스크로로 진입 시\r\n\t\tsetPaymethodView(\"escrow\",\"payStart\",null);\r\n\t} else { // 에스크로 진입이 아닐 때\r\n\t\tisEscrowChk = true; // 에스크로 동의를 true로 설정\r\n\t\t\r\n\t\t/*\r\n\t\t * 리뉴얼 화면과 나머지 결제의 이용약관 동의 방식이 달라서 구분 처리\r\n\t\t * 기존 : 에스크로 동의 -> 이용약관 동의 -> 결제화면\r\n\t\t * 리뉴얼 : 에스크로 동의 -> 이용약관 동의 + 결제화면\r\n\t\t * 리뉴얼 완료 후 else 부분 삭제\r\n\t\t */\r\n\t\t\r\n\t\tvar dboption = $payForm.find(\"input[name=dboption]\").val();\r\n\t\t\r\n\t\tif(selectMenuId == \"Card\" || selectMenuId == \"HPP\" || selectMenuId == \"GiftCard\") {\r\n\t\t\tsetPaymethodView(selectMenuId,\"payStart\",null);\r\n\t\t}else if(selectMenuId == \"DirectBank\"){\r\n\t\t\tif(currency != \"USD\") {\r\n\t\t\t\tif(firstMenuId == \"flgUseProvision\") {\r\n\t\t\t\t\tfirstMenuId = \"AssentChk\";\r\n\t\t\t\t}else {\r\n\t\t\t\t\tif(dboption == \"1\"){\r\n\t\t\t\t\t\tfirstMenuId = \"iDirectBank\";\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tfirstMenuId = \"DirectBank\";\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tsetPaymethodView(firstMenuId,\"payStart\",null);\r\n\t\t\t\t\r\n\t\t\t} else {\r\n\t\t\t\tif(dboption == \"1\"){\r\n\t\t\t\t\tsetPaymethodView(\"iDirectBank\",\"payStart\",null);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tsetPaymethodView(\"DirectBank\",\"payStart\",null);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}else {\r\n\t\t\t\r\n\t\t\tif(currency != \"USD\") {\r\n\t\t\t\tif(firstMenuId == \"flgUseProvision\") {\r\n\t\t\t\t\tfirstMenuId = \"AssentChk\";\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tsetPaymethodView(firstMenuId,\"payStart\",null);\r\n\t\t\t} else {\r\n\t\t\t\tsetPaymethodView(selectMenuId,\"payStart\",null);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t}\r\n\t}\r\n\t\r\n\t\r\n}\r\n\r\n/////////////////////////////////////\r\n// 변수 선언\r\n/////////////////////////////////////\r\n\r\nvar boolMobile = false;\r\n\r\njQuery(document).ready(function(){\r\n\t// 스크린 키보드 타켓 설정\r\n\t$screenKeytarget = \"#subWrapper\";\r\n});\r\n\r\n/////////////////////////////////////\r\n// 로딩창 표시용\r\n/////////////////////////////////////\r\n\r\nfunction showLoading(){\r\n\tjQuery('#wrapper').hideLoading();\r\n\tjQuery('#wrapper').showLoading();\r\n}\r\n\r\n//showLoading();\r\n\r\nfunction hideLoadingSlow(){\r\n\tsetTimeout(function(){jQuery('#wrapper').hideLoading();}, 800);\r\n}\r\n\r\nfunction hideLoading(){\r\n\tsetTimeout(function(){jQuery('#wrapper').hideLoading();});\r\n}\r\n\r\n\r\n\r\n//사용자 이미지 크기 조절\r\n/*\r\nfunction setMemberImg(){\r\n\r\n\tif(jQuery(\"#member\").size() >0){\r\n\r\n\t\tif( 280 <= jQuery(\"#member img\").width()){\r\n\r\n\t\t\tvar setSize = 280;\r\n\t\t\tvar $mImg = jQuery(\"#member img\");\r\n\r\n\t\t\tvar width = $mImg.width();\r\n\t\t\tvar height = $mImg.height();\r\n\r\n\t\t\tif (width > setSize) {\r\n\t\t\t\tvar widthHiritu= (width - setSize) / width;\r\n\t\t\t\tvar newImgWidth= setSize;\r\n\t\t\t\tvar newImgHeight=Math.floor(height - (height * widthHiritu));\r\n\r\n\t\t\t\t$mImg.width(newImgWidth);\r\n\t\t\t\t$mImg.height(newImgHeight);\r\n\r\n\t\t\t}\r\n\r\n\t\t}\r\n\r\n\t\tif(230 <= jQuery(\"#member img\").height()){\r\n\r\n\t\t\tvar setSize = 230;\r\n\t\t\tvar $mImg = jQuery(\"#member img\");\r\n\r\n\t\t\tvar width = $mImg.width();\r\n\t\t\tvar height = $mImg.height();\r\n\r\n\t\t\tif (height > setSize) {\r\n\t\t\t\tvar heightHiritu= (height - setSize) / height;\r\n\t\t\t\tvar newImgHeight= setSize;\r\n\t\t\t\tvar newImgWidth=Math.floor(width - (width * heightHiritu));\r\n\r\n\t\t\t\t$mImg.width(newImgWidth);\r\n\t\t\t\t$mImg.height(newImgHeight);\r\n\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t}\r\n\r\n}\r\n*/\r\n\r\n//alert\r\nfunction callAlert(msg,func){\r\n\r\n\tshowLoading();\r\n\r\n\tif(null == func){\r\n\t\tjAlert(msg, INImsg.title, function(r) {\r\n\t\t\tif(r){hideLoading();}\r\n\t\t});\r\n\t}else{\r\n\t\tjAlert(msg, INImsg.title, function(r){\r\n\t\t\tif(r){\r\n\t\t\t\tfunc(r);\r\n\t\t\t\thideLoading();\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n}\r\n\r\n/**\r\n * 네이버 nik 알림창 - 타이틀 입력가능 추가 2015-10-03 by yang \r\n * **/\r\nfunction callNikAlert(msg,tit,func){\r\n\r\n\tshowLoading();\r\n\r\n\tif(null == func){\r\n\t\tjAlert(msg, tit, function(r) {\r\n\t\t\tif(r){hideLoading();}\r\n\t\t});\r\n\t}else{\r\n\t\tjAlert(msg, tit, function(r){\r\n\t\t\tif(r){\r\n\t\t\t\tfunc(r);\r\n\t\t\t\thideLoading();\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n}\r\n\r\n"
          },
