= 0; \r\n\t\t\r\n\t\tvar setInter = setInterval(function(){\r\n\t\t\tintervalcnt ++;\r\n\t\t\t\r\n\t\t\tif(jQuery('#overlayFrame').length > 0) {\r\n\t\t\t\tclearInterval(setInter);\r\n\t\t\t\tsetIframeCloseBtn();\r\n\t\t\t\tjQuery('#overlayFrame').attr(\"tabindex\", \"399\");\r\n\t\t\t}else if(intervalcnt > 5)\r\n\t\t\t{\r\n\t\t\t\tclearInterval(setInter);\r\n\t\t\t}\r\n\t\t},1000);\r\n\t\t\r\n\t}else{\r\n\t\t\r\n\t\tvar win = '';\r\n\t\t\r\n\t\t// Fixes dual-screen position                         Most browsers      Firefox\r\n\t    var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;\r\n\t    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;\r\n\r\n\t    width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t    height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\r\n\t    var left = ((width / 2) - (w / 2)) + dualScreenLeft;\r\n\t    var top = ((height / 2) - (h / 2)) ;\r\n\t\t    \r\n\t\twin = window.open(\"../checkWin.jsp\",\"newFrame\",\"width=450,height=520,resizable=no,scroll=auto,top=\"+top+\",left=\"+left+\",modal=yes\");\r\n\t\t\r\n//\t\t\t\t\t\twin = window.open(\"../checkWin.jsp\",\"_blank\",\"width=450,height=520,resizable=no,scroll=auto,top=\"+top+\",left=\"+left+\",modal=yes\");\r\n//\t\t\t\t\t\twin.document.write('<iframe name=\"newFrame\" width=\"100%\" height=\"500\" frameborder=\"0\" allowfullscreen></iframe>');\r\n\t\t\r\n\t\t\r\n\t\t// set user-agent\r\n\t\tvar popUseragent = navigator.userAgent;\r\n\t\t\r\n\t\tif( !win ){\r\n\t\t\t\r\n\t\t\tvar alertMsg = \"\";\r\n\r\n\t\t\t/*if(popUseragent.indexOf(\"Edge\")>-1) {\r\n\t\t\t\talertMsg = \"결제창 정상 호출을 위한 설정 방법 \\n\\n1.신뢰할 수 있는 사이트 변경\\n인터넷 익스플로러 내 도구>인터넷 옵션>보안(탭)>신뢰할 수 있는 \\n사이트>사이트(버튼)에서 상점 도메인과 https://stdpay.inicis.com를\\n모두 추가 혹은 제거 합니다.\\n\\n2.팝업차단 확인\\n도구>인터넷옵션>개인 정보(탭)> 팝업 차단 사용 해지 합니다.\\n\\n설정 이후 페이지를 새로고침 해주세요.\";\r\n\t\t\t} else if(popUseragent.indexOf(\"Firefox\")>-1 || popUseragent.indexOf(\"Chrome\")>-1 || popUseragent.indexOf(\"Safari\")>-1) {\r\n\t\t\t\talertMsg = \"팝업이 차단되었습니다.\\n팝업차단 해제 후 다시 시도해 주시기 바랍니다.\";\r\n\t\t\t} else {\r\n\t\t\t\talertMsg = \"결제창 정상 호출을 위한 설정 방법 \\n\\n1.신뢰할 수 있는 사이트 변경\\n인터넷 익스플로러 내 도구>인터넷 옵션>보안(탭)>신뢰할 수 있는 \\n사이트>사이트(버튼)에서 상점 도메인과 https://stdpay.inicis.com를\\n모두 추가 혹은 제거 합니다.\\n\\n2.팝업차단 확인\\n도구>인터넷옵션>개인 정보(탭)> 팝업 차단 사용 해지 합니다.\\n\\n설정 이후 페이지를 새로고침 해주세요.\";\r\n\t\t\t}\r\n\t\t\t*/\r\n\t\t\t\r\n\t\t\tif(popUseragent.indexOf(\"Firefox\")>-1 || popUseragent.indexOf(\"Chrome\")>-1 || popUseragent.indexOf(\"Safari\")>-1 || popUseragent.indexOf(\"Edg\")>-1) {\r\n\t\t\t\talertMsg = INImsg.alert_popup_check2;\t\r\n\t\t\t} else {\r\n\t\t\t\talertMsg = INImsg.alert_popup_check1;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tjAlert(alertMsg, \"KG이니시스\", function(r) {\r\n\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\tlocation.href = closeUrl;\t\r\n\t\t\t\t\r\n\t\t\t\tif(typeof(win)!='undefined' || !win.closed) {\r\n\t\t\t\t\twin.close();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\treturn;\r\n\t\t} else{\r\n\t\t\tvar setInter = setInterval(function(){\r\n//\t\t\t\t\t\t\t\twin.focus();\r\n\t\t\t\tif(typeof(win)=='undefined' || win.closed) {\r\n//\t\t\t\t\t\t\t\t\talert(\"name=payPopup===============\"+$payForm.find(\"input[name=payPopup]\").val());\r\n\t\t\t\t\t// 정상처리 되면 0\r\n\t\t\t\t\t\r\n\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2'){\r\n\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\tlocation.href = closeUrl;\t\r\n\t\t\t\t\t}else{\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\thideLoading();\r\n\t\t\t\t\t}\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t}\r\n\r\n\t\t\t},2000);\r\n\t\t\t\r\n\t\t\t$payForm.attr(\"target\",\"newFrame\");\r\n\t\t}\r\n\t\t\r\n\t\t$payForm.attr(\"target\",\"newFrame\");\r\n\t\t$payForm.attr(\"action\",\"/payAuthentication/tmoneypay\");\r\n\t\t$payForm.trigger(\"submit\");\r\n\t}\r\n\r\n}\r\n\r\n//전용차에서 포인트 팝업처리\r\nfunction makePointPopup(type,cardCode){\r\n\tif($payForm.find(\"input[name=payViewType]\").val() == 'popup'){\r\n\t\t\r\n\t\tvar w;\r\n\t\tvar h;\r\n\t\tvar url;\r\n\t\t//포인트 결제 동의 안내\r\n\t\tif(!checkPointMinPrice()){\r\n\t\t\tw= 330;\r\n\t\t\th= 175;\r\n\t\t\turl = '../pointPopup/Point3.html'; //포인트 최소금액 미달 안내\r\n\t\t}else{\r\n\t\t\tif($payForm.find(\"input[name=selectPopup]\").val() == '1'){\r\n\t\t\t\tw= 330;\r\n\t\t\t\th= 155;\r\n\t\t\t\turl = '../pointPopup/Point1-1.html';\r\n\t\t\t}else if($payForm.find(\"input[name=selectPopup]\").val() == '2'){\r\n\t\t\t\tw= 330;\r\n\t\t\t\th= 155;\r\n\t\t\t\turl = '../pointPopup/Point1-1.html';\r\n\t\t\t}else if($payForm.find(\"input[name=selectPopup]\").val() == '3'){\r\n\t\t\t\tw= 330;\r\n\t\t\t\th= 155;\r\n\t\t\t\turl = '../pointPopup/Point1.html';\r\n\t\t\t}else{\r\n\t\t\t//포인트 사용\r\n\t\t\t\tw= 330;\r\n\t\t\t\th= 155;\r\n\t\t\t\turl = '../pointPopup/Point1.html';\r\n\t\t\t}\r\n\t\t}\r\n\t\tvar dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;\r\n\t    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;\r\n\t\r\n\t    width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t    height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\t\r\n\t    var left = ((width / 2) - (w / 2)) + dualScreenLeft;\r\n\t    var top = ((height / 2) - (h / 2)) ;\r\n\t   \r\n\t\twin = window.open(url,\"newFrame\",\"width=\"+ w +\"px,height=\"+ h +\"px,resizable=no,scrollbars=no,top=\"+top+\",left=\"+left+\",modal=yes\");\r\n\t\tvar setInter = setInterval(function(){\r\n\t\t\tif(typeof(win)=='undefined' || win.closed) {\r\n\t\t\t\tclearInterval(setInter);\r\n\t\t\t\tif(type==\"VISA3D\"){\r\n\t\t\t\t\t\tcallVisa3d(cardCode);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif($payForm.find(\"input[name=KBAPP]\") != null && $payForm.find(\"input[name=KBAPP]\").val() =='KBAPP' && (cardCode == '06' || cardCode == '56')){\r\n\t\t\t\t\t\tcallkbAppPopup();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tcallISP();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},200);\r\n\t\t\r\n\t}else{\r\n\t\tif(!checkPointMinPrice()){\r\n\t\t\tvar  getTag=jQuery(\"#point_popup4\").html();\r\n\t\t\tjQuery(\"#overlay_popup\").html(getTag);\r\n\t\t\tjQuery(\"#overlay_popup\").css({\"width\":\"310px\",\"height\":\"129px\"});\r\n\t\t}else{\r\n\t\t\tif($payForm.find(\"input[name=selectPopup]\").val() == '1'){\r\n\t\t\t\t//\r\n\t\t\t\tvar  getTag=jQuery(\"#point_popup3\").html();\r\n\t\t\t\tjQuery(\"#overlay_popup\").html(getTag);\r\n\t\t\t\tjQuery(\"#overlay_popup\").css({\"width\":\"310px\",\"height\":\"129px\"});\r\n\t\t\t\t\r\n\t\t\t\t//wcchoi\r\n\t\t\t\t//2016.06.29\r\n\t\t\t\t//DESC: 포커스 이동\r\n\t\t\t\t//\r\n\t\t\t}else if($payForm.find(\"input[name=selectPopup]\").val() == '2'){\r\n\t\t\t\tvar  getTag=jQuery(\"#point_popup11\").html();\r\n\t\t\t\tjQuery(\"#overlay_popup\").html(getTag);\r\n\t\t\t\tjQuery(\"#overlay_popup\").css({\"width\":\"310px\",\"height\":\"300px\"});\r\n\t\t\t\tif($payForm.find(\"input[name=card_customized_msg]\").val().length > 0){\r\n\t\t\t\t\tshowCpMsgCustom($payForm.find(\"input[name=card_customized_msg]\").val(), cardCode);\r\n\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t//wcchoi\r\n\t\t\t\t//2016.06.29\r\n\t\t\t\t//DESC: 포커스 이동\r\n\t\t\t}else if($payForm.find(\"input[name=selectPopup]\").val() == '3'){\r\n\t\t\t\tvar  getTag=jQuery(\"#point_popup12\").html();\r\n\t\t\t\tjQuery(\"#overlay_popup\").html(getTag);\r\n\t\t\t\tjQuery(\"#overlay_popup\").css({\"width\":\"310px\",\"height\":\"300px\"});\t\t\t\t\t\t\t\r\n\t\t\t\t//wcchoi\r\n\t\t\t\t//2016.06.29\r\n\t\t\t\t//DESC: 포커스 이동\r\n\t\t\t}else{\r\n\t\t\t//포인트 사용\r\n\t\t\t\tvar  getTag=jQuery(\"#point_popup2\").html();\r\n\t\t\t\tjQuery(\"#overlay_popup\").html(getTag);\r\n\t\t\t\tjQuery(\"#overlay_popup\").css({\"width\":\"310px\",\"height\":\"129px\"});\r\n\t\t\t\t//wcchoi\r\n\t\t\t\t//2016.06.29\r\n\t\t\t\t//DESC: 포커스 이동\r\n\t\t\t}\r\n\t\t}\r\n\t\toverlayPopupOnOff(true);\r\n\t\r\n\t}\r\n}\r\n\r\n\r\n\r\nfunction showCpMsgCustom (cpMsgJsonStr, cardCode) {\r\n\tvar deJsonStr = decodeURIComponent(cpMsgJsonStr);\r\n\tvar cpMsgJson = JSON.parse(deJsonStr);\r\n\tvar cpMsg = cpMsgJson[cardCode];\r\n\tif(cpMsg != \"undefined\" && cpMsg != null && cpMsg != \"\"){\r\n\t\t$(\".tblType04 .odd\").show;\r\n\t\t$(\"#newrlaxogns\").parent(\"tr\").show();\r\n\t\t$(\"#newrlaxogns\").html(cpMsg);\r\n\t}else{\r\n\t\t$(\"#newrlaxogns\").parent(\"tr\").hide();\r\n\t}\r\n}\r\n\r\nfunction checkPointMinPrice(){\r\n\tvar $selCardCD;\r\n\tif(boolMobile){\r\n\t\t$selCardCD = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t}else{\r\n\t\t$selCardCD = $payForm.find(\"[name=cardCode]:checked\");\r\n\t}\r\n\t//console.log($selCardCD.val());\r\n\t\r\n\tif(($payForm.find(\"input[name=cardPointList]\").val() !=null && $payForm.find(\"input[name=cardPointList]\").val().indexOf($selCardCD.val()) >= 0) ||\r\n\t\t\t\t($payForm.find(\"input[name=q5CardPointList]\").val() !=null && $payForm.find(\"input[name=q5CardPointList]\").val().indexOf($selCardCD.val()) >= 0 )){\r\n\t\t\r\n\t\tvar cardPointDetailList = $payForm.find(\"input[name=cardPointDetailList]\").val();\r\n\t\tvar selCardCode = $payForm.find(\"[name=cardCode]:checked\").val();\r\n\t\t//console.log(cardPointDetailList);\r\n\t\t//console.log($payForm.find(\"input[name=cardPointList]\").val());\r\n\t\tif(jQuery.trim(cardPointDetailList) != \"\"){\r\n\t\t\tvar detailArr = cardPointDetailList.split(\",\");\r\n\t\t\tvar cardCode = new Array();\r\n\t\t\tvar minPrice = new Array();\r\n\t\t\tvar detailInfoYN = \"N\";\r\n\t\t\tvar detailIdx = 0;\r\n\t\t\tfor(var i=0 ; i < detailArr.length ; i++){\r\n\t\t\t\tcardCode.push(detailArr[i].split(\"-\")[0]);\r\n\t\t\t\tminPrice.push(detailArr[i].split(\"-\")[1]);\r\n\t\t\t\tif(jQuery.trim(detailArr[i].split(\"-\")[0]) == jQuery.trim(selCardCode)){\r\n\t\t\t\t\tdetailInfoYN = \"Y\";\r\n\t\t\t\t\tdetailIdx = i;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar oriPrice \t= Number($('[name=price]').val()); //결제요청금액\r\n\t\t\tvar minusPrice = 0;\r\n\t\t\tif(detailInfoYN == \"Y\"){\r\n\t\t\t\tif($payForm.find(\"input[name=couponInfo]\").val() !=null && $payForm.find(\"input[name=couponInfo]\").val().length > 0){\r\n\r\n\t\t\t\t\tvar couponPrice = Number($payForm.find(\"input[name=couponInfo]\").val().split(\"-\")[1]);\r\n\t\t\t\t\t\r\n\t\t\t\t\tminusPrice = oriPrice - couponPrice;\r\n\t\t\t\t}else if(Number($('[name=lpoint]').val()) > 0){ //Lpoint 사용\r\n\t\t\t\t\tminusPrice = oriPrice - Number($('[name=lpoint]').val());\r\n\t\t\t\t}else{\r\n\t\t\t\t\tminusPrice = oriPrice;\r\n\t\t\t\t}\r\n\t\t\t\tif(Number(minusPrice) < Number(minPrice[detailIdx])){\r\n\t\t\t\t\t$(\"#pntMinPrice\").text(minPrice[detailIdx].replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,'));\r\n\t\t\t\t\ttry{\r\n\t\t\t\t\t\t$(\"#pntMinPrice2\").text(minPrice[detailIdx].replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,'));\r\n\t\t\t\t\t}catch(e){\r\n\t\t\t\t\t}\r\n\t\t\t\t\t//console.log(cardCode +\"\\n\" + minPrice + \"\\n\" + detailInfoYN + \"\\n\" +selCardCode +\"\\nminusPrice :\"+ minPrice[detailIdx] +\"/\"  +minusPrice);\t\t\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t//console.log(cardCode +\"\\n\" + minPrice + \"\\n\" + detailInfoYN + \"\\n\" +selCardCode +\"\\n minusPrice\"+ minPrice[detailIdx] +\"/\"  +minusPrice);\r\n\t\t}\r\n\t}\r\n\treturn true;\r\n\t\r\n}\r\n\r\n//Iframe overlay_CloseBtn 포커싱\r\nfunction setIframeCloseBtn(){\r\n\tjQuery('.overlay_close').attr({\r\n\t\tid: \"overlay_CloseBtn\",\r\n\t\ttabindex: \"398\"\r\n\t});\r\n\tjQuery('#overlay_CloseBtn').focus();\r\n}\r\n\r\n//웹접근성 개선\r\nfunction setCardBtnTitle(id){\r\n\tvar selectCardCodeInfo = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\r\n\tif(id == \"payCodeEctSelect\"){\r\n\t\tif((selectCardCodeInfo.val() != \"Kpay\")){\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"새창열림\");\r\n\t\t}else{\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t}\r\n\t}else{\r\n\t\tif($payForm.find(\"input[name=payPopup]\").val() == '1')\r\n\t\t{\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"새창열림\");\r\n\t\t}\t\r\n\t\telse if(selectCardCodeInfo.attr(\"cardtype\") == \"isp\" && (selectCardCodeInfo.val() == '06' && $payForm.find(\"input[name=KBAPP]\") != null && $payForm.find(\"input[name=KBAPP]\").val() =='KBAPP'))\r\n\t\t{\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t}\r\n\t\telse if(\r\n\t\t\tselectCardCodeInfo.attr(\"cardtype\") != \"visa3d\" && \r\n\t\t\tselectCardCodeInfo.attr(\"cardtype\") != \"union\" && \r\n\t\t\tselectCardCodeInfo.attr(\"cardtype\") != \"normal\" \r\n\t\t){\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"새창열림\");\r\n\t\t}else{\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction below1000Check()\r\n{\r\n\tvar oriPrice \t= Number($('[name=price]').val()); //결제요청금액\r\n\tvar acceptMethod = ($payForm.find(\"[name=acceptmethod]\").val());\r\n\tif(oriPrice < 1000 && acceptMethod.indexOf(\"below1000\") == -1)\r\n\t{\r\n\t\tjAlert(\"1,000원미만은 결제 하실 수 없습니다. \\n상점에 문의 해주세요.\", \"KG 이니시스\", function() \r\n\t\t\t\t{\r\n\t\t\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2') \r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\treturn \"N\";\r\n\t}\r\n\treturn \"Y\";\r\n}\r\n\r\n//이력 update 로직 추가로 인한 추가 250807\r\nfunction historyUpdateClose(closeUrl, viewType){\r\n\tjQuery.ajax({\r\n\t\tasync : true\r\n\t\t, url: \"/payMain/historyUpdate\"\r\n\t\t, data : $payForm.serialize()\r\n\t\t, type : \"POST\"\r\n\t\t, dataType:\"json\"\r\n\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\tvar resultCode = jsonData['resultValue'];\r\n\t\t\tif(resultCode == \"true\"){\r\n\t\t\t\tif(viewType == \"overlay\" || viewType == \"\" || viewType == null){\r\n\t\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tself.close();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t}\r\n\t\t, complete:function(jqXHR,status){\r\n\t\t}\r\n\t});\r\n\t\r\n}\r\n////////////////////////////////////////////////////\r\n//google analytics event tracking.\r\n///////////////////////////////////////////////////\r\nfunction ini_ga_event_tracking(cate , action , lbl , bInteraction) {\r\n\tga('send','event',{eventCategory\t:\tcate\r\n\t\t\t\t\t\t,eventAction\t:\taction\r\n\t\t\t\t\t\t,eventLabel\t\t:\tlbl\r\n\t\t\t\t\t\t,nonInteraction\t: \tbInteraction\r\n\t\t\t\t\t\t});\t//google analytics event tracking..\r\n}"
