            "text": "//////////////////////////////////////////////////////////////////////////////////////////////////\r\n//카드결제창 이벤트\r\n//////////////////////////////////////////////////////////////////////////////////////////////////\r\n\r\nvar chkValid = false;\r\n\r\nfunction setEventCard(){\r\n\t/**START**/\r\n\t//범용 카드에 네이버 nik 신용카드 통합  - 2015-10-13 by yang\r\n\tvar goPayMethod = $payForm.find('input[name=gopaymethod]').val();\r\n\tvar site_id_nik = $payForm.find('input[name=acceptmethod]').val();\r\n\tvar selectCardCode = \"\";\r\n\r\n\tif ('onlycard'  == goPayMethod && (-1 != site_id_nik.indexOf('site_id(nik)')) ) {\t//내이버 nik 카드\r\n\t\tINImsg.title = INImsg.alert_nik_card_title;\t//알림창 - 범용창 메소드 변경없이 알림창 title 변경 - 2015-10-03 by yang\r\n\t}\r\n\t/**END**/\r\n\t////////////////////////////////////\r\n\t// 카드 Step1\r\n\t////////////////////////////////////\r\n\r\n\t// 카드 Radio 선택시\r\n\tjQuery(document).on(\"change\",\"input:radio[name=cardCode]\", function(){\r\n\t\tvar price = $(\"input:hidden[name=price]\").val();\r\n\t\tprice = Number(price);\r\n\t\t\r\n\t\t//카드 Radio 선택시 이니안심 체크 시작\r\n\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t        if(jQuery(this).val() != null){\r\n\t\t\t\tif(jQuery(this).attr(\"cardType\") == \"isp\" || jQuery(this).attr(\"cardType\") == \"visa3d\"){\r\n\t\t\t\t/*\tif($payForm.find(\"input[name=cardQuota]\").val() != '00'){\r\n\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t}else if($('[name=lpUse]').val() == 'true'){\r\n\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg3);\r\n\t\t\t\t\t}else if($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf(jQuery(this).val()) >= 0){ //해외카드 일 경우 사용불가\r\n\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg1);\r\n\t\t\t\t\t}*/\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t//이니안심 특정 금액인 경우 할부개월 허용 로직 개선 250430\r\n\t\t\t\t\tif(jQuery(this).attr(\"cardCode\") == \"04\"){\r\n\t\t\t\t\t\t//현대카드\r\n\t\t\t\t\t\tif(price >= 10000 && price <= 199699){\r\n\t\t\t\t\t\t\tif($payForm.find(\"input[name=cardQuota]\").val() != '00' && $payForm.find(\"input[name=cardQuota]\").val() != '02' && $payForm.find(\"input[name=cardQuota]\").val() != '03'){\r\n\t\t\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg9);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tif($payForm.find(\"input[name=cardQuota]\").val() != '00'){\r\n\t\t\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t//그외카드\r\n\t\t\t\t\t\tif(price >= 50000 && price <= 199699){\r\n\t\t\t\t\t\t\tif($payForm.find(\"input[name=cardQuota]\").val() != '00' && $payForm.find(\"input[name=cardQuota]\").val() != '02' && $payForm.find(\"input[name=cardQuota]\").val() != '03'){\r\n\t\t\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg9);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tif($payForm.find(\"input[name=cardQuota]\").val() != '00'){\r\n\t\t\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t//lpoint 사용\r\n\t\t\t\t\tif($('[name=lpUse]').val() == 'true'){\r\n\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg3);\r\n\t\t\t\t\t}else if($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf(jQuery(this).val()) >= 0){ //해외카드 일 경우 사용불가\r\n\t\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\t\tresetKcare();\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg1);\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\t\tresetKcare();\r\n\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg1);\r\n\t\t\t\t}\r\n\t        }\r\n\t\t}\r\n\t\t//카드 Radio 선택시 이니안심 체크 끝\r\n\t\t\r\n\t\t//var price = $(\"input:hidden[name=price]\").val();\r\n\t\tvar viewPrice = '';\r\n\t\tvar installmentPrice =$(\"input[name=installmentPrice]\").val();\r\n\t\t//price = Number(price);\r\n\t\tinstallmentPrice = Number(installmentPrice);\r\n\t\t\r\n\t\t// 그외의 카드 셀렉트박스 초기화\r\n\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\t\r\n\t\t// 그외의 결제 셀렉트박스 초기화\r\n\t\tjQuery(\"#spanSelectPayCode .dropdown dt\").html($(\"#spanSelectPayCode .dropdown dd ul li:eq(0)\").html());\r\n\t\tjQuery(\"#payCodeEct\").val(\"\");\r\n\t\t\r\n\t\t$payForm.find(\"input[name=CARD_Point]\").val('0');\r\n\t\t\r\n\t\t///////체크값 초기화 하고 나가기!\r\n\t\tvar currency = $(\"input:hidden[name=currency]\").val();\r\n\t\tif(currency == 'WON'){\r\n\t\t\t\r\n\t\t\t//이니안심 사용여부 체크\r\n\t\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t\t\t\t//이니안심사용(결제요청금액 + 이니안심금액\r\n\t\t\t\tviewPrice = String(Number($payForm.find(\"input[name=price]\").val()) + Number($('[name=PR_KCARE]').val())).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\t}else{\r\n\t\t\t\tviewPrice = String($payForm.find(\"input[name=price]\").val()).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t$(document).find(\"input[name=couponInfo]\").val('');\r\n\t\t\t$(document).find(\"input[name=sspResponse]\").val('');\r\n\t\t\t$(document).find(\"input[name=couponGroup]\").val('');\r\n\t\t\t$(\".payPrice\").html(viewPrice);\r\n\t\t\t$(\".couponPrice\").html('0');\r\n\t\t\t$(\".coupon\").hide();\r\n\t\t\t///////////////////////\r\n\t\t\t//신한카드일 경우 앱 카드결제 활성화\r\n\t\t\tif((\"14\"== $(this).val()) && $(this).parent(\"a\").hasClass(\"selected\")){\r\n\t\t\t\t$(\"#shinhanApp\").parent(\"li\").show();\r\n\t\t\t}else{\r\n\t\t\t\t$(\"#shinhanApp\").parent(\"li\").hide();\r\n\t\t\t\t$(\"#shinhanApp\").prop(\"checked\", false);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//////////////////////\r\n\t\t\t//유니마일 포인트 사용 부분 활성화\r\n\t\t\tif(jQuery(this).attr(\"cardType\") == \"isp\" && (\"11\"== $(this).val() || \"38\"== $(this).val() || \"71\"== $(this).val() || \"46\"== $(this).val() || \"47\"== $(this).val()) && $(this).parent(\"a\").hasClass(\"selected\")){\r\n\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").show();\r\n\t\t\t}else{\r\n\t\t\t\t$(\"#uniMilePoint\").parent(\"li\").hide();\r\n\t\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif(price >= installmentPrice){\r\n\t\t\t\t//할부개월 선택 select박스 노출 되기 전에 기존 선택되어 있는 결제수단 title \"\" 처리\r\n\t\t\t\t$(\".btnPaymnt\").each(function(){\r\n\t\t\t\t\t$(this).attr(\"title\",$(this).attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t\t});\r\n\t\t\t\t\r\n\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\t\t\tsetCardNoInterestText(this);\r\n\r\n\t\t\t\t//이니안심 사용가능하고, 카드리스트가 일정량보다 많을경우 할부드롭박스 css수정\r\n\t\t\t\tif($payForm.find(\"input[name=USE_KCARE]\").val() == '1'){\r\n\t\t\t\t\tif($payForm.find(\"input[name=KCARE_cardCodeEtc]\").val().split(\",\").length > 1\r\n\t\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_focusPayList]\").val().split(\",\").length ==2\r\n\t\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_payCodesBasic]\").val().split(\",\").length > 1){\r\n\t\t\t\t\t\t$(\"#cardQuotaView .dropdown dd ul\").css(\"height\", \"60px\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t//현대카드 1만원 이상 할부보이도록\r\n\t\t\t}else if( price >= 10000 && (\"04\"== $(this).val()) && $(this).parent(\"a\").hasClass(\"selected\")){\r\n\t\t\t\t//할부개월 선택 select박스 노출 되기 전에 기존 선택되어 있는 결제수단 title \"\" 처리\r\n\t\t\t\t$(\".btnPaymnt\").each(function(){\r\n\t\t\t\t\t$(this).attr(\"title\",$(this).attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t\t});\r\n\t\t\t\t\r\n\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\t\t\tsetCardNoInterestText(this);\r\n\r\n\t\t\t\t//이니안심 사용가능하고, 카드리스트가 일정량보다 많을경우 할부드롭박스 css수정\r\n\t\t\t\tif($payForm.find(\"input[name=USE_KCARE]\").val() == '1'){\r\n\t\t\t\t\tif($payForm.find(\"input[name=KCARE_cardCodeEtc]\").val().split(\",\").length > 1\r\n\t\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_focusPayList]\").val().split(\",\").length ==2\r\n\t\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_payCodesBasic]\").val().split(\",\").length > 1){\r\n\t\t\t\t\t\t$(\"#cardQuotaView .dropdown dd ul\").css(\"height\", \"60px\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\t$(\".btnPaymnt\").each(function(){\r\n\t\t\t\t\t$(this).attr(\"title\",$(this).attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t\t});\r\n\t\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t}\r\n\t\t\t \r\n\t\t\t \r\n\t\t}else{\r\n\t\t\t//USD 50달러 이상일때만 보여지도록 우선!적용\r\n\t\t\tif(price >= 5000){\r\n\t\t\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\t\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\t\t\tsetCardNoInterestText(this);\r\n\t\t\t}\r\n\t\t}\t\t\r\n\t\t\r\n\t\t//KB증권 수탁사 변경에 따른 문구 임시 노출\r\n\t\tif(\"62\"== $payForm.find(\"[name=cardCode]:checked\").val()){\r\n\t\t\tvar now = new Date();\r\n\r\n\t\t\tvar year = now.getFullYear();//   <%-- 현재시간 중 4자리 연도 --%>\r\n\t\t\tvar month = now.getMonth()+1; //  <%--현재시간 중 달. 달은 0부터 시작하기 때문에 +1 --%>\r\n\t\t\tif((month+\"\").length < 2){\r\n\t\t\t    month=\"0\"+month;//   <%--달의 숫자가 1자리면 앞에 0을 붙임. --%>\r\n\t\t\t}\r\n\t\t\tvar date = now.getDate();//      <%--현재 시간 중 날짜 --%>\r\n\t\t\tif((date+\"\").length < 2){\r\n\t\t\t    date=\"0\"+date;\r\n\t\t\t}\r\n\r\n\t\t\ttoday = year + \"\" + month + \"\" + date;\r\n\t\t\t\r\n\t\t\tif(Number(today) >= 20190402 && Number(today) < 20190414){\r\n\t\t\t\tcallAlert(\"KB증권체크카드 중 9491-05로 시작하는 카드의 경우,\\n <b>KB국민카드</b> 선택 후 결제가 가능합니다.\");\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t// 간편결제, 페이결제는 OBC적립이 노출 안되도록 설정\r\n\t\tif(\"iniPoint\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Kpay\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Ssp\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Lpay\" == $payForm.find(\"[name=cardCode]:checked\").val()) {\r\n\t\t\t$(\"#useSaveOcb\").prop(\"checked\", false);\r\n\t\t\t$(\"#useSaveOcb\").prop(\"disabled\", true);\r\n\t\t} else {\r\n\t\t\t$(\"#useSaveOcb\").prop(\"disabled\", false);\r\n\t\t}\r\n\t\t\r\n\t\t//네이버 nik 카드 viewpage 할부선택 항목 show/hide 기능\r\n\t\tif ('onlycard'  == goPayMethod && (-1 != site_id_nik.indexOf('site_id(nik)')) ) {\t//내이버 nik 카드\r\n\t\t\tcardQuotaEvt();\t//할부선택 show/hide\r\n\t\t}\r\n\t\t\r\n\t\t//spider \r\n\t\t//20160615\r\n\t\t//wcchoi \r\n\t\tvar radioValue = $(this).val();\r\n\t\tif(\"oneClick\" != radioValue){\r\n\t\t\t//get page id.\r\n\t\t\tvar page = $('#curPage').val();\r\n\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t//\t$('#'+page+'Btn').focus();\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\tjQuery(document).on(\"mousedown\",\".btnPaymnt\", function(){\r\n\t\t$(this).css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t});\r\n\t\r\n\tjQuery(document).on(\"keyup\",\".btnPaymnt\", function(e){\r\n\t\t//키보드 키\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tvar chkCardTitle = $(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"aria-label\");\r\n\t\t\r\n\t\tif (9 == keycode){\r\n\t\t\tif(e.shiftKey){\r\n\t\t\t\t//이전꺼로 돌아가는거\r\n\t\t\t\tif(!chkCardTitle.endsWith(\"선택\") || !chkCardTitle.endsWith(\"선택됨\")){\r\n\t\t\t\t\t$(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"aria-label\", chkCardTitle+\"선택\");\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\t//다음꺼로 넘어가는거\t\r\n\t\t\t\tif(!chkCardTitle.endsWith(\"선택됨\")){\r\n\t\t\t\t\t$(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"aria-label\", chkCardTitle+\"선택\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\tjQuery(document).on(\"keydown\",\".btnPaymnt\", function(e){\r\n\t\t//키보드 키\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tvar chkCardTitle = $(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"aria-label\");\r\n\t\tif (9 == keycode){\r\n\t\t\tif(e.shiftKey){\r\n\t\t\t\tif(chkCardTitle.endsWith(\"선택\")){\r\n\t\t\t\t\t$(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"aria-label\", chkCardTitle.replace(\"선택\", \"\"));\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\t//다음꺼로 넘어가는거\r\n\t\t\t\tif(chkCardTitle.endsWith(\"선택\")){\r\n\t\t\t\t\t$(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"aria-label\", chkCardTitle.replace(\"선택\", \"\"));\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 카드/페이선택시_2017.03.07_kyb\r\n\tjQuery(document).off(\"click\",\".btnPaymnt\").on(\"click\",\".btnPaymnt\", function(){\t\r\n\t\t// 카드결제와 포인트결제의 중복 스크립트 현상으로 인해 페이지 조건을 넣어줌\r\n\t\tif($(\"#curPage\").val() != \"Card\") return;\r\n\t\t\r\n\t\tif(!$(this).hasClass(\"selected\")) {\r\n\t\t\t$(\".btnPaymnt\").removeClass(\"selected\").css(\"border-color\", \"\");\r\n\t\t\t$(this).addClass(\"selected\");\t\t\t\r\n\t\t\t$(this).find(\"input:radio[name=cardCode]\").prop(\"checked\", true).trigger(\"change\");\r\n\t\t\t$(\".btnPaymnt.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t\t\tif($(\".btnPaymnt.selected\").attr(\"title\").indexOf(\"선택됨\") < 0){\r\n\t\t\t\t$(\".btnPaymnt.selected\").attr(\"title\",$(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"title\")+\"선택됨\");\r\n\t\t\t}\r\n\t\t\t// 약관체크\r\n\t\t\tif($payForm.find(\"input[name=stdEasyPayUse]\").val() == '1'){ //간편결제창\r\n\t\t\t\t// 기존 카드결제창 이용약관 동의 검증\t\r\n\t\t\t\tif($payForm.find(\"input[name=USE_KCARE]\").val() != \"\" && $payForm.find(\"input[name=PR_KCARE]\").val() != \"\"){// 이니안심 사용가능 할 경우\r\n\t\t\t\t\t// 간편결제 전용창 약관 2칸\r\n\t\t\t\t\tif(($(\"#inputChk1_2\").prop(\"checked\") && $(\"#inputChk3_2\").prop(\"checked\") && $(\"#inputChk4_2\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(($(\"#inputChk1\").prop(\"checked\") && $(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t\t}\r\n\t\t\t\t}\t\r\n\t\t\t\t\r\n\t\t\t}else{ //범용창\r\n\t\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\t\tsetCardBtnTitle($(this).attr(\"id\"));\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t$payForm.find(\"input[name=CARD_Point]\").val('0');\r\n\t\t\tif($(this).children()[0].getAttribute(\"cardtype\") != null){\r\n\t\t\t\tif($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf($(this).children()[0].value) >= 0 \r\n\t\t\t\t\t\t|| $(this).children()[0].value == '26'\r\n\t\t\t\t\t\t|| $(this).children()[0].value == 'iniPoint'){\r\n\t\t\t\t\t$(\"#chkLpoint\").parent(\"li\").hide();\r\n\t\t\t\t}else{\r\n\t\t\t\t\t$(\"#chkLpoint\").parent(\"li\").show();\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\t$(\"#chkLpoint\").parent(\"li\").hide();\r\n\t\t\t} \r\n\t\t\t\r\n\t\t\tif(Number($('[name=lpointAll]').val()) > 0){\r\n\t\t\t\t//if(this.id != $('[name=lpointCdcd]').val()){\r\n\t\t\t\t\t$(\"#chkLpointUse\").prop(\"checked\", false).trigger(\"change\");\r\n\t\t\t\t\t$(\"#lpointConfirmbtn\").trigger(\"click\");\r\n\t\t\t\t//}\r\n\t\t\t}\r\n\t\t\t$('[name=lpointCdcd]').val(this.id);\r\n\t\t\t\r\n\t\t} else {\r\n\t\t\t$(\".btnPaymnt.selected\").attr(\"title\",$(this).find(\"input:radio[name=cardCode]\").parent(\"a\").attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t$(\".btnPaymnt\").removeClass(\"selected\").css(\"border-color\", \"\");\r\n\t\t\t$(\"input:radio[name=cardCode]\").prop(\"checked\", false);\r\n\t\t\t$(\"#shinhanApp, #chkLpoint, #uniMilePoint\").parent(\"li\").hide();\r\n\t\t\t$(\"#shinhanApp\").prop(\"checked\", false);\r\n\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\tvar currency = $(\"input:hidden[name=currency]\").val();\r\n\t\t\t\r\n\t\t\tif(currency == 'WON'){\r\n\t\t\t\t\r\n\t\t\t\tvar price = '';\r\n\t\t\t\t\r\n\t\t\t\t//이니안심 사용여부 체크\r\n\t\t\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t\t\t\t\t//이니안심사용(결제요청금액 + 이니안심금액\r\n\t\t\t\t\tprice = String(Number($payForm.find(\"input[name=price]\").val()) + Number($('[name=PR_KCARE]').val())).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\t\t}else{\r\n\t\t\t\t\tprice = String($payForm.find(\"input[name=price]\").val()).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t\t\t}\r\n\r\n\t\t\t\t$(document).find(\"input[name=couponInfo]\").val('');\r\n\t\t\t\t$(document).find(\"input[name=couponGroup]\").val('');\r\n\t\t\t\t$(\".payPrice\").html(price);\r\n\t\t\t\t$(\".couponPrice\").html('0');\r\n\t\t\t\t$(\".coupon\").hide();\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t$(\".bottomBtn\").addClass(\"btnDis\");\r\n\t\t\t$(\".btnType09\").css(\"color\", \"\");\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t\t$(this).focus();\r\n\t\t}\r\n\t});\r\n\r\n\t// 카드 \"기타선택\" 클릭시\r\n\tjQuery(document).on(\"change\", \"#cardCodeEctSelect\", function() {\r\n\t\t// 카드결제와 포인트결제의 중복 스크립트 현상으로 인해 페이지 조건을 넣어줌\r\n\t\tif($(\"#curPage\").val() != \"Card\") return;\r\n\t\t\r\n\t\t//이니안심 사용 시 해외카드 불가\r\n\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t\t\tif($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf($(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html()) >= 0\r\n\t\t\t\t\t&& $(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html() != \"\"){\r\n\t\t\t\t$(\"#inputChk6\").prop(\"checked\", false);\r\n\t\t\t\tresetKcare();\r\n\t\t\t\tcallAlert(INImsg.alert_kcare_msg1);\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\tvar price = $(\"input:hidden[name=price]\").val();\r\n\t\tvar installmentPrice =$(\"input[name=installmentPrice]\").val();\r\n\t\tprice = Number(price);\r\n\t\tinstallmentPrice = Number(installmentPrice);\r\n\t\t\r\n\t\tjQuery(\"#spanSelectPayCode .dropdown dt\").html($(\"#spanSelectPayCode .dropdown dd ul li:eq(0)\").html());\r\n\t\tjQuery(\"#payCodeEct\").val(\"\");\r\n\t\t\r\n\t\tif (!boolMobile) {\r\n\t\t\tjQuery(\"#cardCodeEct\").val($(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html());\r\n\t\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\",\t$(\"#spanSelectCardCode .dropdown\").find(\"dt a\").attr(\"cardType\"));\r\n\t\t\tjQuery(\"#cardCodeEct\").prop(\"checked\", true);\r\n\t\t}\r\n\t\t\r\n\t\tif(price >= installmentPrice){\r\n\t\t\tsetCardNoInterestText(jQuery(\"#cardCodeEct\"));\r\n\t\t\t\r\n\t\t\t//할부개월 선택 select박스 노출 되기 전에 기존 선택되어 있는 결제수단 title \"\" 처리\r\n\t\t\t$(\".btnPaymnt\").each(function(){\r\n\t\t\t\t$(this).attr(\"title\",$(this).attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\t//이니안심 사용가능하고, 카드리스트가 일정량보다 많을경우 할부드롭박스 css수정\r\n\t\t\tif($payForm.find(\"input[name=USE_KCARE]\").val() == '1'){\r\n\t\t\t\tif($payForm.find(\"input[name=KCARE_cardCodeEtc]\").val().split(\",\").length > 1\r\n\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_focusPayList]\").val().split(\",\").length ==2\r\n\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_payCodesBasic]\").val().split(\",\").length > 1){\r\n\t\t\t\t\t$(\"#cardQuotaView .dropdown dd ul\").css(\"height\", \"60px\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t//현대카드 1만원 이상 할부보이도록\r\n\t\t}else if( price >= 10000 && \"04\"== $payForm.find(\"[name=cardCode]:checked\").val()){\r\n\t\t\tsetCardNoInterestText(jQuery(\"#cardCodeEct\"));\r\n\r\n\t\t\t//할부개월 선택 select박스 노출 되기 전에 기존 선택되어 있는 결제수단 title \"\" 처리\r\n\t\t\t$(\".btnPaymnt\").each(function(){\r\n\t\t\t\t$(this).attr(\"title\",$(this).attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\t//이니안심 사용가능하고, 카드리스트가 일정량보다 많을경우 할부드롭박스 css수정\r\n\t\t\tif($payForm.find(\"input[name=USE_KCARE]\").val() == '1'){\r\n\t\t\t\tif($payForm.find(\"input[name=KCARE_cardCodeEtc]\").val().split(\",\").length > 1\r\n\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_focusPayList]\").val().split(\",\").length ==2\r\n\t\t\t\t\t\t&& $payForm.find(\"input[name=KCARE_payCodesBasic]\").val().split(\",\").length > 1){\r\n\t\t\t\t\t$(\"#cardQuotaView .dropdown dd ul\").css(\"height\", \"60px\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\t//그외카드 제외 한 카드 선택 후 남아있는 선택됨 replace\r\n\t\t\t$(\".btnPaymnt\").each(function(){\r\n\t\t\t\t$(this).attr(\"title\",$(this).attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t});\r\n\t\t\t\r\n\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t}\r\n\t\t\r\n\t\t///////체크값 초기화 하고 나가기!\r\n\t\tvar currency_usd = $(\"input:hidden[name=currency]\").val();\r\n\t\t\r\n\t\tvar currency = '';\r\n\t\t//이니안심 사용여부 체크\r\n\t\tif($(\"#inputChk6\").prop(\"checked\")){\r\n\t\t\t//이니안심사용(결제요청금액 + 이니안심금액\r\n\t\t\tcurrency = String(Number($payForm.find(\"input[name=price]\").val()) + Number($('[name=PR_KCARE]').val())).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t}else{\r\n\t\t\tcurrency = String($payForm.find(\"input[name=price]\").val()).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t}\r\n\t\t\t\t\r\n\t\t$payForm.find(\"input[name=CARD_Point]\").val('0');\r\n\t\t$(document).find(\"input[name=couponInfo]\").val('');\r\n\t\t$(document).find(\"input[name=couponGroup]\").val('');\r\n\t\t\r\n\t\tif(currency_usd != \"USD\"){\r\n\t\t\t$(\".payPrice\").html(currency);\t\t\r\n\t\t\t$(\".couponPrice\").html('0');\r\n\t\t\t$(\".coupon\").hide();\r\n\t\t}\r\n\t\t///////////////////////\r\n\t\t//신한카드일 경우 앱 카드결제 활성화\r\n\t\tif(\"14\"== $payForm.find(\"[name=cardCode]:checked\").val()){\r\n\t\t\t$(\"#shinhanApp\").parent(\"li\").show();\r\n\t\t}else{\r\n\t\t\t$(\"#shinhanApp\").parent(\"li\").hide();\r\n\t\t\t$(\"#shinhanApp\").prop(\"checked\", false);\r\n\t\t}\r\n\t\t//////////////////////\r\n\t\t//유니마일 포인트 사용 부분 활성화\r\n\t\tif($('#cardCodeEct').attr(\"cardType\") == \"isp\" && (\"11\"== $payForm.find(\"[name=cardCode]:checked\").val() || \"38\"== $payForm.find(\"[name=cardCode]:checked\").val() \r\n\t\t\t\t|| \"71\"== $payForm.find(\"[name=cardCode]:checked\").val() || \"46\"== $payForm.find(\"[name=cardCode]:checked\").val() || \"47\"== $payForm.find(\"[name=cardCode]:checked\").val())){\r\n\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t\t$(\"#uniMilePoint\").parent(\"li\").show();\r\n\t\t}else{\r\n\t\t\t$(\"#uniMilePoint\").parent(\"li\").hide();\r\n\t\t\t$(\"#uniMilePoint\").prop(\"checked\", false);\r\n\t\t}\r\n\t\t\r\n\t\t//해외카드일 경우 LPOINT 감춤\r\n\t\tif($payForm.find(\"input[name=cardCodesNormal]\").val().indexOf($payForm.find(\"[name=cardCode]:checked\").val()) >= 0 \r\n\t\t\t\t|| $payForm.find(\"[name=cardCode]:checked\").val() == '26'\r\n\t\t\t\t|| $payForm.find(\"[name=cardCode]:checked\").val() == 'iniPoint'){\r\n\t\t\t$(\"#chkLpoint\").parent(\"li\").hide();\r\n\t\t}else{\r\n\t\t\t$(\"#chkLpoint\").parent(\"li\").show();\r\n\t\t}\r\n\t\tif(Number($('[name=lpointAll]').val()) > 0){\r\n\t\t\t$(\"#chkLpointUse\").prop(\"checked\", false).trigger(\"change\");\r\n\t\t\t$(\"#lpointConfirmbtn\").trigger(\"click\");\r\n\t\t}\r\n\t\t$('[name=lpointCdcd]').val(this.id);\r\n\t\t\r\n\t\t//KB증권 수탁사 변경에 따른 문구 임시 노출\r\n\t\tif(\"62\"== $payForm.find(\"[name=cardCode]:checked\").val()){\r\n\t\t\tvar now = new Date();\r\n\r\n\t\t\tvar year = now.getFullYear();//   <%-- 현재시간 중 4자리 연도 --%>\r\n\t\t\tvar month = now.getMonth()+1; //  <%--현재시간 중 달. 달은 0부터 시작하기 때문에 +1 --%>\r\n\t\t\tif((month+\"\").length < 2){\r\n\t\t\t    month=\"0\"+month;//   <%--달의 숫자가 1자리면 앞에 0을 붙임. --%>\r\n\t\t\t}\r\n\t\t\tvar date = now.getDate();//      <%--현재 시간 중 날짜 --%>\r\n\t\t\tif((date+\"\").length < 2){\r\n\t\t\t    date=\"0\"+date;\r\n\t\t\t}\r\n\r\n\t\t\ttoday = year + \"\" + month + \"\" + date;\r\n\t\t\t\r\n\t\t\tif(Number(today) >= 20190402 && Number(today) < 20190414){\r\n\t\t\t\tcallAlert(\"KB증권체크카드 중 9491-05로 시작하는 카드의 경우,\\n <b>KB국민카드</b> 선택 후 결제가 가능합니다.\");\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t// 간편결제, 페이결제는 OBC적립이 노출 안되도록 설정\r\n\t\tif(\"iniPoint\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Kpay\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Ssp\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Lpay\" == $payForm.find(\"[name=cardCode]:checked\").val()) {\r\n\t\t\t$(\"#useSaveOcb\").prop(\"checked\", false);\r\n\t\t\t$(\"#useSaveOcb\").prop(\"disabled\", true);\r\n\t\t} else {\r\n\t\t\t$(\"#useSaveOcb\").prop(\"disabled\", false);\r\n\t\t}\r\n\t\t\r\n\t\tjQuery(\"#title\").show();\r\n\t\tjQuery(\"#useCoupon_title\").hide();\r\n\t\tjQuery(\"#notCoupon_title\").hide();\r\n\t\tjQuery(window).trigger(\"resize\");\r\n\r\n\t\t//네이버 nik 카드 viewpage 할부선택 항목 show/hide 기능\r\n\t\tif ('onlycard'  == goPayMethod && (-1 != site_id_nik.indexOf('site_id(nik)')) ) {\t//내이버 nik 카드\r\n\t\t\tcardQuotaEvt();\t//할부선택 show/hide\r\n\t\t}\r\n\t\t\r\n\t\t$(\".btnPaymnt\").removeClass(\"selected\").css(\"border-color\", \"\");\r\n\t\t\r\n\t\tif($(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html() == '') {\r\n\t\t\t$(\"#spanSelectCardCode .dropdown dt a\").removeClass(\"selected\");\r\n\t\t\t\r\n\t\t\t$(\"#spanSelectCardCode .dropdown dt a\").attr(\"title\", $(\"#spanSelectCardCode .dropdown dt a\").attr(\"title\").replace(\"선택됨\",\"\"));\r\n\t\t\t\r\n\t\t\t$(\".bottomBtn\").addClass(\"btnDis\");\r\n\t\t\t$(\".btnType09\").css(\"color\", \"\");\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t\t$(\"#spanSelectCardCode .dropdown dt\").focus();\r\n\t\t} else {\r\n\t\t\t$(\"#spanSelectCardCode .dropdown dt a\").addClass(\"selected\");\r\n\t\t\t$(\"#spanSelectCardCode .dropdown dt a.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\r\n\t\t\t$(\"#spanSelectCardCode .dropdown dt a.selected\").attr(\"title\", $(\"#spanSelectCardCode .dropdown dt a.selected\").attr(\"title\")+\" 선택됨\");\r\n\t\t\t\r\n\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\tsetCardBtnTitle($(this).attr(\"id\"));\r\n\t\t\t\t//spider 20160615\r\n\t\t\t\t//wcchoi \r\n\t\t\t\t//DESC : 다음버튼으로 포커스 이동.\r\n\t\t\t\t//get page id.\r\n//\t\t\t\tvar page = $('#curPage').val();\r\n//\t\t\t\t$('#'+page+'Btn').focus();\r\n\t\t\t} else {\r\n\t\t\t\t$(\"#spanSelectCardCode .dropdown dt a span\").focus();\t\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\treturn true;\r\n\t});\r\n\t//wcchoi\r\n\t//2016.06.27\r\n\t//DESC: cardCodeEctSelect에서 탭키를 눌렀을때 이벤트.\r\n\t$(document).on(\"keydown\", \"#cardCodeEctSelect\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode){\r\n\t\t\te.stopPropagation();\r\n//\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\t//focus oneClick.\r\n\t\t\tvar oneClick=$(\"#oneClick\");\r\n\t    \tsetTimeout(function() {\r\n\t    \t\toneClick.focus(); \r\n\t        }, 100);\r\n\t\t}\r\n\t});\r\n\t\r\n\t// pay \"그외결제\" 선택시\r\n\tjQuery(document).on(\"change\", \"#payCodeEctSelect\", function() {\r\n\t\tvar price = $(\"input:hidden[name=price]\").val();\r\n\t\tvar installmentPrice =$(\"input[name=installmentPrice]\").val();\r\n\t\tprice = Number(price);\r\n\t\tinstallmentPrice = Number(installmentPrice);\r\n\t\tjQuery(\"#spanSelectCardCode .dropdown dt\").html($(\"#spanSelectCardCode .dropdown dd ul li:eq(0)\").html());\r\n\t\tjQuery(\"#cardCodeEct\").val(\"\");\r\n\t\tjQuery(\"#cardCodeEct\").attr(\"cardType\", \"\");\r\n\t\tif (!boolMobile) {\r\n\t\t\tjQuery(\"#payCodeEct\").val($(\"#spanSelectPayCode .dropdown\").find(\"dt a span.value\").html());\r\n\t\t\tjQuery(\"#payCodeEct\").prop(\"checked\", true);\r\n\t\t}\r\n\t\tif(price >= installmentPrice){\r\n\t\t\tsetCardNoInterestText(jQuery(\"#payCodeEct\"));\r\n\t\t}else{\r\n\t\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t}\r\n\t\t\r\n\t\t///////체크값 초기화 하고 나가기!\r\n\t\tvar currency = String($payForm.find(\"input[name=price]\").val()).replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');\r\n\t\t$(document).find(\"input[name=couponInfo]\").val('');\r\n\t\t$(document).find(\"input[name=couponGroup]\").val('');\r\n\t\t$(\".payPrice\").html(currency);\r\n\t\t$(\".couponPrice\").html('0');\r\n\t\t$(\".coupon\").hide();\r\n\t\t///////////////////////\r\n\t\t\r\n\t\t// 간편결제, 페이결제는 OBC적립이 노출 안되도록 설정\r\n\t\tif(\"iniPoint\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Kpay\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Ssp\" == $payForm.find(\"[name=cardCode]:checked\").val() || \"Lpay\" == $payForm.find(\"[name=cardCode]:checked\").val()) {\r\n\t\t\t$(\"#useSaveOcb\").prop(\"checked\", false);\r\n\t\t\t$(\"#useSaveOcb\").prop(\"disabled\", true);\r\n\t\t} else {\r\n\t\t\t$(\"#useSaveOcb\").prop(\"disabled\", false);\r\n\t\t}\r\n\t\t$payForm.find(\"input[name=CARD_Point]\").val('0');\r\n\t\tjQuery(\"#title\").show();\r\n\t\tjQuery(\"#useCoupon_title\").hide();\r\n\t\tjQuery(\"#notCoupon_title\").hide();\r\n\t\tjQuery(window).trigger(\"resize\");\r\n\t\t\r\n\t\t$(\".btnPaymnt\").removeClass(\"selected\").css(\"border-color\", \"\");\r\n\t\t\r\n\t\tif($(\"#spanSelectPayCode .dropdown\").find(\"dt a span.value\").html() == '') {\r\n\t\t\t$(\"#spanSelectPayCode .dropdown dt a\").removeClass(\"selected\");\r\n\t\t\t$(\".bottomBtn\").addClass(\"btnDis\");\r\n\t\t\t$(\".btnType09\").css(\"color\", \"\");\r\n\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t\t$(\"#spanSelectPayCode .dropdown dt\").focus();\r\n\t\t} else {\r\n\t\t\t$(\"#spanSelectPayCode .dropdown dt a\").addClass(\"selected\");\r\n\t\t\t$(\"#spanSelectPayCode .dropdown dt a.selected\").css(\"border-color\", $(\"input[name=colorView]\").val());\r\n\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) || isAssentChk) {\r\n\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\tsetCardBtnTitle($(this).attr(\"id\"));\r\n\t\t\t\t//spider 20160615\r\n\t\t\t\t//wcchoi \r\n\t\t\t\t//DESC : 다음버튼으로 포커스 이동.\r\n\t\t\t\t//get page id.\r\n//\t\t\t\tvar page = $('#curPage').val();\r\n//\t\t\t\t$('#'+page+'Btn').focus();\r\n\t\t\t} else {\r\n\t\t\t\t$(\"#spanSelectPayCode .dropdown dt\").focus();\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\treturn true;\r\n\t});\r\n\t\r\n\t//원클릭 선택시\r\n\tjQuery(document).on(\"change\", \"#oneClickSelect\", function() {\r\n\t\tjQuery(\"#cardQuotaView\").hide();\r\n\t\t$(\"#shinhanApp\").parent(\"li\").hide();\r\n\t\t$(\"#shinhanApp\").prop(\"checked\", false);\r\n\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\tjQuery(\"#oneClick\").val(jQuery(this).val());\r\n\t\tjQuery(\"#oneClick\").prop(\"checked\", true);\r\n\t\t\r\n\t\t//wcchoi spider\r\n\t\t//2016.06.15\r\n\t\t//DESC : 포커스를 현재페이지의 다음버튼으로 이동.\r\n\t\t//get page id.\r\n//\t\tvar page = $('#curPage').val();\r\n//\t\t$('#'+page+'Btn').focus();\r\n\t});\r\n\t\r\n\t// 앱카드에서 엔터를 클릭했을경우\r\n\tjQuery(document).on(\"keydown\", \"#shinhanApp\", function(e) {\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\r\n\t\t\tif($(this).prop(\"checked\")){\r\n\t\t\t\t$(this).prop(\"checked\",false);\r\n\t\t\t}else{\r\n\t\t\t\t$(this).prop(\"checked\",true);\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 유니마일포인트 check event\r\n\tjQuery(document).on(\"click\", \"#uniMilePoint\", function(e) {\r\n\t\tif($(this).prop(\"checked\")){\r\n\t\t\t$('#uniMilePoint').prop(\"checked\",true);\r\n\t\t\t$('#UniMilePointPopup').removeClass(\"hide\"); \r\n\t\t\tjQuery(\"#overlay_subPopup\").show();\r\n\t\t\tjQuery(\"#overlay_popup_bg\").show();\r\n\t\t\t$(\"#inputFocusUniMilePointPopup\").focus(); \r\n\t\t}else{\r\n\t\t\t$('#uniMilePoint').prop(\"checked\",false);\r\n\t\t\t\r\n\t\t}\r\n\t});\r\n\t\r\n\t// 유니마일포인트 check event\r\n\tjQuery(document).on(\"keydown\", \"#uniMilePoint\", function(e) {\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t\r\n\t\t\tif($(this).prop(\"checked\")){\r\n\t\t\t\t$('#uniMilePoint').prop(\"checked\",false);\r\n\t\t\t}else{\r\n\t\t\t\t$('#uniMilePoint').prop(\"checked\",true);\r\n\t\t\t\t$('#UniMilePointPopup').removeClass(\"hide\"); \r\n\t\t\t\tjQuery(\"#overlay_subPopup\").show();\r\n\t\t\t\tjQuery(\"#overlay_popup_bg\").show();\r\n\t\t\t\t$(\"#inputFocusUniMilePointPopup\").focus(); \r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t});\r\n\r\n\t\r\n\t/**********************/\r\n\t//Lpoint Popup Event\r\n\t/**********************/\r\n\t\r\n\t//결제창 내 Lpoint checkbox 클릭 이벤트\r\n\tjQuery(document).on(\"click keydown\", \"#chkLpoint\", function(e) {\r\n\t\tinputClear();\r\n\r\n\t\tvar isChk = $(\"#chkLpoint\").is(\":checked\"); //결제창 내 Lpoint 선택 여부\r\n\t\tvar isDchk = $payForm.find(\"input[name=LpointChk]\").val() ? true : false; //Lpoint 다이렉트 호출 여부\r\n\t\tvar strLpointOpt = \"\";\r\n\t\t\r\n\t\tif(isChk || isDchk){\r\n\t\t\tvar strAcceptMethod = $payForm.find(\"input[name=acceptmethod]\").val();\r\n\t\t\tvar beginIndex = \"\";\r\n\t\t\tvar temp = \"\";\r\n\t\t\tvar endIndex = \"\";\r\n\t\t\tvar strLpointCi = \"\";\r\n\t\t\t\r\n\t\t\t//LpointOpt, ci 인입\r\n\t\t\tif(strAcceptMethod.indexOf(\"LpointOpt(\") > -1 && strAcceptMethod.indexOf(\"ci(\") > -1) {\r\n\t\t\t\t//lpoint 옵션 값 가져오는거\r\n\t\t\t\tbeginIndex = strAcceptMethod.indexOf(\"LpointOpt(\");\r\n\t\t\t\ttemp = strAcceptMethod.substring(beginIndex+10, strAcceptMethod.length);\r\n\t\t\t\tendIndex = temp.indexOf(\")\");\r\n\t\t\t\tstrLpointOpt = temp.substring(0, endIndex);\r\n\t\t\t\t\r\n\t\t\t\t//ci 값 가져오기\r\n\t\t\t\tif(strLpointOpt != \"\"){\r\n\t\t\t\t\tbeginIndex = \"\";\r\n\t\t\t\t\tendIndex = \"\";\r\n\t\t\t\t\ttemp = \"\";\r\n\t\t\t\t\t\r\n\t\t\t\t\tbeginIndex = strAcceptMethod.indexOf(\"ci(\");\r\n\t\t\t\t\ttemp = strAcceptMethod.substring(beginIndex+3, strAcceptMethod.length);\r\n\t\t\t\t\tendIndex = temp.indexOf(\")\");\r\n\t\t\t\t\tstrLpointCi = temp.substring(0, endIndex);\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t//ci, lpointopt 담기\r\n\t\t\t\t$payForm.find(\"input[name=LpointOpt]\").remove();\r\n\t\t\t\t$payForm.find(\"input[name=LpointCi]\").remove();\r\n\t\t\t\t\t\r\n\t\t\t\t$payForm.append(\"<input type='hidden' name='LpointOpt' />\");\r\n\t\t\t\t$payForm.append(\"<input type='hidden' name='LpointCi' />\");\r\n\t\t\t\t\r\n\t\t\t\t$payForm.find(\"input[name=LpointOpt]\").val(strLpointOpt);\r\n\t\t\t\t$payForm.find(\"input[name=LpointCi]\").val(strLpointCi);\r\n\t\t\t}else{\r\n\t\t\t\tstrLpointOpt = 1;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif($('[name=couponInfo]').val().length > 0){\r\n\t\t\t\t\r\n\t\t\t\tcallAlert(INImsg.alert_point_msg8);//LPOINT와 쿠폰은 함께 사용할 수 없습니다.\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//이니안심 선택 후 lpoint 사용불가\r\n\t\t\tif($(\"#inputChk6\").prop(\"checked\")) {\r\n\t\t\t\tcallAlert(INImsg.alert_kcare_msg8);\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\r\n\t\t\tif(strLpointOpt == \"1\"){\r\n\t\t\t\t//카드번호 인증\r\n\t\t\t\t\r\n\t\t\t\t//인증방식 radio hide\r\n\t\t\t\t$(\".lpoint_type\").hide();\r\n\t\t\t\t\r\n\t\t\t\topenLpointPop();\r\n\t\t\t}else if(strLpointOpt == \"2\"){\r\n\t\t\t\t//CI 인증\r\n\t\t\t\t\r\n\t\t\t\t//인증방식 radio hide\r\n\t\t\t\t$(\".lpoint_type\").hide();\r\n\t\t\t\t\r\n\t\t\t\tshowLoading();\t\r\n\t\t\t\t\r\n\t\t\t\tvalidationCi(strLpointOpt);\r\n\t\t\t}else{\r\n\t\t\t\t//CI or 카드번호 인증\r\n\t\t\t\t\r\n\t\t\t\t//인증방식 radio show\r\n\t\t\t\t$(\".lpoint_type\").show();\r\n\t\t\t\t\r\n\t\t\t\t//카드번호 default 설정\r\n\t\t\t\t$(\"#lpointType2\").prop(\"checked\" ,true);\r\n\t\t\t\t\r\n\t\t\t\tif(!jQuery(\"#lpCardSelect\").is(\":visible\")){\r\n\t\t\t\t\t$(\"#lpCardSelect\").show();\r\n\t\t\t\t}\r\n\t\t\t\r\n\t\t\t\topenLpointPop();\r\n\t\t\t}\r\n\t\t\t\r\n\t\t}\r\n\t});\t\r\n\r\n\r\n\tfunction validationCi(opt) {\r\n\t\t//Direct 여부 확인 값\r\n\t\tvar strChk = $payForm.find(\"input[name=LpointChk]\").val();\r\n\t\t\r\n\t\tjQuery.ajax({\r\n\t\t\tasyn : true\r\n\t\t\t, url:'/jsApi/lpoint/checkLpointCi'\r\n\t\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t\t, type : \"POST\"\r\n\t\t\t, dataType:\"json\"\r\n\t\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t\t\tif(jsonData.resultCode == '0000'){ \r\n\t\t\t\t\t\t// 정상 통신\r\n\t\t\r\n\t\t\t\t\t\t//ci 정상 검증 되었으면 customerNo 응답 받음\t\r\n\t\t\t\t\t\t$payForm.find(\"input[name=LpointCustomerNo]\").remove();\r\n\t\t\t\t\t\t$payForm.find(\"input[name=LpointFlag]\").remove();\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t$payForm.append(\"<input type='hidden' name='LpointCustomerNo' />\");\r\n\t\t\t\t\t\t$payForm.append(\"<input type='hidden' name='LpointFlag'/>\");\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t$payForm.find(\"input[name=LpointCustomerNo]\").val(jsonData.customerNo);\r\n\t\t\t\t\t\t$payForm.find(\"input[name=LpointFlag]\").val(\"customer\");\r\n\t\t\t\r\n\t\t\t\t\t\tif(strChk != null) {\r\n\t\t\t\t\t\t\t//해당 필드에 값이 있으면 direct 방식으로 호출했다라는 의미\r\n\t\t\t\t\t\t\t//카드번호 input hide\r\n\t\t\t\t\t\t\t$(\"#dlpCardSelect\").hide();\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t//카드번호 input hide\r\n\t\t\t\t\t\t\t$(\"#lpCardSelect\").hide();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tif(opt ==\"3\"){\r\n\t\t\t\t\t\t\t//포인트 방식 section show\r\n\t\t\t\t\t\t\t$(\".lpoint_type\").show(); \r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\topenLpointPop();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tcallAlert(\"[본인정보 확인 실패(CI 암복호화 오류)]\"+\"<br>\"+\"자세한 사항은 상점에 문의 바랍니다.\", function(){\r\n\t\t\t\t\t\t\t//opt 3번인 경우 실패하면 카드번호 인증방식으로 전환해주기\r\n\t\t\t\t\t\t\tif(opt == \"3\"){\r\n\t\t\t\t\t\t\t\tif(strChk != null) {\r\n\t\t\t\t\t\t\t\t\t//direct 방식\r\n\t\t\t\t\t\t\t\t\tdirectInputClear();\r\n\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t//카드번호 radion btn checked\r\n\t\t\t\t\t\t\t\t\t$(\"#dlpointType2\").prop(\"checked\" ,true);\r\n\t\t\t\t\t\t\t\t\t//카드번호 tr show\r\n\t\t\t\t\t\t\t\t\t$(\"#dlpCardSelect\").show();\r\n\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\t//범용창 방식\r\n\t\t\t\t\t\t\t\t\tinputClear();\r\n\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t//카드번호 radion btn checked\r\n\t\t\t\t\t\t\t\t\t$(\"#lpointType2\").prop(\"checked\" ,true);\r\n\t\t\t\t\t\t\t\t\t//카드번호 tr show\r\n\t\t\t\t\t\t\t\t\t$(\"#lpCardSelect\").show();\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tif(strChk != null){\r\n\t\t\t\t\t\t\t\t\t//2번 인데 ci 검증 실패하면 팝업 닫기\r\n\t\t\t\t\t\t\t\t\toverlayPopupOnOff(false);\r\n\t\t\t\t\t\t\t\t\tclosePopupUrl();\r\n\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\t$('#chkLpoint').prop(\"checked\",false);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\t\t\talert(\"[Connection Failure]\"+jsonData.resultMsg);\t\r\n\t\t\t\t\t\r\n\t\t\t\t\thideLoading();\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(strChk != null){\r\n\t\t\t\t\t\toverlayPopupOnOff(false);\r\n\t\t\t\t\t\tclosePopupUrl();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t$('#chkLpoint').prop(\"checked\",false);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t, complete:function(jqXHR,status){\r\n\t\t\t\t\thideLoading();\r\n\t\t\t\t}\r\n\t\t});\r\n\t}\r\n\t\r\n\t\r\n\tfunction openLpointPop(){\r\n\t\t$('#chkLPointAll').prop(\"checked\",false);\r\n\r\n\t\t//비밀번호 tr\r\n\t\t$('#lpPlSelectSect').show();\r\n\t\t\r\n\t\t//비밀번호 설정/재설정 div\r\n\t\t$('#lpPlLinkSect').show();\r\n\t\t\r\n\t\t//가용금액/사용금액 div\r\n\t\t$('#lpPlPointSect').hide();\r\n\r\n\t\t$(\"#chkLpointUse\").prop(\"checked\", true);\r\n\t\t//div lpointpopup show\r\n\t\t$('#lpointPopup').removeClass(\"hide\"); \r\n\r\n\t\tjQuery(\"#overlay_subPopup\").show();\r\n\t\tjQuery(\"#overlay_popup_bg\").show();\r\n\r\n\t}\r\n\t\r\n\t//Lpoint 범용창 팝업 포인트번호 정보 확인 버튼 이벤트\r\n\tjQuery(document).on(\"click\", \"#lpointType1\", function(){\r\n\t\tinputClear();\r\n\r\n\t\t//카드번호 입력 tr hide\r\n\t\t$(\"#lpCardSelect\").hide();\r\n\t\r\n\t\tif(jQuery(\"#lpPlPointSect\").is(\":visible\")){\r\n\t\t\tjQuery(\"#lpPlPointSect\").hide();\r\n\t\t}\r\n\t\t\r\n\t\tvar LpointOpt = $payForm.find(\"input[name=LpointOpt]\").val();\r\n\t\r\n\t\tshowLoading();\t\r\n\t\t\r\n\t\t//ci 인증\r\n\t\tvalidationCi(LpointOpt);\r\n\t\t\r\n\t});\r\n\t\r\n\t//Lpoint 범용창 팝업 포인트번호 직접 입력 버튼 이벤트\r\n\tjQuery(document).on(\"click\", \"#lpointType2\", function(){\r\n\t\t//CI 인증 후 카드번호 인증 진행할 수 있는 케이스 존재로 CI 인증 데이터 존재하면 remove\r\n\t\tif($payForm.find(\"input[name=LpointFlag]\").val() != null && $payForm.find(\"input[name=LpointCustomerNo]\").val() != null) {\r\n\t\t\t$payForm.find(\"input[name=LpointFlag]\").remove();\r\n\t\t\t$payForm.find(\"input[name=LpointCustomerNo]\").remove();\r\n\t\t\t\r\n\t\t}\r\n\r\n\t\tinputClear();\r\n\t\t\r\n\t\t//카드번호 입력 tr show\r\n\t\t$(\"#lpCardSelect\").show();\r\n\t\t\r\n\t\tif(jQuery(\"#lpPlPointSect\").is(\":visible\")){\r\n\t\t\tjQuery(\"#lpPlPointSect\").hide();\r\n\t\t}\r\n\t\t\r\n\t});\r\n\t\r\n\t//Lpoint 다이렉트 팝업 포인트번호 정보 확인 버튼 이벤트\r\n\tjQuery(document).on(\"click\", \"#dlpointType1\", function(){\r\n\t\tdirectInputClear();\r\n\t\t\r\n\t\t//카드번호 입력 tr hide\r\n\t\t$(\"#dlpCardSelect\").hide();\t\t\t\r\n\t\t\r\n\t\tvar LpointOpt = $payForm.find(\"input[name=LpointOpt]\").val();\r\n\r\n\t\tshowLoading();\r\n\t\t\r\n\t\tvalidationCi(LpointOpt);\r\n\t});\r\n\r\n\t//다이렉트 엘포인트 팝업 포인트번호 직접 입력 버튼 이벤트\r\n\tjQuery(document).on(\"click\", \"#dlpointType2\", function(){\t\r\n\t\t//CI 인증 후 카드번호 인증 진행할 수 있는 케이스 존재로 CI 인증 데이터 존재하면 remove\r\n\t\tif($payForm.find(\"input[name=LpointFlag]\").val() != null && $payForm.find(\"input[name=LpointCustomerNo]\").val() != null) {\r\n\t\t\t$payForm.find(\"input[name=LpointFlag]\").remove();\r\n\t\t\t$payForm.find(\"input[name=LpointCustomerNo]\").remove();\r\n\t\t}\r\n\t\t\r\n\t\tdirectInputClear();\r\n\t\t\r\n\t\t//카드번호 입력 tr show\r\n\t\t$(\"#dlpCardSelect\").show();\r\n\t\t\r\n\t\tif(jQuery(\"#lpPlPointSect\").is(\":visible\")){\r\n\t\t\tjQuery(\"#lpPlPointSect\").hide();\r\n\t\t}\r\n\t});\r\n\r\n\t//Lpoint 범용창 팝업 input clear\r\n\tfunction inputClear(){\r\n\t\t//카드번호 inputbox\r\n\t\t$(\"#lCardNo1,#lCardNo2,#lCardNo3,#lCardNo4\").val(\"\");\r\n\t\t\r\n\t\t//비밀번호 inputbox\r\n\t\t$(\"#lCardPw\").val(\"\");\r\n\t\t\r\n\t\t//가용금액\r\n\t\t$('#possLPoint').text('');\r\n\t\t\r\n\t}\r\n\t\r\n\t//Lpoint 다이렉트 팝업 input clear\r\n\tfunction directInputClear(){\r\n\t\t//카드번호 inputbox\r\n\t\t$(\"#lDCardNo1,#lDCardNo2,#lDCardNo3,#lDCardNo4\").val(\"\");\r\n\t\t\r\n\t\t//비밀번호 inputbox\r\n\t\t$(\"#lDCardPw\").val(\"\");\r\n\t\t\r\n\t\t//가용금액\r\n\t\t$(\"#possLDPoint\").text('');\r\n\t}\r\n\t\r\n\t//Lpoint 범용창 포인트 조회 이벤트\r\n\tjQuery(document).on(\"click\",\"#chkPointBtn\",function(){\r\n\r\n\t\t//CI 인증한 경우\r\n\t\tvar LpointFlag = $payForm.find(\"input[name=LpointFlag]\").val();\r\n\t\t\r\n\t\tif(LpointFlag == \"\" || LpointFlag == undefined) {\r\n\t\t\t//카드번호 입력체크\r\n\t\t\tif($('#lCardNo1').val().length < 4 || $('#lCardNo2').val().length < 4 || $('#lCardNo3').val().length < 4 || $('#lCardNo4').val().length < 4){\r\n\t\t\t\t\r\n\t\t\t\tcallAlert(INImsg.alert_card_msg3);//카드번호를 입력하세요\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t//비밀번호 입력체크\r\n\t\tif($('#lCardPw').val().length < 1 ){\r\n\t\t\tcallAlert(INImsg.alert_point_msg2);//alert_point_msg2\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t\tshowLoading();\t\r\n\r\n\t\tjQuery.ajax({\r\n\t\t\tasyn : true\r\n\t\t\t, url:'/jsApi/lpoint/checkLpoint'\r\n\t\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t\t, type : \"POST\"\r\n\t\t\t, dataType:\"json\"\r\n\t\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t\tvar code = jsonData['resultcode']; \r\n\t\t\t\t\tif(jsonData.resultcode == '0000'){ // 정상 통신\r\n\r\n\t\t\t\t\t\t//hidden으로 암호화 reqdata를 저장한다.\r\n\t\t\t\t\t\t//hidden으로 가용포인트를 저장한다.\r\n\t\t\t\t\t\t$('#lpointAll').val(jsonData.point);\r\n\t\t\t\t\t\t$('#cryptLpInfo').val(jsonData.cryptLpInfo);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t$('#possLPoint').text(jsonData.point + 'p');\r\n\t\t\t\t\t\t$('#usePoint').val(0);\r\n\t\t\t\t\t\t$('#lpPlLinkSect').hide();\r\n\t\t\t\t\t\t$('#lpPlPointSect').show();\r\n\t\t\t\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tcallAlert(\"[Failure]\"+jsonData.resultmsg);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\t\t\talert(\"[Connection Failure]\"+errorThrown);\r\n\t\t\t\t\t//var closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t//location.href = closeUrl;\r\n\t\t\t\t}\r\n\t\t\t, complete:function(jqXHR,status){\r\n\t\t\t\t\thideLoading();\r\n\t\t\t\t}\r\n\t\t});\r\n\t});\r\n\t\r\n\t\r\n\t//Lpoint 다이렉트 포인트 조회 이벤트\r\n\tjQuery(document).on(\"click\",\"#chkLpointBtn\",function(){\r\n\t\t\r\n\t\t//CI 인증한 경우\r\n\t\tvar LpointFlag = $payForm.find(\"input[name=LpointFlag]\").val();\r\n\t\t\t\r\n\t\tif(LpointFlag == \"\" || LpointFlag == undefined){\r\n\t\t\t//카드번호 입력체크\r\n\t\t\tif($('#lDCardNo1').val().length < 4 || $('#lDCardNo2').val().length < 4 || $('#lDCardNo3').val().length < 4 || $('#lDCardNo4').val().length < 4){\r\n\t\t\t\t\r\n\t\t\t\tcallAlert(INImsg.alert_card_msg3);//카드번호를 입력하세요\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t//비밀번호 입력체크\r\n\t\tif($('#lDCardPw').val().length < 1 ){\r\n\t\t\tcallAlert(INImsg.alert_point_msg2);//alert_point_msg2\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t\t$(\"[lpoint_values='true']\").remove();\r\n\t\t\t\t\r\n\t\t$payForm.append($(\"<input type='hidden' name='lCardFullNo' lpoint_values='true' value='\" + $('#lDCardNo1').val() + $('#lDCardNo2').val() + $('#lDCardNo3').val() + $('#lDCardNo4').val() + \"'/>\"));\r\n\t\t$payForm.append($(\"<input type='hidden' name='lpointPw' lpoint_values='true' value='\" + $('#lDCardPw').val() + \"'/>\"));\r\n\t\t\t\t\r\n\t\tshowLoading();\t\r\n\r\n\t\tjQuery.ajax({\r\n\t\t\tasyn : true\r\n\t\t\t, url:'/jsApi/lpoint/checkDLpoint'\r\n\t\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t\t, type : \"POST\"\r\n\t\t\t, dataType:\"json\"\r\n\t\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t\r\n\t\t\t\tvar code = jsonData['resultcode']; \r\n\t\t\t\t\tif(jsonData.resultcode == '0000'){ // 정상 통신\r\n\r\n\t\t\t\t\t\t//hidden으로 암호화reqdata를 저장한다.\r\n\t\t\t\t\t\t//hidden으로 가용포인트를 저장한다.\r\n\t\t\t\t\t\t$('#lpointAll').val(jsonData.point);\r\n\t\t\t\t\t\t$('#cryptLpInfo').val(jsonData.cryptLpInfo);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t$('#possLDPoint').text(jsonData.point + 'p');\r\n\t\t\t\t\t\t$('#uselDPoint').val(Number($('[name=price]').val()));\r\n\t\t\t\t\t\t$('#lpPlLinkSect').hide();\r\n\t\t\t\t\t\t$('#lpPlInfomation').hide();\r\n\t\t\t\t\t\t$('#lpPlPointSect').show();\r\n\t\t\t\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tcallAlert(\"[Failure]\"+jsonData.resultmsg);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t, error:function(jqXHR,status,errorThrown ){\r\n\t\t\t\t\talert(\"[Connection Failure]\"+errorThrown);\r\n\t\t\t\t\t//var closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\t\t//location.href = closeUrl;\r\n\t\t\t\t}\r\n\t\t\t, complete:function(jqXHR,status){\r\n\t\t\t\t\thideLoading();\r\n\t\t\t\t}\r\n\t\t});\r\n\t});\r\n\t\r\n\t//Lpoint 다이렉트 확인 버튼 이벤트 \r\n\tjQuery(document).on(\"click\",\"#lpointDirectConfirmbtn\", function(){\r\n\r\n\t\tvar isChecked = $('#chkDirectLpointUse').is(':checked');\r\n\t\tvar LpointFlag = $payForm.find(\"input[name=LpointFlag]\").val();\r\n\t\t\r\n\t\t//사용일때\r\n\t\tif(isChecked){\t\r\n\t\t\tvar oriPrice \t= Number($('[name=price]').val());\r\n\t\t\tvar lpoint \t\t= Number($('#uselDPoint').val());\r\n\t\t\tvar possPoint \t= Number($('#lpointAll').val());\r\n\t\t\tvar cardPrice \t= oriPrice - lpoint;\r\n\r\n\t\t\tif(LpointFlag == \"\" || LpointFlag == undefined) {\r\n\t\t\t\tif($('#lDCardNo1').val().length < 4 || $('#lDCardNo2').val().length < 4 || $('#lDCardNo3').val().length < 4 || $('#lDCardNo4').val().length < 4){\r\n\t\t\t\t\tcallAlert(INImsg.alert_card_msg3);\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\r\n\t\t\tif($('#cryptLpInfo').val().length < 1){\r\n\t\t\t\tcallAlert(INImsg.alert_point_msg7);//'포인트를 조회하십시오.'\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tif(lpoint == 0){\r\n\t\t\t\tcallAlert(INImsg.alert_point_msg5);//'포인트는 1포인트 이상 사용 가능합니다.'\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif (possPoint < lpoint){ \r\n\t\t\t\tcallAlert(\"사용할포인트가 부족합니다.\");\t\r\n\t\t\t\treturn false;\r\n\t\t\t}else if(oriPrice < lpoint || oriPrice > lpoint){\r\n\t\t\t\tcallAlert(INImsg.alert_point_msg6 +\"\\n 결제금액(\"+ oriPrice +\")과 일치하여야 합니다.\");\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t$('.lpoint_exp_credit').text(cardPrice);\r\n\t\t\t$('.lpoint_exp_point').text(lpoint);\r\n\t\t\t$('.lpoint_exp').removeClass(\"hide\"); \r\n\t\t\t\r\n\t\t\t$('[name=lpTotalPrice]').val(oriPrice);\r\n\t\t\t$('[name=lpCardPrice]').val(cardPrice);\r\n\t\t\t$('[name=lpoint]').val(lpoint);\r\n\t\t\t$('[name=lpUse]').val('true');\r\n\t\t\t\r\n\t\t\t$(\"#chkLpoint\").prop(\"checked\", true);\r\n\t\t\t\t\r\n\t\t\t\r\n\t\t\tif( Number($('[name=lpCardPrice]').val()) == 0 && Number($('[name=lpTotalPrice]').val()) >= 1 && (Number($('[name=lpTotalPrice]').val()) == Number($('[name=lpoint]').val()))){\r\n\t\t\t\tcallRecive.cardNextKbappOnlyLpoint();\r\n\t\t\t}else{\r\n\t\t\t\tcallAlert(\"결제금액(\"+oriPrice+\")과 LPoint 사용금액과 일치 하지 않습니다.\");\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\r\n\t\t\treturn false;\r\n\t\t//미사용일때\r\n\t\t}else{\r\n\t\t\tcallAlert(\"포인트사용을 체크하십시오.\");\r\n\t\t\treturn false;\r\n\t\t}\r\n\t});\r\n\t\r\n\t\r\n\t\r\n\tvar closeCheck = false;\r\n\t// 엘포인트 다이렉트 팝업 닫기 이벤트\r\n\tjQuery(document).on(\"click\",\"#lpointDirectCloseBtn\", function(){\r\n\t\t\r\n\t\t closeCheck = true;\r\n\t\t\r\n\t\t//lpoint체크 여부는 포인트의 사용유무로만 판단한다.\r\n\t\tif($('[name=lpUse]').val() == 'true'){\r\n\t\t\t$(\"#chkLpoint\").prop(\"checked\", true);\r\n\t\t}else{\r\n\t\t\t$(\"#chkLpoint\").prop(\"checked\", false);\r\n\t\t}\r\n\t\t\r\n\t\t$('#lDCardNo1, #lDCardNo2, #lDCardNo3, #lDCardNo4, #lDCardPw, #uselDPoint').val('');\r\n\t\t$('#possLDPoint').text('');\r\n\t\t\r\n\t\tclosePopupUrl();\r\n\t});\r\n\t\r\n\t\r\n\t/*// 엘포인트 다이렉트 입력금액확인 이벤트ok\r\n\tjQuery(document).on(\"focusout\",\"#uselDPoint\",function(){\r\n\t\t\r\n\t\tvar oriPrice \t= Number($('[name=price]').val());\r\n\t\tvar possPoint \t= Number($('#lpointAll').val());\r\n\t\tvar usedPoint \t= Number($('#uselDPoint').val());\r\n\t\t\r\n\t\tif( possPoint < usedPoint){\r\n\t\t\tcallAlert(INImsg.alert_point_msg6); //사용할 포인트를 확인 하십시오.\r\n\t\t\t$('#uselDPoint').val(0);\r\n\t\t\treturn false;\r\n\t\t}else if(oriPrice < usedPoint){\r\n\t\t\tcallAlert(INImsg.alert_point_msg6 +\"\\n 결제금액(\"+ oriPrice +\")과 일치하여야 합니다.\"); //사용할 포인트를 확인 하십시오.\r\n\t\t\t$('#uselDPoint').val(0);\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t});*/\r\n\t\r\n\t/*// 엘포인트 다이렉트 전체체크 이벤트ok\r\n\tjQuery(document).on(\"change\",\"#chkLPointAll\",function(){\r\n\t\t\r\n\t\tvar isChecked = $(this).is(':checked');\r\n\t\tif(isChecked){\r\n\r\n\t\t\t//포인트 전체가 아닌 상품가격과 비교하여 처리한다.\r\n\t\t\tvar oriPrice \t= Number($('[name=price]').val());\r\n\t\t\tvar possPoint \t= Number($('#lpointAll').val());\r\n\t\t\tif(oriPrice <= possPoint){\r\n\t\t\t\t$('#uselDPoint').val(oriPrice);\r\n\t\t\t}else if(oriPrice > possPoint){\r\n\t\t\t\t$('#uselDPoint').val(possPoint);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t}else{\r\n\t\t\t$('#uselDPoint').val(0);\r\n\t\t}\r\n\r\n\t});*/\r\n\t\r\n\t\r\n\t// lpoint 입력금액확인 이벤트ok\r\n\tjQuery(document).on(\"focusout\",\"#usePoint\",function(){\r\n\t\t\r\n\t\tvar oriPrice \t= Number($('[name=price]').val());\r\n\t\tvar possPoint \t= Number($('#lpointAll').val());\r\n\t\tvar usedPoint \t= Number($('#usePoint').val());\r\n\t\t\r\n\t\tif( possPoint < usedPoint || oriPrice < usedPoint){\r\n\t\t\tcallAlert(INImsg.alert_point_msg6); //사용할 포인트를 확인 하십시오.\r\n\t\t\t$('#usePoint').val(0);\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\t\r\n\t});\r\n\t\r\n\t// lpoint 전체체크 이벤트ok\r\n\tjQuery(document).on(\"change\",\"#chkLPointAll\",function(){\r\n\t\t\r\n\t\tvar isChecked = $(this).is(':checked');\r\n\t\tif(isChecked){\r\n\r\n\t\t\t//포인트 전체가 아닌 상품가격과 비교하여 처리한다.\r\n\t\t\tvar oriPrice \t= Number($('[name=price]').val());\r\n\t\t\tvar possPoint \t= Number($('#lpointAll').val());\r\n\t\t\tif(oriPrice <= possPoint){\r\n\t\t\t\t$('#usePoint').val(oriPrice);\r\n\t\t\t}else if(oriPrice > possPoint){\r\n\t\t\t\t$('#usePoint').val(possPoint);\r\n\t\t\t}\r\n\t\t\t\r\n\t\t}else{\r\n\t\t\t$('#usePoint').val(0);\r\n\t\t}\r\n\r\n\t});\r\n\t\r\n\t//lpoint 사용체크 이벤트\r\n\tjQuery(document).on(\"change\",\"#chkLpointUse\",function(){\r\n\t\t\r\n\t\tvar isChecked = $(this).is(':checked');\r\n\t\tif(isChecked){\r\n\t\t\t$('#lpPlSelectSect').show();\r\n\t\t\t$('#lpPlLinkSect').show();\r\n\t\t\t$('#lpPlPointSect').hide();\r\n\t\t}else{\r\n\t\t\t//사용해제시 hide처리만 값의 변경은 '확인'처리시\r\n\t\t\t$('#lpPlSelectSect').hide();\r\n\t\t\t$('#lpPlLinkSect').hide();\r\n\t\t\t$('#lpPlPointSect').hide();\r\n\t\t\t$('#usePoint').val('');\r\n\t\t\t$('#possLPoint').text('');\r\n\t\t}\r\n\t});\r\n\r\n\t//엘포인트 범용창 팝업 확인 버튼 이벤트 \r\n\tjQuery(document).on(\"click\",\"#lpointConfirmbtn\", function(){\r\n\t\tvar isChecked = $('#chkLpointUse').is(':checked');\r\n\t\tvar flag = $payForm.find(\"input[name=LpointFlag]\").val();\r\n\t\t\r\n\t\t//사용일때\r\n\t\tif(isChecked){\r\n\t\t\tvar oriPrice \t= Number($('[name=price]').val());\r\n\t\t\tvar lpoint \t\t= Number($('#usePoint').val());\r\n\t\t\tvar possPoint \t= Number($('#lpointAll').val());\r\n\t\t\tvar cardPrice \t= oriPrice - lpoint;\r\n\t\t\t\r\n\t\t\t\r\n\t\t\tif(flag == \"\" || flag == undefined) {\r\n\t\t\t\tif($('#lCardNo1').val().length < 4 || $('#lCardNo2').val().length < 4 || $('#lCardNo3').val().length < 4 || $('#lCardNo4').val().length < 4){\r\n\t\t\t\t\tcallAlert(INImsg.alert_card_msg3);\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\r\n\t\t\tif($('#cryptLpInfo').val().length < 1){\r\n\t\t\t\tcallAlert(INImsg.alert_point_msg7);//'포인트를 조회하십시오.'\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tif(lpoint == 0){\r\n\t\t\t\tcallAlert(INImsg.alert_point_msg5);//'포인트는 1포인트 이상 사용 가능합니다.'\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tif (possPoint < lpoint || oriPrice < lpoint){\r\n\t\t\t\t$('#usePoint').val(0);\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//신판금액이 5만원 미만이면 할부항목을 삭제\r\n\t\t\tif((oriPrice - lpoint) < 50000 && \"04\" != $payForm.find(\"[name=cardCode]:checked\").val() ){\r\n\t\t\t\t$(\"#cardQuotaView .dropdown dt\").empty();\r\n\t\t\t\t$(\"#cardQuotaView .dropdown ul\").empty();\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t}else if((oriPrice - lpoint) < 10000 && \"04\" == $payForm.find(\"[name=cardCode]:checked\").val() ){\r\n\t\t\t\t$(\"#cardQuotaView .dropdown dt\").empty();\r\n\t\t\t\t$(\"#cardQuotaView .dropdown ul\").empty();\r\n\t\t\t\t$payForm.find(\"input[name=cardQuota]\").val(\"00\");\r\n\t\t\t}else if((oriPrice - lpoint) >= 10000 && \"04\" == $payForm.find(\"[name=cardCode]:checked\").val() ){\r\n\t\t\t\t$('[name=lpoint]').val(lpoint);\r\n\t\t\t\tsetCardNoInterestText($payForm.find(\"[name=cardCode]:checked\"));\r\n\t\t\t}else if((oriPrice - lpoint) >= 50000 && \"04\" != $payForm.find(\"[name=cardCode]:checked\").val() ){\r\n\t\t\t\t$('[name=lpoint]').val(lpoint);\r\n\t\t\t\tsetCardNoInterestText($payForm.find(\"[name=cardCode]:checked\"));\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t$('.lpoint_exp_credit').text(cardPrice);\r\n\t\t\t$('.lpoint_exp_point').text(lpoint);\r\n\t\t\t$('.lpoint_exp').removeClass(\"hide\"); \r\n\t\t\t$('[name=lpTotalPrice]').val(oriPrice);\r\n\t\t\t$('[name=lpCardPrice]').val(cardPrice);\r\n\t\t\t$('[name=lpoint]').val(lpoint);\r\n\t\t\t$('[name=lpUse]').val('true');\r\n\t\t\t\r\n\t\t\t$(\"#chkLpoint\").prop(\"checked\", true);\r\n\t\t\t\r\n\t\t//미사용일때\r\n\t\t}else{\r\n\t\t\t\r\n\t\t\t$('[name=lpTotalPrice]').val(0);\r\n\t\t\t$('[name=lpCardPrice]').val(0);\r\n\t\t\t$('[name=lpoint]').val(0);\r\n\t\t\t$('[name=lpointAll]').val(0);\r\n\t\t\t$('[name=lpointCdcd]').val('');\r\n\t\t\t\r\n\t\t\t$('[name=cryptLpInfo]').val('');\r\n\t\t\t$('[name=lpUse]').val('false');\r\n\t\t\t//$('#lpointDisplay').empty(); =>변경\r\n\t\t\t$('.lpoint_exp_credit').text('');\r\n\t\t\t$('.lpoint_exp_point').text('');\r\n\t\t\t$('.lpoint_exp').addClass(\"hide\");\r\n\t\t\t\r\n\t\t\t$(\"#chkLpoint\").prop(\"checked\", false);\r\n\t\t\t\r\n\t\t\tvar oriPrice \t= Number($('[name=price]').val());\r\n\t\t\tvar lpoint \t\t= Number($('#usePoint').val());\r\n\t\t\t\r\n\t\t\tif( oriPrice >= 10000 && \"04\" == $payForm.find(\"[name=cardCode]:checked\").val() ){\t\t\t\t\t\r\n\t\t\t\tsetCardNoInterestText($payForm.find(\"[name=cardCode]:checked\"));\r\n\t\t\t}else if( oriPrice >= 50000 && \"04\" != $payForm.find(\"[name=cardCode]:checked\").val() ){\r\n\t\t\t\tsetCardNoInterestText($payForm.find(\"[name=cardCode]:checked\"));\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t$('#lCardNo1, #lCardNo2, #lCardNo3, #lCardNo4, #lCardPw, #usePoint').val('');\r\n\t\t$('#possLPoint').text('');\r\n\t\t$('#lpointPopup').addClass(\"hide\");\r\n\t\t\r\n\t\toverlayPopupOnOff(false);\r\n\t\t\r\n\t});\r\n\t// lpoint 닫기 이벤트\r\n\tjQuery(document).on(\"click\",\"#lpointCloseBtn\", function(){\r\n\t\t\r\n\t\t//lpoint체크 여부는 포인트의 사용유무로만 판단한다.\r\n\t\tif($('[name=lpUse]').val() == 'true'){\r\n\t\t\t$(\"#chkLpoint\").prop(\"checked\", true);\r\n\t\t}else{\r\n\t\t\t$(\"#chkLpoint\").prop(\"checked\", false);\r\n\t\t}\r\n\t\t\r\n\t\t$('#lpointPopup').addClass(\"hide\");\r\n\t\t\r\n\t\toverlayPopupOnOff(false);\r\n\t\t\r\n\t\t$('#lCardNo1, #lCardNo2, #lCardNo3, #lCardNo4, #lCardPw, #usePoint').val('');\r\n\t\t$('#possLPoint').text('');\r\n\t});\r\n\t\r\n\t// payNext\r\n\tjQuery(document).on(\"click\",\"#CardBtn\", function(){\r\n\t\t// 이니안심 사용여부 초기화\r\n\t\t$payForm.find(\"input[name=CNF_KCARE]\").val(\"0\");\r\n\t\t\r\n\t\t//유니마일 사용여부 초기화\r\n\t\t$payForm.find(\"input[name=umpUse]\").val(\"0\");\r\n\t\t\r\n\t\t/* 간편결제전용창 약관체크 */\r\n\t\tvar stdEasyPay = \"false\"; \r\n\t\t\r\n\r\n\t\tif($payForm.find(\"input[name=stdEasyPayUse]\").val() == '1'){\r\n\t\t\t\r\n\t\t\t// 기존 카드결제창 이용약관 동의 검증\t\r\n\t\t\tif($payForm.find(\"input[name=USE_KCARE]\").val() != \"\" && $payForm.find(\"input[name=PR_KCARE]\").val() != \"\"){// 이니안심 사용가능 할 경우\r\n\t\t\t\t\r\n\t\t\t\t// 간편결제 전용창 약관 2칸\r\n\t\t\t\tif(!($(\"#inputChk1_2\").prop(\"checked\")) && !isAssentChk) {// 전자금융거래 이용약관\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg1);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} else if(!($(\"#inputChk3_2\").prop(\"checked\")) && !isAssentChk) {// 개인정보의 수집 및 이용안내\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg3);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} else if(!($(\"#inputChk4_2\").prop(\"checked\")) && !isAssentChk) { // 개인정보 제공 및 위탁안내\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg4);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} \r\n\t\t\t}else{\r\n\t\r\n\t\t\t\t// 간편결제 전용창 약관 1칸\r\n\t\t\t\tif(!($(\"#inputChk1\").prop(\"checked\")) && !isAssentChk) {// 전자금융거래 이용약관\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg1);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} else if(!($(\"#inputChk3\").prop(\"checked\")) && !isAssentChk) {// 개인정보의 수집 및 이용안내\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg3);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} else if(!($(\"#inputChk4\").prop(\"checked\")) && !isAssentChk) { // 개인정보 제공 및 위탁안내\r\n\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg4);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t} \r\n\t\t\t}\r\n\t\t\t\r\n\t\t}else{\r\n\r\n\t\t/*\t// 기존 카드결제창 이용약관 동의 검증\t\r\n\t\t\tif(!($(\"#inputChk7\").prop(\"checked\") && $(\"#inputChkDetail7\").prop(\"checked\")) && !isAssentChk) {// 전자금융 이용약관  2020.12.08 kth\r\n\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg1);\r\n\t\t\t\treturn;\r\n\t\t\t} else if(!($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChkDetail3\").prop(\"checked\")) && !isAssentChk) {// 개인정보의 수집 및 이용안내\r\n\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg3);\r\n\t\t\t\treturn;\r\n\t\t\t} else if(!($(\"#inputChk4\").prop(\"checked\") && $(\"#inputChkDetail4\").prop(\"checked\")) && !isAssentChk) { // 개인정보 제공 및 위탁안내\r\n\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg4);\r\n\t\t\t\treturn;\r\n\t\t\t} */\r\n\r\n\t\t\t//보안취약점 개선 240402\r\n\t\t\tif(!isFlgUseProvision){\r\n\t\t\t\tvar checkAgree = termsAndAgreement();\r\n\t\t\t\tif(checkAgree == \"false\"){\r\n\t\t\t\t\t\r\n\t\t\t\t\tif(!($(\"#inputChk7\").prop(\"checked\") && $(\"#inputChkDetail7\").prop(\"checked\"))) {// 전자금융 이용약관  2020.12.08 kth\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg1);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t} else if(!($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChkDetail3\").prop(\"checked\"))) {// 개인정보의 수집 및 이용안내\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg3);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t} else if(!($(\"#inputChk4\").prop(\"checked\") && $(\"#inputChkDetail4\").prop(\"checked\"))) { // 개인정보 제공 및 위탁안내\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bill_agree_msg4);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\r\n\t\t}\r\n\t\t/* 간편결제전용창 약관체크 끝 */\r\n\t\t\r\n\t\t\tif(boolMobile){\r\n\t\t\t\tselectCardCode = $payForm.find(\"[name=cardCode] option:selected\");\r\n\t\t\t}else{\r\n\t\t\t\tselectCardCode = $payForm.find(\"[name=cardCode]:checked\");\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tvar $selectCardCode = selectCardCode;\r\n\t\t\t\r\n\t\t\t//은련카드인데 통화가 USD일 경우 진행안됨\r\n\t\t\tif($selectCardCode.val() == '26'){\r\n\t\t\t\tif($payForm.find(\"[name=currency]\").val() == 'USD'){\r\n\t\t\t\t\tcallAlert(INImsg.alert_card_msg16);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t// 1000원 미만이면서 네이버 체크 아웃일시 ALERT창 지정 2016.03.18 BY KSM\r\n\t\t\tvar below1000ErrorAlert= $(\"#below1000ErrorAlert\").val();\r\n\t\t\t\r\n\t\t\t// 1000 미만이면서 below1000이 없으면서 네이버 체크 아웃일 경우 2016.03.16 BY KSM\t\r\n\t\t\tif(below1000ErrorAlert &&  (-1 != site_id_nik.indexOf('site_id(nik)'))) {\r\n\t\t\t\tcallNikAlert(INImsg.alert_card_msg12 , INImsg.alert_nik_card_title);\t//네이버 nik용으로 title도 입력가능하게 별도로 공통에 만듬.\r\n\t\t\t\treturn; \r\n\t\t\t}\r\n\t\t\t\r\n\t\t\tif($selectCardCode.size() <= 0 || $selectCardCode.val().length <= 0){\r\n\t\t\t\t//callAlert(INImsg.alert_card_msg1);\r\n\t\t\t\tif ('onlycard'  == goPayMethod && (-1 != site_id_nik.indexOf('site_id(nik)')) ) {\t//내이버 nik 카드\r\n\t\t\t\t\tcallNikAlert(INImsg.alert_card_msg1 , INImsg.alert_nik_card_title);\t//네이버 nik용으로 title도 입력가능하게 별도로 공통에 만듬.\r\n\t\t\t\t} else {\r\n\t\t\t\t\tcallAlert(INImsg.alert_card_msg1);\r\n\t\t\t\t}\r\n\t\t\t\treturn;\r\n\t\t\t} else if ( ('onlycard'  == goPayMethod && (-1 != site_id_nik.indexOf('site_id(nik)'))) && !$('#chkconfirm').is(':checked')) {\t/****네이버 nik 신용카드 결제정보 제공 동의 체크 2015-09-22 by Yang****/\r\n\t\t\t\tcallNikAlert(INImsg.alert_nik_agree_msg4 , INImsg.alert_nik_agree_tit4);\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t// 이니안심 체크여부\r\n\t\t\tif($(\"#inputChk6\").prop(\"checked\")) {\r\n\t\t\t\tif($selectCardCode.attr(\"cardType\") == \"isp\" || $selectCardCode.attr(\"cardType\") == \"visa3d\"){\r\n\t\t\t\t\t\r\n\t\t\t\t\t/*\r\n\t\t\t\t \t\t이니안심 할부개월 개선 250429\r\n\t\t\t\t\t\t현대카드 10000 ~ 199699\r\n\t\t\t\t\t\t그외카드 50000 ~ 199699 \r\n\t\t\t\t\t */\r\n\t\t\t\t\r\n\t\t\t\t\tvar getPrice = $payForm.find(\"input[name=price]\").val();\r\n\t\t\t\t\tvar getQuota = $payForm.find(\"input[name=cardQuota]\").val();\r\n\t\t\t\t\t\r\n\t\t\t\t\tif($selectCardCode.val() == '04'){\r\n\t\t\t\t\t\tif(Number(getPrice) >= 10000 && Number(getPrice) <= 199699){\r\n\t\t\t\t\t\t\tif(getQuota != '00' && getQuota != '02' && getQuota != '03'){\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg9);\r\n\t\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tif(getQuota != '00'){\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tif(Number(getPrice) >= 50000 && Number(getPrice) <= 199699){\r\n\t\t\t\t\t\t\tif(getQuota != '00' && getQuota != '02' && getQuota != '03'){\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg9);\r\n\t\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tif(getQuota != '00'){\r\n\t\t\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\tif($('[name=lpUse]').val() == 'true'){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg3);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t// 이니안심 사용\r\n\t\t\t\t\t\t$payForm.find(\"input[name=CNF_KCARE]\").val(\"1\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t/*if($payForm.find(\"input[name=cardQuota]\").val() != '00'){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg2);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}else if($('[name=lpUse]').val() == 'true'){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg3);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\t// 이니안심 사용\r\n\t\t\t\t\t\t$payForm.find(\"input[name=CNF_KCARE]\").val(\"1\");\r\n\t\t\t\t\t}*/\r\n\t\t\t\t\t\r\n\t\t\t\t\t// 간편결제 전용창일 경우\r\n\t\t\t\t\tif($payForm.find(\"input[name=stdEasyPayUse]\").val() == '1'){\r\n\t\t\t\t\t\tif(!$(\"#inputChk6_2\").prop(\"checked\")){\r\n\t\t\t\t\t\t\tcallAlert(INImsg.alert_hpp_msg4);\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\tcallAlert(INImsg.alert_kcare_msg1);\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//유니마일 포인트 체크여부\r\n\t\t\tif($(\"#uniMilePoint\").prop(\"checked\")){\r\n\t\t\t\tif($selectCardCode.attr(\"cardType\") == \"isp\"){\r\n\t\t\t\t\t// 유니마일 포인트 사용\r\n\t\t\t\t\t$payForm.find(\"input[name=umpUse]\").val(\"1\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t//OK 캐쉬백 포인트 적립 ~\r\n\t\t\tif($(\"#useSaveOcb\").prop(\"checked\") == true){\r\n\t\t\t\t$(\".OCBPopup\").show();\r\n\t\t\t\t$(\"#overlay_popup_bg\").show();\r\n\t\t\t}else{\r\n\t\t\t\t$payForm.find(\"input[name=ocbRequestdata]\").val('');\r\n\t\t\t\t$payForm.find(\"input[name=ocbSave_flg]\").val(false);\r\n\t\t\t\t\r\n\t\t\t\t// 카드결제\r\n\t\t\t\tgoCardPayment(goPayMethod, site_id_nik, $selectCardCode);\r\n\t\t\t\t\r\n\t\t\t}\r\n\t});\r\n\t\r\n    //wcchoi\r\n\t//2016.06.28\r\n\t//DESC :쿠폰 팝업에서 취소버튼에서 탭키를 클릭하면, 포커스 이동.\r\n\t$(document).on(\"keydown\", \"#notCp\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\tsetInputFocusPointPopup();\r\n\t\t}\r\n\t});\r\n    //wcchoi\r\n\t//2016.06.28\r\n\t//DESC :쿠폰 팝업에서 사용버튼에서 닫기버튼이 없이 사용버튼만 있고  탭키를 눌렀을때,\r\n\t//       사용버튼, 사용안함버튼 버튼이 2개있는경우, 탭키 눌렀을때 포커스 이동.\r\n\t$(document).on(\"keydown\", \"#useCp\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tvar length =  0;\r\n\t\t\tlength = $(\"#notCp\").length;\r\n\t\tif (9 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\tif(length < 0 || 0 == length){\r\n\t\t\t\tsetInputFocusPointPopup();\r\n\t\t\t}else if(length > 0){\r\n\t\t\t\tsetTimeout(function() {\r\n\t\t\t\t\t$(\"#notCp\").focus(); \r\n\t\t\t    }, 100);\t\r\n\t\t\t}\t\t\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :유니마일 팝업에서 확인버튼에서 탭키를 클릭하면, 포커스 이동.\r\n\t$(document).on(\"keydown\", \"#uniMileOk\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode){\r\n\t\t\tif(!e.shiftKey){\r\n\t\t\t\te.stopPropagation();\r\n\t\t\t\te.preventDefault();\r\n\t\t\t\t$(\"#inputFocusUniMilePointPopup\").focus();\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n\t//DESC :유니마일 팝업 처음 포커싱 된 페이지에서 탭+쉬프트 키를 클릭하면, 확인버튼으로 포커스 이동.\r\n\t$(document).on(\"keydown\", \"#inputFocusUniMilePointPopup\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (9 == keycode){\r\n\t\t\tif(e.shiftKey){\r\n\t\t\t\te.stopPropagation();\r\n\t\t\t\te.preventDefault();\r\n\t\t\t\t$(\"#uniMileOk\").focus();\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\t\r\n \t////////////////////////////////////\r\n\t// 카드 Step2\r\n\t////////////////////////////////////\r\n\r\n\tjQuery(document).on(\"change\",\"input[name=cardHasType]\", function(){\r\n\t\tif(jQuery(\"input[name=cardHasType]:checked\").val() == \"co\"){\r\n\t\t\tjQuery(\".cardNextIdViewTr\").hide();\r\n\t\t\tjQuery(\".cardNextCoViewTr\").show();\r\n\r\n\t\t\tjQuery(\".cardNextIdViewTr\").find(\"input\").attr(\"disabled\",true);\r\n\t\t\tjQuery(\".cardNextCoViewTr\").find(\"input\").attr(\"disabled\",false);\r\n\t\t}else if(jQuery(\"input[name=cardHasType]:checked\").val() == \"id\"){\r\n\t\t\tjQuery(\".cardNextCoViewTr\").hide();\r\n\t\t\tjQuery(\".cardNextIdViewTr\").show();\r\n\r\n\t\t\tjQuery(\".cardNextCoViewTr\").find(\"input\").attr(\"disabled\",true);\r\n\t\t\tjQuery(\".cardNextIdViewTr\").find(\"input\").attr(\"disabled\",false);\r\n\t\t}\r\n\r\n\t});\r\n\t//wcchoi\r\n\t//2016.06.16\r\n\t//DESC : 라디오 버튼을 클릭했을떄 \r\n\t$(document).on(\"keydown\", \"span.radio\", function(e) {\r\n\t\tvar value = $(this).children('input:radio[name=cardHasType]').val();\r\n\t\tvar id = $(this).children('input:radio[name=cardHasType]').prop(\"id\");\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13  == keycode){\r\n\t\t\tif (\"co\" == value) {\r\n\t\t\t\t$(\".cardNextIdViewTr\").hide();\r\n\t\t\t\t$(\".cardNextCoViewTr\").show();\r\n\t\t\t\t$(\".cardNextIdViewTr\").find(\"input\").attr(\"disabled\",true);\r\n\t\t\t\t$(\".cardNextCoViewTr\").find(\"input\").attr(\"disabled\",false);\r\n\t\t\t\t$(\"#\"+id).prop(\"checked\", true);\r\n\t\t\t}else if(\"id\" == value) {\t\t\r\n\t\t\t\t$(\".cardNextCoViewTr\").hide();\r\n\t\t\t\t$(\".cardNextIdViewTr\").show();\r\n\t\t\t\t$(\".cardNextCoViewTr\").find(\"input\").attr(\"disabled\",true);\r\n\t\t\t\t$(\".cardNextIdViewTr\").find(\"input\").attr(\"disabled\",false);\r\n\t\t\t\t$(\"#\"+id).prop(\"checked\", true);\r\n\t\t\t}\t\t\r\n\t\t}\r\n\t});\r\n\t\r\n\t//은련카드\r\n\tjQuery(document).on(\"click\",\"#UnionPayBtn\", function(){\r\n\t\tunionPay();\r\n\t});\r\n\t\r\n\t// 비인증\r\n\tjQuery(document).on(\"click\",\"#CardNextBtn\", function(){\r\n\t\tif(\r\n\t\t\t$payForm.find(\"[name=cardNumber1]\").val().length < 4\r\n\t\t\t|| $payForm.find(\"[name=cardNumber2]\").val().length < 4\r\n\t\t\t|| $payForm.find(\"[name=cardNumber3]\").val().length < 4\r\n\t\t\t|| $payForm.find(\"[name=cardNumber4]\").val().length < 2\r\n\t\t){\r\n\t\t\tcallAlert(INImsg.alert_card_msg3);\r\n\t\t\treturn;\r\n\t\t}else if(\r\n\t\t\t$payForm.find(\"[name=cardYear]\").val().length <= 0\r\n\t\t){\r\n\t\t\tcallAlert(INImsg.alert_card_msg4);\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\t// 추가 정보 있는지 확인\r\n\t\tif(jQuery(\"input[name=cardHasType]\").length > 0 ){\r\n\t\t\t\r\n\t\t\tif(jQuery(\"input[name=cardHasType]:checked\").val() == \"id\"){\r\n\t\t\t\tvar target = $payForm.find(\"[name=idFirstPwd]\").val();\r\n\t\t\t\tif(typeof(target) !='undefined'){\r\n\t\t\t\t\tif(target.length < 2 ){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_point_msg2);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tif(typeof($payForm.find(\"[name=idRegNum1]\").val()) !='undefined'){\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\tif(jQuery.trim($payForm.find(\"[name=idRegNum1]\").val()).length < 6){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bank_msg12);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse{\r\n\t\t\t\t\t\tvar juminNm = jQuery.trim($payForm.find(\"[name=idRegNum1]\").val());\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t//== 달체크\r\n\t\t\t\t\t\tvar strTemp = \"\";\r\n\t\t\t\t\t\tstrTemp = juminNm[2];\r\n\t\t\t\t\t\tstrTemp += juminNm[3];\r\n\t\t\t\r\n\t\t\t\t\t\ti = parseInt(strTemp,10);\r\n\t\t\t\t\t\tif( i < 1 || i > 12 ) {\r\n\t\t\t\t\t\t\tcallAlert(INImsg.alert_bank_msg12);\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t}\r\n\t\t\t\r\n\t\t\t\t\t\t//== 날체크\r\n\t\t\t\t\t\tstrTemp = \"\";\r\n\t\t\t\t\t\tstrTemp = juminNm[4];\r\n\t\t\t\t\t\tstrTemp += juminNm[5];\r\n\t\t\t\r\n\t\t\t\t\t\ti = parseInt(strTemp,10);\r\n\t\t\t\t\t\tif( i < 1 || i > 31 ){ \r\n\t\t\t\t\t\t\tcallAlert(INImsg.alert_bank_msg12);\r\n\t\t\t\t\t\t\treturn;\t\t\t\t\t\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\t\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tcheckCardNumber();\r\n\t\t\t\t\r\n\t\t\t}else if(jQuery(\"input[name=cardHasType]:checked\").val() == \"co\"){\r\n\t\t\t\t\r\n\t\t\t\t// 사업자번호 첫번째자리 입력 validation 체크\r\n\t\t\t\tvar target = $payForm.find(\"[name=coFirstPwd]\").val();\r\n\t\t\t\tif(typeof(target) !='undefined'){\r\n\t\t\t\t\tif(target.length < 2 ){\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_point_msg2);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tif(typeof($payForm.find(\"[name=coRegNum1]\").val()) !='undefined'){\r\n\t\t\t\t\tif (jQuery.trim($payForm.find(\"[name=coRegNum1]\").val()).length != 3) {\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bank_msg16);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\n\t\t\t\t\t// 사업자번호 두번째자리 입력 validation 체크\r\n\t\t\t\t\tif (jQuery.trim($payForm.find(\"[name=coRegNum2]\").val()).length != 2) {\r\n\t\t\t\t\t\tcallAlert(INImsg.alert_bank_msg17);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\t\r\