          "content": {
            "size": 16510,
            "mimeType": "text/css",
            "compression": 0,
            "text": "/*\r\n@font-face {\r\n\tfont-family: 'iPhone keyboard';\r\n\tsrc: url(iphone-keyboard.ttf);\r\n}\r\n*/\r\n\r\n\r\ninput.screenKey_icon {background:url(https://stdux.inicis.com/stdpay/images/icon_screenkey.png) no-repeat ; }\r\n\r\n/*** ���� ***/\r\n#modalKeyboard .ini_gap_top1 {max-width:500px;margin:auto}\r\n#modalKeyboard .ini_gap_top2 {max-width:500px;margin:auto}\r\n#modalKeyboard .ini_gap\t\t{max-width:800px;margin:auto}\r\n\r\n#modalKeyboard .ini_gap_top1 {padding:20px 15px 0px 15px;height:auto;clear:both;}\r\n#modalKeyboard .ini_gap_top2 {padding:10px 15px 15px 15px;height:auto;clear:both;}\r\n\r\n#modalKeyboard .ini_gap\t\t{padding:0px 15px 0px 15px;height:auto;clear:both;}\r\n\r\n\r\n/*** ��� �۾� ***/\r\n#modalKeyboard .ini_tit_top_etc {display:block;clear:both;text-align:left;}\r\n#modalKeyboard .ini_tit_top_etc ul.ini_etc_left {float:left; font:\"UnDotumWeb\"; font-weight:bold; color:#235ea0;letter-spacing:-1px;}\r\n\r\n\r\n\r\n/*** �Է� ǥ��â ***/\r\n#modalKeyboard .input_parent\t{width:auto; clear:both; overflow:hidden; background:#fff; text-align:left; border:1px solid #c0c0c0; padding: 13px 5px 10px 5px; -webkit-box-shadow:inset 1px 1px #EEE}\r\n\r\n#modalKeyboard .input_parent input.input_basic\t{border:none; width:100%; font-size:20px; background:none; color:#666666;padding:0px;}\r\n#modalKeyboard .input_parent input.input_basic::-webkit-input-placeholder {color:#686868;     }\r\n\r\n\r\n#modalKeyboard .ini_password {font-size:92%; width:100%; height:auto;}\r\n#modalKeyboard .ini_password ul {display:table; width:100%;}\r\n\r\n#modalKeyboard .ini_password ul li {display:table-cell;}\r\n\r\n#modalKeyboard .ini_password ul li.space_area {width:7px;}\r\n#modalKeyboard .ini_password ul li.text_area {width:40px;background:#f5f5f5; border:1px solid #cecece; text-align:center; font-weight:bold;vertical-align:middle;font-size:14px}\r\n#modalKeyboard .ini_password ul li.btn_complete {width:120px;text-align:center; vertical-align:middle;font-size:15px; background:#5594c6; border:1px solid #3f749d; color:#fff;margin:0 0 0 0;}\r\n\r\n\r\n/*** �Է¿Ϸ� ��ư ***/\r\n#modalKeyboard .btn_complete a {color:#fff; text-decoration:none;}\r\n#modalKeyboard .btn_complete a:link {color:#fff; text-decoration:none;}\r\n#modalKeyboard .btn_complete a:visited {color:#fff; text-decoration:none;}\r\n#modalKeyboard .btn_complete a:hover, a:active {color:#fff; text-decoration:none;}\r\n\r\n/**********************************************************************/\r\n/*** Ű���� ***/\r\n\r\n#modalKeyboard .small{\r\n\tpadding:0px;\r\n}\r\n\r\n.selectedInput {\r\n\tborder-style:ridge;\r\n\tborder-color:#ff8080;\r\n}\r\n\r\n#keyboardLayer\t{\r\n\tz-index:10001;\r\n\twidth:100%;\r\n\theight:auto;\r\n\tbottom:0px;\r\n\tdisplay:block;\r\n}\r\n\r\n#overlayLayer{\r\n\tposition:fixed;\r\n\tz-index:10000;\r\n\theight:100%;\r\n\twidth:100%;\r\n\tmin-width:100%;\r\n\tmin-height:100%;\r\n\t/*background-color:red;*/\r\n\r\n\tbottom:0px;\r\n}\r\n\r\n#spaceDiv{\r\n\toverflow:hidden;\r\n\theight:0px;\r\n\tclear:both;\r\n\tbackground-color:#757D8A;\r\n/*\tborder:1px soild red;*/\r\n}\r\n/******************* Ű���� ***************************/\r\n\r\n#iphone-keyboard {\r\n\tfont-family:Helvetica, Arial, sans-serif, Verdana;\r\n\tfont-weight:bold;\r\n\r\n\tmin-width:320px;\r\n\tmax-width:1280px;\r\n\tmargin:0px auto 0px auto;\r\n\tpadding:0;\r\n\toverflow:hidden;\r\n\tborder:1px solid #3A3D42;\r\n\tborder-top:2px solid #3A3D42;\r\n\tbackground:#757D8A;\r\n\tbackground-image:-moz-linear-gradient(#9098A3, #454f5d);\r\n\tbackground-image:-webkit-gradient(linear, left top, left bottom, from(#9098A3), to(#454f5d));\r\n\tbackground-image:gradient(linear, left top, left bottom, from(#9098A3), to(#454f5d));\r\n\tfilter:progid:DXImageTransform.Microsoft.gradient(startColorstr='#9098A3', endColorstr='#454f5d');\r\n\r\n\tbox-shadow:0 1px 0 rgba(255,255,255,.3) inset;\r\n\t-moz-box-shadow:0 1px 0 rgba(255,255,255,.3) inset;\r\n\t-webkit-box-shadow:0 1px 0 rgba(255,255,255,.3) inset;\r\n\tfilter:progid:DXImageTransform.Microsoft.dropshadow(OffX=1, OffY=0, Color='#33FFFFFF'),\r\n}\r\n\r\n#iphone-keyboard li {\r\n\ttext-align:center;\r\n\tlist-style:none;\r\n\tdisplay:block;\r\n\theight:100%;\r\n}\r\n\r\n#iphone-keyboard li:first-child {\r\n\tmargin-top:.5em;\r\n}\r\n\r\n#iphone-keyboard span.ibutton,\r\n#iphone-keyboard span.ibutton.specialkey:active {\r\n\tcolor:#3A3D42;\r\n\r\n\tcursor:pointer;\r\n\r\n\ttext-decoration:none;\r\n\ttext-align:center;\r\n\ttext-shadow:0 1px 1px white;\r\n\tfont-weight:bold;\r\n\t/*height:20px;*/\r\n\r\n\tborder:0;\r\n\tborder-top:1px solid rgba(255,255,255,.45);\r\n\r\n\r\n\tborder-radius:4px;\r\n\t-moz-border-radius:4px;\r\n\t-webkit-border-radius:4px;\r\n\r\n\tbox-shadow:0 1px 3px rgba(0,0,0,.7), 0 1px 0 rgba(0,0,0,.3);\r\n\t-moz-box-shadow:0 1px 3px rgba(0,0,0,.7), 0 1px 0 rgba(0,0,0,.3);\r\n\t-webkit-box-shadow:0 1px 3px rgba(0,0,0,.7), 0 1px 0 rgba(0,0,0,.3);\r\n\tfilter:progid:DXImageTransform.Microsoft.dropshadow(OffX=1, OffY=2, Color='#77000000'),\r\n\r\n}\r\n#iphone-keyboard span.ibutton{\r\n\tbackground:#ECEDEF;\r\n\tbackground-image:-moz-linear-gradient(#f8f8f9, #dddfe1);\r\n\tbackground-image:-webkit-gradient(linear, left top, left bottom, from(#f8f8f9), to(#dddfe1));\r\n\tbackground-image:gradient(linear, left top, left bottom, from(#f8f8f9), to(#dddfe1));\r\n\t/*filter:progid:DXImageTransform.Microsoft.gradient(startColorstr='#f8f8f9', endColorstr='#dddfe1');*/\r\n\r\n}\r\n\r\n#iphone-keyboard span.ibutton:active,\r\n#iphone-keyboard span.ibutton.space:active {\r\n\tbackground-image:-moz-linear-gradient(#E2E3E4, #AAADB4);\r\n\tbackground-image:-webkit-gradient(linear, left top, left bottom, from(#E2E3E4), to(#AAADB4));\r\n\tbackground-image:gradient(linear, left top, left bottom, from(#E2E3E4), to(#AAADB4));\r\n\tfilter:progid:DXImageTransform.Microsoft.gradient(startColorstr='#E2E3E4', endColorstr='#AAADB4');\r\n}\r\n\r\n#iphone-keyboard span.ibutton.specialkey {\r\n\t/*backgr