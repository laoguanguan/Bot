          "content": {
            "size": 4369,
            "mimeType": "text/html",
            "compression": 0,
            "text": "\n\n<!doctype html>\n<html lang=\"ko\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"Cache-Control\" content=\"no-cache\" />\n    <meta http-equiv=\"Pragma\" content=\"no-cache\" />\n    <meta http-equiv=\"Expires\" content=\"0\" />\n    <title>kakao 결제하기</title>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/assets/apps/dkpg_web/css/common.css\">\n    <script src=\"https://stdpay.inicis.com/stdjs/INIStdPay.js\" type=\"text/javascript\" charset=\"UTF-8\"></script>\n  </head>\n  <body onload=\"onload_pay();\">\n    <div class=\"dk_popup\">\n      <div class=\"popup_pay_type\" style=\"width: 100%;\n        text-align: center;\">\n        <div class=\"popup_body\">\n\n          <script type=\"text/javascript\">\n              function onload_pay() {\n                if (navigator.appName.toLowerCase() == \"netscape\") {\n                  self.resizeTo(900, 700);\n                } else {\n                  window.resizeTo(900, 700);\n                }\n                pay('order_info');\n              }\n\n              function pay(frm_id) {\n                INIStdPay.pay(frm_id);\n              }\n\n              window.onpageshow = function(event) {\n                if ( event.persisted || (window.performance && window.performance.getEntriesByType('navigation').length &&\n                        window.performance.getEntriesByType(\"navigation\")[0].type == \"back_forward\")) {\n                  onload_pay();\n                }\n              }\n\n          </script>\n\n          <form id=\"order_info\" method=post>\n\n            <input type=\"hidden\" id=\"popup_redirect_yn\" value='Y' />\n\n            <input type='hidden' name='version' value=\"1.0\">\n            <input type='hidden' name='mid' value=\"ticketon05\">\n            <input type='hidden' name='goodname' value=\"QWER 1ST WORLD TOUR 〈ROCKATION : HOMECOMING〉\">\n            <input type='hidden' name='oid' value=\"8000000317494935\">\n            <input type='hidden' name='price' value=\"161000\">\n            <input type='hidden' name='currency' value=\"WON\">\n            <input type='hidden' name='buyername' value=\"멜론티켓\">\n            <input type='hidden' name='buyertel' value=\"0000000000\">\n            <input type='hidden' name='buyeremail' value=\"\">\n\n            <input type='hidden' name='timestamp' value=\"1773238228202\">\n            <input type='hidden' name='signature' value=\"92fd23a71acc808b152e3cd52a4603da288129bb6f793e344f6a7eb05b970c9b\">\n            <input type='hidden' name='use_chkfake' value=\"Y\">\n            <input type='hidden' name='verification' value=\"752e218b8e124b7e12e6b34e7a0a9c5a0f109f3bcf01d66fe0fc48d11bf9e327\">\n            <input type='hidden' name='returnUrl' value=\"https://dkpg-web.payments.kakao.com/dkpg/v1/payment/inicis/card/approve_web\">\n            <input type='hidden' name='mKey' value=\"246f541a34eeb94f7554f0b38e8eed7c20b0ac639baf9f00d3e8fe5a5b2d38f3\">\n\n            <input type='hidden' name='gopaymethod' value=\"Card\">\n\n\n            <input type='hidden' name='parentemail' value=\"\">\n\n            <input type='hidden' name='languageView' value=\"en\">\n            <input type='hidden' name='charset' value=\"UTF-8\">\n            <input type='hidden' name='payViewType' value=\"overlay\">\n            <input type='hidden' name='closeUrl' value=\"https://dkpg-web.payments.kakao.com/dkpg/v1/payment/inicis/card/cancel_web?session_key=ktx00Z726088ff29cc477cb9d65d9142742016\">\n\n            \n            \n              <input type='hidden' name='quotabase' value=\"01:02:03:04:05:06:07:08:09:10:11:12\">\n            \n            <input type=\"hidden\" name=\"offerPeriod\" value=\"\">\n            <input type='hidden' name='acceptmethod' value=\"SKIN(ORIGINAL):below1000:ini_onlycardcode(26):popreturn\">\n\n            <input type='hidden' name='ini_cardcode' value=\"\">\n            <input type='hidden' name='ansim_quota' value=\"\">\n\n          </form>\n\n\n          <div class=\"pay_roading\">\n            <span class=\"img_pay\"></span>\n            <h2 class=\"tit_info\">현재 결제 진행중 입니다.</h2>\n            <p class=\"desc_info\">결제가 완료되기 전에 창을 닫으시면<br>정상적으로 결제가 진행 되지 않습니다.</p>\n          </div>\n\n          <div class=\"bundle_btn\" style=\"display: none;\">\n            <span class=\"inner_btn\">\n              <a href=\"#none\" class=\"btn_popup\">닫기</a>\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </body>\n</html>\n"
          },
