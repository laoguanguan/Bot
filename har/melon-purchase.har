ass=\"btnType07\" tabindex=\"603\"><span class=\"boldNo\" langTag=\"popup.label4.sub1\">Yes</span></a>\r\n\t\t</div>\t\r\n\t</div>\r\n</div></div>\r\n<div class=\"hide pointMinPrice\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div id=\"point_popup4\">\r\n\t<span style=\"opacity:0;position:absolute;top:-9999px;filter: alpha(opacity=0);-ms-filter:progid:DXImageTransform.Microsoft.Alpha(Opacity=0);-moz-opacity:0;-khtml-opacity:0\">\r\n\t\t<input type=\"text\" id=\"inputFocusPointPopup4\" maxlength=\"0\" tabindex=\"600\"/>\r\n\t</span>\t\r\n \t<div class=\"popLayer\" style=\"width:310px; height:129px; margin:-95px 0 0 -180px;\"><!--padding:30px 24px; -->\r\n\t\t<p class=\"copy02 txtC bold\"><span langTag=\"popup.label6.sub1\" tabindex=\"601\">Card points can not be used.</span></p>\r\n\t\t<p class=\"copy03 txtC\"><span langTag=\"popup.label6.sub2\" tabindex=\"602\">You can use your card points if your payment is more than <span id=\"pntMinPrice\" class=\"bold\"></span> won.<br /><br />Click <span class=\"bold\">OK</span> button to proceed with normal payment. </span></p>\r\n\t\t<div class=\"btnWrapC\" style=\"margin-top: 10px;\">\t\t\t\r\n\t\t\t<a href=\"#none\" id=\"notCp\" class=\"btnType06\" tabindex=\"603\"><span class=\"boldNo\" langTag=\"popup.label7.sub1\">OK</span></a>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n</div>\r\n<div class=\"OCBPopup hide\">\r\n\r\n\r\n\r\n\r\n\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\">\r\n\r\n<div id=\"OCBSavePoint\" >\r\n <div class=\"popLayer\" style=\"width:310px; height:147px; margin:-105px 0 0 -230px;\"><!--padding:30px 24px; -->\r\n\r\n\t<p class=\"copy02 txtC bold\"><span langTag=\"ocb.save.popup.title\">Accumulate OK Cashbag points</span></p>\r\n\t<p class=\"copy03 txtC\"><span langTag=\"ocb.save.card.text\">Please enter a correct OK Cashbag card number.</span></p>\r\n\t<table class=\"tblType03\">\r\n\t<colgroup>\r\n\t\t<col style=\"width:60px;\"/>\r\n\t\t<col />\r\n\t</colgroup>