            "compression": 0,
            "text": "var timer = undefined;\t\r\nvar inicis = {};\r\ninicis.common = {\r\n\t\t\r\n\tarrIds : ['#id','#escrowConf','#escrow','#Card','#DirectBank','#BPDirectBank','#VBank','.goHppBtn','#PhoneBill','#POINT','#OCBPoint','#GSPT','#UPNT','#GiftCard','#EWallet','#EasyPay','#CardFormPay','#Swallet','#Paypin','#Mypoint', '.leftBanner', '#leftPlayPauseBtn', '#leftPrevBtn', '#leftNextBtn', '#setKo','#setEn','#setCh']\r\n\t,\r\n\tsetInputFocus : function(id) {\r\n\t\tclearTimeout(timer);\r\n    \ttimer = setTimeout(function() {\r\n        \t$(\"#\"+id).focus(); \r\n        }, 100);\r\n\t},\t\r\n\t//DESC : left tab Index disable.\r\n\tsetLeftDisableTabIndex : function() {\r\n\t\tfor ( var i in this.arrIds) { $(this.arrIds[i]).attr('tabindex', -1); }\r\n\t\t\r\n\t\t/*****\r\n\t\t$(\"#id\").attr(\"tabindex\", -1);\r\n\t\t$(\"#Bill\").attr(\"tabindex\", -1);\r\n\t\t$(\"#escrowConf\").attr(\"tabindex\", -1);\r\n\t\t$(\"#flgUseProvision\").attr(\"tabindex\", -1);\r\n\t\t$(\"#escrow\").attr(\"tabindex\", -1);\r\n\t\t$(\"#Card\").attr(\"tabindex\", -1); \r\n\t\t$(\"#DirectBank\").attr(\"tabindex\", -1);\r\n\t\t$(\"#VBank\").attr(\"tabindex\", -1);\r\n//\t\t$(\"#HPP\").attr(\"tabindex\", -1);\t//동일한 ID 충돌함.\r\n\t\t$(\"#PhoneBill\").attr(\"tabindex\", -1);\r\n\t\t$(\"#POINT\").attr(\"tabindex\", -1);\r\n\t\t$(\"#OCBPoint\").attr(\"tabindex\", -1);\r\n\t\t$(\"#GSPT\").attr(\"tabindex\", -1);\r\n\t\t$(\"#UPNT\").attr(\"tabindex\", -1);\r\n\t\t$(\"#GiftCard\").attr(\"tabindex\", -1);\r\n\t\t$(\"#EWallet\").attr(\"tabindex\", -1);\r\n\t\t$(\"#EasyPay\").attr(\"tabindex\", -1);\r\n\t\t$(\"#CardFormPay\").attr(\"tabindex\", -1);\r\n\t\t//$(\"#Kpay\").attr(\"tabindex\", -1); //card.jsp 에 같은 이름이 있어서 삭제 \r\n\t\t$(\"#Swallet\").attr(\"tabindex\", -1);\r\n\t\t$(\"#Paypin\").attr(\"tabindex\", -1);\r\n\t\t$(\"#Mypoint\").attr(\"tabindex\", -1);\r\n\t\t*/\r\n\t},\r\n//DESC : left tabIndex setting.\r\n\tsetLeftTabIndex : function() {\r\n\t\t\r\n\t\tvar idxInit = 200;\r\n\t\tfor ( var i in this.arrIds) {\r\n\t\t\t$(this.arrIds[i]).attr('tabindex', ++idxInit);\r\n\t\t}\r\n\t\t/***\r\n\t\t$(\"#id\").attr(\"tabindex\", 201);\r\n\t\t$(\"#Bill\").attr(\"tabindex\", 202);\r\n\t\t$(\"#escrowConf\").attr(\"tabindex\", 203);\r\n\t\t$(\"#flgUseProvision\").attr(\"tabindex\", 204);\r\n\t\t$(\"#escrow\").attr(\"tabindex\", 205);\r\n\t\t$(\"#Card\").attr(\"tabindex\", 206);\r\n\t\t$(\"#DirectBank\").attr(\"tabindex\", 207);\r\n\t\t$(\"#VBank\").attr(\"tabindex\", 208);\r\n//\t\t$(\"#HPP\").attr(\"tabindex\", 209);\t//vbank.jsp에 같은 이름 존재. 2016-07-25 by yang\r\n\t\t$(\".goHppBtn\").attr(\"tabindex\", 209);\t//class로 변경하여 tabindex 추가 by yang\r\n\t\t$(\"#PhoneBill\").attr(\"tabindex\", 210);\r\n\t\t$(\"#POINT\").attr(\"tabindex\", 211);\r\n\t\t$(\"#OCBPoint\").attr(\"tabindex\", 212);\r\n\t\t$(\"#GSPT\").attr(\"tabindex\", 213);\r\n\t\t$(\"#UPNT\").attr(\"tabindex\", 214);\r\n\t\t$(\"#GiftCard\").attr(\"tabindex\", 215);\r\n\t\t$(\"#EWallet\").attr(\"tabindex\", 216);\r\n\t\t$(\"#EasyPay\").attr(\"tabindex\", 217);\r\n\t\t$(\"#CardFormPay\").attr(\"tabindex\", 218);\r\n\t\t//$(\"#Kpay\").attr(\"tabindex\", 219); //card.jsp 에 같은 이름이 있어서 삭제 \r\n\t\t$(\"#Swallet\").attr(\"tabindex\", 220);\r\n\t\t$(\"#Paypin\").attr(\"tabindex\", 221);\r\n\t\t$(\"#Mypoint\").attr(\"tabindex\", 222);\r\n\t\t\r\n\t\t$(\"#setKo\").attr(\"tabindex\", 223);\t//다국어-한국\t2016-07-25\r\n\t\t$(\"#setEn\").attr(\"tabindex\", 224);\t//다극어-영문 2016-07-25\r\n\t\t*/\r\n\t},\r\n\t//DESC : 쿠폰tabindex 설정.\r\n\tsetTabIndexCoupon : function(){\r\n\t\t//for statment number count.\r\n\t\tvar kpListCount = $('#kpListCount').val();\r\n\t\tvar ppListCount = $('#ppListCount').val();\r\n\t\tvar esListCount = $('#esListCount').val();\r\n\t\tvar couponListCount = $('#couponListCount').val();\r\n\t\t//tabIndex count, start number is 501.\r\n\t\tvar index = 501;\r\n\t\tfor(var i = 0; i<=kpListCount; i++){\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span1Kp\"+i).attr(\"tabindex\", index+i);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span2Kp\"+i).attr(\"tabindex\", index+i);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#tdKp\"+i).attr(\"tabindex\", index+i);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#useCpnBtnKp\"+i).attr(\"tabindex\", index+i);\r\n\t\t}\r\n\t\tfor(var i = 0;i<=ppListCount; i++){\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span1Pp\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span2Pp\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#tdPp\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#useCpnBtnPp\"+i).attr(\"tabindex\", index);\r\n\t\t} \r\n\t\tfor(var i = 0;i<=esListCount; i++){\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span1Es\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span2Es\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#tdEs\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#useCpnBtnEs\"+i).attr(\"tabindex\", index);\r\n\t\t} \r\n\t\tfor(var i = 0;i<=couponListCount; i++){\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span1Coupon\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#span2Coupon\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#tdCoupon\"+i).attr(\"tabindex\", index);\r\n\t\t\tindex++;\r\n\t\t\t$(\"#useCpnBtnCoupon\"+i).attr(\"tabindex\", index);\r\n\t\t} \r\n\t},\r\n\t//DESC : 카드 tab index 설정.\r\n\t setTabIndexCard : function(){\r\n\t\t//check ico1, ico2 children.\r\n\t\t//\tvar isCheck = $(\"#ico1\"+i).children('img').length;\r\n\t\t//\tvar isCheck2 = $(\"#ico2\"+i).children('img').length;\r\n\t\t//for statment number count.\r\n\t\tvar payCode1Count = $('#payCode1Count').val();\r\n\t\tvar payCode2Count = $('#payCode2Count').val();\r\n\t\tvar cardCode1Count = $('#cardCode1Count').val();\r\n\t\tvar cardCode2Count = $('#cardCode2Count').val();\r\n\t\t//tabIndex count, start number is 308.\r\n\t\tvar cardCodeIndex = 308;\r\n\t\t\r\n\t\t//pay first for statement.\r\n\t\tfor (var i = 0; i<=payCode1Count; i++) {\r\n\t\t\tcardCodeIndex++;\r\n\t\t\t$(\"#payCode1\"+i).attr(\"tabindex\", cardCodeIndex+i);\r\n\t\t\tcardCodeIndex++;\r\n\t\t\t$(\"#payCode1Desc\"+i).attr(\"tabindex\", cardCodeIndex+i);\r\n\t\t}\r\n\t\t\r\n//\t\t//pay second for statement.\r\n//\t\tfor (var i = 0;i<=payCode2Count; i++) {\r\n//\t\t\tcardCodeIndex++;\r\n//\t\t\t$(\"#payCode2\"+i).attr(\"tabindex\", cardCodeIndex);\r\n//\t\t}\t\r\n//\t\t\r\n//\t\tcardCodeIndex++;\r\n//\t\t$(\"#payCodeEctSelect dt\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\t//card first for statement.\r\n\t\tfor (var i = 0; i<=cardCode1Count; i++) {\r\n\t\t\tcardCodeIndex++;\r\n\t\t\t$(\"#cardCode1\"+i).attr(\"tabindex\", cardCodeIndex+i);\r\n\t\t\tcardCodeIndex++;\r\n\t\t\t$(\"#samsungDesc\"+i).attr(\"tabindex\", cardCodeIndex+i);\r\n\t\t\tcardCodeIndex++;\r\n\t\t\t$(\"#hyundaiDesc\"+i).attr(\"tabindex\", cardCodeIndex+i);\r\n\t\t}\r\n\t\t\r\n\t\t//card second for statement.\r\n\t\tfor (var i = 0;i<=cardCode2Count; i++) {\r\n\t\t\t cardCodeIndex++;\r\n\t\t\t$(\"#cardCode2\"+i).attr(\"tabindex\", cardCodeIndex);\r\n\t\t}\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#cardCodeEctSelect a span\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\t//그외카드 tab 처리\r\n\t\tvar keyCd = \"\";\r\n\t\t$(\"#cardCodeEctSelect .innerBox li a\").eq($(\"#cardCodeEctSelect .innerBox li a\").length-1).keydown(function(e){\t\r\n\t\t\tkeyCd += e.keyCode;\r\n\t\t\t\r\n\t\t\tif(keyCd.indexOf(\"16\")>-1){ //shift+tab 처리\t\t\t\t\r\n\t\t\t\tif(keyCd.indexOf(\"9\")>-1){\r\n\t\t\t\t\tkeyCd = \"\";\t\r\n\t\t\t\t}\r\n\t\t\t}else if(keyCd.indexOf(\"9\")>-1){ //tab 처리\r\n\t\t\t\t$(\"#cardCodeEctSelect .innerBox li a\").eq(0).click();\r\n\t\t\t\tkeyCd = \"\";\r\n\t\t\t}\r\n\t\t});\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#cardQuota dt\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#shinhanApp\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#useSaveOcb\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#uniMilePoint\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#sIntroBtn\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#pIntroBtn\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#nIntroBtn\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n//\t\tcardCodeIndex++;\r\n//\t\t$(\"#oneClick\").attr(\"tabindex\", cardCodeIndex);\r\n//\t\tcardCodeIndex++;\r\n//\t\t$(\"#oneClickSelect\").attr(\"tabindex\", cardCodeIndex);\r\n//\t\tvar isDisabled = $(\"#shinhanApp\").attr(\"disabled\");\r\n//\t\tif('undefined' == isDisabled){\r\n//\t\t\tcardCodeIndex++;\r\n//\t\t\t$(\"#shinhanApp\").attr(\"tabindex\", cardCodeIndex);\r\n//\t\t}\r\n\t\t//pay second for statement.\r\n\t\tfor (var i = 0;i<=payCode2Count; i++) {\r\n\t\t\tcardCodeIndex++;\r\n\t\t\t$(\"#payCode2\"+i).attr(\"tabindex\", cardCodeIndex);\r\n\t\t}\t\r\n\t\t\r\n\t\tcardCodeIndex++;\r\n\t\t$(\"#payCodeEctSelect dt\").attr(\"tabindex\", cardCodeIndex);\r\n\t\t\r\n\t}\r\n};"
