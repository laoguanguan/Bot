;\r\n\t\t\t$payForm.find(\"input[name=check]\").prop(\"checked\",true);\r\n\t\t}\r\n\t\t\r\n\t\tif(selectMenuId == \"Card\") {\r\n\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) && ($(\".btnPaymnt\").hasClass(\"selected\") || ($(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").length > 0 && $(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html() != \"\") || ($(\"#spanSelectPayCode .dropdown\").find(\"dt a span.value\").length > 0 && $(\"#spanSelectPayCode .dropdown\").find(\"dt a span.value\").html() != \"\"))) {\r\n\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\tvar page = $('#curPage').val();\r\n\t\t\t\tsetCardBtnTitle(\"\");\r\n\t\t\t\t//$('#'+page+'Btn').focus();\r\n\t\t\t} else {\r\n\t\t\t\t$(\".bottomBtn\").addClass(\"btnDis\");\r\n\t\t\t\t$(\".btnType09\").css(\"color\", \"\");\r\n\t\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t\t\t$(this).focus();\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n\r\n// 개별 동의에서 엔터를 클릭했을경우\r\njQuery(document).on(\"keydown\",\"input[name=check]\", function(e){\r\n\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\tif (13 == keycode || 32 == keycode){\r\n\t\te.stopPropagation();\r\n\t\te.preventDefault();\r\n\t\t\r\n\t\tif($(\"#inputAll\").prop(\"checked\")){\r\n\t\t\t$(\"#inputAll\").prop(\"checked\",false);\r\n\t\t}\r\n\t\t\r\n\t\tif($(this).prop(\"checked\")){\r\n\t\t\t$(this).prop(\"checked\",false);\r\n\t\t}else{\r\n\t\t\t$(this).prop(\"checked\",true);\r\n\t\t}\r\n\t\t\r\n\t\tif(selectMenuId == \"Card\") {\r\n\t\t\tif(($(\"#inputChk3\").prop(\"checked\") && $(\"#inputChk4\").prop(\"checked\")) && ($(\".btnPaymnt\").hasClass(\"selected\") || ($(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").length > 0 && $(\"#spanSelectCardCode .dropdown\").find(\"dt a span.value\").html() != \"\") || ($(\"#spanSelectPayCode .dropdown\").find(\"dt a span.value\").length > 0 && $(\"#spanSelectPayCode .dropdown\").find(\"dt a span.value\").html() != \"\"))) {\r\n\t\t\t\t$(\".bottomBtn\").removeClass(\"btnDis\");\r\n\t\t\t\t$(\".btnType09\").css(\"color\", $(\"input[name=colorView]\").val());\r\n\t\t\t\tvar page = $('#curPage').val();\r\n\t\t\t\tsetCardBtnTitle(\"\");\r\n\t\t\t\t//$('#'+page+'Btn').focus();\r\n\t\t\t} else {\r\n\t\t\t\t$(\".bottomBtn\").addClass(\"btnDis\");\r\n\t\t\t\t$(\".btnType09\").css(\"color\", \"\");\r\n\t\t\t\t$(\"#CardBtn\").attr(\"title\",\"\");\r\n\t\t\t\t$(this).focus();\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n});\r\n\r\n// 손실보험에서 엔터를 클릭했을경우\r\njQuery(document).on(\"keydown\",\"#inputChk6\", function(e){\r\n\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\tif (13 == keycode){\r\n\t\te.stopPropagation();\r\n\t\te.preventDefault();\r\n\t\t\r\n\t\tjQuery(\"#inputChk6\").trigger(\"click\");\r\n\t}\r\n});\r\n\r\n//2016.05.04  WCCHOI\r\n//DESC :약관동의 자세히보기 첫번째 엔터키입력했을때 \r\n$(document).on(\"keydown\",'#aDetailView1', function(e){\r\n\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\tvar lang = $('#payForm').find(\"[name=languageView]\").val();\r\n\tvar mobilians = $(\"#mobilians\").val();\r\n\tvar url = \"https://plugin.inicis.com/html60/main/01_Information\";\r\n\t\r\n\tif(\"ko\" == lang ){\r\n\t\turl+= \".html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnPayAgree.html\";\r\n\t\t}\r\n\t}else if(\"en\" == lang){\r\n\t\turl+= \"_en.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnPayAgreeEn.html\";\r\n\t\t}\r\n\t}else if(\"cn\" == lang){\r\n\t\turl+= \"_cn.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnPayAgreeCn.html\";\r\n\t\t}\r\n\t}\r\n\t\r\n\tif (13 == keycode){\r\n\t\te.stopPropagation();\r\n\t\te.preventDefault();\r\n\t\twindow.open(url, \"stdOpen\", \"scrollbars = yes, width=1000, height=580\");\r\n\t}\r\n});\r\n\r\n//2016.05.04  WCCHOI\r\n//DESC :약관동의 자세히보기 두번째 엔터키입력했을때 \r\n$(document).on(\"keydown\",'#aDetailView2', function(e){\r\n\tvar lang = $('#payForm').find(\"[name=languageView]\").val();\r\n\tvar url = \"https://plugin.inicis.com/html60/main/02_Information\";\r\n\tvar mobilians = $(\"#mobilians\").val();\r\n\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\tif(\"ko\" == lang){\r\n\t\turl+= \".html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnSocialAgree.html\";\r\n\t\t}\r\n\t}else if(\"en\" == lang){\r\n\t\turl+= \"_en.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnSocialAgreeEn.html\";\r\n\t\t}\r\n\t}else if(\"cn\" == lang){\r\n\t\turl+= \"_cn.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnSocialAgreeCn.html\";\r\n\t\t}\r\n\t}\r\n\t\r\n\tif (13 == keycode){\r\n\t\te.stopPropagation();\r\n\t\te.preventDefault();\r\n\t\twindow.open(url, \"stdOpen\", \"scrollbars = yes, width=450, height=580\");\r\n\t}\r\n});\r\n\r\n//2016.05.04  WCCHOI\r\n//DESC :약관동의 자세히보기 세번째 엔터키입력했을때 \r\n$(document).on(\"keydown\",'#aDetailView3', function(e){\r\n\tvar lang = $('#payForm').find(\"[name=languageView]\").val();\r\n\tvar url = \"https://plugin.inicis.com/html60/main/03_Information\";\r\n\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\tvar mobilians = $(\"#mobilians\").val();\r\n\t\r\n\tif(\"ko\" == lang){\r\n\t\turl+= \".html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnInfoAgree.html\";\r\n\t\t}\r\n\t}else if(\"en\" == lang){\r\n\t\turl+= \"_en.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnInfoAgreeEn.html\";\r\n\t\t}\r\n\t}else if(\"cn\" == lang){\r\n\t\turl+= \"_cn.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnInfoAgreeCn.html\";\r\n\t\t}\r\n\t}\r\n\t\r\n\tif (13 == keycode){\r\n\t\te.stopPropagation();\r\n\t\te.preventDefault();\r\n\t\twindow.open(url, \"stdOpen\", \"scrollbars = yes, width=1000, height=580\");\r\n\t}\r\n});\r\n\r\n//2016.05.04  WCCHOI\r\n//DESC :약관동의 자세히보기 네번째 엔터키입력했을때 \r\n$(document).on(\"keydown\",'#aDetailView4', function(e){\r\n\tvar lang = $('#payForm').find(\"[name=languageView]\").val();\r\n\tvar url = \"https://plugin.inicis.com/html60/main/04_Information\";\r\n\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\tvar mobilians = $(\"#mobilians\").val();\r\n\tif(\"ko\" == lang){\r\n\t\turl+= \".html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnInfoUse.html\";\r\n\t\t}\r\n\t}else if(\"en\" == lang){\r\n\t\turl+= \"_en.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnInfoUseEn.html\";\r\n\t\t}\r\n\t}else if(\"cn\" == lang){\r\n\t\turl+= \"_cn.html\";\r\n\t\tif(mobilians === 'true'){\r\n\t\t\turl=\"https://mup.mobilians.co.kr/terms/cnInfoUseCn.html\";\r\n\t\t}\r\n\t}\r\n\t\r\n\tif (13 == keycode){\r\n\t\te.stopPropagation();\r\n\t\te.preventDefault();\r\n\t\twindow.open(url, \"stdOpen\", \"scrollbars = yes, width=1000, height=580\");\r\n\t}\r\n});\r\n\r\n//2017.02.24 kyb\r\n//DESC :약관동의 자세히보기 다섯번째 엔터키입력했을때 \r\n$(document).on(\"keydown\",'#aDetailView5', function(e){\r\n\tvar lang = $('#payForm').find(\"[name=languageView]\").val();\r\n\tvar url = \"https://plugin.inicis.com/html60/main/06_Information\";\r\n\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\tif(\"ko\" == lang){\r\n\t\turl+= \".html\";\r\n\t}else if(\"en\" == lang){\r\n\t\turl+= \"_en.html\";\r\n\t}else if(\"cn\" == lang){\r\n\t\turl+= \"_cn.html\";\r\n\t}\r\n\t\r\n\tif (13 == keycode){\r\n\t\te.stopPropagation();\r\n\t\te.preventDefault();\r\n\t\twindow.open(url, \"stdOpen\", \"scrollbars = yes, width=1000, height=580\");\r\n\t}\r\n});\r\n\r\n//삼성페이 호출 함수\r\nfunction callSSP(){\r\n\t\r\n\tif($payForm.find(\"[name=currency]\").val() == 'USD'){\r\n\t\tjAlert(\"결제를 위한 통화코드가 원화가 아닙니다.\\n신용카드 결제를 이용해주세요.\", \"KG 이니시스\", function() {\r\n\t\t\tif($payForm.find(\"input[name=payPopup]\").val() == '2') {\r\n\t\t\t\tvar closeUrl = $payForm.find(\"[name=closeUrl]\").val();\r\n\t\t\t\tlocation.href = closeUrl;\r\n\t\t\t}\r\n\t\t});\r\n\t\treturn;\r\n\t}\r\n\t\r\n\t//1000원미만 결제여부 확인\r\n\tif(below1000Check() != \"Y\"){\r\n\t\t return;\r\n\t }\r\n\t\r\n\tvar acceptmethod = $payForm.find(\":input[name=acceptmethod]\").val();\r\n\tshowLoading();\r\n\t\tjQuery.ajax({\r\n\t\t\tasyn : true\r\n\t\t\t, url:'/jsApi/ssp/verify'\r\n\t\t\t, data : $payForm.serialize()+\"&scriptDate=\"+(new Date()).getTime()\r\n\t\t\t, type : \"POST\"\r\n\t\t\t, dataType:\"json\"\r\n\t\t\t, contentType:\"application/x-www-form-urlencoded;charset=UTF-8\"\r\n\t\t\t, success:function(jsonData, staus,jqXHR){\r\n\t\t\t\t\r\n\t\t\t\t//console.log(jsonData);\r\n//\t\t\t\talert(\"123123123123===\"+jsonData['resultCode'] );\r\n\t\t\t\t\t\r\n\t\t\t\t\t// 정상 통신\r\n\t\t\t\tvar code = jsonData['resultCode']; \r\n\t\t\t\t\tif(jsonData['resultCode'] == '0000'){\r\n\r\n\t\t\t\t\t\t$payForm.find(\"input[name=sspRequest]\").val(jsonData['sspRequest']);\r\n\t\t\t\t\t\t$payForm.find(\"input[name=sspResponse]\").val(jsonData['sspResponse']);\r\n\t\t\t\t\t\t$payForm.find(\"input[name=checkNoInt]\").val(jsonData['checkNoInt']);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tvar w = 400;\r\n\t\t\t\t\t\tvar h = 660;\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tif($payForm.find(\"input[name=acceptmethod]\").val().indexOf(\"useoverlay\") > -1){\r\n\t\t\t\t\t\t\t//iframe방식\r\n\t\t\t\t\t\t\tsetIframe();\r\n\t\t\t\t\t\t\t\r\n//\t\t\t\t\t\t\tjQuery(\"#overlay_subWapper .overlayFrame\").attr(\"src\",\"\");\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t//카드사 창 센터로\r\n\t\t\t\t\t\t\tvar m = -53;\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tjQuery(\"#overlay_subWapper .overlayFrame\").css({\"width\": w + \"px\",\"height\": h + \"px\"});\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tjQuery(\"#overlay_subWapper\").css({\"margin\": m +\"px auto\"});\r\n\t\r\n\t\t\t\t\t\t\tjQuery(\"#overlay_subWapper\").css({\"width\":(jQuery(\"#overlay_subWapper .overlayFrame\").width()+2)+\"px\",\"height\":(jQuery(\"#overlay_subWapper .overlayFrame\").height()+37)+\"px\"});\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\thideLoading();\r\n\t\t\t\t\t\t\toverlayOnOff(true);\r\n\t\r\n\t\t\t\t\t\t\t$payForm.attr(\"target\",\"overlayFrame\");\r\n\t\t\t\t\t\t\tif(jsonData['sspVersion'] == \"v2\"){\r\n\t\t\t\t\t\t\t\t$payForm.attr(\"action\",\"/payAuthentication/sspV2\");\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t$payForm.attr(\"action\",\"/payAuthentication/ssp\");\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t$payForm.trigger(\"submit\");\r\n\t\t\t\t\t\t\tvar intervalcnt = 0; \r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tvar setInter = setInterval(function(){\r\n\t\t\t\t\t\t\t\tintervalcnt ++;\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\tif(jQuery('#overlayFrame').length > 0) {\r\n\t\t\t\t\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\t\t\t\t\tsetIframeCloseBtn();\r\n\t\t\t\t\t\t\t\t\tjQuery('#overlayFrame').attr(\"tabindex\", \"399\");\r\n\t\t\t\t\t\t\t\t}else if(intervalcnt > 5)\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t},1000);\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tvar win = '';\r\n\t\t\t\t\t\t\t// Fixes dual-screen position                         Most browsers      Firefox\r\n\t\t\t\t\t\t    var dualScreenLeft = window.screenLeft != undefined ? window.screenLeft : screen.left;\r\n\t\t\t\t\t\t    var dualScreenTop = window.screenTop != undefined ? window.screenTop : screen.top;\r\n\t\t\r\n\t\t\t\t\t\t    width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n\t\t\t\t\t\t    height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\t\t\r\n\t\t\t\t\t\t    var left = ((width / 2) - (w / 2)) + dualScreenLeft;\r\n\t\t\t\t\t\t    var top = ((height / 2) - (h / 2)) ;\r\n\t\t\t\t\t\t\t    \r\n\t\t