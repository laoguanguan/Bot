.07.05\r\n\t//DESC : goOpenWindow 일때 엔터키로 새창열기\r\n\t$(document).on(\"keydown\", \".goOpenWindow\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\t\tvar mobilians = $(\"#mobilians\").val();\r\n\t\t\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\twindow.open($(this).attr(\"src\"), \"stdOpen\", \"width=1000,height=580,scrollbars = yes,resizable = yes\");\r\n\t\t}\r\n\t});\t\t\t\r\n\t\r\n\t// 새창 열기\r\n\tjQuery(document).on(\"click\",\".goOpenWinBook\", function(){\r\n\t\twindow.open(jQuery(this).attr(\"src\"),\"stdOpen\",\"width=1100,height=680,scrollbars = yes,resizable = yes\");\r\n\t});\r\n\t\r\n\t// 새창 열기\r\n\tjQuery(document).on(\"click\",\".goOpenPopup\", function(){\r\n\t\twindow.open(jQuery(this).attr(\"src\"),\"stdOpen\",\"width=746,height=543,scrollbars = yes,resizable = yes\");\r\n\t});\r\n\t\r\n\t// 새창 열기\r\n\tjQuery(document).on(\"click\",\".goOpenPopupNew\", function(){\r\n\t\tvar width = ($(this).attr(\"pop_width\") != undefined) ? $(this).attr(\"pop_width\") : \"1000\";\r\n\t\tvar height = ($(this).attr(\"pop_height\") != undefined) ? $(this).attr(\"pop_height\") : \"580\";\r\n\t\twindow.open($(this).attr(\"src\"), \"stdOpen\", \"width=\" + width + \",height=\" + height + \",scrollbars = yes,resizable = yes\");\r\n\t});\r\n\t\r\n\t$(document).on(\"keydown\", \".goOpenPopupNew\", function(e){\r\n\t\tvar keycode = (e.keyCode ? e.keyCode : e.which);\r\n\t\tif (13 == keycode){\r\n\t\t\te.stopPropagation();\r\n\t\t\te.preventDefault();\r\n\t\t\t$(this).trigger(\"click\");\r\n\t\t}\r\n\t});\r\n\r\n\t// 새창 열기\r\n\tjQuery(document).on(\"click\",\".goOpenCulture\", function(){\r\n\t\tshowLoading();\r\n\t\twin = window.open(jQuery(this).attr(\"src\"),\"stdOpen\",\"width=422,height=387,scrollbars = no,resizable = no\");\r\n\t\tvar setInter = setInterval(function(){\r\n//\t\t\twin.focus();\r\n\t\t\tif(typeof(win)=='undefined' || win.closed) {\r\n\t\t\t\tclearInterval(setInter);\r\n\t\t\t\t\thideLoading();\r\n\t\t\t}\r\n\r\n\t\t},2000);\r\n\t});\r\n\r\n\t//약관 동의 자세히보기 이벤트\r\n\tjQuery(document).on(\"click\",\".goDetailView1\", function(){\r\n\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\t\tvar goURL = \"\"\r\n\t\tvar mobilians = $(\"#mobilians\").val();\r\n\r\n\t\tif(languageView == \"ko\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/01_Information.html\";\r\n\t\t\tif(mobilians === 'true'){\r\n\t\t\t\tgoURL=\"https://mup.mobilians.co.kr/terms/cnPayAgree.html\";\r\n\t\t\t}\r\n\t\t}else if(languageView == \"en\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/01_Information_en.html\";\r\n\t\t\tif(mobilians === 'true'){\r\n\t\t\t\tgoURL=\"https://mup.mobilians.co.kr/terms/cnPayAgreeEn.html\";\r\n\t\t\t}\r\n\t\t}else if(languageView == \"cn\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/01_Information_cn.html\";\r\n\t\t\tif(mobilians === 'true'){\r\n\t\t\t\tgoURL=\"https://mup.mobilians.co.kr/terms/cnPayAgreeCn.html\";\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\t//window.open(goURL,\"stdOpen\",\"scrollbars = yes\");\r\n\t\twindow.open(goURL, \"stdOpen\", \"scrollbars = yes, width=1000, height=580\");\r\n\r\n\t});\r\n\t\r\n\tjQuery(document).on(\"click\",\".goDetailView2\", function(){\r\n\t\tvar languageView = $payForm.find(\"[name=languageView]\").val();\r\n\t\tvar goURL = \"\"\r\n\t\tvar mobilians = $(\"#mobilians\").val();\r\n\t\t\r\n\t\tif(languageView == \"ko\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/02_Information.html\";\r\n\t\t\tif(mobilians === 'true'){\r\n\t\t\t\tgoURL=\"https://mup.mobilians.co.kr/terms/cnSocialAgree.html\";\r\n\t\t\t}\r\n\t\t}else if(languageView == \"en\"){\r\n\t\t\tgoURL=\"https://plugin.inicis.com/html60/main/02_Information_en.html\";\r\n\t\t\tif(mobilians === 'true'){\r\n\t\t\t\tgoURL=\"https://mup.mobilians.co.kr/terms/cnSocialAgreeEn.html\";\r\n\t\t\t}\r\n\t\t}else if(languageView == \"cn