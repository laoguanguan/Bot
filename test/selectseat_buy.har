            "text": "/**\r\n * 예매자 부가 정보 입력 수정 조회 관련 스크립트 모음.\r\n * since 16-11-23\r\n */\r\n\r\nif(window['$dom'] == void 0){ //old browser's window has object check\r\n\tvar $dom = {};\r\n\t$dom.addInfo = {};\r\n}\r\n\r\nvar _els = {};\r\n// _els.tempInputField = 'tempInputField';\r\n// _els.tempInputFieldLabel = 'tempInputFieldLabel';\r\n_els.userInputField = 'userInputField';\r\n_els.userInputFieldLabel = 'userInputFieldLabel';\r\n// addInfo 생성\r\n_els.addInfo = 'addInfo';\r\n_els.addInfoTitle = 'addInfoTitle';\r\n_els.addInfoInputFieldList = 'addInfoInputFieldList';\r\n_els.addInfoInputFieldListTemplate = 'addInfoInputFieldListTemplate';\r\n_els.addInfoNotice = 'addInfoNotice';\r\n_els.chkAgree04 = 'chkAgree04';\r\n_els.name = {};\r\n_els.name.userInputField = 'userInputField';\r\n_els.clazz = {};\r\n_els.clazz.inputFieldName = 'inputFieldName';\r\n_els.httpsApi = DeployPhaseUtils.convertUrl(\"https://tktapi.melon.com\");\r\n\r\n//예매자 부가 정보 관련 내용 정리\r\nvar addInfo = {};\r\naddInfo.ui = {};\r\naddInfo.form = {};\r\n//예매자 부가 정보 Input 생성\r\naddInfo.ui.createAddInfoRow = function(cmd,data,seq,isFirst,isLast){\r\n\tvar _$row;\r\n\tvar _tempAddInfoInput = $dom.addInfo.addInfoInputFieldListTemplate;\r\n\tif (_tempAddInfoInput.find(\".\" + data.fieldCode).length > 0) {\r\n\t\t_$row = $(_tempAddInfoInput.find(\".\" + data.fieldCode)[0]).clone();\r\n\t} else {\r\n\t\t// 코드 매핑이 안되면 기본 세팅으로 설정\r\n\t\t_$row = $(_tempAddInfoInput.find(\".TA_temp\")[0]).clone();\r\n\t}\r\n\r\n\tvar _this = this;\r\n\t_this.renderDefault = function() {\r\n\t\t// 라벨 등록\r\n\t\tvar inputFieldLabelEle = _$row.find(\".inputFieldName\")[0];\r\n\t\tinputFieldLabelEle.innerHTML = data.fieldName;\r\n\r\n\t\t// input,select 찾고 ID,NAME 설정\r\n\t\tvar liClassName = _$row.attr('class').split(\" \")[1];\r\n\t\tfor (var i = 0; i < _$row.find(\"input, select\").length; i++) {\r\n\t\t\t_$row.find(\"input, select\")[i].id = _els.userInputField + '_' + data.fieldSeq + \"_\" + i;\r\n\t\t\t_$row.find(\"input, select\")[i].name = _els.name.userInputField + \"_\" + data.fieldSeq;\r\n\t\t\t_$row.find(\"input, select\")[i].setAttribute('data-field-seq', data.fieldSeq);\r\n\t\t\t_$row.find(\"input, select\")[i].setAttribute('data-field-code', data.fieldCode);\r\n\t\t\t$(_$row.find(\"input[type='radio']\")[i]).parent().find(\"label\").attr(\"for\", _els.userInputField + '_' + data.fieldSeq + \"_\" + i);\r\n\t\t}\r\n\t\treturn _$row;\r\n\t};\r\n\t_this.renderDelvy = function(){\r\n\t\treturn _this.renderDefault();\r\n\t};\r\n\t_this.renderFinish = function(){\r\n\t\t_$row = $dom.addInfo.addInfoInputFieldListTemplate.clone();\r\n\t\t_$row.find('li')[0].innerHTML = data.fieldName + ' : ' + addInfo.form.xsscheck(data.userValue,1);\r\n\t\treturn _$row.html();\r\n\t};\r\n\t_this.renderRsrvDetail = function(){\r\n\t\t// 마이티켓 > 예매확인/취소 화면\r\n\t\t_$row = $dom.addInfo.addInfoInputFieldListTemplate.clone();\r\n\t\tvar inputFieldLabelEle = _$row.find('th')[0];\r\n\t\tvar userInputFieldEle  = _$row.find('td')[0];\r\n\t\tinputFieldLabelEle.innerHTML = data.fieldName;\r\n\t\tuserInputFieldEle.innerHTML  = addInfo.form.xsscheck(data.userValue,1);\r\n\t\tif(isFirst || isLast){\r\n\t\t\tvar className = isFirst ? 'fst' : (isLast ? 'lst' : '');\r\n\t\t\tinputFieldLabelEle.classList.add(className)\r\n\t\t\tuserInputFieldEle.classList.add(className)\r\n\t\t}\r\n\t\treturn _$row.html();\r\n\t};\r\n\t_this.renderChangeAddInfo = function() {\r\n\t\t// 마이티켓 > 예매확인/취소 > 예매자 부가정보 변경 화면\r\n\t\tresutl = _this.renderDefault();\r\n\t\tif (data.fieldCode === \"TA0001\") {\r\n\t\t\tvar _arr = data.userValue.split(\"-\")\r\n\t\t\tfor (var i = 0; i < _arr.length; i++) {\r\n\t\t\t\tresutl.find(\"select\")[i].value = _arr[i];\r\n\t\t\t}\r\n\t\t} else if (data.fieldCode === \"TA0003\") {\r\n\t\t\tresutl.find(\"input[type='radio']:input[value='\"+ data.userValue +\"']\").prop(\"checked\", true);\r\n\t\t} else if (data.fieldCode === \"TA0010\") {\r\n\t\t\tvar _arr = data.userValue.split(\" \")\r\n\t\t\tfor (var i = 0; i < _arr.length; i++) {\r\n\t\t\t\tresutl.find(\"input, select\")[i].value = _arr[i];\r\n\t\t\t}\r\n\t\t} else if (data.fieldCode === \"TA0011\") {\r\n\t\t\tvar _arr = data.userValue.split(\"@\")\r\n\t\t\tfor (var i = 0; i < _arr.length; i++) {\r\n\t\t\t\tresutl.find(\"input\")[i].value = _arr[i];\r\n\t\t\t}\r\n\t\t}else {\r\n\t\t\tresutl.find(\"input, select\").val(data.userValue);\r\n\t\t}\r\n\r\n\t\treturn resutl;\r\n\t};\r\n\tvar render;\r\n\tswitch(cmd){\r\n\tcase 'delvy'\t\t: render = _this.renderDelvy;\t\t\tbreak;\r\n\tcase 'finish'\t\t: render = _this.renderFinish;\t\t\tbreak;\r\n\tcase 'rsrvDetail'\t: render = _this.renderRsrvDetail;\t\tbreak;\r\n\tcase 'changeAddInfo': render = _this.renderChangeAddInfo;\tbreak;\r\n\tdefault\t\t\t\t: render = function(){ if( window.console ){ console.log('dev log :: cmd \\'{}\\' is not defined.',cmd); } return false; }; break;\r\n\t}\r\n\treturn render();\r\n};\r\naddInfo.ui.toggleAddInfo = function(cmd,isOn){\r\n\tvar _this = this;\r\n\t_this.renderDefault = function(){\r\n\t\tvar disp = isOn ? '' : 'none';\r\n\t\t$dom.addInfo.addInfo[0].style.display = disp;\r\n\t};\r\n\t_this.renderDelvy = function(){\r\n\t\t_this.renderDefault();\r\n\t};\r\n\t_this.renderFinish = function(){\r\n\t\t_this.renderDefault();\r\n\t};\r\n\t_this.renderRsrvDetail = function(){\r\n\t\t_this.renderDefault();\r\n\t};\r\n\t_this.renderChangeAddInfo = function(){\r\n\t\t//토글 없음.\r\n\t};\r\n\tvar render;\r\n\tswitch(cmd){\r\n\tcase 'delvy'\t\t: render = _this.renderDelvy;\t\t\tbreak;\r\n\tcase 'finish'\t\t: render = _this.renderFinish;\t\t\tbreak;\r\n\tcase 'rsrvDetail'\t: render = _this.renderRsrvDetail;\t\tbreak;\r\n\tcase 'changeAddInfo': render = _this.renderChangeAddInfo;\tbreak;\r\n\tdefault\t\t\t\t: render = function(){ if( window.console ){ console.log('dev log :: cmd \\'{}\\' is not defined.',cmd); } return false; }; break;\r\n\t}\r\n\treturn render();\r\n};\r\n// 예매자 부가정보 타이틀 세팅\r\naddInfo.ui.renderingAddInfoTitle = function(cmd,addInfoData){\r\n\tvar _this = this;\r\n\t_this.renderDefalut = function(){\r\n\t\t$dom.addInfo.addInfoTitle[0].innerHTML = addInfo.form.addInfo.title;\r\n\t};\r\n\t_this.renderDelvy = function(){\r\n\t\t_this.renderDefalut();\r\n\t};\r\n\t_this.renderFinish = function(){\r\n\t\t_this.renderDefalut();\r\n\t};\r\n\t_this.renderRsrvDetail = function(){\r\n\t\tvar ADD_INFO_TITLE_SUFFIX = '';\r\n\t\t$dom.addInfo.addInfoTitle[0].innerHTML = addInfo.form.addInfo.title + ADD_INFO_TITLE_SUFFIX;\r\n\t};\r\n\t_this.renderChangeAddInfo = function(){\r\n\t\t//제목 입력이 없음.\r\n\t};\r\n\tvar render;\r\n\tswitch(cmd){\r\n\tcase 'delvy'\t\t: render = _this.renderDelvy;\t\t\tbreak;\r\n\tcase 'finish'\t\t: render = _this.renderFinish;\t\t\tbreak;\r\n\tcase 'rsrvDetail'\t: render = _this.renderRsrvDetail;\t\tbreak;\r\n\tcase 'changeAddInfo': render = _this.renderChangeAddInfo;\tbreak;\r\n\tdefault\t\t\t\t: render = function(){ if( window.console ){ console.log('dev log :: cmd \\'{}\\' is not defined.',cmd); } return false; }; break;\r\n\t}\r\n\treturn render();\r\n};\r\n// 예매자 부가정보 Input 박스 세팅\r\naddInfo.ui.renderingAddInfoList = function(cmd,addInfoData){\r\n\tif(addInfo.form.addInfo.inputFields == undefined || addInfo.form.addInfo.inputFields.length == undefined || addInfo.form.addInfo.inputFields.length <= 0){\r\n\t\treturn false;\r\n\t}\r\n\r\n\t// input 기본 데이터 세팅\r\n\taddInfo.form.setInputData();\r\n\r\n\tvar renderHtmlStr = '';\r\n\tvar listLength = addInfo.form.addInfo.inputFields.length;\r\n\taddInfo.form.addInfo.inputFields.forEach(function(data,idx){\r\n\t\tvar isFirst = idx == 0 ? true : false;\r\n\t\tvar isLast = idx == listLength -1 ? true : false;\r\n\t\tvar _$row = addInfo.ui.createAddInfoRow(cmd,data,idx+1,isFirst,isLast);\r\n\t\t//renderHtmlStr += _$row.html();\r\n\t\t$dom.addInfo.addInfoInputFieldList.append(_$row);\r\n\r\n\t});\r\n\r\n\t// html input maxlength 말을 안들어 처먹음\r\n\t$dom.addInfo.addInfoInputFieldList.find(\".inp_txt\").keyup(function(){\r\n\t\tif ($(this).val().length > $(this).attr('maxlength')) {\r\n\t\t\t$(this).val($(this).val().substr(0, $(this).attr('maxlength')));\r\n\t\t}\r\n\t});\r\n\r\n\t// html 숫자만 입력 받자\r\n\t$dom.addInfo.addInfoInputFieldList.find(\"input:text[numberOnly]\").on(\"blur keyup\", function(e) {\r\n\t\tvar regExp = /[^0-9]/g;\r\n\t\tvar ele = e.target;\r\n\t\tif (regExp.test(ele.value)) {\r\n\t\t\tele.value = ele.value.replace(regExp, '');\r\n\t\t}\r\n\t});\r\n\r\n\t// // 한글 입력 방지\r\n\t$dom.addInfo.addInfoInputFieldList.find(\"input:text[hangeulNotOnly]\").on(\"blur keyup\", function(e) {\r\n\t\tif (!(e.keyCode >=37 && e.keyCode<=40)) {\r\n\t\t\tvar regExp = /[ㄱ-ㅎ|ㅏ-ㅣ|가-힣]/g;\r\n\t\t\tvar ele = e.target;\r\n\t\t\tif(regExp.test(ele.value)){\r\n\t\t\t\tele.value = ele.value.replace(regExp, '');\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\r\n\t// //  스페이스 방지\r\n\t$dom.addInfo.addInfoInputFieldList.find(\"input:text[spaceNotOnly]\").on(\"blur keyup\", function(e) {\r\n\t\tif (!(e.keyCode >=37 && e.keyCode<=40)) {\r\n\t\t\tvar regExp = /\\s/g;\r\n\t\t\tvar ele = e.target;\r\n\t\t\tif(regExp.test(ele.value)){\r\n\t\t\t\tele.value = ele.value.replace(regExp, '');\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\r\n\t//$dom.addInfo.addInfoInputFieldList.html(renderHtmlStr);\r\n\taddInfo.ui.toggleAddInfo(cmd,true);\r\n};\r\n\r\naddInfo.ui.renderingAddInfoNotice = function(cmd,addInfoData){\r\n\r\n\tif( addInfoData.data === null || !(addInfoData.data.ntsEnTitle || addInfoData.data.ntsEnText || addInfoData.data.agreeEnText) ){\r\n\t\treturn false;\r\n\t}\r\n\r\n\tvar _this = this;\r\n\t_this.renderDefault = function(){\r\n\r\n\t\t// 엔터 구분값 분리후 <li> 적용\r\n\t\tvar testArray = addInfoData.data.ntsEnText.split('\\n');\r\n\t\tntsTestStr = \"\";\r\n\t\tfor (var i = 0; i <testArray.length; i++) {\r\n\t\t\tntsTestStr += \"<li>\" + addInfo.form.xsscheck(testArray[i],1) + \"</li>\";\r\n\t\t}\r\n\r\n\t\t$($dom.addInfo.addInfoNotice[0]).css(\"display\",\"\");\r\n\t\t$($dom.addInfo.addInfoNotice[0]).find(\".box-notice-title\")[0].innerHTML = addInfo.form.xsscheck(addInfoData.data.ntsEnTitle,1);\r\n\t\t$($dom.addInfo.addInfoNotice[0]).find(\".box-notice-list\")[0].innerHTML = ntsTestStr\r\n\t\t$($dom.addInfo.addInfoNotice[0]).find(\"#notice-check\")[0].title = addInfo.form.xsscheck(addInfoData.data.agreeEnText,1);\r\n\t\t$($dom.addInfo.addInfoNotice[0]).find(\"#notice-check\")[0].setAttribute('data-use-yn', \"Y\");\r\n\t\t$($dom.addInfo.addInfoNotice[0]).find(\".txt_lab\")[0].innerHTML = addInfo.form.xsscheck(addInfoData.data.agreeEnText,1);\r\n\t};\r\n\t_this.renderDelvy = function(){\r\n\t\t_this.renderDefault();\r\n\t};\r\n\t_this.renderFinish = function(){\r\n\t\t_this.renderDefault();\r\n\t};\r\n\t_this.renderRsrvDetail = function(){\r\n\t\t_this.renderDefault();\r\n\t};\r\n\t_this.renderChangeAddInfo = function(){\r\n\t\t//유의 사항 정보 없음.\r\n\t};\r\n\r\n\tvar render;\r\n\tswitch(cmd){\r\n\t\tcase 'delvy'\t\t: render = _this.renderDelvy;\t\t\tbreak;\r\n\t\tcase 'finish'\t\t: render = _this.renderFinish;\t\t\tbreak;\r\n\t\tcase 'rsrvDetail'\t: render = _this.renderRsrvDetail;\t\tbreak;\r\n\t\tcase 'changeAddInfo': render = _this.renderChangeAddInfo;\tbreak;\r\n\t\tdefault\t\t\t\t: render = function(){ if( window.console ){ console.log('dev log :: cmd \\'{}\\' is not defined.',cmd); } return false; }; break;\r\n\t}\r\n\treturn render();\r\n\r\n};\r\naddInfo.ui.renderingAddInfo = function(cmd,addInfoData){\r\n\taddInfo.ui.renderingAddInfoTitle(cmd,addInfoData);\r\n\taddInfo.ui.renderingAddInfoList(cmd,addInfoData);\r\n\taddInfo.ui.renderingAddInfoNotice(cmd,addInfoData);\r\n};\r\naddInfo.form.isUseAddInfo = function(data){\r\n\taddInfo.form.setUseAddInfo(data);\r\n\tvar res = (\"Y\" == data.addInfoYn) ? true : false;\r\n\treturn res;\r\n};\r\naddInfo.form.srvT; //srvTime timestamp\r\naddInfo.form.setLastServerTimeTimestamp = function(timeStr){\r\n\taddInfo.form.srvT = addInfo.form.getTimestamp(timeStr);\r\n};\r\naddInfo.form.getLastServerTimeTimestamp = function(){\r\n\treturn addInfo.form.srvT || new Date(new Date().getTime() + timeMillisecondForkoreanGMT).toISOString().replace(/[-:T]/g,'').replace(/\\.(?:\\d{3})Z/g,'');\r\n};\r\naddInfo.form.getTimestamp = function(timeStr){\r\n\tvar _this = this;\r\n\t/**\r\n\t * via melon-ticket-www-web/src/main/webapp/WEB-INF/views/performance/index.jsp\r\n\t */\r\n\tvar timeMillisecondForkoreanGMT = 1000*60*60*9;\r\n\t_this.getSimpleTS = function(timeMillisecond) {\r\n\t\tvar resultStr = '';\r\n\t\tvar _date = (timeMillisecond == undefined ? new Date() : new Date(timeMillisecond + timeMillisecondForkoreanGMT));\r\n\t\ttry{\r\n\t\t    if (!_date.toISOString) {\r\n\t\t    \tresultStr = _this.getTS(_date);\r\n\t\t    }else if(_date.toISOString() == \"Invalid Date\"){\r\n\t            resultStr = _this.getTS(_date);\r\n\t\t    } else {\r\n\t\t\t    resultStr = _date.toISOString().replace(/[-:T]/g,'').replace(/\\.(?:\\d{3})Z/g,'');\r\n\t\t    }\r\n\t\t}catch(e){\r\n\t        resultStr = _this.getTS(_date);\r\n\t\t}\r\n\t\treturn resultStr;\r\n\t};\r\n\t/**\r\n\t * via melon-ticket-www-web/src/main/webapp/WEB-INF/views/performance/index.jsp\r\n\t */\r\n\t_this.getTS = function(date) {\r\n\t    if (isValidDate(date)) {\r\n\t        var month = date.getMonth() + 1;\r\n\t        var day = date.getDate();\r\n\t        var hours = date.getHours();\r\n\t        var minutes = date.getMinutes();\r\n\t        var seconds = date.getSeconds();\r\n\r\n\t        var strDate = date.getFullYear().toString()\r\n\t            + ((month < 10) ? '0' + month : month).toString()\r\n\t            + ((day < 10) ? '0' + day : day).toString()\r\n\t            + ((hours < 10) ? '0' + hours : hours).toString()\r\n\t            + ((minutes < 10) ? '0' + minutes : minutes).toString()\r\n\t            + ((seconds < 10) ? '0' + seconds : seconds).toString();\r\n\r\n\t        return strDate;\r\n\t    }\r\n\t    return null;\r\n\t};\r\n\tvar srvT;\r\n\ttry{\r\n\t\tvar srvTime = timeStr ? Date.parse(timeStr) : new Date().getTime(); //Date type\r\n\t\tsrvT = _this.getSimpleTS(srvTime); //srvTime timestamp\r\n\t}\r\n\tcatch(e){}\r\n\treturn srvT;\r\n};\r\naddInfo.form.addInfo = {};\r\naddInfo.form.addInfo.useAddInfo = 'N';\r\naddInfo.form.getUseAddInfo = function(data){\r\n\treturn addInfo.form.addInfo.useAddInfo;\r\n};\r\naddInfo.form.setUseAddInfo = function(data){\r\n\taddInfo.form.addInfo.useAddInfo = (\"Y\" == data.addInfoYn) ? 'Y' : 'N';\r\n};\r\naddInfo.form.isModifiableDispPeriodAddInfo = function(addInfoData){\r\n\tif(addInfo.form.addInfo.isModifiableDispPeriod == undefined ){\r\n\t\tif( window.console ){ console.log('dev log :: addInfo.form.addInfo.isModifiableDispPeriod is not defined'); }\r\n\t\treturn false;\r\n\t}\r\n\tvar res = (\"Y\" == addInfo.form.addInfo.isModifiableDispPeriod) ? true : false;\r\n\treturn res;\r\n};\r\naddInfo.form.parseAddInfo = function(cmd,inputDatas, addInfo){\r\n\tvar req= {};\r\n\r\n\tvar _this = this;\r\n\t_this.getDefault = function(req){\r\n\t\t//req.rsrvSeq = inputDatas.rsrvSeq; //reservation/servcie 안쪽에서 세팅\r\n\t\treq.prodId = inputDatas.prodId;\r\n\t\treq.scheduleNo = inputDatas.scheduleNo;\r\n\t\treq.priceNo = inputDatas.priceNo;\r\n\t\treq.userTermsYn = inputDatas.userTermsYn;\r\n\t\treturn req;\r\n\t};\r\n\t_this.getchangeAddInfo = function(req){\r\n\t\treq.rsrvSeq = inputDatas.rsrvSeq; //reservation/servcie 안쪽에서 세팅\r\n\t\treq.prodId = pId;\r\n\t\treq.scheduleNo = inputDatas.scheduleNo;\r\n\t\treq.priceNo = inputDatas.priceNo;\r\n\t\treq.userTermsYn = inputDatas.userTermsYn;\r\n\r\n\t\t//덮어 쓰는것 방지 코드\r\n\t\tif(inputDatas.rsrvSeq    ) { addInfo.rsrvSeq = undefined;     }\r\n\t\tif(inputDatas.scheduleNo ) { addInfo.scheduleNo = undefined;  }\r\n\t\tif(inputDatas.priceNo    ) { addInfo.priceNo = undefined;     }\r\n\t\tif(inputDatas.userTermsYn) { addInfo.userTermsYn = undefined; }\r\n\r\n\t\treturn req;\r\n\t};\r\n\tvar getter;\r\n\tswitch(cmd){\r\n\tcase 'delvy'\t\t: getter = _this.getDefault;\t\tbreak;\r\n\tcase 'changeAddInfo': getter = _this.getchangeAddInfo;\tbreak;\r\n\tdefault\t\t\t\t: ge