sion=' + m_sessionid + '&funcname=end&param1=&param2=';\n\tCallFunction(param, Ret_PayEND);\n}\n\n/**\n * 종료\n * @param {*} e \n */\nfunction Ret_PayEND(e) {\n\tvp_util.Write_ISP_Log(\"[Ret_PayEND]\", \"\");\n\tRemoveEvent();\n\tvar data = eval('(' + e.data + ')');\n\tif (data.resultcode == \"00\") {\n\t\tm_queryinstall_count = 0;\n\t\treplKvpCardCd(); VP_Ret_Pay(true);\n\t\thideDivPop();\n\t} else {\n\t\tvp_util.Write_ISP_Log(\"[Ret_PayEND]\", data.msg);\n\t\tm_queryinstall_count = 0;\n\t\thideDivPop();\n\t\tCancelVPPayment('99');\n\t}\n}\n\n\n/*-------------------------------- start post-------------------*/\n\n/**\n * 버전체크 (POST)\n * @param {*} resHttp \n */\nfunction Ret_CheckVersion_POST(resHttp) {\n\tif (m_eispprocess == \"CheckVersion\") {\n\t\tm_eispprocess = \"Ret_CheckVersion\";\n\t\tvar rtnData = resHttp.responseText;\n\t\tvar rtn = null;\n\t\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[CheckVersion_POST res status ]\", resHttp.status);\n\t\tif (undefined != resHttp.readyState) vp_util.Write_ISP_Log(\"[CheckVersion_POST res readyState ]\", resHttp.readyState);\n\t\tvp_util.Write_ISP_Log(\"[CheckVersion_POST res Data]\", resHttp.responseText);\n\n\t\tif (rtnData != null && rtnData != undefined) {\n\t\t\tif (typeof jQuery !== \"undefined\") rtn = jQuery.parseJSON(rtnData);\n\t\t\telse if (typeof parent.jQuery !== \"undefined\") rtn = parent.jQuery.parseJSON(rtnData);\n\t\t\tif (rtn.status != undefined) vp_util.Write_ISP_Log(\"[CheckVersion_POST result]\", rtn.status);\n\t\t\tif (rtn.status == 'S_OK') {\n\t\t\t\tvar c_version = rtn.reply.VPWalletLauncherC;\n\t\t\t\tvar s_version = rtn.reply.VPWalletService;\n\t\t\t\tif (c_version != undefined && c_version != null) c_version = c_version.split('.').join('');\n\t\t\t\tif (s_version != undefined && s_version != null) s_version = s_version.split('.').join('');\n\t\t\t\tvar reasonUpdate = \"\";\n\t\t\t\tif (m_min_c_version > c_version || m_min_s_version > s_version) reasonUpdate = \"minVersion\";\n\t\t\t\telse if ((m_current_c_version > c_version || m_current_s_version > s_version) && m_update_flag == true) reasonUpdate = \"lowVersion\";\n\t\t\t\tif (reasonUpdate != \"\") {\n\t\t\t\t\tm_update_flag = false;\n\t\t\t\t\tvp_util.Write_ISP_Log(\"[InstallPageCall POST]\", reasonUpdate);\n\t\t\t\t\trestartPayment('VersionUpdate');\n\t\t\t\t} else {\n\t\t\t\t\tif (m_eISPErrorStep != 'MakeSession' && m_eISPErrorStep != 'SetData') {\n\t\t\t\t\t\tvp_ispplus_install.CloseLoadingUI();\n\t\t\t\t\t\tvp_ispplus_install.OpenLoadingUI();\n\t\t\t\t\t}\n\t\t\t\t\tclearInterval(m_checkinstall_timer);\n\t\t\t\t\tMakeSession_POST();\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif (rtn.reply.ErrCode != undefined) vp_util.Write_ISP_Log(\"[CheckVersion_POST res ErrCode]\", rtn.reply.ErrCode);\n\t\t\t\tif (rtn.reply.ErrMsg != undefined) vp_util.Write_ISP_Log(\"[CheckVersion_POST res ErrMsg]\", rtn.reply.ErrMsg);\n\t\t\t\tm_eispprocess = \"\";\n\t\t\t\trestartPayment('CheckVersion');\n\t\t\t}\n\t\t}\n\t\tvp_util.Write_ISP_Log(\"[Ret_CheckVersion_POST] m_eispprocess\", m_eispprocess);\n\t}\n}\n\n/**\n * Make Session (POST)\n */\nfunction MakeSession_POST() {\n\tm_eispprocess = \"MakeSession\";\n\tm_sessionid = makeSessionID();\n\tvar str = '{\"command\":\"makesession\",\"sessionid\":\"' + m_sessionid + '\",';\n\tstr += ' \"args\":{\"type\":\"sync\",\"target\":\"VPWalletLauncherC\",\"path\":\"VP\\\\\\\\VPWalletService\",\"needrd\":\"true\"}';\n\tstr += '}';\n\tvp_util.Write_ISP_Log(\"[MakeSession_POST] start, str : \", str);\n\tif (m_eispprocess == \"MakeSession\") sendProc('MakeSession', null, str, Ret_MakeSession_POST, ErrProc);\n}\n\n/**\n * Make Session (POST) 후작업\n * @param {*} resHttp \n */\nfunction Ret_MakeSession_POST(resHttp) {\n\ttry {\n\t\tif (m_eispprocess == 'MakeSession') {\n\t\t\tm_eispprocess = \"Ret_MakeSession\";\n\t\t\tvar rtnData = resHttp.responseText;\n\t\t\tvar rtn = null;\n\t\t\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[MakeSession_POST res status ]\", resHt