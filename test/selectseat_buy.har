          "cookies": [],
          "content": {
            "size": 28131,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"ko\" lang=\"ko\">\n<head>\n    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0], j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src= 'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f); })(window,document,'script','dataLayer','GTM-TFF7JZ5');</script>\n<title>Danal Payment</title>\n<!--<meta http-equiv=\"Content-Language\" content=\"ko\" />-->\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\"/>\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n<!--<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no,maximum-scale=1.0, minimum-scale=1.0\">-->\n<link rel=\"shortcut icon\" href=\"/creditcard_std_global/web/images/favicon.ico\">\n<link rel=\"stylesheet\" href=\"/creditcard_std_global/web/css/style.css?nocache=20260405210011\" />\n<link rel=\"stylesheet\" href=\"/creditcard_std_global/web/css/jquery-ui.min.css\" />\n<script type=\"text/javascript\">\n    var $SCRIPT_ROOT = \"/creditcard_std_global\";\n    \n        var resize_flag = 'Y';\n        if(resize_flag === 'Y'){\n            window.resizeTo(712, 565);\n        }\n    \n</script>\n<script src=\"/creditcard_std_global/web/js/jquery.min.js\" type=\"text/javascript\"></script>\n<script src=\"/creditcard_std_global/web/js/jquery.number.js\" type=\"text/javascript\"></script>\n<script src=\"/creditcard_std_global/web/js/jquery-ui.min.js\" type=\"text/javascript\"></script>\n<script src=\"/creditcard_std_global/web/js/creditcard_std.common.js?nocache=20260405210011\"></script>\n\n\n    <script src=\"/creditcard_std_global/web/js/placeholders.min.js\" type=\"text/javascript\"></script>\n    <script language=javascript src=\"https://www.vpay.co.kr/eISP/Wallet_layer_VP.js\"></script>\n</head>\n<body class=\"c00\" oncontextmenu='return false' onselectstart=\"return false\" ondragstart=\"return false\">\n<!-- WRAP -->\n<div id=\"wrap\">\n    \n<div class=\"input_w\">\n    <div class=\"header\">\n        <h1 id=\"ID_CI_IMG\">logo</h1> <!-- 100x47 -->\n        <span class=\"danal_tit\">Credit card</span>\n    </div>\n    <div class=\"terms_w\">\n        <div class=\"terms_all\">\n            <span class=\"tit\">Terms</span>\n            <button id=\"check00\" onclick=\"danalpaycard.web.terms_all_agree()\" tabindex=\"0\" title=\"전체동의 선택안됨\" aria-label=\"전체동의 선택안됨\" style=\"width:134px;\"><span></span> Agreed to all terms</button>\n        </div> <!-- 동의체크 button class=on -->\n        <ul class=\"terms_list\"  >\n            <li class=\"check_area\">\n                <input type=\"checkbox\" onclick=\"\" name=\"terms_agree\" id=\"terms01\" title=\"financial transactions agreement\" tabindex=\"0\"/>\n                <label for=\"terms01\"><span></span><div>financial transactions agreement</div></label>\n                <a href=\"#\" onclick=\"danalpaycard.web.terms_popup('1')\" tabindex=\"0\">Detail</a>\n            </li>\n            <li class=\"check_area\">\n                <input type=\"checkbox\" onclick=\"\" name=\"terms_agree\" id=\"terms02\" title=\"Sharing of personal information\" tabindex=\"0\"/>\n                <label for=\"terms02\"><span></span><div>Sharing of personal information</div></label>\n                <a href=\"#\" onclick=\"danalpaycard.web.terms_popup('3')\" tabindex=\"0\">Detail</a>\n            </li>\n            <li class=\"check_area\">\n                <input type=\"checkbox\" onclick=\"\" name=\"terms_agree\" id=\"terms03\" title=\"Consent for Use of personal information\"tabindex=\"0\"/>\n                <label for=\"terms03\"><span></span><div>Consent for Use of personal information</div></label>\n                <a href=\"#\" onclick=\"danalpaycard.web.terms_popup('2')\" tabindex=\"0\">Detail</a>\n            </li>\n        </ul>\n    </div>\n    <fieldset class=\"dis_b\" id=\"cardfield\">\n        <div class=\"card_select\">\n            <div class=\"select_area\" style=\"max-height: 200px; overflow: auto\">\n                <ul id=\"card_select_ul\"></ul>\n                <ul id=\"id_ali_ul\" style=\"margin-top: 10px;\"></ul>\n            </div>\n            <div class=\"card_info_tx\"><p>You cannot pay in installmaents with a card issued overseas </p>\n                <div class=\"card_info_w\">\n                    <span class=\"point_info\" id=\"id_point_info\" style=\"display: none;\"><em></em><a href=\"#\" tabindex=\"0\">포인트</a></span>\n                    <span class=\"interest_info\" id=\"id_noint_info\" style=\"display: none;\"><em></em><a href=\"#\" tabindex=\"0\">무이자</a></span>\n                </div>\n            </div>\n            <div id=\"id_card_w\" style=\"display:none\">\n                <div class=\"monthly_w\" >\n                <span class=\"card_info_tx\" style=\"padding:0px !important;\">\n                    <!-- <p id=\"id_union_text\" style=\"color:red\">* 국내에서 발급받은 유니온페이카드는 결제가 불가능하오니 국내카드 선택 후 결제해주세요.</p> -->\n                </span>\n                    <span id=\"id_quota_span\">\n                    <label class=\"cont_tit\">할부선택</label>\n                    <span class=\"select_box_w\" style=\"border: none;\">\n                            <label for=\"mon\" id=\"id_quota_text\"></label>\n                            <select name=\"quota\" id=\"mon\" class=\"select_box04_w\" title=\"할부선택\" tabindex=\"0\" >\n                            </select>\n                    </span>\n                </span>\n                    <div class=\"point_w check_point\" id=\"point_checkbox\" style=\"display: none\">\n                        <input type=\"checkbox\" onclick=\"\" name=\"point01\" id=\"point01\" tabindex=\"0\">\n                        <label for=\"point01\"><span></span> <pp id=\"id_point_name\">포인트</pp>사용<em>(포인트 사용금액은 청구할인)</em></label>\n                    </div>\n                </div>\n                <div class=\"email_w\">\n                    <label class=\"cont_tit\" for=\"id_email\">Email</label><input type=\"text\" id=\"id_email\" class=\"input_st01\" placeholder=\"Please enter your email address. (optional)\" value=\"\" tabindex=\"0\"/>\n                </div>\n            </div>\n        </div>\n        <div class=\"payment_select\" style=\"display: none;\">\n            <!--            <ul id=\"id_ali_ul\">-->\n            <!--                <li><button>samsungPay</button></li>-->\n            <!--                <li><button>카카오페이</button></li>-->\n            <!--                <li><button>토스</button></li>-->\n            <!--                <li><button>PAYCO</button></li>-->\n            <!--                <li>&lt;!&ndash; li class=on &ndash;&gt;-->\n            <!--                    <span class=\"select_box02_w\" onclick=\"\">&lt;!&ndash; li class=on &ndash;&gt;-->\n            <!--                        <label for=\"etc\">그외결제</label>-->\n            <!--                        <select id=\"etc\" class=\"select_b\" title=\"그외결제\">-->\n            <!--                            <option selected=\"selected\">그외결제</option>-->\n            <!--                            <option>배민페이</option>-->\n            <!--                            <option>네이버페이</option>-->\n            <!--                            <option>차이</option>-->\n            <!--                        </select>-->\n            <!--                    </span>-->\n            <!--                </li>-->\n            <!--            </ul>-->\n        </div>\n    </fieldset>\n    \n</div>\n<div class=\"info_w\">\n    <span class=\"shadow\"></span>\n    <ul class=\"card_info\">\n        <!--        <li><dl>-->\n        <!--            <dt>업체명</dt>-->\n        <!--            <dd>주식회사 카카오</dd>-->\n        <!--        </dl></li>-->\n        <li><dl>\n            <dt>Product name</dt>\n            <dd>Lilas LIVE TOUR 20..</dd>\n        </dl></li>\n        <!--        <li><dl>-->\n        <!--            <dt>제공기간</dt>-->\n        <!--            <dd> 별도 제공기간 없음 </dd>-->\n        <!--        </dl></li>-->\n        \n        <li><dl>\n            <dt>Price</dt>\n            <dd>140,000Won</dd>\n        </dl></li>\n        \n        <li style=\"display: none\" id=\"discount_li\"><dl>\n            <dt>할인쿠폰</dt>\n            <dd id=\"discount_dd\" >\n                <button type=\"button\" onclick=\"danalpaycard.web.direct_discount_btn()\" class=\"discount_btn\">할인받기</button>\n            <dd id=\"discount_dd_dd\" style=\"display: none\"><span id=\"discount_dd_span\"></span><em>Won</em></dd>\n            </dd>\n        </dl></li>\n    </ul>\n    <div class=\"card_amt\">\n        <ul>\n            <li class=\"tit\">Payment amount</li>\n            <li id=\"bill_amount\"><span id=\"bill_amount_span\">140,000</span><em>Won</em></li>\n        </ul>\n        <div class=\"btn_w\">\n            <button type=\"button\" class=\"next off\" id=\"next_btn\" tabindex=\"0\">Next</button>\n            <button type=\"button\" id=\"id_cancel_btn\" tabindex=\"0\">Cancel</button>\n        </div>\n    </div>\n</div>\n\n<!--POPUP 약관 레이어 -->\n<div class=\"popup\" id=\"POP_TERM\" style=\"display: none\">\n    <p> </p>\n    <div class=\"content_w\">\n        <div class=\"content\"  style=\"width:500px\">\n            <div class=\"pheader\">Terms <button class=\"pop_close\" onclick=\"danalpaycard.common.hidepop();\"></button></div>\n            <div class=\"pbody\">\n                <div class=\"iframe_w\">\n                    <iframe id=\"terms_pop_iframe\" src=\"\" title=\"Terms\" frameborder=\"0\" marginwidth=\"0\" marginheight=\"0\"> </iframe><!--약관 iframe-->\n                </div>\n            </div>\n            <div class=\"pfunction\">\n                <button onclick=\"danalpaycard.common.hidepop();\">Close</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- //POPUP 약관 레이어팝업-->\n\n<!--POPUP 카드사 레이어 -->\n<div class=\"popup\" id=\"POP_AUTH\" style=\"display:none\">\n    <p> </p>\n    <div class=\"content_w\">\n        <div class=\"content\" id=\"auth_pop_width\"  style=\"width:459px;  border-radius:0px !important;\"> <!-- width 사이즈변경 세로 고정 -->\n            <div class=\"pheader01\"><button class=\"pop_close\" id=\"auth_popup_close\"></button></div>\n            <div class=\"pbody\">\n                <div class=\"iframe_w01\" id=\"iframe_div\">\n                    <!--                        <iframe src=\"\" title=\"\" frameborder=\"0\" marginwidth=\"0\" marginheight=\"0\"> </iframe>&lt;!&ndash;iframe&ndash;&gt;-->\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- //POPUP 카드사 레이어팝업-->\n\n<!--POPUP 무이자 안내 레이어-->\n<div class=\"popup\" id=\"POP_NOINT\" style=\"display:none\">\n    <p> </p>\n    <div class=\"content_w\">\n        <div class=\"content\" style=\"width:400px\">\n            <div class=\"pheader\">무이자 할부 안내 <button class=\"pop_close\"  onclick=\"danalpaycard.common.hidepop();\"></button></div>\n            <div class=\"pbody\">\n                <div class=\"notice_w\">\n                    <div class=\"cont\" id=\"ID_NOINT_POP_CONT\">\n                        <!--안내 html-->\n                        <p>법인, 체크, 선불, 기프트카드는 무이자 할부에서 제외됩니다.<br>직계약 가맹점 및 상점 부담 무이자 가맹점, 특별제휴 가맹점 등 일부 가맹점은 제외될 수 있습니다.</p>\n                        <table id=\"ID_NOINT_POP_TABLE\">\n                        </table>\n                        <h3>이용 시 유의사항</h3>\n                        <span class=\"info_txt\">부분취소 시 잔액이 무이자 할부 조건에 맞지 않으면 무이자 혜택이 적용되지 않습니다.</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"pfunction\">\n                <button type=\"button\" onclick=\"danalpaycard.common.hidepop();\">닫기</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!--//POPUP 무이자 안내 레이어-->\n\n<!--POPUP 포인트 안내 레이어-->\n<div class=\"popup\" id=\"POP_POINT\" style=\"display:none\">\n    <p> </p>\n    <div class=\"content_w\">\n        <div class=\"content\" style=\"width:400px\">\n            <div class=\"pheader\">포인트안내 <button class=\"pop_close\"  onclick=\"danalpaycard.common.hidepop();\"></button></div>\n            <div class=\"pbody\">\n                <div class=\"notice_w\">\n                    <div class=\"cont\">\n                        <p>카드사포인트 가맹점입니다.<br>포인트 결제 시 카드사 정책에따라 가용 포인트가 차감되고. 부족한 금액은 신용카드로 결제됩니다.</p>\n                        <p><em>'포인트 사용'</em>을 체크하시면 카드 포인트 결제가 진행되며,포인트 사용금액은 청구 할인됩니다.</p>\n                        <span class=\"info_txt\">포인트 결제정책은 카드사마다 상이하오니 문의사항이 있으신 경우 각 카드사로 문의하시기 바랍니다.</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"pfunction\">\n                <button type=\"button\" onclick=\"danalpaycard.common.hidepop();\">닫기</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!--//POPUP 포인트 안내 레이어-->\n\n<!--환금성 확인 레이어 -->\n<div class=\"popup\" id=\"POP_ISGAME\" style=\"display: none\">\n    <p> </p>\n    <div class=\"content_w\">\n        <div class=\"content\"  style=\"width:400px\">\n            <div class=\"pheader\">이용안내 <button class=\"pop_close\" onclick=\"danalpaycard.common.hidepop();\"></button></div>\n            <div class=\"pbody\">\n                <div class=\"iframe_w\" style=\"height: 250px !important; padding: 15px;\">\n                    <iframe id=\"isgame_pop_iframe\" src=\"https://checkout.teledit.com/creditcard/notice/isp_mobile.html\" title=\"약관\" frameborder=\"0\" marginwidth=\"0\" marginheight=\"0\"> </iframe><!--약관 iframe-->\n                </div>\n            </div>\n            <div class=\"pfunction\">\n                <button id=\"isgame_pop_confirm_btn\">확인</button>\n                <button onclick=\"danalpaycard.common.hidepop();\">닫기</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- //환금성 확인 레이어-->\n\n<!--POPUP 즉시할인 안내 레이어-->\n<div class=\"popup\" id=\"POP_DISCOUNT\" style=\"display:none\">\n    <p> </p>\n    <div class=\"content_w\">\n        <div class=\"content\" style=\"width:450px\">\n            <div class=\"pheader\">할인 혜택 안내 <button class=\"pop_close\"  onclick=\"danalpaycard.common.hidepop();\"></button></div>\n            <div class=\"pbody\">\n                <div class=\"notice_w\">\n                    <div class=\"cont\">\n                        <p>할인 쿠폰을 선택해 주세요.</p>\n                        <table id=\"ID_DISCOUNT_POP_TABLE\">\n                        </table>\n\n                        <h3>쿠폰 사용 시 유의사항</h3>\n                        <span class=\"info_txt\">부분취소 시 잔액이 쿠폰할인 조건에 맞지 않으면 쿠폰이 취소됩니다.</span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"pfunction\">\n                <button type=\"button\" onclick=\"danalpaycard.common.hidepop();\">닫기</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!--//POPUP 즉시할인 안내 레이어-->\n\n\n<!--POPUP 즉시할인 confirm 레이어 -->\n<div class=\"popup\" id=\"POP_DC_CONFIRM\" style=\"display: none\">\n    <p> </p>\n    <div class=\"content_w\">\n        <div class=\"content\" style=\"width:400px\">\n            <div class=\"pheader\">Alert\n                <!--                    <button class=\"pop_close\" onclick=\"danalpaycard.common.hidepop();\" ></button>-->\n            </div>\n            <div class=\"pbody\">\n                <div class=\"notice_w\">\n                    <div class=\"scroll\" id=\"dc_confirm_pop_text\">\n\n                    </div>\n                </div>\n            </div>\n            <div class=\"pfunction\">\n                <button id=\"dc_confirm_pop_confirm_btn\" onclick=\"danalpaycard.web.dc_confirm_confirm()\">OK</button>\n                <button class=\"cancel\" id=\"dc_confirm_pop_cancel_btn\" onclick=\"danalpaycard.web.dc_confirm_cancel();\">Cancel</button>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- //POPUP 즉시할인 confirm 레이어팝업-->\n\n\n<!-- forms / inputs -->\n<form name=\"authForm\" style=\"display: none;\" method=\"POST\"></form>\n\n<form name=\"vanForm\" id=\"vanForm\" style=\"display: none;\" action=\"/creditcard_std_global/web/finish_global\" method=\"POST\" >\n    <input type=\"hidden\" name=\"data\" id=\"van-data\" value=\"\"/>\n    <input type=\"hidden\" name=\"STARTPARAMS\" value=\"\" />\n    \n    <input type=\"hidden\" name=\"UISKIP\" value=\"Y\" />\n    \n</form>\n\n<input type=\"hidden\" name=\"data\" value=\"\"/>\n<input type=\"hidden\" name=\"cancelurl\" value=\"https://dkpg-web.payments.kakao.com/dkpg/v1/payment/danal/card-foreign/cancel\"/>\n<input type=\"hidden\" name=\"returnurl\" value=\"https://dkpg-web.payments.kakao.com/dkpg/v1/payment/danal/card-foreign/approve/OPM:V1:bBSGsiFeSJS0ubi1xQZGOY6WQ8FjMeIQqW4HFYqJR5oTUZg3_dU=\"/>\n<input type=\"hidden\" name=\"color\" value=\"00\"/>\n<input type=\"hidden\" name=\"ciurl\" value=\"https://checkout.teledit.com/creditcard_std_global//web/images/logo_danal.png\"/>\n<input type=\"hidden\" name=\"tid_enc\" value=\"lkCozsPN4l0CNMpfXBihF5JAJXlN+lX1cvlVnukqgoA=\"/>\n<input type=\"hidden\" name=\"duration\" value=\"별도 제공기간 없음\"/>\n<!-- //forms / inputs -->\n\n\n    <!--POPUP 알림 레이어 -->\n    <div class=\"popup\" id=\"POP_ALERT\" style=\"display: none\">\n        <p> </p>\n        <div class=\"content_w\">\n            <div class=\"content\" style=\"width:400px\">\n                <div class=\"pheader\">Alert\n                    <button class=\"pop_close\" onclick=\"danalpaycard.common.hidepop();\" ></button></div>\n                <div class=\"pbody\">\n                    <div class=\"notice_w\">\n                        <div class=\"scroll\" id=\"alert_pop_text\">\n                            서비스이용 약관을 모두 동의해주세요.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"pfunction\">\n                    <button id=\"alert_pop_confirm_btn\">OK</button>\n                    <button class=\"cancel\" id=\"alert_pop_cancel_btn\" onclick=\"danalpaycard.common.hidepop();\">Cancel</button>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- //POPUP 알림 레이어팝업-->\n\n    <!--POPUP 에러 레이어 -->\n    <div class=\"popup\" id=\"POP_ERROR\" style=\"display: none;\">\n        <p> </p>\n        <div class=\"content_w\">\n            <div class=\"content\" style=\"width:400px\">\n                <div class=\"pheader\">Error</div>\n                <div class=\"pbody\">\n                    <div class=\"notice_w\">\n                        <div class=\"scroll\" id=\"error_pop_text\">\n                            오류가 발생하였습니다.<br />\n                            처음부터 다시 시도해 주세요.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"pfunction\">\n                    <button id=\"error_pop_confirm_btn\" onclick=\"danalpaycard.common.session_close();\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- //POPUP 알림 레이어-->\n\n    <!--즉시할인 POPUP 알림 레이어 -->\n    <div class=\"popup\" id=\"POP_DISCOUNT_CONFIRM\" style=\"display: none;\">\n        <p> </p>\n        <div class=\"content_w\">\n            <div class=\"content\" style=\"width:400px\">\n                <div class=\"pheader\">알림</div>\n                <div class=\"pbody\">\n                    <div class=\"notice_w\">\n                        <div class=\"scroll\">\n                            즉시할인 적용이 가능합니다.<br />\n                            적용하시겠습니까?\n                        </div>\n                    </div>\n                </div>\n                <div class=\"pfunction\">\n                    <button id=\"discount_ok_btn\">적용</button>\n                    <button class=\"cancel\" id=\"discount_no_btn\">적용안함</button>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- // 즉시할인 POPUP 알림 레이어-->\n\n    <!--로딩-->\n    <div class=\"loader_pop\" style=\"display: none\">\n        <p> </p>\n        <div class=\"loader_w\">\n            <div class=\"lds-ring\"><div></div><div></div><div></div><div></div></div>\n        </div>\n    </div>\n    <!-- //로딩-->\n\n    <!-- Edge 호환성 가이드 -->\n    <div class=\"popup\" id=\"POP_EDGE\" style=\"display: none;\">\n        <p> </p>\n        <div class=\"content_w\">\n            <div class=\"content\" style=\"width:430px\">\n                <div class=\"pheader\" style=\"font-size:20px;word-break:keep-all;\">Edge 브라우저 결제 안내</div>\n                <div class=\"pbody\" style=\"letter-spacing: 0px !important;\">\n                    <div class=\"notice_w\">\n                        <div class=\"scroll\" id=\"edge_pop_text\" style=\"margin:10px 0;color:#666; padding: 20px 30px !important; max-height: 350px !important;\">\n                            <p> Win10 Edge 환경에서는 카드사 사정에 따라 결제가 원활 하지 않을 수 있습니다.</p>\n                            <p class=\"danal-box\" style=\"background:#eee;padding:15px;margin:20px 0;color:#000;\"><b>호환성설정 후 결제가능 카드</b><br>KB국민카드, 카카오뱅크체크카드</p>\n\n                            <p style=\"text-align: left !important;\">※위 카드를 이용하시려면 <a href=\"javascript:window.open('about:flags','danal_edge_flas','top=0,left=0,height=400,width=400');\"><b>이 곳</b></a>을 클릭하신 후, <br>\n                                개발자설정 > Microsoft 호환성 목록 사용항목을 '체크해제'로 설정하시고\n                                이 창으로 돌아와 확인 버튼을 클릭하시면 결제를 진행할 수 있습니다. </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"pfunction\">\n                    <button id=\"edge_pop_confirm_btn\" onclick=\"danalpaycard.common.hidepop();\" style=\"font-size:18px;padding:15px 13px;display:block; color:#ffffff;background:#0078D6; font-weight:400;border:0;width:100%;text-align:center;cursor:pointer; margin: unset !important; border-radius: 0px 0px 4px 4px !important;\">확인</button>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- //Edge 호환성 가이드 -->\n    \n\n</div>\n<!-- //WRAP -->\n\n\n\n<!--[if lt IE 7]><script type=\"text/javascript\" src=\"/creditcard_std_global/web/js/json2.min.js\"></script><![endif]-->\n<!--[if IE 7]><script type=\"text/javascript\" src=\"/creditcard_std_global/web/js/json2.min.js\"></script><![endif]-->\n<!--[If IE 6]>\n<script type=\"text/javascript\">\n\n    alert(\"Internet Explorer6 이하에서는 지원하지 않습니다.\");\n    var cancelURL = \"https://dkpg-web.payments.kakao.com/dkpg/v1/payment/danal/card-foreign/cancel\";\n    if(cancelURL){\n        location.href = cancelURL;\n    }\n    else{\n        window.close();\n    }\n</script>\n<![endif]-->\n<!--[if IE 6]>\n<script src=\"/creditcard_std_global/web/js/DD_belatedPNG_0.0.8a-min.js\"></script>\n<script src=\"/creditcard_std_global/web/js/fix_png.min.js\"></script>\n<![endif]-->\n<script type=\"text/javascript\">\n    //Google Analysis\n    (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n    })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n\n    ga('create', 'UA-69292503-1', 'auto');\n    ga('send', 'pageview');\n</script>\n\n<script type=\"text/javascript\">\n    if(typeof(danalpaycard) === 'undefined'){\n        danalpaycard = {};\n    }\n    if(danalpaycard.web == null){\n        danalpaycard.web = {};\n    }\n\n    if(danalpaycard.van_cancel_msg == null){\n        danalpaycard.van_cancel_msg = \"\";\n    }\n\n    // 즉시할인 체크를 위한 CPID 추가\n    danalpaycard.web.cpid = 'AF10000003';\n\n    danalpaycard.web.main_cardinfo = JSON.parse('[{\"AUTHMODE\": \"V3D\", \"CARDCODE\": \"0901\", \"CARDIMAGE\": false, \"CARDNAME\": \"\\ud574\\uc678\\ube44\\uc790\", \"CARD_NOTICE\": \"\", \"DISPLAYPOINT\": \"\", \"IMMEDIATEDISCOUNTAMOUNT\": \"0\", \"IMMEDIATEDISCOUNTEVENTID\": \"\", \"IMMEDIATEDISCOUNTMINAMOUNT\": \"0\", \"ISPOINT\": \"N\", \"NOINT\": [], \"NOINTAMOUNT\": \"0\", \"PARTFREECUSTOMERQUOTA\": [], \"PARTFREEQUOTA\": [], \"POINTMINAMOUNT\": \"0\", \"POINT_NAME\": \"\\uce74\\ub4dc\\ud3ec\\uc778\\ud2b8\", \"QUOTA\": [\"00\"], \"QUOTAMINAMOUNT\": \"50000\", \"QUOTA_INFO\": \"\\uac1c\\uc6d4;00;N\", \"SEQNO\": 21}]');\n    danalpaycard.web.select_cardinfo = JSON.parse('null');\n    \n    danalpaycard.web.AMOUNT = \"140000\";\n    danalpaycard.web.ITEMNAME = \"Lilas LIVE TOUR 20..\";\n    danalpaycard.web.skip_page_code_list =  JSON.parse('[\"BILLINFO\"]');\n\n    \n</script>\n<script src=\"/creditcard_std_global/web/js/creditcard_std.web_global.js?nocache=20260405210011\"></script>\n\n<!-- KVP 조회 플러그인 관련 javascript -->\n<script type=\"text/javascript\">\n\n    $(document).ready(function() {\n\n        var pageError = $(\"input[type=hidden][name=page-error]\").val();\n        if(pageError!=\"0000\") {\n            $(\"#popup_error_msg\").text($(\"input[type=hidden][name=page-error-msg]\").val());\n            $(\"#popup_error\").css(\"display\", \"block\");\n        }\n        else {\n            changeAmount();\n            //installment init\n            $(\"#no_installment_radio\").attr(\"checked\", false);\n            $(\"#installment_radio\").attr(\"checked\", false);\n        }\n        document.onkeydown = danalpaycard.web.preventInvalidAction;\n\n    });\n\n    // ISP 결제 관련\n    //StartSmartUpdate();\n    var vpform;\n    function BeforePost(form) {\n        vpform = form;\n        MakePayMessage(form);\n    }\n\n    function VP_Ret_Pay(ret) {\n        if(ret)  {\n            vpform.submit();\n        }\n        else {\n            danalpaycard.web.callbackVanFail('VP', '{\"msg\":\"ISP인증에 실패하였습니다.\"}');\n        }\n    }\n\n    // ISP 결제 관련\n\n    function selectCardOnlyOne() {\n        var selectedCard = $($(' .select_credit').children()[0]);\n        $(selectedCard.find(\"input\")[0]).click();\n    }\n\n\n</script>\n<!-- //KVP 조회 플러그인 관련 javascript -->\n\n\n</body>\n</html>"
