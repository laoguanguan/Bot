            "size": 10712,
            "mimeType": "text/javascript",
            "text": "/**\n * Created by juhankim-lt on 15. 11. 10..\n */\n\nvar ezPaperZone = null;\nvar panZoomZone = null;\nvar ezCusMgnZone = null;\n\nvar mFloorZone = \"\";\nvar mAreaZone = \"\";\n\nvar OBJECT_IMAGE_PATH = \"/img/\";\n//object 이미지 확장자\nvar OBJECT_IMAGE_ATTR = \"svg\";\n//object 이미지 크기\nvar OBJECT_IMAGE_WIDTH = 40;\nvar OBJECT_IMAGE_HEIGHT = 40;\nvar MAP_VIEW_TYPE = \"MAP\";\n\nvar ZONE_BLOCK_SNTV_IDX = Array();\nvar ZONE_BLOCK_IDX = Array();\nvar ZONE_BLOCK_ID = Array();\nvar ZONE_BLOCK_TITLE = Array();\n\nfunction fnLoadSeatMapZone( seatData )\n{\n    MAP_VIEW_TYPE = \"ZONE\";\n    ZONE_BLOCK_IDX = Array();\n    fnCusMapLoadingProcessZone( seatData );\n}\n\nfunction fnCusMapLoadingProcessZone( cusMap )\n{\n    if (ezCusMgnZone != null)\n    {\n        ezCusMgnZone.RemoveAll();\n        ezCusMgnZone = null;\n    }\n\n    mFloorZone = (cusMap.snt.f.use == \"Y\" ? cusMap.snt.f.name : \"\");\n    mAreaZone = (cusMap.snt.a.use == \"Y\" ? cusMap.snt.a.name : \"\");\n\n    ezCusMgnZone = new EzSeatCusZone();\n\n    ezCusMgnZone.InitSeat( \"1\" , cusMap.ms.width , cusMap.ms.height , cusMap.mt );\n\n    ezCusMgnZone.SetBackGroundColor( cusMap.bg );\n\n    ezCusMgnZone.SetBackGround( cusMap.bu );\n\n\n    if (cusMap.da.bb != null) {\n        for (var i = 0; i < cusMap.da.bb.length; i++) {\n            ezCusMgnZone.DrawBackBlock(cusMap.da.bb[i]);\n        }\n    }\n\n    if (cusMap.da.zb != null) {\t//joyh 2016.10.11 수정\n\t\tfor (var i = 0; i < cusMap.da.zb.length; i++) {\n            ezCusMgnZone.DrawZoneBlock(cusMap.da.zb[i],mFloorZone,mAreaZone);\n        }\n        for (var i = 0; i < cusMap.da.zb.length; i++) {\n            ezCusMgnZone.DrawZoneFrontBlock(cusMap.da.zb[i],mFloorZone,mAreaZone);\n        }\t\n    }\n\n    if (cusMap.da.sb != null) {\n        for (var i = 0; i < cusMap.da.sb.length; i++) {\n            ezCusMgnZone.DrawZoneBlock(cusMap.da.sb[i],mFloorZone,mAreaZone);\n            \n            if(ZONE_BLOCK_ID[\"'\"+cusMap.da.sb[i].sntv.f +\",\"+cusMap.da.sb[i].sntv.a+\"'\"] != undefined){\n            \t\tvar blockObj \t= ZONE_BLOCK_ID[\"'\"+cusMap.da.sb[i].sntv.f +\",\"+cusMap.da.sb[i].sntv.a+\"'\"];\n            \t\tvar blocks\t\t= blockObj.toString().split(\",\");\n            \t\tvar block \t\t= cusMap.da.sb[i].sbid;\n            \t\tfor(var h = 0 ; h < blocks.length ; h ++){\n            \t\t\tif(blocks[h] != cusMap.da.sb[i].sbid){\n            \t\t\t\tblock += \",\"+blocks[h];\n            \t\t\t}\n            \t\t}\n            \t\tZONE_BLOCK_ID[\"'\"+ cusMap.da.sb[i].sntv.f +\",\"+cusMap.da.sb[i].sntv.a+\"'\"] = block;\n            }else{\n            \t\tZONE_BLOCK_ID[\"'\"+cusMap.da.sb[i].sntv.f +\",\"+cusMap.da.sb[i].sntv.a+\"'\"] = cusMap.da.sb[i].sbid;\n            }\n        }\n    }\n\n}\n\nfunction SelectGradeZone( pZoneSNTV )\n{\n    if (EzSeatCusZone != null)\n    {\n\n        ZONE_BLOCK_SNTV_IDX = Array();\n        var zAr = pZoneSNTV.split(\";\");\n\n        for (var i =0; i < zAr.length; i++)\n        {\n            ZONE_BLOCK_SNTV_IDX[zAr[i]] = zAr[i];\n        }\n\n        for (var i =0; i < ZONE_BLOCK_IDX.length; i++)\n        {\n            ZONE_BLOCK_IDX[i].SetZoneShowHidden(\"Y\");\n        }\n\n        for (var i =0; i < ZONE_BLOCK_IDX.length; i++)\n        {\n            if (ZONE_BLOCK_SNTV_IDX[ZONE_BLOCK_IDX[i].GetSNTV()] != null )\n            {\n                ZONE_BLOCK_IDX[i].SetZoneShowHidden(\"Y\");\n            }else{\n                ZONE_BLOCK_IDX[i].SetZoneShowHidden(\"N\");\n            }\n        }\n    }\n}\n\n/* {{ hkcho */\nfunction SetGradeZoneDefault()\n{\n    for (var i =0; i < ZONE_BLOCK_IDX.length; i++)\n    {\n    \tZONE_BLOCK_IDX[i].SetZoneShowHidden(\"Y\");\n    }\n}\n/* }} hkcho */\n\nfunction SetIndexMap( pX , pY , pW , pH)\n{\n\n}\n\nEzSeatCusZone = function()\n{\n    var mBackGround = null;\n    var mWidth =0;\n    var mHeight = 0;\n\n    var me = this;\n    var mMapType = \"\";\n    var mInxMapUrl = \"\";\n\n    me.GetMapType = function()\n    {\n        return mMapType;\n    };\n\n    me.GetIndexMapUrl = function()\n    {\n        return  mInxMapUrl;\n    };\n\n    me.SetIndexMap = function( pUrl )\n    {\n    \tif(undefined != pUrl && \"\" != pUrl){\n    \t\tpUrl = pUrl.replace(\"http:\", \"https:\");\n    \t}\n        mInxMapUrl = pUrl;\n    };\n\n    me.InitSeat = function( pLocID , pWidth , pHeight , pMapType )\n    {\n        mWidth = pWidth;\n        mHeight = pHeight;\n        mMapType = pMapType;\n\n        if(pMapType == \"BLOCK\" && pWidth * 600 < pHeight * 700){  //TICKETDEV-2283 [PC] 국내/글로벌 원스탑 UI 오류 수정\n            pHeight = pHeight * 1.1;\n        }\n\n        ezPaperZone = Raphael( \"ez_canvas_zone\", $(\"#ez_canvas_zone\").width()*2 , $(\"#ez_canvas_zone\").height()*2 );\n        ezPaperZone.canvas.style.backgroundColor = \"#F4F4F4\";\n\n        ezPaperZone.setViewBox(0 , 0, pWidth , pHeight, true);\n        ezPaperZone.canvas.setAttribute('preserveAspectRatio', 'xMidYMid meet');\n    };\n\n    me.SetBackGroundColor = function( pbackColor )\n    {\n    \tif(undefined !== pbackColor){\n    \t\tezPaperZone.canvas.style.backgroundColor = \"#\"+pbackColor;\n    \t}\n    };\n\n    me.SetBackGround = function ( pbackGround )\n    {\n        if (pbackGround != \"\") {\n        \tpbackGround = pbackGround.replace(\"http:\", \"https:\");\n            mBackGround = ezPaperZone.image(pbackGround, 0, 0, mWidth, mHeight);\n            mBackGround.toBack();\n        }\n    };\n\n\t//joyh 2016.10.11 수정\n    me.DrawZoneBlock = function( pZB , mFloorZone , mAreaZone)\n    {\n        var zBlock = null;\n\n        switch ( pZB.dt )\n        {\n            case \"RECT\":\n                zBlock = new EzCusRect( pZB.cd.x , pZB.cd.y , pZB.cd.w , pZB.cd.h , ezPaperZone);\n                zBlock.SetStyle( pZB.fc , pZB.lc , pZB.ls);\n\n                if (pZB.r != 0) {\n                    zBlock.SetRotate( pZB.r );\n                }\n                ZONE_BLOCK_SNTV_IDX[pZB.snt.f +\",\"+ pZB.snt.a] = pZB.s