SP_Log(\"[SetData_POST] start, str : \", str);\n\tif (m_eispprocess == \"SetData\") sendProc('SetData', null, str, Ret_SetData_POST, ErrProc);\n} // end SetData\n\n/**\n * plugin data set (POST) 후작업\n */\nfunction Ret_SetData_POST(resHttp) {\n\ttry {\n\t\tif (m_eispprocess == 'SetData') {\n\t\t\tm_eispprocess = \"Ret_SetData\";\n\t\t\tvar rtnData = resHttp.responseText;\n\t\t\tvar rtn = null;\n\t\t\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[SetData_POST res status ]\", resHttp.status);\n\t\t\tif (undefined != resHttp.readyState) vp_util.Write_ISP_Log(\"[SetData_POST res readyState ]\", resHttp.readyState);\n\t\t\tvp_util.Write_ISP_Log(\"[SetData_POST res Data]\", resHttp.responseText);\n\n\t\t\tif (rtnData != null && rtnData != undefined) {\n\t\t\t\tif (typeof jQuery !== \"undefined\") rtn = jQuery.parseJSON(rtnData);\n\t\t\t\telse if (typeof parent.jQuery !== \"undefined\") rtn = parent.jQuery.parseJSON(rtnData);\n\t\t\t\tvp_util.Write_ISP_Log(\"[SetData_POST result]\", rtn.status);\n\t\t\t\tif (rtn.status == 'S_OK') {\n\t\t\t\t\tif (rtn.reply.setdata != undefined) vp_util.Write_ISP_Log(\"[SetData_POST end success][setdata]\", rtn.reply.setdata);\n\t\t\t\t\tif (m_eISPErrorStep == 'SetData') {\n\t\t\t\t\t\tm_eISPErrorStep = '';\n\t\t\t\t\t\tvp_ispplus_install.CloseLoadingUI();\n\t\t\t\t\t\tvp_ispplus_install.OpenLoadingUI();\n\t\t\t\t\t}\n\t\t\t\t\tLoadPay_POST();\n\t\t\t\t} else {\n\t\t\t\t\tif (rtn.reply.ErrCode != undefined) vp_util.Write_ISP_Log(\"[SetData_POST res ErrCode]\", rtn.reply.ErrCode);\n\t\t\t\t\tif (rtn.reply.ErrMsg != undefined) vp_util.Write_ISP_Log(\"[SetData_POST res ErrMsg]\", rtn.reply.ErrMsg);\n\t\t\t\t\trestartPayment('SetData');\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tvp_util.Write_ISP_Log(\"[SetData_POST]\", \"rtnData is null\");\n\t\t\t\trestartPayment('SetData');\n\t\t\t}\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_SetData] m_eispprocess: \", m_eispprocess);\n\t\t}\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[Ret_SetData_POST Error]\", error.toString());\n\t\trestartPayment('SetData');\n\t}\n} // end Ret_SetData\n\n/**\n * LoadPay (POST)\n */\nfunction LoadPay_POST() {\n\tm_eispprocess = \"LoadPay\";\n\tvar str = '{\"command\":\"loadpay\",\"sessionid\":\"' + m_sessionid + '\"}';\n\tvp_util.Write_ISP_Log(\"[LoadPay_POST] start, str : \", str);\n\tif (m_eispprocess == \"LoadPay\") sendProc('LoadPay', null, str, Ret_LoadPay_POST, ErrProc);\n} // end LoadPay\n\n/**\n * LoadPay 후처리 (POST) - 결제인증 결과 요청\n * @param {*} resHttp \n */\nfunction Ret_LoadPay_POST(resHttp) {\n\ttry {\n\t\tif (m_eispprocess == 'LoadPay') {\n\t\t\tm_eispprocess = \"Ret_LoadPay\";\n\t\t\tvar rtnData = resHttp.responseText;\n\t\t\tvar rtn = null;\n\t\t\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[LoadPay_POST res status ]\", resHttp.status);\n\t\t\tif (undefined != resHttp.readyState) vp_util.Write_ISP_Log(\"[LoadPay_POST res readyState ]\", resHttp.readyState);\n\t\t\tvp_util.Write_ISP_Log(\"[LoadPay_POST res Data]\", resHttp.responseText);\n\n\t\t\tif (rtnData != null && rtnData != undefined) {\n\t\t\t\tif (typeof jQuery !== \"undefined\") rtn = jQuery.parseJSON(rtnData);\n\t\t\t\telse if (typeof parent.jQuery !== \"undefined\") rtn = parent.jQuery.parseJSON(rtnData);\n\t\t\t\tif (rtn.status != undefined) vp_util.Write_ISP_Log(\"[LoadPay_POST result]\", rtn.status);\n\t\t\t\tif (rtn.status == 'S_OK') {\n\t\t\t\t\tif (rtn.reply.loadpay != undefined) vp_util.Write_ISP_Log(\"[LoadPay_POST end success][loadpay]\", rtn.reply.loadpay);\n\t\t\t\t\tGetData_POST();\t// 결제인증결과 요청\n\t\t\t\t} else {\n\t\t\t\t\tif (rtn.reply.ErrCode != undefined) vp_util.Write_ISP_Log(\"[LoadPay_POST res ErrCode]\", rtn.reply.ErrCode);\n\t\t\t\t\tif (rtn.reply.ErrMsg != undefined) vp_util.Write_ISP_Log(\"[LoadPay_POST res ErrMsg]\", rtn.reply.ErrMsg);\n\t\t\t\t\tm_eispprocess = \"\";\n\t\t\t\t\thideDivPop();\n\t\t\t\t\tCancelVPPayment(rtn.reply.ErrCode == '10031' ? '01' : '99');\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tvp_util.Write_ISP_Log(\"[Ret_LoadPay_POST]\", \"rtnData is null\");\n\t\t\t\tm_eispprocess = \"\";\n\t\t\t\thideDivPop();\n\t\t\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t\t\t\tCancelVPPayment('99');\n\t\t\t}\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_LoadPay_POST] m_eispprocess: \", m_eispprocess);\n\t\t}\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[Ret_LoadPay_POST error]\", error.toString());\n\t\tm_eispprocess = \"\";\n\t\thideDivPop();\n\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t\tCancelVPPayment('99');\n\t}\n} // end Ret_LoadPay\n\n/**\n * get pay data (POST)\n */\nfunction GetData_POST() {\n\tm_eispprocess = \"GetData\";\n\tvp_util.Write_ISP_Log(\"[GetData_POST]\", \"start\");\n\n\tvar argsVal = makeGetData();\n\tvar str = '{\"command\":\"getdata\",\"sessionid\":\"' + m_sessionid + '\",';\n\tstr += ' \"args\":' + argsVal;\n\tstr += '}';\n\tvp_util.Write_ISP_Log(\"[GetData_POST] str\", str);\n\tif (m_eispprocess == \"GetData\") sendProc('GetData', null, str, Ret_GetData_POST, ErrProc);\n\n} // end GetData\n\n/**\n * get pay data 후처리 (POST)\n * @param {*} resHttp \n * @returns {function} PayEnd_POST\n */\nfunction Ret_GetData_POST(resHttp) {\n\ttry {\n\t\tif (m_eispprocess == 'GetData') {\n\t\t\tm_eispprocess = \"Ret_GetData\";\n\t\t\tvar rtnData = resHttp.responseText;\n\t\t\tvar rtn = null;\n\t\t\tvar retdata = null;\n\t\t\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[GetData_POST res status ]\", resHttp.status);\n\t\t\tif (undefined != resHttp.readyState) vp_util.Write_ISP_Log(\"[GetData_POST res readyState ]\", resHttp.readyState);\n\t\t\tvp_util.Write_ISP_Log(\"[GetData_POST res Data]\", resHttp.responseText);\n\n\t\t\tif (rtnData != null && rtnData != undefined) {\n\t\t\t\tif (typeof jQuery !== \"undefined\") retdata = jQuery.parseJSON(rtnData);\n\t\t\t\telse if (typeof parent.jQuery !== \"undefined\") retdata = parent.jQuery.parseJSON(rtnData);\n\t\t\t\trtn = retdata.reply;\n\t\t\t\tif (retdata.status != undefined) vp_util.Write_ISP_Log(\"[GetData_POST result]\", retdata.status);\n\t\t\t\tif (retdata.status == 'S_OK') {\n\t\t\t\t\tif (retdata.sessionid != undefined) vp_util.Write_ISP_Log(\"[LoadPay_POST end success][sessionid]\", retdata.sessionid);\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_SESSIONKEY')) vpPayform.KVP_SESSIONKEY.value = decodeURIComponent(rtn.Kvp_sessionkey);\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_ENCDATA')) vpPayform.KVP_ENCDATA.value = decodeURIComponent(rtn.Kvp_encryptdata);\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_NOINT')) vpPayform.KVP_NOINT.value = rtn.Kvp_noint;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_QUOTA')) vpPayform.KVP_QUOTA.value = rtn.Kvp_quota;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_CARDCODE')) vpPayform.KVP_CARDCODE.value = rtn.Kvp_cardcode;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_CONAME')) vpPayform.KVP_CONAME.value = '안전결제';\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_CARD_PREFIX')) vpPayform.KVP_CARD_PREFIX.value = rtn.Kvp_prifix;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_PAYSET_FLAG')) vpPayform.KVP_PAYSET_FLAG.value = rtn.Kvp_PaySet_Flag;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_USING_POINT')) vpPayform.KVP_USING_POINT.value = rtn.Kvp_Using_Point;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_RET_SAVEPOINT')) vpPayform.VP_RET_SAVEPOINT.value = rtn.Vp_Success_SavePoint;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_RESERVED1')) vpPayform.KVP_RESERVED1.value = rtn.Kvp_reserved1;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_RESERVED2')) vpPayform.KVP_RESERVED2.value = rtn.Kvp_reserved2;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_RESERVED3')) vpPayform.KVP_RESERVED3.value = rtn.Kvp_reserved3;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_RET_CODE')) vpPayform.VP_PREDIS_RET_CODE.value = rtn.VP_PREDIS_RET_CODE;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_RCOUNT')) vpPayform.VP_PREDIS_RCOUNT.value = rtn.VP_PREDIS_RCOUNT;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_MAMOUNT')) vpPayform.VP_PREDIS_MAMOUNT.value = rtn.VP_PREDIS_MAMOUNT;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_TOT')) vpPayform.VP_PREDIS_DISAMOUNT_TOT.value = rtn.VP_PREDIS_DISAMOUNT_TOT;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_MEMCODE')) vpPayform.VP_PREDIS_MEMCODE.value = rtn.VP_PREDIS_MEMCODE;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_CAMCODE')) vpPayform.VP_PREDIS_CAMCODE.value = rtn.VP_PREDIS_CAMCODE;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_RET_AMOUNT')) vpPayform.VP_PREDIS_RET_AMOUNT.value = rtn.VP_PREDIS_RET_AMOUNT;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_M001')) vpPayform.VP_PREDIS_DISAMOUNT_M001.value = rtn.VP_PREDIS_DISAMOUNT_M001;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_M901')) vpPayform.VP_PREDIS_DISAMOUNT_M901.value = rtn.VP_PREDIS_DISAMOUNT_M901;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_M902')) vpPayform.VP_PREDIS_DISAMOUNT_M902.value = rtn.VP_PREDIS_DISAMOUNT_M902;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_PREDIS_RET_MEMGRADE')) vpPayform.VP_PREDIS_RET_MEMGRADE.value = rtn.VP_PREDIS_RET_MEMGRADE;\n\t\t\t\t\treturn PayEnd_POST();\n\t\t\t\t} else {\n\t\t\t\t\tif (retdata.reply.ErrCode != undefined) vp_util.Write_ISP_Log(\"[GetData_POST res ErrCode]\", retdata.reply.ErrCode);\n\t\t\t\t\tif (retdata.reply.ErrMsg != undefined) vp_util.Write_ISP_Log(\"[GetData_POST res ErrMsg]\", retdata.reply.ErrMsg);\n\t\t\t\t\tm_eispprocess = \"\";\n\t\t\t\t\thideDivPop();\n\t\t\t\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t\t\t\t\tCancelVPPayment('99');\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tvp_util.Write_ISP_Log(\"[Ret_GetData_POST]\", \"rtnData is null\");\n\t\t\t\tm_eispprocess = \"\";\n\t\t\t\thideDivPop();\n\t\t\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t\t\t\tCancelVPPayment('99');\n\t\t\t}\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_GetData_POST] m_eispprocess: \", m_eispprocess);\n\t\t}\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[Ret_GetData_POST catch event]\", error.toString());\n\t\tm_eispprocess = \"\";\n\t\thideDivPop();\n\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t}\n} // end Ret_GetData\n\n/**\n * 결제종료 (POST)\n */\nfunction PayEnd_POST() {\n\tm_eispprocess = \"PayEnd\";\n\tvp_util.Write_ISP_Log(\"[PayEnd_POST]\", \"start\");\n\tvar str = '{\"command\":\"payend\",\"sessionid\":\"' + m_sessionid + '\"}';\n\tvp_util.Write_ISP_Log(\"[PayEnd_POST] str\", str);\n\tif (m_eispprocess == \"PayEnd\") sendProc('PayEnd', null, str, Ret_PayEnd_POST, Err_PayEnd_POST);\n}\n\n/**\n * 결제종료 후처리 (POST)\n * @param {*} resHttp \n */\nfunction Ret_PayEnd_POST(resHttp) {\n\tvp_util.Write_ISP_Log(\"[PayEnd_POST res Data]\", resHttp.responseText);\n\tm_eispprocess = \"\";\n\tm_queryinstall_count = 0;\n\treplKvpCardCd(); VP_Ret_Pay(true);\n\thideDivPop();\n}\n\n/**\n * 결제종료 - ERROR (POST)\n * @param {*} resHttp \n */\nfunction Err_PayEnd_POST(resHttp) {\n\tvp_util.Write_ISP_Log(\"[PayEnd_POST end error]\", \"\");\n\tm_eispprocess = \"\";\n\tm_queryinstall_count = 0;\n\treplKvpCardCd(); VP_Ret_Pay(true);\n\thideDivPop();\n}\n\n/**\n * pay data 를 json 형태로 생성\n * @returns jsonString\n */\nfunction makeGetData() {\n\tvar jObj = {};\n\tjObj.Kvp_sessionkey = '';\n\tjObj.Kvp_encryptdata = '';\n\tjObj.Kvp_noint = '';\n\tjObj.Kvp_quota = '';\n\tjObj.Kvp_cardcode = '';\n\tjObj.Kvp_coname = '';\n\tjObj.Kvp_prifix = '';\n\tjObj.Kvp_PaySet_Flag = '';\n\tjObj.Kvp_Using_Point = '';\n\tjObj.Vp_Success_SavePoint = '';\n\tjObj.Kvp_reserved1 = '';\n\tjObj.Kvp_reserved2 = '';\n\tjObj.Kvp_reserved3 = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_RET_CODE')) jObj.VP_PREDIS_RET_CODE = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_RCOUNT')) jObj.VP_PREDIS_RCOUNT = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MAMOUNT')) jObj.VP_PREDIS_MAMOUNT = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_TOT')) jObj.VP_PREDIS_DISAMOUNT_TOT = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MEMCODE')) jObj.VP_PREDIS_MEMCODE = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_CAMCODE')) jObj.VP_PREDIS_CAMCODE = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_RET_AMOUNT')) jObj.VP_PREDIS_RET_AMOUNT = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_M001')) jObj.VP_PREDIS_DISAMOUNT_M001 = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_M901')) jObj.VP_PREDIS_DISAMOUNT_M901 = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_DISAMOUNT_M902')) jObj.VP_PREDIS_DISAMOUNT_M902 = '';\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_RET_MEMGRADE')) jObj.VP_PREDIS_RET_MEMGRADE = '';\n\n\tvar i = 0;\n\tvar toJson = '{';\n\tfor (key in jObj) {\n\t\tif (i != 0) toJson += ',';\n\t\ttoJson += '\"' + key + '\":' + '\"' + jObj[key] + '\"';\n\t\ti++;\n\t}\n\ttoJson += '}';\n\n\treturn toJson;\n}\n\n/**\n * 결제 프로세스 재시작\n * @param {*} _reason \n */\nfunction restartPayment(_reason) {\n\tif (!m_instprocess) {\n\t\tm_instprocess = true;\n\t\tvp_ispplus_install.install(_reason);\n\t\tm_queryinstall_count = 5; // Pass initial install page\n\t\tclearInterval(m_checkinstall_timer);\n\t\tm_checkinstall_timer = setInterval(function () { CheckVersion(); }, 5000);\n\t}\n\telse if (m_eISPErrorStep == 'MakeSession' || m_eISPErrorStep == 'SetData') {\n\t\tm_checkinstall_timer = setInterval(function () { CheckVersion(); }, 5000);\n\t}\n}\n\nfunction RemoveEvent() {\n\tif (m_BrowserInfo == \"wsf\" || (m_OSInfo == \"Windows XP\" && (vp_util.getInternetExplorerVersion() > 0 && vp_util.getInternetExplorerVersion() < 8.0))) { }\n\telse {\n\t\tif (window.detachEvent)\n\t\t\twindow.detachEvent(\"onmessage\", m_ret_function);\n\t\telse\n\t\t\twindow.removeEventListener(\"message\", m_ret_function, false);\n\t\tvp_util.Write_ISP_Log(\"[RemoveEvent]\", m_ret_function.name);\n\t}\n}\n\n/**\n * XMLHttpRequest set\n * @param {*} _url\n * @returns XMLHttpRequest\n */\nfunction getXMLHttpRequestVP(_url) {\n\tvar xmlReqObj;\n\tfor (var xmlObjCount = 0; xmlObjCount < 5; xmlObjCount++) {\n\t\ttry {\n\t\t\tif (xmlObjCount == 0) {\n\t\t\t\tif (m_payMethod == 'eisp') {\n\t\t\t\t\tm_http_ver = 1;\n\t\t\t\t\txmlReqObj = new window.XDomainRequest();\n\t\t\t\t\txmlReqObj.setRequestHeader('Content-Type', 'text/plain');\n\t\t\t\t\txmlReqObj.onprogress = function () { };\n\t\t\t\t\txmlReqObj.ontimeout = function () { };\n\t\t\t\t\txmlReqObj.open('POST', _url);\n\t\t\t\t}\n\t\t\t\telse {\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t}\n\t\t\telse if (xmlObjCount == 1) {\n\t\t\t\tm_http_ver = 0;\n\t\t\t\txmlReqObj = new XMLHttpRequest();\n\t\t\t\txmlReqObj.open('POST', _url, true);\n\t\t\t}\n\t\t\telse if (xmlObjCount == 2) {\n\t\t\t\tm_http_ver = 2;\n\t\t\t\txmlReqObj = new ActiveXObject(\"Msxml2.XMLHTTP\");\n\t\t\t\txmlReqObj.open('POST', _url, true);\n\t\t\t}\n\t\t\telse if (xmlObjCount == 3) {\n\t\t\t\tm_http_ver = 2;\n\t\t\t\txmlReqObj = new ActiveXObject(\"Microsoft.XMLHTTP\");\n\t\t\t\txmlReqObj.open('POST', _url, true);\n\t\t\t}\n\t\t\telse {\n\t\t\t\tm_http_ver = 3;\n\t\t\t\txmlReqObj = null;\n\t\t\t\tvp_util.Write_ISP_Log(\"[getXMLHttpRequestVP] \", \"XMLHttpRequest is not available\");\n\t\t\t}\n\t\t\treturn xmlReqObj;\n\t\t} catch (e) {\n\t\t\tcontinue;\n\t\t}\n\t}\n}\n\n/**\n * 결제정보 전달 후 처리\n * @param {*} resHttp \n * @returns {function} eispMakePayMessage\n */\nfunction Ret_sendPay(resHttp) {\n\tvar rtnData = resHttp.responseText;\n\tvar rtn = null;\n\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[Ret_sendPay res status ]\", resHttp.status);\n\tif (undefined != resHttp.readyState) vp_util.Write_ISP_Log(\"[Ret_sendPay res readyState ]\", resHttp.readyState);\n\tvp_util.Write_ISP_Log(\"[Ret_sendPay m_queryinstall_count]\", m_queryinstall_count);\n\tvp_util.Write_ISP_Log(\"[Ret_sendPay res Data]\", resHttp.responseText);\n\ttry {\n\t\tif (rtnData != null && rtnData != undefined) {\n\t\t\tif (typeof jQuery !== \"undefined\") rtn = jQuery.parseJSON(rtnData);\n\t\t\telse if (typeof parent.jQuery !== \"undefined\") rtn = parent.jQuery.parseJSON(rtnData);\n\t\t\telse {\n\t\t\t\tvp_util.Write_ISP_Log(\"[jQuery undefine] \", \"\");\n\t\t\t\tisWellConn = false;\n\t\t\t\treturn eispMakePayMessage();\n\t\t\t}\n\t\t\tif (undefined != rtn.status) vp_util.Write_ISP_Log(\"[Ret_sendPay result]\", rtn.status);\n\t\t\tif (undefined != rtn.tid) {\n\t\t\t\tif (rtn.tid != '') {\n\t\t\t\t\tvp_util.Write_ISP_Log(\"[Ret_sendPay res tid]\", rtn.tid);\n\t\t\t\t\tif (rtn.tid.length >= 20) retCurrTID = rtn.tid;\n\t\t\t\t\tif (vp_util.IsPayboocOnlyPay(vpCardCode, vpIssuerCode)) return wispMakePayMessage();\n\t\t\t\t\tif (m_BrowserInfo == \"wsf\" || (m_BrowserInfo == \"wie\" && m_IEVersion == \"7r\")) return eispMakePayMessage();\n\t\t\t\t\tif (!vp_util.checkCardCodeNormal(vpCardCode)) return getVPCardCode();\n\t\t\t\t\tif (vp_util.checkQRTarget(vpCardCode, vpIssuerCode, vpPayform)) return wQRMakePayMessage();\n\t\t\t\t\telse return getPayMethod();\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[Ret_sendPay]\", error.toString());\n\t\tisWellConn = false;\n\t\treturn eispMakePayMessage();\n\t}\n\tvp_util.Write_ISP_Log(\"[Ret_sendPay]\", \"rtnData is null\");\n\tisWellConn = false;\n\treturn eispMakePayMessage();\n}\n\nfunction Err_sendPay(resHttp) {\n\tvp_util.Write_ISP_Log(\"[sendPayForm error]\", \"\");\n\tisWellConn = false;\n\treturn eispMakePayMessage();\n}\n\n/**\n * pay data 전송\n * @param {*} cmd \n * @param {*} m_url \n * @param {*} jsondata \n * @param {*} callbackFunc \n * @param {*} errbackFunc \n */\nfunction sendProc(cmd, m_url, jsondata, callbackFunc, errbackFunc) {\n\tvar svc_url = (m_url == undefined || m_url == null) ? GetCurent_url_POST() : m_url;\n\tvar httpReq = getXMLHttpRequestVP(svc_url);\n\tif (httpReq != null) {\n\t\tif (m_http_ver == 1) {\n\t\t\thttpReq.timeout = 10000000000;\n\t\t\thttpReq.onerror = function (event) {\n\t\t\t\tvp_util.Write_ISP_Log(\"[sendProc onerror] \", event.toString());\n\t\t\t\terrbackFunc(httpReq);\n\t\t\t};\n\t\t\thttpReq.onload = function () {\n\t\t\t\tvp_util.Write_ISP_Log(\"[sendProc onload] \", \"\");\n\t\t\t\tcallbackFunc(httpReq);\n\t\t\t};\n\t\t\thttpReq.send(jsondata);\n\t\t} else {\n\t\t\tif (m_payMethod == 'eisp') httpReq.setRequestHeader('Content-Type', 'text/plain');\n\t\t\telse if (cmd == \"sendPayForm\" || cmd == \"sendAuthData\") httpReq.setRequestHeader('Content-Type', 'application/json');\n\t\t\telse {\n\t\t\t\thttpReq.setRequestHeader(\"Content-type\", \"application/x-www-form-urlencoded\");\n\t\t\t}\n\t\t\tif (cmd == \"sendPayForm\" || cmd == \"sendAuthData\") {\n\t\t\t\thttpReq.setRequestHeader(\"X-login-token\", x_login_token);\n\t\t\t}\n\t\t\thttpReq.onreadystatechange = function () {\n\t\t\t\tif (httpReq.readyState == 4) {\n\t\t\t\t\tif (httpReq.status == 200) callbackFunc(httpReq);\n\t\t\t\t\telse if (httpReq.status == 405) return;\n\t\t\t\t\telse errbackFunc(httpReq);\n\t\t\t\t}\n\t\t\t};\n\t\t\thttpReq.send(jsondata);\n\t\t}\n\t} else {\n\t\tvp_util.Write_ISP_Log(\"[sendProc] \", \"XMLHttpRequest is not available\");\n\t\terrbackFunc(httpReq);\n\t}\n}\n\n/**\n * pay data 를 json 형태로 생성\n * @returns jsonString\n */\nfunction makeSetData() {\n\tvar jObj = {};\n\tjObj.CardCode = vpCardCode;\n\tjObj.tid = retCurrTID;\n\tjObj.VP_BCIssuerCode = vpIssuerCode;\n\tjObj.PGID = CheckFormField(vpPayform, 'KVP_PGID') ? vpPayform.KVP_PGID.value : '';\n\tjObj.NoInterestFlag = CheckFormField(vpPayform, 'KVP_NOINT_FLAG') ? vpPayform.KVP_NOINT_FLAG.value : '';\n\tjObj.GoodName = vp_util.getConvertedGoodName();\n\tjObj.Price = CheckFormField(vpPayform, 'KVP_PRICE') ? vpPayform.KVP_PRICE.value : '';\n\tjObj.Currency = CheckFormField(vpPayform, 'KVP_CURRENCY') ? vpPayform.KVP_CURRENCY.value : '';\n\tjObj.NoInterestInf = CheckFormField(vpPayform, 'KVP_NOINT_INF') ? vpPayform.KVP_NOINT_INF.value : '';\n\tjObj.QuotaInf = CheckFormField(vpPayform, 'KVP_QUOTA_INF') ? vpPayform.KVP_QUOTA_INF.value : '';\n\tjObj.BC_PubCertPriv = CheckFormField(vpPayform, 'KVP_BC_OACERT_INF') ? vpPayform.KVP_BC_OACERT_INF.value : '';\n\tjObj.SH_PubCertPriv = CheckFormField(vpPayform, 'KVP_SH_OACERT_INF') ? vpPayform.KVP_SH_OACERT_INF.value : '';\n\tjObj.JB_PubCertPriv = CheckFormField(vpPayform, 'KVP_JB_OACERT_INF') ? vpPayform.KVP_JB_OACERT_INF.value : '';\n\tjObj.KJ_PubCertPriv = CheckFormField(vpPayform, 'KVP_KJ_OACERT_INF') ? vpPayform.KVP_KJ_OACERT_INF.value : '';\n\tjObj.Kvp_fixPayFlag = CheckFormField(vpPayform, 'KVP_FIXPAYFLAG') ? vpPayform.KVP_FIXPAYFLAG.value : '';\n\tjObj.Kvp_Merchant_KB = CheckFormField(vpPayform, 'KVP_MERCHANT_KB') ? vpPayform.KVP_MERCHANT_KB.value : '';\n\tjObj.KB_SavePointree = CheckFormField(vpPayform, 'KVP_KB_SAVEPOINTREE') ? vpPayform.KVP_KB_SAVEPOINTREE.value : '';\n\tjObj.WR_SavePoint = CheckFormField(vpPayform, 'KVP_WR_SAVEPOINT') ? vpPayform.KVP_WR_SAVEPOINT.value : '';\n\tjObj.BC_SavePoint = CheckFormField(vpPayform, 'VP_BC_SAVEPOINT') ? vpPayform.VP_BC_SAVEPOINT.value : '';\n\tjObj.VP_ReqAuth = CheckFormField(vpPayform, 'VP_REQ_AUTH') ? vpPayform.VP_REQ_AUTH.value : '';\n\tjObj.PubCertPriv = CheckFormField(vpPayform, 'KVP_OACERT_INF') ? vpPayform.KVP_OACERT_INF.value : 'NONE';\n\tjObj.CURRENT_URL = encodeURIComponent(CURRENT_URL);\n\tjObj.VP_BROWSER = npEfdsUtil.getBwVsnCd();\n\tjObj.osInfo = m_OSInfo;\n\tjObj.USING_JS = js_name;\n\tjObj.isWebPOC = m_isPayMthdPopped;\n\tjObj.Check_JS = 'VPEISP';\n\tjObj.isWellConn = (isWellConn) ? \"TRUE\" : \"FALSE\";\n\tjObj.POP_BLOCKED = (m_isPopupBlocked) ? \"TRUE\" : \"FALSE\";\n\tjObj.BrowserName = m_BrowserInfo + ((m_BrowserInfo == \"wie\") ? m_IEVersion : \"\") + ((m_payMethod == 'eisp') ? \"\" : \"_wisp\");\n\tif (m_payMethod == 'eisp') {\n\t\tjObj.VP_MerchantID = CheckFormField(vpPayform, 'VP_MERCHANT_ID') ? vpPayform.VP_MERCHANT_ID.value : '';\n\t} else {\n\t\tjObj.VP_MERCHANT_ID = CheckFormField(vpPayform, 'VP_MERCHANT_ID') ? vpPayform.VP_MERCHANT_ID.value : '';\n\t}\n\tif (CheckFormField(vpPayform, 'VP_PG_TID')) jObj.VP_PG_TID = vpPayform.VP_PG_TID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_CON')) jObj.VP_PREDIS_CON = vpPayform.VP_PREDIS_CON.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_TID')) jObj.VP_PREDIS_TID = vpPayform.VP_PREDIS_TID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MCODE')) jObj.VP_PREDIS_MCODE = vpPayform.VP_PREDIS_MCODE.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_SORT')) jObj.VP_PREDIS_SORT = vpPayform.VP_PREDIS_SORT.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_CODE')) jObj.VP_PREDIS_CODE = vpPayform.VP_PREDIS_CODE.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MID')) jObj.VP_PREDIS_MID = vpPayform.VP_PREDIS_MID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_AMOUNT')) jObj.VP_PREDIS_AMOUNT = vpPayform.VP_PREDIS_AMOUNT.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_TCOUNT')) jObj.VP_PREDIS_TCOUNT = vpPayform.VP_PREDIS_TCOUNT.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_SHOWID')) jObj.VP_PREDIS_SHOWID = vpPayform.VP_PREDIS_SHOWID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_REAL_MID')) jObj.VP_PREDIS_REAL_MID = vpPayform.VP_PREDIS_REAL_MID.value;\n\n\tvar i = 0;\n\tvar toJson = '{';\n\tfor (key in jObj) {\n\t\tif (i != 0) toJson += ',';\n\t\ttoJson += '\"' + key + '\":' + '\"' + jObj[key] + '\"';\n\t\ti++;\n\t}\n\ttoJson += '}';\n\n\treturn toJson;\n}\n\n/**\n * send pay form 작성 \n * @returns {string} toJson\n */\nfunction makeSendPayFormData() {\n\tvar jObj = {};\n\tjObj.cardCode = vpCardCode;\n\tjObj.vP_BCIssuerCode = vpIssuerCode;\n\tjObj.pGID = CheckFormField(vpPayform, 'KVP_PGID') ? vpPayform.KVP_PGID.value : '';\n\tjObj.noInterestFlag = CheckFormField(vpPayform, 'KVP_NOINT_FLAG') ? vpPayform.KVP_NOINT_FLAG.value : '';\n\tjObj.goodName = vp_util.getConvertedGoodName();\n\tjObj.price = CheckFormField(vpPayform, 'KVP_PRICE') ? vpPayform.KVP_PRICE.value : '';\n\tjObj.currency = CheckFormField(vpPayform, 'KVP_CURRENCY') ? vpPayform.KVP_CURRENCY.value : '';\n\tjObj.noInterestInf = CheckFormField(vpPayform, 'KVP_NOINT_INF') ? vpPayform.KVP_NOINT_INF.value : '';\n\tjObj.quotaInf = CheckFormField(vpPayform, 'KVP_QUOTA_INF') ? vpPayform.KVP_QUOTA_INF.value : '';\n\tjObj.bC_PubCertPriv = CheckFormField(vpPayform, 'KVP_BC_OACERT_INF') ? vpPayform.KVP_BC_OACERT_INF.value : '';\n\tjObj.sH_PubCertPriv = CheckFormField(vpPayform, 'KVP_SH_OACERT_INF') ? vpPayform.KVP_SH_OACERT_INF.value : '';\n\tjObj.jB_PubCertPriv = CheckFormField(vpPayform, 'KVP_JB_OACERT_INF') ? vpPayform.KVP_JB_OACERT_INF.value : '';\n\tjObj.jJ_PubCertPriv = CheckFormField(vpPayform, 'KVP_KJ_OACERT_INF') ? vpPayform.KVP_KJ_OACERT_INF.value : '';\n\tjObj.kvp_fixPayFlag = CheckFormField(vpPayform, 'KVP_FIXPAYFLAG') ? vpPayform.KVP_FIXPAYFLAG.value : '';\n\tjObj.kvp_Merchant_KB = CheckFormField(vpPayform, 'KVP_MERCHANT_KB') ? vpPayform.KVP_MERCHANT_KB.value : '';\n\tjObj.kB_SavePointree = CheckFormField(vpPayform, 'KVP_KB_SAVEPOINTREE') ? vpPayform.KVP_KB_SAVEPOINTREE.value : '';\n\tjObj.wR_SavePoint = CheckFormField(vpPayform, 'KVP_WR_SAVEPOINT') ? vpPayform.KVP_WR_SAVEPOINT.value : '';\n\tjObj.bC_SavePoint = CheckFormField(vpPayform, 'VP_BC_SAVEPOINT') ? vpPayform.VP_BC_SAVEPOINT.value : '';\n\tjObj.vP_ReqAuth = CheckFormField(vpPayform, 'VP_REQ_AUTH') ? vpPayform.VP_REQ_AUTH.value : '';\n\tjObj.pubCertPriv = CheckFormField(vpPayform, 'KVP_OACERT_INF') ? vpPayform.KVP_OACERT_INF.value : 'NONE';\n\tjObj.QRFlag = CheckFormField(vpPayform, 'QRFlag') ? vpPayform.QRFlag.value : '';\n\tjObj.cURRENT_URL = encodeURIComponent(CURRENT_URL);\n\tjObj.vP_BROWSER = npEfdsUtil.getBwVsnCd();\n\tjObj.osInfo = m_OSInfo;\n\tjObj.uSING_JS = js_name;\n\tjObj.isWebPOC = m_isPayMthdPopped;\n\tjObj.check_JS = 'VPEISP';\n\tjObj.isWellConn = (isWellConn) ? \"TRUE\" : \"FALSE\";\n\tjObj.pOP_BLOCKED = (m_isPopupBlocked) ? \"TRUE\" : \"FALSE\";\n\tjObj.browserName = m_BrowserInfo + ((m_BrowserInfo == \"wie\") ? m_IEVersion : \"\") + ((m_payMethod == 'eisp') ? \"\" : \"_wisp\");\n\tif (m_payMethod == 'eisp') {\n\t\tjObj.vP_MerchantID = CheckFormField(vpPayform, 'VP_MERCHANT_ID') ? vpPayform.VP_MERCHANT_ID.value : '';\n\t} else {\n\t\tjObj.vP_MERCHANT_ID = CheckFormField(vpPayform, 'VP_MERCHANT_ID') ? vpPayform.VP_MERCHANT_ID.value : '';\n\t}\n\tif (CheckFormField(vpPayform, 'VP_PG_TID')) jObj.pgTid = vpPayform.VP_PG_TID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_CON')) jObj.vP_PREDIS_CON = vpPayform.VP_PREDIS_CON.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_TID')) jObj.vP_PREDIS_TID = vpPayform.VP_PREDIS_TID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MCODE')) jObj.vP_PREDIS_MCODE = vpPayform.VP_PREDIS_MCODE.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_SORT')) jObj.vP_PREDIS_SORT = vpPayform.VP_PREDIS_SORT.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_CODE')) jObj.vP_PREDIS_CODE = vpPayform.VP_PREDIS_CODE.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MID')) jObj.vP_PREDIS_MID = vpPayform.VP_PREDIS_MID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_AMOUNT')) jObj.vP_PREDIS_AMOUNT = vpPayform.VP_PREDIS_AMOUNT.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_TCOUNT')) jObj.vP_PREDIS_TCOUNT = vpPayform.VP_PREDIS_TCOUNT.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_SHOWID')) jObj.vP_PREDIS_SHOWID = vpPayform.VP_PREDIS_SHOWID.value;\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_REAL_MID')) jObj.vP_PREDIS_REAL_MID = vpPayform.VP_PREDIS_REAL_MID.value;\n\t\n\tvar i = 0;\n\tvar toJson = '{';\n\tfor (key in jObj) {\n\t\tif (i != 0) toJson += ',';\n\t\ttoJson += '\"' + key + '\":' + '\"' + jObj[key] + '\"';\n\t\ti++;\n\t}\n\ttoJson += '}';\n\n\treturn toJson;\n}\n\n/**\n * form object 에 필드 존재여부 확인\n * @param {*} CheckForm \n * @param {*} CheckFormFieldName \n * @returns true or false\n */\nfunction CheckFormField(CheckForm, CheckFormFieldName) {\n\ttry {\n\t\tif(CheckFormFieldName.toLowerCase().indexOf('kb_savepointree') !== -1) {\n\t\t\tvp_util.Write_ISP_Log(\"[CheckFormField]\", 'return false, because CheckFormFieldName is ['+CheckFormFieldName+']');\n\t\t\treturn false;\n\t\t}\n\t\tvar FormCnt = CheckForm.elements.length;\n\t\tvar FormName;\n\t\tvar Cnt = 0;\n\t\tvar CheckField = 0;\n\t\twhile (FormCnt > Cnt) {\n\t\t\tFormName = CheckForm.elements[Cnt].name;\n\t\t\tif (FormName == CheckFormFieldName)\n\t\t\t\tCheckField++;\n\t\t\tCnt++;\n\t\t}\n\t\tif (CheckField > 0)\n\t\t\treturn true;\n\t\telse\n\t\t\treturn false;\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[CheckFormField]\", error.toString());\n\t\treturn false;\n\t}\n}\n\n/**\n * object 에 필드 존재여부 확인\n * @param {*} CheckForm \n * @param {*} CheckFormFieldName \n * @param {*} CheckValue \n * @returns true or false\n */\nfunction CheckFormFieldValue(CheckForm, CheckFormFieldName, CheckValue) {\n\ttry {\n\t\tvar FormCnt = CheckForm.elements.length;\n\t\tvar FormName;\n\t\tvar Cnt = 0;\n\t\tvar CheckField = 0;\n\t\twhile (FormCnt > Cnt) {\n\t\t\tFormName = CheckForm.elements[Cnt].name;\n\t\t\tif (FormName == CheckFormFieldName) {\n\t\t\t\tif (CheckForm.elements[Cnt].value == CheckValue) {\n\t\t\t\t\tCheckField++;\n\t\t\t\t}\n\t\t\t}\n\t\t\tCnt++;\n\t\t}\n\t\tif (CheckField > 0)\n\t\t\treturn true;\n\t\telse\n\t\t\treturn false;\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[CheckFormField]\", error.toString());\n\t\treturn false;\n\t}\n}\n\n/**\n * 거래 취소\n * @param {*} _cancelCode \n */\nfunction CancelVPPayment(_cancelCode) {\n\tif (CheckFormField(vpPayform, \"VP_CANCEL_CODE\")) vpPayform.VP_CANCEL_CODE.value = _cancelCode;\n\tVP_Ret_Pay(false);\n}\n\n/**\n * smart update (프로그램 시작시 PG에서 호출)\n */\nfunction StartSmartUpdate() {\n\tvar VISTACAB_VER = \"1,1,2,2\";\n\tvar KVP_LOAD_STRING_IE = \"<OBJECT ID=KvpDwn CLASSID=CLSID:E78928A6-3D2A-4BF7-A100-F3FBAA351B49 width=0 height=0 CODEBASE=https://www.vpay.co.kr/kvpfiles/KVPISPCTLD.cab#Version=1,0,0,4></OBJECT>\";\n\tvar KVP_LOAD_STRING_VISTA = \"<OBJECT ID=KvpDwn CLASSID=CLSID:E78928A6-3D2A-4BF7-A100-F3FBAA351B49 width=0 height=0 CODEBASE=https://www.vpay.co.kr/kvpfiles_new/KVPISPCTLD_VISTA.cab#Version=\"\n\t\t+ VISTACAB_VER + \"></OBJECT>\";\n\tvar KVP_LOAD_STRING_VISTA64 = \"<OBJECT ID=KvpDwn CLASSID=CLSID:E78928A6-3D2A-4BF7-A100-F3FBAA351B49 width=0 height=0 CODEBASE=https://www.vpay.co.kr/kvpfiles_new/KVPISPCTLD_VISTA64.cab#Version=\"\n\t\t+ VISTACAB_VER + \"></OBJECT>\";\n\tvp_util.Write_ISP_Log(\"[CS|For ActiveX]\", \"StartSmartUpdate\");\n\tif (m_AX_mode == true) {\n\t\tif (m_BrowserInfo == \"wie\") {\n\t\t\ttry {\n\t\t\t\tvar ver = vp_util.CheckVer();\n\t\t\t\tif (ver == 1) {\n\t\t\t\t\tdocument.writeln(KVP_LOAD_STRING_VISTA);\n\t\t\t\t} else if (ver == 2) {\n\t\t\t\t\tdocument.writeln(KVP_LOAD_STRING_VISTA64);\n\t\t\t\t} else if (ver == 3) {\n\t\t\t\t\tdocument.writeln(KVP_LOAD_STRING_IE);\n\t\t\t\t} else {\n\t\t\t\t\tdocument.writeln(KVP_LOAD_STRING_IE);\n\t\t\t\t}\n\t\t\t} catch (e) {\n\t\t\t\talert(e.toString());\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunction showDivPop() {\n\ttry {\n\t\tvar showDiv = document.getElementById('newDiv');\n\t\tif (showDiv == null && showDiv == undefined) {\n\t\t\tvp_ispplus_install.OpenLoadingUI();\n\t\t} else {\n\t\t\tshowDiv.style.display = '';\n\t\t}\n\t} catch (e) {\n\t\talert(e.toString());\n\t}\n}\n\nfunction hideDivPop() {\n\ttry {\n\t\twispPopWinObj = void 0;\n\t\tvar hideDiv = document.getElementById('newDiv');\n\t\tif (hideDiv != null && hideDiv != undefined) hideDiv.style.display = 'none';\n\t} catch (e) {\n\t\talert(e.toString());\n\t}\n}\n\nfunction makeSessionID() {\n\tvar v_session = new Date().getTime().toString() + Math.floor(Math.random() * 100).toString();\n\treturn v_session;\n}\n\n/**\n * TID 생성\n * @returns tid\n */\nfunction genTID() {\n\tvar dateObj = new Date();\n\tvar hours = dateObj.getHours();\n\tvar minutes = dateObj.getMinutes();\n\tvar seconds = dateObj.getSeconds();\n\tvar month = dateObj.getMonth() + 1;\n\tvar text = '';\n\tvar possible = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\n\tvar date = dateObj.getDate();\n\n\thours = hours ? hours : 0; // the hour '0' should be '12'\n\thours = hours < 10 ? '0' + hours : hours;\n\tminutes = minutes < 10 ? '0' + minutes : minutes;\n\tseconds = seconds < 10 ? '0' + seconds : seconds;\n\n\tmonth = month < 10 ? '0' + month.toString() : month.toString();\n\tdate = date < 10 ? '0' + date.toString() : date.toString();\n\n\tfor (var i = 0; i < 21; i++)\n\t\ttext += possible.charAt(Math.floor(Math.random() * possible.length));\n\n\tvar strTime = hours.toString() + minutes.toString() + seconds.toString();\n\tvar tid = vpPayform.KVP_PGID.value + dateObj.getFullYear().toString() + month + date + strTime + text;\n\n\treturn tid;\n}\n\n/**\n * vp classes\n */\nvar vp_util = {\n\tWrite_ISP_Log: function (target, msg) {\n\t\tif (m_debug == true) {\n\t\t\tif (window.console)\n\t\t\t\tconsole.log(target + \" : \" + msg);\n\t\t}\n\t},\n\tgetInternetExplorerVersion: function () {\n\t\tvar rv = -1;\n\t\tif (navigator.appName == 'Microsoft Internet Explorer') {\n\t\t\tvar ua = navigator.userAgent;\n\t\t\tvar re = new RegExp(\"MSIE ([0-9]{1,}[\\.0-9]{0,})\");\n\t\t\tif (re.exec(ua) != null)\n\t\t\t\trv = parseFloat(RegExp.$1);\n\t\t}\n\t\treturn rv;\n\t},\n\tgetOSInfo: function () {\n\t\tvar ua = navigator.userAgent;\n\t\tif (ua.indexOf(\"Win16\") != -1) return \"Windows 3.x\";\n\t\tif (ua.indexOf(\"Windows\") != -1) {\n\t\t\tif (ua.indexOf(\"NT 6.1\") != -1) return \"Windows 7\";\n\t\t\telse if (ua.indexOf(\"NT 10.0\") != -1) return \"Windows 10\";\n\t\t\telse if (ua.indexOf(\"NT 6.3\") != -1) return \"Windows 8.1\";\n\t\t\telse if (ua.indexOf(\"NT 6.2\") != -1) return \"Windows 8\";\n\t\t\telse if (ua.indexOf(\"NT 5.1\") != -1) return \"Windows XP\";\n\t\t\telse if (ua.indexOf(\"NT 6.0\") != -1) return \"Windows Vista/Server 2008\";\n\t\t\telse if (ua.indexOf(\"NT 5.0\") != -1) return \"Windows 2000\";\n\t\t\telse if (ua.indexOf(\"NT\") != -1) return \"Windows NT\";\n\t\t\telse if (ua.indexOf(\"9x 4.90\") != -1) return \"Windows Me\";\n\t\t\telse if (ua.indexOf(\"98\") != -1) return \"Windows 98\";\n\t\t\telse if (ua.indexOf(\"95\") != -1) return \"Windows 95\";\n\t\t\telse return \"Windows\";\n\t\t} else {\n\t\t\tif (ua.indexOf(\"Macintosh\") != -1) return \"Macintosh\";\n\t\t\telse if (ua.indexOf(\"iPad\") != -1) return \"iPad\";\n\t\t\telse if (ua.indexOf(\"iPhone\") != -1) return \"iPhone\";\n\t\t\telse if (ua.indexOf(\"Android\") != -1) return \"Android\";\n\t\t\telse if (ua.indexOf(\"Linux\") != -1) return \"Linux\";\n\t\t}\n\t\treturn \"\";\n\t},\n\tisDisabledOS: function () {\n\t\ttry {\n\t\t\tif (m_OSInfo.indexOf(\"Windows\") != -1) {\n\t\t\t\tvar osVer = navigator.userAgent.split(\"NT\")[1].split(\";\")[0].replace(\" \", \"\");\n\t\t\t\tosVer = osVer.split(\")\")[0];\n\t\t\t\tif(osVer > 6.0) return false;\n\t\t\t}\n\t\t} catch (error) {\n\t\t\treturn true;\n\t\t}\n\t\treturn true;\n\t},\n\tbrowser_check: function (_osInfo) {\n\t\tif (_osInfo == \"\" || !_osInfo) {\n\t\t\tvar mOS = navigator.platform;\n\t\t\treturn mOS\n\t\t}\n\n\t\tvar mAgent = navigator.userAgent;\n\t\tif (_osInfo.indexOf(\"Windows\") != -1) {\n\t\t\tif (mAgent.indexOf(\"MSIE\") != -1) {\n\t\t\t\treturn \"wie\";\n\t\t\t} else if (mAgent.indexOf(\"Edg\") != -1) {\n\t\t\t\tvp_util.Write_ISP_Log(\"[browser_check]\", mAgent);\n\t\t\t\tvar agent = \"wedge\";\n\t\t\t\tvar chromeVersionMatch = mAgent.match(/Edg\\/(\\d+)\\./);\n\t\t\t\tif (chromeVersionMatch && chromeVersionMatch[1]) {\n\t\t\t\t\tvar majorVersion = parseInt(chromeVersionMatch[1], 10);\n\t\t\t\t\tvp_util.Write_ISP_Log(\"[browser_check_version]\", majorVersion);\n\t\t\t\t\tif(majorVersion >= 143) { //143 이상 대응\n\t\t\t\t\t\tagent = \"wchrome141\"\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn agent;\n\t\t\t} else if (mAgent.indexOf(\"Opera\") != -1) {\n\t\t\t\treturn \"wopera\";\n\t\t\t} else if (mAgent.indexOf(\"OPR\") != -1) {\n\t\t\t\treturn \"wopera\";\n\t\t\t} else if (mAgent.indexOf(\"Firefox\") != -1) {\n\t\t\t\treturn \"wff\";\n\t\t\t} else if (mAgent.indexOf(\"Whale\") != -1) {\n\t\t\t\treturn \"wwhale\";\n\t\t\t} else if (mAgent.indexOf(\"Chrome\") != -1) {\n\t\t\t\tvp_util.Write_ISP_Log(\"[browser_check]\", mAgent);\n\t\t\t\tvar agent = \"wchrome\";\n\t\t\t\tvar chromeVersionMatch = mAgent.match(/Chrome\\/(\\d+)\\./);\n\t\t\t\tif (chromeVersionMatch && chromeVersionMatch[1]) {\n\t\t\t\t\tvar majorVersion = parseInt(chromeVersionMatch[1], 10);\n\t\t\t\t\tvp_util.Write_ISP_Log(\"[browser_check_version]\", majorVersion);\n\t\t\t\t\tif(majorVersion >= 142) { //142 이상 대응\n\t\t\t\t\t\tagent = \"wchrome141\"\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn agent;\n\t\t\t} else if (mAgent.indexOf(\"Safari\") != -1) {\n\t\t\t\treturn \"wsf\";\n\t\t\t} else if (mAgent.indexOf(\"Mozilla/5.0\") != -1) {\n\t\t\t\tif (navigator.appName == 'Netscape') {\n\t\t\t\t\tvar ua = navigator.userAgent;\n\t\t\t\t\tvar re = new RegExp(\"Trident/.*rv:([0-9]{1,}[\\.0-9]{0,})\");\n\t\t\t\t\tif (re.exec(ua) != null) {\n\t\t\t\t\t\tvar rv = -1;\n\t\t\t\t\t\trv = parseFloat(RegExp.$1);\n\t\t\t\t\t\tif (rv != -1) {\n\t\t\t\t\t\t\treturn \"wie\";\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t} else if (_osInfo == \"Macintosh\") {\n\t\t\tif (mAgent.indexOf(\"MSIE\") != -1) {\n\t\t\t\treturn \"mie\";\n\t\t\t} else if (mAgent.indexOf(\"Opera\") != -1) {\n\t\t\t\treturn \"mopera\";\n\t\t\t} else if (mAgent.indexOf(\"OPR\") != -1) {\n\t\t\t\treturn \"mopera\";\n\t\t\t} else if (mAgent.indexOf(\"Firefox\") != -1) {\n\t\t\t\treturn \"mff\";\n\t\t\t} else if (mAgent.indexOf(\"Chrome\") != -1) {\n\t\t\t\treturn \"mchrome\";\n\t\t\t} else if (mAgent.indexOf(\"Safari\") != -1) {\n\t\t\t\treturn \"msf\";\n\t\t\t}\n\t\t}\n\t\t\n\t\treturn _osInfo;\n\t},\n\tCheckVer: function () {\n\t\tvar webblasare = navigator.appVersion;\n\n\t\tif (webblasare.indexOf(\"WOW64\") != -1) {\n\t\t\tif (webblasare.indexOf(\"Windows NT 5.1\") != -1 || webblasare.indexOf(\"Windows NT 5.2\") != -1) {\n\t\t\t\treturn 3;\n\t\t\t} else {\n\t\t\t\treturn 2;\n\t\t\t}\n\t\t} else if (webblasare.indexOf(\"Windows NT 6.0\") != -1 || webblasare.indexOf(\"Windows NT 6.1\") != -1 || webblasare.indexOf(\"Windows NT 6.2\") != -1) {\n\t\t\treturn 1;\n\t\t} else {\n\t\t\treturn 0;\n\t\t}\n\t},\n\tcheckEssentialForm: function () {\n\t\tvar vpCheckInfoCnt = 0;\n\t\tif (CheckFormField(vpPayform, \"KVP_PRICE\")) {\n\t\t\tif (vpPayform.KVP_PRICE.value != \"0\" && vpPayform.KVP_PRICE.value != \"\") {\n\t\t\t\tvpCheckInfoCnt += 1;\n\t\t\t}\n\t\t}\n\t\tif (vpCheckInfoCnt == 1) return true;\n\t\telse return false;\n\t},\n\tVPPopupAllowAlert: function (_browser, _curUrl, _osInfo) {\n\t\tvar popupMthd = \"alert\"; //confirm\n\t\tvar availPGArray = new Array('pay.kcp.co.kr', 'www.allthegate.com', 'www.vpay.co.kr');\n\t\tif (_osInfo.indexOf(\"Windows\") != -1) {\n\t\t\tfor (var j = 0; j < availPGArray.length; j++) {\n\t\t\t\tif (_curUrl.indexOf(availPGArray[j]) != -1) {\n\t\t\t\t\tpopupMthd = \"confirm\";\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tvar vpPopupAlertString = \"\";\n\t\tif (popupMthd == \"confirm\") {\n\t\t\tvpPopupAlertString += \"고객님의 브라우저에 팝업차단이 설정되어 있습니다.\\n\";\n\t\t\tvpPopupAlertString += \"기존 방식으로 진행을 원하실 경우, [확인]을 눌러주세요.\\n\";\n\t\t\tvpPopupAlertString += \"신규 웹 방식으로 진행을 원하실 경우, [취소]를 누르신 후 팝업차단을 해제해주세요.\\n\\n\";\n\t\t\tif (_browser == \"wie\") {\n\t\t\t\tvpPopupAlertString += \"[팝업 차단 해제 방법]\\n\";\n\t\t\t\tvpPopupAlertString += \"1. 인터넷 익스플로어 하단 또는 상단에 '팝업허용' 선택\\n\";\n\t\t\t\tvpPopupAlertString += \"2. 인터넷 익스플로어 설정 변경\\n\";\n\t\t\t\tvpPopupAlertString += \"도구 > 인터넷 옵션 > 개인 정보(탭) > 팝업 차단 사용 체크 해제\\n\\n\";\n\t\t\t} else {\n\t\t\t\tvpPopupAlertString += \"해제 이후 '페이지 새로고침(F5키)'이 필요할 수 있습니다.\\n\";\n\t\t\t}\n\t\t\treturn confirm(vpPopupAlertString);\n\t\t} else {\n\t\t\tif (_browser == \"wie\") {\n\t\t\t\tvpPopupAlertString += \"팝업 차단 또는 신뢰 사이트 설정을 확인해 주세요\\n\\n\";\n\t\t\t\tvpPopupAlertString += \"[팝업 차단 해제 방법]\\n\\n\";\n\t\t\t\tvpPopupAlertString += \"1. 인터넷 익스플로어 하단 또는 상단에 '팝업허용' 선택\\n\";\n\t\t\t\tvpPopupAlertString += \"2. 인터넷 익스플로어 설정 변경\\n\";\n\t\t\t\tvpPopupAlertString += \"도구 > 인터넷 옵션 > 개인 정보(탭) > 팝업 차단 사용 체크 해제\\n\\n\";\n\t\t\t\tvpPopupAlertString += \"또는\\n\\n\";\n\t\t\t\tvpPopupAlertString += \"[신뢰 사이트 설정 변경 방법]\\n\\n\";\n\t\t\t\tvpPopupAlertString += \"도구 > 인터넷 옵션 > 보안(탭) > 신뢰할 수 있는 사이트 > 사이트(버튼)에 아래 2개 주소 2개를 삭제하거나 둘 다 추가\\n\\n\";\n\t\t\t\tvpPopupAlertString += _curUrl;\n\t\t\t\tvpPopupAlertString += \"\\n\"+config.ui_domain+\"\\n\\n\";\n\t\t\t\tvpPopupAlertString += \"설정 이후 '페이지 새로고침(F5키)'이 필요합니다.\";\n\t\t\t}\n\t\t\telse {\n\t\t\t\tvpPopupAlertString += \"아래 확인 버튼을 클릭하시고 팝업차단을 해제하여 주시기 바랍니다.\\n\\n\";\n\t\t\t\tvpPopupAlertString += \"해제 이후 '페이지 새로고침(F5키)'이 필요할 수 있습니다.\\n\";\n\t\t\t}\n\t\t\talert(vpPopupAlertString);\n\t\t\treturn false;\n\t\t}\n\t},\n\tgetConvertedGoodName: function () {\n\t\tvar v_GoodName = \"\";\n\t\tvar count = 0;\n\t\tvar i = 0;\n\t\tif (CheckFormField(vpPayform, \"KVP_GOODNAME\")) {\n\t\t\tv_GoodName = vpPayform.KVP_GOODNAME.value;\n\t\t\tv_GoodName = v_GoodName.replace(/http/gi, \"\");\n\t\t\tv_GoodName = v_GoodName.replace(/[\\r\\n\\t|\\n|\\r\\t|=|%|×|\\\"|\\\\|\"]/gm, \"\");\n\t\t\tv_GoodName = v_GoodName.replace(/&/gi, \"and\");\n\t\t\tfor (i = 0; i < v_GoodName.length; i++) {\n\t\t\t\tif (escape(v_GoodName.charAt(i)).length >= 4) count += 2;\n\t\t\t\telse if (escape(v_GoodName.charAt(i)) !== '%0D') count++;\n\t\t\t\tif (count > 99) {\n\t\t\t\t\tif (escape(v_GoodName.charAt(i)) === '%0A') i--;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\tthis.Write_ISP_Log(\"[getConvertedGoodName]\", v_GoodName);\n\t\t\tv_GoodName = encodeURIComponent(v_GoodName.substring(0, i));\n\t\t}\n\t\treturn v_GoodName;\n\t},\n\tgetVPCardAndIssuerCode: function () {\n\t\tif (CheckFormField(vpPayform, \"KVP_CARDCOMPANY\")) {\n\t\t\tif (m_isChangedCardCode == true) {\n\t\t\t\tm_isChangedCardCode = false;\n\t\t\t\tvpCardCode = '';\n\t\t\t\tvpIssuerCode = '';\n\t\t\t} else {\n\t\t\t\tvpCardCode = vpPayform.KVP_CARDCOMPANY.value;\n\t\t\t\tif (CheckFormField(vpPayform, \"VP_BC_ISSUERCODE\")) vpIssuerCode = vpPayform.VP_BC_ISSUERCODE.value;\n\t\t\t}\n\t\t}\n\t\tvpCardCode = vpCardCode.replace(/^\\s+|\\s+$/g, '');\n\t\tvpIssuerCode = vpIssuerCode.replace(/^\\s+|\\s+$/g, '');\n\t\tif (vpCardCode == \"0700\" ||