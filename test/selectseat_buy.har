\"+ config.ui_domain + \"/assets/images/gate/btn_card_57_hover.png'\\\" onmouseout=\\\"this.src='\"+ config.ui_domain + \"/assets/images/gate/btn_card_57.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"</ul>\";\n\tcardSelectDiv += \"</div>\";\n\tcardSelectDiv += \"</div>\";\n\tcardSelectDiv += \"</div>\";\n\tcardSelectDiv += \"</body>\";\n\tcardSelectDiv += \"</html>\";\n\n\tif (typeof wispPopWinObj == \"undefined\") {\n\t\twispPopWinObj = window.open('about:blank', 'vpWispWin', vp_util.getPopupWindowOption(\"cardselect\"));\n\t}\n\tif (wispPopWinObj == null) {\n\t\tif (vp_util.VPPopupAllowAlert(m_BrowserInfo, CURRENT_URL, m_OSInfo)) {\n\t\t\tm_isPopupBlocked = true;\n\t\t\treturn eispMakePayMessage();\n\t\t} else {\n\t\t\thideDivPop();\n\t\t\treturn CancelVPPayment('02');\n\t\t}\n\t} else {\n\t\twispPopWinStep = \"cardSelect\";\n\t\ttry {\n\t\t\twispPopWinObj.document.open();\n\t\t\twispPopWinObj.document.write(cardSelectDiv);\n\t\t\twispPopWinObj.document.close();\n\t\t} catch (error) {\n\t\t\twispPopWinObj.close();\n\t\t\treturn eispMakePayMessage();\n\t\t}\n\t}\n\twispPopWinObj.focus();\n\tChkWispPopWinClosed();\n}\n\n/**\n * 카드코드 설정\n * @param {*} cardCode \n * @param {*} issuerCode \n */\nfunction setVPCardCode(cardCode, issuerCode) {\n\tvpCardCode = cardCode;\n\tvpIssuerCode = issuerCode;\n\tm_isChangedCardCode = true;\n\t\n\tif (vp_util.checkQRTarget(vpCardCode, vpIssuerCode, vpPayform)) {\n\t\ttry {\n\t\t\twispPopWinObj.resizeBy(0, -180);\t\n\t\t} catch (error) {\n\t\t\tvp_util.Write_ISP_Log(\"[wispPopWinObj resizeBy]\", error);\n\t\t}\n\t\treturn wQRMakePayMessage();\n\t} else if (vpCardCode == \"0204\") {\n\t\teispMakePayMessage();\n\t\twispPopWinObj.close();\n\t} else if (vpCardCode == \"0100\" && vpIssuerCode == \"KI\") {\n\t\tm_isPayMthdPopped = 'TRUE';\n\t\teispMakePayMessage();\n\t\twispPopWinObj.close();\n\t} else {\n\t\ttry {\n\t\t\twispPopWinObj.resizeBy(0, -180);\t\n\t\t} catch (error) {\n\t\t\tvp_util.Write_ISP_Log(\"[wispPopWinObj resizeBy]\", error);\n\t\t}\n\t\treturn getPayMethod();\n\t}\n}\n\n/**\n * Elements Hidden 처리\n * @param {*} formObj \n * @param {*} name \n * @param {*} value \n * @param {*} isAppend \n * @returns formObj\n */\nfunction kvpAddHidden(formObj, name, value, isAppend) {\n\tif (CheckFormField(formObj, name) && !isAppend) {\n\t\tvar frmElements = formObj.elements[name];\n\t\tfrmElements.value = value;\n\t} else {\n\t\tvar m_input = kvpgetInputTag('hidden', name, value);\n\t\tformObj.appendChild(m_input);\n\t}\n\treturn formObj;\n}\n\n/**\n * 전송 formObj 생성\n * @param {*} name \n * @param {*} method \n * @param {*} action \n * @param {*} target \n * @returns formObj\n */\nfunction kvpCreateForm(name, method, action, target) {\n\tvar tmpForm = document.getElementsByName(name);\n\tvar formObj;\n\n\tif (tmpForm.length > 0) formObj = tmpForm[0];\n\telse formObj = document.createElement('form');\n\n\tformObj.name = name;\n\tformObj.method = method;\n\tformObj.action = action;\n\tformObj.target = target;\n\n\tif (tmpForm.length < 1) document.body.appendChild(formObj);\n\treturn formObj;\n}\n\n/**\n * input tag 설정\n * @param {*} type \n * @param {*} name \n * @param {*} value \n * @returns tagObj\n */\nfunction kvpgetInputTag(type, name, value) {\n\tvar tagObj = document.createElement('input');\n\ttagObj.setAttribute(\"type\", type);\n\ttagObj.setAttribute(\"name\", name);\n\ttagObj.setAttribute(\"value\", value);\n\treturn tagObj;\n}\n\n/**\n * PayMethod 화면 노출\n */\nfunction getPayMethod() {\n\tif (vp_util.IsPayboocOnlyPay(vpCardCode, vpIssuerCode)) return wispMakePayMessage();\n\tif (vp_util.checkQRTarget(vpCardCode, vpIssuerCode, vpPayform)) return wQRMakePayMessage();\n\tif (vpCardCode == \"0204\") return eispMakePayMessage(); \n\tif (CheckFormFieldValue(vpPayform, \"VP_PREDIS_CON\", \"TRUE\")) return eispMakePayMessage();\n\tif (vpCardCode == \"0100\" && (vpIssuerCode == \"KI\" || vpIssuerCode == \"44\")) {\n\t\tm_isPayMthdPopped = 'TRUE';\n\t\treturn eispMakePayMessage();\n\t}\n\tvar payGateDiv = '';\n\tpayGateDiv += '<!DOCTYPE html>';\n\tpayGateDiv += '<html lang=\\\"ko\\\">';\n\tpayGateDiv += '<head>';\n\tpayGateDiv += '<title>ISP/페이북</title>';\n\tpayGateDiv += '<meta charset=\\\"UTF-8\\\">';\n\tpayGateDiv += '<meta http-equiv=\\\"X-UA-Compatible\\\" content=\\\"IE=edge, chrome=1\\\">';\n\tpayGateDiv += '<link rel=\\\"stylesheet\\\" href=\\\"'+ vpDomain +'/eISP/style/bc.paybooc.gate2.css\\\">';\n\tpayGateDiv += '<script src=\\\"https://www.vpay.co.kr/eISP/jquery-1.12.4.min.js\\\"></script>';\n\tpayGateDiv += '<script src=\\\"https://www.vpay.co.kr/eISP/slick.min.js\\\"></script>';\n\tpayGateDiv += '<script src=\\\"'+ vpDomain +'/eISP/Wallet_gate2_VP.js\\\"></script>';\n\tpayGateDiv += '</head>';\n\tpayGateDiv += '<body>';\n\tpayGateDiv += '<div class=\\\"pages page-layout-gate\\\">';\n\tpayGateDiv += '<div class=\\\"layout-header\\\">';\n\tpayGateDiv += '<h1 class=\\\"page-title\\\">';\n\tpayGateDiv += '<span class=\\\"logo\\\">페이북</span>';\n\tpayGateDiv += '<span class=\\\"title\\\">결제 게이트</span>';\n\tpayGateDiv += '</h1>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div id=\\\"inapppay-dap1\\\" class=\\\"layout-cont\\\">';\n\tpayGateDiv += '<div class=\\\"block1\\\">';\n\tpayGateDiv += '<div class=\\\"left\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" onclick=\\\"wQRPay()\\\" class=\\\"pay-item-m pay-app\\\">';\n\tpayGateDiv += '<div class=\\\"txt\\\">';\n\tpayGateDiv += '<p class=\\\"tt\\\">페이북 앱 결제<span class=\\\"badge\\\">추천</span></p>';\n\tpayGateDiv += '<p class=\\\"tx\\\">앱으로 QR 스캔하면 끝!</p>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<span class=\\\"btn\\\">결제하기</span>';\n\tpayGateDiv += '</a>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"right\\\">';\n\tpayGateDiv += '<div class=\\\"banner-pc slick-ad-banner\\\">';\n\tpayGateDiv += '<div class=\\\"slick-item\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"adt-item\\\">';\n\tpayGateDiv += '<img src=\\\"\\\" alt=\\\"\\\">';\n\tpayGateDiv += '</a>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"block2\\\">';\n\tpayGateDiv += '<div class=\\\"left\\\"><a href=\\\"javascript:void(0)\\\" class=\\\"btn-etcpayment\\\">기타 결제</a></div>';\n\tpayGateDiv += '<div class=\\\"right\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"btn-appdownload\\\"><span class=\\\"ico\\\"></span>페이북 앱 다운로드</a>';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"btn-useablecard\\\"><span class=\\\"ico\\\"></span>이용가능 카드 안내</a>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div id=\\\"inapppay-dap2\\\" class=\\\"layout-cont\\\">';\n\tpayGateDiv += '<div class=\\\"block1\\\">';\n\tpayGateDiv += '<div class=\\\"left\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" onclick=\\\"wQRPay()\\\" class=\\\"pay-item-s pay-app\\\">';\n\tpayGateDiv += '<p class=\\\"tt\\\">페이북 앱 결제<span class=\\\"badge\\\">추천</span></p>';\n\tpayGateDiv += '</a>';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" onclick=\\\"pocPay()\\\" class=\\\"pay-item-s pay-psw\\\">';\n\tpayGateDiv += '<p class=\\\"tt\\\">비밀번호 결제</p>';\n\tpayGateDiv += '</a>';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" onclick=\\\"ispPay()\\\" class=\\\"pay-item-s pay-ctf\\\">';\n\tpayGateDiv += '<p class=\\\"tt\\\">인증서 등록/결제</p>';\n\tpayGateDiv += '<p class=\\\"tx\\\">기업공용카드, 선불카드, 본인 명의 카드 또는<br>휴대폰이 아닌 경우 및 기존 ISP 등록 카드</p>';\n\tpayGateDiv += '</a>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"right\\\">';\n\tpayGateDiv += '<div class=\\\"banner-pc slick-ad-banner\\\">';\n\tpayGateDiv += '<div class=\\\"slick-item\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"adt-item\\\">';\n\tpayGateDiv += '<img src=\\\"\\\" alt=\\\"\\\">';\n\tpayGateDiv += '</a>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"block2\\\">';\n\tpayGateDiv += '<div class=\\\"left\\\"></div>';\n\tpayGateDiv += '<div class=\\\"right\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"btn-appdownload\\\"><span class=\\\"ico\\\"></span>페이북 앱 다운로드</a>';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"btn-useablecard\\\"><span class=\\\"ico\\\"></span>이용가능 카드 안내</a>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"layout-popup-normal\\\" id=\\\"layerPopup-payboocGuide\\\">';\n\tpayGateDiv += '<div class=\\\"layout-popup-content\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"btn-layout-close\\\"><img src=\\\"'+ vpDomain +'/eISP/images/gate2/btn_close02.png\\\"></a>';\n\tpayGateDiv += '<h3 class=\\\"title\\\">페이북 이용안내</h3>';\n\tpayGateDiv += '<p class=\\\"cnt\\\"><img src=\\\"'+ vpDomain +'/eISP/images/gate2/popup_paybooc.png\\\"></p>';\n\tpayGateDiv += '<h3 class=\\\"title\\\">페이북 앱 결제 순서안내</h3>';\n\tpayGateDiv += '<p class=\\\"cnt\\\"><img src=\\\"'+ vpDomain +'/eISP/images/gate2/popup_paybooc_step.png\\\"></p>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"bg-dim\\\"></div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"layout-popup-normal\\\" id=\\\"layerPopup-useableCard\\\">';\n\tpayGateDiv += '<div class=\\\"layout-popup-content\\\">';\n\tpayGateDiv += '<a href=\\\"javascript:void(0)\\\" class=\\\"btn-layout-close\\\"><img src=\\\"'+ vpDomain +'/eISP/images/gate2/btn_close02.png\\\"></a>';\n\tpayGateDiv += '<h3 class=\\\"title\\\">이용가능 카드</h3>';\n\tpayGateDiv += '<p class=\\\"cnt\\\">바로카드, 우리카드, SC제일, 하나BC, 농협BC, IBK기업, KB국민BC, iM뱅크, BNK부산, BNK경남, 씨티BC, 신한BC, 저축은행중앙회, 수협은행, 우체국, 새마을금고중앙회,\t광주은행, 한국산업은행, 제주은행, 신협중앙회, 교보증권, 유진투자증권, 미래에셋증권, 유안타증권, DB증권, SK증권, NH투자증권, 케이뱅크, 카카오페이카드, 코나카드, 산림조합, 한국투자증권, 지머니트랜스, 핀트카드, KG파이낸셜, 한패스, 코인샷카드, 비즈플레이, 우리은행, 섹타나인, 중국은행, 네이버카드, 글로벌머니익스프레스, 머니트리카드, 다날, 헥토파이낸셜</p>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '<div class=\\\"bg-dim\\\"></div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</div>';\n\tpayGateDiv += '</body>';\n\tpayGateDiv += '</html>';\n\n\tif (typeof wispPopWinObj == \"undefined\") {\n\t\twispPopWinObj = window.open('about:blank', 'vpWispWin', vp_util.getPopupWindowOption());\n\t}\n\tif (wispPopWinObj == null) {\n\t\tif (vp_util.VPPopupAllowAlert(m_BrowserInfo, CURRENT_URL, m_OSInfo)) {\n\t\t\tm_isPopupBlocked = true;\n\t\t\treturn eispMakePayMessage();\n\t\t} else {\n\t\t\thideDivPop();\n\t\t\treturn CancelVPPayment('02');\n\t\t}\n\t} else {\n\t\twispPopWinStep = \"payMthd\";\n\t\ttry {\n\t\t\twispPopWinObj.document.open();\n\t\t\twispPopWinObj.document.write(payGateDiv);\n\t\t\twispPopWinObj.document.close();\n\t\t} catch (error) {\n\t\t\twispPopWinObj.close();\n\t\t\treturn eispMakePayMessage();\n\t\t}\n\t}\n\tm_isPayMthdPopped = 'TRUE';\n\tsetTimeout(function () { wispPopWinObj.focus(); }, 600);\n\tChkWispPopWinClosed();\n}\n\n/**\n * wisp 여부 체크 및 팝업 닫기\n */\nfunction ChkWispPopWinClosed() {\n\ttry {\n\t\tif (this.wispPopWinObj && this.wispPopWinObj.closed) {\n\t\t\tvp_util.Write_ISP_Log(\"[ChkWispPopWinClosed]\", wispPopWinStep);\n\t\t\tm_queryinstall_count++;\n\t\t\tif (wispPopWinStep == \"cardSelect\") {\n\t\t\t\tif (m_isChangedCardCode == false) {\n\t\t\t\t\twispPopWinStep = \"\";\n\t\t\t\t\thideDivPop();\n\t\t\t\t\tCancelVPPayment('01');\n\t\t\t\t}\n\t\t\t} else if (wispPopWinStep == \"payMthd\") {\n\t\t\t\tif (m_isPayMthdSelected == false) {\n\t\t\t\t\twispPopWinStep = \"\";\n\t\t\t\t\thideDivPop();\n\t\t\t\t\tCancelVPPayment('01');\n\t\t\t\t}\n\t\t\t} else if (wispPopWinStep == \"webPay\") {\n\t\t\t\twispPopWinStep = \"\";\n\t\t\t\tvar reqUrl = config.api_domain + \"/pb-api/payment/send-auth-data\";\n\t\t\t\tvar tidString = \"{\\\"tid\\\":\\\"\" + retCurrTID +\"\\\"}\";\n\t\t\t\tsendProc('sendAuthData', reqUrl, tidString, Ret_Finish, Err_Finish);\n\t\t\t}\n\t\t}\n\t\telse {\n\t\t\tsetTimeout(function () { ChkWispPopWinClosed(); }, 500);\n\t\t}\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[ChkWispPopWinClosed catch event]\", error.toString());\n\t}\n}\n\n/**\n * 거래 종료\n * @param {*} resHttp \n */\nfunction Ret_Finish(resHttp) {\n\ttry {\n\t\tvar rtnData = resHttp.responseText;\n\t\tvar rtn = null;\n\t\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[Ret_Finish res status ]\", resHttp.status);\n\t\tif (undefined != resHttp.readyState) vp_util.Write_ISP_Log(\"[Ret_Finish res readyState ]\", resHttp.readyState);\n\t\tvp_util.Write_ISP_Log(\"[Ret_Finish m_queryinstall_count]\", m_queryinstall_count);\n\t\tvp_util.Write_ISP_Log(\"[Ret_Finish res Data]\", resHttp.responseText);\n\n\t\tif (rtnData != null && rtnData != undefined) {\n\t\t\tif (typeof jQuery !== \"undefined\") rtn = jQuery.parseJSON(rtnData);\n\t\t\telse if (typeof parent.jQuery !== \"undefined\") rtn = parent.jQuery.parseJSON(rtnData);\n\t\t\telse {\n\t\t\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t\t\t\thideDivPop();\n\t\t\t\treturn CancelVPPayment('13');\n\t\t\t}\n\n\t\t\tif (undefined != rtn.code) vp_util.Write_ISP_Log(\"[Ret_Finish result]\", rtn.code);\n\t\t\tif (rtn.code == 'S_OK') {\n\t\t\t\tif (undefined != rtn.code) vp_util.Write_ISP_Log(\"[Ret_Finish end success][code][\" + m_queryinstall_count + \"]\", rtn.code);\n\t\t\t\tm_queryinstall_count = 0;\n\t\t\t\tif (rtn.response) {\n\t\t\t\t\tif (rtn.response.sessionkey != undefined) vp_util.Write_ISP_Log(\"[Ret_Finish res sessionkey]\", rtn.response.sessionkey);\n\t\t\t\t\tif (rtn.response.encData != undefined) vp_util.Write_ISP_Log(\"[Ret_Finish res encData]\", rtn.response.encData);\n\t\t\t\t\tif (rtn.response.cardcode != undefined) vp_util.Write_ISP_Log(\"[Ret_Finish res cardcode]\", rtn.response.cardcode);\n\t\t\t\t\tif (rtn.response.cardPrefix != undefined) vp_util.Write_ISP_Log(\"[Ret_Finish res cardPrefix]\", rtn.response.cardPrefix);\n\t\t\t\t\tif (rtn.response.quota != undefined) vp_util.Write_ISP_Log(\"[Ret_Finish res quota]\", rtn.response.quota);\n\t\t\t\t\tif (rtn.response.noint != undefined) vp_util.Write_ISP_Log(\"[Ret_Finish res noint]\", rtn.response.noint);\n\t\t\t\t\tif (rtn.response.vpCardToken != undefined) vp_util.Write_ISP_Log(\"[Ret_Finish res vpCardToken]\", rtn.response.vpCardToken);\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_SESSIONKEY')) vpPayform.KVP_SESSIONKEY.value = rtn.response.sessionkey;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_ENCDATA')) vpPayform.KVP_ENCDATA.value = rtn.response.encData;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_CARDCODE')) vpPayform.KVP_CARDCODE.value = rtn.response.cardcode;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_CARD_PREFIX')) vpPayform.KVP_CARD_PREFIX.value = rtn.response.cardPrefix;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_QUOTA')) vpPayform.KVP_QUOTA.value = rtn.response.quota;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'KVP_NOINT')) vpPayform.KVP_NOINT.value = rtn.response.noint;\n\t\t\t\t\tif (CheckFormField(vpPayform, 'VP_CARD_TOKEN')) vpPayform.VP_CARD_TOKEN.value = rtn.response.vpCardToken ? rtn.response.vpCardToken : \"\";\n\t\t\t\t\treplKvpCardCd(); VP_Ret_Pay(true); // 결제인증완료\n\t\t\t\t\thideDivPop();\n\t\t\t\t} else {\n\t\t\t\t\thideDivPop();\n\t\t\t\t\tCancelVPPayment('13');// response 비정상\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif (undefined != rtn.code) vp_util.Write_ISP_Log(\"[Ret_Finish res status]\", rtn.code);\n\t\t\t\tm_queryinstall_count = 0;\n\t\t\t\tif (this.wispPopWinObj != null && !this.wispPopWinObj.closed) wispPopWinObj.close();\n\t\t\t\thideDivPop();\n\t\t\t\tCancelVPPayment('01');// 결제인증완료\n\t\t\t}\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_Finish]\", \"rtnData is null\");\n\t\t\tChkWispPopWinClosed();\n\t\t}\n\t} catch (error) {\n\t\tvp_util.Write_ISP_Log(\"[Ret_Finish catch event]\", error.toString());\n\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t\thideDivPop();\n\t\tCancelVPPayment('99');\n\t}\n}\n\n/**\n * 거래종료 - ERROR\n * @param {*} resHttp \n */\nfunction Err_Finish(resHttp) {\n\tvp_util.Write_ISP_Log(\"[Err_Finish end error]\", \"\");\n\tif (undefined != resHttp.status) vp_util.Write_ISP_Log(\"[Err_Finish res status ]\", resHttp.status);\n\tif (undefined != resHttp.readyState) vp_util.Write_ISP_Log(\"[Err_Finish res readyState ]\", resHttp.readyState);\n\tm_queryinstall_count = 0;\n\tif (this.wispPopWinObj != null && !this.wispPopWinObj.closed) wispPopWinObj.close();\n\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\thideDivPop();\n\tCancelVPPayment('99');\n}\n\n/**\n * 1~100 사이 정수 랜덤 추출하여 update flag 설정\n */\nfunction UpdateService() {\n\tif (Math.floor((Math.random() * (100 - 1 + 1)) + 1) <= m_update_percent) m_update_flag = true;\n}\n\nfunction CheckAllowPercent(_percent) {\n\tif (Math.floor((Math.random() * (100 - 1 + 1)) + 1) <= _percent) return true;\n\treturn false;\n}\n\n/**\n * error process\n * @param {*} resHttp \n */\nfunction ErrProc(resHttp) {\n\tif (m_eispprocess == \"CheckVersion\" || m_eispprocess == \"MakeSession\" || m_eispprocess == \"SetData\") {\n\t\tvp_util.Write_ISP_Log(\"[Error resHttp] Err eispProcess :\", m_eispprocess);\n\t\tm_isFailedPostEISP = true;\n\t\tif (resHttp != null) vp_util.Write_ISP_Log(\"[Error resHttp] Error resHttp :\", resHttp);\n\t\tif (resHttp != null && resHttp.status != undefined) vp_util.Write_ISP_Log(\"[Error resHttp] Error resHttp.status :\", resHttp.status);\n\t\tif (m_eispprocess != \"CheckVersion\") restartPayment(m_eispprocess);\n\t} else {\n\t\tif (resHttp.status != undefined && resHttp != null) vp_util.Write_ISP_Log(\"[\" + m_eispprocess + \"] Error\", resHttp.status);\n\t\thideDivPop();\n\t\talert('서비스가 정상적으로 실행되지 않았습니다.\\n다시 시도해 주시기 바랍니다.');\n\t\treturn;\n\t}\n}\n\n/**\n * 플러그인 버전 체크\n * @returns Ret_CheckVersion\n */\nfunction CheckVersion() {\n\tvp_util.Write_ISP_Log(\"[CheckVersion]\", \"\");\n\tm_eispprocess = \"CheckVersion\";\n\tif (m_queryinstall_count == 3) return restartPayment('CheckVersion');\n\telse if (m_queryinstall_count == 200) clearInterval(m_checkinstall_timer);\n\telse {\n\t\tif (isWellConn && (m_isFailedPostEISP == false)) { // send pay form 정상 진행 & 에러 발생 없음\n\t\t\tvp_util.Write_ISP_Log(\"[CheckVersion_POST]\", \"m_queryinstall_count [\" + m_queryinstall_count + \"]\");\n\t\t\tvar str = '{\"command\":\"checkversion\"}';\n\t\t\tif (m_eispprocess == \"CheckVersion\") sendProc('CheckVersion', null, str, Ret_CheckVersion_POST, ErrProc);\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[CheckVersion]\", m_queryinstall_count);\n\t\t\tvar param = 'command=checkversion';\n\t\t\tCallFunction(param, Ret_CheckVersion);\n\t\t\tm_queryinstall_count++;\n\t\t}\n\t}\n}\n\n/**\n * 플러그인 버전체크 후 작업\n * @param {*} e \n */\nfunction Ret_CheckVersion(e) {\n\tvp_util.Write_ISP_Log(\"[Ret_CheckVersion]\", e.data);\n\tRemoveEvent();\n\tif (!m_eispprocess.match('Ret_CheckVersion')) {\n\t\tvar data = eval('(' + e.data + ')');\n\t\tif (data.resultcode && data.resultcode == '00') {\n\t\t\tif ((data.version < m_min_s_version) || (data.version < m_current_s_version && m_update_flag == true)) {\n\t\t\t\tvp_util.Write_ISP_Log(\"[InstallPageCall]\", \"Version Update Required\");\n\t\t\t\trestartPayment('VersionUpdate');\n\t\t\t\tm_ret_function = \"\";\n\t\t\t\treturn;\n\t\t\t}\n\t\t\telse {\n\t\t\t\tclearInterval(m_checkinstall_timer);\n\t\t\t\tm_eispprocess += 'Ret_CheckVersion,';\n\t\t\t\tif (m_eISPErrorStep != 'MakeSession' || m_eISPErrorStep != 'SetData') {\n\t\t\t\t\tvp_ispplus_install.CloseLoadingUI();\n\t\t\t\t\tvp_ispplus_install.OpenLoadingUI();\n\t\t\t\t}\n\t\t\t\tMakeSession();\n\t\t\t}\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_CheckVersion]\", data.msg);\n\t\t\tm_ret_function = \"\";\n\t\t}\n\t}\n}\n\n/**\n * Make Session\n */\nfunction MakeSession() {\n\tvp_util.Write_ISP_Log(\"[MakeSession]\", \"\");\n\tvar param = 'command=makesession&type=sync&target=VPWalletLauncherC&path=VP%5CVPWalletService';\n\tCallFunction(param, Ret_MakeSession);\n}\n\n/**\n * Make Session 후작업\n * @param {*} e \n */\nfunction Ret_MakeSession(e) {\n\tvp_util.Write_ISP_Log(\"[Ret_MakeSession]\", e.data);\n\tvar data = eval('(' + e.data + ')');\n\tif (data.resultcode && data.resultcode == '00') {\n\t\tm_sessionid = data.sessionid;\n\t\tm_eispprocess += 'Ret_MakeSession,';\n\t\tif (data.sessionid != null) {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_MakeSession_sessionid]\", data.sessionid);\n\t\t\tRemoveEvent();\n\t\t\tif (m_eISPErrorStep == 'MakeSession') {\n\t\t\t\tm_eISPErrorStep = '';\n\t\t\t\tvp_ispplus_install.CloseLoadingUI();\n\t\t\t\tvp_ispplus_install.OpenLoadingUI();\n\t\t\t}\n\t\t\tSetData1();\n\t\t}\n\t} else {\n\t\tRemoveEvent();\n\t\tm_eispprocess = \"\";\n\t\tvp_util.Write_ISP_Log(\"[Ret_MakeSession]\", data.msg);\n\t\trestartPayment('MakeSession');\n\t}\n}\n\n/**\n * plugin data set 1\n */\nfunction SetData1() {\n\tvp_util.Write_ISP_Log(\"[SetData1]\", \"\");\n\tvar KVP_NOINT_FLAG = CheckFormField(vpPayform, \"KVP_NOINT_FLAG\") ? vpPayform.KVP_NOINT_FLAG.value : '';\n\tvar KVP_GOODNAME = vp_util.getConvertedGoodName();\n\tvar param = 'command=setdata&session=' + m_sessionid + '&fname=setfield';\n\tparam += '&datas[0][filedname]=PGID&datas[0][value]=' + vpPayform.KVP_PGID.value;\n\tparam += '&datas[1][filedname]=CardCode&datas[1][value]=' + vpCardCode;\n\tparam += '&datas[2][filedname]=NoInterestFlag&datas[2][value]=' + KVP_NOINT_FLAG;\n\tparam += '&datas[3][filedname]=Price&datas[3][value]=' + vpPayform.KVP_PRICE.value;\n\tparam += '&datas[4][filedname]=GoodName&datas[4][value]=' + KVP_GOODNAME;\n\tCallFunction(param, Ret_SetData1);\n}\n\n/**\n * plugin data set 1 후작업\n * @param {*} e \n */\nfunction Ret_SetData1(e) {\n\tvp_util.Write_ISP_Log(\"[Ret_SetData1]\", e.data);\n\tRemoveEvent();\n\tif (!m_eispprocess.match('Ret_SetData1')) {\n\t\tvar data = eval('(' + e.data + ')');\n\t\tif (data.resultcode && data.resultcode == '00') {\n\t\t\tm_eispprocess += 'Ret_SetData1,';\n\t\t\tSetData2();\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_SetData1]\", data.msg);\n\t\t\trestartPayment('SetData1');\n\t\t}\n\t}\n}\n\n/**\n * plugin data set 2\n */\nfunction SetData2() {\n\tvp_util.Write_ISP_Log(\"[SetData2]\", \"\");\n\tvar KVP_NOINT_INF = CheckFormField(vpPayform, \"KVP_NOINT_INF\") ? vpPayform.KVP_NOINT_INF.value : '';\n\tvar KVP_QUOTA_INF = CheckFormField(vpPayform, \"KVP_QUOTA_INF\") ? vpPayform.KVP_QUOTA_INF.value : '';\n\tvar KVP_OACERT_INF = CheckFormField(vpPayform, \"KVP_OACERT_INF\") ? vpPayform.KVP_OACERT_INF.value : 'NONE';\n\tvar param = 'command=setdata&session=' + m_sessionid + '&fname=setfield';\n\tparam += '&datas[0][filedname]=Currency&datas[0][value]=' + vpPayform.KVP_CURRENCY.value;\n\tparam += '&datas[1][filedname]=NoInterestInf&datas[1][value]=' + KVP_NOINT_INF;\n\tparam += '&datas[2][filedname]=QuotaInf&datas[2][value]=' + KVP_QUOTA_INF;\n\tparam += '&datas[3][filedname]=VP_BCIssuerCode&datas[3][value]=' + vpIssuerCode;\n\tparam += '&datas[4][filedname]=isWellConn&datas[4][value]=' + ((isWellConn) ? 'TRUE' : 'FALSE');\n\tCallFunction(param, Ret_SetData2);\n}\n\n/**\n * plugin data set 2 후작업\n * @param {*} e \n */\nfunction Ret_SetData2(e) {\n\tvp_util.Write_ISP_Log(\"[Ret_SetData2]\", e.data);\n\tRemoveEvent();\n\tif (!m_eispprocess.match('Ret_SetData2')) {\n\t\tvar data = eval('(' + e.data + ')');\n\t\tif (data.resultcode && data.resultcode == '00') {\n\t\t\tm_eispprocess += 'Ret_SetData2,';\n\t\t\tSetData3();\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_SetData2]\", data.msg);\n\t\t\trestartPayment('SetData2');\n\t\t}\n\t}\n}\n\n/**\n * plugin data set 3\n */\nfunction SetData3() {\n\tvp_util.Write_ISP_Log(\"[SetData3]\", \"\");\n\tvar KVP_BC_OACERT_INF = CheckFormField(vpPayform, \"KVP_BC_OACERT_INF\") ? vpPayform.KVP_BC_OACERT_INF.value : \"\";\n\tvar KVP_SH_OACERT_INF = CheckFormField(vpPayform, \"KVP_SH_OACERT_INF\") ? vpPayform.KVP_SH_OACERT_INF.value : \"NONE\";\n\tvar KVP_JB_OACERT_INF = CheckFormField(vpPayform, \"KVP_JB_OACERT_INF\") ? vpPayform.KVP_JB_OACERT_INF.value : \"NON