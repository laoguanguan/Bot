            "text": "/**\n* @incoding UTF-8\n* @file Wallet_layer_VP.js\n* @version 0.0.1\n* @author FDL @ jyheo\n* @date 2024-01-09\n* @description VP_PAYMENT_SERVICE_POST (Updated 20221226_0)\n*/\n\n/**\n * make querySelector function for IE7 \n */\n(function(document) {\n\t'use strict';\n\tif (!document.querySelectorAll) {\n\t\tdocument.querySelectorAll = function(selectors) {\n\t\t\tvar style = document.createElement('style'),\n\t\t\t\telements = [],\n\t\t\t\telement;\n\t\t\tdocument.documentElement.firstChild.appendChild(style);\n\t\t\tdocument._qsa = [];\n\n\t\t\tstyle.styleSheet.cssText = selectors + '{x-qsa:expression(document._qsa && document._qsa.push(this))}';\n\t\t\twindow.scrollBy(0, 0);\n\t\t\tstyle.parentNode.removeChild(style);\n\n\t\t\twhile (document._qsa.length) {\n\t\t\t\telement = document._qsa.shift();\n\t\t\t\telement.style.removeAttribute('x-qsa');\n\t\t\t\telements.push(element);\n\t\t\t}\n\t\t\tdocument._qsa = null;\n\t\t\treturn elements;\n\t\t};\n\t}\n\tif (!document.querySelector) {\n\t\tdocument.querySelector = function(selectors) {\n\t\t\tvar elements = document.querySelectorAll(selectors);\n\t\t\treturn (elements.length) ? elements[0] : null;\n\t\t};\n\t}\n})(document);\n\n/**\n * set www domain\n */\nvar vpDomain = document.querySelector('script[src^=\"https://www-test.vpay.co.kr\"]') == null ? \"https://www.vpay.co.kr\" : \"https://www-test.vpay.co.kr\";\nvar vpImgDomain = document.querySelector('script[src^=\"https://www-test.vpay.co.kr\"]') == null ? \"http://www.vpay.co.kr\" : \"http://www-test.vpay.co.kr\";\n\n/**\n * init server domain\n */\nvar config = {\n\tui_domain : \"https://ui.vpay.co.kr\"\n\t, api_domain : \"https://api.vpay.co.kr\"\n}\n\n/**\n * init x-login-token\n */\nvar x_login_token = \"eyJ0eXAiOiJKV1RfREVWSSIsImFsZyI6IkhTMjU2In0.eyJzdWIiOiJYLWxvZ2luLXRva2VuIiwiZGV2aUlubyI6IlBMVUdJTi1QUkQtVE9LRU4iLCJzdmNNZW1OTyI6IiIsImVuY0hwbm8iOiIiLCJhZW50VmVyIjoiMTAiLCJvc1RwQ2QiOiIiLCJsZ25HYm4iOiIxIn0.j6MDMi9xARa-Yee4UNnvTjqp9D6ZxPBU98fTktDsZ-A\";\nvar m_current_c_version = 2112;\t//2023.05.25 배포기준 버전\nvar m_current_s_version = 2112;\nvar m_min_c_version = 2107;\nvar m_min_s_version = 2107;\nvar m_update_percent = 100;\t\t// 2023.07.19 비율 70% -> 100%로 변경\n\n/**\n * init commont function\n */\nvar pcUtils = {\n\t/**\n\t * 서버에서 도메인 정보를 가져온다.\n\t * @param {*} dmin \n\t */\n\tgetDminNm : function(dmin) {\n\t\tvar script = document.createElement('script');\n\t\tscript.src = dmin + \"/pc-lkg-scpt/get-dmin-nm\"+\"?callback=clbkDminNm\";\n\t\tdocument.body.appendChild(script);\n\t}\n\t/**\n\t * 서버에서 동적데이터를 가져온다.\n\t * @param {*} dmin \n\t */\n\t, getDataVal : function(dmin) {\n\t\tvar script = document.createElement('script');\n\t\tscript.src = dmin + \"/pa-api/web/pc-lkg-scpt/get-data-info\"+\"?callback=clbkDataVal\";\n\t\tdocument.body.appendChild(script);\n\t}\n};\n\n/**\n * callback - servlet xml에 설정되어있는 api, ui 의 도메인을 가져온다.\n * @param {*} data \n */\nfunction clbkDminNm(data) {\n\tif(data !== null && data !== undefined) {\n\t\tconfig = {\n\t\t\tui_domain : data.ui_domain\n\t\t\t, api_domain : data.api_domain\n\t\t}\n\t\tpcUtils.getDataVal(config.api_domain);\n\t}\n};\n/**\n * callback - 공통코드에 설정되어있는 데이터를 가져온다.\n * @param {*} data \n */\nfunction clbkDataVal(data) {\n\tif(data !== null && data !== undefined) {\n\t\tm_current_s_version = data.CUR_SVC_VER;\n\t\tm_min_c_version = data.MIN_LCHRC_VER;\n\t\tm_update_percent = data.ADVT_PGM_RATE;\n\t\tm_current_c_version = data.CUR_LCHRC_VER;\n\t\tm_min_s_version = data.MIN_SVC_VER;\n\t\tx_login_token = data.X_LOGIN_TOKEN\n\t}\n};\n\n/**\n * document ready\n */\ndocument.addEventListener\n\t? document.addEventListener(\"DOMContentLoaded\",function(){\n\t\tpcUtils.getDminNm(vpDomain);\n\t})\n\t: document.attachEvent('onreadystatechange', function(){\n\t\tif(document.readyState === 'complete') {\n\t\t\tpcUtils.getDminNm(vpDomain);\n\t\t}\n\t});\n\n/**\n * device Info - 브라우져정보\n */\nvar m_BrowserInfo = '';\n/**\n * device Info - OS 정보\n */\nvar m_OSInfo = '';\n/**\n * device Info - IE Version\n */\nvar m_IEVersion = '';\n\n//Flags\nvar m_payMethod = 'wisp';\nvar m_debug = false;\nvar m_AX_mode = false;\nvar m_isChangedCardCode = false;\nvar m_isPayMthdSelected = false;\nvar m_isPayMthdPopped = 'FALSE';\nvar js_name = 'LAYERJS';\nvar isWellConn = true;\nvar m_isPopupBlocked = false;\nvar m_ret_function;\nvar m_checkinstall_timer;\nvar m_queryinstall_count = 0;\nvar m_checkinstall_interval = 2000;\nvar m_sessionid = \"\";\n\nvar m_eispprocess = \"\";\nvar m_instprocess = false;\n// var m_current_c_version = 2112;\t//2023.09.06 배포기준 버전\n// var m_current_s_version = 2112;\n// var m_min_c_version = 2107;\n// var m_min_s_version = 2107;\n// var m_update_percent = 100;\t\t// 2023.07.19 비율 70% -> 100%로 변경\nvar m_update_flag = false;\nvar m_protocol = \"https://\";\nvar m_address = \"127.0.0.1\";\nvar m_port = \"55501\";\nvar m_http_ver = 0;\t// 0:XHR 1:XDR 2:MS XML\nvar m_eISPErrorStep = '';\nvar m_isFailedPostEISP = false;\nvar wispPopWinObj;\nvar wispPopWinStep = \"\";\n\n//pgInfo\nvar vpCardCode = '';\nvar vpIssuerCode = '';\nvar retCurrTID = '';\nvar CURRENT_URL = \"\";\nvar vpPayform;\n\n/**\n * 초기화 및 결제정보 전송 (send-pay-form)\n * @param {*} _vpPayform \n * @returns CancelVPPayment\n */\nfunction MakePayMessage(_vpPayform) {\n\tinitVPVariables();\n\tm_OSInfo = vp_util.getOSInfo();\n\tm_BrowserInfo = vp_util.browser_check(m_OSInfo);\n\tm_IEVersion = browserCheck.getIeBrowserVer();\n\tCURRENT_URL = vp_util.getCurrentURL();\n\tvpPayform = _vpPayform;\n\tif (!vp_util.checkEssentialForm()) {\n\t\talert(\"결제 필수정보가 전송되지 않았습니다.\\n취소 후 결제를 다시 진행하여 주시기 바랍니다.\");\n\t\treturn CancelVPPayment('10');\n\t}\n\n\tshowDivPop();\n\tvp_util.getVPCardAndIssuerCode();\n\ttry {\n\t\tisWellConn = true;\n\t\tvp_util.Write_ISP_Log(\"[sendPayForm]\", \"start\");\n\t\tvar payformUrl = config.api_domain + \"/pb-api/payment/send-pay-form\";\n\t\tsendProc('sendPayForm', payformUrl, makeSendPayFormData(), Ret_sendPay, Err_sendPay);\n\t} catch (e) {\n\t\tvp_util.Write_ISP_Log(\"[sendPayForm error]\", e.toString());\n\t\tisWellConn = false;\n\t\treturn eispMakePayMessage();\t\n\t}\n} // end MakePayMessage\n\n/**\n * wisp process\n * @returns eispMakePayMessage\n */\nfunction wispMakePayMessage() {\n\tm_isPayMthdSelected = true;\n\tif (wispPopWinObj == null && m_OSInfo.indexOf(\"Windows\") != -1 \n\t&& !vp_util.IsPayboocOnlyPay(vpCardCode, vpIssuerCode) && !vp_util.checkQRTarget(vpCardCode, vpIssuerCode, vpPayform)) {\n\t\tif (vp_util.VPPopupAllowAlert(m_BrowserInfo, CURRENT_URL, m_OSInfo)) {\n\t\t\tm_isPopupBlocked = true;\n\t\t\treturn eispMakePayMessage();\n\t\t} else {\n\t\t\thideDivPop();\n\t\t\treturn CancelVPPayment('02');\n\t\t}\n\t} else if (vp_util.IsPayboocOnlyPay(vpCardCode, vpIssuerCode) && m_OSInfo.indexOf(\"Windows\") == -1) {\n\t\talert(\"죄송합니다. 이 결제 건은 해당 결제 방식을 지원하지 않습니다.\");\n\t\thideDivPop();\n\t\treturn CancelVPPayment('14');\n\t} else if (typeof wispPopWinObj == \"undefined\") {\n\t\twispPopWinObj = window.open('about:blank', 'vpWispWin', vp_util.getPopupWindowOption());\n\t\tif (wispPopWinObj == null) {\n\t\t\tvp_util.VPPopupAllowAlert(m_BrowserInfo, CURRENT_URL, m_OSInfo);\n\t\t\thideDivPop();\n\t\t\treturn CancelVPPayment('02');\n\t\t}\n\t}\n\n\t// 사용자 브라우저종류 및 버전\n\tvar brow = browserCheck.getBrowserName() + m_IEVersion;\t//브라우저종류\n\tvar vpFomObj = kvpCreateForm(\"fomVpPayData\", \"post\", config.ui_domain + \"/web/mainView\", \"vpWispWin\");\n\tvpFomObj = kvpAddHidden(vpFomObj, 'browser', brow, false);\t//사용자 브라우저종류및버전\n\tvpFomObj = kvpAddHidden(vpFomObj, 'mallDomain', document.domain, false);\n\tvpFomObj = kvpAddHidden(vpFomObj, 'wispPayMethod', m_payMethod, false);\n\tvpFomObj = kvpAddHidden(vpFomObj, 'osInfo', m_OSInfo, false);\n\tvpFomObj = kvpAddHidden(vpFomObj, 'tid', retCurrTID, false);\n\tvpFomObj = kvpAddHidden(vpFomObj, 'CardCode', vpCardCode, false);\n\tvpFomObj = kvpAddHidden(vpFomObj, 'VP_BC_IssuerCode', vpIssuerCode, false);\n\tif (CheckFormField(vpPayform, 'KVP_GOODNAME')) vpFomObj = kvpAddHidden(vpFomObj, 'GoodName', vp_util.getConvertedGoodName(), false);\n\tif (CheckFormField(vpPayform, 'KVP_PRICE')) vpFomObj = kvpAddHidden(vpFomObj, 'Price', vpPayform.KVP_PRICE.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_CURRENCY')) vpFomObj = kvpAddHidden(vpFomObj, 'Currency', vpPayform.KVP_CURRENCY.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_NOINT_INF')) vpFomObj = kvpAddHidden(vpFomObj, 'NoInterestInf', vpPayform.KVP_NOINT_INF.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_QUOTA_INF')) vpFomObj = kvpAddHidden(vpFomObj, 'QuotaInf', vpPayform.KVP_QUOTA_INF.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_PGID')) vpFomObj = kvpAddHidden(vpFomObj, 'PGID', vpPayform.KVP_PGID.value, false);\n\tif (CheckFormField(vpPayform, 'VP_MERCHANT_ID')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_MerchantID', vpPayform.VP_MERCHANT_ID.value, false);\n\tif (CheckFormField(vpPayform, 'VP_REQ_AUTH')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_ReqAuth', vpPayform.VP_REQ_AUTH.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_BC_OACERT_INF')) vpFomObj = kvpAddHidden(vpFomObj, 'BC_PubCertPriv', vpPayform.KVP_BC_OACERT_INF.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_JB_OACERT_INF')) vpFomObj = kvpAddHidden(vpFomObj, 'KJ_PubCertPriv', vpPayform.KVP_JB_OACERT_INF.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_KJ_OACERT_INF')) vpFomObj = kvpAddHidden(vpFomObj, 'JB_PubCertPriv', vpPayform.KVP_KJ_OACERT_INF.value, false);\n\tif (CheckFormField(vpPayform, 'KVP_SH_OACERT_INF')) vpFomObj = kvpAddHidden(vpFomObj, 'SH_PubCertPriv', vpPayform.KVP_SH_OACERT_INF.value, false);\n\t//선할인\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_CON')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_CON', vpPayform.VP_PREDIS_CON.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_TID')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_TID', vpPayform.VP_PREDIS_TID.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MCODE')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_MCODE', vpPayform.VP_PREDIS_MCODE.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_SORT')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_SORT', vpPayform.VP_PREDIS_SORT.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_CODE')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_CODE', vpPayform.VP_PREDIS_CODE.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_MID')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_MID', vpPayform.VP_PREDIS_MID.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_AMOUNT')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_AMOUNT', vpPayform.VP_PREDIS_AMOUNT.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_TCOUNT')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_TCOUNT', vpPayform.VP_PREDIS_TCOUNT.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_SHOWID')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_SHOWID', vpPayform.VP_PREDIS_SHOWID.value, false);\n\tif (CheckFormField(vpPayform, 'VP_PREDIS_REAL_MID')) vpFomObj = kvpAddHidden(vpFomObj, 'VP_PREDIS_REAL_MID', vpPayform.VP_PREDIS_REAL_MID.value, false);\n\n\tvpFomObj = kvpAddHidden(vpFomObj, 'domain', document.domain, false);\n\twispPopWinStep = \"webPay\";\n\tvpFomObj.submit();\n\tsetTimeout(function () { wispPopWinObj.focus(); }, 600);\n\tChkWispPopWinClosed();\n} // end wispMakeMessage\n\n/**\n * ISP Process\n * @returns CancelVPPayment\n */\nfunction eispMakePayMessage() {\n\tif (m_OSInfo.indexOf(\"Windows\") == -1) {\n\t\talert(\"죄송합니다. 현재 Windows OS 외에서는 해당 결제방식을 지원하지 않습니다. 다른 결제 방식을 사용해주시기 바랍니다.\");\n\t\thideDivPop();\n\t\treturn CancelVPPayment('11');\n\t} else if (vp_util.isDisabledOS()) {\n\t\talert(\"죄송합니다. 해당 버전의 OS에서는 해당 결제방식을 지원하지 않을 수 있습니다. 진행이 불가능할 경우, 다른 결제 방식을 사용해주시기 바랍니다. (Windows 7 이상 사용가능)\");\n\t} else if (vp_util.IsPayboocOnlyPay(vpCardCode, vpIssuerCode)) {\n\t\talert(\"죄송합니다. 이 결제 건은 해당 결제 방식을 지원하지 않습니다.\");\n\t\thideDivPop();\n\t\treturn CancelVPPayment('14');\n\t}\n\n\tm_isPayMthdSelected = true;\n\tm_payMethod = 'eisp';\n\tm_eISPErrorStep = '';\n\tUpdateService(); // set update flag\n\tvp_util.SupportFromChrome141();\n\n\tif (m_AX_mode == true && m_BrowserInfo == \"wie\") {\n\t\thideDivPop();\n\t\tif (document.KvpDwn.KvpSmartUpdate(vpImgDomain + \"/\") != \"true\") {\n\t\t\talert(\"KvpSmartUpdate: 지불에 실패 하였습니다.\");\n\t\t\tdocument.KvpDwn.KVPEnd(\"\");\n\t\t\treturn CancelVPPayment('12');\n\t\t}\n\t\t// 지불 플러그인 기본값 셋팅\n\t\tif (vp_ActiveX_ISP.SetField(vpPayform) == false) {\n\t\t\tdocument.KvpDwn.KVPEnd(\"\");\n\t\t\talert(\"지불에 실패하였습니다. 처음부터 다시 시작하시기 바랍니다.(Error : SetField function)\");\n\t\t\treturn CancelVPPayment('12');\n\n\t\t}\n\t\tif (document.KvpDwn.KvpPayMessesge(\"\") != \"true\") {\n\t\t\tdocument.KvpDwn.KVPEnd(\"\");\n\t\t\treturn CancelVPPayment('01');\n\t\t}\n\t\tvp_ActiveX_ISP.GetField();\n\t\tdocument.KvpDwn.KVPEnd(\"\");\n\t\treplKvpCardCd(); VP_Ret_Pay(true);\n\t\treturn;\n\t}\n\tif (m_BrowserInfo == \"wsf\") {\n\t\tm_protocol = \"http://\";\n\t\tm_port = \"55512\";\n\t}\n\tvp_util.Write_ISP_Log(\"[eispMakePayMessage]\", \"eISP start\");\n\tm_instprocess = false;\n\tshowDivPop();\n\tCheckVersion();\n\tm_checkinstall_timer = setInterval(function () { CheckVersion(); }, m_checkinstall_interval);\n}\n\n/**\n * kvpcardcode 내 발행사코드를 치환(29 to 61)처리 한다. \n */\nfunction replKvpCardCd() {\n\tif (CheckFormField(vpPayform, 'KVP_CARDCODE')) {\n\t\tif(vpPayform.KVP_CARDCODE.value.length < 15) {\n\t\t\treplKvpCardCdAlert(\"check length is fail\");\n\t\t\tvp_util.Write_ISP_Log(\"[replKvpCardCd]\", \"check length is fail\");\n\t\t\treturn;\n\t\t}\n\t\tif(vpPayform.KVP_CARDCODE.value.substring(2,6) !== \"0100\") {\n\t\t\treplKvpCardCdAlert(\"it's not BC CARD\");\n\t\t\tvp_util.Write_ISP_Log(\"[replKvpCardCd] \", \"it's not BC CARD\");\n\t\t\treturn;\n\t\t}\n\t\tif(vpPayform.KVP_CARDCODE.value.substring(6,8) !== \"29\") {\n\t\t\treplKvpCardCdAlert(\"it's not NAVER CARD\");\n\t\t\tvp_util.Write_ISP_Log(\"[replKvpCardCd] \", \"it's not NAVER CARD\");\n\t\t\treturn;\n\t\t}\t\n\t\tvar modKvpCardCd = vpPayform.KVP_CARDCODE.value.substring(0, 6) + \"61\" + vpPayform.KVP_CARDCODE.value.substring(8);\n\t\treplKvpCardCdAlert(\"success replace [\"+vpPayform.KVP_CARDCODE.value+\"] to [\"+modKvpCardCd+\"]\");\n\t\tvp_util.Write_ISP_Log(\"[replKvpCardCd] \", \"success replace [\"+vpPayform.KVP_CARDCODE.value+\"] to [\"+modKvpCardCd+\"]\");\n\t\tvpPayform.KVP_CARDCODE.value = modKvpCardCd;\n\t}\n}\n\nfunction replKvpCardCdAlert(str) {\n\tvar isOnAlert = false;\n\tif(isOnAlert) {\n\t\talert(str);\n\t}\n}\n\n/**\n * wQRMakePayMessage\n */\nfunction wQRMakePayMessage() {\n\tm_payMethod = 'qr';\n\tvp_util.Write_ISP_Log(\"[wQR TID] \", \"web QR pay\");\n\twispMakePayMessage();\n}\n\nfunction GetCurent_url() {\n\treturn m_protocol + m_address + \":\" + m_port + \"/?\";\n}\n\nfunction GetCurent_url_POST() {\n\treturn m_protocol + m_address + \":\" + m_port;\n}\n\n/**\n * CallFunction\n * @param {*} _param \n * @param {*} CallBackFunction \n */\nfunction CallFunction(_param, CallBackFunction) {\n\tvar ret_function = null;\n\tvar url = GetCurent_url();\n\tif (m_BrowserInfo == \"wsf\" || (m_OSInfo == \"Windows XP\" && (vp_util.getInternetExplorerVersion() > 0 && vp_util.getInternetExplorerVersion() < 8.0))) {\n\t\tvar func_name = CallBackFunction.toString().match(/^function\\s*([^\\s(]+)/)[1];\n\t\turl = GetCurent_url() + \"callback=\" + func_name + \"&\" + _param + \"&rand=\" + Math.floor((Math.random() * (1000 - 0 + 1)) + 0).toString();\n\t} else {\n\t\turl = url + _param + \"&rand=\" + Math.floor((Math.random() * (1000 - 0 + 1)) + 0).toString();\n\t}\n\tret_function = CallBackFunction;\n\tCallCreateFunction(url, ret_function);\n}\n\n/**\n * CallCreateFunction\n * @param {*} url \n * @param {*} ret_function \n */\nfunction CallCreateFunction(url, ret_function) {\n\tvar isp_com_form = null;\n\tvar ispDiv = document.createElement('div');\n\tispDiv.setAttribute(\"id\", \"isp_div\");\n\tdocument.body.appendChild(ispDiv);\n\t//for XP IE6,7\n\tif (m_BrowserInfo == \"wsf\" || (m_OSInfo == \"Windows XP\" && (vp_util.getInternetExplorerVersion() > 0 && vp_util.getInternetExplorerVersion() < 8.0))) {\n\t\tisp_com_form = document.createElement('script');\n\t\tisp_com_form.id = \"ispdata\";\n\t\tisp_com_form.src = url;\n\t} else {\n\t\tisp_com_form = document.createElement('iframe');\n\t\tisp_com_form.width = \"0px\";\n\t\tisp_com_form.frameborder = \"no\";\n\t\tisp_com_form.border = \"0px\";\n\t\tisp_com_form.height = \"0px\";\n\t\tisp_com_form.id = \"ispdata\";\n\t\tisp_com_form.src = url;\n\t\tif (m_ret_function != ret_function) {\n\t\t\tvp_util.Write_ISP_Log(\"[ADD_Event]\", ret_function.name);\n\t\t\tm_ret_function = ret_function;\n\t\t\tvp_util.Write_ISP_Log(\"[CallCreateFunction]\", ret_function.name);\n\t\t\tif (window.attachEvent)\n\t\t\t\twindow.attachEvent(\"onmessage\", ret_function);\n\t\t\telse\n\t\t\t\twindow.addEventListener(\"message\", ret_function, false);\n\t\t}\n\t}\n\tdocument.getElementById(\"isp_div\").appendChild(isp_com_form);\n}\n\n/**\n * getVPCardCode\n */\nfunction getVPCardCode() {\n\tvar cardSelectDiv = '';\n\tcardSelectDiv += \"<!DOCTYPE html>\";\n\tcardSelectDiv += \"<html lang=\\\"ko\\\">\";\n\tcardSelectDiv += \"<head>\";\n\tcardSelectDiv += \"<meta charset=\\\"UTF-8\\\">\";\n\tcardSelectDiv += \"<meta http-equiv=\\\"X-UA-Compatible\\\" content=\\\"IE=edge, chrome=1\\\">\";\n\tcardSelectDiv += \"<title>ISP/페이북</title>\";\n\tcardSelectDiv += \"</head>\";\n\tcardSelectDiv += \"<body style=\\\"padding: 0; margin: 0\\\">\";\n\tcardSelectDiv += \"<div class=\\\"pages page-layout-normal\\\" style=\\\"overflow: hidden; width: 650px; height: 630px; background-color: #fff; position: fixed; left: 50%; top: 50%; margin-left: -325px; margin-top: -315px;\\\">\";\n\tcardSelectDiv += \"<div class=\\\"title-view\\\" style=\\\"position: relative; margin: 30px 30px 0 30px; height: 43px; border-bottom: 1px solid #f0f0f0;\\\">\";\n\tcardSelectDiv += \"<button type=\\\"button\\\" class=\\\"btn-close\\\" style=\\\"appearance: none; cursor: pointer; border: 0px; background-color: transparent; position: absolute; top: 0px; right: 0px; z-index: 1; text-indent: -9999px; background-image: url(\"+ vpDomain +\"/eISP/images/selectcard/btn_close02.png); width: 19px; height: 19px\\\" onClick=\\\"window.close();\\\">닫기</button>\";\n\tcardSelectDiv += \"<p class=\\\"page-title\\\" style=\\\"display: block; position: position: absolute; top: 30px; left: 30px; z-index: 800; height: 30px; position: static; padding: 0; margin: 0;\\\">\";\n\tcardSelectDiv += \"<span class=\\\"logo\\\" style=\\\"display: inline-block; *display: inline; *zoom: 1; vertical-align: middle; text-align: left; text-indent: -9999px; *text-indent: 0; *font-size: 0; *line-height: 999px; *overflow: hidden; background-image: url(\"+ vpDomain +\"/eISP/images/selectcard/logo01.png); width: 33px; height: 28px\\\">PAY BOOC</span>\";\n\tcardSelectDiv += \"<span class=\\\"title\\\" style=\\\"display: inline-block; margin: 0 0 -4px 8px; font-size: 20px; font-weight: 700; color: #202020;vertical-align: middle;\\\"><img src=\\\"\"+ vpDomain +\"/eISP/images/selectcard/title_select_card.png\\\" alt=\\\"카드사 선택\\\"></span>\";\n\tcardSelectDiv += \"</p>\";\n\tcardSelectDiv += \"</div>\";\n\tcardSelectDiv += \"<div class=\\\"content-view select-card\\\" style=\\\"display: block; position: relative; padding: 0px 40px 66px 40px; height: 449px;\\\">\";\n\tcardSelectDiv += \"<p class=\\\"select-card-message\\\" style=\\\"margin: 0; padding: 20px; font-size: 12px; color: #999; line-height: 15px; text-align: center;\\\">결제하실 카드를 선택해주세요.<br>\";\n\tcardSelectDiv += \"고객님 카드에 <span class=\\\"icon-bcard\\\" style=\\\" display: inline-block; text-indent: -9999px; background-image: url(\"+ vpDomain +\"/eISP/images/selectcard/logo_bccard.png); width: 60px; height: 15px\\\">비씨카드</span> 로고가 있으면 비씨카드를 선택해주세요.</p>\";\n\tcardSelectDiv += \"<div class=\\\"card-list-wrap\\\" style=\\\"width: 600px; height: 100%; padding: 0; margin: 0\\\">\";\n\tcardSelectDiv += \"<ul class=\\\"card-list\\\" style=\\\"padding: 0; margin: 0;\\\">\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0100\\',\\'\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_00.png\\\" alt=\\\"비씨카드\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_00_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_00.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0204\\',\\'KBC\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_06.png\\\" alt=\\\"국민카드\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_06_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_06.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0100\\',\\'WR\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_20.png\\\" alt=\\\"우리카드\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_20_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_20.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'1500\\',\\'\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_34.png\\\" alt=\\\"광주은행\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_34_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_34.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'1800\\',\\'\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_07.png\\\" alt=\\\"수협은행\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_07_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_07.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0204\\',\\'KJB\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_37.png\\\" alt=\\\"전북은행\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_37_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_37.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0100\\',\\'PT\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_71.png\\\" alt=\\\"우체국예금\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_71_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_71.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0100\\',\\'SM\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_45.png\\\" alt=\\\"MG새마을금고\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_45_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_45.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0100\\',\\'BK\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_95.png\\\" alt=\\\"상호저축은행\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_95_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_95.png'\\\" style=\\\"border: none\\\"></a></li>\";\n\tcardSelectDiv += \"<li class=\\\"item\\\" style=\\\"list-style: none; width: 76px; height: 60px; float: left; text-align: center; margin-right: 5px; margin-bottom: 5px;\\\"><a href=\\\"javascript:void(0);\\\" onClick=\\\"opener.setVPCardCode(\\'0100\\',\\'KDB\\');\\\"><img src=\\\"\"+ config.ui_domain + \"/assets/images/gate/btn_card_02.png\\\" alt=\\\"한국산업은행\\\" onmouseover=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_02_hover.png'\\\" onmouseout=\\\"this.src='\" + config.ui_domain + \"/assets/images/gate/btn_card_02.