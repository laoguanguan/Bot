vpIssuerCode = \"LT\";\n\t\t\telse if (vpIssuerCode == \"80\") vpIssuerCode = \"IMB\";\n\t\t} else if (vpCardCode == \"1600\") {\n\t\t\tvpCardCode = \"0204\";\n\t\t\tvpIssuerCode = \"KJB\";\n\t\t}\n\t},\n\tcheckCardCodeNormal: function (_cardcode) {\n\t\tvar normalCodeList = new Array('0100', '0204', '1500', '1600', '1800', '0170', '0700');\n\t\tfor (var i = 0; i < normalCodeList.length; i++) {\n\t\t\tif (normalCodeList[i] == _cardcode) {\n\t\t\t\treturn true;\n\t\t\t}\n\t\t}\n\t\treturn false;\n\t},\n\tgetCurrentURL: function () {\n\t\tif (!window.location.origin) {\n\t\t\twindow.location.origin = window.location.protocol + \"//\" + window.location.hostname + (window.location.port ? ':' + window.location.port : '');\n\t\t}\n\t\treturn ((window.location.origin == \"file://\") ? \"\" : window.location.origin);\n\t},\n\tgetPopupWindowOption: function (_name) {\n\t\tvar menuLayerWidth = 650;\n\t\tvar menuLayerHeight = 452;\n\t\tif (_name == \"cardselect\") menuLayerHeight += 180;\n\t\tvar tempLeftPos = window.screenLeft != undefined ? window.screenLeft : screen.left;\n\t\tvar tempTopPos = window.screenTop != undefined ? window.screenTop : screen.top;\n\t\tvar tempWidth = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\n\t\tvar tempHeight = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\n\t\tvar menuLeftPos = ((tempWidth / 2) - (menuLayerWidth / 2)) + tempLeftPos;\n\t\tvar menuTopPos = ((tempHeight / 2) - (menuLayerHeight / 2)) + tempTopPos;\n\n\t\treturn ('vpWispWin', 'width=' + this.getPopupWindowWidth() + ', height=' + this.getPopupWindowHeight(_name) + ', top=' + menuTopPos + ', left=' + menuLeftPos + ', resizable=no');\n\t},\n\tgetPopupWindowWidth: function () {\n\t\tvar menuLayerWidth = 650;\n\t\tif (m_BrowserInfo == 'wff') {\n\t\t\tmenuLayerWidth += 2;\n\t\t}\n\t\telse if (m_BrowserInfo == 'wopera') {\n\t\t\tmenuLayerWidth += 20;\n\t\t}\n\t\treturn menuLayerWidth;\n\t},\n\tgetPopupWindowHeight: function (_name) {\n\t\tvar menuLayerHeight = 452;\n\t\tif (_name == \"cardselect\") menuLayerHeight += 180;\n\t\tif (m_BrowserInfo == 'wff') {\n\t\t\tmenuLayerHeight += 2;\n\t\t}\n\t\tif (m_BrowserInfo == 'msf') {\n\t\t\tmenuLayerHeight += 30;\n\t\t}\n\t\telse if (m_BrowserInfo == 'wopera') {\n\t\t\tmenuLayerHeight += 82;\n\t\t\tif (navigator.userAgent.indexOf(\"NT 6.3\") != -1 || navigator.userAgent.indexOf(\"NT 6.2\") != -1) menuLayerHeight += 10;\n\t\t}\n\t\treturn menuLayerHeight;\n\t},\n\tcheckQRTarget: function (_cardCode, _issuerCode, _vpPayform) {\n\t\tif (this.IsPayboocOnlyPay(_cardCode, _issuerCode)) {\n\t\t\treturn false;\n\t\t}\n\t\tif (m_OSInfo.indexOf(\"Windows\") == -1) {\n\t\t\tif (_cardCode != \"0204\") return true;\n\t\t\tif (this.checkIsKBPartners(_cardCode, _issuerCode)) {\n\t\t\t\treturn true;\n\t\t\t}\n\t\t}\n\t\tif (CheckFormField(_vpPayform, \"QRFlag\")) {\n\t\t\treturn (_vpPayform.QRFlag.value == \"TRUE\")\n\t\t}\n\t\treturn false;\n\t},\n\tcheckIsKBPartners: function (_cardCode, _issuerCode) {\n\t\tif (_cardCode == \"0204\") {\n\t\t\tif (_issuerCode == \"KA\" || _issuerCode == \"PYC\" || _issuerCode == \"HWH\" || _issuerCode == \"KNI\" \n\t\t\t\t|| _issuerCode == \"HS\" || _issuerCode == \"IAR\" || _issuerCode == \"KTS\" || _issuerCode == \"KJB\"\n\t\t\t\t|| _issuerCode == \"DN\" || _issuerCode == \"LT\" || _issuerCode == \"IMB\") {\n\t\t\t\treturn true;\n\t\t\t}\t\n\t\t}\n\t\treturn false;\n\t\t\n\t},\n\tIsPayboocOnlyPay: function (_cardCode, _issuerCode) {\n\t\tif (_cardCode == \"0100\" && _issuerCode == \"SSG\") {\n\t\t\treturn true;\n\t\t}\n\t\treturn false;\n\t},\n\tIsChrome141AndFailChkVer: function (_reason) {\n\t\tif (m_BrowserInfo === \"wchrome141\" && m_isFailedPostEISP === true && _reason === \"CheckVersion\") {\n\t\t\treturn true;\n\t\t}\n\t\treturn false;\n\t},\n\tSupportFromChrome141: function() {\n\t\tthis.Write_ISP_Log(\"[m_OSInfo]\", m_OSInfo);\n\t\tthis.Write_ISP_Log(\"[m_BrowserInfo]\", m_BrowserInfo);\n\t\tif (m_BrowserInfo === \"wchrome141\") {\n\t\t\tvar httpReq = new XMLHttpRequest();\n\t\t\thttpReq.open('POST', GetCurent_url_POST(), true);\n\t\t\thttpReq.timeout = 1000;\n\t\t\thttpReq.setRequestHeader('Content-Type', 'text/plain');\n\t\t\thttpReq.onreadystatechange = function () {\n\t\t\t\tvp_util.Write_ISP_Log(\"[SUPPORT FROM CHROME 141 readyState]\", httpReq.readyState);\n\t\t\t\tvp_util.Write_ISP_Log(\"[SUPPORT FROM CHROME 141 status]\", httpReq.status);\n\t\t\t\tif (httpReq.readyState === 4) {\n\t\t\t\t\tif (httpReq.status !== 200) {\n\t\t\t\t\t\tvp_util.Write_ISP_Log(\"[SUPPORT FROM CHROME 141 onerror] \", httpReq.status);\n\t\t\t\t\t\talert('설치가 반복되거나 결제 진행이 안되는 경우 가맹점으로 문의 부탁드립니다.');\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t};\n\t\t\thttpReq.ontimeout = function () {\n\t\t\t\tvp_util.Write_ISP_Log(\"[SUPPORT FROM CHROME 141 timeout]\", httpReq.timeout);\n\t\t\t};\n\t\t\thttpReq.send('{\"command\":\"checkversion\"}');\n\t\t}else {\n\t\t\tthis.Write_ISP_Log(\"[SUPPORT FROM CHROME 141 m_BrowserInfo]\", m_BrowserInfo);\n\t\t}\n\t}\n};\n\n/**\n * browser check\n */\nvar browserCheck = {\n\tbrowserName: null,\n\tbrowserVer: null,\n\tgetBrowserName: function () {\n\t\tthis.browserName = navigator.userAgent.toLowerCase();\n\t\tif (this.browserName.indexOf('opera') != -1) return 'opera';\n\t\tif (this.browserName.indexOf('opr') != -1) return 'opera';\n\t\tif (this.browserName.indexOf('firefox') != -1) return 'firefox';\n\t\tif (this.browserName.indexOf('chrome') != -1) return 'chrome';\n\t\tif (this.browserName.indexOf('safari') != -1) return 'safari';\n\t\tif (this.browserName.indexOf('staroffice') != -1) return 'staroffice';\n\t\tif (this.browserName.indexOf('webtv') != -1) return 'webtv';\n\t\tif (this.browserName.indexOf('beonex') != -1) return 'beonex';\n\t\tif (this.browserName.indexOf('chimera') != -1) return 'chimera';\n\t\tif (this.browserName.indexOf('netpositive') != -1) return 'netpositive';\n\t\tif (this.browserName.indexOf('phoenix') != -1) return 'phoenix';\n\t\tif (this.browserName.indexOf('skipstone') != -1) return 'skipstone';\n\t\tif (this.browserName.indexOf('msie') != -1) return 'msie';\n\t\tif (this.browserName.indexOf('rv:11.0') != -1) return 'msie';\n\t\tif (this.browserName.indexOf('netscape') != -1) return 'netscape';\n\t\tif (this.browserName.indexOf('mozilla/5.0') != -1) return 'mozilla';\n\t},\n\tgetIeBrowserVer: function () {\n\t\tthis.browserVer = \"\";\n\t\tvar ua = navigator.userAgent;\n\t\tvar re = new RegExp('MSIE ([0-9]{1,}[\\.0-9]{0,})');\n\t\tif (re.exec(ua) != null) {\n\t\t\tthis.browserVer = parseFloat(RegExp.$1).toString();\n\t\t}\n\t\tif (/Trident/.test(ua)) {\t\t// IE 8 이상 버전 체크\n\t\t\tif (ua.indexOf('rv:11.0') != -1) {\t// IE 11 버전 일경우\n\t\t\t\tthis.browserVer = \"11\";\n\t\t\t}\n\t\t}\n\t\tif (this.browserVer.indexOf(\"7\") > -1) {\n\t\t\tthis.browserVer += (/Trident/.test(ua)) ? \"c\" : \"r\";\n\t\t}\n\t\treturn this.browserVer;\n\t}\n};\n\n/**\n * aictive X ISP 결제 field set/get\n */\nvar vp_ActiveX_ISP = {\n\tSetField: function (_vpPayform) {\n\t\tdocument.KvpDwn.KVPSetField(\"PGID\", _vpPayform.KVP_PGID.value);\n\t\tdocument.KvpDwn.KVPSetField(\"CardCode\", vpCardCode);\n\t\tdocument.KvpDwn.KVPSetField(\"GoodName\", decodeURIComponent(vp_util.getConvertedGoodName()));\n\t\tdocument.KvpDwn.KVPSetField(\"Price\", _vpPayform.KVP_PRICE.value);\n\t\tdocument.KvpDwn.KVPSetField(\"Currency\", _vpPayform.KVP_CURRENCY.value);\n\t\tdocument.KvpDwn.KVPSetField(\"NoInterestInf\", _vpPayform.KVP_NOINT_INF.value);\n\t\tdocument.KvpDwn.KVPSetField(\"QuotaInf\", _vpPayform.KVP_QUOTA_INF.value);\n\t\tdocument.KvpDwn.KVPSetField(\"ImgURL\", vpImgDomain + \"/\");\n\t\tdocument.KvpDwn.KVPSetField(\"VP_BCIssuerCode\", vpIssuerCode);\n\t\tdocument.KvpDwn.KVPSetField(\"Check_JS\", \"VP\"); //JS VP페이지 링크사용\n\t\tdocument.KvpDwn.KVPSetField(\"CURRENT_URL\", CURRENT_URL);\n\t\tdocument.KvpDwn.KVPSetField(\"Reserved1\", _vpPay