ace('층', ' Floor,').replace('구역', ' Sec,').replace('열', ' Row,').replace('번', ' Seat');\n\t} else {\n\t\tswitch(langCd){\n\t        case LANG_CD.EN:\n\t        \tpSeatTitle = pSeatTitle.replace('층', ' Floor,').replace('구역', ' Sec,').replace('열', ' Row,').replace('번', ' Seat');\n\t            break;\n\t        case LANG_CD.CN:\n\t        \tpSeatTitle = pSeatTitle.replace('층', ' 层,').replace('구역', ' Sec,').replace('열', ' 列,').replace('번', ' 号');\n\t            break;\n\t        case LANG_CD.JP:\n\t        \tpSeatTitle = pSeatTitle.replace('층', ' 層,').replace('구역', ' Sec,').replace('열', ' 列,').replace('번', ' 番');\n\t            break;\n\t        case LANG_CD.KR:\n\t            break;\n\t        default:\n\t        \tpSeatTitle = pSeatTitle.replace('층', ' Floor,').replace('구역', ' Sec,').replace('열', ' Row,').replace('번', ' Seat');\n            \tbreak;\n\t\t}\n\t}*/\n\t\n\tpSeatTitle = pSeatTitle.replaceAll('  ', ' ');\n\t\n\tvar pSeatTitleEn = '';\n\n\tvar a = pSeatTitle.split(',');\n\n\tfor(i = 0; i < a.length; i++){\n\n\t\tvar b = a[i].trim().split(' ');\n\t\tif(b.length == 1){\n\t\t\tpSeatTitleEn += b[0];\n\t\t}else{\n\t\t\tpSeatTitleEn += b[1] + ' ' + b[0];\t\n\t\t}\n\t\t\n\t\t\n\t\tif(i < a.length - 1){\n\t\t\t\n\t\t\tpSeatTitleEn += ', ';\n\t\t}\n\t}\n\t\n\treturn pSeatTitleEn;\n}\n\nfunction covertSection(sec){\n\tsec = sec.replace('층', 'Floor').replace('구역', 'Sec').replace('열', 'Row').replace('번', 'Seat');\n\t/*if(window['langCd'] == void 0){\n\t\tsec = sec.replace('층', 'Floor').replace('구역', 'Sec').replace('열', 'Row').replace('번', 'Seat');\n\t} else {\n\t\tswitch(langCd){\n\t        case LANG_CD.EN:\n\t        \tsec = sec.replace('층', 'Floor').replace('구역', 'Sec').replace('열', 'Row').replace('번', 'Seat');\n\t            break;\n\t        case LANG_CD.CN:\n\t        \tsec = sec.replace('층', '层').replace('구역', '区域').replace('열', '列').replace('번', '号');\n\t            break;\n\t        case LANG_CD.JP:\n\t        \tsec = sec.replace('층', '層').replace('구역', '区域').replace('열', '列').replace('번', '番');\n\t            break;\n\t        case LANG_CD.KR:\n\t            break;\n\t        default:\n\t        \tsec = sec.replace('층', 'Floor').replace('구역', 'Sec').replace('열', 'Row').replace('번', 'Seat');\n            \tbreak;\n\t\t}\n\t}*/\n\treturn sec;\n}\n\n/**\n * 날짜문자열을 넘기면 YYYY.mm.dd 형태로 포맷팅됨.\n * Deprecated Sun, 31 Jul 2016 17:00\n */\nfunction convertDateFormat(date, time){\n\t\n\tif(date == null || date == undefined || date.length != 8){\n\t\t\n\t\tdate = \"20000101\";\n\t}\n\t\n\tif(time == null || time == undefined || (time.length != 4 && time.length != 6)){\n\t\t\n\t\ttime = \"0000\";\n\t}\n\t\n\t//var d = new Date(Date.parse(date.substr(0,4)+\"-\"+date.substr(4,2)+\"-\"+date.substr(6,2)+\"T\"+time.substr(0,2)+\":\"+time.substr(2,2)));\n\t//return d.toUTCString().substr(0, 22); // Sat, 30 Jul 2016 18:00\n\treturn convertDateFormatOnlyDate(date) + \" \" + convertDateFormatOnlyTime(time);\n}\n\nfunction convertDateFormat2(date){\n\t\n\tif(date == null || date == undefined || date.length < 12){\n\t\t\n\t\tif(date.length < 8){\n\t\t\t\n\t\t\tdate = \"200001010000\";\t\n\t\t}else{\n\t\t\t\n\t\t\tdate = date.substr(0, 8) + \"0000\";\n\t\t}\n\t}\n\treturn convertDateFormat(date.substr(0, 8), date.substr(8, 4));\n}\n\nfunction convertDateFormatOnlyDate(dateStr, DATE_DELIM){\n\tDATE_DELIM = (DATE_DELIM == undefined ? \".\" : DATE_DELIM);\n\treturn (dateStr.substr(0,4)+DATE_DELIM+dateStr.substr(4,2)+DATE_DELIM+dateStr.substr(6,2));\n}\nfunction convertDateFormatOnlyTime(timeStr, TIME_DELIM){\n\tTIME_DELIM = (TIME_DELIM == undefined ? \":\" : TIME_DELIM);\n\tif(timeStr.length == 6){\n\t\treturn (timeStr.substr(0,2)+TIME_DELIM+timeStr.substr(2,2)+TIME_DELIM+timeStr.substr(4,2));\n\t} else {\n\t\treturn (timeStr.substr(0,2)+TIME_DELIM+timeStr.substr(2,2));\n\t}\n}\n// Jun 07, 2016\nfunction convertMMMDDYYYY(date){\n\t\n\tif(date == null || date == undefined || date.length != 8){\n\t\t\n\t\tdate = \"20000101\";\n\t}\n\t\n\tvar monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n\t\n\treturn monthNames[Number(date.substr(4,2)) - 1] + \" \" +  date.substr(6,2) + \", \" + date.substr(0,4);\n}\n\nisGlbPhoneNumber = function (val, msg) {\n\tif (/^((\\+\\d{1,3}(-| )?\\(?\\d\\)?(-| )?\\d{1,5})|(\\(?\\d{2,6}\\)?))(-| )?(\\d{3,4})(-| )?(\\d{4})(( x| ext)\\d{1,5}){0,1}$/.test(val)){\n\t\treturn true;\n\t}\n\telse {\n\t\tif (msg) {\n\t\t\talertGlb(msg);\n\t\t}\n\t\treturn false;\n\t}\n}\n\nisGlbUserName = function (val) {\n\tif (/^[a-zA-Z\\s]+$/.test(val)){\n\t\n\t\treturn true;\n\t}\n\telse {\n\t\treturn false;\n\t}\n}\n\n/**\n * xss 공격 관련 특수문자 escape\n * @param string\n * @returns {string}\n */\nfunction escapeHtml(string) {\n\tvar entityMap = {\n\t\t'&': '&amp;',\n\t\t'<': '&lt;',\n\t\t'>': '&gt;',\n\t\t'\"': '&quot;',\n\t\t\"'\": '&#39;',\n\t\t'/': '&#x2F;',\n\t\t'`': '&#x60;',\n\t\t'=': '&#x3D;'\n\t};\n\n\treturn String(string).replace(/[&<>\"'\\/]/g, function (s) {\n\t\treturn entityMap[s];\n\t});\n}\n\n/**\n * [{},{},...] 일 때, 각 object안에 있는 string 값들에 대해 xss 취약점 보완\n * @param {array} arr\n */\nfunction xssHtmlObj(arr) {\n\tif (arr.constructor != Array) {\n\t\tconsole.log('Not Array');\n\t\treturn false;\n\t}\n\tarr.forEach(function(obj) {\n\t\tif (obj.constructor != Object) {\n\t\t\tconsole.log('Not Object');\n\t\t\treturn false;\n\t\t}\n\t\t$.each(obj, function(k, v) {\n\t\t\tif (typeof v === 'string') {\n\t\t\t\tobj[k] = escapeHtml(v);\n\t\t\t}\n\t\t});\n\t});\n}\n\n\n/**\n * 힌글만 입력되는지 validation\n * validForKor(text);\n * @return boolean\n * */\nfunction validForKor(text){\n\tvar denyChar = /[ㄱ-ㅎㅏ-ㅣ가-힣]/g;\n\tif (denyChar.test(text)) {\n\t\treturn true;\n\t}\n\treturn false;\n}\n\n/**\n * 공백(스페이스 바) validation\n * validForSpace(text);\n * @return boolean\n * */\nfunction validForSpace(str) {\n\tif(str.search(/\\s/) !== -1) {\n\t\treturn true; // 스페이스가 있는 경우\n\t} else {\n\t\treturn false; // 스페이스 없는 경우\n\t}\n}"
