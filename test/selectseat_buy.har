            "compression": 0,
            "text": "@charset \"utf-8\";\r\n\r\n@font-face{\r\nfont-family:'Noto';\r\nfont-weight:normal;\r\nsrc:url(../fonts/NotoSansKR-Regular.eot);\r\nsrc:url(../fonts/NotoSansKR-Regular.eot?#iefix) format('embedded-opentype'),url(../fonts/NotoSansKR-Regular.woff) format('woff'),url(../fonts/NotoSansKR-Regular.ttf) format('truetype');\r\n}\r\n@font-face{\r\nfont-family:'Noto';\r\nfont-weight:bold;\r\nsrc:url(../fonts/NotoSansKR-Bold.eot);\r\nsrc:url(../fonts/NotoSansKR-Bold.eot?#iefix) format('embedded-opentype'),url(../fonts/NotoSansKR-Bold.woff) format('woff'),url(../fonts/NotoSansKR-Bold.ttf) format('truetype');\r\n}\r\n\r\n/* reset*/\r\n* {-webkit-box-sizing: border-box;-moz-box-sizing: border-box;box-sizing: border-box;}\r\nhtml,body {height: 100%;}\r\nhtml {-ms-touch-action: none; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale}\r\nbody {-webkit-text-size-adjust:none} /* 뷰포트 변환시 폰트크기 자동확대 방지 */\r\nbody,div,dl,dt,dd,ul,ol,li,h1,h2,h3,h4,h5,h6,pre,code,form,fieldset,legend,textarea,p,blockquote,th,td,input,select,textarea,button {margin:0;padding:0;width: auto;box-sizing: border-box;}\r\nfieldset,img {border:0 none}\r\nimg{max-width:100%}\r\ndl,ul,ol,menu,li, dir {list-style:none; margin:0}\r\nblockquote, q {quotes:none}\r\nblockquote:before, blockquote:after,q:before, q:after {content:'';content:none}\r\ninput,select,textarea,button{vertical-align:middle}\r\nbutton {border:0 none;background-color:transparent;cursor:pointer; /*outline:none; */}\r\n/*button:focus {outline:0;}*/\r\ntable {border-collapse:collapse;border-spacing:0}\r\ninput[type='text'],input[type='password'],input[type='submit'],input[type='search'] , input[type=\"tel\"] , input[type=\"number\"]{-webkit-appearance:none;appearance: none;}\r\ninput[readonly=\"readonly\"] {background-color:#f6f6f6;}\r\ninput:checked[type='checkbox'] {background-color:#666; -webkit-appearance:checkbox}\r\nbutton,input[type='button'],input[type='submit'],input[type='reset'],input[type='file'] {-webkit-appearance:button; border-radius:0}\r\ninput[type=\"search\"]::-webkit-search-decoration,\r\ninput[type=\"search\"]::-webkit-search-cancel-button,\r\ninput[type=\"search\"]::-webkit-search-results-button,\r\ninput[type=\"search\"]::-webkit-search-results-decoration {display:none;} {-webkit-appearance:none}\r\nbody {background:transparent}\r\nbody,th,td,input,select,textarea,button {font-size:14px;line-height:1;font-family: Dotum,'돋움',Noto,Helvetica,AppleSDGothicNeo,sans-serif; color: #222;-webkit-text-size-adjust: none;letter-spacing:-0.5px} \r\na {color:#333;text-decoration:none}\r\na:active, a:hover, a:link {text-decoration:none}\r\naddress,caption,cite,code,dfn,em,var, i {font-style: inherit;font-weight: inherit;}\r\nli,p,dt,dd,div,span{word-break:break-all;}\r\nb, strong, em{font-weight:normal; }\r\n.txt_l{text-align:left !important}.txt_r{text-align:right !important}.txt_c{text-align:center !important}\r\n\r\n/*링크에 대한 설정*/\r\na { text-decoration: none;}\r\na:link { text-decoration: none}\r\na:visited { text-decoration: none}\r\na:hover { text-decoration: none}\r\n\r\n/*placeholder */\r\n::-webkit-input-placeholder{color:#ccc;font-weight:normal;}\r\n::-moz-placeholder{color:#ccc;font-weight:normal;}\r\n::-moz-placeholder{color:#ccc;font-weight:normal;}\r\n:-ms-input-placeholder{color:#ccc;font-weight:normal;}\r\n\r\na:focus, button:focus, label:focus, select:focus, input:focus {outline: dotted thin #666 !important;}\r\ninput:focus + label {outline: none}\r\n.focus_s {outline: dotted thin #666}\r\n\r\n/*radiobox\r\n.radio {height: 1.625rem;line-height:1.625rem;position:relative;display:inline-block}\r\n.radio input[type=\"radio\"]{display: none}\r\n.radio label {font-size: 1\trem;color:#aaa;letter-spacing:0;display:inline-block; height: 1.625rem;line-height:1.625rem;cursor:pointer;}\r\n.radio label em{display: inline-block;vertical-align:top ; width: 1.625rem; height: 1.625rem;border: 0.08rem solid #cccccc;border-radius:100%; cursor: pointer;margin-right:0.3rem;}\r\n/* .radio label img{vertical-align:middle;position:relative;top:-1px;left:-4px;} */\r\n/*.radio input[type=\"radio\"]:checked + label em {border: 0.08rem solid #f43142; background: #fff url(../images/icon_pack.png) -4.16rem -0.13rem no-repeat;background-size:7.75rem auto;}\r\n.radio input[type=\"radio\"]:checked + label {color:#000;}*/\r\n\r\n/*checkbox*/\r\n.check_area input[type=\"checkbox\"]{position: absolute;top: 3px;left: 3px; width: 10px; height: 10px; outline: 0}\r\n.check_area label {letter-spacing:-1px;display:inline-block; cursor:pointer;}\r\n.check_area label span{display: inline-block;vertical-align:top ;position:relative;top:-2px;left:2px; width: 16px; height: 12px;cursor: pointer;margin-right:9px;background:#fff url(../images/icon_pack.png) -52px -1px no-repeat;}\r\n.check_area input[type=\"checkbox\"]:checked + label span {background: #fff url(../images/icon_pack.png) -3px -1px; no-repeat;}\r\n\r\n/*onlyglobal\r\n약관명 ellipsis\r\n*/\r\n.check_area label div{display: inline-block; width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}\r\n@media(min-width: 770px) {.check_area label div{display: inline-block; width: auto; white-space: normal; overflow: visible; text-overflow: clip;}}\r\n\r\n.check_point {position: relative;}\r\n.check_point input[type=\"checkbox\"]{position: absolute; top: 3px; left: 3px; width: 10px; height: 10px; outline: 0}\r\n.check_point label {letter-spacing:-1px;display:inline-block; cursor:pointer;}\r\n.check_point label span{z-index: 999; background: #fff; border:1px solid #ccc;border-radius:3px;width:24px; height:24px; display: inline-block;vertical-align:middle;position:relative;top:-1px;left:2px; cursor: pointer;margin-right:9px;}\r\n.check_point input[type=\"checkbox\"]:checked + label span {background: #fff url(../images/icon_pack.png) 0 2px; no-repeat;}\r\n\r\n/*input*/\r\n.input_st01{border: 1px solid #ccc;border-radius:5px;height:43px;display:block;padding:0 10px;width:100%;text-align:left;font-size:14px;font-weight:bold; }\r\n/*.input_st01:focus{border:1px solid #333;color:#000;outline:0;}*/\r\n\r\n/*셀렉트박스*/\r\nselect {font-size:12px;padding:2px 0;_margin-top:10px}\r\nselect:disabled {background:#f4f6fa !important;_background:#fff;  color:#cccccc !important;border:1px solid #ccc}\r\n\r\n.select_box_w {width:100px;height:33px; position: relative;border:1px solid #333;_border:0;border-radius:5px; display:inline-block;*display:inline; zoom:1;vertical-align:middle;\r\nbackground:transparent url(../images/icon_select.png) 90% center no-repeat;}\r\n.select_box_w label {position: absolute;top:9px;left:13px; color: #333;_color:#333;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;word-wrap:normal;text-align:left;font-weight:bold;font-size:12px;line-height:13px;}\r\n.select_box_w select.select_b {position:relative;top:-1px; width: 100%;height:35px;opacity: 0;filter: alpha(opacity=0);}\r\n.select_box_w.on {border:1px solid #888;}\r\n.select_box_w.on label{color:#333;font-weight:bold;}\r\n\r\n.select_box01_w {width:100%;height:58px; position: relative;border:1px solid #e0e0e0;_border:0;border-radius:5px; display:inline-block;*display:inline; zoom:1;vertical-align:middle;\r\nbackground:transparent url(../images/icon_select.png) 90% center no-repeat;}\r\n.select_box01_w label {position: absolute;top:22px;left:10px; right:20px; color: #666;_color:#666;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;word-wrap:normal;text-align:left;font-size:11px;line-height:12px;}\r\n.select_box01_w select.select_b {position:relative;top:-1px; width: 100%;height:58px;opacity: 0;filter: alpha(opacity=0);}\r\n.select_box01_w.on {border:1px solid #888;}\r\n.select_box01_w.on label{color:#333;font-weight:bold;}\r\n\r\n.select_box02_w {width:100%;height:38px; position: relative;border:1px solid #e0e0e0;_border:0;border-radius:5px; display:inline-block;*display:inline; zoom:1;vertical-align:middle;\r\nbackground:transparent url(../images/icon_select.png) 90% center no-repeat;}\r\n.select_box02_w label {position: absolute;top:12px;left:10px; right:20px; color: #666;_color:#666;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;word-wrap:normal;text-align:left;font-size:12px;line-height:13px;}\r\n.select_box02_w select.select_b {position:relative;top:-1px; width: 100%;height:38px;opacity: 0;filter: alpha(opacity=0);}\r\n.select_box02_w.on {border:1px solid #888;}\r\n.select_box02_w.on label{color:#333;font-weight:bold;}\r\n\r\n#wrap{width:100%;position:relative;min-width:660px;max-width:800px;/*overflow:hidden;height:490px;*/margin:0 auto}\r\nsection{position:relative;overflow:hidden;margin-bottom:50px;}\r\n\r\n/**카드정보 입력**/\r\n.input_w{float:left;width:100%;padding-right:195px;height:490px;background:#fff;z-index:0;position:relative;}\r\n.input_w .header{height:48px;border-bottom:1px solid #ececec;position:relative;}\r\n.input_w .header h1{font-size:0;background:transparent url(../images/ci_danal.png?date=220701) 0 0 no-repeat;width:64px;height:30px; background-size:64px auto;position:absolute;bottom:5px;left:17px }\r\n.input_w .header .danal_tit{position:absolute;bottom:10px;right:17px;font-family:Noto;font-size:18px;}\r\n\r\n/*약관*/\r\n.terms_w{position:relative; margin:13px 18px}\r\n.terms_all{position:relative;height:28px;}\r\n.terms_all .tit{font-size:16px;font-family:noto;position:absolute;top:5px}\r\n.terms_all button{font-size:13px;color:#333;font-family:noto;width:86px;height:28px;line-height:24px;display:inline-block; vertical-align:middle;border:1px solid #dddddd;border-radius:5px; position:absolute;right:0;top:0;box-shadow: 1px 1px 2px 0 #eaeaea}\r\n.terms_all button span{background: transparent url(../images/icon_pack.png) no-repeat;background-position: -52px -1px; width:16px;height:12px;display:inline-block;margin-right:1px;}\r\n.terms_all button.on span{background-position: -3px -1px;}\r\n.terms_w .terms_list {overflow:hidden;margin-top:10px;}\r\n.terms_w .terms_list li{width:50%;font-size:11px;float:left;padding:4px 0;position:relative;}\r\n.terms_w .terms_list a{position:absolute;right:20px;border-bottom: 1px solid #999;color:#999;cursor:pointer;}\r\n\r\n\r\n/*카드선택*/\r\n.card_select{position:relative; margin:0 13px;border-bottom:1px solid #eee;}\r\n.card_select ul{overflow:hidden;}\r\n.card_select li{width:20%;float:left;padding:3px;position:relative;}\r\n.card_select li button{border:1px solid #e0e0e0;color:#666;border-radius:5px; display:block;width:100%;height:58px;font-size:11px;letter-spacing:-1px}\r\n.card_select li button span{display:block;margin:0 auto}\r\n.card_select li.on button{border:1px solid #000;box-shadow: 3px 3px 0 0 #ddd;color:#000 !important}\r\n.card_select li.on .select_box01_w{border:1px solid #000;box-shadow: 3px 3px 0 0 #ddd;color:#000 !important}\r\n.card_select li .icon_event{position:absolute;left:0;top:0;font-size:10px;color:#ff0008;display:block;padding:0 4px 1px;background:#fff; border:1px solid #ff0008;border-radius:5px;z-index:999}\r\n.card_info_tx{position:relative; width:100%;margin-top:10px;padding:0 3px 15px;letter-spacing:-1px;}\r\n.card_info_tx p{font-size:11px;color:#999;}\r\n.card_info_w{position:absolute; right: 5px; top:0;display:inline-block;height:15px;font-size:11px;}\r\n.interest_info {margin-left:7px}\r\n.interest_info em{background: transparent url(../images/icon_pack.png) -103px -2px no-repeat;height:14px;width:14px;display:inline-block;vertical-align:middle;}\r\n.interest_info a{border-bottom: 1px solid #fff;color:#666;cursor:pointer;}\r\n.point_info {margin-left:5px}\r\n.point_info em{background: transparent url(../images/icon_pack.png) -151px -2px no-repeat;height:14px;width:14px;display:inline-block;vertical-align:middle;}\r\n.point_info a{border-bottom: 1px solid #fff;color:#666;cursor:pointer;}\r\n\r\n.point_w{display:inline-block;margin-left:10px}\r\n.point_w label{font-size:13px;color:#333}\r\n.point_w label em{font-size:11px;color:#999}\r\n\r\n/* 즉시할인 */\r\n.discount_btn {\r\n  width: 100px;\r\n  height: 26px;\r\n  background-color: #f9454a;\r\n  color: white;\r\n  text-align: center;\r\n  font-size: 14px;\r\n  border-radius: 5px;\r\n}\r\n.discount_set_btn {\r\n  background-color: #f9454a;\r\n  color: white;\r\n  padding: 6px;\r\n  font-size: 12px;\r\n  border-radius: 5px;\r\n}\r\n#discount_dd_dd {\r\n color:#f9454a;\r\n}\r\n\r\n\r\n\r\n.hyundai, .sinhan, .samsung, .kb, .bc, .lotte, .hana, .nh, .woori, .union, .payco, .kakao, .naver, .visa, .master, .jcb {background: transparent url(../images/img_card_ci.png?t=240830) no-repeat;background-size:315px auto;}\r\n.hyundai{width:70px;height:26px;background-position: -14px -8px !important}\r\n.sinhan{width:70px;height:26px;background-position: -118px -8px !important}\r\n.samsung{width:70px;height:26px;background-position: -220px -8px !important}\r\n.lotte{width:70px;height:26px;background-position: -14px -59px !important}\r\n.hana{width:70px;height:26px;background-position: -115px -59px !important}\r\n.nh{width:70px;height:26px;background-position: -221px -59px !important}\r\n.woori{width:70px;height:26px;background-position: -221px -114px !important}\r\n.bc{width:70px;height:26px;background-position: -115px -114px !important}\r\n.kb{width:70px;height:26px;background-position: -16px -114px !important}\r\n.union{width:70px;height:26px;background-position: -16px -162px !important}\r\n.payco{width:70px;height:26px;background-position: -117px -162px !important}\r\n.kakao{width:70px;height:26px;background-position: -220px -162px !important}\r\n.naver{width:70px;height:26px;background-position: -13px -210px !important}\r\n.visa{width:70px;height:26px;background-position: -116px -207px !important}\r\n.master{width:70px;height:26px;background-position: -222px -208px !important}\r\n.jcb{width:70px;height:26px;background-position: -14px -253px !important}\r\n\r\n.card_info_b{position:absolute;top:5px;right:5px}\r\n.interest_b{background: transparent url(../images/icon_pack.png) -103px -2px no-repeat;height:14px;width:14px;display:inline-block;vertical-align:middle;font-size:0}\r\n.point_b{background: transparent url(../images/icon_pack.png) -151px -2px no-repeat;height:14px;width:14px;display:inline-block;vertical-align:middle;font-size:0;}\r\n\r\n/* 할부선택*/\r\n.monthly_w {padding:0 3px 8px;}\r\n\r\n/*이메일입력 200429*/\r\n.email_w{position:relative; margin: 0 3px 13px 3px;}\r\n.email_w input{width: 70%; display: inline-block;height: 33px;margin-left:4px;border-color: #000; font-size: 13px;}\r\n.cont_tit{display: inline-block; width: 70px; font-family: noto; font-size: 15px;}\r\n\r\n/*간편결제*/\r\n.payment_select{position:relative; margin:10px 13px;}\r\n.payment_select ul{overflow:hidden;}\r\n.payment_select li{width:20%;float:left;padding:3px;position:relative}\r\n.payment_select li button{border:1px solid #e0e0e0;color:#666;border-radius:5px; display:block;width:100%;height:38px;font-size:12px;}\r\n.payment_select li.on button{border:1px solid #000;box-shadow: 3px 3px 0 0 #ddd}\r\n.payment_select li.on .select_box02_w{border:1px solid #000;box-shadow: 3px 3px 0 0 #ddd;color:#000 !important}\r\n.payment_select li .icon_event{position:absolute;right:0;top:0;font-size:10px;color:#ff0008;display:block;padding:0 4px 1px;background:#fff; border:1px solid #ff0008;border-radius:5px;z-index:999}\r\n\r\n/*비활성화*/\r\n.dis_b li span em{filter: opacity(0.5);}\r\n.dis_b .icon_event{filter: opacity(0.5);}\r\n.dis_b li.on em{filter: opacity(1);}\r\n.dis_b li.on span.icon_event{filter: opacity(1);}\r\n\r\n.dis_b li button span{background: transparent url(../images/img_card_d.png?t=240830) no-repeat;background-size:315px auto;}\r\n.dis_b li button{color:#ccc}\r\n.dis_b li button:disabled{cursor:default;}\r\n.dis_b li .select_box01_w label{color:#ccc}\r\n.dis_b li .select_box02_w label{color:#ccc}\r\n.dis_b li.on button span{background: transparent url(../images/img_card_ci.png?t=240830) no-repeat;background-size:315px auto;}\r\n.dis_b li.on button{color:#666}\r\n.dis_b li.on .select_box01_w label{color:#666}\r\n.dis_b li.on .select_box02_w label{color:#666}\r\n\r\n/*상세타이틀*/\r\n.confirm_w{position:relative; margin:20px 18px;font-size:16px;font-family:noto;}\r\n\r\n/*상세내역*/\r\n.field_w{position:relative; margin:0 20px;padding:20px 0;border-bottom:1px solid #eee;border-top:1px solid #eee}\r\n.field_w li{}\r\n.field_w dl{width:100%;}\r\n.field_w dt, .field_w dd{display:inline-block;}\r\n.field_w dt {font-size:14px;padding-left:10px;font-family:noto;color:#999;width:25%}\r\n.field_w dd{width:75%;padding-right:30px;font-size:14px;font-weight:bold;height:43px;line-height:43px} \r\n\r\n.confirm_info{text-align:center;margin-top:30px;font-size:14px;color:#666}\r\n.confirm_info span{color:#e04549}\r\n\r\n/*배너*/\r\n.banner_w {text-align:center;position:absolute;left:0;right:195px;bottom:5px}\r\n.banner_img {max-height: 60px}\r\n\r\n/**카드정보 실행**/\r\n.info_w{width:195px;height:490px;background:#f4f4f4;position:absolute;right:0;top:0}\r\n.shadow{display:block;width:1px;height:490px;position:absolute;top:0;left:0;background:#ddd;box-shadow: 1px 0 0 1px #eaeaea ;}\r\n.card_info{padding:20px 12px}\r\n.card_info li{margin-bottom:13px;}\r\n.card_info li dt{font-size:11px;margin-bottom:5px; color:#999}\r\n.card_info li dd{font-size:14px;font-weight:bold; color:#333;letter-spacing:-1px;text-overflow: ellipsis; white-space: nowrap; overflow: hidden; line-height: 15px;}\r\n.card_amt {padding:15px 12px 2px;width:100%;position:absolute;bottom:0;}\r\n.card_amt li{width:100%;text-align:right;margin-bottom:5px;font-size:30px;font-weight:bold;font-family:Tahoma;color:#ef3b40;letter-spacing:-1px;}\r\n.card_amt li em{vertical-align:middle;font-size:24px;display:inline-block;position:relative;top:-3px;font-weight:bold;font-family:noto;padding-left:2px;}\r\n.card_amt .tit{font-size:11px;color:#999;font-weight:normal;}\r\n.btn_w{position:relative;width:100%;margin-top:20px}\r\n.btn_w button{background:#fff;display:block;width:100%;height:48px;border-radius:5px;font-family:noto;color:#8d8d8d;font-size:20px;font-wieght:bold;margin:10px 0;box-shadow: 1.5px 1.5px 0 1px #eaeaea}\r\n.btn_w button.next{background:#e04549;color:#fff;box-shadow: 1.5px 1.5px 0 1px #ddd}\r\n\r\n/**popup**/\r\n.popup {position: fixed; top: 0; bottom: 0; left: 0; right: 0;z-index:9999999999;width:100%;height:100%;display:table;}\r\n.popup > p { position: absolute; top:-150px; bottom:-150px; left: 0; right: 0; background-color: #000000; opacity: 0.6;z-index:-1;\r\n -ms-filter: \"progid:DXImageTransform.Microsoft.Alpha(Opacity=40)\";filter: alpha(opacity=40)}\r\n.popup .content_w {position:relative;z-index:9999999;display:table-cell;vertical-align:middle;text-align:center;}\r\n.popup .content { display: inline-block;position: relative;background:#ffffff;border-radius:5px;box-shadow: 0 1px 2px #333;}\r\n.popup .content .pheader {position:relative;  width: 100%; height: 52px; line-height: 52px; font-weight:bold; text-align: center; border-bottom: 1px solid #eee;font-size:18px;color:#000;background:#fff;border-radius:5px 5px 0 0; }\r\n.popup .content .pheader .pop_close{position:absolute;right:2px;top:2px; font-size:0;background: #fff url(../images/btn_close.png) no-repeat; background-size: 50px auto;display:inline-block;width:50px;height:48px;}\r\n.popup .content .pheader01 {width: 100%; height: 20px; z-index:999}\r\n.popup .content .pheader01 .pop_close{position:absolute;right:2px;top:1px;font-size:0;background: #fff url(../images/btn_close.png) 30px -10px; background-size: 40px auto;display:inline-block;width:19px;height:17px;}\r\n.popup .content .pbody {font-size: 14px; padding: 0;overflow:hidden;-webkit-overflow-scrolling: touch;background:#fff;letter-spacing:-1px}\r\n.popup .content .pbody .iframe_w {position: relative;height: 330px !important;background:#fff;-webkit-overflow-scrolling: touch;}\r\n.popup .content .pbody .iframe_w iframe {position: relative; width: 100%;height: 330px;-webkit-overflow-scrolling: touch;}\r\n.popup .content .pbody .iframe_w01 {position: relative;height: 460px;background:#fff; overflow: auto;}\r\n.popup .content .pbody .iframe_w01 iframe {position: relative; width: 100%;height: 460px;}\r\n.popup .content .pbody .notice_w{position:relative;font-size:16px;text-align:center;line-height:20px;font-weight:normal !important;background:#fff}\r\n.popup .content .pbody .notice_w b{font-weight:bold !important}\r\n.popup .content .pbody .scroll{padding:50px 30px;overflow:hidden;overflow-y:auto;-webkit-overflow-scrolling: touch;max-height:250px;}\r\n.popup .content .pbody .cont{padding:20px 30px;overflow:hidden;overflow-y:auto;-webkit-overflow-scrolling: touch;max-height:300px;}\r\n.popup .content .pbody .cont p{text-align:left;font-size:13px;line-height:18px;margin:10px 0}\r\n.popup .content .pbody .cont p em{color:#ef3b40}\r\n.popup .content .pbody .info_txt {font-size:11px;line-height:16px;text-align:left;display:inline-block;color:#666;margin-top:10px;position:relative;padding-left:10px;}\r\n.popup .content .pbody .info_txt:after{content:'';width:4px;height:4px;border-radius:100px; display:inline-block;background:#999;position:absolute;left:0;top:4px}\r\n.popup .content .pbody h3{font-size:12px;line-height:12px;width:100%;text-align:left;display:inline-block;color:#ef3b40;margin-top:20px;letter-spacing:-2px}\r\n.popup .content .pbody table{border:1px solid #ddd;width:100%; cellspacing:0;cellpadding:0}\r\n.popup .content .pbody table th{font-size:12px;text-align:left;padding:10px;border-bottom:1px solid #ddd}\r\n.popup .content .pbody table td{font-size:11px;line-height:14px;color:#999;text-align:left;padding:10px;border-bottom:1px solid #ddd}\r\n.popup .content .pfunction{overflow:hidden;}\r\n.popup .content .pfunction button{font-size:18px;float:right;padding:20px 10px;margin-right:10px;display:block;background:#fff;color:#000; font-weight:bold;}\r\n.popup .content .pfunction button.cancel{color:#ccc !important;margin-right:0;}\r\n\r\n/**loader**/\r\n.loader_pop {position:fixed;z-index:9999999999;top:0;right:0;bottom:0;left:0;width:100%;