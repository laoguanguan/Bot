 amount exceeds limit',\r\n\t'3426': 'Could not find this transaction',\r\n\t'3427': 'Original transaction does not exist or state is incorrect',\r\n\t'3428': 'Does not match original transaction information',\r\n\t'3429': 'Max number of inquiries exceeded or too frequent operations',\r\n\t'3430': 'UnionPay risk constraint',\r\n\t'3431': 'Transaction is not within the acceptance time range',\r\n\t'3432': 'Balance deduction successful but transaction exceeded payment time limit',\r\n\t'3433': 'Business not allowed please contact overseas service hotline for help.',\r\n\t'3434': 'Wrong number entered or business not opened, please contact overseas service hotline for help.',\r\n\t'3435': 'Transaction failure for details, please inquire with your issuer',\r\n\t'3436': 'Card number entered is invalid please double check and enter',\r\n\t'3437': 'Transaction failed issuer does not support this merchant please change to another bank card',\r\n\t'3438': 'Card state is incorrect',\r\n\t'3439': 'Card balance is insufficient',\r\n\t'3440': 'Error with PIN expiration date, or CVN2 entered, transaction failure',\r\n\t'3441': 'Cardholder identity information or mobile number entered are incorrect',\r\n\t'3442': 'Limit on number of PIN entry attempts exceeded',\r\n\t'3443': 'Your bank card currently does not support this business',\r\n\t'3444': 'Time limit on entry exceeded transaction failure',\r\n\t'3445': 'Transaction has been redirected, waiting for cardholder input',\r\n\t'3446': 'Dynamic password or SMS verification code validation failure',\r\n\t'3447': 'You have not signed up for UnionPay card-not-present payment service',\r\n\t'3448': 'Payment card has exceeded expiration date',\r\n\t'3449': 'Requires encryption verification for activation',\r\n\t'3450': 'Bank card has not been activated for authenticated payment',\r\n\t'3451': 'Issuer transaction rights limited for details please contact your issuer',\r\n\t'3452': 'The bank card is valid but issuer does not support SMS verification',\r\n\t'3453': 'Monthly accumulated transaction counter exceeded',\r\n\t'3454': 'File does not exist',\r\n\t'3455': 'General error',\r\n\t'3456': 'partial success',\r\n};\r\ndanalpaycard.web.terms_agree_flag = false;\r\ndanalpaycard.web.selected_card_obj = null;\r\ndanalpaycard.web.prev_selected_card_obj = null;\r\ndanalpaycard.web.cardcode = '';\r\ndanalpaycard.web.quota = '';\r\ndanalpaycard.web.usecardpoin = false;\r\ndanalpaycard.web.immediately_discount = false;\r\ndanalpaycard.web.all_card_list = null;\r\ndanalpaycard.web.runISP = null;\r\ndanalpaycard.web.ISPOINTCHECK = false;\r\ndanalpaycard.web.IMMEDIATELYDISCOUNT_OBJ = null;\r\ndanalpaycard.web.IMMEDIATELYDISCOUNT_BTN = false;\r\ndanalpaycard.web.alicode = '';\r\ndanalpaycard.web.alliance_popup_cancel_flag = true;\r\ndanalpaycard.web.current_card_sel = null;\r\ndanalpaycard.web.prev_card_sel = null;\r\ndanalpaycard.web.select_type = null;\r\ndanalpaycard.web.prev_select_type = null;\r\n\r\n// functions\r\ndanalpaycard.web.init_step1 = function(){\r\n    // 파라미터 초기화\r\n    danalpaycard.web.selected_card_obj = null;\r\n    danalpaycard.web.prev_selected_card_obj = null;\r\n    danalpaycard.web.cardcode = '';\r\n    danalpaycard.web.quota = '';\r\n    danalpaycard.web.usecardpoin = false;\r\n    danalpaycard.web.immediately_discount = false;\r\n    danalpaycard.web.all_card_list = null;\r\n    danalpaycard.web.runISP = null;\r\n    danalpaycard.web.ISPOINTCHECK = false;\r\n    danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ = null;\r\n\r\n    if(!danalpaycard.web.main_cardinfo){\r\n        danalpaycard.web.all_card_list = danalpaycard.web.select_cardinfo;\r\n    }\r\n    else if(!danalpaycard.web.select_cardinfo){\r\n        danalpaycard.web.all_card_list = danalpaycard.web.main_cardinfo;\r\n    }\r\n    else{\r\n        danalpaycard.web.all_card_list = danalpaycard.web.main_cardinfo.concat(danalpaycard.web.select_cardinfo);\r\n    }\r\n\r\n    danalpaycard.web.all_card_list.forEach(function(v, i){\r\n        // 카드명 예외처리\r\n        if(v.CARDCODE == '0200'){\r\n            v.CARDNAME = 'BC카드(페이북)';\r\n        } else if(v.CARDCODE == '0800'){\r\n            v.CARDNAME = '농협(NH페이)';\r\n        }\r\n\r\n    });\r\n\r\n    //test-data\r\n    // $.each(danalpaycard.web.all_card_list, function(idx, obj){\r\n    //     if(['0100', '0200', '0907', \"0500\"].indexOf(obj.CARDCODE) > -1){\r\n    //         obj.DISPLAYPOINT = 'Y';\r\n    //         obj.ISPOINT = 'Y';\r\n    //         obj['EVENT'] = 'Y';\r\n    //         obj.NOINT = ['00', '02', '03'];\r\n    //         obj.NOINTAMOUNT = \"60000\";\r\n    //         obj.POINTMINAMOUNT = \"56000\";\r\n    //     }\r\n    // });\r\n\r\n    // 결제금액 길이 처리\r\n    if($(\"#bill_amount\").text().length > 12){\r\n        $(\"#bill_amount\").css({'font-size': '22px'});\r\n    }else if($(\"#bill_amount\").text().length > 11){\r\n        $(\"#bill_amount\").css({'font-size': '24px'});\r\n    }else if($(\"#bill_amount\").text().length > 10){\r\n        $(\"#bill_amount\").css({'font-size': '26px'});\r\n    }\r\n\r\n    // checkbox 초기화\r\n    $.each($(\"input[type=checkbox]\"), function(idx, ele){\r\n        $(ele).prop('checked', false);\r\n    });\r\n\r\n    // 카드 li 리스트 생성\r\n    var main_card_list_html = '';\r\n    if(danalpaycard.web.all_card_list.length < 10){\r\n        // 카드 갯수가 10개 미만이면, 더보기 항목은 없음.\r\n        $.each(danalpaycard.web.all_card_list, function(idx, obj){\r\n            main_card_list_html += danalpaycard.web.make_card_li(obj);\r\n        });\r\n        $('#card_select_ul').html(main_card_list_html);\r\n    }\r\n    else{\r\n        // 카드 갯수가 10개 이상이면, main과 select항목을 나누어 표시.\r\n        $.each(danalpaycard.web.main_cardinfo, function(idx, obj){\r\n            main_card_list_html += danalpaycard.web.make_card_li(obj);\r\n        });\r\n        $('#card_select_ul').html(main_card_list_html);\r\n\r\n        // 더보기 selectbox\r\n        var sub_card_select_html = '<li>' +\r\n        '<span class=\"select_box01_w\" title=\"카드 더보기\" style=\" border: none;\" >' +\r\n        '<label id=\"card_ls_label\" for=\"card_ls\">더 보기</label>' +\r\n        '<select id=\"card_ls\" class=\"select_box03_w\" name=\"card_sel\" title=\"카드 더보기\" style=\"line-height: 50px;\" onmousedown=\"event.preventDefault()\" tabindex=\"0\"></select>' +\r\n        '</span>' +\r\n        '<span class=\"card_info_b\">' +\r\n            '<em id=\"id_sel_point_icon\"></em>'+\r\n            '<em id=\"id_sel_noint_icon\"></em>'+\r\n        '</span>' +\r\n        '<span id=\"id_sel_event_icon\"></span>' +\r\n        '</li>';\r\n        $('#card_select_ul').append(sub_card_select_html);\r\n\r\n        var sub_card_option_html = '<option value=\"\" style=\"color: #ccc;\" disabled selected>카드선택</option>';\r\n        $.each(danalpaycard.web.select_cardinfo, function(idx, obj){\r\n            sub_card_option_html += '<option value=\"'+ obj.CARDCODE +'\"' +\r\n                'data-point=\"' +(obj.ISPOINT == \"Y\" || obj.DISPLAYPOINT == 'Y' ? 'Y' : 'N')+ '\"' +\r\n                'data-noint=\"' +(obj.NOINT.length > 0 ? 'Y' : 'N')+ '\"' +\r\n                'data-event=\"' +(obj.EVENT ? 'Y' : 'N')+ '\">'+ obj.CARDNAME + '</option>';\r\n        });\r\n        $('#card_ls').html(sub_card_option_html);\r\n    }\r\n\r\n    // 다음 버튼 초기화\r\n    $(\"#next_btn\").removeClass('off').addClass('off');\r\n\r\n    // 포인트, 무이자 안내 팝업 아이콘\r\n    $(\"#id_point_info\").hide();\r\n    $(\"#id_noint_info\").hide();\r\n    $.each(danalpaycard.web.all_card_list, function(idx, obj){\r\n        if(obj.DISPLAYPOINT == 'Y'){\r\n            $(\"#id_point_info\").show();\r\n        }\r\n        if(obj.NOINT.length > 0){\r\n            $(\"#id_noint_info\").show();\r\n        }\r\n    });\r\n\r\n    // 무이자 팝업 내용\r\n    danalpaycard.web.init_noint();\r\n\r\n    // 즉시할인 init\r\n    danalpaycard.web.init_discount();\r\n\r\n    // 배너 이미지\r\n    danalpaycard.web.init_banner();\r\n\r\n    // 제휴이벤트 init\r\n    danalpaycard.web.init_ALI();\r\n\r\n};\r\ndanalpaycard.web.make_card_li = function(obj){\r\n    var li_html = '<li>' +\r\n        '<button data-cardcode=\"'+obj.CARDCODE+'\" tabindex=\"0\" title=\"'+obj.CARDNAME+' 선택안됨\" aria-label=\"'+obj.CARDNAME+' 선택안됨\">' +\r\n        '<span class=\"'+ (danalpaycard.web.card_obj.hasOwnProperty(obj.CARDCODE) ?  danalpaycard.web.card_obj[obj.CARDCODE]['c_name'] : '') +'\"></span>'+\r\n        danalpaycard.web.card_obj[obj.CARDCODE]['name'] +\r\n    '</button>' +\r\n    '<span class=\"card_info_b\">' +\r\n    (obj.ISPOINT == \"Y\" || obj.DISPLAYPOINT == 'Y' ? '<em class=\"point_b\">포인트</em>' : '') +\r\n    (obj.NOINT.length > 0 ? '<em class=\"interest_b\">무이자</em>' : '') +\r\n    '</span>' +\r\n    (obj.EVENT ? '<span class=\"icon_event\">EVENT</span>' : '') +\r\n    '</li>';\r\n    return li_html;\r\n};\r\ndanalpaycard.web.terms_agree_check = function(){\r\n    if($(\"input[name=terms_agree]:checked\").length < 3){\r\n        danalpaycard.web.terms_agree_flag = false;\r\n        danalpaycard.web.cardcode = '';\r\n        danalpaycard.web.quota = '';\r\n        $(\"#check00\").removeClass('on');\r\n        $(\"#check00\").removeClass('on');\r\n        $(\"#cardfield\").addClass('dis_b');\r\n        $(\".terms_list\").slideDown('fast');\r\n\r\n        // 웹접근성 title, aria-label 속성 추가\r\n        $(\"#check00\").attr('title', '전체동의 선택안됨');\r\n        $(\"#check00\").attr('aria-label', '전체동의 선택안됨');\r\n    }\r\n    else{\r\n        danalpaycard.web.terms_agree_flag = true;\r\n        $(\"#check00\").addClass('on');\r\n        $(\"#check00\").addClass('on');\r\n        $(\"#cardfield\").removeClass('dis_b');\r\n        $(\".terms_list\").slideUp('fast');\r\n\r\n        // 웹접근성 title, aria-label 속성 추가\r\n        $(\"#check00\").attr('title', '전체동의 선택됨');\r\n        $(\"#check00\").attr('aria-label', '전체동의 선택됨');\r\n    }\r\n};\r\ndanalpaycard.web.terms_all_agree = function(){\r\n    danalpaycard.web.reset_discount();\r\n    var $all_btn = $(\"#check00\");\r\n    $all_btn.toggleClass('on');\r\n    $(\"#cardfield\").removeClass('dis_b');\r\n    $(\"#card_ls\").attr('onmousedown', '');\r\n\r\n    $(\"select[name=card_sel]\").val('');\r\n    $(\"select[name=card_sel]\").selectmenu('refresh');\r\n    danalpaycard.web.cardcode = '';\r\n\r\n    var option = false;\r\n    if($all_btn.hasClass('on')){\r\n        option = true;\r\n    }\r\n    danalpaycard.web.terms_agree_flag = option;\r\n    option ? $(\"#cardfield\").removeClass('dis_b') : $(\"#cardfield\").addClass('dis_b');\r\n    if(!option) {\r\n        $.each($(\"#cardfield button, #cardfield span.select_box01_w, #cardfield span.select_box02_w\"), function (i, e) {\r\n            $(e).parent().removeClass('on');\r\n        });\r\n        $(\"#id_sel_noint_icon\").removeClass('interest_b');\r\n        $(\"#card_ls\").attr('onmousedown', 'event.preventDefault()');\r\n        $(\"#next_btn\").addClass('off');\r\n    }\r\n\r\n\r\n\r\n    $.each($(\"input[name=terms_agree]\"), function(idx, ele){\r\n        $(ele).prop('checked', option);\r\n    });\r\n    $('#id_card_w').hide();\r\n    $(\".terms_list\").slideToggle('fast');\r\n    \r\n    \r\n    // 웹접근성 title, aria-label 속성 추가\r\n    if(option){\r\n        $(\"#check00\").attr('title', '전체동의 선택됨');\r\n        $(\"#check00\").attr('aria-label', '전체동의 선택됨');\r\n    }else{\r\n        $(\"#check00\").attr('title', '전체동의 선택안됨');\r\n        $(\"#check00\").attr('aria-label', '전체동의 선택안됨');\r\n    }\r\n};\r\ndanalpaycard.web.cardbtn_click_action = function(ele){\r\n    if(!danalpaycard.web.terms_agree_flag){\r\n        danalpaycard.common.alert('Please agree to the terms and conditions first.');\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n        return false;\r\n    }\r\n    if(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ) {\r\n        danalpaycard.common.dc_confirm('다른 카드사를 선택하면 할인 쿠폰 적용이 해제 됩니다.')\r\n    }\r\n    else {\r\n        $(\"#card_ls\").prop('onmousedown', false);\r\n        if(ele.tagName === 'BUTTON'){\r\n            danalpaycard.web.common_click_action(ele);\r\n        }\r\n    }\r\n};\r\ndanalpaycard.web.cardsel_click_action = function(ui){\r\n    try{\r\n        var ele = ui.item.element[0]\r\n        var $selected_obj = $(ele);\r\n        var cardcode = $selected_obj.val();\r\n        if(!cardcode || cardcode == ''){\r\n            return false;\r\n        }\r\n        ($selected_obj.data('point') == 'Y' ? $(\"#id_sel_point_icon\").addClass('point_b') : $(\"#id_sel_point_icon\").removeClass('point_b'));\r\n        ($selected_obj.data('noint') == 'Y' ? $(\"#id_sel_noint_icon\").addClass('interest_b') : $(\"#id_sel_noint_icon\").removeClass('interest_b'));\r\n        if($selected_obj.data('event') == 'Y'){\r\n            $(\"#id_sel_event_icon\").text('EVENT');\r\n            $(\"#id_sel_event_icon\").addClass('icon_event');\r\n        }else{\r\n            $(\"#id_sel_event_icon\").text('');\r\n            $(\"#id_sel_event_icon\").removeClass('icon_event');\r\n        }\r\n\r\n        $(\"#card_ls_label\").text($selected_obj.text());\r\n        $(ele).parent().parent().data('cardcode', cardcode);\r\n        danalpaycard.web.common_click_action($(ele).parent().parent());\r\n    } catch (e) {\r\n        console.log(e)\r\n    }\r\n\r\n\r\n};\r\ndanalpaycard.web.common_click_action = function(ele){\r\n    try{\r\n\r\n        danalpaycard.web.cardcode =  $(ele).data('cardcode');\r\n        danalpaycard.web.alicode = $(ele).data('alliancecode');\r\n\r\n        $(\"#mon\").val($(\"#mon option:first\").val());\r\n        var text = $('select[name=quota] option:selected').text();\r\n        danalpaycard.web.quota = $('select[name=quota] option:selected').val();\r\n        $(\"#id_quota_text\").text(text);\r\n        $(\"#point01\").prop('checked', false);\r\n        //포인트 속성값 미사용 처리\r\n        if(!$(\"#point_checkbox input[type=checkbox]\").prop('checked')) {\r\n            danalpaycard.web.ISPOINTCHECK = $('input[name=point01]').is(':checked');\r\n        }\r\n\r\n        /* class on/off */\r\n        var $parent = $(ele).parent();\r\n        var $cardfield = $(\"#cardfield\");\r\n        var $all_cards = $(\"#cardfield button, #cardfield span.select_box01_w, #cardfield span.select_box02_w\");\r\n\r\n        $.each($all_cards, function(i, e){\r\n            try{\r\n                $(e).parent().removeClass('on');\r\n\r\n                // 웹접근성 title, aria-label 속성 추가\r\n                if(e.tagName == 'BUTTON' || e.tagName == 'button'){\r\n                    var cardname = '';\r\n                    if($(e).data('cardcode')){\r\n                        cardname = danalpaycard.web.card_obj[$(e).data('cardcode')]['name'];\r\n                    }\r\n                    if($(e).data('alliancecode')){\r\n                        cardname = danalpaycard.web.card_obj[$(e).data('alliancecode')]['name'];\r\n                    }\r\n                    $(e).attr('title', cardname + \" 선택안됨\");\r\n                    $(e).attr('aria-label', cardname + \" 선택안됨\");\r\n                }\r\n            }catch (e) {\r\n                console.log(e)\r\n            }\r\n        });\r\n\r\n        // 웹접근성 title, aria-label 속성 추가\r\n        var cardname = '';\r\n        if(danalpaycard.web.cardcode){\r\n            cardname = danalpaycard.web.card_obj[danalpaycard.web.cardcode]['name'];\r\n        }\r\n        if(danalpaycard.web.alliance_code){\r\n            cardname = danalpaycard.web.card_obj[danalpaycard.web.alliance_code]['name'];\r\n        }\r\n        if(ele.tagName == 'BUTTON' || ele.tagName == 'button'){\r\n            $(ele).attr('title', cardname + \" 선택됨\");\r\n            $(ele).attr('aria-label', cardname + \" 선택됨\");\r\n        }\r\n\r\n        $cardfield.addClass('dis_b');\r\n        $parent.addClass('on');\r\n        $(\"#next_btn\").removeClass('off');\r\n        /* //class on/off */\r\n\r\n        /* 할부 & 포인트 & 카드 공지사항 데이터 처리 */\r\n        var card_data = null;\r\n        $.each(danalpaycard.web.all_card_list, function(idx, obj){\r\n            if(obj.CARDCODE == danalpaycard.web.cardcode){\r\n                card_data = obj;\r\n                return false;\r\n            }\r\n        });\r\n\r\n        if(card_data && card_data.CARD_NOTICE != ''){\r\n            danalpaycard.common.alert(card_data.CARD_NOTICE);\r\n        }\r\n\r\n        var option_html = '';\r\n        var quota_info_list = card_data ? card_data.QUOTA_INFO.split(',') : [];\r\n        $.each(quota_info_list, function(idx, info){\r\n            var info_list = info.split(';');\r\n            option_html += '<option value=\"'+info_list[1]+'\">'+(info_list[0] == \"개월\" ? '일시불' : info_list[0]) +'</option>';\r\n        });\r\n        $(\"#mon\").empty();\r\n        $(\"#mon\").html(option_html);\r\n        $(\"#mon\").selectmenu('refresh');\r\n        danalpaycard.web.quota_click_action();\r\n\r\n        if(  (card_data && card_data.ISPOINT == \"Y\") || (card_data && card_data.DISPLAYPOINT == 'Y') ){\r\n            $(\"#point_checkbox\").show();\r\n            $(\"#id_point_name\").text(card_data.POINT_NAME);\r\n        }\r\n        else{\r\n            $(\"#point_checkbox\").hide();\r\n        }\r\n\r\n        /* 할부 영역 처리 */\r\n        var $select_div = $($(ele).parents()[3]);\r\n        if($select_div.hasClass('card_select')){\r\n            $('#id_card_w').slideDown('fast');\r\n        }else{\r\n            $('#id_card_w').slideUp('fast');\r\n        }\r\n        /* //할부 영역 처리 */\r\n\r\n\r\n        $(\"#id_quota_span\").show();\r\n        /* 제휴간편결제 할부 예외처리 */\r\n        if(danalpaycard.web.alicode){\r\n            $(\"#id_quota_span\").hide();\r\n        }\r\n        /* //제휴간편결제 할부 예외처리 */\r\n\r\n        /* 유니온 페이 예외처리 */\r\n        if(danalpaycard.web.cardcode == '0930') {\r\n            $(\"#id_union_text\").show();\r\n            $(\"#id_quota_span\").hide();\r\n        }else {\r\n            $(\"#id_union_text\").hide();\r\n        }\r\n        /* //유니온 페이 예외처리 */\r\n\r\n        //현대카드 할부개월 예외 처리\r\n        if(danalpaycard.web.cardcode == '0400' && parseInt(danalpaycard.web.quota) >= 19){\r\n            $(\"#point_checkbox\").hide();\r\n        }\r\n\r\n        /* 비자사이버소스 예외처리 */\r\n        if(danalpaycard.web.cardcode == '0901' || danalpaycard.web.cardcode == '0902' || danalpaycard.web.cardcode == '0905'){\r\n            $(\"#id_quota_span\").hide();\r\n        }\r\n        /* //비자사이버소스 예외처리 */\r\n\r\n    }catch (e) {\r\n        danalpaycard.common.alert(\"카드선택 중 오류가 발생했습니다. 다른 카드를 선택해주세요.\")\r\n    }\r\n\r\n\r\n};\r\ndanalpaycard.web.terms_popup = function(termindex){\r\n    $('#terms_pop_iframe').attr('src', '/creditcard/term/term' + termindex + \"_global.html?t=230220\");\r\n    danalpaycard.common.showpop('TERM');\r\n};\r\ndanalpaycard.web.quota_click_action = function(){\r\n    var text = $('select[name=quota] option:selected').text();\r\n    danalpaycard.web.quota = $('select[name=quota] option:selected').val();\r\n    $(\"#id_quota_text\").text(text);\r\n};\r\n\r\ndanalpaycard.web.requestPay = function(params) {\r\n    danalpaycard.common.showloader();\r\n    $(\"#next_btn\").unbind(\"click\");\r\n    $(\"#next_btn\").bind(\"click\", danalpaycard.web.check_next_btn);\r\n    $.ajax({\r\n        url: $SCRIPT_ROOT + \"/web/pay\",\r\n        type: \"POST\",\r\n        data: params,\r\n        success:function(result){\r\n            if(result.hasOwnProperty('RETURNCODE') && result.RETURNCODE == '1163'){\r\n                // precardauth 이벤트 중복 에러 예외처리\r\n                danalpaycard.common.alert(result.RETURNMSG);\r\n                danalpaycard.web.reset_discount();\r\n                return false;\r\n            }\r\n            var authParam = JSON.parse(result.AUTHVANPARAM);\r\n            var inputs = \"\";\r\n            for (var k in authParam) {\r\n                inputs +=\"<input type='hidden' name='\" + k +\"' value='\" +  (authParam[k]) + \"'/>\";\r\n            }\r\n\r\n            $(\"#ext-payment\").remove();\r\n            $(\"#iframe_div\").append(\"<iframe frameborder='no' id='ext-payment' name='ext-payment' scrolling='no' style='display: block !important;'> </iframe>\");\r\n            $(\"form[name='authForm']\").html(inputs);\r\n\r\n            var url = result.AUTHVANURL;\r\n            if(result.AUTHVANCODE==\"VP\" ) {\r\n                danalpaycard.web.runISP = danalpaycard.web.runISPPay(url);\r\n                if(result.ISGAMECP==\"Y\") {\r\n                    danalpaycard.common.showpop('ISGAME');\r\n                }\r\n                else {\r\n                    danalpaycard.web.runISP();\r\n                }\r\n            }\r\n            else if(result.AUTHVANCODE==\"UPOP\" || params.CARDCODE == \"0901\" || params.CARDCODE == \"0902\" || params.CARDCODE == \"0905\") {\r\n                document.authForm.target = \"ext_payment2\";\r\n                document.authForm.action = url;\r\n                document.authForm.method = \"post\";\r\n\r\n                var status = \"toolbar=no,directories=no,scrollbars=yes,resizable=no,status=no,menubar=no,width=1000, height=790, top=20, left=100\";\r\n\r\n                try{\r\n                    // 팝업 열기\r\n                    danalpaycard.web.child_window = window.open(\"_blank\", 'ext_payment2', status);\r\n\r\n                    // 팝업 차단 확인\r\n                    if(danalpaycard.web.child_window == null\r\n                        || typeof (danalpaycard.web.child_window) == 'undefined'\r\n                        || (danalpaycard.web.child_window == null && danalpaycard.web.child_window.outerWidth == 0)\r\n                        || (danalpaycard.web.child_window != null && danalpaycard.web.child_window.outerHeight == 0)\r\n                        || danalpaycard.web.child_window.test == \"undefined\"\r\n                    ) {\r\n                        danalpaycard.web.showAlliVanPopUp_block(\"Pop-up window has been blocked.</br>Please allow pop-up window and try again.\");\r\n                        return false;\r\n                    }\r\n                } catch (e) {\r\n                    console.log(e)\r\n                }\r\n\r\n                // 팝업 닫힘 확인\r\n                danalpaycard.web.ali_timer = setInterval(function(){\r\n                    if(danalpaycard.web.child_window.closed){\r\n                        clearInterval(danalpaycard.web.ali_timer);\r\n                        if( danalpaycard.web.alliance_popup_cancel_flag ){\r\n                            danalpaycard.common.alert('Authentication has been canceled.');\r\n                            $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n                        }\r\n                    }\r\n                }, 200);\r\n                danalpaycard.web.showAlliVanPopUp(\"The payment is in progress.</br>Please complete the payment in the pop-up window.\");\r\n\r\n\r\n                try {\r\n                    document.charset = document.authForm.acceptCharset;\r\n                    document.authForm.submit();\r\n                    document.charset = \"UTF-8\";\r\n                }\r\n                catch (ex) {\r\n                    //WIN10 & IE11\r\n                    document.characterSet = document.authForm.acceptCharset;\r\n                    document.authForm.submit();\r\n                    document.characterSet = \"UTF-8\";\r\n                }\r\n            }\r\n            else if(['ALI'].indexOf(result.AUTHMODE) > -1){\r\n                document.authForm.target = \"ext_payment2\";\r\n                document.authForm.action = url;\r\n                document.authForm.method = \"post\";\r\n                if(['NAVER'].indexOf(result.AUTHVANCODE) > -1 ){\r\n                    document.authForm.method = 'get';\r\n                }\r\n\r\n                var status = \"toolbar=no,directories=no,scrollbars=yes,resizable=no,status=no,menubar=no,width=437, height=618, top=20, left=100\";\r\n\r\n                if(result.AUTHVANCODE == 'NAVER'){\r\n                    status = status.replace(\"width=437\", \"width=750\");\r\n                    status = status.replace(\"height=618\", \"height=850\");\r\n                }\r\n\r\n                try{\r\n                    // 팝업 열기\r\n                    danalpaycard.web.child_window = window.open(\"../web/blank\", 'ext_payment2', status);\r\n\r\n                    // 팝업 차단 확인\r\n                    if(danalpaycard.web.child_window == null\r\n                        || typeof (danalpaycard.web.child_window) == 'undefined'\r\n                        || (danalpaycard.web.child_window == null && danalpaycard.web.child_window.outerWidth == 0)\r\n                        || (danalpaycard.web.child_window != null && danalpaycard.web.child_window.outerHeight == 0)\r\n                        || danalpaycard.web.child_window.test == \"undefined\"\r\n                    ) {\r\n                        danalpaycard.web.showAlliVanPopUp_block(\"팝업이 차단되었습니다.</br>팝업을 허용한 후 다시 시도해 주십시오.\");\r\n                        return false;\r\n                    }\r\n                } catch (e){\r\n                    console.log(e)\r\n                }\r\n\r\n\r\n                // 팝업 닫힘 확인\r\n                danalpaycard.web.ali_timer = setInterval(function(){\r\n                    if(danalpaycard.web.child_window.closed){\r\n                        clearInterval(danalpaycard.web.ali_timer);\r\n                        if( danalpaycard.web.alliance_popup_cancel_flag ){\r\n                            danalpaycard.common.alert('인증 취소되었습니다.');\r\n                            $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n                        }\r\n                    }\r\n                }, 200);\r\n                danalpaycard.web.showAlliVanPopUp(\"결제가 진행중입니다.</br>팝업창에서 결제를 완료해주세요.\");\r\n\r\n\r\n                try {\r\n                    document.charset = document.authForm.acceptCharset;\r\n                    document.authForm.submit();\r\n                    document.charset = \"UTF-8\";\r\n                }\r\n                catch (ex) {\r\n                    //WIN10 & IE11\r\n                    if(['KAKAO'].indexOf(result.AUTHVANCODE) > -1 ){\r\n                        document.authForm.action = $SCRIPT_ROOT + '/web/redirect';\r\n                        $(document.authForm).append(\"<input type='hidden' name='van_url' value='\"+url+\"' />\");\r\n                    }\r\n                    document.characterSet = document.authForm.acceptCharset;\r\n                    document.authForm.submit();\r\n                    document.characterSet = \"UTF-8\";\r\n                }\r\n            }\r\n            else {\r\n\r\n                document.authForm.target = \"ext-payment\";\r\n                document.authForm.action = url;\r\n                document.authForm.method = \"post\";\r\n\r\n                if(params.CARDCODE==\"0800\" || params.CARDCODE==\"0700\") {\r\n                    //NH, 롯데\r\n                    document.authForm.acceptCharset=\"UTF-8\";\r\n                }\r\n                else {\r\n                    document.authForm.acceptCharset=\"EUC-KR\";\r\n                }\r\n\r\n                try {\r\n                    document.charset = document.authForm.acceptCharset;\r\n                    document.authForm.submit();\r\n                    document.charset = \"UTF-8\";\r\n                }\r\n                catch (ex) {\r\n                    //WIN10 & IE11\r\n                    document.characterSet = document.authForm.acceptCharset;\r\n                    document.authForm.submit();\r\n                    document.characterSet = \"UTF-8\";\r\n                }\r\n                var width  = 408;\r\n                var height = 398;\r\n                var iframeCloseButton = $(\".iframe_close\");\r\n\r\n                $(\"#ext-payment\").attr('scrolling', 'no');\r\n                switch(params.CARDCODE) {\r\n                    case '0100': //신한카드\r\n                        iframeCloseButton.css('display', 'none');\r\n                        width = 408;\r\n                        height = 398;\r\n                        break;\r\n\r\n                    case '0500': //삼성카드\r\n                        iframeCloseButton.css('display', 'none');\r\n                        width = 400;\r\n                        height = 410;\r\n                        break;\r\n\r\n                    case '0400': //현대카드\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 393;\r\n                        height = 411;\r\n                        break;\r\n\r\n                    case '0700': //롯데카드\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 654;\r\n                        height = 468;\r\n                        break;\r\n\r\n                    case '0800': //NH\r\n                        iframeCloseButton.css('display', 'none');\r\n                        width = 402;\r\n                        height = 480;//556;\r\n                        break;\r\n\r\n                    case '0906'://씨티카드\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 641;\r\n                        height = 475;\r\n                        break;\r\n\r\n                    case '0600'://하나카드\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 588;\r\n                        height = 428;\r\n                        break;\r\n\r\n                    case '0601'://하나(구외환)\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 588;\r\n                        height = 428;\r\n                        break;\r\n\r\n                    case '0300'://KB국민\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 460;//459;\r\n                        height = 455;//455;\r\n                        break;\r\n\r\n                    case '0922'://카카오뱅크\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 465;//710;\r\n                        height = 355;//455;\r\n                        break;\r\n\r\n                    case '0907'://우리카드\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 600;\r\n                        height = 480;\r\n                        // $(\".iframe_w01\").css({\"height\": height});\r\n                        $(\".iframe_w01 iframe\").css({\"height\": '500px'});\r\n                        break;\r\n\r\n                    case '0930': //은련카드\r\n                        $(\"#ext-payment\").attr('scrolling', 'yes');\r\n                        width = 660;\r\n                        height = 460;\r\n                        $(\".iframe_w01 iframe\").css({\"height\": '460px'});\r\n                        break;\r\n\r\n                    case '0931'://토스뱅크\r\n                        iframeCloseButton.css('display', 'block');\r\n                        width = 588;\r\n                        height = 428;\r\n                        break;\r\n\r\n                    default :\r\n                        width = 408;\r\n                        height = 398;\r\n                        break;\r\n                }\r\n\r\n                $(\"#ext-payment\").data(\"authvancode\", result.AUTHVANCODE);\r\n                $(\"#auth_pop_width\").css(\"width\", width);\r\n                // $(\"#ext-payment\").attr(\"height\", height);\r\n                // $(\"#ext-payment\").css(\"margin-left\", -1*(width/2));\r\n                // $(\"#ext-payment\").css(\"margin-top\", -1*(height/2));\r\n                // $(\"#ext-payment\").css(\"background\", \"#fff\");\r\n                // $(\"#ext-payment-popup\").css(\"display\", \"block\");\r\n\r\n\r\n                danalpaycard.common.showpop(\"AUTH\")\r\n            }\r\n\r\n            danalpaycard.common.sendWebEventToGA(\"alert\", (\"pay.auth.\").concat(result.AUTHVANCODE.toString(), \".\" , params.CARDCODE));\r\n\r\n        },\r\n        error:function(response) {\r\n            console.log(response);\r\n            var result = jQuery.parseJSON(response.responseText);\r\n            if(result.hasOwnProperty('tx_return_code')){\r\n                if(['1161', '1166', '1163'].indexOf(result.tx_return_code) > -1){\r\n                    danalpaycard.common.alert(result.tx_return_msg);\r\n                    danalpaycard.common.hideloader();\r\n                    danalpaycard.common.showpop('ALERT');\r\n                    return;\r\n                }\r\n                result.tx_return_msg = danalpaycard.web.return_msg[result.tx_return_code] ? danalpaycard.web.return_msg[result.tx_return_code] : result.tx_return_msg;\r\n                $(\"#error_pop_text\").text(result.tx_return_msg);\r\n            } else {\r\n                $(\"#error_pop_text\").text(result.page_error_msg);\r\n            }\r\n\r\n            danalpaycard.common.showpop('ERROR');\r\n            danalpaycard.common.hideloader();\r\n            danalpaycard.common.sendWebErrorToGA(result.ga_error_info);\r\n        },\r\n        complete: function(){\r\n                danalpaycard.common.hideloader();\r\n        }\r\n    });\r\n};\r\ndanalpaycard.web.check_next_btn = function() {\r\n    var quota = $('#mon').val();\r\n\r\n    Placeholders.disable(); // FOR IE8\r\n\r\n    var popConfirmText = $(\"#pop_confirm_text\");\r\n    var popConfirm = $(\"#pop_confirm\");\r\n\r\n    if(!danalpaycard.web.terms_agree_flag){\r\n        danalpaycard.common.alert('Please agree to the terms and conditions first.');\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n        return false;\r\n    }\r\n\r\n    /* 제휴간편결제인 경우 */\r\n    if(danalpaycard.web.alicode && danalpaycard.web.alicode != ''){\r\n        var payParams = danalpaycard.web.get_requestPay_params('ALI');\r\n        payParams['ALLIANCECODE'] = danalpaycard.web.alicode;\r\n        payParams['SUBTYPE'] = 'ALLIANCE';\r\n\r\n\r\n        if(['NAVER'].indexOf(danalpaycard.web.alicode) > -1) {\r\n            // 네이버페이는 브릿지 페이지 띄움\r\n            danalpaycard.web.naverpay_bridgePage();\r\n        } else {\r\n            danalpaycard.web.requestPay(payParams);\r\n        }\r\n        return false;\r\n    }\r\n    /* // 제휴간편결제 끝*/\r\n\r\n    if( !danalpaycard.web.cardcode || danalpaycard.web.cardcode == '' ) {\r\n        danalpaycard.common.sendWebEventToGA(\"alert\", \"prepay.confirm.paymentinfo\");\r\n        danalpaycard.common.alert(\"Please select all the payment information.\");\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n        Placeholders.enable();\r\n        return false;\r\n    }\r\n\r\n    if ( !quota || quota == '') {\r\n        danalpaycard.common.sendWebEventToGA(\"alert\", \"prepay.confirm.paymentinfo\");\r\n        danalpaycard.common.alert(\"결제하실 정보를 모두 선택해 주세요.\");\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n        popConfirm.css('display', 'block');\r\n        Placeholders.enable();\r\n        return false\r\n    }\r\n\r\n    if($.trim($(\"#id_email\").val()) != ''){\r\n        var regexEmail =  /^([\\w-]+(?:\\.[\\w-]+)*)@((?:[\\w-]+\\.)*\\w[\\w-]{0,66})\\.([a-z]{2,6}(?:\\.[a-z]{2})?)$/i;\r\n        if(!regexEmail.test($.trim($(\"#id_email\").val()))){\r\n            danalpaycard.common.alert(\"Please check your email.\", null, function(){\r\n                $(\"#id_email\").focus();\r\n            });\r\n            $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n            return false;\r\n        }\r\n    }\r\n\r\n    /* 비자사이버소스인 경우 */\r\n    if(danalpaycard.web.cardcode === '0901' || danalpaycard.web.cardcode === '0902' || danalpaycard.web.cardcode === '0905'){\r\n        var payParams = danalpaycard.web.get_requestPay_params('CYBS');\r\n        payParams['SUBTYPE'] = 'CYBER';\r\n        danalpaycard.web.requestPay(payParams);\r\n        return;\r\n    }\r\n    /* // 비자사이버소스 끝*/\r\n\r\n    var payParams = danalpaycard.web.get_requestPay_params();\r\n    var isEventCpid = ['0010000010', '9810030929'];\r\n\r\n    // 할인 쿠폰 적용 안했으면, 또는 특정 CPID 가 아닌경우\r\n    if(payParams.ISIMMEDIATELYDISCOUNT == 'N' &&\r\n        isEventCpid.indexOf(danalpaycard.web.cpid) > -1) {\r\n        var immediatediscountEvent;\r\n\r\n        // 할인 적용 확인 ( CARDCODE 찾고, 할부개월 수 찾고, 즉시할인체크 )\r\n        danalpaycard.web.all_card_list.map(function(value, index) {\r\n            if(payParams.CARDCODE == value.CARDCODE &&\r\n                payParams.QUOTA.indexOf(value.QUOTA) &&\r\n                parseInt(value.IMMEDIATEDISCOUNTAMOUNT) > 0) {\r\n                immediatediscountEvent = value;\r\n            }\r\n        });\r\n\r\n        // 즉시할인 가능한 케이스라, show 띄우기\r\n        if(immediatediscountEvent) {\r\n            danalpaycard.common.showpop('DISCOUNT_CONFIRM');\r\n\r\n            // 적용한다고 하였을때, 이벤트\r\n            $('#discount_ok_btn').off('click').on('click', function() {\r\n                danalpaycard.common.hidepop();\r\n                danalpaycard.web.set_discount(payParams.CARDCODE);\r\n                payParams = danalpaycard.web.get_requestPay_params();\r\n                danalpaycard.web.requestPay(payParams);\r\n            });\r\n\r\n            // 적용 안한다고 하였을때 이벤트\r\n            $('#discount_no_btn').off('click').on('click', function() {\r\n                danalpaycard.common.hidepop();\r\n                danalpaycard.web.requestPay(payParams);\r\n            });\r\n            return;\r\n        }\r\n    }\r\n    danalpaycard.web.requestPay(payParams);\r\n};\r\ndanalpaycard.web.get_requestPay_params = function(authmode){\r\n    var tid_enc = $(\"input[name='tid_enc']\").val();\r\n    var cardCode = danalpaycard.web.cardcode;\r\n    var quota = $('#mon').val();\r\n    var userEmail = $.trim($(\"#id_email\").val());\r\n    var pointCheck = danalpaycard.web.ISPOINTCHECK ? 'Y' : 'N';\r\n    var immediatelyDiscount = danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ ? 'Y': 'N';\r\n\r\n    return {\r\n        'TID_ENC': tid_enc,\r\n        'CARDCODE': cardCode,\r\n        'ISPOINTCHECK': pointCheck,\r\n        'ISIMMEDIATELYDISCOUNT': immediatelyDiscount,\r\n        'USEREMAIL': userEmail,\r\n        'QUOTA': quota,\r\n        \"AUTHMODE\": authmode\r\n    };\r\n};\r\ndanalpaycard.web.runISPPay = function(url) {\r\n    function ISPPay() {\r\n\r\n        // VP 시작시 기존 #isp_dev 삭제\r\n        var ispCount = $.find(\"#isp_div\").length;\r\n        while (ispCount > 0) {\r\n            var ispDiv = $.find(\"#isp_div\");\r\n            $(ispDiv).remove();\r\n            ispCount = $.find(\"#isp_div\").length;\r\n        }\r\n\r\n        document.authForm.acceptCharset = \"UTF-8\"; //ISP 는 UTF-8\r\n        document.authForm.target = \"ext-payment\";\r\n        document.authForm.action = url;\r\n        document.authForm.method = \"post\";\r\n        BeforePost(authForm);\r\n    }\r\n    return ISPPay;\r\n};\r\n\r\ndanalpaycard.web.callbackVanFail = function(van, jsonPostData){\r\n    danalpaycard.common.hidepop();\r\n    danalpaycard.web.alliance_popup_cancel_flag = true;\r\n    $(\"#ext-payment\").remove();\r\n    if(van == \"VP\") {\r\n        try {\r\n            var j = JSON.parse(jsonPostData);\r\n            danalpaycard.web.showCancelVanPopUp(j.msg);\r\n        }\r\n        catch (e) {\r\n            danalpaycard.web.showCancelVanPopUp();\r\n        }\r\n    }\r\n    else {\r\n        if (van === \"SROO\") {\r\n            var j = JSON.parse(jsonPostData);\r\n            if(j.error.toUpperCase() == 'ISP'){\r\n                var payParams = danalpaycard.web.get_requestPay_params('ISP');\r\n                danalpaycard.web.requestPay(payParams)\r\n            }\r\n            else {\r\n                danalpaycard.web.showCancelVanPopUp();\r\n                //$(\"#next\").bind(\"click\", next);\r\n                danalpaycard.web.sendWebEventToGA(\"result\", (\"pay.auth.\").concat(van, \".cancel\"));\r\n            }\r\n\r\n        }\r\n        else if(van === \"PLRIS\") {\r\n\r\n            try {\r\n                var j = JSON.parse(jsonPostData);\r\n                danalpaycard.web.showCancelVanPopUp(\"[\" + j.r0.toString() +\"] \" + (j.msg ? j.msg.toString() : '인증 취소되었습니다.'));\r\n            }\r\n            catch (e) {\r\n                danalpaycard.web.showCancelVanPopUp();\r\n            }\r\n\r\n            //$(\"#next\").bind(\"click\", next);\r\n            danalpaycard.web.sendWebEventToGA(\"result\", (\"pay.auth.\").concat(van, \".cancel\"));\r\n        }\r\n        else if(van === \"RCMO\") {\r\n            try {\r\n                var j = JSON.parse(jsonPostData);\r\n                danalpaycard.web.showCancelVanPopUp(\"[\" + j.r0.toString() +\"] \" + (j.msg ? decodeURIComponent(j.msg.toString()) : '인증 취소되었습니다.') );\r\n            }\r\n            catch (e) {\r\n                danalpaycard.web.showCancelVanPopUp();\r\n            }\r\n            //$(\"#next\").bind(\"click\", next);\r\n            danalpaycard.web.sendWebEventToGA(\"result\", (\"pay.auth.\").concat(van, \".cancel\"));\r\n        }\r\n        else if(van === \"ILK\") {\r\n            var j = JSON.parse(jsonPostData);\r\n            if (j.hasOwnProperty('isp_yn') && j['isp_yn'] == 'Y') {\r\n                // ILK -> ISP 전환\r\n                var payParams = danalpaycard.web.get_requestPay_params('ISP');\r\n                danalpaycard.web.requestPay(payParams)\r\n            }\r\n            else {\r\n                // 취소, 오류, 기타\r\n                danalpaycard.web.showCancelVanPopUp();\r\n                //$(\"#next\").bind(\"click\", next);\r\n                danalpaycard.web.sendWebEventToGA(\"result\", (\"pay.auth.\").concat(van,  \".cancel\"));\r\n            }\r\n\r\n        }\r\n        else if(van === \"UPOP\") {\r\n            try {\r\n                var j = JSON.parse(jsonPostData);\r\n                danalpaycard.common.alert(\"[\" + j.respCode.toString() +\"] \" + \"인증 실패되었습니다.</br>처음부터 다시 시도해주십시오.\", null, function(){\r\n                    danalpaycard.common.session_close(); //은련카드는 인증실패시 재시도불가\r\n                });\r\n                $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n            }\r\n            catch (e) {\r\n                danalpaycard.common.alert(\"인증 실패되었습니다.</br>처음부터 다시 시도해주십시오.\", null, function(){\r\n                    danalpaycard.common.session_close(); //은련카드는 인증실패시 재시도불가\r\n                });\r\n                $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n            }\r\n        }\r\n        else if(['PAYCO', 'KAKAO', 'NAVER'].indexOf(van) > -1) {\r\n            try {\r\n                var j = JSON.parse(jsonPostData);\r\n                if(j.hasOwnProperty('code') && j.hasOwnProperty('message')){\r\n                    danalpaycard.web.showCancelVanPopUp(\"[\" + j.code +\"] \" + j.message);\r\n                } else {\r\n                    danalpaycard.web.showCancelVanPopUp();\r\n                }\r\n            }catch (e) {\r\n                danalpaycard.web.showCancelVanPopUp();\r\n            }\r\n        }\r\n        else {\r\n\r\n            danalpaycard.web.showCancelVanPopUp();\r\n            //$(\"#next\").bind(\"click\", next);\r\n            danalpaycard.web.sendWebEventToGA(\"result\", (\"pay.auth.\").concat(van,\".cancel\"));\r\n        }\r\n    }\r\n};\r\ncallbackVanFail = danalpaycard.web.callbackVanFail;\r\n\r\ndanalpaycard.web.callbackVanSuccess = function(van, jsonPostData) {\r\n    danalpaycard.web.alliance_popup_cancel_flag = false;\r\n    danalpaycard.common.hidepop();\r\n    danalpaycard.web.submitVanForm(van, jsonPostData);\r\n};\r\ncallbackVanSuccess = danalpaycard.web.callbackVanSuccess;\r\ndanalpaycard.web.submitVanForm = function(van, jsonPostData) {\r\n    var params = {};\r\n    params['tid_enc'] = $(\"input[name='tid_enc']\").val();\r\n    params['cancelurl'] = $(\"input[name='cancelurl']\").val();\r\n    params['returnurl'] = $(\"input[name='returnurl']\").val();\r\n    params['color'] = $(\"input[name='color']\").val();\r\n    params['ciurl'] = $(\"input[name='ciurl']\").val();\r\n    params['duration'] = $(\"input[name='duration']\").val();\r\n    params['amount'] = $(\"#sales_amount\").data(\"sales-total-amount\");\r\n    params['cpname'] = $(\"#cpname\").text();\r\n    params['itemname'] = $(\"#itemname\").text();\r\n    params['json_post_data'] = jsonPostData;\r\n    params['van'] = van;\r\n\r\n    var inputs = \"\";\r\n    for (var k in params) {\r\n        inputs += \"<input name='\" + k + \"' value='\" + params[k] + \"'/>\";\r\n    }\r\n\r\n    $(\"#vanForm\").append(inputs);\r\n    document.vanForm.submit();\r\n    danalpaycard.common.showloader();\r\n    setTimeout(function () {\r\n        danalpaycard.common.hideloader();\r\n    }, 8000);\r\n};\r\n\r\n\r\ndanalpaycard.web.showCancelVanPopUp = function(msg){\r\n    var alert_msg = msg ? msg.replace(/\\\\n/g, '<br>') : \"인증 취소되었습니다.\";\r\n\r\n    if(danalpaycard.web.all_card_list.length == 1){\r\n        $(\".pop_close\").hide();\r\n        danalpaycard.common.alert(alert_msg, null, function(){\r\n            danalpaycard.common.session_close();\r\n        });\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n    }\r\n    else{\r\n        danalpaycard.common.alert(alert_msg);\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n    }\r\n\r\n    if(Placeholders) {\r\n        Placeholders.enable();\r\n    }\r\n};\r\ndanalpaycard.web.showAlliVanPopUp = function(msg){\r\n    danalpaycard.common.alert(msg, function(){\r\n        $('.pop_close').hide();\r\n        $(\"#alert_pop_confirm_btn\").text(\"\");\r\n    }, function(){\r\n\r\n        Placeholders.enable();\r\n        danalpaycard.common.hidepop();\r\n        clearInterval(danalpaycard.web.ali_timer);\r\n    });\r\n\r\n    // document.hidden_form_cancel.submit();\r\n};\r\ndanalpaycard.web.showAlliVanPopUp_block = function(msg){\r\n    danalpaycard.common.alert(msg, function(){\r\n        $('.pop_close').hide();\r\n        $(\"#alert_pop_confirm_btn\").text(\"재시도\");\r\n    }, function(){\r\n        danalpaycard.web.init_step1();\r\n    });\r\n    $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n\r\n    // document.hidden_form_cancel.submit();\r\n};\r\n/* 새로고침 막기 & 백스페이스 */\r\ndanalpaycard.web.preventInvalidAction = function(e) {\r\n    if((e.ctrlKey == true && (e.keyCode == 78 || e.keyCode == 82)) || (e.keyCode == 116)) {\r\n        e.preventDefault();\r\n        e.keyCode = 0;\r\n        e.cancelBubble = true;\r\n        e.returnValue = false;\r\n    }\r\n\r\n    if(e.target.nodeName != \"INPUT\" && e.target.nodeName != \"TEXTAREA\") {\r\n        if(e.keyCode === 8) {\r\n            return false;\r\n        }\r\n    }\r\n};\r\n\r\ndanalpaycard.web.init_banner = function(){\r\n    danalpaycard.common.set_banner2();\r\n};\r\ndanalpaycard.web.init_noint = function(){\r\n    if(danalpaycard.web.all_card_list){\r\n        $(\"#ID_NOINT_POP_TABLE\").empty();\r\n        danalpaycard.web.all_card_list.sort(function(a, b){\r\n            return parseInt(a.CARDCODE) - parseInt(b.CARDCODE);\r\n        });\r\n\r\n        var html = '';\r\n        $.each(danalpaycard.web.all_card_list, function(idx, obj){\r\n            if(obj['NOINT'].length > 0){\r\n                html += '<tr><th>'+ obj['CARDNAME']+'</th><td>'+ (obj['NOINTAMOUNT'])[0]+'만원 이상 결제 시<br> '+ obj['NOINT'].join(', ')+'개월 무이자</td></tr>';\r\n            }\r\n        });\r\n        if(html != ''){\r\n            $(\"#ID_NOINT_DIV\").show();\r\n            $(\"#ID_NOINT_POP_TABLE\").append(html);\r\n        }\r\n    }\r\n};\r\ndanalpaycard.web.init_discount = function(){\r\n    if(danalpaycard.web.all_card_list){\r\n        $(\"#ID_DISCOUNT_POP_TABLE\").empty();\r\n\r\n        danalpaycard.web.all_card_list.sort(function(a, b){\r\n            return parseInt(a.CARDCODE) - parseInt(b.CARDCODE);\r\n        });\r\n\r\n        var html = '';\r\n        $.each(danalpaycard.web.all_card_list, function(idx, obj){\r\n            if( parseInt(obj['IMMEDIATEDISCOUNTAMOUNT']) > 0){\r\n                danalpaycard.web.IMMEDIATELYDISCOUNT_BTN = true;\r\n                html += '<tr><th>'+ obj['CARDNAME']+'</th><td>'+ $.number(obj['IMMEDIATEDISCOUNTMINAMOUNT'])+'원 이상 결제 시 <span style=\"color:red\">'+ $.number(obj['IMMEDIATEDISCOUNTAMOUNT'])+'원 즉시할인</span></td><td><button onclick=\"danalpaycard.web.set_discount(\\''+obj['CARDCODE']+'\\')\" type=\"button\" class=\"discount_set_btn\">적용</button> </td></tr>';\r\n            }\r\n        });\r\n        if(html != ''){\r\n            // $(\"#ID_NOINT_DIV\").show();\r\n            $(\"#ID_DISCOUNT_POP_TABLE\").append(html);\r\n        }\r\n\r\n        if(danalpaycard.web.IMMEDIATELYDISCOUNT_BTN) {\r\n            $(\"#discount_li\").show();\r\n        }\r\n    }\r\n};\r\ndanalpaycard.web.edge_check = function(){\r\n    if (navigator && navigator.userAgent) {\r\n        var userAgent = navigator.userAgent.toLowerCase();\r\n        if (userAgent.indexOf(\"edge\") > -1){\r\n            danalpaycard.common.showpop('EDGE');\r\n        }\r\n    }\r\n};\r\n\r\ndanalpaycard.web.direct_discount_btn = function(){\r\n    if(!danalpaycard.web.terms_agree_flag){\r\n        danalpaycard.common.alert('약관동의를 먼저 해주세요.');\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n        return false;\r\n    }\r\n    danalpaycard.common.showpop('DISCOUNT');\r\n};\r\ndanalpaycard.web.set_discount = function(cardcode){\r\n    $(\"#card_ls\").on('mousedown', function(e){e.preventDefault();});\r\n    var click_flag = false;\r\n\r\n    $.each($(\"#cardfield button\"), function(i, v){\r\n        // console.log($(v).data('cardcode'));\r\n        if($(v).data('cardcode') == cardcode){\r\n            if(danalpaycard.web.select_type) {\r\n                danalpaycard.web.prev_select_type = danalpaycard.web.select_type;\r\n            }\r\n            danalpaycard.web.select_type = 'button';\r\n\r\n            $(v).click();\r\n            click_flag = true;\r\n            return false;\r\n        }\r\n    });\r\n\r\n    // sub cardlist 확인\r\n    if(!click_flag){\r\n        $.each($(\"select[name=card_sel] option\"), function(i, v){\r\n            if($(v).val() == cardcode){\r\n                if(danalpaycard.web.select_type) {\r\n                    danalpaycard.web.prev_select_type = danalpaycard.web.select_type;\r\n                }\r\n                danalpaycard.web.select_type = 'select';\r\n\r\n                $(\"select[name=card_sel]\").val(cardcode);\r\n                $(\"select[name=card_sel]\").selectmenu('refresh');\r\n                var card_sel_selectmenu = $(\"select[name=card_sel]\").selectmenu('instance');\r\n                danalpaycard.web.cardsel_click_action({item: card_sel_selectmenu.items[card_sel_selectmenu.focusIndex]});\r\n                click_flag = true;\r\n                return false;\r\n            }\r\n        });\r\n    }\r\n\r\n    if(click_flag){\r\n        danalpaycard.common.hidepop();\r\n        var temp_card_data = null;\r\n        danalpaycard.web.all_card_list.forEach(function(obj, idx){\r\n            if(obj.CARDCODE == cardcode) {\r\n                temp_card_data = obj;\r\n                danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ = {\r\n                    min_amt: obj.IMMEDIATEDISCOUNTMINAMOUNT,\r\n                    dc_amt: obj.IMMEDIATEDISCOUNTAMOUNT,\r\n                    noint_min_amt: obj.NOINTAMOUNT,\r\n                    point_min_amt: obj.POINTMINAMOUNT,\r\n                    quota_min_amt: obj.QUOTAMINAMOUNT,\r\n                    cardcode: cardcode\r\n                }\r\n            }\r\n        });\r\n        $(\".discount_btn\").hide();\r\n        $(\"#discount_dd_dd\").show();\r\n        $(\"#discount_dd_span\").text(\"- \"+$.number(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ.dc_amt));\r\n        var discounted_amt = parseInt(danalpaycard.web.AMOUNT) - parseInt(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ.dc_amt);\r\n        $(\"#bill_amount_span\").text($.number(discounted_amt));\r\n\r\n        // 할부 최소 금액 확인\r\n        if(discounted_amt < parseInt(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ.quota_min_amt)){\r\n            $(\"#mon\").empty();\r\n            $(\"#mon\").append(\"<option value='00'>일시불</option>\");\r\n            $(\"#mon\").selectmenu('refresh');\r\n        }\r\n\r\n        // 무이자 최소 금액 확인\r\n        if(discounted_amt < parseInt(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ.noint_min_amt)){\r\n            $.each($(\"#mon option\"), function(idx, obj){\r\n                var replace_txt = $(obj).text().replace('(무)', '');\r\n                $(obj).text(replace_txt);\r\n            })\r\n            $(\"#mon\").selectmenu('refresh');\r\n        }\r\n\r\n        //즉시할인 적용 시 포인트 속성값 미사용 처리\r\n        if(!$(\"#point_checkbox input[type=checkbox]\").prop('checked')) {\r\n            danalpaycard.web.ISPOINTCHECK = $('input[name=point01]').is(':checked');\r\n        }\r\n\r\n    } else {\r\n        danalpaycard.common.alert('즉시할인 적용 중 오류가 발생하였습니다.');\r\n    }\r\n};\r\ndanalpaycard.web.reset_discount = function(){\r\n    // danalpaycard.web.cardsel_click_action($(\"select[name=card_sel] option:first\")[0]);\r\n    $(\"#cardfield span.select_box01_w\").removeClass('on');\r\n    $(\"#card_ls\").off('mousedown');\r\n    $(\".discount_btn\").show();\r\n    $(\"#discount_dd_dd\").hide();\r\n    $(\"#discount_dd_span\").text(\"0\");\r\n    $(\"#bill_amount_span\").text($.number(parseInt(danalpaycard.web.AMOUNT)));\r\n    danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ = null;\r\n    danalpaycard.web.IMMEDIATELYDISCOUNT_BTN = false;\r\n};\r\ndanalpaycard.web.dc_confirm_confirm = function(){\r\n    danalpaycard.web.reset_discount();\r\n    danalpaycard.common.hidepop();\r\n    $(\"#card_ls\").prop('onmousedown', false);\r\n\r\n    if(danalpaycard.web.select_type == 'select') {\r\n        return;\r\n    }\r\n\r\n    if(danalpaycard.web.selected_card_obj.tagName === 'BUTTON'){\r\n        danalpaycard.web.common_click_action(danalpaycard.web.selected_card_obj);\r\n    } else {\r\n        danalpaycard.web.cardcode = '';\r\n        $.each($(\"#cardfield button, #cardfield span.select_box01_w, #cardfield span.select_box02_w\"), function (i, e) {\r\n            $(e).parent().removeClass('on');\r\n        });\r\n        $(\"#next_btn\").addClass('off');\r\n        $(\"#cardfield span.select_box01_w\").parent().addClass('on');\r\n    }\r\n};\r\ndanalpaycard.web.dc_confirm_cancel = function(){\r\n    danalpaycard.common.hidepop();\r\n    \r\n    if(danalpaycard.web.select_type == 'select') {\r\n        // 카드 더보기 -> 카드 더보기\r\n        if(danalpaycard.web.prev_select_type == 'select') {\r\n            $('.ui-front').find('#card_ls-menu .ui-menu-item-wrapper').eq(danalpaycard.web.prev_card_sel.item.index).click();\r\n            danalpaycard.common.hidepop();\r\n            return false;\r\n        }    \r\n\r\n        // 주요 카드 -> 카드 더보기\r\n        var ele = danalpaycard.web.selected_card_obj;\r\n        $(\"#card_ls\").prop('onmousedown', false);\r\n        if(ele.tagName === 'BUTTON'){\r\n            danalpaycard.web.common_click_action(ele);\r\n        }\r\n    }\r\n\r\n    // 주요 카드 -> 주요 카드\r\n    if(danalpaycard.web.select_type == 'button') {\r\n        // 카드 더보기 -> 주요카드\r\n        if(danalpaycard.web.prev_select_type == 'select') {\r\n            $('.ui-front').find('#card_ls-menu .ui-menu-item-wrapper').eq(danalpaycard.web.current_card_sel.item.index).click();\r\n            danalpaycard.common.hidepop();\r\n            return false;\r\n        }    \r\n\r\n        var ele = danalpaycard.web.prev_selected_card_obj;\r\n        $(\"#card_ls\").prop('onmousedown', false);\r\n        if(ele.tagName === 'BUTTON'){\r\n            danalpaycard.web.common_click_action(ele);\r\n        }\r\n\r\n        danalpaycard.web.selected_card_obj = danalpaycard.web.prev_selected_card_obj;\r\n    }    \r\n    return false;\r\n};\r\n\r\n/*\r\n    - 제휴간편결제\r\n */\r\ndanalpaycard.web.init_ALI = function(){\r\n    if(danalpaycard.web.hasOwnProperty('alliance_info')){\r\n        if(danalpaycard.web.alliance_info.length > 0){\r\n            var li_html = '';\r\n            $.each(danalpaycard.web.alliance_info, function(idx, obj){\r\n                li_html += danalpaycard.web.make_ali_li(obj)\r\n            });\r\n            $(\"#id_ali_ul\").html(li_html);\r\n            $(\".payment_select\").show();\r\n\r\n            danalpaycard.web.kakaopay_promotion();\r\n        }\r\n    }\r\n\r\n};\r\ndanalpaycard.web.make_ali_li = function(obj){\r\n    return \"<li>\" +\r\n        \"<button data-alliancecode='\"+obj.ALLIANCECODE+\"' tabindex='0'>\"+\r\n        '<span class=\"'+ (danalpaycard.web.card_obj.hasOwnProperty(obj.ALLIANCECODE) ?  danalpaycard.web.card_obj[obj.ALLIANCECODE]['c_name'] : '') +'\"></span>'+\r\n        obj.ALLIANCENAME +\r\n        \"</button>\" +\r\n        \"</li>\";\r\n};\r\ndanalpaycard.web.kakaopay_promotion = function(){\r\n    // 카카오페이 상단 배치\r\n    var kakao_li = null;\r\n    var kakao_btn = null;\r\n    $.each( $(\"#id_ali_ul button\"), function(idx, obj){\r\n        if($(obj).data('alliancecode') == 'KAKAO'){\r\n            kakao_btn = $(obj);\r\n            kakao_li = $(obj).parent();\r\n        }\r\n    });\r\n\r\n    if(kakao_li){\r\n        kakao_btn.css({height: '45px'});\r\n        kakao_li.css({width: '100%'});\r\n        $(\"#card_select_ul\").prepend(kakao_li);\r\n    }\r\n};\r\ndanalpaycard.web.naverpay_bridgePage = function(){\r\n    // 네이버페이는 브릿지 페이지 먼저 띄움\r\n    var status = \"toolbar=no,directories=no,scrollbars=yes,resizable=no,status=no,menubar=no,width=750, height=900, top=20, left=100\";\r\n\r\n    try{\r\n        var input_html = \"\";\r\n        var input_names = ['STARTPARAMS', 'tid_enc']\r\n        for (var k in input_names) {\r\n            input_html +=\"<input type='hidden' name='\" + input_names[k] +\"' value='\" +  ($(\"input[name=\"+input_names[k]+\"]\").val()) + \"'/>\";\r\n        }\r\n        $(\"form[name='authForm']\").html(input_html);\r\n\r\n        // 팝업 열기\r\n        danalpaycard.web.child_window = window.open(\"_blank\", 'ext_payment2', status);\r\n\r\n        document.authForm.target = \"ext_payment2\";\r\n        document.authForm.action = './web/naverpay';\r\n        document.authForm.method = \"post\";\r\n        document.authForm.submit();\r\n\r\n        // 팝업 차단 확인\r\n        if(danalpaycard.web.child_window == null\r\n            || typeof (danalpaycard.web.child_window) == 'undefined'\r\n            || (danalpaycard.web.child_window == null && danalpaycard.web.child_window.outerWidth == 0)\r\n            || (danalpaycard.web.child_window != null && danalpaycard.web.child_window.outerHeight == 0)\r\n            || danalpaycard.web.child_window.test == \"undefined\"\r\n        ) {\r\n            danalpaycard.web.showAlliVanPopUp_block(\"팝업이 차단되었습니다.</br>팝업을 허용한 후 다시 시도해 주십시오.\");\r\n            return false;\r\n        }\r\n    } catch (e){\r\n        console.log(e)\r\n    }\r\n\r\n    // 팝업 닫힘 확인\r\n    danalpaycard.web.ali_timer = setInterval(function(){\r\n        if(danalpaycard.web.child_window.closed){\r\n            clearInterval(danalpaycard.web.ali_timer);\r\n            if( danalpaycard.web.alliance_popup_cancel_flag ){\r\n                danalpaycard.common.alert('인증 취소되었습니다.');\r\n                $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n            }\r\n        }\r\n    }, 200);\r\n    danalpaycard.web.showAlliVanPopUp(\"결제가 진행중입니다.</br>팝업창에서 결제를 완료해주세요.(영어)\");\r\n};\r\n\r\n$(function(){\r\n    // init\r\n    danalpaycard.web.edge_check();\r\n    danalpaycard.web.init_step1();\r\n\r\n    // 약관 이벤트 처리\r\n    $(\"input[name=terms_agree]\").off('change').on('change', function(){\r\n        danalpaycard.web.terms_agree_check();\r\n    });\r\n\r\n    // 주요 카드사 버튼\r\n    $(\"#cardfield button\").off('click').on('click', function(e){\r\n        if(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ ){\r\n            if(danalpaycard.web.selected_card_obj == this &&\r\n                danalpaycard.web.select_type == 'button'){\r\n                return;\r\n            }\r\n        }\r\n\r\n        if(danalpaycard.web.select_type) {\r\n            danalpaycard.web.prev_select_type = danalpaycard.web.select_type;\r\n        }\r\n        danalpaycard.web.select_type = 'button';\r\n\r\n        danalpaycard.web.prev_selected_card_obj = danalpaycard.web.selected_card_obj;\r\n        danalpaycard.web.selected_card_obj = this;\r\n\r\n        danalpaycard.web.cardbtn_click_action(this);\r\n    });\r\n\r\n    // 할부 selectbox 이벤트 처리\r\n    $(\"select[name=quota]\").off('change').on('change', function(){\r\n        danalpaycard.web.quota_click_action(this);\r\n    });\r\n\r\n    // point checkbox 이번트 처리\r\n    $(\"#point01\").off('click').on('click', function(){\r\n\r\n        if(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ){\r\n            var dc_amt = parseInt(danalpaycard.web.AMOUNT) - parseInt(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ.dc_amt);\r\n            if(dc_amt < parseInt(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ.point_min_amt)){\r\n                danalpaycard.common.alert('포인트사용 가능 최소금액은 '+$.number(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ.point_min_amt)+'원 입니다.')\r\n                $(\"#point01\").prop('checked', false);\r\n                if(!$(\"#point_checkbox input[type=checkbox]\").prop('checked')) {\r\n                    danalpaycard.web.ISPOINTCHECK = $('input[name=point01]').is(':checked');\r\n                }\r\n            } else {\r\n                danalpaycard.web.ISPOINTCHECK = $('input[name=point01]').is(':checked');\r\n            }\r\n        }else {\r\n            var amt = parseInt(danalpaycard.web.AMOUNT);\r\n            var min_point_amt = 0;\r\n            danalpaycard.web.all_card_list.forEach(function(obj, idx){\r\n                if(obj.CARDCODE == $(danalpaycard.web.selected_card_obj).data('cardcode')){\r\n                    min_point_amt = parseInt(obj.POINTMINAMOUNT);\r\n                }\r\n            });\r\n            if(amt < min_point_amt){\r\n                danalpaycard.common.alert('포인트사용 가능 최소금액은 '+$.number(min_point_amt)+'원 입니다.')\r\n                $(\"#point01\").prop('checked', false);\r\n                if(!$(\"#point_checkbox input[type=checkbox]\").prop('checked')) {\r\n                    danalpaycard.web.ISPOINTCHECK = $('input[name=point01]').is(':checked');\r\n                }\r\n            } else {\r\n                danalpaycard.web.ISPOINTCHECK = $('input[name=point01]').is(':checked');\r\n            }\r\n        }\r\n\r\n\r\n    });\r\n\r\n    // 다음 버튼 이벤트 처리\r\n    $(\"#next_btn\").off('click').on('click', function(){\r\n\r\n        danalpaycard.web.check_next_btn();\r\n    });\r\n\r\n    // 취소 버튼 이벤트 처리\r\n    $(\"#id_cancel_btn\").off('click').on('click', function(){\r\n        danalpaycard.common.confirm('Would you like to cancel the payment?', null, function(){\r\n            danalpaycard.common.session_close();\r\n        });\r\n        $(\"#alert_pop_confirm_btn\").show().text(\"OK\");\r\n    });\r\n\r\n    // 인증사 닫기 버튼 이벤트 처리\r\n    $(\"#auth_popup_close\").off('click').on('click', function(){\r\n        danalpaycard.common.hidepop();\r\n        $(\"#ext-payment\").remove();\r\n        danalpaycard.web.showCancelVanPopUp();\r\n    });\r\n\r\n    // 무이자 팝업 처리\r\n    $(\"#id_noint_info\").off('click').on('click', function(){\r\n        danalpaycard.common.showpop(\"NOINT\");\r\n    });\r\n\r\n    // 포인트 안내 팝업 처리\r\n    $(\"#id_point_info\").off('click').on('click', function(){\r\n        danalpaycard.common.showpop(\"POINT\");\r\n    });\r\n\r\n    // 카드 '더 보기' focus 처리\r\n    $(\"#card_ls, #mon\").on('focusin', function(){\r\n        $(this).parent().addClass('focus_s');\r\n    });\r\n    $(\"#card_ls, #mon\").on('focusout', function(){\r\n        $(this).parent().removeClass('focus_s');\r\n    });\r\n\r\n    $(\"#isgame_pop_confirm_btn\").off('click').on('click', function(){\r\n        danalpaycard.common.hidepop();\r\n        danalpaycard.web.runISP();\r\n    });\r\n\r\n\r\n    // jqueryui selectmenu scroll 처리\r\n    $(\"select[name=card_sel]\").selectmenu().selectmenu(\"menuWidget\").css({\"max-height\": '150px'});\r\n    $(\"select[name=quota]\").selectmenu().selectmenu(\"menuWidget\").css({\"max-height\": '120px', 'margin-bottom': '20px'});\r\n\r\n\r\n    // 더보기 카드 selectbox 이벤트 처리 - jqueryui selectmenu\r\n    var selectmenu = $(\"select[name=card_sel]\").selectmenu({\r\n        select: function(e, ui) {\r\n            if(danalpaycard.web.select_type) {\r\n                danalpaycard.web.prev_select_type = danalpaycard.web.select_type;\r\n            }\r\n            danalpaycard.web.select_type = 'select';\r\n            \r\n            if(danalpaycard.web.current_card_sel) {\r\n                danalpaycard.web.prev_card_sel = danalpaycard.web.current_card_sel;\r\n            }\r\n            danalpaycard.web.current_card_sel = ui;\r\n            danalpaycard.web.cardsel_click_action(ui);\r\n\r\n            if(danalpaycard.web.IMMEDIATELYDISCOUNT_OBJ) {\r\n                danalpaycard.common.dc_confirm('다른 카드사를 선택하면 할인 쿠폰 적용이 해제 됩니다.');\r\n            }\r\n        },\r\n        change: function(e, ui){\r\n            danalpaycard.web.cardcode = ui.item.value;\r\n        },\r\n        open: function(e, ui){\r\n            $(this).parent().addClass('focus_s');\r\n        },\r\n        close: function(e, ui){\r\n            $(this).parent().removeClass('focus_s');\r\n        }\r\n    });\r\n\r\n\r\n    // 현대카드 할부개월 예외 처리\r\n    $('#mon').selectmenu({\r\n        change: function(event, ui) {\r\n            danalpaycard.web.quota_click_action(this);\r\n\t\t\tvar cardCode = danalpaycard.web.cardcode; //현재 선택된 카드코드\r\n\t\t\tif(cardCode == '0400'){\r\n\t\t\t\tvar isPointAvailable = false;\r\n\t\t\t\t// 현대카드 ISPOINT 값\r\n\t\t\t\t$.each(danalpaycard.web.all_card_list, function(idx, obj){\r\n\t\t\t\t\tif(obj.CARDCODE == '0400'){\r\n\t\t\t\t\t\tisPointAvailable = (obj.ISPOINT == 'Y');\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\tif ((parseInt(ui.item.value) >= 19 && isPointAvailable) || !isPointAvailable) {\r\n\t\t\t\t\t$(\"#point_checkbox\").hide();\r\n\t\t\t\t\tif($(\"#point_checkbox input[type=checkbox]\").prop('checked')) {\r\n\t\t\t\t\t   $(\"#point_checkbox input[type=checkbox]\").click();\r\n\t\t\t\t\t}\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$(\"#point_checkbox\").show();\r\n\t\t\t\t}\r\n\t\t\t}\r\n        }\r\n    });\r\n\r\n});"
