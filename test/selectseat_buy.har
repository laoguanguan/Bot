          "content": {
            "size": 12566,
            "mimeType": "application/javascript",
            "compression": 0,
            "text": "if(typeof(danalpaycard) === 'undefined'){\n    danalpaycard = {};\n}\ndanalpaycard.common = {};\ndanalpaycard.common.static_path = '/creditcard';\ndanalpaycard.common.showpop = function(id){\n    if($('#POP_'+id).length == 0 ){\n        return false;\n    }\n    $('#POP_'+id).show();\n    $('body').css('overflow', 'hidden');\n    $('.pop_close:visible').focus();\n    // danalpaycard.common.popup_overflow_manage();\n};\ndanalpaycard.common.hidepop = function(callbackfunc){\n    if(callbackfunc){\n        callbackfunc();\n    }\n    $('.popup').hide();\n    $('body').css('overflow', '');\n\n    if(danalpaycard.common.layer_first_target != null){\n        danalpaycard.common.layer_first_target = null;\n    }\n};\ndanalpaycard.common.showloader = function(){\n    $(\".loader_pop\").show();\n};\ndanalpaycard.common.hideloader = function(){\n    $(\".loader_pop\").hide();\n};\n\ndanalpaycard.common.alert = function(text, callbackfunc, callbackfunc_after_confirm){\n    $(\"#alert_pop_confirm_btn\").show().text(\"확인\");\n    $('#alert_pop_cancel_btn').hide();\n    $('#alert_pop_confirm_btn').attr('onclick', 'danalpaycard.common.hidepop();');\n    $('#alert_pop_text').html(text);\n\n    if(callbackfunc){\n        callbackfunc();\n    }\n\n    if(callbackfunc_after_confirm){\n        $('#alert_pop_x_btn').attr('onclick', 'danalpaycard.common.hidepop('+callbackfunc_after_confirm+');');\n        $('#alert_pop_confirm_btn').attr('onclick', 'danalpaycard.common.hidepop('+callbackfunc_after_confirm+');');\n    }\n\n    danalpaycard.common.showpop('ALERT');\n};\ndanalpaycard.common.confirm = function(text, callbackfunc, callbackfunc_after_confirm){\n    $(\"#alert_pop_confirm_btn\").show().text(\"확인\");\n    $('#alert_pop_cancel_btn').show();\n    $('#alert_pop_text').text(text);\n\n    if(callbackfunc){\n        callbackfunc();\n    }\n\n    if(callbackfunc_after_confirm){\n        $('#alert_pop_confirm_btn').attr('onclick', 'danalpaycard.common.hidepop('+callbackfunc_after_confirm+');');\n    }\n\n    danalpaycard.common.showpop('ALERT');\n};\n\ndanalpaycard.common.dc_confirm = function(text){\n    $('#dc_confirm_pop_text').text(text);\n    danalpaycard.common.showpop('DC_CONFIRM');\n};\n\ndanalpaycard.common.session_close = function(){\n    var startparams_json = $(\"input[name='STARTPARAMS']\").val();\n    var cancelUrl = $(\"input[name='cancelurl']\").val();\n    if(cancelUrl == ''){\n        cancelUrl = $(\"input[name='cancel_url']\").val();\n    }\n    danalpaycard.common.showloader();\n    if(startparams_json) {\n        $.ajax({\n            url: $SCRIPT_ROOT + '/web/close',\n            type: \"post\",\n            data: {\"STARTPARAMS\": startparams_json},\n            success: function (result) {\n                danalpaycard.common.close_paymentwindow(cancelUrl);\n            },\n            error: function (response) {\n                var result = jQuery.parseJSON(response.responseText);\n                danalpaycard.common.close_paymentwindow(cancelUrl);\n            },\n            complete: function(){\n                danalpaycard.common.hideloader();\n            }\n        });\n    }\n    else {\n        danalpaycard.common.close_paymentwindow(cancelUrl);\n    }\n};\ndanalpaycard.common.close_paymentwindow = function(cancelUrl){\n    if(cancelUrl !=undefined && cancelUrl) {\n        window.location.href = cancelUrl;\n    }\n    else {\n        window.close();\n    }\n};\ndanalpaycard.common.popup_overflow_manage = function(){\n    // 레이어팝업 overflow 되는 경우, 높이 조절하는 함수\n    // try{\n    //     var window_h = window.innerHeight;\n    //     var popup_h = $('.content')[0].offsetHeight;\n    //     var scroll_div = null;\n    //     $.each($('.content'), function(idx, ele){\n    //         if($(ele).is(':visible')){\n    //             popup_h = ele.offsetHeight;\n    //             scroll_div = $(ele).find('.scroll');\n    //             return false;\n    //         }\n    //     });\n    //     // console.log('w:'+window_h+', p:'+popup_h+' w/p:'+window_h/popup_h + ', scroll:'+scroll_div[0].offsetHeight);\n    //     if(popup_h > window_h){\n    //         // 가로모드인 경우\n    //         $('.iframe_w').css('height', '6rem');\n    //         $('.notice_w').css('height', '5rem');\n    //     }\n    //     else if(window_h/popup_h > 1 && window_h/popup_h < 1.5){\n    //         // 테블릿 가로모드\n    //         $('.iframe_w').css('height', '10rem');\n    //         $('.notice_w').css('height', '6rem');\n    //     }\n    //     else if(window_h - popup_h > 100){\n    //         // 기본 케이스\n    //         $('.iframe_w').css('height', '20rem');\n    //         if(scroll_div[0].offsetHeight < 100){\n    //             // 1~2줄 알럿\n    //             $('.notice_w').css('height', '5rem');\n    //         }else{\n    //             // 그 이상 알럿\n    //             $('.notice_w').css('height', '15rem');\n    //         }\n    //     }\n    // }catch (e){\n    //\n    // }\n};\n\n\n/* Google Analytics */\ndanalpaycard.common.sendWebErrorToGA = function(errorInfo) {\n    //Google Analysis\n    if(!this.ga) {\n        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n            (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n            m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n        })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n\n    }\n\n    ga('send', 'pageview',   '/creditcard_std/web/error?' + errorInfo);\n};\ndanalpaycard.common.sendWebEventToGA = function(action, label) {\n    var category = \"web\";\n\n    if(!this.ga) {\n        //Google Analysis\n        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n            (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n            m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n        })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n    }\n\n    ga('send', 'event', category, action, label);\n};\n/* //Google Analytics */\n\n\ndanalpaycard.common.set_banner = function(res){\n    try{\n        $.get(danalpaycard.common.static_path + '/banner/banner.json?t='+ new Date().getTime(), function(res){\n            if(res && res.hasOwnProperty(\"creditcard_std\") && res.creditcard_std.length > -1){\n                var data = null;\n                var now_dt = new Date();\n                if( res.creditcard_std.length == 1){\n                    data = res.creditcard_std[0];\n                    // 게시 기간 확인\n                    if(data.hasOwnProperty('sdate') && data.hasOwnProperty('edate')){\n                        var beg_dt = new Date(data.sdate.year, data.sdate.month -1, data.sdate.day, data.sdate.hour, data.sdate.minute, data.sdate.second);\n                        var end_dt = new Date(data.edate.year, data.edate.month -1, data.edate.day, data.edate.hour, data.edate.minute, data.edate.second);\n\n                        if(end_dt < now_dt || beg_dt > now_dt){\n                            return false;\n                        }\n                    }\n\n                }else{\n                    var valid_data = [];\n                    // 게시 기간 확인\n                    $.each(res.creditcard_std, function(idx, obj){\n                        if(obj.hasOwnProperty('sdate') && obj.hasOwnProperty('edate')){\n                            var beg_dt = new Date(obj.sdate.year, obj.sdate.month -1, obj.sdate.day, obj.sdate.hour, obj.sdate.minute, obj.sdate.second);\n                            var end_dt = new Date(obj.edate.year, obj.edate.month -1, obj.edate.day, obj.edate.hour, obj.edate.minute, obj.edate.second);\n                            if(end_dt > now_dt && beg_dt < now_dt){\n                                valid_data.push(obj);\n                            }\n                        }else{\n                            valid_data.push(obj);\n                        }\n                    });\n\n                    var weighted_array = [];\n                    valid_data.map(function(val, idx){\n                        if(val.hasOwnProperty('probability') && val.probability > 0){\n                            for(var i = 0; i< val.probability; i++){\n                                weighted_array.push(idx);\n                            }\n                        }\n                    });\n                    if(weighted_array.length > 0 && weighted_array.length < 11){\n                        var random_num = Math.floor(Math.random() * weighted_array.length);\n                        data = valid_data[weighted_array[random_num]];\n                    } else {\n                        var random_num = Math.floor(Math.random() * valid_data.length);\n                        data = valid_data[random_num];\n                    }\n\n\n\n                }\n                if(!data){\n                    return false;\n                }\n                var img = $(\"<img />\", {\n                    \"id\" : data.banner_id,\n                    \"class\": \"banner_img\",\n                    \"alt\" : data.alt,\n                    \"src\": danalpaycard.common.static_path + data.src,\n                    \"onclick\": data.onclick,\n                    \"style\": \"cursor:pointer;\"\n                });\n\n                $(\"#ID_BANNER_DIV\").empty();\n                $(\"#ID_BANNER_DIV\").append(img);\n            }\n        });\n\n    }catch (e) {\n        console.log('banner error. : '+ e.toString());\n    }\n\n    $(\"#ID_BANNER_DIV\").keyup(function(e){\n        if(e.keyCode === 13 || e.keyCode === 32){\n            $(\"#\"+data.banner_id).click();\n        }\n    });\n};\ndanalpaycard.common.set_banner2 = function(){\n    try{\n        $.ajax({\n            url: 'https://dams.danalpay.com/api/v2/getbanner/DC_PC',\n            success: function(res){\n                if(res.banner_cnt > 0){\n                    var dams_url = \"https://dams.danalpay.com/build/images/\";\n                    var img = $(\"<img />\", {\n                        \"id\" : res.banner.id,\n                        \"class\": \"banner_img\",\n                        \"alt\" : res.banner.name,\n                        \"src\": dams_url + res.banner.img_src,\n                        \"onclick\": 'window.open(\"'+res.banner.url+'\")',\n                        \"style\": \"cursor:pointer;\"\n                    });\n\n                    $(\"#ID_BANNER_DIV\").empty();\n                    $(\"#ID_BANNER_DIV\").append(img);\n                }\n            },\n            error: function(res){\n                console.log('here')\n                danalpaycard.common.set_banner();\n            },\n            timeout: 3000\n        })\n\n    }catch (e) {\n        console.log(e)\n        danalpaycard.common.set_banner();\n    }\n\n    $(\"#ID_BANNER_DIV\").keyup(function(e){\n        if(e.keyCode === 13 || e.keyCode === 32){\n            $(\".banner_img\").click();\n        }\n    });\n};\ndanalpaycard.common.layer_first_target = null;\n\n$(function(){\n    $(document).on('keyup', function(e){\n        if($(\".popup\").is(\":visible\")){\n            if(danalpaycard.common.layer_first_target == null){\n                // console.log('layer pop  is open, set first');\n                danalpaycard.common.layer_first_target = document.activeElement;\n            }\n        }\n\n        if(e.keyCode === 9){\n            // console.log(danalpaycard.common.layer_first_target);\n            // console.log($(\".popup\").is(\":visible\"));\n            if($(\".popup\").is(\":visible\")){\n                if(danalpaycard.common.layer_first_target == null){\n                    // console.log('layer pop  is open, set first');\n                    danalpaycard.common.layer_first_target = document.activeElement;\n                }\n                else{\n                    var is_in_layerpop = false;\n                    $.each($(e.target).parents(), function(idx, ele){\n                        if(ele.className == 'popup'){\n                            is_in_layerpop = true;\n                            // console.log(e.target.tagName + ': is_in_layerpop');\n                            return false;\n                        }\n                    });\n\n                    if(! is_in_layerpop){\n                        setTimeout(function(){\n                            $(danalpaycard.common.layer_first_target).focus();\n                            // console.log('layer focus out!, set first element.');\n                        }, 1);\n                    }\n                }\n            }\n            else{\n                if(danalpaycard.common.layer_first_target != null){\n                    danalpaycard.common.layer_first_target = null;\n                }\n            }\n        }\n\n    })\n});"
