n\t\t\tvp_util.Write_ISP_Log(\"[Ret_GetData_Kvp_PaySet_Flag]\", data.msg);\n\t\t}\n\t}\n}\n\n/**\n * get 복합결제 사용포인트\n */\nfunction GetData_Kvp_Using_Point() {\n\tvp_util.Write_ISP_Log(\"[GetData_Kvp_Using_Point]\", \"\");\n\tif (CheckFormField(vpPayform, \"KVP_USING_POINT\")) {\n\t\tvar param = 'command=getdata&session=' + m_sessionid + '&gname=Kvp_Using_Point';\n\t\tCallFunction(param, Ret_GetData_Kvp_Using_Point);\n\t} else {\n\t\tGetData_Vp_Success_SavePoint();\n\t}\n}\n\n/**\n * set 복합결제 사용포인트\n * @param {*} e \n */\nfunction Ret_GetData_Kvp_Using_Point(e) {\n\tvar data = eval('(' + e.data + ')');\n\tif (data.callback == 'Kvp_Using_Point') {\n\t\tRemoveEvent();\n\t\tif (data.resultcode && data.resultcode == '00') {\n\t\t\tm_eispprocess += 'Ret_GetData_Kvp_Using_Point,';\n\t\t\tvpPayform.KVP_USING_POINT.value = decodeURIComponent(data.getdata);\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_GetData_Kvp_Using_Point]\", vpPayform.KVP_USING_POINT.value);\n\t\t\tGetData_Vp_Success_SavePoint();\n\t\t} else {\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_GetData_Kvp_Using_Point]\", data.msg);\n\t\t}\n\t}\n}\n\n/**\n * get 세이브 포인트\n */\nfunction GetData_Vp_Success_SavePoint() {\n\tvp_util.Write_ISP_Log(\"[GetData_Vp_Success_SavePoint]\", \"\");\n\tif (CheckFormField(vpPayform, \"VP_RET_SAVEPOINT\")) {\n\t\tvar param = 'command=getdata&session=' + m_sessionid + '&gname=Vp_Success_SavePoint';\n\t\tCallFunction(param, Ret_GetData_Vp_Success_SavePoint);\n\t} else {\n\t\tGetData_VP_PREDIS_RET_CODE();\n\t}\n}\n\n/**\n * set 세이브 포인트\n * @param {*} e \n */\nfunction Ret_GetData_Vp_Success_SavePoint(e) {\n\tvar data = eval('(' + e.data + ')');\n\tif (data.callback == 'Vp_Success_SavePoint') {\n\t\tRemoveEvent();\n\t\tif (data.resultcode && data.resultcode == '00') {\n\t\t\tm_eispprocess += 'Ret_GetData_Vp_Success_SavePoint,';\n\t\t\tvpPayform.VP_RET_SAVEPOINT.value = decodeURIComponent(data.getdata);\n\t\t\tvp_util.Write_ISP_Log(\"[Ret_GetData_Vp_Success_SavePoint]\", vpPayform.VP_RET_SAVEPOINT.valu